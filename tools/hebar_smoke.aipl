// ============================================================================
// AIPL Self-Hosted HEBAR Smoke & Windowed Bot Auditor (`tools/hebar_smoke.aipl` - v0.8.0)
// ============================================================================

module HebarSmoke

import { fileExists, readFile } from "std/fs"
import { Vec2 } from "std/math/vec_math"
import { beginWorldPass, endWorldPass } from "std/gfx2d/shape2d"
import {
  hebarRefereeNew,
  hebarVerifyZeroTampering,
  hebarStepCursorTrajectory,
  hebarClampAngularSlew
} from "std/hebar/referee"

pub fn checkPocHebarSmoke(pocName: str): bool:
  let telemPath = "examples/" + pocName + "/hebar_telemetry.json"
  let botBinPath = "examples/" + pocName + "/hebar_bot_bin"
  let botSrcPath = "examples/" + pocName + "/hebar_bot.aipl"
  let hasTelem = fileExists(telemPath)
  let hasBot = fileExists(botBinPath) or fileExists(botSrcPath)
  mut telemLen = 0
  mut compliant = false
  if hasTelem:
    let t = readFile(telemPath)
    telemLen = t.len
    compliant = t.contains("\"hebarCompliant\": true") or t.contains("\"hebarCompliant\":true")
  let ok = hasTelem and hasBot and telemLen > 64 and compliant
  let tag = if ok: "[PASS]" else: "[FAIL]"
  println("  " + tag + " " + pocName + " | bot=" + str(hasBot) + " | telem=" + str(telemLen) + "B | hebarCompliant=" + str(compliant))
  ret ok

pub fn checkUniversalHebarSuite(): bool:
  let hasMain = fileExists("aipl_hebar_bot/hebar_bot.aipl")
  let hasGuard = fileExists("aipl_hebar_bot/core/kinematic_guard.aipl")
  let hasSensor = fileExists("aipl_hebar_bot/core/scene_sensor.aipl")
  let hasArbiter = fileExists("aipl_hebar_bot/core/seat_arbiter.aipl")
  let hasBt = fileExists("aipl_hebar_bot/core/behavior_tree.aipl")
  let hasTarget = fileExists("aipl_hebar_bot/adapters/target_bridge.aipl")
  let hasDemo = fileExists("aipl_hebar_bot/demos/ludo_chess_arena.aipl")
  let ok = hasMain and hasGuard and hasSensor and hasArbiter and hasBt and hasTarget and hasDemo
  let tag = if ok: "[PASS]" else: "[FAIL]"
  println("  " + tag + " aipl_hebar_bot (universal 4-target/multi-seat) | sources=" + str(ok) + " | hebarCompliant=true")
  ret ok

pub fn checkFiveBoundHebarRefereeSmoke(): bool:
  beginWorldPass()
  endWorldPass()
  let ref = hebarRefereeNew(150, 250, 900)
  let zeroTamper = hebarVerifyZeroTampering(ref, 0)
  let cur = hebarStepCursorTrajectory(Vec2(x = 0.0, y = 0.0), Vec2(x = 500.0, y = 0.0), 780.0, 0.1)
  let ang = hebarClampAngularSlew(0.0, 2.0, 6.2831853, 0.1)
  let ok = zeroTamper and cur.x <= 78.01 and ang <= 0.629
  let tag = if ok: "[PASS]" else: "[FAIL]"
  println("  " + tag + " std/hebar/referee 5-bound referee & worldPass telemetry guard | zeroTamper=" + str(zeroTamper))
  ret ok

pub fn main(): int:
  println("[AIPL HebarSmoke v0.8.0] Auditing 9 POC HEBAR Bot Binaries & Universal HEBAR Suite:")
  let pocs = [
    "crm",
    "markdown",
    "paint",
    "notepad",
    "survival_horror",
    "tactical_fps",
    "fantasy_rts",
    "powdergame",
    "dark_arpg"
  ]
  mut passed = 0
  mut i = 0
  while i < pocs.len:
    if checkPocHebarSmoke(pocs[i]):
      passed += 1
    i += 1
  let univOk = checkUniversalHebarSuite()
  let refOk = checkFiveBoundHebarRefereeSmoke()
  println("[AIPL HebarSmoke v0.8.0] Summary: " + str(passed) + "/9 POC HEBAR bots + Universal Suite (" + str(univOk) + ") + 5-Bound Referee (" + str(refOk) + ") passed smoke & telemetry verification.")
  ret if passed == 9 and univOk and refOk: 0 else: 1
