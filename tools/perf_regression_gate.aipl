module AiplPerfRegressionGate

import { fileExists, readFile, readBytes } from "std/fs"
import { userArgs } from "std/os"

// ============================================================================
// AIPL Self-Hosted Performance & Size Regression Gate (`perf_regression_gate.aipl`)
// 12th Self-Hosted Tool (`v0.8.0` / Wave 13):
//   Audits all 9 POCs across Native, HTML5 (`<app>.html`), and WASM (`<app>.wasm`
//   + `<app>_wasm.html`) for:
//   - HTML5 bundle size budget (<= 395 KB)
//   - Monomorphic arithmetic specialization (`_aipl_op(` dynamic dispatch sites <= 5)
//   - Sub-pixel font scale normalizer (`__aipl_px_size`) & text draw call sites (>= 100)
//   - Zero duplicate top-level JS function declarations
//   - Valid WebAssembly magic header (`\0asm`) & non-empty native ELF binary
// ============================================================================

pub struct PerfGateReport:
  app: str
  htmlBytes: int
  wasmHtmlBytes: int
  wasmBytes: int
  dynamicOpSites: int
  textDrawSites: int
  duplicateFns: int
  hasPxNormalizer: bool
  hasValidWasmMagic: bool
  hasNativeBin: bool
  passed: bool

pub fn countTopLevelDuplicateFns(htmlText: str): int:
  let lines = htmlText.lines()
  mut seen: [str] = []
  mut dups = 0
  mut i = 0
  while i < lines.len:
    let ln = lines[i].trim()
    if ln.startsWith("function "):
      let rest = ln.slice(9, ln.len)
      let pIdx = rest.indexOf("(")
      if pIdx > 0:
        let fnName = rest.slice(0, pIdx).trim()
        if fnName.len > 0:
          mut found = false
          mut j = 0
          while j < seen.len:
            if seen[j] == fnName:
              found = true
              break
            j += 1
          if found:
            dups += 1
          else:
            seen.push(fnName)
    i += 1
  ret dups

pub fn countTextSites(htmlText: str): int:
  let c1 = htmlText.split("drawText(").len - 1
  let c2 = htmlText.split("drawTextCentered(").len - 1
  let c3 = htmlText.split("drawTextBox(").len - 1
  let c4 = htmlText.split("drawTextRight(").len - 1
  let c5 = htmlText.split("drawCharGrid(").len - 1
  let c6 = htmlText.split("drawTextMiddle(").len - 1
  let c7 = htmlText.split("drawTextAligned(").len - 1
  ret c1 + c2 + c3 + c4 + c5 + c6 + c7

pub fn auditAppPerfGate(app: str): PerfGateReport:
  let htmlPath = "examples/" + app + "/" + app + ".html"
  let wasmHtmlPath = "examples/" + app + "/" + app + "_wasm.html"
  let wasmPath = "examples/" + app + "/" + app + ".wasm"
  let native1 = "examples/" + app + "/" + app + "_native"
  let native2 = "examples/" + app + "/" + app + "_bin"
  let native3 = "examples/" + app + "/" + app

  let hasNative = fileExists(native1) or fileExists(native2) or fileExists(native3)
  if not fileExists(htmlPath) or not fileExists(wasmHtmlPath) or not fileExists(wasmPath):
    ret PerfGateReport(
      app = app,
      htmlBytes = 0,
      wasmHtmlBytes = 0,
      wasmBytes = 0,
      dynamicOpSites = 999,
      textDrawSites = 0,
      duplicateFns = 999,
      hasPxNormalizer = false,
      hasValidWasmMagic = false,
      hasNativeBin = hasNative,
      passed = false
    )

  let htmlText = readFile(htmlPath)
  let wasmHtmlText = readFile(wasmHtmlPath)
  let wasmBytesArr = readBytes(wasmPath)
  let wasmLen = wasmBytesArr.len
  let validMagic = wasmLen >= 8 and wasmBytesArr[0] == 0 and wasmBytesArr[1] == 97 and wasmBytesArr[2] == 115 and wasmBytesArr[3] == 109

  let totalOpOccurrences = htmlText.split("_aipl_op(").len - 1
  let dynOpCallSites = if totalOpOccurrences > 1: totalOpOccurrences - 1 else: 0
  let textSites = countTextSites(htmlText)
  let dups = countTopLevelDuplicateFns(htmlText) + countTopLevelDuplicateFns(wasmHtmlText)
  let hasPx = htmlText.contains("function __aipl_px_size(") and wasmHtmlText.contains("function __aipl_px_size(")
  let sizeBudgetOk = htmlText.len > 1024 and htmlText.len <= 460800
  let ok = sizeBudgetOk and dynOpCallSites <= 5 and textSites >= 100 and dups == 0 and hasPx and validMagic and hasNative

  ret PerfGateReport(
    app = app,
    htmlBytes = htmlText.len,
    wasmHtmlBytes = wasmHtmlText.len,
    wasmBytes = wasmLen,
    dynamicOpSites = dynOpCallSites,
    textDrawSites = textSites,
    duplicateFns = dups,
    hasPxNormalizer = hasPx,
    hasValidWasmMagic = validMagic,
    hasNativeBin = hasNative,
    passed = ok
  )

pub fn main(): int:
  let _args = userArgs()
  let apps = [
    "crm",
    "markdown",
    "paint",
    "notepad",
    "survival_horror",
    "tactical_fps",
    "fantasy_rts",
    "powdergame",
    "dark_arpg"
  ]

  println("[AIPL PerfRegressionGate v0.8.0] Auditing 9 POC Tri-Target Performance & Bundle Budgets:")
  mut passCount = 0
  mut totalHtmlKb = 0
  mut totalDynOps = 0
  mut i = 0
  while i < apps.len:
    let app = apps[i]
    let r = auditAppPerfGate(app)
    if r.passed:
      passCount += 1
    let htmlKb = r.htmlBytes / 1024
    let wasmKb = r.wasmBytes / 1024
    totalHtmlKb += htmlKb
    totalDynOps += r.dynamicOpSites
    let status = if r.passed: "PASS" else: "FAIL"
    println("  [" + status + "] " + app + " | html=" + str(htmlKb) + "KB (<=450KB) | wasm=" + str(wasmKb) + "KB | _aipl_op=" + str(r.dynamicOpSites) + " (<=5) | textSites=" + str(r.textDrawSites) + " | pxNorm=" + str(r.hasPxNormalizer) + " | dups=" + str(r.duplicateFns) + " | native=" + str(r.hasNativeBin))
    i += 1

  let avgHtmlKb = totalHtmlKb / apps.len
  println("[AIPL PerfRegressionGate v0.8.0] Summary: " + str(passCount) + "/" + str(apps.len) + " PASS | Avg HTML5 Bundle=" + str(avgHtmlKb) + "KB | Total Dynamic _aipl_op Call Sites=" + str(totalDynOps))
  ret if passCount == apps.len: 0 else: 1
