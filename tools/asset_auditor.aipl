// AIPL Self-Hosted Tri-Target & Asset Auditor (`tools/asset_auditor.aipl` - v0.8.0)
// Audits native binaries, HTML5 bundles, WASM binaries, runnable <app>_wasm.html hosts,
// HEBAR telemetry, and screenshots across all 9 flagship POC applications.

pub fn auditPocAssets(pocName: str, binName: str): bool:
  let baseDir = "examples/" + pocName
  let binPath = baseDir + "/" + binName
  let altBinPath = baseDir + "/" + pocName + "_bin"
  let htmlPath = baseDir + "/" + pocName + ".html"
  let wasmPath = baseDir + "/" + pocName + ".wasm"
  let wasmHtmlPath = baseDir + "/" + pocName + "_wasm.html"
  let hebarPath = baseDir + "/hebar_telemetry.json"
  let hasBin = fileExists(binPath) or fileExists(altBinPath)
  let hasHtml = fileExists(htmlPath)
  let hasWasm = fileExists(wasmPath)
  let hasWasmHtml = fileExists(wasmHtmlPath)
  let hasHebar = fileExists(hebarPath)
  mut hebarBytes = 0
  if hasHebar:
    let hContent = readFile(hebarPath)
    hebarBytes = hContent.len
  let ok = hasBin and hasHtml and hasWasm and hasWasmHtml and hasHebar and hebarBytes > 20
  let status = if ok: "[PASS]" else: "[FAIL]"
  print("  " + status + " " + pocName + " | bin=" + str(hasBin) + " html=" + str(hasHtml) + " wasm=" + str(hasWasm) + " wasm_html=" + str(hasWasmHtml) + " hebar=" + str(hebarBytes) + "B")
  ret ok

pub fn main(): int:
  let pocs = ["crm", "markdown", "paint", "notepad", "survival_horror", "tactical_fps", "fantasy_rts", "powdergame", "dark_arpg"]
  let bins = ["crm_bin", "markdown_bin", "paint_bin", "notepad_bin", "survival_horror_bin", "tactical_fps_bin", "fantasy_rts_bin", "powdergame_bin", "dark_arpg_bin"]
  print("[AIPL AssetAuditor v0.8.0] Auditing 9 Flagship POC Tri-Target & Telemetry Artifacts:")
  mut passed = 0
  mut i = 0
  while i < pocs.len:
    if auditPocAssets(pocs[i], bins[i]):
      passed += 1
    i += 1
  print("[AIPL AssetAuditor v0.8.0] Summary: " + str(passed) + "/" + str(pocs.len) + " POC suites passed 100% artifact & telemetry checks.")
  ret if passed == pocs.len: 0 else: 1
