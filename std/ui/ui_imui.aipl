pub fn auraContextNew(theme: AuraTheme): AuraContext:
  let emptyOffsets: Map[str, float] = mapNew()
  let emptyBuffers: Map[str, AuraTextEditBuffer] = mapNew()
  let emptyOverlays: Map[str, AuraZOverlay] = mapNew()
  let emptyState: Map[str, str] = mapNew()
  ret AuraContext(
    theme = theme,
    hotId = "",
    activeId = "",
    focusedId = "",
    mouseX = 0.0,
    mouseY = 0.0,
    mouseDown = false,
    mouseClicked = false,
    wheelY = 0.0,
    textInput = "",
    scrollOffsets = emptyOffsets,
    cursorX = 0.0,
    cursorY = 0.0,
    layoutDir = "column",
    layoutGap = 8.0,
    textBuffers = emptyBuffers,
    zOverlays = emptyOverlays,
    uiState = emptyState,
    focusOrder = []
  )

pub fn auraScrimColor(scrimHex: int): Color:
  if scrimHex > 16777215:
    let r = (scrimHex / 16777216) % 256
    let g = (scrimHex / 65536) % 256
    let b = (scrimHex / 256) % 256
    let a = clampFloat(float(scrimHex % 256) / 255.0, 0.45, 0.85)
    ret rgba(r, g, b, a)
  let g = (scrimHex / 65536) % 32
  let b = (scrimHex / 256) % 40
  let aByte = scrimHex % 256
  let a = if aByte > 0: clampFloat(float(aByte) / 255.0, 0.58, 0.82) else: 0.72
  ret rgba(4, g, b, a)

pub fn auraGlassColor(glassHex: int): Color:
  if glassHex > 16777215:
    let r = (glassHex / 16777216) % 256
    let g = (glassHex / 65536) % 256
    let b = (glassHex / 256) % 256
    let a = clampFloat(float(glassHex % 256) / 255.0, 0.65, 0.94)
    ret rgba(r, g, b, a)
  let r = (glassHex / 65536) % 256
  let g = (glassHex / 256) % 256
  let b = glassHex % 256
  ret rgba(r, g, b, 0.86)

/// Derives a perceptually uniform `AuraTheme` from a single `AuraSeedToken` using Radix 12-step OKLCH scales and APCA contrast.
pub fn auraDeriveThemeFromSeed(seed: AuraSeedToken): AuraTheme:
  let pScale = generateRadix12Scale(seed.primaryHex, seed.isDark)
  let sScale = generateRadix12Scale(seed.secondaryHex, seed.isDark)
  let tScale = generateRadix12Scale(seed.tertiaryHex, seed.isDark)
  let nScale = generateRadix12Scale(seed.neutralHex, seed.isDark)
  let rScale = maxFloat(0.25, seed.radiusScale)
  let sHex = if seed.isDark: 0x22C55E else: 0x16A34A
  let wHex = if seed.isDark: 0xF59E0B else: 0xD97706
  let dHex = if seed.isDark: 0xEF4444 else: 0xDC2626
  ret AuraTheme(
    name = seed.name,
    bgCanvas = nScale.s1,
    surface0 = nScale.s2,
    surface1 = nScale.s3,
    surface2 = nScale.s4,
    surface3 = nScale.s5,
    surfaceGlass = nScale.s3,
    outline = nScale.s7,
    outlineVariant = nScale.s6,
    scrim = if seed.isDark: 0x020408B0 else: 0x0F172A80,
    primary = pScale.s9,
    onPrimary = autoContrastForegroundHex(pScale.s9),
    primaryContainer = pScale.s3,
    secondary = sScale.s9,
    onSecondary = autoContrastForegroundHex(sScale.s9),
    secondaryContainer = sScale.s3,
    tertiary = tScale.s9,
    textPrimary = nScale.s12,
    textSecondary = nScale.s11,
    textMuted = nScale.s8,
    success = sHex,
    onSuccess = autoContrastForegroundHex(sHex),
    warning = wHex,
    onWarning = autoContrastForegroundHex(wHex),
    danger = dHex,
    onDanger = autoContrastForegroundHex(dHex),
    info = if seed.isDark: 0x3B82F6 else: 0x2563EB,
    radiusSm = 6.0 * rScale,
    radiusMd = 10.0 * rScale,
    radiusLg = 16.0 * rScale
  )

/// Bridges `AuraTheme` to `SemanticPalette` (`std/theme`) including Material 3 surface containers.
pub fn auraThemeToSemanticPalette(theme: AuraTheme): SemanticPalette:
  ret SemanticPalette(
    bgPrimary = theme.bgCanvas,
    bgSurface = theme.surface0,
    fgPrimary = theme.textPrimary,
    fgMuted = theme.textMuted,
    accent = theme.primary,
    focusRing = theme.secondary,
    surfaceContainerLowest = theme.bgCanvas,
    surfaceContainerLow = theme.surface0,
    surfaceContainer = theme.surface1,
    surfaceContainerHigh = theme.surface2,
    surfaceContainerHighest = theme.surface3
  )

/// Bridges `SemanticPalette` (`std/theme`) back to `AuraTheme`.
pub fn semanticPaletteToAuraTheme(pal: SemanticPalette, name: str = "semantic"): AuraTheme:
  ret AuraTheme(
    name = name,
    bgCanvas = pal.bgPrimary,
    surface0 = pal.bgSurface,
    surface1 = pal.surfaceContainer,
    surface2 = pal.surfaceContainerHigh,
    surface3 = pal.surfaceContainerHighest,
    surfaceGlass = pal.surfaceContainer,
    outline = pal.surfaceContainerHighest,
    outlineVariant = pal.surfaceContainerHigh,
    scrim = 0x020408B0,
    primary = pal.accent,
    onPrimary = autoContrastForegroundHex(pal.accent),
    primaryContainer = pal.surfaceContainer,
    secondary = pal.focusRing,
    onSecondary = autoContrastForegroundHex(pal.focusRing),
    secondaryContainer = pal.surfaceContainerLow,
    tertiary = pal.accent,
    textPrimary = pal.fgPrimary,
    textSecondary = pal.fgMuted,
    textMuted = pal.fgMuted,
    success = 0x22C55E,
    onSuccess = 0x052E16,
    warning = 0xF59E0B,
    onWarning = 0x451A03,
    danger = 0xEF4444,
    onDanger = 0xFFFFFF,
    info = 0x3B82F6,
    radiusSm = 6.0,
    radiusMd = 10.0,
    radiusLg = 16.0
  )

/// Renders a single line of rich `TextSpan` runs (`std/richtext`) and returns the total advance width.
pub fn auraRichTextLine(ctx: AuraContext, spans: [TextSpan], x: float, y: float): float:
  mut curX = x
  mut i = 0
  while i < spans.len:
    let sp = spans[i]
    let scale = maxFloat(0.4, sp.fontSize / 14.0)
    let colHex = if sp.colorHex != 0: sp.colorHex else: ctx.theme.textPrimary
    drawText(sp.text, curX, y, scale, colorHex(colHex))
    curX = curX + float(sp.text.len) * sp.fontSize * 0.6
    i += 1
  ret measureRichLineWidth(spans)

pub fn auraBeginFrame(ctx: AuraContext): AuraContext:
  let mx = getMouseX()
  let my = getMouseY()
  let mDown = isMouseButtonDown(0)
  let mClicked = isMouseButtonPressed(0)
  let wy = mouseWheelY()
  let typed = getTextInput()
  mut nextActive = ctx.activeId
  let storedActive = ctx.uiState.get("activeId").unwrapOr("")
  if nextActive.len == 0 and storedActive.len > 0:
    nextActive = storedActive
  if not mDown and not nextActive.endsWith(":select_all"):
    nextActive = ""
    ctx.uiState.set("activeId", "")
  mut nextFocused = ctx.focusedId
  let storedFocused = ctx.uiState.get("focusedId").unwrapOr("")
  if storedFocused.len > 0 and nextFocused.len == 0:
    nextFocused = storedFocused
  ctx.hotId = ""
  ctx.activeId = nextActive
  ctx.focusedId = nextFocused
  ctx.mouseX = mx
  ctx.mouseY = my
  ctx.mouseDown = mDown
  ctx.mouseClicked = mClicked
  ctx.wheelY = wy
  ctx.textInput = typed
  ctx.cursorX = 0.0
  ctx.cursorY = 0.0
  ctx.layoutDir = "column"
  ctx.layoutGap = 8.0
  ret ctx

/// Begins an AuraDS frame with automatic `AspectViewport` mouse coordinate unprojection (`std/viewport`).
pub fn auraBeginFrameWithViewport(ctx: AuraContext, vp: AspectViewport): AuraContext:
  let base = auraBeginFrame(ctx)
  base.mouseX = unprojectMouseX(vp, base.mouseX)
  base.mouseY = unprojectMouseY(vp, base.mouseY)
  ret base

/// Cycles keyboard focus across `focusOrder` widget IDs using `cycleFocusIndex` (`std/accessibility`).
pub fn auraCycleKeyboardFocus(mut ctx: AuraContext, focusOrder: [str], reverse: bool): AuraContext:
  if focusOrder.len == 0:
    ret ctx
  mut curIdx = -1
  mut i = 0
  while i < focusOrder.len:
    if focusOrder[i] == ctx.focusedId:
      curIdx = i
    i += 1
  let nextIdx = if curIdx < 0: 0 else: cycleFocusIndex(curIdx, focusOrder.len, reverse)
  ctx.focusedId = focusOrder[nextIdx]
  ctx.uiState.set("focusedId", ctx.focusedId)
  ret ctx

/// Renders a high-contrast 2px keyboard focus ring around `rect` when `ctx.focusedId == id`.
pub fn auraDrawWidgetFocusRing(ctx: AuraContext, id: str, rect: AuraRect): void:
  if ctx.focusedId == id:
    drawRoundedRectOutline(rect.x - 2.0, rect.y - 2.0, rect.w + 4.0, rect.h + 4.0, ctx.theme.radiusSm + 2.0, 2.0, colorHex(ctx.theme.secondary))
  ret

/// Renders a unified real-time telemetry ribbon showing FPS, frame latency (`ms`), and active widget count.
pub fn auraTelemetryRibbon(ctx: AuraContext, rect: AuraRect, fps: float, frameTimeMs: float, activeWidgets: int): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let fpsInt = int(fps + 0.5)
  let msTenths = int(frameTimeMs * 10.0 + 0.5)
  let msWhole = msTenths / 10
  let msFrac = msTenths % 10
  let statusCol = if fps >= 55.0: ctx.theme.success elif fps >= 30.0: ctx.theme.warning else: ctx.theme.danger
  drawCircle(rect.x + 12.0, rect.y + rect.h * 0.5, 4.0, colorHex(statusCol))
  drawText("FPS: {fpsInt}  |  Frame: {msWhole}.{msFrac} ms  |  Widgets: {activeWidgets}", rect.x + 24.0, rect.y + (rect.h - 10.0) * 0.5, 0.80, colorHex(ctx.theme.textPrimary))
  ret

/// Flushes all deferred Z-layer popup overlays (dropdowns, comboboxes, tooltips) on top of base widgets.
pub fn auraEndFrame(ctx: AuraContext):
  let keys = ctx.zOverlays.keys()
  mut k = 0
  while k < keys.len:
    let key = keys[k]
    let ovOpt = ctx.zOverlays.get(key)
    if ovOpt.isSome():
      let ov = ovOpt.unwrap()
      if ov.kind == "dropdown" or ov.kind == "combobox":
        let itemH = 26.0
        let menuH = float(ov.options.len) * itemH + 8.0
        let menuY = ov.rect.y
        drawRoundedRect(ov.rect.x, menuY + 3.0, ov.rect.w, menuH, ctx.theme.radiusSm, rgba(0, 0, 0, 0.28))
        drawRoundedRect(ov.rect.x, menuY, ov.rect.w, menuH, ctx.theme.radiusSm, colorHex(ctx.theme.surface2))
        drawRoundedRectOutline(ov.rect.x, menuY, ov.rect.w, menuH, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.primary))
        mut oi = 0
        while oi < ov.options.len:
          let itemRect = AuraRect(x = ov.rect.x + 4.0, y = menuY + 4.0 + float(oi) * itemH, w = ov.rect.w - 8.0, h = itemH - 2.0)
          if oi == ov.selectedIdx:
            drawRoundedRect(itemRect.x, itemRect.y, itemRect.w, itemRect.h, 4.0, colorHex(ctx.theme.primaryContainer))
          elif auraPointInRect(ctx.mouseX, ctx.mouseY, itemRect):
            drawRoundedRect(itemRect.x, itemRect.y, itemRect.w, itemRect.h, 4.0, colorHex(ctx.theme.surface3))
          drawText(ov.options[oi], itemRect.x + 8.0, itemRect.y + 6.0, 0.85, colorHex(ctx.theme.textPrimary))
          oi += 1
      elif ov.kind == "tooltip":
        drawRoundedRect(ov.rect.x, ov.rect.y + 2.0, ov.rect.w, ov.rect.h, 4.0, rgba(0, 0, 0, 0.25))
        drawRoundedRect(ov.rect.x, ov.rect.y, ov.rect.w, ov.rect.h, 4.0, colorHex(ctx.theme.surface3))
        drawTextCentered(ov.text, ov.rect.x + ov.rect.w * 0.5, ov.rect.y + 6.0, 0.8, colorHex(ctx.theme.textPrimary))
    let _rem = ctx.zOverlays.remove(key)
    k += 1
  ret

pub fn auraPointInRect(px: float, py: float, r: AuraRect): bool:
  ret px >= r.x and px <= r.x + r.w and py >= r.y and py <= r.y + r.h

pub fn auraIsHovered(ctx: AuraContext, r: AuraRect): bool:
  ret auraPointInRect(ctx.mouseX, ctx.mouseY, r) or isMouseInRect(r.x, r.y, r.w, r.h)

pub fn auraIsClicked(ctx: AuraContext, r: AuraRect): bool:
  ret (ctx.mouseClicked and auraPointInRect(ctx.mouseX, ctx.mouseY, r)) or isRectClicked(r.x, r.y, r.w, r.h)

// =============================================================================
// 13.2 Layout, Windowing & Container Architecture
// =============================================================================

/// Returns the responsive bounding rectangle matching the active window dimensions.
pub fn auraWindowRect(): AuraRect:
  ret AuraRect(x = 0.0, y = 0.0, w = float(getScreenWidth()), h = float(getScreenHeight()))

/// Computes the responsive content area inside current window dimensions excluding top bar and outer padding.
pub fn auraContentRect(topBarH: float, pad: float): AuraRect:
  let sw = float(getScreenWidth())
  let sh = float(getScreenHeight())
  ret AuraRect(x = pad, y = topBarH + pad, w = sw - pad * 2.0, h = sh - topBarH - pad * 2.0)

/// Computes the index-th horizontal flex cell inside container with gap spacing.
pub fn auraFlexRow(container: AuraRect, count: int, index: int, gap: float): AuraRect:
  mut safeCount = count
  if safeCount < 1:
    safeCount = 1
  let totalGap = float(safeCount - 1) * gap
  let cellW = (container.w - totalGap) / float(safeCount)
  let cellX = container.x + float(index) * (cellW + gap)
  ret AuraRect(x = cellX, y = container.y, w = cellW, h = container.h)

/// Computes the index-th vertical flex cell inside container with gap spacing.
pub fn auraFlexCol(container: AuraRect, count: int, index: int, gap: float): AuraRect:
  mut safeCount = count
  if safeCount < 1:
    safeCount = 1
  let totalGap = float(safeCount - 1) * gap
  let cellH = (container.h - totalGap) / float(safeCount)
  let cellY = container.y + float(index) * (cellH + gap)
  ret AuraRect(x = container.x, y = cellY, w = container.w, h = cellH)

/// Computes a responsive 2D grid cell inside container.
pub fn auraGridCell(container: AuraRect, cols: int, rows: int, col: int, row: int, gap: float): AuraRect:
  mut safeCols = cols
  if safeCols < 1:
    safeCols = 1
  mut safeRows = rows
  if safeRows < 1:
    safeRows = 1
  let totalGapX = float(safeCols - 1) * gap
  let totalGapY = float(safeRows - 1) * gap
  let cellW = (container.w - totalGapX) / float(safeCols)
  let cellH = (container.h - totalGapY) / float(safeRows)
  let cx = container.x + float(col) * (cellW + gap)
  let cy = container.y + float(row) * (cellH + gap)
  ret AuraRect(x = cx, y = cy, w = cellW, h = cellH)

/// Computes index-based grid cell inside container with cell height.
pub fn auraGridCellIndexed(rect: AuraRect, cols: int, idx: int, cellH: float, gap: float): AuraRect:
  mut safeCols = cols
  if safeCols < 1:
    safeCols = 1
  let col = idx % safeCols
  let row = idx / safeCols
  let totalGap = float(safeCols - 1) * gap
  let cellW = (rect.w - totalGap) / float(safeCols)
  let cx = rect.x + float(col) * (cellW + gap)
  let cy = rect.y + float(row) * (cellH + gap)
  ret AuraRect(x = cx, y = cy, w = cellW, h = cellH)

/// Splits container horizontally into responsive left and right panes.
pub fn auraSplitHorizontal(container: AuraRect, leftRatio: float, gap: float, isLeft: bool): AuraRect:
  let totalW = container.w - gap
  let leftW = totalW * leftRatio
  let rightW = totalW - leftW
  if isLeft:
    ret AuraRect(x = container.x, y = container.y, w = leftW, h = container.h)
  ret AuraRect(x = container.x + leftW + gap, y = container.y, w = rightW, h = container.h)

/// Clears the active canvas framebuffer using AuraDS MD3 dark canvas background color.
pub fn auraClearBackground():
  clearScreen(colorHex(0x0B0F19))
  ret

/// Begins an elevated collision-free flow-managed container with default dark theme.
pub fn auraContainerBegin(title: str, x: float, y: float, w: float, h: float, pad: float, gap: float): AuraFlowContainer:
  let theme = auraThemeDark()
  ret auraContainerBeginWithTheme(theme, title, x, y, w, h, pad, gap, false)

/// Begins an elevated collision-free flow-managed container with custom theme and optional clipping.
pub fn auraContainerBeginWithTheme(theme: AuraTheme, title: str, x: float, y: float, w: float, h: float, pad: float, gap: float, clip: bool): AuraFlowContainer:
  drawRoundedRect(x, y + 2.0, w, h, theme.radiusMd, rgba(0, 0, 0, 0.15))
  drawRoundedRect(x, y + 4.0, w, h, theme.radiusMd, rgba(0, 0, 0, 0.28))
  drawRoundedRect(x, y, w, h, theme.radiusMd, colorHex(theme.surface1))
  drawRoundedRect(x + 1.0, y + 1.0, w - 2.0, 1.0, theme.radiusMd, rgba(255, 255, 255, 0.07))
  drawRoundedRectOutline(x, y, w, h, theme.radiusMd, 1.0, colorHex(theme.outlineVariant))
  if clip:
    let _sc = pushScissor(UiCanvas(width = w, height = h, scissorStack = []), ScissorRect(x = int(x + 2.0), y = int(y + 2.0), w = int(w - 4.0), h = int(h - 4.0)))
  mut curX = x + pad
  mut curY = y + pad
  mut botY = y + pad
  if title != "":
    drawText(title, x + pad, y + pad, 1.05, colorHex(theme.textPrimary))
    let th = measureTextHeight(title, 1.05)
    drawLine(x + pad, y + pad + th + 4.0, x + w - pad, y + pad + th + 4.0, colorHex(theme.outlineVariant), 1.0)
    curY = y + pad + th + gap + 6.0
    botY = curY
  ret AuraFlowContainer(
    x = x, y = y, w = w, h = h,
    padX = pad, padY = pad,
    gapX = gap, gapY = gap,
    cursorX = curX, cursorY = curY,
    rowMaxH = 0.0, contentBottomY = botY,
    clip = clip, elevated = true,
    surface1 = theme.surface1,
    outlineVariant = theme.outlineVariant,
    radiusMd = theme.radiusMd
  )

/// Advances container cursor to a fresh row.
pub fn auraContainerNewLine(c: AuraFlowContainer): AuraFlowContainer:
  let nextY = c.cursorY + (if c.rowMaxH > 0.0: c.rowMaxH + c.gapY else: 0.0)
  ret AuraFlowContainer(
    x = c.x, y = c.y, w = c.w, h = c.h,
    padX = c.padX, padY = c.padY,
    gapX = c.gapX, gapY = c.gapY,
    cursorX = c.x + c.padX, cursorY = nextY,
    rowMaxH = 0.0, contentBottomY = c.contentBottomY,
    clip = c.clip, elevated = c.elevated,
    surface1 = c.surface1,
    outlineVariant = c.outlineVariant,
    radiusMd = c.radiusMd
  )

/// Allocates bounding space for an item in flow layout, automatically wrapping lines if necessary.
pub fn auraContainerAllocate(c: AuraFlowContainer, itemW: float, itemH: float): [float]:
  if (c.cursorX + itemW > c.x + c.w - c.padX) and (c.cursorX > c.x + c.padX):
    let cx = c.x + c.padX
    let cy = c.cursorY + c.rowMaxH + c.gapY
    let rmh = itemH
    let nextCursorX = cx + itemW + c.gapX
    let nextBottom = if cy + itemH + c.padY > c.contentBottomY: cy + itemH + c.padY else: c.contentBottomY
    ret [cx, cy, nextCursorX, cy, rmh, nextBottom]
  let cx = c.cursorX
  let cy = c.cursorY
  let rmh = if itemH > c.rowMaxH: itemH else: c.rowMaxH
  let nextCursorX = cx + itemW + c.gapX
  let nextBottom = if cy + itemH + c.padY > c.contentBottomY: cy + itemH + c.padY else: c.contentBottomY
  ret [cx, cy, nextCursorX, cy, rmh, nextBottom]

/// Updates container flow cursor after layout allocation.
pub fn auraContainerNext(c: AuraFlowContainer, itemW: float, itemH: float): AuraFlowContainer:
  let alloc = auraContainerAllocate(c, itemW, itemH)
  ret AuraFlowContainer(
    x = c.x, y = c.y, w = c.w, h = c.h,
    padX = c.padX, padY = c.padY,
    gapX = c.gapX, gapY = c.gapY,
    cursorX = alloc[2], cursorY = alloc[3],
    rowMaxH = alloc[4], contentBottomY = alloc[5],
    clip = c.clip, elevated = c.elevated,
    surface1 = c.surface1,
    outlineVariant = c.outlineVariant,
    radiusMd = c.radiusMd
  )

/// Returns item AuraRect allocated within the container.
pub fn auraContainerLastRect(c: AuraFlowContainer, itemW: float, itemH: float): AuraRect:
  let alloc = auraContainerAllocate(c, itemW, itemH)
  ret AuraRect(x = alloc[0], y = alloc[1], w = itemW, h = itemH)

/// Renders non-overlapping text inside a flow container, auto-wrapping if necessary.
pub fn auraFlowText(c: AuraFlowContainer, theme: AuraTheme, text: str, fontSize: float, col: Color): AuraFlowContainer:
  let maxW = c.w - c.padX * 2.0
  let totalW = measureTextWidthPx(text, fontSize)
  let lineH = measureTextHeight("A", fontSize) + 4.0

  if totalW > maxW and maxW > 40.0:
    mut cx = c.cursorX
    mut cy = c.cursorY
    if c.cursorX > c.x + c.padX:
      cx = c.x + c.padX
      cy = c.cursorY + c.rowMaxH + c.gapY

    let words = text.split(" ")
    mut lines: [str] = []
    mut curLine = ""
    mut i = 0
    while i < words.len:
      let word = words[i]
      if word.len > 0:
        let testLine = if curLine.len == 0: word else: curLine + " " + word
        if measureTextWidthPx(testLine, fontSize) <= maxW:
          curLine = testLine
        else:
          if curLine.len > 0:
            lines.push(curLine)
          curLine = word
      i = i + 1
    if curLine.len > 0:
      lines.push(curLine)

    mut lineIdx = 0
    while lineIdx < lines.len:
      drawText(lines[lineIdx], cx, cy + float(lineIdx) * lineH, fontSize, col)
      lineIdx = lineIdx + 1

    let totalH = float(lines.len) * lineH
    let nextBottom = if cy + totalH + c.padY > c.contentBottomY: cy + totalH + c.padY else: c.contentBottomY
    ret AuraFlowContainer(
      x = c.x, y = c.y, w = c.w, h = c.h,
      padX = c.padX, padY = c.padY,
      gapX = c.gapX, gapY = c.gapY,
      cursorX = c.x + c.padX,
      cursorY = cy + totalH + c.gapY,
      rowMaxH = 0.0,
      contentBottomY = nextBottom,
      clip = c.clip, elevated = c.elevated,
      surface1 = c.surface1,
      outlineVariant = c.outlineVariant,
      radiusMd = c.radiusMd
    )

  let h = measureTextHeight(text, fontSize) + 4.0
  let alloc = auraContainerAllocate(c, totalW, h)
  drawText(text, alloc[0], alloc[1], fontSize, col)
  ret AuraFlowContainer(
    x = c.x, y = c.y, w = c.w, h = c.h,
    padX = c.padX, padY = c.padY,
    gapX = c.gapX, gapY = c.gapY,
    cursorX = alloc[2], cursorY = alloc[3],
    rowMaxH = alloc[4], contentBottomY = alloc[5],
    clip = c.clip, elevated = c.elevated,
    surface1 = c.surface1,
    outlineVariant = c.outlineVariant,
    radiusMd = c.radiusMd
  )

/// Renders a collision-free badge within a flow container.
pub fn auraFlowBadge(c: AuraFlowContainer, theme: AuraTheme, label: str, bgCol: Color, fgCol: Color): AuraFlowContainer:
  let w = measureTextWidthPx(label, 0.85) + 20.0
  let h = 22.0
  let alloc = auraContainerAllocate(c, w, h)
  drawRoundedRect(alloc[0], alloc[1] + 1.0, w, h, h * 0.5, rgba(0, 0, 0, 0.20))
  drawRoundedRect(alloc[0], alloc[1], w, h, h * 0.5, bgCol)
  drawRoundedRectOutline(alloc[0], alloc[1], w, h, h * 0.5, 1.0, rgba(255, 255, 255, 0.15))
  let textH = measureTextHeight(label, 0.85)
  drawTextCentered(label, alloc[0] + w * 0.5, alloc[1] + (h - textH) * 0.5, 0.85, fgCol)
  ret AuraFlowContainer(
    x = c.x, y = c.y, w = c.w, h = c.h,
    padX = c.padX, padY = c.padY,
    gapX = c.gapX, gapY = c.gapY,
    cursorX = alloc[2], cursorY = alloc[3],
    rowMaxH = alloc[4], contentBottomY = alloc[5],
    clip = c.clip, elevated = c.elevated,
    surface1 = c.surface1,
    outlineVariant = c.outlineVariant,
    radiusMd = c.radiusMd
  )

/// Renders a responsive button inside a flow container with auto-wrapping.
pub fn auraFlowButton(c: AuraFlowContainer, ctx: AuraContext, theme: AuraTheme, id: str, label: str, variant: int): AuraFlowContainer:
  let tw = measureTextWidthPx(label, 1.0) + 28.0
  let w = if tw > 72.0: tw else: 72.0
  let h = 34.0
  let alloc = auraContainerAllocate(c, w, h)
  let btnRect = AuraRect(x = alloc[0], y = alloc[1], w = w, h = h)
  let varStr = if variant == 1: "outlined" elif variant == 2: "tonal" elif variant == 3: "elevated" elif variant == 4: "ghost" elif variant == 5: "danger" else: "filled"
  auraButton(ctx, id, btnRect, label, varStr)
  ret AuraFlowContainer(
    x = c.x, y = c.y, w = c.w, h = c.h,
    padX = c.padX, padY = c.padY,
    gapX = c.gapX, gapY = c.gapY,
    cursorX = alloc[2], cursorY = alloc[3],
    rowMaxH = alloc[4], contentBottomY = alloc[5],
    clip = c.clip, elevated = c.elevated,
    surface1 = c.surface1,
    outlineVariant = c.outlineVariant,
    radiusMd = c.radiusMd
  )

/// Concludes flow container rendering, popping scissor clip if enabled, auto-expanding background + border bounds if content grew, and returning content height.
pub fn auraContainerEnd(c: AuraFlowContainer): float:
  if c.clip:
    let _sc = popScissor(UiCanvas(width = c.w, height = c.h, scissorStack = []))
  let usedH = c.contentBottomY - c.y
  if c.elevated and not c.clip and usedH > c.h:
    let extY = if c.h > c.radiusMd: c.y + c.h - c.radiusMd else: c.y
    let extH = (c.y + usedH) - extY
    drawRoundedRect(c.x, extY, c.w, extH, c.radiusMd, colorHex(c.surface1))
    drawRoundedRectOutline(c.x, c.y, c.w, usedH, c.radiusMd, 1.0, colorHex(c.outlineVariant))
  ret usedH

pub fn auraRowBegin(mut ctx: AuraContext, x: float, y: float, gap: float): AuraContext:
  ctx.cursorX = x
  ctx.cursorY = y
  ctx.layoutDir = "row"
  ctx.layoutGap = gap
  ret ctx

pub fn auraColumnBegin(mut ctx: AuraContext, x: float, y: float, gap: float): AuraContext:
  ctx.cursorX = x
  ctx.cursorY = y
  ctx.layoutDir = "column"
  ctx.layoutGap = gap
  ret ctx

pub fn auraNextRect(mut ctx: AuraContext, w: float, h: float): AuraRect:
  let r = AuraRect(x = ctx.cursorX, y = ctx.cursorY, w = w, h = h)
  if ctx.layoutDir == "row":
    ctx.cursorX = ctx.cursorX + w + ctx.layoutGap
  else:
    ctx.cursorY = ctx.cursorY + h + ctx.layoutGap
  ret r

pub fn auraScrollAreaBegin(mut ctx: AuraContext, id: str, rect: AuraRect, contentHeight: float): float:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  mut offset = ctx.scrollOffsets.get(id).unwrapOr(0.0)
  if auraIsHovered(ctx, rect) and ctx.wheelY != 0.0:
    offset = offset - ctx.wheelY * 24.0
  mut maxScroll = contentHeight - rect.h
  if maxScroll < 0.0:
    maxScroll = 0.0
  if offset < 0.0:
    offset = 0.0
  if offset > maxScroll:
    offset = maxScroll
  ctx.scrollOffsets.set(id, offset)
  let _sc = pushScissor(UiCanvas(width = rect.w, height = rect.h, scissorStack = []), ScissorRect(x = int(rect.x), y = int(rect.y), w = int(rect.w), h = int(rect.h)))
  if maxScroll > 0.0 and contentHeight > 0.0:
    let trackX = rect.x + rect.w - 6.0
    drawRoundedRect(trackX, rect.y + 2.0, 4.0, rect.h - 4.0, 2.0, colorHex(ctx.theme.surface2))
    let availTrack = maxFloat(1.0, rect.h - 4.0)
    mut thumbH = (rect.h / contentHeight) * availTrack
    if thumbH < 18.0:
      thumbH = 18.0
    if thumbH > availTrack:
      thumbH = availTrack
    let thumbY = rect.y + 2.0 + (offset / maxScroll) * maxFloat(0.0, availTrack - thumbH)
    drawRoundedRect(trackX, thumbY, 4.0, thumbH, 2.0, colorHex(ctx.theme.primary))
  ret offset

pub fn auraScrollAreaEnd():
  let _sc = popScissor(UiCanvas(width = 0.0, height = 0.0, scissorStack = []))
  ret

pub fn auraAppBar(ctx: AuraContext, rect: AuraRect, title: str, subtitle: str):
  // Bottom elevation shadow
  drawRect(rect.x, rect.y + rect.h, rect.w, 3.0, rgba(0, 0, 0, 0.18))
  drawRect(rect.x, rect.y + rect.h - 1.0, rect.w, 1.0, rgba(0, 0, 0, 0.35))
  // Surface fill & specular top edge
  drawRect(rect.x, rect.y, rect.w, rect.h, colorHex(ctx.theme.surface1))
  drawRect(rect.x, rect.y, rect.w, 1.0, rgba(255, 255, 255, 0.08))
  drawRect(rect.x, rect.y + rect.h - 1.0, rect.w, 1.0, colorHex(ctx.theme.outlineVariant))
  // Glowing primary Material 3 brand orb + inner highlight dot
  let orbX = rect.x + 22.0
  let orbY = rect.y + rect.h * 0.5
  drawCircle(orbX, orbY, 11.0, rgba(0, 0, 0, 0.25))
  drawCircle(orbX, orbY, 7.5, colorHex(ctx.theme.primary))
  drawCircle(orbX - 2.0, orbY - 2.0, 2.5, colorHex(ctx.theme.onPrimary))
  // Crisp title
  let titleH = measureTextHeight(title, 1.1)
  drawText(title, rect.x + 40.0, rect.y + (rect.h - titleH) * 0.5, 1.1, colorHex(ctx.theme.textPrimary))
  // Right-aligned subtitle pill badge so it never collides with title
  if subtitle.len > 0:
    let subW = measureTextWidthPx(subtitle, 0.8) + 16.0
    let subH = 22.0
    let subX = rect.x + rect.w - subW - 16.0
    let subY = rect.y + (rect.h - subH) * 0.5
    drawRoundedRect(subX, subY, subW, subH, subH * 0.5, colorHex(ctx.theme.surface2))
    drawRoundedRectOutline(subX, subY, subW, subH, subH * 0.5, 1.0, colorHex(ctx.theme.outlineVariant))
    let subTextH = measureTextHeight(subtitle, 0.8)
    drawTextCentered(subtitle, subX + subW * 0.5, subY + (subH - subTextH) * 0.5, 0.8, colorHex(ctx.theme.textSecondary))
  ret

pub fn auraCard(ctx: AuraContext, rect: AuraRect):
  // 2-layer soft Material 3 elevation shadow
  drawRoundedRect(rect.x, rect.y + 2.0, rect.w, rect.h, ctx.theme.radiusMd, rgba(0, 0, 0, 0.15))
  drawRoundedRect(rect.x, rect.y + 4.0, rect.w, rect.h, ctx.theme.radiusMd, rgba(0, 0, 0, 0.28))
  // surface1 rounded fill
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, colorHex(ctx.theme.surface1))
  // subtle top specular highlight line
  drawRoundedRect(rect.x + 1.0, rect.y + 1.0, rect.w - 2.0, 1.0, ctx.theme.radiusMd, rgba(255, 255, 255, 0.07))
  // outlineVariant rounded border
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, 1.0, colorHex(ctx.theme.outlineVariant))
  ret

pub fn auraStatCard(ctx: AuraContext, rect: AuraRect, title: str, value: str, trend: str, positive: bool):
  auraCard(ctx, rect)
  // Top accent bar
  drawRoundedRect(rect.x + 10.0, rect.y + 2.0, rect.w - 20.0, 3.0, 1.5, colorHex(ctx.theme.primary))
  // Muted label
  drawText(title, rect.x + 16.0, rect.y + 14.0, 0.85, colorHex(ctx.theme.textMuted))
  // Bold value
  drawText(value, rect.x + 16.0, rect.y + 36.0, 1.35, colorHex(ctx.theme.textPrimary))
  // Trend pill badge
  if trend.len > 0:
    mut trCol = ctx.theme.danger
    if positive:
      trCol = ctx.theme.success
    let trW = measureTextWidthPx(trend, 0.8) + 14.0
    let trH = 20.0
    let trX = rect.x + rect.w - trW - 14.0
    let trY = rect.y + rect.h - trH - 12.0
    drawRoundedRect(trX, trY, trW, trH, trH * 0.5, colorHex(trCol))
    drawTextCentered(trend, trX + trW * 0.5, trY + 3.0, 0.8, colorHex(ctx.theme.onPrimary))
  ret

pub fn auraProgressBar(ctx: AuraContext, x: float, y: float, w: float, h: float, progress: float, color: int):
  let p = clampFloat(progress, 0.0, 1.0)
  let rad = h * 0.5
  drawRoundedRect(x, y, w, h, rad, colorHex(ctx.theme.surface2))
  if p > 0.0:
    let fillW = maxFloat(h, w * p)
    drawRoundedRect(x, y, fillW, h, rad, colorHex(color))
  ret

pub fn auraTabs(ctx: AuraContext, id: str, rect: AuraRect, tabs: [str], activeIdx: int): int:
  ret auraTabBar(ctx, id, rect, tabs, activeIdx)

pub fn auraNavigationRail(ctx: AuraContext, rect: AuraRect, items: [str], activeIdx: int): int:
  drawRect(rect.x, rect.y, rect.w, rect.h, colorHex(ctx.theme.surface0))
  drawRect(rect.x + rect.w - 1.0, rect.y, 1.0, rect.h, colorHex(ctx.theme.outlineVariant))
  mut selected = activeIdx
  mut i = 0
  let itemH = 52.0
  while i < items.len:
    let iy = rect.y + 12.0 + float(i) * (itemH + 6.0)
    let itemRect = AuraRect(x = rect.x + 6.0, y = iy, w = rect.w - 12.0, h = itemH)
    if auraIsClicked(ctx, itemRect):
      selected = i
    if i == selected:
      drawRoundedRect(itemRect.x, itemRect.y, itemRect.w, itemRect.h, ctx.theme.radiusMd, colorHex(ctx.theme.primaryContainer))
      drawRoundedRect(rect.x, itemRect.y + 12.0, 3.0, itemRect.h - 24.0, 1.5, colorHex(ctx.theme.primary))
      drawTextCentered(items[i], rect.x + rect.w * 0.5, itemRect.y + itemRect.h * 0.5 - 5.0, 0.85, colorHex(ctx.theme.textPrimary))
    else:
      if auraIsHovered(ctx, itemRect):
        drawRoundedRect(itemRect.x, itemRect.y, itemRect.w, itemRect.h, ctx.theme.radiusMd, colorHex(ctx.theme.surface1))
      drawTextCentered(items[i], rect.x + rect.w * 0.5, itemRect.y + itemRect.h * 0.5 - 5.0, 0.85, colorHex(ctx.theme.textSecondary))
    i = i + 1
  ret selected

pub fn auraSidebarDrawer(ctx: AuraContext, rect: AuraRect, title: str, items: [str], activeIdx: int): int:
  drawRect(rect.x, rect.y, rect.w, rect.h, colorHex(ctx.theme.surface0))
  drawRect(rect.x + rect.w - 1.0, rect.y, 1.0, rect.h, colorHex(ctx.theme.outlineVariant))
  drawText(title, rect.x + 16.0, rect.y + 16.0, 0.95, colorHex(ctx.theme.textMuted))
  mut selected = activeIdx
  mut i = 0
  let rowH = 38.0
  while i < items.len:
    let ry = rect.y + 44.0 + float(i) * (rowH + 4.0)
    let rowRect = AuraRect(x = rect.x + 8.0, y = ry, w = rect.w - 16.0, h = rowH)
    if auraIsClicked(ctx, rowRect):
      selected = i
    if i == selected:
      drawRoundedRect(rowRect.x, rowRect.y, rowRect.w, rowRect.h, ctx.theme.radiusSm, colorHex(ctx.theme.primaryContainer))
      drawText(items[i], rowRect.x + 14.0, rowRect.y + 12.0, 0.9, colorHex(ctx.theme.textPrimary))
    else:
      if auraIsHovered(ctx, rowRect):
        drawRoundedRect(rowRect.x, rowRect.y, rowRect.w, rowRect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface1))
      drawText(items[i], rowRect.x + 14.0, rowRect.y + 12.0, 0.9, colorHex(ctx.theme.textSecondary))
    i = i + 1
  ret selected

pub fn auraSplitPane(ctx: AuraContext, id: str, rect: AuraRect, vertical: bool, ratio: float): (AuraRect, AuraRect):
  mut r = ratio
  if r < 0.1:
    r = 0.1
  if r > 0.9:
    r = 0.9
  let sash = 6.0
  if vertical:
    let firstW = (rect.w - sash) * r
    let secondW = rect.w - sash - firstW
    let sashX = rect.x + firstW
    drawRect(sashX, rect.y, sash, rect.h, colorHex(ctx.theme.surface2))
    drawRect(sashX + 2.0, rect.y + rect.h * 0.5 - 16.0, 2.0, 32.0, colorHex(ctx.theme.outline))
    let first = AuraRect(x = rect.x, y = rect.y, w = firstW, h = rect.h)
    let second = AuraRect(x = sashX + sash, y = rect.y, w = secondW, h = rect.h)
    ret (first, second)
  let firstH = (rect.h - sash) * r
  let secondH = rect.h - sash - firstH
  let sashY = rect.y + firstH
  drawRect(rect.x, sashY, rect.w, sash, colorHex(ctx.theme.surface2))
  drawRect(rect.x + rect.w * 0.5 - 16.0, sashY + 2.0, 32.0, 2.0, colorHex(ctx.theme.outline))
  let firstPane = AuraRect(x = rect.x, y = rect.y, w = rect.w, h = firstH)
  let secondPane = AuraRect(x = rect.x, y = sashY + sash, w = rect.w, h = secondH)
  ret (firstPane, secondPane)

pub fn auraWindow(ctx: AuraContext, id: str, title: str, rect: AuraRect): AuraRect:
  let headerH = 34.0
  drawRoundedRect(rect.x + 3.0, rect.y + 5.0, rect.w, rect.h, ctx.theme.radiusMd, auraScrimColor(ctx.theme.scrim))
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, colorHex(ctx.theme.surface1))
  drawRoundedRect(rect.x, rect.y, rect.w, headerH, ctx.theme.radiusMd, colorHex(ctx.theme.surface2))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, 1.0, colorHex(ctx.theme.outline))
  drawCircle(rect.x + rect.w - 18.0, rect.y + headerH * 0.5, 5.0, colorHex(ctx.theme.danger))
  drawCircle(rect.x + rect.w - 34.0, rect.y + headerH * 0.5, 5.0, colorHex(ctx.theme.warning))
  drawCircle(rect.x + rect.w - 50.0, rect.y + headerH * 0.5, 5.0, colorHex(ctx.theme.success))
  drawText(title, rect.x + 14.0, rect.y + 10.0, 0.95, colorHex(ctx.theme.textPrimary))
  ret AuraRect(x = rect.x + 8.0, y = rect.y + headerH + 8.0, w = rect.w - 16.0, h = rect.h - headerH - 16.0)

pub fn auraTabBar(ctx: AuraContext, id: str, rect: AuraRect, tabs: [str], activeIdx: int): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface1))
  drawRect(rect.x, rect.y + rect.h - 1.0, rect.w, 1.0, colorHex(ctx.theme.outlineVariant))
  if tabs.len == 0:
    ret activeIdx
  mut selected = activeIdx
  let tabW = rect.w / float(tabs.len)
  mut i = 0
  while i < tabs.len:
    let tx = rect.x + float(i) * tabW
    let tabRect = AuraRect(x = tx, y = rect.y, w = tabW, h = rect.h)
    if auraIsClicked(ctx, tabRect):
      selected = i
    let tabTextH = measureTextHeight(tabs[i], 0.9)
    if i == selected:
      drawTextCentered(tabs[i], tx + tabW * 0.5, rect.y + (rect.h - tabTextH) * 0.5, 0.9, colorHex(ctx.theme.primary))
      drawRoundedRect(tx + 8.0, rect.y + rect.h - 3.0, tabW - 16.0, 3.0, 1.5, colorHex(ctx.theme.primary))
    else:
      if auraIsHovered(ctx, tabRect):
        drawRect(tx, rect.y, tabW, rect.h - 1.0, colorHex(ctx.theme.surface2))
      drawTextCentered(tabs[i], tx + tabW * 0.5, rect.y + (rect.h - tabTextH) * 0.5, 0.9, colorHex(ctx.theme.textSecondary))
    i = i + 1
  ret selected

// =============================================================================
// 13.3 Rich Interactive Form Controls, IME Composition & Native Text Editing
// =============================================================================

pub struct AuraSemanticNode(id: str, role: str, label: str, value: str, focused: bool, rect: AuraRect)

/// Exports a semantic accessibility tree (`ARIA` roles on Web / structured node tree on Native).
pub fn auraExportSemanticTree(nodes: [AuraSemanticNode]): str:
  mut parts: [str] = []
  mut i = 0
  while i < nodes.len:
    let n = nodes[i]
    let focStr = if n.focused: "true" else: "false"
    let item = "{\"id\":\"" + n.id + "\",\"role\":\"" + n.role + "\",\"ariaLabel\":\"" + n.label + "\",\"value\":\"" + n.value + "\",\"focused\":" + focStr + ",\"bounds\":[" + str(int(n.rect.x)) + "," + str(int(n.rect.y)) + "," + str(int(n.rect.w)) + "," + str(int(n.rect.h)) + "]}"
    parts.push(item)
    i += 1
  ret "[" + parts.join(",") + "]"

/// Computes word-boundary cursor jump to the left (`Ctrl+Left`).
pub fn auraWordJumpLeft(text: str, cursor: int): int:
  mut pos = if cursor > text.len: text.len else: cursor
  if pos <= 0:
    ret 0
  while pos > 0 and text.charCodeAt(pos - 1) == 32:
    pos -= 1
  while pos > 0 and text.charCodeAt(pos - 1) != 32:
    pos -= 1
  ret pos

/// Computes word-boundary cursor jump to the right (`Ctrl+Right`).
pub fn auraWordJumpRight(text: str, cursor: int): int:
  let n = text.len
  mut pos = if cursor < 0: 0 else: cursor
  if pos >= n:
    ret n
  while pos < n and text.charCodeAt(pos) == 32:
    pos += 1
  while pos < n and text.charCodeAt(pos) != 32:
    pos += 1
  ret pos

pub struct AuraTextEditBuffer(text: str, cursor: int, selStart: int, selEnd: int, undoStack: [str], redoStack: [str])

pub fn auraTextEditNew(initialText: str): AuraTextEditBuffer:
  ret AuraTextEditBuffer(
    text = initialText,
    cursor = initialText.len,
    selStart = initialText.len,
    selEnd = initialText.len,
    undoStack = [],
    redoStack = []
  )

pub fn auraTextEditHasSelection(buf: AuraTextEditBuffer): bool:
  ret buf.selStart != buf.selEnd

pub fn auraTextEditSelectedText(buf: AuraTextEditBuffer): str:
  let lo = if buf.selStart < buf.selEnd: buf.selStart else: buf.selEnd
  let hi = if buf.selStart > buf.selEnd: buf.selStart else: buf.selEnd
  let safeLo = if lo < 0: 0 elif lo > buf.text.len: buf.text.len else: lo
  let safeHi = if hi < safeLo: safeLo elif hi > buf.text.len: buf.text.len else: hi
  ret buf.text.slice(safeLo, safeHi)

pub fn auraTextCharIndexAtX(text: str, textStartX: float, clickX: float, fontSize: float): int:
  if text.len == 0 or clickX <= textStartX:
    ret 0
  let relX = clickX - textStartX
  mut bestIdx = text.len
  mut prevW = 0.0
  mut i = 1
  while i <= text.len:
    let curW = measureTextWidthPx(text.slice(0, i), fontSize)
    let midW = (prevW + curW) * 0.5
    if relX < midW:
      ret i - 1
    prevW = curW
    i += 1
  ret bestIdx

pub fn auraTextEditInsert(mut buf: AuraTextEditBuffer, typed: str): AuraTextEditBuffer:
  if typed.len == 0:
    ret buf
  buf.undoStack.push(buf.text)
  buf.redoStack = []
  let rawLo = if buf.selStart < buf.selEnd: buf.selStart else: buf.selEnd
  let rawHi = if buf.selStart > buf.selEnd: buf.selStart else: buf.selEnd
  let lo = clampInt(rawLo, 0, buf.text.len)
  let hi = clampInt(rawHi, lo, buf.text.len)
  buf.cursor = clampInt(buf.cursor, 0, buf.text.len)
  let insPos = if lo != hi: lo else: buf.cursor
  let endPos = if lo != hi: hi else: buf.cursor
  let safeLo = if insPos < 0: 0 elif insPos > buf.text.len: buf.text.len else: insPos
  let safeHi = if endPos < safeLo: safeLo elif endPos > buf.text.len: buf.text.len else: endPos
  buf.text = buf.text.slice(0, safeLo) + typed + buf.text.slice(safeHi, buf.text.len)
  buf.cursor = safeLo + typed.len
  buf.selStart = buf.cursor
  buf.selEnd = buf.cursor
  ret buf

pub fn auraIsWordChar(code: int): bool:
  ret (code >= 48 and code <= 57) or (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or code == 95 or code >= 128

pub fn auraWordStartAt(text: str, idx: int): int:
  if text.len == 0:
    ret 0
  mut probe = if idx < 0: 0 elif idx >= text.len: text.len - 1 else: idx
  if not auraIsWordChar(text.charCodeAt(probe)) and probe > 0 and auraIsWordChar(text.charCodeAt(probe - 1)):
    probe -= 1
  if not auraIsWordChar(text.charCodeAt(probe)):
    ret 0
  mut lo = probe
  while lo > 0 and auraIsWordChar(text.charCodeAt(lo - 1)):
    lo -= 1
  ret lo

pub fn auraWordEndAt(text: str, idx: int): int:
  if text.len == 0:
    ret 0
  mut probe = if idx < 0: 0 elif idx >= text.len: text.len - 1 else: idx
  if not auraIsWordChar(text.charCodeAt(probe)) and probe > 0 and auraIsWordChar(text.charCodeAt(probe - 1)):
    probe -= 1
  if not auraIsWordChar(text.charCodeAt(probe)):
    ret text.len
  mut hi = probe + 1
  while hi < text.len and auraIsWordChar(text.charCodeAt(hi)):
    hi += 1
  ret hi

pub fn auraTextEditMouseSelect(mut buf: AuraTextEditBuffer, textStartX: float, clickX: float, fontSize: float, isClick: bool, isDrag: bool, isDoubleClick: bool, shiftHeld: bool): AuraTextEditBuffer:
  let idx = auraTextCharIndexAtX(buf.text, textStartX, clickX, fontSize)
  if isDoubleClick:
    let wLo = auraWordStartAt(buf.text, idx)
    let wHi = auraWordEndAt(buf.text, idx)
    if wLo < wHi:
      buf.selStart = wLo
      buf.selEnd = wHi
      buf.cursor = wHi
    else:
      buf.selStart = 0
      buf.selEnd = buf.text.len
      buf.cursor = buf.text.len
    ret buf
  if isClick:
    if shiftHeld:
      let anchor = if buf.cursor == buf.selEnd: buf.selStart else: buf.selEnd
      buf.selStart = if anchor < idx: anchor else: idx
      buf.selEnd = if anchor > idx: anchor else: idx
      buf.cursor = idx
    else:
      buf.selStart = idx
      buf.selEnd = idx
      buf.cursor = idx
    ret buf
  if isDrag:
    let anchor = if buf.cursor == buf.selEnd: buf.selStart else: buf.selEnd
    buf.selStart = if anchor < idx: anchor else: idx
    buf.selEnd = if anchor > idx: anchor else: idx
    buf.cursor = idx
  ret buf

pub fn auraTextEditApplyShortcut(mut buf: AuraTextEditBuffer, key: str, ctrlHeld: bool, shiftHeld: bool): AuraTextEditBuffer:
  let k = key.toUpper()
  let nLen = buf.text.len
  let rawLo = if buf.selStart < buf.selEnd: buf.selStart else: buf.selEnd
  let rawHi = if buf.selStart > buf.selEnd: buf.selStart else: buf.selEnd
  let loSel = clampInt(rawLo, 0, nLen)
  let hiSel = clampInt(rawHi, loSel, nLen)
  buf.cursor = clampInt(buf.cursor, 0, nLen)
  let hasSel = loSel < hiSel
  if ctrlHeld and k == "A":
    buf.selStart = 0
    buf.selEnd = buf.text.len
    buf.cursor = buf.text.len
    ret buf
  if ctrlHeld and k == "C":
    let lo = if hasSel: loSel else: 0
    let hi = if hasSel: hiSel else: buf.text.len
    setClipboardText(buf.text.slice(lo, hi))
    ret buf
  if ctrlHeld and k == "X":
    let lo = if hasSel: loSel else: 0
    let hi = if hasSel: hiSel else: buf.text.len
    setClipboardText(buf.text.slice(lo, hi))
    buf.undoStack.push(buf.text)
    buf.redoStack = []
    buf.text = buf.text.slice(0, lo) + buf.text.slice(hi, buf.text.len)
    buf.cursor = lo
    buf.selStart = lo
    buf.selEnd = lo
    ret buf
  if ctrlHeld and k == "V":
    let clip = getClipboardText()
    if clip.len > 0:
      buf.undoStack.push(buf.text)
      buf.redoStack = []
      let lo = if hasSel: loSel else: buf.cursor
      let hi = if hasSel: hiSel else: buf.cursor
      buf.text = buf.text.slice(0, lo) + clip + buf.text.slice(hi, buf.text.len)
      buf.cursor = lo + clip.len
      buf.selStart = buf.cursor
      buf.selEnd = buf.cursor
    ret buf
  if ctrlHeld and k == "Z":
    if buf.undoStack.len > 0:
      buf.redoStack.push(buf.text)
      buf.text = buf.undoStack.pop()
      buf.cursor = buf.text.len
      buf.selStart = buf.cursor
      buf.selEnd = buf.cursor
    elif buf.text.len > 0:
      buf.redoStack.push(buf.text)
      let prevIdx = auraWordJumpLeft(buf.text, buf.text.len)
      buf.text = buf.text.slice(0, prevIdx)
      buf.cursor = buf.text.len
      buf.selStart = buf.cursor
      buf.selEnd = buf.cursor
    ret buf
  if ctrlHeld and k == "Y":
    if buf.redoStack.len > 0:
      buf.undoStack.push(buf.text)
      buf.text = buf.redoStack.pop()
      buf.cursor = buf.text.len
      buf.selStart = buf.cursor
      buf.selEnd = buf.cursor
    ret buf
  if k == "LEFT" or k == "ARROWLEFT":
    let anchor = clampInt(if buf.cursor == buf.selEnd: buf.selStart else: buf.selEnd, 0, nLen)
    let nextPos = if ctrlHeld: auraWordJumpLeft(buf.text, buf.cursor) else: (if buf.cursor > 0: buf.cursor - 1 else: 0)
    if shiftHeld:
      buf.selStart = if anchor < nextPos: anchor else: nextPos
      buf.selEnd = if anchor > nextPos: anchor else: nextPos
      buf.cursor = nextPos
    elif hasSel and not ctrlHeld:
      buf.cursor = loSel
      buf.selStart = loSel
      buf.selEnd = loSel
    else:
      buf.cursor = nextPos
      buf.selStart = nextPos
      buf.selEnd = nextPos
    ret buf
  if k == "RIGHT" or k == "ARROWRIGHT":
    let anchor = clampInt(if buf.cursor == buf.selStart: buf.selEnd else: buf.selStart, 0, nLen)
    let nextPos = if ctrlHeld: auraWordJumpRight(buf.text, buf.cursor) else: (if buf.cursor < buf.text.len: buf.cursor + 1 else: buf.text.len)
    if shiftHeld:
      buf.selStart = if anchor < nextPos: anchor else: nextPos
      buf.selEnd = if anchor > nextPos: anchor else: nextPos
      buf.cursor = nextPos
    elif hasSel and not ctrlHeld:
      buf.cursor = hiSel
      buf.selStart = hiSel
      buf.selEnd = hiSel
    else:
      buf.cursor = nextPos
      buf.selStart = nextPos
      buf.selEnd = nextPos
    ret buf
  if k == "HOME":
    let anchor = clampInt(if buf.cursor == buf.selEnd: buf.selStart else: buf.selEnd, 0, nLen)
    if shiftHeld:
      buf.selStart = 0
      buf.selEnd = anchor
    else:
      buf.selStart = 0
      buf.selEnd = 0
    buf.cursor = 0
    ret buf
  if k == "END":
    let anchor = clampInt(if buf.cursor == buf.selStart: buf.selEnd else: buf.selStart, 0, nLen)
    if shiftHeld:
      buf.selStart = anchor
      buf.selEnd = buf.text.len
    else:
      buf.selStart = buf.text.len
      buf.selEnd = buf.text.len
    buf.cursor = buf.text.len
    ret buf
  if k == "BACKSPACE":
    if hasSel:
      buf.undoStack.push(buf.text)
      buf.redoStack = []
      buf.text = buf.text.slice(0, loSel) + buf.text.slice(hiSel, buf.text.len)
      buf.cursor = loSel
      buf.selStart = loSel
      buf.selEnd = loSel
    elif buf.cursor > 0:
      buf.undoStack.push(buf.text)
      buf.redoStack = []
      let delStart = if ctrlHeld: auraWordJumpLeft(buf.text, buf.cursor) else: buf.cursor - 1
      buf.text = buf.text.slice(0, delStart) + buf.text.slice(buf.cursor, buf.text.len)
      buf.cursor = delStart
      buf.selStart = delStart
      buf.selEnd = delStart
    ret buf
  if k == "DELETE" or k == "DEL":
    if hasSel:
      buf.undoStack.push(buf.text)
      buf.redoStack = []
      buf.text = buf.text.slice(0, loSel) + buf.text.slice(hiSel, buf.text.len)
      buf.cursor = loSel
      buf.selStart = loSel
      buf.selEnd = loSel
    elif buf.cursor < buf.text.len:
      buf.undoStack.push(buf.text)
      buf.redoStack = []
      let delEnd = if ctrlHeld: auraWordJumpRight(buf.text, buf.cursor) else: buf.cursor + 1
      buf.text = buf.text.slice(0, buf.cursor) + buf.text.slice(delEnd, buf.text.len)
      buf.selStart = buf.cursor
      buf.selEnd = buf.cursor
    ret buf
  ret buf

pub struct AuraMultiSelectState(selectedIndices: [int], anchorIndex: int, lastClickedIndex: int)

pub fn auraMultiSelectNew(): AuraMultiSelectState:
  let emptySel: [int] = []
  ret AuraMultiSelectState(
    selectedIndices = emptySel,
    anchorIndex = -1,
    lastClickedIndex = -1
  )

pub fn auraMultiSelectIsSelected(st: AuraMultiSelectState, idx: int): bool:
  mut i = 0
  while i < st.selectedIndices.len:
    if st.selectedIndices[i] == idx:
      ret true
    i += 1
  ret false

pub fn auraMultiSelectToggle(st: AuraMultiSelectState, idx: int): AuraMultiSelectState:
  mut nextSel: [int] = []
  mut found = false
  mut i = 0
  while i < st.selectedIndices.len:
    if st.selectedIndices[i] == idx:
      found = true
    else:
      nextSel.push(st.selectedIndices[i])
    i += 1
  if not found:
    nextSel.push(idx)
  ret AuraMultiSelectState(
    selectedIndices = nextSel,
    anchorIndex = if st.anchorIndex >= 0: st.anchorIndex else: idx,
    lastClickedIndex = idx
  )

pub fn auraMultiSelectRange(st: AuraMultiSelectState, fromIdx: int, toIdx: int): AuraMultiSelectState:
  let lo = if fromIdx < toIdx: fromIdx else: toIdx
  let hi = if fromIdx > toIdx: fromIdx else: toIdx
  mut nextSel: [int] = []
  mut k = lo
  while k <= hi:
    nextSel.push(k)
    k += 1
  ret AuraMultiSelectState(
    selectedIndices = nextSel,
    anchorIndex = fromIdx,
    lastClickedIndex = toIdx
  )

pub fn auraMultiSelectAll(st: AuraMultiSelectState, totalCount: int): AuraMultiSelectState:
  mut nextSel: [int] = []
  mut i = 0
  while i < totalCount:
    nextSel.push(i)
    i += 1
  let anchor = if totalCount > 0: clampInt(st.anchorIndex, 0, totalCount - 1) else: -1
  ret AuraMultiSelectState(
    selectedIndices = nextSel,
    anchorIndex = anchor,
    lastClickedIndex = if totalCount > 0: totalCount - 1 else: -1
  )

pub fn auraMultiSelectClear(st: AuraMultiSelectState): AuraMultiSelectState:
  let _prevAnchor = st.anchorIndex
  let emptySel: [int] = []
  ret AuraMultiSelectState(
    selectedIndices = emptySel,
    anchorIndex = -1,
    lastClickedIndex = -1
  )

pub fn auraMultiSelectHandleClick(st: AuraMultiSelectState, clickedIdx: int, ctrlHeld: bool, shiftHeld: bool): AuraMultiSelectState:
  if shiftHeld and st.anchorIndex >= 0:
    ret auraMultiSelectRange(st, st.anchorIndex, clickedIdx)
  if ctrlHeld:
    ret auraMultiSelectToggle(st, clickedIdx)
  let singleSel: [int] = [clickedIdx]
  ret AuraMultiSelectState(
    selectedIndices = singleSel,
    anchorIndex = clickedIdx,
    lastClickedIndex = clickedIdx
  )

/// Renders the standard AuraDS Focus Ring (`2px solid`).
pub fn auraDrawFocusRing(rect: AuraRect, radius: float):
  let theme = auraThemeArcadeNeon()
  drawRoundedRectOutline(rect.x - 1.0, rect.y - 1.0, rect.w + 2.0, rect.h + 2.0, radius + 1.0, 2.0, colorHex(theme.primary))

pub fn auraTextField(mut ctx: AuraContext, id: str, rect: AuraRect, label: str, placeholder: str, value: str): AuraTextResult:
  if label.len > 0:
    drawText(label, rect.x, rect.y - 16.0, 0.8, colorHex(ctx.theme.textSecondary))
  let ctrlHeld = isKeyDown("Control") or isKeyDown("Ctrl") or isKeyDown("Control_L") or isKeyDown("Control_R")
  let shiftHeld = isKeyDown("Shift") or isKeyDown("Shift_L") or isKeyDown("Shift_R")
  let kDrag = id + ":drag"

  mut editBuf = auraTextEditNew(value)
  let existingOpt = ctx.textBuffers.get(id)
  if existingOpt.isSome():
    editBuf = existingOpt.unwrap()
    if editBuf.text != value:
      editBuf.text = value
      if editBuf.cursor > value.len:
        editBuf.cursor = value.len
      if editBuf.selStart > value.len:
        editBuf.selStart = value.len
      if editBuf.selEnd > value.len:
        editBuf.selEnd = value.len

  mut isDragActive = ctx.uiState.get(kDrag).unwrapOr("0") == "1"

  let clickedInside = auraIsClicked(ctx, rect)
  if clickedInside:
    let wasFocused = ctx.focusedId == id
    ctx.focusedId = id
    ctx.activeId = id
    ctx.uiState.set("focusedId", id)
    ctx.uiState.set("activeId", id)
    let dbl = isMouseDoubleClicked()
    editBuf = auraTextEditMouseSelect(editBuf, rect.x + 10.0, ctx.mouseX, 0.9, true, false, dbl, shiftHeld and wasFocused)
    isDragActive = not dbl
  elif ctx.focusedId == id and ctx.mouseDown and isDragActive:
    editBuf = auraTextEditMouseSelect(editBuf, rect.x + 10.0, ctx.mouseX, 0.9, false, true, false, shiftHeld)
  elif not ctx.mouseDown:
    isDragActive = false

  let isFocused = ctx.focusedId == id
  mut bgCol = ctx.theme.surface0
  mut borderCol = ctx.theme.outlineVariant
  mut borderThick = 1.0
  if isFocused:
    borderCol = ctx.theme.secondary
    borderThick = 2.0
  elif auraIsHovered(ctx, rect):
    borderCol = ctx.theme.outline
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(bgCol))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, borderThick, colorHex(borderCol))
  if isFocused:
    auraDrawWidgetFocusRing(ctx, id, rect)

  mut changed = false
  mut submitted = false
  let compText = if isFocused: getCompositionText() else: ""
  let compCursor = if isFocused: getCompositionCursor() else: 0
  if isFocused:
    if ctx.activeId == id + ":select_all" and editBuf.selStart == editBuf.selEnd:
      editBuf.selStart = 0
      editBuf.selEnd = editBuf.text.len
      editBuf.cursor = editBuf.text.len

    let prevText = editBuf.text
    if ctrlHeld and (isKeyPressed("A") or isKeyPressed("a")):
      editBuf = auraTextEditApplyShortcut(editBuf, "A", true, shiftHeld)
      ctx.activeId = id + ":select_all"
      ctx.uiState.set("activeId", ctx.activeId)
    elif ctrlHeld and (isKeyPressed("C") or isKeyPressed("c")):
      editBuf = auraTextEditApplyShortcut(editBuf, "C", true, shiftHeld)
    elif ctrlHeld and (isKeyPressed("X") or isKeyPressed("x")):
      editBuf = auraTextEditApplyShortcut(editBuf, "X", true, shiftHeld)
      ctx.activeId = id
      ctx.uiState.set("activeId", id)
    elif ctrlHeld and (isKeyPressed("V") or isKeyPressed("v")):
      editBuf = auraTextEditApplyShortcut(editBuf, "V", true, shiftHeld)
      ctx.activeId = id
      ctx.uiState.set("activeId", id)
    elif ctrlHeld and (isKeyPressed("Z") or isKeyPressed("z")):
      editBuf = auraTextEditApplyShortcut(editBuf, "Z", true, shiftHeld)
      ctx.activeId = id
      ctx.uiState.set("activeId", id)
    elif ctrlHeld and (isKeyPressed("Y") or isKeyPressed("y")):
      editBuf = auraTextEditApplyShortcut(editBuf, "Y", true, shiftHeld)
      ctx.activeId = id
      ctx.uiState.set("activeId", id)
    else:
      if isKeyPressed("ArrowLeft") or isKeyPressed("Left"):
        editBuf = auraTextEditApplyShortcut(editBuf, "LEFT", ctrlHeld, shiftHeld)
        if editBuf.selStart == editBuf.selEnd:
          ctx.activeId = id
      if isKeyPressed("ArrowRight") or isKeyPressed("Right"):
        editBuf = auraTextEditApplyShortcut(editBuf, "RIGHT", ctrlHeld, shiftHeld)
        if editBuf.selStart == editBuf.selEnd:
          ctx.activeId = id
      if isKeyPressed("Home"):
        editBuf = auraTextEditApplyShortcut(editBuf, "HOME", ctrlHeld, shiftHeld)
        if editBuf.selStart == editBuf.selEnd:
          ctx.activeId = id
      if isKeyPressed("End"):
        editBuf = auraTextEditApplyShortcut(editBuf, "END", ctrlHeld, shiftHeld)
        if editBuf.selStart == editBuf.selEnd:
          ctx.activeId = id

      mut typed = getTextInput()
      if ctx.textInput.len > 0:
        typed = ctx.textInput
      if typed.len > 0 and not ctrlHeld:
        editBuf = auraTextEditInsert(editBuf, typed)
        ctx.activeId = id
      if isKeyPressed("Backspace"):
        editBuf = auraTextEditApplyShortcut(editBuf, "BACKSPACE", ctrlHeld, shiftHeld)
        ctx.activeId = id
      elif isKeyPressed("Delete"):
        editBuf = auraTextEditApplyShortcut(editBuf, "DELETE", ctrlHeld, shiftHeld)
        ctx.activeId = id
      if isKeyPressed("Escape"):
        if editBuf.selStart != editBuf.selEnd or ctx.activeId == id + ":select_all":
          editBuf.selStart = editBuf.cursor
          editBuf.selEnd = editBuf.cursor
          ctx.activeId = id
        else:
          ctx.focusedId = ""
          ctx.uiState.set("focusedId", "")
      if isKeyPressed("Tab"):
        if ctx.focusOrder.len > 0:
          ctx = auraCycleKeyboardFocus(ctx, ctx.focusOrder, shiftHeld)
        else:
          ctx.focusedId = ""
          ctx.uiState.set("focusedId", "")
      if isKeyPressed("Enter"):
        submitted = true

    if editBuf.text != prevText:
      changed = true

  ctx.textBuffers.set(id, editBuf)
  ctx.uiState.set(kDrag, if isDragActive: "1" else: "0")

  let nextText = editBuf.text
  let textY = rect.y + (rect.h - 12.0) * 0.5
  let displayStr = if compText.len > 0: "{nextText}{compText}" else: nextText
  if displayStr.len > 0:
    let fitted = truncateText(displayStr, rect.w - 20.0, 0.9)
    let loSel = if editBuf.selStart < editBuf.selEnd: editBuf.selStart else: editBuf.selEnd
    let hiSel = if editBuf.selStart > editBuf.selEnd: editBuf.selStart else: editBuf.selEnd
    let hasSel = isFocused and (loSel < hiSel or ctx.activeId == id + ":select_all")
    if hasSel:
      let visLo = if ctx.activeId == id + ":select_all" and loSel == hiSel: 0 else: clampInt(loSel, 0, fitted.len)
      let visHi = if ctx.activeId == id + ":select_all" and loSel == hiSel: fitted.len else: clampInt(hiSel, visLo, fitted.len)
      let x0 = rect.x + 10.0 + measureTextWidthPx(fitted.slice(0, visLo), 0.9)
      let x1 = rect.x + 10.0 + measureTextWidthPx(fitted.slice(0, visHi), 0.9)
      let maxHlW = rect.x + rect.w - 8.0 - x0
      let rawHlW = maxFloat(6.0, x1 - x0 + 2.0)
      let hlW = if rawHlW > maxHlW: maxHlW else: rawHlW
      drawRoundedRect(x0 - 1.0, rect.y + 4.0, hlW, rect.h - 8.0, 3.0, colorHex(ctx.theme.primaryContainer))
      drawRoundedRectOutline(x0 - 1.0, rect.y + 4.0, hlW, rect.h - 8.0, 3.0, 1.0, colorHex(ctx.theme.primary))
      if visLo > 0:
        drawText(fitted.slice(0, visLo), rect.x + 10.0, textY, 0.9, colorHex(ctx.theme.textPrimary))
      drawText(fitted.slice(visLo, visHi), x0, textY, 0.9, colorHex(ctx.theme.onPrimary))
      if visHi < fitted.len:
        drawText(fitted.slice(visHi, fitted.len), x1, textY, 0.9, colorHex(ctx.theme.textPrimary))
    else:
      drawText(fitted, rect.x + 10.0, textY, 0.9, colorHex(ctx.theme.textPrimary))
    if isFocused:
      let baseW = measureTextWidthPx(truncateText(nextText, rect.w - 20.0, 0.9), 0.9)
      if compText.len > 0:
        let compW = measureTextWidthPx(compText, 0.9)
        drawRect(rect.x + 10.0 + baseW, textY + 13.0, compW, 1.5, colorHex(ctx.theme.secondary))
        let preSlice = if compCursor >= 0 and compCursor <= compText.len: compText.slice(0, compCursor) else: compText
        let caretX = rect.x + 12.0 + baseW + measureTextWidthPx(preSlice, 0.9)
        drawRect(caretX, rect.y + 6.0, 2.0, rect.h - 12.0, colorHex(ctx.theme.secondary))
      else:
        let visCur = clampInt(editBuf.cursor, 0, fitted.len)
        let caretX = rect.x + 10.0 + measureTextWidthPx(fitted.slice(0, visCur), 0.9)
        drawRect(caretX, rect.y + 6.0, 2.0, rect.h - 12.0, colorHex(ctx.theme.primary))
  else:
    if placeholder.len > 0:
      drawText(placeholder, rect.x + 10.0, textY, 0.9, colorHex(ctx.theme.textMuted))
    if isFocused:
      drawRect(rect.x + 10.0, rect.y + 6.0, 2.0, rect.h - 12.0, colorHex(ctx.theme.primary))

  ret AuraTextResult(text = nextText, changed = changed, submitted = submitted)

pub fn auraTextArea(mut ctx: AuraContext, id: str, rect: AuraRect, label: str, value: str): AuraTextResult:
  if label.len > 0:
    drawText(label, rect.x, rect.y - 16.0, 0.8, colorHex(ctx.theme.textSecondary))
  if auraIsClicked(ctx, rect):
    ctx.focusedId = id
    ctx.activeId = id
    ctx.uiState.set("focusedId", id)
    ctx.uiState.set("activeId", id)
  let isFocused = ctx.focusedId == id
  mut borderCol = ctx.theme.outlineVariant
  if isFocused:
    borderCol = ctx.theme.secondary
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.5, colorHex(borderCol))
  if isFocused:
    auraDrawWidgetFocusRing(ctx, id, rect)

  mut editBuf = auraTextEditNew(value)
  let existingOpt = ctx.textBuffers.get(id)
  if existingOpt.isSome():
    editBuf = existingOpt.unwrap()
    if editBuf.text != value:
      editBuf.text = value
      editBuf.cursor = value.len
      editBuf.selStart = value.len
      editBuf.selEnd = value.len

  mut changed = false
  let compText = if isFocused: getCompositionText() else: ""
  if isFocused:
    let prevText = editBuf.text
    let ctrlHeld = isKeyDown("Control") or isKeyDown("Ctrl")
    let shiftHeld = isKeyDown("Shift") or isKeyDown("Shift_L") or isKeyDown("Shift_R")
    if ctrlHeld and isKeyPressed("A"):
      editBuf = auraTextEditApplyShortcut(editBuf, "A", true, shiftHeld)
      ctx.activeId = id + ":select_all"
    elif ctrlHeld and isKeyPressed("C"):
      editBuf = auraTextEditApplyShortcut(editBuf, "C", true, shiftHeld)
    elif ctrlHeld and isKeyPressed("X"):
      editBuf = auraTextEditApplyShortcut(editBuf, "X", true, shiftHeld)
    elif ctrlHeld and isKeyPressed("V"):
      editBuf = auraTextEditApplyShortcut(editBuf, "V", true, shiftHeld)
    elif ctrlHeld and isKeyPressed("Z"):
      editBuf = auraTextEditApplyShortcut(editBuf, "Z", true, shiftHeld)
    elif ctrlHeld and isKeyPressed("Y"):
      editBuf = auraTextEditApplyShortcut(editBuf, "Y", true, shiftHeld)
    else:
      mut typed = getTextInput()
      if ctx.textInput.len > 0:
        typed = ctx.textInput
      if typed.len > 0:
        if ctx.activeId == id + ":select_all":
          editBuf.undoStack.push(editBuf.text)
          editBuf.text = typed
          editBuf.cursor = typed.len
          editBuf.selStart = typed.len
          editBuf.selEnd = typed.len
          ctx.activeId = id
        else:
          editBuf = auraTextEditInsert(editBuf, typed)
      if isKeyPressed("Backspace") and editBuf.text.len > 0:
        if ctx.activeId == id + ":select_all":
          editBuf.undoStack.push(editBuf.text)
          editBuf.text = ""
          editBuf.cursor = 0
          editBuf.selStart = 0
          editBuf.selEnd = 0
          ctx.activeId = id
        else:
          editBuf = auraTextEditApplyShortcut(editBuf, "BACKSPACE", ctrlHeld, shiftHeld)
      if isKeyPressed("Tab"):
        if ctx.focusOrder.len > 0:
          ctx = auraCycleKeyboardFocus(ctx, ctx.focusOrder, shiftHeld)
        else:
          ctx.focusedId = ""
          ctx.uiState.set("focusedId", "")
      if isKeyPressed("Enter"):
        editBuf = auraTextEditInsert(editBuf, "\n")
    if editBuf.text != prevText:
      changed = true

  ctx.textBuffers.set(id, editBuf)
  let nextText = editBuf.text
  let shownText = if compText.len > 0: "{nextText}{compText}" else: nextText
  let isAllSel = isFocused and ctx.activeId == id + ":select_all" and shownText.len > 0
  if isAllSel:
    let hlW = clampFloat(measureTextWidthPx(shownText, 0.9) + 6.0, 8.0, rect.w - 16.0)
    drawRoundedRect(rect.x + 8.0, rect.y + 8.0, hlW, 18.0, 3.0, colorHex(ctx.theme.primaryContainer))
    drawRoundedRectOutline(rect.x + 8.0, rect.y + 8.0, hlW, 18.0, 3.0, 1.0, colorHex(ctx.theme.primary))
  drawTextBox(shownText, rect.x + 10.0, rect.y + 10.0, rect.w - 20.0, 0.9, colorHex(if isAllSel: ctx.theme.onPrimary else: ctx.theme.textPrimary))
  if isFocused and compText.len > 0:
    let compW = measureTextWidthPx(compText, 0.9)
    drawRect(rect.x + 10.0, rect.y + 24.0, compW, 1.5, colorHex(ctx.theme.secondary))
  ret AuraTextResult(text = nextText, changed = changed, submitted = false)

pub fn auraButton(mut ctx: AuraContext, id: str, rect: AuraRect, label: str, variant: str): bool:
  let hovered = auraIsHovered(ctx, rect)
  let clicked = auraIsClicked(ctx, rect)
  if clicked or (hovered and ctx.mouseClicked):
    ctx.activeId = id
    ctx.uiState.set("activeId", id)
  let isActive = ctx.activeId == id or ctx.uiState.get("activeId").unwrapOr("") == id
  let pressed = ctx.mouseDown and (hovered or isActive)
  mut offY = 0.0
  if pressed:
    offY = 1.0
  let by = rect.y + offY
  let rad = ctx.theme.radiusMd
  let isGhost = variant == "ghost" or variant == "Ghost" or variant == "text" or variant == "Text"
  let isElevated = variant == "elevated" or variant == "Elevated"
  let isOutlined = variant == "outlined" or variant == "Outlined"
  let isTonal = variant == "tonal" or variant == "Tonal"
  let isDanger = variant == "danger" or variant == "Danger"
  let isFilled = not isGhost and not isElevated and not isOutlined and not isTonal and not isDanger

  mut bgCol = ctx.theme.primary
  mut fgCol = ctx.theme.onPrimary
  mut outlineCol = 0
  if isTonal:
    bgCol = ctx.theme.primaryContainer
    fgCol = ctx.theme.primary
  elif isOutlined:
    bgCol = ctx.theme.surface0
    fgCol = ctx.theme.primary
    outlineCol = ctx.theme.outline
  elif isElevated:
    bgCol = ctx.theme.surface2
    fgCol = ctx.theme.textPrimary
  elif isGhost:
    bgCol = ctx.theme.surface1
    fgCol = ctx.theme.textSecondary
  elif isDanger:
    bgCol = ctx.theme.danger
    fgCol = ctx.theme.onDanger

  // Elevation shadow on Filled and Elevated when not pressed
  if (isFilled or isElevated) and not pressed:
    drawRoundedRect(rect.x, by + 2.0, rect.w, rect.h, rad, rgba(0, 0, 0, 0.22))

  // Surface fill
  if not isGhost or hovered:
    drawRoundedRect(rect.x, by, rect.w, rect.h, rad, colorHex(bgCol))
    // Hover state-layer brightening
    if hovered and not pressed:
      drawRoundedRect(rect.x, by, rect.w, rect.h, rad, rgba(255, 255, 255, 0.12))

  if outlineCol != 0:
    drawRoundedRectOutline(rect.x, by, rect.w, rect.h, rad, 1.0, colorHex(outlineCol))
  if hovered:
    drawRoundedRectOutline(rect.x, by, rect.w, rect.h, rad, 1.5, colorHex(ctx.theme.secondary))
  auraDrawWidgetFocusRing(ctx, id, rect)

  let labelH = measureTextHeight(label, 0.9)
  drawTextCentered(label, rect.x + rect.w * 0.5, by + (rect.h - labelH) * 0.5, 0.9, colorHex(fgCol))
  ret clicked

pub fn auraIconButton(ctx: AuraContext, id: str, rect: AuraRect, icon: str): bool:
  let hovered = auraIsHovered(ctx, rect)
  let clicked = auraIsClicked(ctx, rect)
  let cx = rect.x + rect.w * 0.5
  let cy = rect.y + rect.h * 0.5
  let r = minFloat(rect.w, rect.h) * 0.5
  mut bgCol = ctx.theme.surface1
  if hovered:
    bgCol = ctx.theme.surface2
  drawCircle(cx, cy, r, colorHex(bgCol))
  drawCircleOutline(cx, cy, r, 1.0, colorHex(ctx.theme.outlineVariant))
  drawTextCentered(icon, cx, cy - 5.0, 0.9, colorHex(ctx.theme.textPrimary))
  ret clicked

pub fn auraSegmentedButton(ctx: AuraContext, id: str, rect: AuraRect, segments: [str], activeIdx: int): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outline))
  if segments.len == 0:
    ret activeIdx
  mut selected = activeIdx
  let segW = rect.w / float(segments.len)
  mut i = 0
  while i < segments.len:
    let sx = rect.x + float(i) * segW
    let segRect = AuraRect(x = sx, y = rect.y, w = segW, h = rect.h)
    if auraIsClicked(ctx, segRect):
      selected = i
    if i == selected:
      drawRoundedRect(sx + 2.0, rect.y + 2.0, segW - 4.0, rect.h - 4.0, ctx.theme.radiusSm, colorHex(ctx.theme.primary))
      drawTextCentered(segments[i], sx + segW * 0.5, rect.y + (rect.h - 10.0) * 0.5, 0.85, colorHex(ctx.theme.onPrimary))
    else:
      drawTextCentered(segments[i], sx + segW * 0.5, rect.y + (rect.h - 10.0) * 0.5, 0.85, colorHex(ctx.theme.textSecondary))
    i = i + 1
  ret selected

pub fn auraFloatingActionButton(ctx: AuraContext, id: str, x: float, y: float, label: str): bool:
  let size = 52.0
  let rect = AuraRect(x = x, y = y, w = size, h = size)
  let clicked = auraIsClicked(ctx, rect)
  drawRoundedRect(x + 2.0, y + 4.0, size, size, ctx.theme.radiusLg, auraScrimColor(ctx.theme.scrim))
  drawRoundedRect(x, y, size, size, ctx.theme.radiusLg, colorHex(ctx.theme.primary))
  drawTextCentered(label, x + size * 0.5, y + size * 0.5 - 6.0, 1.1, colorHex(ctx.theme.onPrimary))
  ret clicked

pub fn auraCheckbox(ctx: AuraContext, id: str, x: float, y: float, label: str, checked: bool): bool:
  let boxSize = 20.0
  let hitW = boxSize + 10.0 + measureTextWidthPx(label, 0.9)
  let hitRect = AuraRect(x = x, y = y, w = hitW, h = boxSize)
  mut nextChecked = checked
  if auraIsClicked(ctx, hitRect):
    nextChecked = not checked
  if nextChecked:
    drawRoundedRect(x, y, boxSize, boxSize, 4.0, colorHex(ctx.theme.primary))
    drawLine(x + 4.0, y + 10.0, x + 8.0, y + 15.0, colorHex(ctx.theme.onPrimary), 2.0)
    drawLine(x + 8.0, y + 15.0, x + 16.0, y + 5.0, colorHex(ctx.theme.onPrimary), 2.0)
  else:
    drawRoundedRect(x, y, boxSize, boxSize, 4.0, colorHex(ctx.theme.surface0))
    drawRoundedRectOutline(x, y, boxSize, boxSize, 4.0, 1.5, colorHex(ctx.theme.outline))
  if label.len > 0:
    drawText(label, x + boxSize + 8.0, y + 4.0, 0.9, colorHex(ctx.theme.textPrimary))
  ret nextChecked

pub fn auraSwitch(ctx: AuraContext, id: str, x: float, y: float, label: str, checked: bool): bool:
  let trackW = 44.0
  let trackH = 24.0
  let hitW = trackW + 10.0 + measureTextWidthPx(label, 0.9)
  let hitRect = AuraRect(x = x, y = y, w = hitW, h = trackH)
  mut nextChecked = checked
  if auraIsClicked(ctx, hitRect):
    nextChecked = not checked
  let rad = trackH * 0.5
  if nextChecked:
    drawRoundedRect(x, y, trackW, trackH, rad, colorHex(ctx.theme.primary))
    drawCircle(x + trackW - 12.0, y + rad, 9.0, colorHex(ctx.theme.onPrimary))
    drawCircle(x + trackW - 12.0, y + rad, 4.0, colorHex(ctx.theme.primary))
  else:
    drawRoundedRect(x, y, trackW, trackH, rad, colorHex(ctx.theme.surface2))
    drawRoundedRectOutline(x, y, trackW, trackH, rad, 1.0, colorHex(ctx.theme.outline))
    drawCircle(x + 12.0, y + rad, 7.5, colorHex(ctx.theme.textSecondary))
  if label.len > 0:
    drawText(label, x + trackW + 10.0, y + 6.0, 0.9, colorHex(ctx.theme.textPrimary))
  ret nextChecked

pub fn auraRadioGroup(ctx: AuraContext, id: str, rect: AuraRect, options: [str], selectedIdx: int): int:
  mut selected = selectedIdx
  mut i = 0
  let rowH = 26.0
  while i < options.len:
    let ry = rect.y + float(i) * rowH
    let rowRect = AuraRect(x = rect.x, y = ry, w = rect.w, h = rowH)
    if auraIsClicked(ctx, rowRect):
      selected = i
    let cx = rect.x + 10.0
    let cy = ry + 11.0
    mut ringCol = ctx.theme.outline
    if i == selected:
      ringCol = ctx.theme.primary
    drawCircleOutline(cx, cy, 8.0, 1.5, colorHex(ringCol))
    if i == selected:
      drawCircle(cx, cy, 4.5, colorHex(ctx.theme.primary))
    drawText(options[i], rect.x + 26.0, ry + 5.0, 0.9, colorHex(ctx.theme.textPrimary))
    i = i + 1
  ret selected

pub fn auraSlider(mut ctx: AuraContext, id: str, rect: AuraRect, label: str, value: float, minVal: float, maxVal: float): float:
  mut span = maxVal - minVal
  if span <= 0.0:
    span = 1.0
  mut nextVal = clampFloat(value, minVal, maxVal)
  let trackY = rect.y + rect.h - 10.0
  let hovered = auraIsHovered(ctx, rect)
  let clicked = auraIsClicked(ctx, rect)
  if clicked or (ctx.mouseDown and hovered):
    ctx.activeId = id
    ctx.uiState.set("activeId", id)
  let isActiveDrag = ctx.activeId == id or ctx.uiState.get("activeId").unwrapOr("") == id
  if (ctx.mouseDown and (hovered or isActiveDrag)) or clicked:
    let t = clampFloat((ctx.mouseX - rect.x) / maxFloat(1.0, rect.w), 0.0, 1.0)
    nextVal = minVal + t * span
  let ratio = clampFloat((nextVal - minVal) / span, 0.0, 1.0)
  if label.len > 0:
    drawText(label, rect.x, rect.y, 0.85, colorHex(ctx.theme.textSecondary))
  // Track background
  drawRoundedRect(rect.x, trackY - 3.0, rect.w, 6.0, 3.0, colorHex(ctx.theme.surface2))
  // Active track fill
  if ratio > 0.0:
    drawRoundedRect(rect.x, trackY - 3.0, rect.w * ratio, 6.0, 3.0, colorHex(ctx.theme.primary))
  let knobX = rect.x + rect.w * ratio
  if hovered or (ctx.mouseDown and isActiveDrag):
    drawCircle(knobX, trackY, 13.0, rgba(99, 102, 241, 0.20))
  drawCircle(knobX, trackY, 9.0, colorHex(ctx.theme.primary))
  drawCircle(knobX, trackY, 4.0, colorHex(ctx.theme.onPrimary))
  auraDrawWidgetFocusRing(ctx, id, rect)
  ret nextVal

pub fn auraNumberStepper(ctx: AuraContext, id: str, rect: AuraRect, label: str, value: int, minVal: int, maxVal: int, stepVal: int): int:
  if label.len > 0:
    drawText(label, rect.x, rect.y - 16.0, 0.8, colorHex(ctx.theme.textSecondary))
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let btnW = 30.0
  let minusRect = AuraRect(x = rect.x, y = rect.y, w = btnW, h = rect.h)
  let plusRect = AuraRect(x = rect.x + rect.w - btnW, y = rect.y, w = btnW, h = rect.h)
  mut nextVal = value
  if auraIsClicked(ctx, minusRect):
    nextVal = value - stepVal
  if auraIsClicked(ctx, plusRect):
    nextVal = value + stepVal
  if nextVal < minVal:
    nextVal = minVal
  if nextVal > maxVal:
    nextVal = maxVal
  drawRoundedRect(minusRect.x + 2.0, minusRect.y + 2.0, btnW - 4.0, rect.h - 4.0, ctx.theme.radiusSm, colorHex(ctx.theme.surface2))
  drawTextCentered("-", minusRect.x + btnW * 0.5, rect.y + (rect.h - 10.0) * 0.5, 1.0, colorHex(ctx.theme.textPrimary))
  drawRoundedRect(plusRect.x + 2.0, plusRect.y + 2.0, btnW - 4.0, rect.h - 4.0, ctx.theme.radiusSm, colorHex(ctx.theme.surface2))
  drawTextCentered("+", plusRect.x + btnW * 0.5, rect.y + (rect.h - 10.0) * 0.5, 1.0, colorHex(ctx.theme.textPrimary))
  drawTextCentered("{nextVal}", rect.x + rect.w * 0.5, rect.y + (rect.h - 10.0) * 0.5, 0.95, colorHex(ctx.theme.textPrimary))
  ret nextVal

pub fn auraSelectDropdown(mut ctx: AuraContext, id: str, rect: AuraRect, label: str, options: [str], selectedIdx: int): int:
  let openKey = id + ":open"
  let v7OpenKey = id + ":v7_open"
  mut isOpen = ctx.uiState.get(openKey).unwrapOr("0") == "1" or ctx.scrollOffsets.get(openKey).unwrapOr(0.0) > 0.5 or ctx.scrollOffsets.get(v7OpenKey).unwrapOr(0.0) > 0.5
  if label.len > 0:
    drawText(label, rect.x, rect.y - 16.0, 0.8, colorHex(ctx.theme.textSecondary))
  let bgHex = if auraIsHovered(ctx, rect): auraApplyStateLayer(ctx.theme.surface0, ctx.theme.primary, 0.08) else: ctx.theme.surface0
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(bgHex))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(if isOpen: ctx.theme.primary else: ctx.theme.outline))
  auraDrawWidgetFocusRing(ctx, id, rect)
  mut selected = selectedIdx
  if options.len > 0 and auraIsClicked(ctx, rect):
    isOpen = not isOpen
    ctx.uiState.set(openKey, if isOpen: "1" else: "0")
    ctx.scrollOffsets.set(openKey, if isOpen: 1.0 else: 0.0)
    ctx.scrollOffsets.set(v7OpenKey, if isOpen: 1.0 else: 0.0)
  mut curText = ""
  if selected >= 0 and selected < options.len:
    curText = options[selected]
  drawText(curText, rect.x + 10.0, rect.y + (rect.h - 10.0) * 0.5, 0.9, colorHex(ctx.theme.textPrimary))
  drawText(if isOpen: "^" else: "v", rect.x + rect.w - 18.0, rect.y + (rect.h - 10.0) * 0.5, 0.85, colorHex(ctx.theme.textSecondary))
  if isOpen and options.len > 0:
    let itemH = 26.0
    let menuH = float(options.len) * itemH + 8.0
    let menuY = rect.y + rect.h + 2.0
    drawRoundedRect(rect.x, menuY, rect.w, menuH, ctx.theme.radiusSm, colorHex(ctx.theme.surface2))
    drawRoundedRectOutline(rect.x, menuY, rect.w, menuH, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.primary))
    mut oi = 0
    while oi < options.len:
      let itemRect = AuraRect(x = rect.x + 4.0, y = menuY + 4.0 + float(oi) * itemH, w = rect.w - 8.0, h = itemH - 2.0)
      if oi == selected:
        drawRoundedRect(itemRect.x, itemRect.y, itemRect.w, itemRect.h, 4.0, colorHex(ctx.theme.primaryContainer))
      elif auraIsHovered(ctx, itemRect):
        drawRoundedRect(itemRect.x, itemRect.y, itemRect.w, itemRect.h, 4.0, colorHex(ctx.theme.surface3))
      drawText(options[oi], itemRect.x + 8.0, itemRect.y + 6.0, 0.85, colorHex(ctx.theme.textPrimary))
      if auraIsClicked(ctx, itemRect):
        selected = oi
        isOpen = false
        ctx.uiState.set(openKey, "0")
        ctx.scrollOffsets.set(openKey, 0.0)
        ctx.scrollOffsets.set(v7OpenKey, 0.0)
      oi += 1
    if isOpen:
      ctx.zOverlays.set(id, AuraZOverlay(
        id = id,
        kind = "dropdown",
        rect = AuraRect(x = rect.x, y = menuY, w = rect.w, h = menuH),
        options = options,
        selectedIdx = selected,
        text = "",
        zOrder = 100
      ))
  ret selected

/// Expandable dropdown menu alias (`AuraDS v7.0`).
pub fn auraSelectDropdownV7(mut ctx: AuraContext, id: str, rect: AuraRect, label: str, options: [str], selectedIdx: int): int:
  ret auraSelectDropdown(ctx, id, rect, label, options, selectedIdx)

pub fn auraComboBox(mut ctx: AuraContext, id: str, rect: AuraRect, query: str, options: [str], selectedIdx: int): int:
  let openKey = id + ":combo_open"
  mut isOpen = ctx.uiState.get(openKey).unwrapOr("0") == "1" or ctx.focusedId == id
  let headerRect = AuraRect(x = rect.x, y = rect.y, w = rect.w, h = 34.0)
  if auraIsClicked(ctx, headerRect):
    isOpen = not isOpen
    ctx.focusedId = if isOpen: id else: ""
    ctx.uiState.set("focusedId", ctx.focusedId)
    ctx.uiState.set(openKey, if isOpen: "1" else: "0")
  drawRoundedRect(rect.x, rect.y, rect.w, 34.0, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, 34.0, ctx.theme.radiusSm, 1.0, colorHex(if isOpen: ctx.theme.primary else: ctx.theme.outline))
  mut displayQuery = "Search..."
  if query.len > 0:
    displayQuery = query
  elif selectedIdx >= 0 and selectedIdx < options.len:
    displayQuery = options[selectedIdx]
  drawText(displayQuery, rect.x + 10.0, rect.y + 11.0, 0.9, colorHex(ctx.theme.textPrimary))
  drawText(if isOpen: "^" else: "v", rect.x + rect.w - 18.0, rect.y + 11.0, 0.85, colorHex(ctx.theme.textSecondary))
  mut selected = selectedIdx
  if isOpen and options.len > 0:
    mut filteredOpts: [str] = []
    mut filteredOrigIdx: [int] = []
    mut i = 0
    while i < options.len and filteredOpts.len < 6:
      let opt = options[i]
      if query.len == 0 or opt.indexOf(query) >= 0:
        filteredOpts.push(opt)
        filteredOrigIdx.push(i)
      i = i + 1
    let itemH = 26.0
    let menuH = float(filteredOpts.len) * itemH + 8.0
    let menuY = rect.y + 36.0
    drawRoundedRect(rect.x, menuY, rect.w, menuH, ctx.theme.radiusSm, colorHex(ctx.theme.surface2))
    drawRoundedRectOutline(rect.x, menuY, rect.w, menuH, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.primary))
    mut rowIdx = 0
    mut selFilteredIdx = -1
    while rowIdx < filteredOpts.len:
      let origIdx = filteredOrigIdx[rowIdx]
      if origIdx == selected:
        selFilteredIdx = rowIdx
      let ry = menuY + 4.0 + float(rowIdx) * itemH
      let itemRect = AuraRect(x = rect.x + 4.0, y = ry, w = rect.w - 8.0, h = itemH - 2.0)
      if auraIsClicked(ctx, itemRect):
        selected = origIdx
        isOpen = false
        ctx.uiState.set(openKey, "0")
      mut rowBg = ctx.theme.surface2
      if origIdx == selected:
        rowBg = ctx.theme.primaryContainer
      elif auraIsHovered(ctx, itemRect):
        rowBg = ctx.theme.surface3
      drawRoundedRect(itemRect.x, itemRect.y, itemRect.w, itemRect.h, 4.0, colorHex(rowBg))
      drawText(filteredOpts[rowIdx], itemRect.x + 8.0, itemRect.y + 6.0, 0.85, colorHex(ctx.theme.textPrimary))
      rowIdx = rowIdx + 1
    if isOpen and filteredOpts.len > 0:
      ctx.zOverlays.set(id, AuraZOverlay(
        id = id,
        kind = "combobox",
        rect = AuraRect(x = rect.x, y = menuY, w = rect.w, h = menuH),
        options = filteredOpts,
        selectedIdx = selFilteredIdx,
        text = query,
        zOrder = 100
      ))
  ret selected

pub fn auraChip(ctx: AuraContext, id: str, x: float, y: float, label: str, selected: bool): bool:
  let w = measureTextWidthPx(label, 0.85) + 24.0
  let h = 28.0
  let rect = AuraRect(x = x, y = y, w = w, h = h)
  let hovered = auraIsHovered(ctx, rect)
  mut nextSel = selected
  if auraIsClicked(ctx, rect):
    nextSel = not selected
  let rad = h * 0.5
  let textH = measureTextHeight(label, 0.85)
  let textY = y + (h - textH) * 0.5
  if nextSel:
    drawRoundedRect(x, y + 2.0, w, h, rad, rgba(0, 0, 0, 0.15))
    drawRoundedRect(x, y, w, h, rad, colorHex(ctx.theme.primaryContainer))
    drawRoundedRectOutline(x, y, w, h, rad, 1.0, colorHex(ctx.theme.primary))
    if hovered:
      drawRoundedRect(x, y, w, h, rad, rgba(255, 255, 255, 0.08))
    drawTextCentered(label, x + w * 0.5, textY, 0.85, colorHex(ctx.theme.primary))
  else:
    drawRoundedRect(x, y, w, h, rad, colorHex(ctx.theme.surface1))
    drawRoundedRectOutline(x, y, w, h, rad, 1.0, colorHex(ctx.theme.outlineVariant))
    if hovered:
      drawRoundedRect(x, y, w, h, rad, rgba(255, 255, 255, 0.06))
    drawTextCentered(label, x + w * 0.5, textY, 0.85, colorHex(ctx.theme.textSecondary))
  ret nextSel

pub fn auraBadge(ctx: AuraContext, x: float, y: float, text: str, color: int):
  let w = maxFloat(22.0, measureTextWidthPx(text, 0.75) + 14.0)
  let h = 18.0
  let textH = measureTextHeight(text, 0.75)
  drawRoundedRect(x, y + 1.0, w, h, h * 0.5, rgba(0, 0, 0, 0.20))
  drawRoundedRect(x, y, w, h, h * 0.5, colorHex(color))
  drawRoundedRectOutline(x, y, w, h, h * 0.5, 1.0, rgba(255, 255, 255, 0.15))
  drawTextCentered(text, x + w * 0.5, y + (h - textH) * 0.5, 0.75, colorHex(ctx.theme.onPrimary))
  ret

pub fn auraDatePicker(ctx: AuraContext, id: str, rect: AuraRect, year: int, month: int, selectedDay: int): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, 1.0, colorHex(ctx.theme.outlineVariant))
  drawTextCentered("{year}-{month}", rect.x + rect.w * 0.5, rect.y + 10.0, 0.95, colorHex(ctx.theme.textPrimary))
  mut chosen = selectedDay
  let cols = 7
  let cellW = (rect.w - 16.0) / 7.0
  let cellH = (rect.h - 40.0) / 5.0
  mut day = 1
  while day <= 31:
    let idx = day - 1
    let col = idx % cols
    let row = idx / cols
    let cx = rect.x + 8.0 + float(col) * cellW
    let cy = rect.y + 32.0 + float(row) * cellH
    let cellRect = AuraRect(x = cx, y = cy, w = cellW - 2.0, h = cellH - 2.0)
    if auraIsClicked(ctx, cellRect):
      chosen = day
    if day == chosen:
      drawRoundedRect(cellRect.x, cellRect.y, cellRect.w, cellRect.h, 4.0, colorHex(ctx.theme.primary))
      drawTextCentered("{day}", cellRect.x + cellRect.w * 0.5, cellRect.y + cellRect.h * 0.5 - 4.0, 0.75, colorHex(ctx.theme.onPrimary))
    else:
      drawTextCentered("{day}", cellRect.x + cellRect.w * 0.5, cellRect.y + cellRect.h * 0.5 - 4.0, 0.75, colorHex(ctx.theme.textSecondary))
    day = day + 1
  ret chosen

pub fn auraColorPickerPopover(ctx: AuraContext, id: str, rect: AuraRect, currentColor: int): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, 1.0, colorHex(ctx.theme.outline))
  let palette = [0xEF4444, 0xF59E0B, 0x22C55E, 0x06B6D4, 0x3B82F6, 0x6366F1, 0xA855F7, 0xEC4899]
  mut chosen = currentColor
  let swW = (rect.w - 20.0) / 4.0
  let swH = (rect.h - 20.0) / 2.0
  mut i = 0
  while i < palette.len:
    let col = i % 4
    let row = i / 4
    let sx = rect.x + 10.0 + float(col) * swW
    let sy = rect.y + 10.0 + float(row) * swH
    let swRect = AuraRect(x = sx, y = sy, w = swW - 4.0, h = swH - 4.0)
    if auraIsClicked(ctx, swRect):
      chosen = palette[i]
    drawRoundedRect(swRect.x, swRect.y, swRect.w, swRect.h, 4.0, colorHex(palette[i]))
    if palette[i] == chosen:
      drawRoundedRectOutline(swRect.x, swRect.y, swRect.w, swRect.h, 4.0, 2.0, colorHex(ctx.theme.textPrimary))
    i = i + 1
  ret chosen

// =============================================================================
// 13.4 Enterprise Data Display, Virtualized Tables, Tree Views, Kanban & Charts
// =============================================================================

pub fn auraInteractiveDataTable(ctx: AuraContext, id: str, rect: AuraRect, headers: [str], rows: [[str]], selectedRow: int): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let headerH = 32.0
  drawRoundedRect(rect.x, rect.y, rect.w, headerH, ctx.theme.radiusSm, colorHex(ctx.theme.surface2))
  mut colCount = headers.len
  if colCount < 1:
    colCount = 1
  let colW = rect.w / float(colCount)
  let maxCellW = if colW > 18.0: colW - 16.0 else: 12.0
  mut c = 0
  while c < headers.len:
    let hText = truncateText(headers[c], maxCellW, 0.85)
    drawText(hText, rect.x + float(c) * colW + 10.0, rect.y + 10.0, 0.85, colorHex(ctx.theme.textPrimary))
    c = c + 1

  mut chosen = selectedRow
  let rowH = 28.0
  mut r = 0
  while r < rows.len:
    let ry = rect.y + headerH + float(r) * rowH
    if ry + rowH <= rect.y + rect.h:
      let rowRect = AuraRect(x = rect.x, y = ry, w = rect.w, h = rowH)
      let rowHovered = auraIsHovered(ctx, rowRect)
      if auraIsClicked(ctx, rowRect):
        chosen = r
      if r == chosen:
        drawRect(rect.x + 1.0, ry, rect.w - 2.0, rowH, colorHex(ctx.theme.primaryContainer))
      elif rowHovered:
        drawRect(rect.x + 1.0, ry, rect.w - 2.0, rowH, colorHex(ctx.theme.surface2))
      elif r % 2 == 1:
        drawRect(rect.x + 1.0, ry, rect.w - 2.0, rowH, colorHex(ctx.theme.surface1))
      let cells = rows[r]
      mut j = 0
      while j < cells.len and j < colCount:
        let cText = truncateText(cells[j], maxCellW, 0.85)
        drawText(cText, rect.x + float(j) * colW + 10.0, ry + 8.0, 0.85, colorHex(ctx.theme.textSecondary))
        j = j + 1
    r = r + 1
  ret chosen

// =============================================================================
// Universal Component Drag-and-Drop Engine (Any Active Component -> Target)
// =============================================================================

pub struct AuraDragDropState(active: bool, isDragging: bool, sourceId: str, payloadKind: str, payload: str, label: str, startX: float, startY: float, curX: float, curY: float, hoveredTargetId: str, dropTargetId: str, droppedThisFrame: bool)

pub fn auraDragDropNew(active: bool): AuraDragDropState:
  ret AuraDragDropState(
    active = active,
    isDragging = false,
    sourceId = "",
    payloadKind = "",
    payload = "",
    label = "",
    startX = 0.0,
    startY = 0.0,
    curX = 0.0,
    curY = 0.0,
    hoveredTargetId = "",
    dropTargetId = "",
    droppedThisFrame = false
  )

pub fn auraDragDropSetActive(mut dnd: AuraDragDropState, active: bool): AuraDragDropState:
  dnd.active = active
  if not active:
    dnd.isDragging = false
    dnd.sourceId = ""
    dnd.payloadKind = ""
    dnd.payload = ""
    dnd.label = ""
    dnd.hoveredTargetId = ""
    dnd.dropTargetId = ""
    dnd.droppedThisFrame = false
  ret dnd

pub fn auraDragDropBeginFrame(mut dnd: AuraDragDropState): AuraDragDropState:
  dnd.curX = getMouseX()
  dnd.curY = getMouseY()
  dnd.hoveredTargetId = ""
  dnd.dropTargetId = ""
  dnd.droppedThisFrame = false
  if not dnd.active:
    dnd.isDragging = false
    ret dnd
  if dnd.isDragging and not isMouseButtonDown(0) and not isMouseButtonReleased(0):
    dnd.isDragging = false
  ret dnd

pub fn auraDragDropEndFrame(mut dnd: AuraDragDropState): AuraDragDropState:
  if not dnd.active or not isMouseButtonDown(0):
    dnd.isDragging = false
  ret dnd

pub fn auraDragDropSource(mut dnd: AuraDragDropState, sourceId: str, payloadKind: str, payload: str, label: str, x: float, y: float, w: float, h: float, componentActive: bool): AuraDragDropState:
  if not dnd.active or not componentActive:
    ret dnd
  let mx = getMouseX()
  let my = getMouseY()
  let mDown = isMouseButtonDown(0)
  let mPressed = isMouseButtonPressed(0)
  let inside = mx >= x and mx <= x + w and my >= y and my <= y + h
  if mPressed and inside and not dnd.isDragging:
    dnd.sourceId = sourceId
    dnd.payloadKind = payloadKind
    dnd.payload = payload
    dnd.label = label
    dnd.startX = mx
    dnd.startY = my
    dnd.curX = mx
    dnd.curY = my
    dnd.isDragging = true
  elif dnd.isDragging and dnd.sourceId == sourceId and mDown:
    dnd.curX = mx
    dnd.curY = my
    drawRoundedRectOutline(x - 1.0, y - 1.0, w + 2.0, h + 2.0, 5.0, 2.0, colorHex(0xF59E0B))
  ret dnd

/// Universal AuraDesign component drag source supporting any active component kind (`button`, `card`, `chip`, `badge`, `tree_node`, `list_item`, `combobox`, `text_field`).
pub fn auraDragDropComponent(mut dnd: AuraDragDropState, componentKind: str, sourceId: str, payloadKind: str, payload: str, label: str, rect: AuraRect, componentActive: bool): AuraDragDropState:
  let compTag = if componentKind.len > 0: "[" + componentKind.toUpperCase() + "] " + label else: label
  ret auraDragDropSource(dnd, sourceId, payloadKind, payload, compTag, rect.x, rect.y, rect.w, rect.h, componentActive)

pub fn auraDragDropTarget(mut dnd: AuraDragDropState, targetId: str, x: float, y: float, w: float, h: float, acceptKind: str): AuraDragDropState:
  if not dnd.active or not dnd.isDragging:
    ret dnd
  let kindMatches = acceptKind == "*" or acceptKind.len == 0 or acceptKind == dnd.payloadKind or acceptKind.contains(dnd.payloadKind)
  if not kindMatches:
    ret dnd
  let mx = getMouseX()
  let my = getMouseY()
  let mDown = isMouseButtonDown(0)
  let inside = mx >= x and mx <= x + w and my >= y and my <= y + h
  drawRoundedRectOutline(x, y, w, h, 5.0, 1.0, colorHex(0x38BDF8))
  if inside:
    dnd.hoveredTargetId = targetId
    drawRoundedRectOutline(x - 1.0, y - 1.0, w + 2.0, h + 2.0, 6.0, 2.5, colorHex(0x22C55E))
    if not mDown:
      dnd.droppedThisFrame = true
      dnd.dropTargetId = targetId
      dnd.isDragging = false
  ret dnd

/// Universal AuraDesign component drop target accepting `AuraRect` and `targetActive`.
pub fn auraDragDropTargetRect(mut dnd: AuraDragDropState, targetId: str, rect: AuraRect, acceptKind: str, targetActive: bool): AuraDragDropState:
  if not targetActive:
    ret dnd
  ret auraDragDropTarget(dnd, targetId, rect.x, rect.y, rect.w, rect.h, acceptKind)

pub fn auraDragDropSimulate(mut dnd: AuraDragDropState, sourceId: str, payloadKind: str, payload: str, targetId: str): AuraDragDropState:
  if not dnd.active:
    dnd.droppedThisFrame = false
    dnd.dropTargetId = ""
    ret dnd
  dnd.sourceId = sourceId
  dnd.payloadKind = payloadKind
  dnd.payload = payload
  dnd.hoveredTargetId = targetId
  dnd.dropTargetId = targetId
  dnd.droppedThisFrame = true
  dnd.isDragging = false
  ret dnd

pub fn auraDragDropRenderOverlay(mut dnd: AuraDragDropState): void:
  if not dnd.active or not dnd.isDragging:
    ret
  if not isMouseButtonDown(0):
    dnd.isDragging = false
    ret
  let badgeTxt = "[" + dnd.payloadKind.toUpperCase() + "] " + dnd.label
  let targetHint = if dnd.hoveredTargetId.len > 0: "  -> DROP ON: " + dnd.hoveredTargetId else: "  (Drag to target window)"
  let fullTxt = badgeTxt + targetHint
  let bw = maxFloat(160.0, measureTextWidthPx(fullTxt, 0.80) + 24.0)
  let bh = 28.0
  let gx = clampFloat(dnd.curX + 12.0, 4.0, 1280.0 - bw - 4.0)
  let gy = clampFloat(dnd.curY + 10.0, 4.0, 720.0 - bh - 4.0)
  let borderHex = if dnd.hoveredTargetId.len > 0: 0x22C55E else: 0x00F5D4
  drawRoundedRect(gx + 2.0, gy + 2.0, bw, bh, 6.0, colorHex(0x020617))
  drawRoundedRect(gx, gy, bw, bh, 6.0, colorHex(0x1E293B))
  drawRoundedRectOutline(gx, gy, bw, bh, 6.0, 2.0, colorHex(borderHex))
  drawText(fullTxt, gx + 10.0, gy + 8.0, 0.80, colorHex(0xFFFFFF))

// =============================================================================
// 4 Distinct Ways to Create TreeViews in AuraDesign
// =============================================================================
// Way 1: auraTreeView (Flat parallel labels + depths arrays)
// Way 2: AuraTreeNode + auraTreeViewInteractive (Collapsible hierarchy + badges)
// Way 3: auraTreeFromPaths + auraTreeViewPaths (Slash-delimited path builder)
// Way 4: auraTreeViewOutliner (Multi-column striped Outliner TreeView with right metrics)
// =============================================================================

pub struct AuraTreeNode(id: str, label: str, depth: int, hasChildren: bool, expanded: bool, badge: str)

pub fn auraTreeNodeBranch(id: str, label: str, depth: int, expanded: bool, badge: str): AuraTreeNode:
  ret AuraTreeNode(
    id = id,
    label = label,
    depth = depth,
    hasChildren = true,
    expanded = expanded,
    badge = badge
  )

pub fn auraTreeNodeLeaf(id: str, label: str, depth: int, badge: str): AuraTreeNode:
  ret AuraTreeNode(
    id = id,
    label = label,
    depth = depth,
    hasChildren = false,
    expanded = true,
    badge = badge
  )

pub fn auraTreeToggleNode(nodes: [AuraTreeNode], targetId: str): [AuraTreeNode]:
  mut out: [AuraTreeNode] = []
  mut i = 0
  while i < nodes.len:
    mut n = nodes[i]
    if n.id == targetId and n.hasChildren:
      n.expanded = not n.expanded
    out.push(n)
    i += 1
  ret out

pub fn auraTreeIsNodeVisible(nodes: [AuraTreeNode], idx: int): bool:
  if idx < 0 or idx >= nodes.len:
    ret false
  if idx == 0:
    ret true
  mut targetDepth = nodes[idx].depth
  mut j = idx - 1
  while j >= 0:
    if nodes[j].depth < targetDepth:
      if nodes[j].hasChildren and not nodes[j].expanded:
        ret false
      targetDepth = nodes[j].depth
    j -= 1
  ret true

/// Way 1: Flat parallel-array TreeView (`labels` + `depths`).
pub fn auraTreeView(ctx: AuraContext, id: str, rect: AuraRect, labels: [str], depths: [int], selectedIdx: int): int:
  let _idLen = id.len
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  mut chosen = selectedIdx
  let rowH = 26.0
  mut i = 0
  while i < labels.len:
    let ry = rect.y + 6.0 + float(i) * rowH
    if ry + rowH <= rect.y + rect.h:
      let rowRect = AuraRect(x = rect.x + 4.0, y = ry, w = rect.w - 8.0, h = rowH)
      let hovered = auraIsHovered(ctx, rowRect)
      if auraIsClicked(ctx, rowRect):
        chosen = i
      if i == chosen:
        drawRoundedRect(rowRect.x, rowRect.y, rowRect.w, rowRect.h, 4.0, colorHex(ctx.theme.primaryContainer))
      elif hovered:
        drawRoundedRect(rowRect.x, rowRect.y, rowRect.w, rowRect.h, 4.0, colorHex(ctx.theme.surface2))
      mut depth = 0
      if i < depths.len:
        depth = depths[i]
      let indentX = rect.x + 12.0 + float(depth) * 16.0
      if depth > 0:
        drawLine(indentX - 8.0, ry + 2.0, indentX - 8.0, ry + rowH - 2.0, 1.0, colorHex(ctx.theme.outlineVariant))
        drawLine(indentX - 8.0, ry + rowH * 0.5, indentX - 2.0, ry + rowH * 0.5, 1.0, colorHex(ctx.theme.outlineVariant))
      drawText(">", indentX, ry + 7.0, 0.8, colorHex(ctx.theme.textMuted))
      drawText(labels[i], indentX + 14.0, ry + 7.0, 0.85, colorHex(ctx.theme.textPrimary))
    i = i + 1
  ret chosen

pub fn auraFitTextToWidth(text: str, maxW: float, sz: float): str:
  if text.len == 0 or maxW <= 0.0:
    ret ""
  let fullW = measureTextWidthPx(text, sz)
  if fullW <= maxW:
    ret text
  mut lo = 0
  mut hi = text.len
  mut best = 0
  while lo <= hi:
    let mid = (lo + hi) / 2
    let cand = if mid > 0: text.slice(0, mid) + "..." else: "..."
    if measureTextWidthPx(cand, sz) <= maxW:
      best = mid
      lo = mid + 1
    else:
      hi = mid - 1
  if best <= 0:
    ret "..."
  ret text.slice(0, best) + "..."

/// Way 2: Structured Interactive Hierarchy TreeView (`AuraTreeNode`) with Expand/Collapse & Badges.
pub fn auraTreeViewInteractive(x: float, y: float, w: float, nodes: [AuraTreeNode], selectedId: str): str:
  let mx = getMouseX()
  let my = getMouseY()
  let clicked = isMouseButtonPressed(0)
  let rowH = 26.0
  mut clickedId = ""
  mut visRow = 0
  mut i = 0
  while i < nodes.len:
    if auraTreeIsNodeVisible(nodes, i):
      let nd = nodes[i]
      let ry = y + float(visRow) * rowH
      if ry + rowH <= 560.0:
        let hovered = mx >= x and mx <= x + w and my >= ry and my <= ry + rowH
        let isSel = nd.id == selectedId
        if isSel:
          drawRoundedRect(x + 2.0, ry + 1.0, w - 4.0, rowH - 2.0, 5.0, colorHex(0x1E3A8A))
          drawRoundedRectOutline(x + 2.0, ry + 1.0, w - 4.0, rowH - 2.0, 5.0, 1.5, colorHex(0x38BDF8))
        elif hovered:
          drawRoundedRect(x + 2.0, ry + 1.0, w - 4.0, rowH - 2.0, 5.0, colorHex(0x1E293B))
        if clicked and hovered:
          clickedId = nd.id
        let indentX = x + 10.0 + float(nd.depth) * 18.0
        if nd.depth > 0:
          drawLine(indentX - 8.0, ry + 2.0, indentX - 8.0, ry + rowH * 0.55, 1.0, colorHex(0x475569))
          drawLine(indentX - 8.0, ry + rowH * 0.55, indentX - 2.0, ry + rowH * 0.55, 1.0, colorHex(0x475569))
        let icon = if nd.hasChildren: (if nd.expanded: "[-]" else: "[+]") else: " * "
        drawText(icon, indentX, ry + 6.0, 0.78, colorHex(0x38BDF8))
        let bw = if nd.badge.len > 0: measureTextWidthPx(nd.badge, 0.72) else: 0.0
        let badgeReserve = if nd.badge.len > 0: (if bw + 20.0 > 110.0: bw + 20.0 else: 110.0) else: 12.0
        let availLabelW = w - (indentX - x) - 24.0 - badgeReserve
        drawText(auraFitTextToWidth(nd.label, availLabelW, 0.82), indentX + 24.0, ry + 6.0, 0.82, colorHex(0xF8FAFC))
        if nd.badge.len > 0:
          drawText(nd.badge, x + w - bw - 10.0, ry + 7.0, 0.72, colorHex(0x94A3B8))
      visRow += 1
    i += 1
  ret clickedId

/// Way 3: Declarative Slash-Path TreeView Builder (`"Group/Subgroup/Item"` -> `[AuraTreeNode]`).
pub fn auraTreeFromPaths(paths: [str]): [AuraTreeNode]:
  mut nodes: [AuraTreeNode] = []
  mut seenIds: [str] = []
  mut pi = 0
  while pi < paths.len:
    let raw = paths[pi].trim()
    if raw.len > 0:
      let parts = raw.split("/")
      mut curPath = ""
      mut depth = 0
      mut si = 0
      while si < parts.len:
        let seg = parts[si].trim()
        if seg.len > 0:
          curPath = if curPath.len > 0: curPath + "/" + seg else: seg
          mut exists = false
          mut ki = 0
          while ki < seenIds.len:
            if seenIds[ki] == curPath:
              exists = true
              break
            ki += 1
          if not exists:
            seenIds.push(curPath)
            let isBranch = si < parts.len - 1
            if isBranch:
              nodes.push(auraTreeNodeBranch(curPath, seg, depth, true, ""))
            else:
              nodes.push(auraTreeNodeLeaf(curPath, seg, depth, ""))
          depth += 1
        si += 1
    pi += 1
  ret nodes

pub fn auraTreeViewPaths(x: float, y: float, w: float, paths: [str], selectedId: str): str:
  let nodes = auraTreeFromPaths(paths)
  ret auraTreeViewInteractive(x, y, w, nodes, selectedId)

/// Way 4: Multi-Column Enterprise Outliner TreeView (`AuraTreeNode` + Striped Rows + Right Telemetry Column).
pub fn auraTreeViewOutliner(x: float, y: float, w: float, nodes: [AuraTreeNode], selectedId: str): str:
  let mx = getMouseX()
  let my = getMouseY()
  let clicked = isMouseButtonPressed(0)
  drawRoundedRect(x, y, w, 28.0, 6.0, colorHex(0x0F172A))
  drawText("ORCHESTRA HIERARCHY (TARGET / WINDOW / BOT)", x + 10.0, y + 8.0, 0.75, colorHex(0x38BDF8))
  drawText("TELEMETRY / STATUS", x + w - 132.0, y + 8.0, 0.75, colorHex(0x38BDF8))
  let rowH = 30.0
  let startY = y + 32.0
  mut clickedId = ""
  mut visRow = 0
  mut i = 0
  while i < nodes.len:
    if auraTreeIsNodeVisible(nodes, i):
      let nd = nodes[i]
      let ry = startY + float(visRow) * rowH
      if ry + rowH <= 560.0:
        let hovered = mx >= x and mx <= x + w and my >= ry and my <= ry + rowH
        let isSel = nd.id == selectedId
        let stripeCol = if visRow % 2 == 0: 0x0F172A else: 0x172033
        let bgCol = if isSel: 0x1E3A8A elif hovered: 0x1E293B else: stripeCol
        drawRoundedRect(x + 2.0, ry + 1.0, w - 4.0, rowH - 2.0, 5.0, colorHex(bgCol))
        if isSel:
          drawRoundedRectOutline(x + 2.0, ry + 1.0, w - 4.0, rowH - 2.0, 5.0, 1.5, colorHex(0x38BDF8))
        if clicked and hovered:
          clickedId = nd.id
        let indentX = x + 10.0 + float(nd.depth) * 18.0
        if nd.depth > 0:
          drawLine(indentX - 9.0, ry + 2.0, indentX - 9.0, ry + rowH * 0.55, 1.0, colorHex(0x475569))
          drawLine(indentX - 9.0, ry + rowH * 0.55, indentX - 2.0, ry + rowH * 0.55, 1.0, colorHex(0x475569))
        let icon = if nd.hasChildren: (if nd.expanded: "[-]" else: "[+]") else: " > "
        let iconCol = if nd.depth == 0: 0x38BDF8 elif nd.depth == 1: 0x4ADE80 else: 0xFACC15
        drawText(icon, indentX, ry + 8.0, 0.78, colorHex(iconCol))
        let bw = if nd.badge.len > 0: measureTextWidthPx(nd.badge, 0.74) else: 0.0
        let badgeReserve = if bw + 20.0 > 142.0: bw + 20.0 else: 142.0
        let availLabelW = w - (indentX - x) - 24.0 - badgeReserve
        drawText(auraFitTextToWidth(nd.label, availLabelW, 0.80), indentX + 24.0, ry + 8.0, 0.80, colorHex(0xF8FAFC))
        if nd.badge.len > 0:
          drawText(nd.badge, x + w - bw - 10.0, ry + 9.0, 0.74, colorHex(0x94A3B8))
      visRow += 1
    i += 1
  ret clickedId

pub fn auraKanbanBoard(ctx: AuraContext, id: str, rect: AuraRect, columns: [str], cardsPerCol: [[str]]):
  if columns.len == 0:
    ret
  let gap = 12.0
  let colW = (rect.w - float(columns.len - 1) * gap) / float(columns.len)
  mut c = 0
  while c < columns.len:
    let cx = rect.x + float(c) * (colW + gap)
    drawRoundedRect(cx, rect.y, colW, rect.h, ctx.theme.radiusMd, colorHex(ctx.theme.surface1))
    drawText(columns[c], cx + 12.0, rect.y + 12.0, 0.95, colorHex(ctx.theme.textPrimary))
    if c < cardsPerCol.len:
      let cards = cardsPerCol[c]
      mut k = 0
      while k < cards.len:
        let cardY = rect.y + 40.0 + float(k) * 54.0
        if cardY + 46.0 <= rect.y + rect.h:
          drawRoundedRect(cx + 8.0, cardY, colW - 16.0, 46.0, ctx.theme.radiusSm, colorHex(ctx.theme.surface2))
          drawRoundedRect(cx + 8.0, cardY, 4.0, 46.0, 2.0, colorHex(ctx.theme.primary))
          drawText(cards[k], cx + 20.0, cardY + 16.0, 0.85, colorHex(ctx.theme.textPrimary))
        k = k + 1
    c = c + 1
  ret

pub fn auraKpiCard(ctx: AuraContext, rect: AuraRect, title: str, value: str, deltaText: str, positive: bool, sparkline: [float]):
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, 1.0, colorHex(ctx.theme.outlineVariant))
  drawText(title, rect.x + 14.0, rect.y + 12.0, 0.85, colorHex(ctx.theme.textSecondary))
  drawText(value, rect.x + 14.0, rect.y + 34.0, 1.35, colorHex(ctx.theme.textPrimary))
  mut deltaCol = ctx.theme.danger
  if positive:
    deltaCol = ctx.theme.success
  drawText(deltaText, rect.x + 14.0, rect.y + rect.h - 20.0, 0.8, colorHex(deltaCol))
  if sparkline.len >= 2:
    let sparkX = rect.x + rect.w * 0.52
    let sparkW = rect.w * 0.42
    let sparkY = rect.y + 24.0
    let sparkH = rect.h - 36.0
    auraLineChart(ctx, AuraRect(x = sparkX, y = sparkY, w = sparkW, h = sparkH), sparkline, deltaCol)
  ret

pub fn auraBarChart(ctx: AuraContext, rect: AuraRect, labels: [str], values: [float], barColor: int):
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  if values.len == 0:
    ret
  mut maxV = 1.0
  mut i = 0
  while i < values.len:
    if values[i] > maxV:
      maxV = values[i]
    i = i + 1
  let plotH = rect.h - 28.0
  let stepW = (rect.w - 16.0) / float(values.len)
  mut idx = 0
  while idx < values.len:
    let ratio = clampFloat(values[idx] / maxV, 0.0, 1.0)
    let bh = plotH * ratio
    let bx = rect.x + 8.0 + float(idx) * stepW + 4.0
    let by = rect.y + 8.0 + (plotH - bh)
    drawRoundedRect(bx, by, maxFloat(4.0, stepW - 8.0), bh, 3.0, colorHex(barColor))
    if idx < labels.len:
      drawTextCentered(labels[idx], bx + (stepW - 8.0) * 0.5, rect.y + rect.h - 14.0, 0.7, colorHex(ctx.theme.textMuted))
    idx = idx + 1
  ret

pub fn auraLineChart(ctx: AuraContext, rect: AuraRect, values: [float], lineColor: int):
  if values.len < 2:
    ret
  mut minV = values[0]
  mut maxV = values[0]
  mut i = 1
  while i < values.len:
    if values[i] < minV:
      minV = values[i]
    if values[i] > maxV:
      maxV = values[i]
    i = i + 1
  mut span = maxV - minV
  if span <= 0.0001:
    span = 1.0
  let stepX = rect.w / float(values.len - 1)
  mut j = 0
  while j + 1 < values.len:
    let x1 = rect.x + float(j) * stepX
    let y1 = rect.y + rect.h - ((values[j] - minV) / span) * rect.h
    let x2 = rect.x + float(j + 1) * stepX
    let y2 = rect.y + rect.h - ((values[j + 1] - minV) / span) * rect.h
    drawLine(x1, y1, x2, y2, colorHex(lineColor), 2.0)
    j = j + 1
  ret

pub fn auraStackedAreaChart(ctx: AuraContext, rect: AuraRect, seriesA: [float], seriesB: [float], colorA: int, colorB: int):
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  if seriesA.len < 2 and seriesB.len < 2:
    ret
  mut globalMin = if seriesA.len > 0: seriesA[0] else: seriesB[0]
  mut globalMax = globalMin
  mut i = 0
  while i < seriesA.len:
    if seriesA[i] < globalMin:
      globalMin = seriesA[i]
    if seriesA[i] > globalMax:
      globalMax = seriesA[i]
    i = i + 1
  mut j = 0
  while j < seriesB.len:
    if seriesB[j] < globalMin:
      globalMin = seriesB[j]
    if seriesB[j] > globalMax:
      globalMax = seriesB[j]
    j = j + 1
  mut span = globalMax - globalMin
  if span <= 0.0001:
    span = 1.0
  let padMin = globalMin - span * 0.08
  let padSpan = span * 1.16
  let innerY = rect.y + 4.0
  let innerH = maxFloat(8.0, rect.h - 8.0)
  if seriesA.len >= 2:
    let stepA = rect.w / float(seriesA.len - 1)
    mut ka = 0
    while ka + 1 < seriesA.len:
      let x1 = rect.x + float(ka) * stepA
      let y1 = innerY + innerH - ((seriesA[ka] - padMin) / padSpan) * innerH
      let x2 = rect.x + float(ka + 1) * stepA
      let y2 = innerY + innerH - ((seriesA[ka + 1] - padMin) / padSpan) * innerH
      drawLine(x1, y1, x2, y2, colorHex(colorA), 2.2)
      ka = ka + 1
  if seriesB.len >= 2:
    let stepB = rect.w / float(seriesB.len - 1)
    mut kb = 0
    while kb + 1 < seriesB.len:
      let x1 = rect.x + float(kb) * stepB
      let y1 = innerY + innerH - ((seriesB[kb] - padMin) / padSpan) * innerH
      let x2 = rect.x + float(kb + 1) * stepB
      let y2 = innerY + innerH - ((seriesB[kb + 1] - padMin) / padSpan) * innerH
      drawLine(x1, y1, x2, y2, colorHex(colorB), 2.2)
      kb = kb + 1
  ret

pub fn auraDonutChart(ctx: AuraContext, x: float, y: float, radius: float, values: [float], colors: [int]):
  mut total = 0.0
  mut i = 0
  while i < values.len:
    total = total + maxFloat(0.0, values[i])
    i = i + 1
  if total <= 0.0:
    drawCircleOutline(x, y, radius, 8.0, colorHex(ctx.theme.surface2))
    ret
  mut startAngle = 0.0
  mut idx = 0
  while idx < values.len:
    let frac = maxFloat(0.0, values[idx]) / total
    let sweep = frac * 6.2831853
    mut col = ctx.theme.primary
    if idx < colors.len:
      col = colors[idx]
    drawArc(x, y, radius, startAngle, startAngle + sweep, 10.0, colorHex(col))
    startAngle = startAngle + sweep
    idx = idx + 1
  ret

pub fn auraHistogram(ctx: AuraContext, rect: AuraRect, values: [float], bins: int, color: int):
  mut safeBins = bins
  if safeBins < 1:
    safeBins = 1
  mut counts: [float] = []
  mut b = 0
  while b < safeBins:
    counts.push(0.0)
    b = b + 1
  if values.len > 0:
    mut minV = values[0]
    mut maxV = values[0]
    mut i = 1
    while i < values.len:
      if values[i] < minV:
        minV = values[i]
      if values[i] > maxV:
        maxV = values[i]
      i = i + 1
    mut span = maxV - minV
    if span <= 0.0001:
      span = 1.0
    mut k = 0
    while k < values.len:
      mut binIdx = int(((values[k] - minV) / span) * float(safeBins - 1))
      if binIdx < 0:
        binIdx = 0
      if binIdx >= safeBins:
        binIdx = safeBins - 1
      counts[binIdx] = counts[binIdx] + 1.0
      k = k + 1
  let emptyLabels: [str] = []
  auraBarChart(ctx, rect, emptyLabels, counts, color)
  ret

// =============================================================================
// 13.5 Modals, Overlays, Notifications & Feedback
// =============================================================================

pub fn auraModalDialog(ctx: AuraContext, id: str, title: str, w: float, h: float, isOpen: bool): bool:
  if not isOpen:
    ret false
  let sw = getScreenWidth()
  let sh = getScreenHeight()
  drawRect(0.0, 0.0, sw, sh, auraScrimColor(ctx.theme.scrim))
  let mx = (sw - w) * 0.5
  let my = (sh - h) * 0.5
  drawRoundedRect(mx + 4.0, my + 8.0, w, h, ctx.theme.radiusLg, rgba(0, 0, 0, 0.45))
  drawRoundedRect(mx, my, w, h, ctx.theme.radiusLg, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(mx, my, w, h, ctx.theme.radiusLg, 1.5, colorHex(ctx.theme.outline))
  drawText(title, mx + 20.0, my + 18.0, 1.1, colorHex(ctx.theme.textPrimary))
  let closeBtn = AuraRect(x = mx + w - 36.0, y = my + 12.0, w = 24.0, h = 24.0)
  if auraIsClicked(ctx, closeBtn) or isKeyPressed("Escape"):
    ret false
  drawTextCentered("X", closeBtn.x + 12.0, closeBtn.y + 6.0, 0.9, colorHex(ctx.theme.textSecondary))
  ret true

pub fn auraDrawerSheet(ctx: AuraContext, id: str, side: str, w: float, title: str, isOpen: bool): AuraRect:
  let sw = getScreenWidth()
  let sh = getScreenHeight()
  if not isOpen:
    ret AuraRect(x = sw, y = 0.0, w = 0.0, h = 0.0)
  mut dx = sw - w
  mut borderX = dx
  if side == "left":
    dx = 0.0
    borderX = dx + w - 1.0
  drawRect(dx, 0.0, w, sh, colorHex(ctx.theme.surface1))
  drawRect(borderX, 0.0, 1.0, sh, colorHex(ctx.theme.outline))
  drawText(title, dx + 16.0, 18.0, 1.05, colorHex(ctx.theme.textPrimary))
  ret AuraRect(x = dx + 12.0, y = 48.0, w = w - 24.0, h = sh - 60.0)

pub fn auraSnackbar(ctx: AuraContext, message: str, actionLabel: str, severity: str): bool:
  let sw = getScreenWidth()
  let sh = getScreenHeight()
  let w = 360.0
  let h = 48.0
  let sx = sw - w - 24.0
  let sy = sh - h - 24.0
  mut accent = ctx.theme.info
  if severity == "success":
    accent = ctx.theme.success
  elif severity == "warning":
    accent = ctx.theme.warning
  elif severity == "danger" or severity == "error":
    accent = ctx.theme.danger
  // MD3 2-layer floating elevation shadow
  drawRoundedRect(sx, sy + 2.0, w, h, ctx.theme.radiusMd, rgba(0, 0, 0, 0.18))
  drawRoundedRect(sx, sy + 6.0, w, h, ctx.theme.radiusMd, rgba(0, 0, 0, 0.35))
  // Surface fill & outline
  drawRoundedRect(sx, sy, w, h, ctx.theme.radiusMd, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(sx, sy, w, h, ctx.theme.radiusMd, 1.0, colorHex(ctx.theme.outlineVariant))
  // Left accent indicator
  drawRoundedRect(sx + 3.0, sy + 4.0, 4.0, h - 8.0, 2.0, colorHex(accent))
  drawText(message, sx + 18.0, sy + (h - 10.0) * 0.5, 0.9, colorHex(ctx.theme.textPrimary))
  if actionLabel.len > 0:
    let actW = measureTextWidthPx(actionLabel, 0.85) + 20.0
    let actRect = AuraRect(x = sx + w - actW - 10.0, y = sy + 8.0, w = actW, h = 32.0)
    let actHovered = auraIsHovered(ctx, actRect)
    if actHovered:
      drawRoundedRect(actRect.x, actRect.y, actRect.w, actRect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface2))
    drawTextCentered(actionLabel, actRect.x + actRect.w * 0.5, actRect.y + 11.0, 0.85, colorHex(ctx.theme.primary))
    ret auraIsClicked(ctx, actRect)
  ret false

pub fn auraTooltip(ctx: AuraContext, targetRect: AuraRect, text: str):
  if auraIsHovered(ctx, targetRect):
    let tw = measureTextWidthPx(text, 0.8) + 16.0
    let th = 24.0
    let tx = targetRect.x + (targetRect.w - tw) * 0.5
    let ty = targetRect.y - th - 6.0
    drawRoundedRect(tx, ty, tw, th, 4.0, colorHex(ctx.theme.surface3))
    drawTextCentered(text, tx + tw * 0.5, ty + 6.0, 0.8, colorHex(ctx.theme.textPrimary))
    ctx.zOverlays.set("tooltip:" + text, AuraZOverlay(
      id = "tooltip:" + text,
      kind = "tooltip",
      rect = AuraRect(x = tx, y = ty, w = tw, h = th),
      options = [],
      selectedIdx = -1,
      text = text,
      zOrder = 200
    ))
  ret

pub fn auraContextMenu(ctx: AuraContext, id: str, x: float, y: float, items: [str], isOpen: bool): int:
  if not isOpen or items.len == 0:
    ret -1
  let w = 160.0
  let rowH = 28.0
  let h = float(items.len) * rowH + 8.0
  drawRoundedRect(x, y, w, h, ctx.theme.radiusSm, colorHex(ctx.theme.surface2))
  drawRoundedRectOutline(x, y, w, h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outline))
  mut clickedIdx = -1
  mut i = 0
  while i < items.len:
    let ry = y + 4.0 + float(i) * rowH
    let itemRect = AuraRect(x = x + 4.0, y = ry, w = w - 8.0, h = rowH)
    if auraIsHovered(ctx, itemRect):
      drawRoundedRect(itemRect.x, itemRect.y, itemRect.w, itemRect.h, 4.0, colorHex(ctx.theme.primaryContainer))
    if auraIsClicked(ctx, itemRect):
      clickedIdx = i
    drawText(items[i], itemRect.x + 10.0, ry + 8.0, 0.85, colorHex(ctx.theme.textPrimary))
    i = i + 1
  ret clickedIdx

// =============================================================================
// 13.6 Game UI & Arcade HUD Component Suite
// =============================================================================

pub fn auraHealthBar(ctx: AuraContext, rect: AuraRect, current: float, maxVal: float, delayedDamage: float, fillColor: int):
  mut safeMax = maxVal
  if safeMax <= 0.0:
    safeMax = 1.0
  let curRatio = clampFloat(current / safeMax, 0.0, 1.0)
  let delayRatio = clampFloat(delayedDamage / safeMax, curRatio, 1.0)
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(ctx.theme.surface0))
  if delayRatio > 0.0:
    drawRoundedRect(rect.x + 2.0, rect.y + 2.0, (rect.w - 4.0) * delayRatio, rect.h - 4.0, 3.0, colorHex(ctx.theme.danger))
  if curRatio > 0.0:
    drawRoundedRect(rect.x + 2.0, rect.y + 2.0, (rect.w - 4.0) * curRatio, rect.h - 4.0, 3.0, colorHex(fillColor))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.5, colorHex(ctx.theme.outline))
  ret

pub fn auraAbilitySlot(ctx: AuraContext, rect: AuraRect, label: str, keybind: str, cooldownRem: float, cooldownTotal: float, active: bool): bool:
  let clicked = auraIsClicked(ctx, rect)
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface1))
  mut borderCol = ctx.theme.outline
  mut borderThick = 1.0
  if active:
    borderCol = ctx.theme.primary
    borderThick = 2.0
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, borderThick, colorHex(borderCol))
  drawTextCentered(label, rect.x + rect.w * 0.5, rect.y + rect.h * 0.5 - 5.0, 0.85, colorHex(ctx.theme.textPrimary))
  if cooldownRem > 0.0 and cooldownTotal > 0.0:
    let cdRatio = clampFloat(cooldownRem / cooldownTotal, 0.0, 1.0)
    let sweepH = rect.h * cdRatio
    drawRoundedRect(rect.x, rect.y + (rect.h - sweepH), rect.w, sweepH, ctx.theme.radiusSm, auraScrimColor(ctx.theme.scrim))
  drawRoundedRect(rect.x + 3.0, rect.y + 3.0, 16.0, 14.0, 3.0, colorHex(ctx.theme.surface3))
  drawTextCentered(keybind, rect.x + 11.0, rect.y + 5.0, 0.7, colorHex(ctx.theme.textPrimary))
  ret clicked and cooldownRem <= 0.0

pub fn auraRadialMenu(ctx: AuraContext, centerX: float, centerY: float, innerR: float, outerR: float, items: [str], selectedIdx: int): int:
  drawCircleOutline(centerX, centerY, outerR, 2.0, colorHex(ctx.theme.primary))
  drawCircle(centerX, centerY, innerR, colorHex(ctx.theme.surface1))
  if items.len == 0:
    ret selectedIdx
  mut chosen = selectedIdx
  let dx = ctx.mouseX - centerX
  let dy = ctx.mouseY - centerY
  let dist = sqrt(dx * dx + dy * dy)
  let stepAngle = 6.2831853 / float(items.len)
  if dist >= innerR and dist <= outerR:
    mut ang = atan2(dy, dx)
    if ang < 0.0:
      ang = ang + 6.2831853
    chosen = int(ang / stepAngle) % items.len
  let midR = (innerR + outerR) * 0.5
  mut i = 0
  while i < items.len:
    let a = (float(i) + 0.5) * stepAngle
    let ix = centerX + cos(a) * midR
    let iy = centerY + sin(a) * midR
    mut col = ctx.theme.textSecondary
    mut nodeBg = ctx.theme.surface2
    if i == chosen:
      col = ctx.theme.primary
      nodeBg = ctx.theme.primaryContainer
    drawCircle(ix, iy, 16.0, colorHex(nodeBg))
    drawTextCentered(items[i], ix, iy - 4.0, 0.75, colorHex(col))
    i = i + 1
  ret chosen

pub fn auraVirtualJoystick(ctx: AuraContext, id: str, centerX: float, centerY: float, radius: float): Vec2:
  drawCircle(centerX, centerY, radius, auraGlassColor(ctx.theme.surfaceGlass))
  drawCircleOutline(centerX, centerY, radius, 2.0, colorHex(ctx.theme.outline))
  mut outX = 0.0
  mut outY = 0.0
  if ctx.mouseDown and radius > 0.0:
    let dx = ctx.mouseX - centerX
    let dy = ctx.mouseY - centerY
    let d = sqrt(dx * dx + dy * dy)
    if d <= radius * 1.5 and d > 0.001:
      let clamped = minFloat(d, radius)
      outX = (dx / d) * (clamped / radius)
      outY = (dy / d) * (clamped / radius)
  drawCircle(centerX + outX * radius * 0.6, centerY + outY * radius * 0.6, radius * 0.38, colorHex(ctx.theme.primary))
  ret Vec2(x = outX, y = outY)

pub fn auraTouchActionButtons(ctx: AuraContext, x: float, y: float, labels: [str]): int:
  mut pressedIdx = -1
  mut i = 0
  while i < labels.len:
    let bx = x + float(i) * 56.0
    let btnRect = AuraRect(x = bx - 22.0, y = y - 22.0, w = 44.0, h = 44.0)
    if auraIsClicked(ctx, btnRect):
      pressedIdx = i
    mut btnBg = ctx.theme.surface2
    if pressedIdx == i:
      btnBg = ctx.theme.primary
    drawCircle(bx, y, 22.0, colorHex(btnBg))
    drawCircleOutline(bx, y, 22.0, 1.5, colorHex(ctx.theme.secondary))
    drawTextCentered(labels[i], bx, y - 5.0, 0.9, colorHex(ctx.theme.textPrimary))
    i = i + 1
  ret pressedIdx

pub fn auraComboCounter(ctx: AuraContext, x: float, y: float, hits: int, label: str, timerRatio: float):
  if hits <= 0:
    ret
  drawText("{hits}x", x, y, 1.6, colorHex(ctx.theme.tertiary))
  drawText(label, x, y + 22.0, 0.9, colorHex(ctx.theme.secondary))
  let barW = 84.0
  drawRoundedRect(x, y + 36.0, barW, 5.0, 2.5, colorHex(ctx.theme.surface2))
  drawRoundedRect(x, y + 36.0, barW * clampFloat(timerRatio, 0.0, 1.0), 5.0, 2.5, colorHex(ctx.theme.primary))
  ret

pub fn auraFloatingCombatText(ctx: AuraContext, x: float, y: float, text: str, color: int, isCrit: bool):
  mut sz = 0.95
  if isCrit:
    sz = 1.35
  drawTextCentered(text, x + 1.0, y + 1.0, sz, colorHex(0x000000))
  drawTextCentered(text, x, y, sz, colorHex(color))
  ret

pub fn auraMinimapFrame(ctx: AuraContext, rect: AuraRect, worldW: float, worldH: float, blipPositions: [Vec2], blipColors: [int]):
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.5, colorHex(ctx.theme.outline))
  mut safeW = 1.0
  if worldW > 0.0:
    safeW = worldW
  mut safeH = 1.0
  if worldH > 0.0:
    safeH = worldH
  mut i = 0
  while i < blipPositions.len:
    let pos = blipPositions[i]
    let bx = rect.x + clampFloat(pos.x / safeW, 0.0, 1.0) * rect.w
    let by = rect.y + clampFloat(pos.y / safeH, 0.0, 1.0) * rect.h
    mut col = ctx.theme.primary
    if i < blipColors.len:
      col = blipColors[i]
    drawCircle(bx, by, 3.5, colorHex(col))
    i = i + 1
  ret

pub fn auraGameOverlay(ctx: AuraContext, variant: str, title: str, subtitle: str, statLabels: [str], statValues: [str], primaryBtn: str, secondaryBtn: str): int:
  let sw = getScreenWidth()
  let sh = getScreenHeight()
  drawRect(0.0, 0.0, sw, sh, auraScrimColor(ctx.theme.scrim))
  let cardW = 380.0
  let cardH = 260.0
  let cx = (sw - cardW) * 0.5
  let cy = (sh - cardH) * 0.5
  drawRoundedRect(cx, cy, cardW, cardH, ctx.theme.radiusLg, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(cx, cy, cardW, cardH, ctx.theme.radiusLg, 2.0, colorHex(ctx.theme.primary))
  drawTextCentered(title, cx + cardW * 0.5, cy + 24.0, 1.4, colorHex(ctx.theme.textPrimary))
  if subtitle.len > 0:
    drawTextCentered(subtitle, cx + cardW * 0.5, cy + 50.0, 0.9, colorHex(ctx.theme.textSecondary))
  mut i = 0
  while i < statLabels.len and i < statValues.len:
    let ry = cy + 84.0 + float(i) * 24.0
    drawText(statLabels[i], cx + 32.0, ry, 0.9, colorHex(ctx.theme.textSecondary))
    drawTextRight(statValues[i], cx + cardW - 32.0, ry, 0.9, colorHex(ctx.theme.textPrimary))
    i = i + 1
  mut action = 0
  let btnY = cy + cardH - 52.0
  if primaryBtn.len > 0:
    let pRect = AuraRect(x = cx + 32.0, y = btnY, w = 148.0, h = 36.0)
    if auraButton(ctx, "overlay_primary", pRect, primaryBtn, "filled"):
      action = 1
  if secondaryBtn.len > 0:
    let sRect = AuraRect(x = cx + cardW - 180.0, y = btnY, w = 148.0, h = 36.0)
    if auraButton(ctx, "overlay_secondary", sRect, secondaryBtn, "outlined"):
      action = 2
  ret action

pub fn auraDialogueBox(ctx: AuraContext, rect: AuraRect, speaker: str, fullText: str, revealedChars: int, choices: [str]): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, 1.5, colorHex(ctx.theme.primary))
  if speaker.len > 0:
    let badgeW = measureTextWidthPx(speaker, 0.9) + 24.0
    drawRoundedRect(rect.x + 16.0, rect.y - 12.0, badgeW, 24.0, 6.0, colorHex(ctx.theme.primary))
    drawTextCentered(speaker, rect.x + 16.0 + badgeW * 0.5, rect.y - 5.0, 0.9, colorHex(ctx.theme.onPrimary))
  let shownLen = clamp(revealedChars, 0, fullText.len)
  let visibleText = fullText.slice(0, shownLen)
  drawTextBox(visibleText, rect.x + 18.0, rect.y + 20.0, rect.w - 36.0, 0.95, colorHex(ctx.theme.textPrimary))
  mut chosen = -1
  if choices.len > 0:
    let choiceW = (rect.w - 36.0 - float(choices.len - 1) * 8.0) / float(choices.len)
    let choiceY = rect.y + rect.h - 36.0
    mut i = 0
    while i < choices.len:
      let cx = rect.x + 18.0 + float(i) * (choiceW + 8.0)
      let cRect = AuraRect(x = cx, y = choiceY, w = choiceW, h = 28.0)
      if auraButton(ctx, "dlg_choice_{i}", cRect, choices[i], "tonal"):
        chosen = i
      i = i + 1
  ret chosen

// =============================================================================
// Standalone Immediate-Mode Aura Canvas Drawing Helpers
// =============================================================================

pub fn drawButton(x: float, y: float, w: float, h: float, label: str, active: bool = false): bool:
  let hovered = isMouseInRect(x, y, w, h)
  let clicked = isRectClicked(x, y, w, h)
  let bg = if active: 0x3B82F6 else: (if hovered: 0x334155 else: 0x1E293B)
  let fg = if active: 0xFFFFFF else: (if hovered: 0xF8FAFC else: 0xCBD5E1)
  drawRoundedRect(x, y, w, h, 6.0, colorHex(bg))
  if hovered or active:
    drawRoundedRectOutline(x, y, w, h, 6.0, 1.5, colorHex(0x60A5FA))
  drawTextCentered(label, x + w * 0.5, y + (h - 10.0) * 0.5, 0.9, colorHex(fg))
  ret clicked

pub fn drawTabStrip(x: float, y: float, w: float, h: float, tabs: [str], activeIdx: int): int:
  mut selected = activeIdx
  let n = tabs.len()
  if n == 0:
    ret selected
  let tabW = w / float(n)
  mut i = 0
  while i < n:
    let tx = x + float(i) * tabW
    if isRectClicked(tx, y, tabW, h):
      selected = i
    let isActive = (i == selected)
    let bg = if isActive: 0x1E293B else: 0x0F172A
    let fg = if isActive: 0x60A5FA else: 0x94A3B8
    drawRect(tx, y, tabW, h, colorHex(bg))
    if isActive:
      drawRect(tx, y + h - 3.0, tabW, 3.0, colorHex(0x38BDF8))
    drawTextCentered(tabs[i], tx + tabW * 0.5, y + (h - 10.0) * 0.5, 0.9, colorHex(fg))
    i += 1
  ret selected

pub fn drawSlider(x: float, y: float, w: float, h: float, value: float, minVal: float, maxVal: float): float:
  let span = if maxVal > minVal: maxVal - minVal else: 1.0
  let clampedVal = clampFloat(value, minVal, maxVal)
  let trackY = y + h * 0.5 - 2.0
  drawRoundedRect(x, trackY, w, 4.0, 2.0, colorHex(0x334155))
  let fillW = ((clampedVal - minVal) / span) * w
  drawRoundedRect(x, trackY, fillW, 4.0, 2.0, colorHex(0x38BDF8))
  let thumbX = x + fillW
  let thumbY = y + h * 0.5
  drawCircle(thumbX, thumbY, 8.0, colorHex(0x38BDF8))
  if isMouseButtonDown(0) and isMouseInRect(x - 8.0, y - 8.0, w + 16.0, h + 16.0):
    let mx = float(getMouseX())
    let ratio = clampFloat((mx - x) / w, 0.0, 1.0)
    ret minVal + ratio * span
  ret clampedVal

pub fn drawProgressBar(x: float, y: float, w: float, h: float, progress: float, color: int = 0x38BDF8, bgColor: int = 0x1E293B):
  let clampedP = clampFloat(progress, 0.0, 1.0)
  drawRoundedRect(x, y, w, h, 4.0, colorHex(bgColor))
  if clampedP > 0.0:
    drawRoundedRect(x, y, w * clampedP, h, 4.0, colorHex(color))
  drawRoundedRectOutline(x, y, w, h, 4.0, 1.0, colorHex(0x475569))
  ret

// =============================================================================
// Advanced Material Design 3 Aura Flow & Data Visualization Primitives
// =============================================================================

pub fn auraAutoWindowSize(c: AuraFlowContainer, minW: int, minH: int, padBottom: float): bool:
  let neededH = int(c.contentBottomY + padBottom)
  let curW = getWindowWidth()
  let curH = getWindowHeight()
  if neededH > curH or curW < minW or curH < minH:
    let newW = if curW < minW: minW else: curW
    let newH = if neededH > minH: neededH else: minH
    setWindowSize(newW, newH)
    ret true
  ret false

pub fn auraFlowNewline(c: AuraFlowContainer): AuraFlowContainer:
  let nextY = c.cursorY + c.rowMaxH + c.gapY
  ret AuraFlowContainer(
    x = c.x, y = c.y, w = c.w, h = c.h,
    padX = c.padX, padY = c.padY,
    gapX = c.gapX, gapY = c.gapY,
    cursorX = c.x + c.padX, cursorY = nextY,
    rowMaxH = 0.0, contentBottomY = c.contentBottomY,
    clip = c.clip, elevated = c.elevated
  )

pub fn auraSparkline(rect: AuraRect, values: [float], minVal: float, maxVal: float, lineCol: Color, fillCol: Color):
  drawRoundedRect(rect.x, rect.y + 2.0, rect.w, rect.h, 6.0, rgba(0, 0, 0, 0.22))
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 6.0, fillCol)
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 6.0, 1.0, rgba(255, 255, 255, 0.08))
  let padX = 8.0
  let padY = 8.0
  let plotW = rect.w - padX * 2.0
  let plotH = rect.h - padY * 2.0
  let gridY1 = rect.y + padY + plotH * 0.333
  let gridY2 = rect.y + padY + plotH * 0.666
  drawLine(rect.x + padX, gridY1, rect.x + rect.w - padX, gridY1, rgba(255, 255, 255, 0.06), 1.0)
  drawLine(rect.x + padX, gridY2, rect.x + rect.w - padX, gridY2, rgba(255, 255, 255, 0.06), 1.0)
  if values.len < 2:
    ret
  mut span = maxVal - minVal
  if span <= 0.0001:
    span = 1.0
  let stepX = plotW / float(values.len - 1)
  mut j = 0
  while j + 1 < values.len:
    let norm1 = clampFloat((values[j] - minVal) / span, 0.0, 1.0)
    let norm2 = clampFloat((values[j + 1] - minVal) / span, 0.0, 1.0)
    let x1 = rect.x + padX + float(j) * stepX
    let y1 = rect.y + rect.h - padY - norm1 * plotH
    let x2 = rect.x + padX + float(j + 1) * stepX
    let y2 = rect.y + rect.h - padY - norm2 * plotH
    drawLine(x1, y1, x2, y2, lineCol, 2.0)
    drawCircle(x1, y1, 2.0, lineCol)
    j = j + 1
  let lastNorm = clampFloat((values[values.len - 1] - minVal) / span, 0.0, 1.0)
  let lastX = rect.x + padX + float(values.len - 1) * stepX
  let lastY = rect.y + rect.h - padY - lastNorm * plotH
  drawCircle(lastX, lastY, 2.5, lineCol)
  ret

pub fn auraCircularGauge(cx: float, cy: float, radius: float, value: float, minVal: float, maxVal: float, label: str, unit: str, theme: AuraTheme):
  let thick = if radius * 0.12 > 4.0: radius * 0.12 else: 4.0
  drawArc(cx, cy, radius, 135.0, 405.0, thick, colorHex(theme.surface2))
  mut span = maxVal - minVal
  if span <= 0.0001:
    span = 1.0
  let ratio = clampFloat((value - minVal) / span, 0.0, 1.0)
  let activeEnd = 135.0 + ratio * 270.0
  if ratio > 0.001:
    drawArc(cx, cy, radius, 135.0, activeEnd, thick, colorHex(theme.primary))
  let valStr = if value == float(int(value)): str(int(value)) else: str(roundTo(value, 1))
  let displayText = if unit.len > 0: valStr + " " + unit else: valStr
  let valScale = clampFloat(radius * 0.02, 0.85, 1.35)
  let valH = measureTextHeight(displayText, valScale)
  drawTextCentered(displayText, cx, cy - valH * 0.5, valScale, colorHex(theme.textPrimary))
  if label.len > 0:
    let lblScale = clampFloat(valScale * 0.75, 0.70, 0.95)
    drawTextCentered(label, cx, cy + radius * 0.52, lblScale, colorHex(theme.textSecondary))
  ret

