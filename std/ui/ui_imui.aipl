/// Renders a scholarly BibTeX / CSL citation & DOI verification inspector card (`AuraDS 6.0`).
pub fn auraCitationBibtexInspector(x: float, y: float, w: float, h: float, citeKey: str, doiString: str, cslStyle: str): void:
  drawRoundedRect(x, y, w, h, 4.0, rgba(16, 22, 32, 225))
  drawRoundedRectOutline(x, y, w, h, 4.0, 1.0, colorHex(0x14B8A6))
  drawText("BIBTEX [" + citeKey + "] DOI:" + doiString + " | CSL:" + cslStyle, x + 8.0, y + (h - 10.0) * 0.5, 0.64, colorHex(0x99F6E4))

/// Renders a binary hex-editor offset, byte stream & ASCII preview strip (`AuraDS 6.0`).
pub fn auraHexBinaryInspectorStrip(x: float, y: float, w: float, h: float, offsetHex: str, bytesHex: str, asciiPreview: str): void:
  drawRoundedRect(x, y, w, h, 4.0, rgba(14, 18, 28, 225))
  drawRoundedRectOutline(x, y, w, h, 4.0, 1.0, colorHex(0x38BDF8))
  drawText("HEX " + offsetHex + ": " + bytesHex + "  |" + asciiPreview + "|", x + 8.0, y + (h - 10.0) * 0.5, 0.64, colorHex(0xBAE6FD))

/// Renders a digital paint studio CMYK ICC soft-proof & total ink coverage histogram card (`AuraDS 6.0`).
pub fn auraCMYKSoftProofHistogram(x: float, y: float, w: float, h: float, iccProfile: str, gamutWarnPct: int, inkCoveragePct: int): void:
  drawRoundedRect(x, y, w, h, 4.0, rgba(20, 16, 26, 225))
  drawRoundedRectOutline(x, y, w, h, 4.0, 1.0, colorHex(0xEC4899))
  drawText("CMYK [" + iccProfile + "] OOG:" + str(gamutWarnPct) + "% | TAC:" + str(inkCoveragePct) + "%", x + 8.0, y + (h - 10.0) * 0.5, 0.64, colorHex(0xFBCFE8))

