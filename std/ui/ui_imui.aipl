pub struct ImUiContext(hotId: int, activeId: int, mousePos: Vec2, isMouseDown: bool)

pub fn beginImUiFrame(ctx: ImUiContext, mouse: Vec2, mouseDown: bool): ImUiContext:
  ret ImUiContext(
    hotId = 0,
    activeId = if mouseDown: ctx.activeId else: 0,
    mousePos = mouse,
    isMouseDown = mouseDown
  )

pub fn imuiButton(ctx: ImUiContext, id: int, rect: Rect, label: str): bool:
  let inside = ctx.mousePos.x >= rect.x and ctx.mousePos.x <= (rect.x + rect.w) and ctx.mousePos.y >= rect.y and ctx.mousePos.y <= (rect.y + rect.h)
  if inside and (ctx.activeId == id or not ctx.isMouseDown) and label.len >= 0:
    ret true
  ret false

pub struct AuraTheme(name: str, bgCanvas: int, surface0: int, surface1: int, surface2: int, surface3: int, surfaceGlass: int, outline: int, outlineVariant: int, scrim: int, primary: int, onPrimary: int, primaryContainer: int, secondary: int, onSecondary: int = 0xFFFFFF, secondaryContainer: int = 0, tertiary: int, textPrimary: int, textSecondary: int, textMuted: int, success: int, onSuccess: int = 0x052E16, warning: int, onWarning: int = 0x451A03, danger: int, onDanger: int = 0xFFFFFF, info: int, radiusSm: float, radiusMd: float, radiusLg: float)
pub struct AuraFlowContainer(x: float, y: float, w: float, h: float, padX: float, padY: float, gapX: float, gapY: float, cursorX: float, cursorY: float, rowMaxH: float, contentBottomY: float, clip: bool, elevated: bool, surface1: int = 0x1E293B, outlineVariant: int = 0x334155, radiusMd: float = 10.0)
pub struct AuraZOverlay(id: str, kind: str, rect: AuraRect, options: [str], selectedIdx: int, text: str, zOrder: int)
pub struct AuraContext(theme: AuraTheme, hotId: str, activeId: str, focusedId: str, mouseX: float, mouseY: float, mouseDown: bool, mouseClicked: bool, wheelY: float, textInput: str, scrollOffsets: Map[str, float], cursorX: float, cursorY: float, layoutDir: str, layoutGap: float, textBuffers: Map[str, AuraTextEditBuffer] = mapNew(), zOverlays: Map[str, AuraZOverlay] = mapNew(), uiState: Map[str, str] = mapNew(), focusOrder: [str] = [])
pub struct AuraTextResult(text: str, changed: bool, submitted: bool)

