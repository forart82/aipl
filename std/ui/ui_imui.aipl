pub struct AuraButtonResult(clicked: bool, hovered: bool)

pub struct AuraInputResult(value: str, changed: bool, submitted: bool)

pub fn createAuraButtonResult(clicked: bool, hovered: bool): AuraButtonResult:
  ret AuraButtonResult(clicked = clicked, hovered = hovered)

