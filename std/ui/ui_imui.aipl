pub fn auraFontSizeSmall(): float:
  ret 0.78

pub fn auraFontSizeBody(): float:
  ret 0.92

pub fn auraFontSizeTitle(): float:
  ret 1.25

pub fn auraFontSizeDisplay(): float:
  ret 1.65

pub fn auraHeading(ctx: AuraContext, x: float, y: float, text: str):
  let sz = auraFontSizeTitle()
  drawText(text, x, y, sz, colorHex(ctx.theme.textPrimary))
  let tw = measureTextWidthPx(text, sz)
  let th = measureTextHeight(text, sz)
  drawRoundedRect(x, y + th + 3.0, clampFloat(tw * 0.35, 24.0, 96.0), 2.5, 1.2, colorHex(ctx.theme.primary))
  ret

pub fn auraSubheading(ctx: AuraContext, x: float, y: float, text: str):
  drawText(text, x, y, auraFontSizeBody(), colorHex(ctx.theme.textSecondary))
  ret

// =============================================================================
// 13.9 Rich Containers, Cards & Navigation Bars (M3 / Shadcn / Fluent 2)
// =============================================================================

pub fn auraElevatedCard(ctx: AuraContext, rect: AuraRect, elevation: int = 2):
  let lvl = clamp(elevation, 1, 4)
  let offset = float(lvl) * 2.0
  drawRoundedRect(rect.x, rect.y + offset, rect.w, rect.h, ctx.theme.radiusMd, rgba(0, 0, 0, 0.28))
  drawRoundedRect(rect.x, rect.y + offset * 0.5, rect.w, rect.h, ctx.theme.radiusMd, rgba(0, 0, 0, 0.16))
  let bg = if lvl >= 3: ctx.theme.surface2 else: ctx.theme.surface1
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, colorHex(bg))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, 1.0, colorHex(ctx.theme.outlineVariant))
  ret

pub fn auraGlassCard(ctx: AuraContext, rect: AuraRect, title: str = ""):
  drawRoundedRect(rect.x, rect.y + 4.0, rect.w, rect.h, ctx.theme.radiusMd, rgba(0, 0, 0, 0.25))
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, auraGlassColor(ctx.theme.surfaceGlass))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, 1.0, colorHex(ctx.theme.outline))
  drawLine(rect.x + ctx.theme.radiusMd, rect.y + 1.0, rect.x + rect.w - ctx.theme.radiusMd, rect.y + 1.0, rgba(255, 255, 255, 0.18), 1.0)
  if title.len > 0:
    drawText(title, rect.x + 14.0, rect.y + 10.0, 0.95, colorHex(ctx.theme.textPrimary))
    drawLine(rect.x + 10.0, rect.y + 32.0, rect.x + rect.w - 10.0, rect.y + 32.0, colorHex(ctx.theme.outlineVariant), 1.0)
  ret

pub fn auraCollapsiblePanel(ctx: AuraContext, id: str, rect: AuraRect, title: str, expanded: bool): bool:
  let headerH = 34.0
  let headerRect = AuraRect(x = rect.x, y = rect.y, w = rect.w, h = headerH)
  mut nextExpanded = expanded
  if auraIsClicked(ctx, headerRect):
    nextExpanded = not expanded
  if nextExpanded:
    drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface1))
    drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  drawRoundedRect(headerRect.x, headerRect.y, headerRect.w, headerRect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface2))
  let chevron = if nextExpanded: "v" else: ">"
  drawText(chevron, rect.x + 12.0, rect.y + 9.0, 0.9, colorHex(ctx.theme.primary))
  drawText(title, rect.x + 28.0, rect.y + 9.0, 0.9, colorHex(ctx.theme.textPrimary))
  ret nextExpanded

pub fn auraAccordionItem(ctx: AuraContext, id: str, rect: AuraRect, title: str, contentText: str, expanded: bool): bool:
  let nextExp = auraCollapsiblePanel(ctx, id, rect, title, expanded)
  if nextExp and rect.h > 40.0:
    drawTextBox(contentText, rect.x + 14.0, rect.y + 42.0, rect.w - 28.0, 0.85, colorHex(ctx.theme.textSecondary))
  ret nextExp

pub fn auraSplitContainerVertical(container: AuraRect, topRatio: float, gap: float, isTop: bool): AuraRect:
  let clampedRatio = clampFloat(topRatio, 0.05, 0.95)
  let totalH = container.h - gap
  let topH = totalH * clampedRatio
  let botH = totalH - topH
  if isTop:
    ret AuraRect(x = container.x, y = container.y, w = container.w, h = topH)
  ret AuraRect(x = container.x, y = container.y + topH + gap, w = container.w, h = botH)

pub fn auraStatusBar(ctx: AuraContext, rect: AuraRect, leftItems: [str], rightItems: [str]):
  drawRect(rect.x, rect.y, rect.w, rect.h, colorHex(ctx.theme.surface0))
  drawLine(rect.x, rect.y, rect.x + rect.w, rect.y, colorHex(ctx.theme.outlineVariant), 1.0)
  mut lx = rect.x + 10.0
  let ty = rect.y + (rect.h - 12.0) * 0.5
  mut i = 0
  while i < leftItems.len:
    let item = leftItems[i]
    drawText(item, lx, ty, 0.78, colorHex(ctx.theme.textSecondary))
    lx = lx + measureTextWidthPx(item, 0.78) + 14.0
    if i + 1 < leftItems.len:
      drawLine(lx - 7.0, rect.y + 5.0, lx - 7.0, rect.y + rect.h - 5.0, colorHex(ctx.theme.outlineVariant), 1.0)
    i = i + 1
  mut rx = rect.x + rect.w - 10.0
  mut j = rightItems.len - 1
  while j >= 0:
    let rItem = rightItems[j]
    let rw = measureTextWidthPx(rItem, 0.78)
    rx = rx - rw
    drawText(rItem, rx, ty, 0.78, colorHex(ctx.theme.primary))
    rx = rx - 14.0
    j = j - 1
  ret

pub fn auraMenuBar(ctx: AuraContext, id: str, rect: AuraRect, menus: [str], activeIdx: int): int:
  drawRect(rect.x, rect.y, rect.w, rect.h, colorHex(ctx.theme.surface1))
  drawLine(rect.x, rect.y + rect.h, rect.x + rect.w, rect.y + rect.h, colorHex(ctx.theme.outlineVariant), 1.0)
  mut chosen = activeIdx
  mut cx = rect.x + 8.0
  mut i = 0
  while i < menus.len:
    let label = menus[i]
    let itemW = measureTextWidthPx(label, 0.85) + 20.0
    let itemRect = AuraRect(x = cx, y = rect.y + 2.0, w = itemW, h = rect.h - 4.0)
    let hovered = auraIsHovered(ctx, itemRect)
    if auraIsClicked(ctx, itemRect):
      chosen = if activeIdx == i: -1 else: i
    if i == chosen or hovered:
      let bg = if i == chosen: ctx.theme.primaryContainer else: ctx.theme.surface2
      drawRoundedRect(itemRect.x, itemRect.y, itemRect.w, itemRect.h, 4.0, colorHex(bg))
    drawTextCentered(label, itemRect.x + itemRect.w * 0.5, rect.y + (rect.h - 12.0) * 0.5, 0.85, colorHex(ctx.theme.textPrimary))
    cx = cx + itemW + 4.0
    i = i + 1
  ret chosen

pub fn auraToolbarRibbon(ctx: AuraContext, id: str, rect: AuraRect, tools: [str], activeIdx: int): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  if tools.len == 0:
    ret activeIdx
  mut selected = activeIdx
  mut cx = rect.x + 6.0
  let btnH = rect.h - 8.0
  mut i = 0
  while i < tools.len:
    let lbl = tools[i]
    let btnW = measureTextWidthPx(lbl, 0.82) + 22.0
    let btnRect = AuraRect(x = cx, y = rect.y + 4.0, w = btnW, h = btnH)
    if auraIsClicked(ctx, btnRect):
      selected = i
    let isAct = (i == selected)
    let isHov = auraIsHovered(ctx, btnRect)
    if isAct:
      drawRoundedRect(btnRect.x, btnRect.y, btnRect.w, btnRect.h, 4.0, colorHex(ctx.theme.primary))
      drawTextCentered(lbl, btnRect.x + btnRect.w * 0.5, btnRect.y + (btnH - 11.0) * 0.5, 0.82, colorHex(ctx.theme.onPrimary))
    else:
      if isHov:
        drawRoundedRect(btnRect.x, btnRect.y, btnRect.w, btnRect.h, 4.0, colorHex(ctx.theme.surface2))
      drawTextCentered(lbl, btnRect.x + btnRect.w * 0.5, btnRect.y + (btnH - 11.0) * 0.5, 0.82, colorHex(ctx.theme.textPrimary))
    cx = cx + btnW + 6.0
    i = i + 1
  ret selected

pub fn auraBreadcrumbs(ctx: AuraContext, id: str, rect: AuraRect, crumbs: [str]): int:
  mut clickedIdx = -1
  mut cx = rect.x + 4.0
  let ty = rect.y + (rect.h - 12.0) * 0.5
  mut i = 0
  while i < crumbs.len:
    let cText = crumbs[i]
    let cw = measureTextWidthPx(cText, 0.85) + 8.0
    let cRect = AuraRect(x = cx, y = rect.y + 2.0, w = cw, h = rect.h - 4.0)
    if auraIsClicked(ctx, cRect):
      clickedIdx = i
    let isLast = (i == crumbs.len - 1)
    let col = if isLast: ctx.theme.textPrimary else: ctx.theme.primary
    drawText(cText, cx + 4.0, ty, 0.85, colorHex(col))
    cx = cx + cw
    if not isLast:
      drawText("/", cx + 2.0, ty, 0.85, colorHex(ctx.theme.textMuted))
      cx = cx + 14.0
    i = i + 1
  ret clickedIdx

pub fn auraPaginationBar(ctx: AuraContext, id: str, rect: AuraRect, currentPage: int, totalPages: int): int:
  mut safeTotal = totalPages
  if safeTotal < 1:
    safeTotal = 1
  mut nextPage = clamp(currentPage, 1, safeTotal)
  let btnW = 34.0
  let btnH = rect.h - 4.0
  let prevRect = AuraRect(x = rect.x, y = rect.y + 2.0, w = 52.0, h = btnH)
  if auraButton(ctx, id + "_prev", prevRect, "< Prev", "outlined") and nextPage > 1:
    nextPage = nextPage - 1
  mut cx = prevRect.x + prevRect.w + 6.0
  let maxShown = if safeTotal < 5: safeTotal else: 5
  mut p = 1
  while p <= maxShown:
    let pRect = AuraRect(x = cx, y = rect.y + 2.0, w = btnW, h = btnH)
    let variant = if p == nextPage: "filled" else: "tonal"
    if auraButton(ctx, id + "_p_" + str(p), pRect, str(p), variant):
      nextPage = p
    cx = cx + btnW + 4.0
    p = p + 1
  let nextRect = AuraRect(x = cx + 2.0, y = rect.y + 2.0, w = 52.0, h = btnH)
  if auraButton(ctx, id + "_next", nextRect, "Next >", "outlined") and nextPage < safeTotal:
    nextPage = nextPage + 1
  ret nextPage

pub fn auraEmptyStateCard(ctx: AuraContext, rect: AuraRect, iconText: str, title: str, subtitle: str, actionLabel: str = ""): bool:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusMd, 1.0, colorHex(ctx.theme.outlineVariant))
  let cx = rect.x + rect.w * 0.5
  let cy = rect.y + rect.h * 0.36
  drawCircle(cx, cy, 24.0, colorHex(ctx.theme.primaryContainer))
  drawTextCentered(iconText, cx, cy - 6.0, 1.1, colorHex(ctx.theme.primary))
  drawTextCentered(title, cx, cy + 32.0, 1.05, colorHex(ctx.theme.textPrimary))
  drawTextCentered(subtitle, cx, cy + 54.0, 0.82, colorHex(ctx.theme.textSecondary))
  if actionLabel.len > 0:
    let bw = measureTextWidthPx(actionLabel, 0.85) + 32.0
    let bRect = AuraRect(x = cx - bw * 0.5, y = cy + 78.0, w = bw, h = 32.0)
    ret auraButton(ctx, "empty_cta_" + title, bRect, actionLabel, "filled")
  ret false

pub fn auraAlertBanner(ctx: AuraContext, rect: AuraRect, severity: str, title: str, message: str, dismissible: bool = false): bool:
  mut accent = ctx.theme.info
  if severity == "success":
    accent = ctx.theme.success
  elif severity == "warning":
    accent = ctx.theme.warning
  elif severity == "danger" or severity == "error":
    accent = ctx.theme.danger
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(accent))
  drawRoundedRect(rect.x + 2.0, rect.y + 2.0, 5.0, rect.h - 4.0, 2.0, colorHex(accent))
  drawText(title, rect.x + 16.0, rect.y + 8.0, 0.92, colorHex(ctx.theme.textPrimary))
  drawText(message, rect.x + 16.0, rect.y + 26.0, 0.82, colorHex(ctx.theme.textSecondary))
  if dismissible:
    let closeRect = AuraRect(x = rect.x + rect.w - 30.0, y = rect.y + 6.0, w = 22.0, h = 22.0)
    if auraIsHovered(ctx, closeRect):
      drawRoundedRect(closeRect.x, closeRect.y, closeRect.w, closeRect.h, 4.0, colorHex(ctx.theme.surface2))
    drawTextCentered("x", closeRect.x + 11.0, closeRect.y + 4.0, 0.85, colorHex(ctx.theme.textSecondary))
    ret auraIsClicked(ctx, closeRect)
  ret false

// =============================================================================
// 13.10 Virtualized Lists, Property Grids & Specialized App Widgets
// =============================================================================

pub fn auraVirtualizedList(ctx: AuraContext, id: str, rect: AuraRect, items: [str], rowHeight: float, scrollOffset: float, selectedIdx: int): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let safeRowH = if rowHeight > 12.0: rowHeight else: 28.0
  let totalItems = items.len
  if totalItems == 0:
    ret selectedIdx
  let firstIdx = clamp(int(scrollOffset / safeRowH), 0, totalItems - 1)
  let maxVisible = int(rect.h / safeRowH) + 1
  mut chosen = selectedIdx
  mut v = 0
  while v < maxVisible and (firstIdx + v) < totalItems:
    let idx = firstIdx + v
    let ry = rect.y + float(v) * safeRowH
    if ry + safeRowH <= rect.y + rect.h + 2.0:
      let rowRect = AuraRect(x = rect.x + 2.0, y = ry, w = rect.w - 12.0, h = safeRowH)
      if auraIsClicked(ctx, rowRect):
        chosen = idx
      let isSel = (idx == chosen)
      let isHov = auraIsHovered(ctx, rowRect)
      if isSel:
        drawRoundedRect(rowRect.x, rowRect.y + 1.0, rowRect.w, rowRect.h - 2.0, 4.0, colorHex(ctx.theme.primaryContainer))
      elif isHov:
        drawRoundedRect(rowRect.x, rowRect.y + 1.0, rowRect.w, rowRect.h - 2.0, 4.0, colorHex(ctx.theme.surface2))
      drawText(items[idx], rowRect.x + 10.0, ry + (safeRowH - 11.0) * 0.5, 0.85, colorHex(ctx.theme.textPrimary))
    v = v + 1
  // Scrollbar track & thumb
  let totalH = float(totalItems) * safeRowH
  if totalH > rect.h:
    let sbX = rect.x + rect.w - 7.0
    drawRoundedRect(sbX, rect.y + 4.0, 4.0, rect.h - 8.0, 2.0, colorHex(ctx.theme.surface2))
    let thumbRatio = clampFloat(rect.h / totalH, 0.1, 1.0)
    let thumbH = (rect.h - 8.0) * thumbRatio
    let scrollRatio = clampFloat(scrollOffset / (totalH - rect.h), 0.0, 1.0)
    let thumbY = rect.y + 4.0 + (rect.h - 8.0 - thumbH) * scrollRatio
    drawRoundedRect(sbX, thumbY, 4.0, thumbH, 2.0, colorHex(ctx.theme.primary))
  ret chosen

pub fn auraRichListItem(ctx: AuraContext, id: str, rect: AuraRect, title: str, subtitle: str, badgeText: str, selected: bool): bool:
  let hovered = auraIsHovered(ctx, rect)
  let clicked = auraIsClicked(ctx, rect)
  let bg = if selected: ctx.theme.primaryContainer else: (if hovered: ctx.theme.surface2 else: ctx.theme.surface1)
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(bg))
  if selected:
    drawRoundedRect(rect.x + 2.0, rect.y + 4.0, 3.5, rect.h - 8.0, 1.5, colorHex(ctx.theme.primary))
  drawText(title, rect.x + 12.0, rect.y + 7.0, 0.9, colorHex(ctx.theme.textPrimary))
  drawText(subtitle, rect.x + 12.0, rect.y + 25.0, 0.78, colorHex(ctx.theme.textSecondary))
  if badgeText.len > 0:
    let bw = measureTextWidthPx(badgeText, 0.75) + 14.0
    let bx = rect.x + rect.w - bw - 10.0
    let by = rect.y + 8.0
    drawRoundedRect(bx, by, bw, 18.0, 9.0, colorHex(ctx.theme.surface3))
    drawTextCentered(badgeText, bx + bw * 0.5, by + 3.0, 0.75, colorHex(ctx.theme.textPrimary))
  ret clicked

pub fn auraPropertyGridRow(ctx: AuraContext, id: str, rect: AuraRect, propName: str, propValue: str, editable: bool = true): bool:
  drawRect(rect.x, rect.y, rect.w, rect.h, colorHex(ctx.theme.surface0))
  drawLine(rect.x, rect.y + rect.h, rect.x + rect.w, rect.y + rect.h, colorHex(ctx.theme.outlineVariant), 0.5)
  let splitX = rect.x + rect.w * 0.44
  drawLine(splitX, rect.y, splitX, rect.y + rect.h, colorHex(ctx.theme.outlineVariant), 0.5)
  let ty = rect.y + (rect.h - 11.0) * 0.5
  drawText(propName, rect.x + 8.0, ty, 0.82, colorHex(ctx.theme.textSecondary))
  let valRect = AuraRect(x = splitX + 4.0, y = rect.y + 2.0, w = rect.w * 0.56 - 8.0, h = rect.h - 4.0)
  if editable:
    let hov = auraIsHovered(ctx, valRect)
    let cellBg = if hov: ctx.theme.surface2 else: ctx.theme.surface1
    drawRoundedRect(valRect.x, valRect.y, valRect.w, valRect.h, 3.0, colorHex(cellBg))
  drawText(propValue, valRect.x + 6.0, ty, 0.82, colorHex(ctx.theme.textPrimary))
  ret editable and auraIsClicked(ctx, valRect)

pub fn auraColorSwatchGrid(ctx: AuraContext, id: str, rect: AuraRect, colors: [int], cols: int, selectedColor: int): int:
  mut safeCols = if cols > 0: cols else: 8
  mut chosen = selectedColor
  if colors.len == 0:
    ret chosen
  let rows = (colors.len + safeCols - 1) / safeCols
  let gap = 4.0
  mut idx = 0
  while idx < colors.len:
    let col = idx % safeCols
    let row = idx / safeCols
    let cell = auraGridCell(rect, safeCols, rows, col, row, gap)
    let cHex = colors[idx]
    if auraIsClicked(ctx, cell):
      chosen = cHex
    drawRoundedRect(cell.x, cell.y, cell.w, cell.h, 4.0, colorHex(cHex))
    if cHex == chosen:
      drawRoundedRectOutline(cell.x - 1.0, cell.y - 1.0, cell.w + 2.0, cell.h + 2.0, 5.0, 2.0, colorHex(ctx.theme.textPrimary))
    else:
      drawRoundedRectOutline(cell.x, cell.y, cell.w, cell.h, 4.0, 1.0, colorHex(ctx.theme.outlineVariant))
    idx = idx + 1
  ret chosen

pub fn auraLayerListRow(ctx: AuraContext, id: str, rect: AuraRect, layerName: str, visible: bool, locked: bool, opacityPct: int, active: bool): int:
  let bg = if active: ctx.theme.primaryContainer else: ctx.theme.surface1
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(bg))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.0, colorHex(if active: ctx.theme.primary else: ctx.theme.outlineVariant))
  let eyeRect = AuraRect(x = rect.x + 6.0, y = rect.y + 4.0, w = 22.0, h = rect.h - 8.0)
  let lockRect = AuraRect(x = rect.x + 32.0, y = rect.y + 4.0, w = 22.0, h = rect.h - 8.0)
  drawRoundedRect(eyeRect.x, eyeRect.y, eyeRect.w, eyeRect.h, 3.0, colorHex(ctx.theme.surface2))
  drawTextCentered(if visible: "V" else: "-", eyeRect.x + 11.0, eyeRect.y + 4.0, 0.78, colorHex(if visible: ctx.theme.success else: ctx.theme.textMuted))
  drawRoundedRect(lockRect.x, lockRect.y, lockRect.w, lockRect.h, 3.0, colorHex(ctx.theme.surface2))
  drawTextCentered(if locked: "L" else: "U", lockRect.x + 11.0, lockRect.y + 4.0, 0.78, colorHex(if locked: ctx.theme.warning else: ctx.theme.textMuted))
  let ty = rect.y + (rect.h - 11.0) * 0.5
  let opStr = str(clamp(opacityPct, 0, 100)) + "%"
  let opW = measureTextWidthPx(opStr, 0.78)
  let maxNameW = maxFloat(24.0, rect.w - 62.0 - opW - 16.0)
  let fitName = truncateText(layerName, maxNameW, 0.85)
  drawText(fitName, rect.x + 62.0, ty, 0.85, colorHex(ctx.theme.textPrimary))
  drawTextRight(opStr, rect.x + rect.w - 8.0, ty, 0.78, colorHex(ctx.theme.textSecondary))
  if auraIsClicked(ctx, eyeRect):
    ret 2
  if auraIsClicked(ctx, lockRect):
    ret 3
  if auraIsClicked(ctx, rect):
    ret 1
  ret 0

pub fn auraMarkdownBlock(ctx: AuraContext, rect: AuraRect, lines: [str]):
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  mut cy = rect.y + 12.0
  let leftX = rect.x + 14.0
  mut i = 0
  while i < lines.len and cy + 16.0 <= rect.y + rect.h:
    let line = lines[i]
    if line.startsWith("# "):
      let h1 = line.slice(2, line.len)
      drawText(h1, leftX, cy, 1.25, colorHex(ctx.theme.primary))
      cy = cy + 26.0
    elif line.startsWith("## "):
      let h2 = line.slice(3, line.len)
      drawText(h2, leftX, cy, 1.05, colorHex(ctx.theme.textPrimary))
      cy = cy + 22.0
    elif line.startsWith("- ") or line.startsWith("* "):
      let item = line.slice(2, line.len)
      drawCircle(leftX + 5.0, cy + 6.0, 3.0, colorHex(ctx.theme.secondary))
      drawText(item, leftX + 14.0, cy, 0.88, colorHex(ctx.theme.textPrimary))
      cy = cy + 19.0
    elif line.startsWith("> "):
      let quote = line.slice(2, line.len)
      drawRoundedRect(leftX, cy, 3.0, 16.0, 1.5, colorHex(ctx.theme.tertiary))
      drawText(quote, leftX + 10.0, cy + 1.0, 0.86, colorHex(ctx.theme.textSecondary))
      cy = cy + 20.0
    else:
      drawText(line, leftX, cy, 0.88, colorHex(ctx.theme.textSecondary))
      cy = cy + 18.0
    i = i + 1
  ret

pub fn auraCodeBlockView(ctx: AuraContext, rect: AuraRect, title: str, codeLines: [str], highlightLine: int = -1):
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.bgCanvas))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let headerH = 26.0
  drawRoundedRect(rect.x, rect.y, rect.w, headerH, ctx.theme.radiusSm, colorHex(ctx.theme.surface2))
  drawCircle(rect.x + 12.0, rect.y + 13.0, 4.5, colorHex(ctx.theme.danger))
  drawCircle(rect.x + 24.0, rect.y + 13.0, 4.5, colorHex(ctx.theme.warning))
  drawCircle(rect.x + 36.0, rect.y + 13.0, 4.5, colorHex(ctx.theme.success))
  drawText(title, rect.x + 52.0, rect.y + 6.0, 0.8, colorHex(ctx.theme.textSecondary))
  let gutterW = 36.0
  drawRect(rect.x + 1.0, rect.y + headerH, gutterW, rect.h - headerH - 2.0, colorHex(ctx.theme.surface0))
  let lineH = 18.0
  mut i = 0
  while i < codeLines.len:
    let ly = rect.y + headerH + 4.0 + float(i) * lineH
    if ly + lineH <= rect.y + rect.h:
      if (i + 1) == highlightLine:
        drawRect(rect.x + gutterW + 1.0, ly - 1.0, rect.w - gutterW - 2.0, lineH, colorHex(ctx.theme.primaryContainer))
      drawTextRight(str(i + 1), rect.x + gutterW - 6.0, ly + 2.0, 0.75, colorHex(ctx.theme.textMuted))
      drawText(codeLines[i], rect.x + gutterW + 8.0, ly + 2.0, 0.82, colorHex(ctx.theme.textPrimary))
    i = i + 1
  ret

pub fn auraFindReplaceBar(ctx: AuraContext, id: str, rect: AuraRect, findQuery: str, replaceQuery: str, matchCount: int): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface2))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outline))
  let boxW = (rect.w - 210.0) * 0.5
  let maxBoxTextW = maxFloat(24.0, boxW - 14.0)
  let findRect = AuraRect(x = rect.x + 8.0, y = rect.y + 4.0, w = boxW, h = rect.h - 8.0)
  let replRect = AuraRect(x = findRect.x + boxW + 6.0, y = rect.y + 4.0, w = boxW, h = rect.h - 8.0)
  drawRoundedRect(findRect.x, findRect.y, findRect.w, findRect.h, 4.0, colorHex(ctx.theme.surface0))
  drawText(truncateText("Find: " + findQuery, maxBoxTextW, 0.8), findRect.x + 8.0, findRect.y + 6.0, 0.8, colorHex(ctx.theme.textPrimary))
  drawRoundedRect(replRect.x, replRect.y, replRect.w, replRect.h, 4.0, colorHex(ctx.theme.surface0))
  drawText(truncateText("Repl: " + replaceQuery, maxBoxTextW, 0.8), replRect.x + 8.0, replRect.y + 6.0, 0.8, colorHex(ctx.theme.textSecondary))
  let countStr = str(matchCount) + " hits"
  drawText(countStr, replRect.x + boxW + 8.0, rect.y + 10.0, 0.78, colorHex(ctx.theme.primary))
  let b1 = AuraRect(x = rect.x + rect.w - 132.0, y = rect.y + 4.0, w = 40.0, h = rect.h - 8.0)
  let b2 = AuraRect(x = rect.x + rect.w - 88.0, y = rect.y + 4.0, w = 40.0, h = rect.h - 8.0)
  let b3 = AuraRect(x = rect.x + rect.w - 44.0, y = rect.y + 4.0, w = 38.0, h = rect.h - 8.0)
  if auraButton(ctx, id + "_next", b1, "Next", "tonal"):
    ret 1
  if auraButton(ctx, id + "_repl", b2, "Repl", "tonal"):
    ret 2
  if auraButton(ctx, id + "_all", b3, "All", "filled"):
    ret 3
  ret 0

pub fn auraShortcutPill(ctx: AuraContext, x: float, y: float, keys: str): float:
  let kw = measureTextWidthPx(keys, 0.75) + 12.0
  let kh = 18.0
  drawRoundedRect(x, y + 1.5, kw, kh, 4.0, rgba(0, 0, 0, 0.35))
  drawRoundedRect(x, y, kw, kh, 4.0, colorHex(ctx.theme.surface2))
  drawRoundedRectOutline(x, y, kw, kh, 4.0, 1.0, colorHex(ctx.theme.outlineVariant))
  drawTextCentered(keys, x + kw * 0.5, y + 3.5, 0.75, colorHex(ctx.theme.textSecondary))
  ret kw

// =============================================================================
// 13.11 Genre-Authentic Game HUD Helpers (FPS / RTS / ARPG / Survival / Sandbox)
// =============================================================================

pub fn auraCrosshairDynamic(ctx: AuraContext, cx: float, cy: float, gap: float, length: float, color: int, hitMarker: bool = false):
  let col = colorHex(color)
  let shadow = rgba(0, 0, 0, 0.65)
  // Shadow strokes for high visibility on bright backgrounds
  drawLine(cx - gap - length, cy + 1.0, cx - gap, cy + 1.0, shadow, 3.0)
  drawLine(cx + gap, cy + 1.0, cx + gap + length, cy + 1.0, shadow, 3.0)
  drawLine(cx + 1.0, cy - gap - length, cx + 1.0, cy - gap, shadow, 3.0)
  drawLine(cx + 1.0, cy + gap, cx + 1.0, cy + gap + length, shadow, 3.0)
  // Primary 4-prong reticle
  drawLine(cx - gap - length, cy, cx - gap, cy, col, 2.0)
  drawLine(cx + gap, cy, cx + gap + length, cy, col, 2.0)
  drawLine(cx, cy - gap - length, cx, cy - gap, col, 2.0)
  drawLine(cx, cy + gap, cx, cy + gap + length, col, 2.0)
  drawCircle(cx, cy, 1.5, col)
  if hitMarker:
    let hCol = colorHex(ctx.theme.danger)
    let d1 = gap * 0.65
    let dist2 = d1 + length * 0.75
    drawLine(cx - dist2, cy - dist2, cx - d1, cy - d1, hCol, 2.0)
    drawLine(cx + d1, cy - d1, cx + dist2, cy - dist2, hCol, 2.0)
    drawLine(cx - dist2, cy + dist2, cx - d1, cy + d1, hCol, 2.0)
    drawLine(cx + d1, cy + d1, cx + dist2, cy + dist2, hCol, 2.0)
  ret

pub fn auraKillFeedEntry(ctx: AuraContext, x: float, y: float, killer: str, weapon: str, victim: str, isHeadshot: bool = false):
  let hsTag = if isHeadshot: " [HS] " else: " "
  let fullStr = killer + " [" + weapon + "]" + hsTag + victim
  let w = measureTextWidthPx(fullStr, 0.8) + 20.0
  let h = 22.0
  drawRoundedRect(x, y, w, h, 4.0, rgba(10, 14, 24, 0.78))
  drawRoundedRectOutline(x, y, w, h, 4.0, 1.0, colorHex(if isHeadshot: ctx.theme.danger else: ctx.theme.outlineVariant))
  mut cx = x + 10.0
  let ty = y + 5.0
  drawText(killer, cx, ty, 0.8, colorHex(ctx.theme.secondary))
  cx = cx + measureTextWidthPx(killer + " ", 0.8)
  let wepStr = "[" + weapon + "]" + hsTag
  drawText(wepStr, cx, ty, 0.8, colorHex(if isHeadshot: ctx.theme.warning else: ctx.theme.textMuted))
  cx = cx + measureTextWidthPx(wepStr, 0.8)
  drawText(victim, cx, ty, 0.8, colorHex(ctx.theme.danger))
  ret

pub fn auraRadarMinimap(ctx: AuraContext, cx: float, cy: float, radius: float, playerYawRad: float, blipOffsets: [Vec2], blipColors: [int]):
  drawCircle(cx, cy, radius, rgba(8, 16, 12, 0.85))
  drawCircleOutline(cx, cy, radius, 2.0, colorHex(ctx.theme.primary))
  drawCircleOutline(cx, cy, radius * 0.66, 1.0, rgba(255, 255, 255, 0.12))
  drawCircleOutline(cx, cy, radius * 0.33, 1.0, rgba(255, 255, 255, 0.12))
  drawLine(cx - radius, cy, cx + radius, cy, rgba(255, 255, 255, 0.10), 1.0)
  drawLine(cx, cy - radius, cx, cy + radius, rgba(255, 255, 255, 0.10), 1.0)
  // FOV Cone lines
  let fovHalf = 0.65
  let lx = cx + cos(playerYawRad - fovHalf) * radius * 0.92
  let ly = cy + sin(playerYawRad - fovHalf) * radius * 0.92
  let rx = cx + cos(playerYawRad + fovHalf) * radius * 0.92
  let ry = cy + sin(playerYawRad + fovHalf) * radius * 0.92
  drawLine(cx, cy, lx, ly, colorHex(ctx.theme.primary), 1.2)
  drawLine(cx, cy, rx, ry, colorHex(ctx.theme.primary), 1.2)
  // Blips
  mut i = 0
  while i < blipOffsets.len:
    let off = blipOffsets[i]
    let dist = sqrt(off.x * off.x + off.y * off.y)
    let scale = if dist > 1.0: 1.0 / dist else: 1.0
    let bx = cx + off.x * scale * (radius - 6.0)
    let by = cy + off.y * scale * (radius - 6.0)
    let bCol = if i < blipColors.len: blipColors[i] else: ctx.theme.danger
    drawCircle(bx, by, 3.2, colorHex(bCol))
    i = i + 1
  drawCircle(cx, cy, 3.8, colorHex(0xFFFFFF))
  drawTextCentered("N", cx, cy - radius + 4.0, 0.72, colorHex(ctx.theme.primary))
  ret

pub fn auraResourceBarRTS(ctx: AuraContext, rect: AuraRect, names: [str], amounts: [int], rates: [str], colors: [int]):
  drawRect(rect.x, rect.y, rect.w, rect.h, colorHex(ctx.theme.surface0))
  drawLine(rect.x, rect.y + rect.h, rect.x + rect.w, rect.y + rect.h, colorHex(ctx.theme.outline), 1.5)
  let count = names.len
  if count == 0:
    ret
  let cellW = clampFloat((rect.w - 24.0) / float(count), 90.0, 210.0)
  mut i = 0
  while i < count:
    let cx = rect.x + 12.0 + float(i) * cellW
    let cy = rect.y + rect.h * 0.5
    let dotCol = if i < colors.len: colors[i] else: ctx.theme.primary
    drawCircle(cx + 8.0, cy, 5.5, colorHex(dotCol))
    let amt = if i < amounts.len: amounts[i] else: 0
    let label = names[i] + ": " + str(amt)
    drawText(label, cx + 18.0, cy - 6.0, 0.85, colorHex(ctx.theme.textPrimary))
    if i < rates.len and rates[i].len > 0:
      let lw = measureTextWidthPx(label, 0.85)
      drawText(rates[i], cx + 22.0 + lw, cy - 5.0, 0.75, colorHex(ctx.theme.success))
    i = i + 1
  ret

pub fn auraCommandCardGrid(ctx: AuraContext, id: str, rect: AuraRect, cols: int, rows: int, labels: [str], hotkeys: [str], costs: [str], disabledMask: [bool]): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.5, colorHex(ctx.theme.outline))
  let safeCols = if cols > 0: cols else: 3
  let safeRows = if rows > 0: rows else: 3
  let padRect = AuraRect(x = rect.x + 6.0, y = rect.y + 6.0, w = rect.w - 12.0, h = rect.h - 12.0)
  mut clickedCmd = -1
  let totalSlots = safeCols * safeRows
  mut idx = 0
  while idx < totalSlots and idx < labels.len:
    let c = idx % safeCols
    let r = idx / safeCols
    let cell = auraGridCell(padRect, safeCols, safeRows, c, r, 5.0)
    let lbl = labels[idx]
    if lbl.len > 0:
      let isDis = if idx < disabledMask.len: disabledMask[idx] else: false
      let isHov = auraIsHovered(ctx, cell)
      if not isDis and auraIsClicked(ctx, cell):
        clickedCmd = idx
      let bg = if isDis: ctx.theme.surface0 else: (if isHov: ctx.theme.surface2 else: ctx.theme.surface1)
      drawRoundedRect(cell.x, cell.y, cell.w, cell.h, 4.0, colorHex(bg))
      drawRoundedRectOutline(cell.x, cell.y, cell.w, cell.h, 4.0, 1.0, colorHex(if isHov and not isDis: ctx.theme.primary else: ctx.theme.outlineVariant))
      drawTextCentered(lbl, cell.x + cell.w * 0.5, cell.y + cell.h * 0.42, 0.78, colorHex(if isDis: ctx.theme.textMuted else: ctx.theme.textPrimary))
      if idx < hotkeys.len and hotkeys[idx].len > 0:
        drawText(hotkeys[idx], cell.x + 4.0, cell.y + 3.0, 0.68, colorHex(ctx.theme.warning))
      if idx < costs.len and costs[idx].len > 0:
        drawTextRight(costs[idx], cell.x + cell.w - 4.0, cell.y + cell.h - 13.0, 0.68, colorHex(ctx.theme.secondary))
    idx = idx + 1
  ret clickedCmd

/// Renders ARPG style Life & Mana orbs anchored at `bottomY` (`cy = bottomY - radius`; pass `orbCy + orbRad` or use `auraOrbsHealthManaCentered`).
pub fn auraOrbsHealthMana(ctx: AuraContext, leftX: float, rightX: float, bottomY: float, radius: float, hpRatio: float, manaRatio: float):
  let hpClamped = clampFloat(hpRatio, 0.0, 1.0)
  let mpClamped = clampFloat(manaRatio, 0.0, 1.0)
  let cy = bottomY - radius
  // Left Health Orb
  drawCircle(leftX, cy, radius + 3.0, colorHex(0x1E1B18))
  drawCircle(leftX, cy, radius, colorHex(0x2A080C))
  if hpClamped > 0.01:
    let hpFillR = radius * (0.25 + 0.75 * hpClamped)
    let hpOffsetY = (1.0 - hpClamped) * radius * 0.45
    drawCircle(leftX, cy + hpOffsetY, hpFillR, colorHex(0xDC2626))
    drawCircle(leftX - radius * 0.28, cy - radius * 0.28, radius * 0.18, rgba(255, 255, 255, 0.28))
  drawCircleOutline(leftX, cy, radius + 2.0, 2.5, colorHex(0xCA8A04))
  drawTextCentered(str(int(hpClamped * 100.0)) + "%", leftX, cy - 6.0, 0.85, colorHex(0xFFFFFF))
  drawTextCentered("LIFE", leftX, cy + radius + 6.0, 0.72, colorHex(ctx.theme.danger))
  // Right Mana Orb
  drawCircle(rightX, cy, radius + 3.0, colorHex(0x1E1B18))
  drawCircle(rightX, cy, radius, colorHex(0x08142C))
  if mpClamped > 0.01:
    let mpFillR = radius * (0.25 + 0.75 * mpClamped)
    let mpOffsetY = (1.0 - mpClamped) * radius * 0.45
    drawCircle(rightX, cy + mpOffsetY, mpFillR, colorHex(0x2563EB))
    drawCircle(rightX - radius * 0.28, cy - radius * 0.28, radius * 0.18, rgba(255, 255, 255, 0.28))
  drawCircleOutline(rightX, cy, radius + 2.0, 2.5, colorHex(0xCA8A04))
  drawTextCentered(str(int(mpClamped * 100.0)) + "%", rightX, cy - 6.0, 0.85, colorHex(0xFFFFFF))
  drawTextCentered("MANA", rightX, cy + radius + 6.0, 0.72, colorHex(ctx.theme.info))
  ret

pub fn auraECGStatusMonitor(ctx: AuraContext, rect: AuraRect, phase: float, healthPct: float, statusLabel: str):
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 6.0, colorHex(0x050B07))
  mut waveCol = 0x22C55E
  if statusLabel == "POISON" or statusLabel == "POISONED":
    waveCol = 0xC355FF
  elif healthPct <= 25.0:
    waveCol = 0xEF4444
  elif healthPct <= 60.0:
    waveCol = 0xF59E0B
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 6.0, 1.5, colorHex(waveCol))
  // Grid lines
  let midY = rect.y + rect.h * 0.52
  drawLine(rect.x + 4.0, midY, rect.x + rect.w - 4.0, midY, rgba(34, 197, 94, 0.18), 1.0)
  let segments = 28
  let stepX = (rect.w - 16.0) / float(segments)
  let amp = rect.h * 0.34
  mut s = 0
  while s < segments:
    let t1 = (float(s) / float(segments) + phase) % 1.0
    let t2 = (float(s + 1) / float(segments) + phase) % 1.0
    mut yOff1 = 0.0
    if t1 > 0.40 and t1 < 0.45:
      yOff1 = -amp * 0.35
    elif t1 >= 0.45 and t1 < 0.50:
      yOff1 = amp * 0.95
    elif t1 >= 0.50 and t1 < 0.55:
      yOff1 = -amp * 0.65
    elif t1 >= 0.62 and t1 < 0.72:
      yOff1 = amp * 0.28
    mut yOff2 = 0.0
    if t2 > 0.40 and t2 < 0.45:
      yOff2 = -amp * 0.35
    elif t2 >= 0.45 and t2 < 0.50:
      yOff2 = amp * 0.95
    elif t2 >= 0.50 and t2 < 0.55:
      yOff2 = -amp * 0.65
    elif t2 >= 0.62 and t2 < 0.72:
      yOff2 = amp * 0.28
    let x1 = rect.x + 8.0 + float(s) * stepX
    let x2 = rect.x + 8.0 + float(s + 1) * stepX
    drawLine(x1, midY - yOff1, x2, midY - yOff2, colorHex(waveCol), 2.0)
    s = s + 1
  drawText("CONDITION: " + statusLabel, rect.x + 8.0, rect.y + rect.h - 16.0, 0.75, colorHex(waveCol))
  ret

pub fn auraElementToolbarStrip(ctx: AuraContext, id: str, rect: AuraRect, elements: [str], colors: [int], activeIdx: int): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let count = elements.len
  if count == 0:
    ret activeIdx
  mut chosen = activeIdx
  let pad = 6.0
  let gap = 5.0
  let totalGap = float(count - 1) * gap
  let itemW = (rect.w - pad * 2.0 - totalGap) / float(count)
  let itemH = rect.h - pad * 2.0
  mut i = 0
  while i < count:
    let ix = rect.x + pad + float(i) * (itemW + gap)
    let iy = rect.y + pad
    let itemRect = AuraRect(x = ix, y = iy, w = itemW, h = itemH)
    if auraIsClicked(ctx, itemRect):
      chosen = i
    let elCol = if i < colors.len: colors[i] else: ctx.theme.primary
    let isSel = (i == chosen)
    drawRoundedRect(ix, iy, itemW, itemH, 4.0, colorHex(if isSel: ctx.theme.surface2 else: ctx.theme.surface1))
    drawRoundedRect(ix + 4.0, iy + 4.0, itemW - 8.0, 6.0, 2.0, colorHex(elCol))
    if isSel:
      drawRoundedRectOutline(ix, iy, itemW, itemH, 4.0, 2.0, colorHex(elCol))
    drawTextCentered(elements[i], ix + itemW * 0.5, iy + itemH * 0.48, 0.76, colorHex(ctx.theme.textPrimary))
    i = i + 1
  ret chosen

// =============================================================================
// 13.12 Wave 1 CRM & Productivity Feedback Upgrades (Interactive Kanban/Tables)
pub fn auraThemeByIndex(idx: int): AuraTheme:
  let mode = idx % 7
  if mode == 1:
    ret auraThemeLight()
  if mode == 2:
    ret auraThemeArcadeNeon()
  if mode == 3:
    ret auraThemeCyberpunk()
  if mode == 4:
    ret auraThemeHighContrast()
  if mode == 5:
    ret auraThemeNord()
  if mode == 6:
    ret auraThemeSolarized()
  ret auraThemeDark()

pub fn auraAvatar(ctx: AuraContext, cx: float, cy: float, radius: float, initials: str, bgColor: int):
  drawCircle(cx, cy, radius, colorHex(bgColor))
  drawCircleOutline(cx, cy, radius, 1.5, colorHex(ctx.theme.outlineVariant))
  let sz = clampFloat(radius * 0.055, 0.72, 1.15)
  drawTextCentered(initials, cx, cy - sz * 5.5, sz, colorHex(0xFFFFFF))
  ret

pub fn auraModalDialogRect(w: float, h: float): AuraRect:
  let sw = float(getScreenWidth())
  let sh = float(getScreenHeight())
  ret AuraRect(x = (sw - w) * 0.5, y = (sh - h) * 0.5, w = w, h = h)

pub fn auraKanbanBoardInteractive(ctx: AuraContext, id: str, rect: AuraRect, columns: [str], colSubtitles: [str], cardsPerCol: [[str]], selectedCol: int, selectedCard: int): AuraKanbanAction:
  mut act = AuraKanbanAction(clickedCol = selectedCol, clickedCard = selectedCard, headerClickedCol = -1)
  if columns.len == 0:
    ret act
  let gap = 12.0
  let colW = (rect.w - float(columns.len - 1) * gap) / float(columns.len)
  mut c = 0
  while c < columns.len:
    let cx = rect.x + float(c) * (colW + gap)
    drawRoundedRect(cx, rect.y, colW, rect.h, ctx.theme.radiusMd, colorHex(ctx.theme.surface1))
    drawRoundedRectOutline(cx, rect.y, colW, rect.h, ctx.theme.radiusMd, 1.0, colorHex(ctx.theme.outlineVariant))
    let hdrRect = AuraRect(x = cx, y = rect.y, w = colW, h = 36.0)
    if auraIsClicked(ctx, hdrRect):
      act = AuraKanbanAction(clickedCol = act.clickedCol, clickedCard = act.clickedCard, headerClickedCol = c)
    drawText(columns[c], cx + 12.0, rect.y + 10.0, 0.9, colorHex(ctx.theme.textPrimary))
    if c < colSubtitles.len and colSubtitles[c].len > 0:
      drawTextRight(colSubtitles[c], cx + colW - 10.0, rect.y + 11.0, 0.75, colorHex(ctx.theme.primary))
    if c < cardsPerCol.len:
      let cards = cardsPerCol[c]
      mut k = 0
      while k < cards.len:
        let cardY = rect.y + 42.0 + float(k) * 54.0
        if cardY + 46.0 <= rect.y + rect.h:
          let cRect = AuraRect(x = cx + 8.0, y = cardY, w = colW - 16.0, h = 46.0)
          if auraIsClicked(ctx, cRect):
            act = AuraKanbanAction(clickedCol = c, clickedCard = k, headerClickedCol = act.headerClickedCol)
          let isSel = (c == act.clickedCol and k == act.clickedCard)
          let isHov = auraIsHovered(ctx, cRect)
          let cBg = if isSel: ctx.theme.primaryContainer else: (if isHov: ctx.theme.surface3 else: ctx.theme.surface2)
          drawRoundedRect(cRect.x, cRect.y, cRect.w, cRect.h, ctx.theme.radiusSm, colorHex(cBg))
          drawRoundedRect(cRect.x, cRect.y, 4.0, cRect.h, 2.0, colorHex(if isSel: ctx.theme.secondary else: ctx.theme.primary))
          let fitCard = truncateText(cards[k], cRect.w - 24.0, 0.84)
          drawText(fitCard, cRect.x + 12.0, cRect.y + 16.0, 0.84, colorHex(ctx.theme.textPrimary))
        k = k + 1
    c = c + 1
  ret act

pub fn auraSortableDataTable(ctx: AuraContext, id: str, rect: AuraRect, headers: [str], rows: [[str]], selectedRow: int, sortCol: int, sortAsc: bool): AuraTableResult:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let headerH = 32.0
  drawRoundedRect(rect.x, rect.y, rect.w, headerH, ctx.theme.radiusSm, colorHex(ctx.theme.surface2))
  mut colCount = headers.len
  if colCount < 1:
    colCount = 1
  let colW = rect.w / float(colCount)
  let maxCellW = if colW > 20.0: colW - 18.0 else: 12.0
  mut clickedHdr = -1
  mut c = 0
  while c < headers.len:
    let hRect = AuraRect(x = rect.x + float(c) * colW, y = rect.y, w = colW, h = headerH)
    if auraIsClicked(ctx, hRect):
      clickedHdr = c
    let arrow = if c == sortCol: (if sortAsc: " ^" else: " v") else: ""
    let hText = truncateText(headers[c] + arrow, maxCellW, 0.85)
    let hCol = if c == sortCol: ctx.theme.primary else: ctx.theme.textPrimary
    drawText(hText, hRect.x + 10.0, rect.y + 10.0, 0.85, colorHex(hCol))
    c = c + 1
  mut chosen = selectedRow
  let rowH = 28.0
  mut r = 0
  while r < rows.len:
    let ry = rect.y + headerH + float(r) * rowH
    if ry + rowH <= rect.y + rect.h:
      let rowRect = AuraRect(x = rect.x, y = ry, w = rect.w, h = rowH)
      let rowHov = auraIsHovered(ctx, rowRect)
      if auraIsClicked(ctx, rowRect):
        chosen = r
      if r == chosen:
        drawRect(rect.x + 1.0, ry, rect.w - 2.0, rowH, colorHex(ctx.theme.primaryContainer))
      elif rowHov:
        drawRect(rect.x + 1.0, ry, rect.w - 2.0, rowH, colorHex(ctx.theme.surface2))
      elif r % 2 == 1:
        drawRect(rect.x + 1.0, ry, rect.w - 2.0, rowH, colorHex(ctx.theme.surface1))
      let cells = rows[r]
      mut j = 0
      while j < cells.len and j < colCount:
        let cText = truncateText(cells[j], maxCellW, 0.84)
        drawText(cText, rect.x + float(j) * colW + 10.0, ry + 8.0, 0.84, colorHex(ctx.theme.textSecondary))
        j = j + 1
    r = r + 1
  ret AuraTableResult(selectedRow = chosen, clickedHeaderCol = clickedHdr)

pub fn auraTimelineFeed(ctx: AuraContext, id: str, rect: AuraRect, badges: [str], titles: [str], timestamps: [str]): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let rowH = 38.0
  let lineX = rect.x + 22.0
  drawLine(lineX, rect.y + 12.0, lineX, rect.y + rect.h - 12.0, colorHex(ctx.theme.outlineVariant), 1.5)
  mut clickedIdx = -1
  mut i = 0
  while i < titles.len:
    let ry = rect.y + 8.0 + float(i) * rowH
    if ry + rowH <= rect.y + rect.h:
      let itemRect = AuraRect(x = rect.x + 6.0, y = ry, w = rect.w - 12.0, h = rowH - 4.0)
      if auraIsClicked(ctx, itemRect):
        clickedIdx = i
      if auraIsHovered(ctx, itemRect):
        drawRoundedRect(itemRect.x, itemRect.y, itemRect.w, itemRect.h, 4.0, colorHex(ctx.theme.surface1))
      drawCircle(lineX, ry + 15.0, 5.0, colorHex(ctx.theme.primary))
      if i < badges.len and badges[i].len > 0:
        drawText("[" + badges[i] + "]", lineX + 12.0, ry + 5.0, 0.75, colorHex(ctx.theme.secondary))
      drawText(titles[i], lineX + 12.0, ry + 19.0, 0.84, colorHex(ctx.theme.textPrimary))
      if i < timestamps.len:
        drawTextRight(timestamps[i], rect.x + rect.w - 12.0, ry + 6.0, 0.72, colorHex(ctx.theme.textMuted))
    i = i + 1
  ret clickedIdx

pub struct AuraDocTabResult(activeIdx: int, closedIdx: int, addClicked: bool)

pub fn auraDocumentTabs(ctx: AuraContext, id: str, rect: AuraRect, titles: [str], dirtyFlags: [bool], activeIdx: int): AuraDocTabResult:
  drawRect(rect.x, rect.y, rect.w, rect.h, colorHex(ctx.theme.surface0))
  drawLine(rect.x, rect.y + rect.h, rect.x + rect.w, rect.y + rect.h, colorHex(ctx.theme.outlineVariant), 1.0)
  mut nextActive = activeIdx
  mut closedTab = -1
  let count = titles.len
  let tabW = if count > 0: clampFloat((rect.w - 44.0) / float(count), 96.0, 180.0) else: 140.0
  mut i = 0
  while i < count:
    let tx = rect.x + 4.0 + float(i) * (tabW + 2.0)
    let tRect = AuraRect(x = tx, y = rect.y + 3.0, w = tabW, h = rect.h - 3.0)
    let closeRect = AuraRect(x = tx + tabW - 22.0, y = rect.y + 7.0, w = 16.0, h = rect.h - 11.0)
    let isSel = (i == nextActive)
    let bg = if isSel: ctx.theme.surface2 else: ctx.theme.surface1
    drawRoundedRect(tRect.x, tRect.y, tRect.w, tRect.h, 5.0, colorHex(bg))
    if isSel:
      drawRect(tRect.x + 4.0, rect.y + rect.h - 2.5, tRect.w - 8.0, 2.5, colorHex(ctx.theme.primary))
    let isDirty = if i < dirtyFlags.len: dirtyFlags[i] else: false
    let suffix = if isDirty: " *" else: ""
    let fitTitle = truncateText(titles[i] + suffix, tabW - 32.0, 0.82)
    drawText(fitTitle, tx + 10.0, rect.y + (rect.h - 10.0) * 0.5, 0.82, colorHex(if isSel: ctx.theme.textPrimary else: ctx.theme.textSecondary))
    if auraIsHovered(ctx, closeRect):
      drawRoundedRect(closeRect.x, closeRect.y, closeRect.w, closeRect.h, 3.0, colorHex(ctx.theme.surface3))
    drawTextCentered("x", closeRect.x + 8.0, closeRect.y + 2.0, 0.75, colorHex(ctx.theme.textMuted))
    if auraIsClicked(ctx, closeRect):
      closedTab = i
    elif auraIsClicked(ctx, tRect):
      nextActive = i
    i = i + 1
  let addX = rect.x + 6.0 + float(count) * (tabW + 2.0)
  let addRect = AuraRect(x = addX, y = rect.y + 5.0, w = 26.0, h = rect.h - 8.0)
  let addClicked = auraButton(ctx, id + "_add", addRect, "+", "tonal")
  ret AuraDocTabResult(activeIdx = nextActive, closedIdx = closedTab, addClicked = addClicked)

pub fn auraShortcutPressed(ctx: AuraContext, keyName: str): bool:
  let ctrlDown = isKeyDown("Control") or isKeyDown("LeftControl") or isKeyDown("RightControl")
  ret ctrlDown and isKeyPressed(keyName)

pub fn auraModShortcutPressed(ctrl: bool, shift: bool, keyName: str): bool:
  let ctrlDown = isKeyDown("Control") or isKeyDown("LeftControl") or isKeyDown("RightControl")
  let shiftDown = isKeyDown("Shift") or isKeyDown("LeftShift") or isKeyDown("RightShift")
  if ctrl and not ctrlDown:
    ret false
  if shift and not shiftDown:
    ret false
  ret isKeyPressed(keyName)

pub fn auraElementToolbarStripIds(ctx: AuraContext, id: str, rect: AuraRect, elements: [str], ids: [int], colors: [int], activeId: int): int:
  mut activeIdx = 0
  mut i = 0
  while i < ids.len:
    if ids[i] == activeId:
      activeIdx = i
    i = i + 1
  let nextIdx = auraElementToolbarStrip(ctx, id, rect, elements, colors, activeIdx)
  if nextIdx >= 0 and nextIdx < ids.len:
    ret ids[nextIdx]
  ret activeId

// ============================================================================
// 19. Wave 2 High-Level Studio & Genre-Authentic Game Composite Widgets (v0.4.0)
// ============================================================================

/// Renders a complete RGB/Hex + Primary/Secondary Color Studio panel with swatch grid.
/// Returns the newly selected color hex (`>= 0`), or `primaryColor` if unchanged.
pub fn auraColorStudioPanel(ctx: AuraContext, id: str, rect: AuraRect, primaryColor: int, secondaryColor: int, swatches: [int], cols: int): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  drawText("COLOR STUDIO", rect.x + 10.0, rect.y + 8.0, 0.78, colorHex(ctx.theme.textSecondary))
  // Secondary & Primary overlapping preview wells
  drawRoundedRect(rect.x + 24.0, rect.y + 34.0, 28.0, 24.0, 4.0, colorHex(secondaryColor))
  drawRoundedRectOutline(rect.x + 24.0, rect.y + 34.0, 28.0, 24.0, 4.0, 1.0, colorHex(ctx.theme.outline))
  drawRoundedRect(rect.x + 10.0, rect.y + 26.0, 28.0, 24.0, 4.0, colorHex(primaryColor))
  drawRoundedRectOutline(rect.x + 10.0, rect.y + 26.0, 28.0, 24.0, 4.0, 1.5, colorHex(0xFFFFFF))
  let rVal = (primaryColor >> 16) & 255
  let gVal = (primaryColor >> 8) & 255
  let bVal = primaryColor & 255
  drawText("R:" + str(rVal) + " G:" + str(gVal) + " B:" + str(bVal), rect.x + 62.0, rect.y + 34.0, 0.78, colorHex(ctx.theme.textPrimary))
  let gridRect = AuraRect(x = rect.x + 8.0, y = rect.y + 64.0, w = rect.w - 16.0, h = maxFloat(24.0, rect.h - 72.0))
  ret auraColorSwatchGrid(ctx, id + "_swatches", gridRect, swatches, cols, primaryColor)

/// Renders a multi-layer stack inspector with Visibility (V), Lock (L), and Opacity %.
/// Returns the active layer index (`0..names.len-1`).
pub fn auraLayerStack(ctx: AuraContext, id: str, rect: AuraRect, names: [str], visibles: [bool], lockeds: [bool], opacities: [int], activeIdx: int): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  drawText("LAYERS (" + str(names.len) + ")", rect.x + 10.0, rect.y + 8.0, 0.78, colorHex(ctx.theme.textSecondary))
  mut nextActive = activeIdx
  let rowH = 30.0
  mut i = 0
  while i < names.len:
    let ry = rect.y + 28.0 + float(i) * (rowH + 3.0)
    if ry + rowH <= rect.y + rect.h:
      let rRect = AuraRect(x = rect.x + 6.0, y = ry, w = rect.w - 12.0, h = rowH)
      let vis = if i < visibles.len: visibles[i] else: true
      let lck = if i < lockeds.len: lockeds[i] else: false
      let opa = if i < opacities.len: opacities[i] else: 100
      let code = auraLayerListRow(ctx, id + "_row_" + str(i), rRect, names[i], vis, lck, opa, i == nextActive)
      if code > 0:
        nextActive = i
    i = i + 1
  ret nextActive

/// Renders a studio canvas viewport frame with top/left pixel rulers and status readout.
/// Returns the inner drawable canvas `AuraRect`.
pub fn auraCanvasViewport(ctx: AuraContext, id: str, rect: AuraRect, zoomPct: int, cursorGridX: int, cursorGridY: int, canvasW: int, canvasH: int): AuraRect:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let rulerThickness = 18.0
  // Top ruler bar
  drawRect(rect.x + rulerThickness, rect.y + 1.0, rect.w - rulerThickness - 1.0, rulerThickness, colorHex(ctx.theme.surface1))
  // Left ruler bar
  drawRect(rect.x + 1.0, rect.y + rulerThickness, rulerThickness, rect.h - rulerThickness * 2.0, colorHex(ctx.theme.surface1))
  mut tick = 0
  while tick < 8:
    let tx = rect.x + rulerThickness + float(tick) * ((rect.w - rulerThickness) / 8.0)
    drawLine(tx, rect.y + rulerThickness - 5.0, tx, rect.y + rulerThickness, colorHex(ctx.theme.textMuted), 1.0)
    let ty = rect.y + rulerThickness + float(tick) * ((rect.h - rulerThickness * 2.0) / 8.0)
    drawLine(rect.x + rulerThickness - 5.0, ty, rect.x + rulerThickness, ty, colorHex(ctx.theme.textMuted), 1.0)
    tick = tick + 1
  // Footer telemetry bar inside viewport
  let footY = rect.y + rect.h - rulerThickness
  drawRect(rect.x + 1.0, footY, rect.w - 2.0, rulerThickness - 1.0, colorHex(ctx.theme.surface1))
  drawText(str(canvasW) + "x" + str(canvasH) + "px  |  Zoom: " + str(zoomPct) + "%  |  XY: (" + str(cursorGridX) + ", " + str(cursorGridY) + ")", rect.x + 8.0, footY + 3.0, 0.72, colorHex(ctx.theme.textSecondary))
  ret AuraRect(x = rect.x + rulerThickness + 4.0, y = rect.y + rulerThickness + 4.0, w = maxFloat(16.0, rect.w - rulerThickness - 8.0), h = maxFloat(16.0, rect.h - rulerThickness * 2.0 - 8.0))

/// Renders an interactive draggable split pane divider and returns the updated split ratio (`[0.15, 0.85]`).
pub fn auraSplitPaneInteractive(ctx: AuraContext, id: str, rect: AuraRect, ratio: float, horizontal: bool): float:
  mut r = clampFloat(ratio, 0.15, 0.85)
  if horizontal:
    let splitX = rect.x + rect.w * r
    let handleRect = AuraRect(x = splitX - 4.0, y = rect.y, w = 8.0, h = rect.h)
    let hov = auraIsHovered(ctx, handleRect)
    if hov and ctx.mouseDown:
      r = clampFloat((ctx.mouseX - rect.x) / maxFloat(1.0, rect.w), 0.15, 0.85)
    let divCol = if hov: ctx.theme.primary else: ctx.theme.outlineVariant
    drawLine(rect.x + rect.w * r, rect.y, rect.x + rect.w * r, rect.y + rect.h, colorHex(divCol), if hov: 2.0 else: 1.0)
  else:
    let splitY = rect.y + rect.h * r
    let handleRect = AuraRect(x = rect.x, y = splitY - 4.0, w = rect.w, h = 8.0)
    let hov = auraIsHovered(ctx, handleRect)
    if hov and ctx.mouseDown:
      r = clampFloat((ctx.mouseY - rect.y) / maxFloat(1.0, rect.h), 0.15, 0.85)
    let divCol = if hov: ctx.theme.primary else: ctx.theme.outlineVariant
    drawLine(rect.x, rect.y + rect.h * r, rect.x + rect.w, rect.y + rect.h * r, colorHex(divCol), if hov: 2.0 else: 1.0)
  ret r

/// Renders a code/document minimap scrollbar track with line density bars and viewport lens.
/// Returns the updated `scrollLine` index when clicked/dragged.
pub fn auraMinimapScrollbar(ctx: AuraContext, id: str, rect: AuraRect, lineLengths: [int], scrollLine: int, visibleLines: int, totalLines: int): int:
  drawRect(rect.x, rect.y, rect.w, rect.h, colorHex(ctx.theme.surface0))
  drawLine(rect.x, rect.y, rect.x, rect.y + rect.h, colorHex(ctx.theme.outlineVariant), 1.0)
  let safeTotal = maxInt(1, totalLines)
  let maxPreview = minInt(lineLengths.len, 80)
  mut i = 0
  while i < maxPreview:
    let ly = rect.y + 4.0 + (float(i) / float(maxInt(1, maxPreview))) * (rect.h - 8.0)
    let barW = clampFloat(float(lineLengths[i]) * 0.45, 2.0, rect.w - 8.0)
    drawRect(rect.x + 4.0, ly, barW, 1.5, colorHex(ctx.theme.textMuted))
    i = i + 1
  let lensRatio = clampFloat(float(visibleLines) / float(safeTotal), 0.08, 1.0)
  let lensH = maxFloat(18.0, rect.h * lensRatio)
  let posRatio = clampFloat(float(scrollLine) / float(maxInt(1, safeTotal - visibleLines)), 0.0, 1.0)
  let lensY = rect.y + posRatio * (rect.h - lensH)
  drawRoundedRect(rect.x + 2.0, lensY, rect.w - 4.0, lensH, 3.0, rgba(124, 92, 255, 68))
  drawRoundedRectOutline(rect.x + 2.0, lensY, rect.w - 4.0, lensH, 3.0, 1.0, colorHex(ctx.theme.primary))
  if auraIsHovered(ctx, rect) and (ctx.mouseClicked or ctx.mouseDown):
    let clickRatio = clampFloat((ctx.mouseY - rect.y) / maxFloat(1.0, rect.h), 0.0, 1.0)
    ret int(clickRatio * float(maxInt(0, safeTotal - visibleLines)))
  ret scrollLine

/// Renders a vector flowchart diagram (nodes + directed arrows) inside `rect`.
pub fn auraMermaidFlowchart(ctx: AuraContext, rect: AuraRect, nodeLabels: [str], edgeFrom: [int], edgeTo: [int]):
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let n = nodeLabels.len
  if n == 0:
    ret
  let nodeW = clampFloat((rect.w - 32.0) / float(maxInt(1, n)) - 14.0, 64.0, 140.0)
  let nodeH = 30.0
  let cy = rect.y + (rect.h - nodeH) * 0.5
  mut ei = 0
  while ei < edgeFrom.len and ei < edgeTo.len:
    let a = edgeFrom[ei]
    let b = edgeTo[ei]
    if a >= 0 and a < n and b >= 0 and b < n:
      let ax = rect.x + 16.0 + float(a) * (nodeW + 16.0) + nodeW
      let bx = rect.x + 16.0 + float(b) * (nodeW + 16.0)
      let midY = cy + nodeH * 0.5
      drawLine(ax, midY, bx, midY, colorHex(ctx.theme.primary), 1.8)
      drawTriangle(bx, midY, bx - 6.0, midY - 4.0, bx - 6.0, midY + 4.0, colorHex(ctx.theme.primary))
    ei = ei + 1
  mut ni = 0
  while ni < n:
    let nx = rect.x + 16.0 + float(ni) * (nodeW + 16.0)
    drawRoundedRect(nx, cy, nodeW, nodeH, 5.0, colorHex(ctx.theme.surface2))
    drawRoundedRectOutline(nx, cy, nodeW, nodeH, 5.0, 1.2, colorHex(ctx.theme.secondary))
    drawTextCentered(truncateText(nodeLabels[ni], nodeW - 10.0, 0.78), nx + nodeW * 0.5, cy + 8.0, 0.78, colorHex(ctx.theme.textPrimary))
    ni = ni + 1
  ret

/// Renders a tactical / RPG / strategy style inventory grid slot cell.
/// Returns `true` when clicked.
pub fn auraInventoryGridSlot(ctx: AuraContext, id: str, rect: AuraRect, itemLabel: str, quantity: int, equipped: bool, selected: bool, rarityColor: int): bool:
  let hov = auraIsHovered(ctx, rect)
  let bg = if selected: ctx.theme.primaryContainer elif hov: ctx.theme.surface3 else: ctx.theme.surface1
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(bg))
  let borderCol = if equipped: ctx.theme.success elif selected: ctx.theme.primary elif rarityColor > 0: rarityColor else: ctx.theme.outlineVariant
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, if equipped or selected: 2.0 else: 1.0, colorHex(borderCol))
  if itemLabel.len > 0:
    drawTextCentered(truncateText(itemLabel, rect.w - 8.0, 0.78), rect.x + rect.w * 0.5, rect.y + (rect.h - 10.0) * 0.5, 0.78, colorHex(if rarityColor > 0: rarityColor else: ctx.theme.textPrimary))
  if equipped:
    drawText("E", rect.x + 4.0, rect.y + 4.0, 0.68, colorHex(ctx.theme.success))
  if quantity > 1:
    drawTextRight("x" + str(quantity), rect.x + rect.w - 4.0, rect.y + rect.h - 12.0, 0.70, colorHex(ctx.theme.warning))
  ret auraIsClicked(ctx, rect)

/// Renders a ARPG / RTS style skill tree node with optional prerequisite connector line and rank badge.
/// Returns `true` when clicked.
pub fn auraSkillTreeNode(ctx: AuraContext, id: str, rect: AuraRect, title: str, rank: int, maxRank: int, unlocked: bool, parentCenterX: float, parentBottomY: float): bool:
  if parentCenterX > 0.0 and parentBottomY > 0.0:
    let connCol = if rank > 0: ctx.theme.warning elif unlocked: ctx.theme.secondary else: ctx.theme.outlineVariant
    drawLine(parentCenterX, parentBottomY, rect.x + rect.w * 0.5, rect.y, colorHex(connCol), 2.0)
  let hov = auraIsHovered(ctx, rect)
  let bg = if rank > 0: ctx.theme.surface2 elif unlocked: ctx.theme.surface1 else: ctx.theme.surface0
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 5.0, colorHex(bg))
  let rim = if rank > 0: ctx.theme.warning elif hov and unlocked: ctx.theme.primary elif unlocked: ctx.theme.secondary else: ctx.theme.outlineVariant
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 5.0, if rank > 0: 2.0 else: 1.0, colorHex(rim))
  drawTextCentered(truncateText(title, rect.w - 8.0, 0.74), rect.x + rect.w * 0.5, rect.y + 8.0, 0.74, colorHex(if unlocked: ctx.theme.textPrimary else: ctx.theme.textMuted))
  drawTextRight(str(rank) + "/" + str(maxRank), rect.x + rect.w - 5.0, rect.y + rect.h - 13.0, 0.68, colorHex(if rank > 0: ctx.theme.warning else: ctx.theme.textMuted))
  ret unlocked and auraIsClicked(ctx, rect)

/// Renders a tactical translucent dark-olive buy menu panel.
/// Returns the clicked item index (`0..items.len-1`), or `-1` if none clicked.
pub fn auraBuyMenuOverlay(ctx: AuraContext, id: str, rect: AuraRect, title: str, items: [str], prices: [int], playerCash: int, selectedIdx: int): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, rgba(24, 32, 22, 228))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.5, rgba(164, 184, 140, 210))
  drawText(title, rect.x + 14.0, rect.y + 12.0, 0.96, rgba(255, 196, 64, 255))
  drawTextRight("$" + str(playerCash), rect.x + rect.w - 14.0, rect.y + 12.0, 0.92, rgba(110, 235, 110, 255))
  drawLine(rect.x + 10.0, rect.y + 34.0, rect.x + rect.w - 10.0, rect.y + 34.0, rgba(164, 184, 140, 140), 1.0)
  mut clicked = -1
  let rowH = 28.0
  mut i = 0
  while i < items.len:
    let ry = rect.y + 42.0 + float(i) * (rowH + 4.0)
    if ry + rowH <= rect.y + rect.h:
      let rRect = AuraRect(x = rect.x + 12.0, y = ry, w = rect.w - 24.0, h = rowH)
      let price = if i < prices.len: prices[i] else: 0
      let affordable = playerCash >= price
      let hov = auraIsHovered(ctx, rRect)
      let isSel = (i == selectedIdx)
      let rowBg = if hov or isSel: rgba(62, 78, 54, 220) else: rgba(34, 44, 30, 190)
      drawRoundedRect(rRect.x, rRect.y, rRect.w, rRect.h, 3.0, rowBg)
      drawRoundedRectOutline(rRect.x, rRect.y, rRect.w, rRect.h, 3.0, 1.0, rgba(140, 160, 120, 150))
      let textCol = if affordable: rgba(245, 215, 110, 255) else: rgba(165, 95, 95, 220)
      drawText(str(i + 1) + ". " + items[i], rRect.x + 10.0, ry + 7.0, 0.82, textCol)
      if price > 0:
        drawTextRight("$" + str(price), rRect.x + rRect.w - 10.0, ry + 7.0, 0.80, textCol)
      if auraIsClicked(ctx, rRect):
        clicked = i
    i = i + 1
  ret clicked

pub struct AuraHeatmapCell(row: int, col: int)

/// Renders an interactive cohort/retention heatmap matrix and returns the clicked `(row, col)`.
pub fn auraHeatmapGrid(ctx: AuraContext, id: str, rect: AuraRect, rowLabels: [str], colLabels: [str], values: [[int]], lowThresh: int, midThresh: int, highThresh: int, selectedRow: int, selectedCol: int): AuraHeatmapCell:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let rCount = maxInt(1, rowLabels.len)
  let cCount = maxInt(1, colLabels.len)
  let labelW = 68.0
  let hdrH = 24.0
  let cellW = maxFloat(24.0, (rect.w - labelW - 12.0) / float(cCount))
  let cellH = maxFloat(20.0, (rect.h - hdrH - 12.0) / float(rCount))
  mut ci = 0
  while ci < colLabels.len:
    drawTextCentered(colLabels[ci], rect.x + labelW + float(ci) * cellW + cellW * 0.5, rect.y + 6.0, 0.74, colorHex(ctx.theme.textSecondary))
    ci = ci + 1
  mut clickedR = selectedRow
  mut clickedC = selectedCol
  mut ri = 0
  while ri < rowLabels.len:
    let ry = rect.y + hdrH + float(ri) * cellH
    drawText(rowLabels[ri], rect.x + 8.0, ry + (cellH - 10.0) * 0.5, 0.76, colorHex(ctx.theme.textPrimary))
    if ri < values.len:
      let rowVals = values[ri]
      mut cj = 0
      while cj < rowVals.len and cj < cCount:
        let cx = rect.x + labelW + float(cj) * cellW
        let cRect = AuraRect(x = cx + 2.0, y = ry + 2.0, w = cellW - 4.0, h = cellH - 4.0)
        let v = rowVals[cj]
        let cellCol = if v >= highThresh: ctx.theme.success elif v >= midThresh: ctx.theme.primary elif v >= lowThresh: ctx.theme.surface2 else: ctx.theme.danger
        drawRoundedRect(cRect.x, cRect.y, cRect.w, cRect.h, 3.0, colorHex(cellCol))
        if ri == selectedRow and cj == selectedCol:
          drawRoundedRectOutline(cRect.x, cRect.y, cRect.w, cRect.h, 3.0, 2.0, colorHex(0xFFFFFF))
        drawTextCentered(str(v) + "%", cRect.x + cRect.w * 0.5, cRect.y + (cRect.h - 10.0) * 0.5, 0.74, colorHex(ctx.theme.textPrimary))
        if auraIsClicked(ctx, cRect):
          clickedR = ri
          clickedC = cj
        cj = cj + 1
    ri = ri + 1
  ret AuraHeatmapCell(row = clickedR, col = clickedC)

/// Renders an SLA escalation countdown row (`BREACH` / `AMBER` / `OK`) with inline Acknowledge button.
pub fn auraSlaCountdownRow(ctx: AuraContext, id: str, rect: AuraRect, title: str, subtitle: str, remainingMins: int, acknowledged: bool): bool:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(ctx.theme.surface1))
  let sevCol = if acknowledged: ctx.theme.success elif remainingMins < 0: ctx.theme.danger elif remainingMins < 20: ctx.theme.warning else: ctx.theme.info
  drawRect(rect.x, rect.y, 4.0, rect.h, colorHex(sevCol))
  drawText(title, rect.x + 12.0, rect.y + 6.0, 0.82, colorHex(ctx.theme.textPrimary))
  drawText(subtitle, rect.x + 12.0, rect.y + 20.0, 0.72, colorHex(ctx.theme.textSecondary))
  let badgeTxt = if acknowledged: "ACK" elif remainingMins < 0: "BREACH " + str(remainingMins) + "m" else: str(remainingMins) + "m"
  drawTextRight(badgeTxt, rect.x + rect.w - 68.0, rect.y + 11.0, 0.76, colorHex(sevCol))
  let btnRect = AuraRect(x = rect.x + rect.w - 58.0, y = rect.y + 5.0, w = 52.0, h = rect.h - 10.0)
  ret auraButton(ctx, id + "_ack", btnRect, if acknowledged: "Done" else: "Ack", "tonal")

/// Renders a local node-and-edge knowledge/relationship graph around `centerLabel`.
/// Returns the clicked neighbor index (`0..neighborLabels.len-1`), or `-1`.
pub fn auraNodeGraph(ctx: AuraContext, id: str, rect: AuraRect, centerLabel: str, neighborLabels: [str]): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let cx = rect.x + rect.w * 0.5
  let cy = rect.y + rect.h * 0.5
  let orbitR = minFloat(rect.w, rect.h) * 0.34
  let n = neighborLabels.len
  mut clickedIdx = -1
  mut i = 0
  while i < n:
    let ang = (float(i) / float(maxInt(1, n))) * 6.2831853
    let nx = cx + cos(ang) * orbitR
    let ny = cy + sin(ang) * orbitR
    drawLine(cx, cy, nx, ny, colorHex(ctx.theme.outlineVariant), 1.5)
    let nRect = AuraRect(x = nx - 36.0, y = ny - 12.0, w = 72.0, h = 24.0)
    let hov = auraIsHovered(ctx, nRect)
    drawRoundedRect(nRect.x, nRect.y, nRect.w, nRect.h, 12.0, colorHex(if hov: ctx.theme.primaryContainer else: ctx.theme.surface2))
    drawRoundedRectOutline(nRect.x, nRect.y, nRect.w, nRect.h, 12.0, 1.0, colorHex(if hov: ctx.theme.primary else: ctx.theme.secondary))
    drawTextCentered(truncateText(neighborLabels[i], 64.0, 0.72), nx, ny - 5.0, 0.72, colorHex(ctx.theme.textPrimary))
    if auraIsClicked(ctx, nRect):
      clickedIdx = i
    i = i + 1
  drawCircle(cx, cy, 20.0, colorHex(ctx.theme.primary))
  drawTextCentered(truncateText(centerLabel, 56.0, 0.76), cx, cy - 5.0, 0.76, colorHex(ctx.theme.onPrimary))
  ret clickedIdx

/// Renders an ARPG socketed item hover tooltip card (Unique Gold, Set Green, Rare Yellow, glyphword Gold)
/// with automatic viewport boundary clamping (`x + w <= screenW`, `y + h <= screenH`).
pub fn auraItemTooltipCard(ctx: AuraContext, x: float, y: float, title: str, titleColor: int, subtitle: str, affixes: [str], sockets: int): void:
  let nAffix = affixes.len
  let cardW = 240.0
  let sockH = if sockets > 0: 26.0 else: 0.0
  let cardH = 48.0 + float(nAffix) * 18.0 + sockH
  let sw = float(getScreenWidth())
  let sh = float(getScreenHeight())
  let cx = clampFloat(x, 8.0, maxFloat(8.0, sw - cardW - 8.0))
  let cy = clampFloat(y, 8.0, maxFloat(8.0, sh - cardH - 8.0))
  drawRoundedRect(cx + 3.0, cy + 4.0, cardW, cardH, 6.0, rgba(0.0, 0.0, 0.0, 0.72))
  drawRoundedRect(cx, cy, cardW, cardH, 6.0, rgba(0.04, 0.04, 0.06, 0.94))
  drawRoundedRectOutline(cx, cy, cardW, cardH, 6.0, 1.5, colorHex(titleColor))
  drawTextCentered(truncateText(title, cardW - 16.0, 0.92), cx + cardW * 0.5, cy + 8.0, 0.92, colorHex(titleColor))
  drawTextCentered(truncateText(subtitle, cardW - 16.0, 0.76), cx + cardW * 0.5, cy + 25.0, 0.76, colorHex(ctx.theme.textSecondary))
  mut i = 0
  while i < nAffix:
    drawTextCentered(truncateText(affixes[i], cardW - 16.0, 0.78), cx + cardW * 0.5, cy + 44.0 + float(i) * 18.0, 0.78, colorHex(0x6888FF))
    i = i + 1
  if sockets > 0:
    let sy = cy + 46.0 + float(nAffix) * 18.0
    let startX = cx + cardW * 0.5 - float(sockets) * 11.0
    mut s = 0
    while s < sockets:
      let sx = startX + float(s) * 22.0 + 11.0
      drawCircle(sx, sy + 8.0, 7.0, rgba(0.08, 0.08, 0.12, 0.95))
      drawCircleOutline(sx, sy + 8.0, 7.0, 1.5, colorHex(0xC7B377))
      s = s + 1

// ============================================================================
// 20. Wave 3 AuraDS 5.0 Studio, Color Wheel, RTS & Tactical HUD Extensions (v0.4.0)
// ============================================================================

/// Converts HSV (`hDeg` in `0..360`, `sPct` in `0..100`, `vPct` in `0..100`) to a 24-bit `0xRRGGBB` integer.
pub fn auraHsvToRgbHex(hDeg: float, sPct: float, vPct: float): int:
  mut h = hDeg
  while h < 0.0:
    h = h + 360.0
  while h >= 360.0:
    h = h - 360.0
  let s = clampFloat(sPct / 100.0, 0.0, 1.0)
  let v = clampFloat(vPct / 100.0, 0.0, 1.0)
  let c = v * s
  let sector = int(h / 60.0) % 6
  let frac = (h / 60.0) - float(int(h / 60.0))
  let x = if sector % 2 == 0: c * frac else: c * (1.0 - frac)
  let m = v - c
  mut rf = 0.0
  mut gf = 0.0
  mut bf = 0.0
  if sector == 0:
    rf = c
    gf = x
  elif sector == 1:
    rf = x
    gf = c
  elif sector == 2:
    gf = c
    bf = x
  elif sector == 3:
    gf = x
    bf = c
  elif sector == 4:
    rf = x
    bf = c
  else:
    rf = c
    bf = x
  let ri = clamp(int((rf + m) * 255.0), 0, 255)
  let gi = clamp(int((gf + m) * 255.0), 0, 255)
  let bi = clamp(int((bf + m) * 255.0), 0, 255)
  ret (ri * 65536) + (gi * 256) + bi

/// Renders an interactive HSV color wheel with outer hue ring and inner saturation/value well.
/// Returns the selected `0xRRGGBB` color hex.
pub fn auraHsvColorWheel(ctx: AuraContext, cx: float, cy: float, rOuter: float, rInner: float, hDeg: float, sPct: float, vPct: float): int:
  let ringR = (rOuter + rInner) * 0.5
  let ringThick = maxFloat(4.0, rOuter - rInner)
  let segments = 24
  mut i = 0
  while i < segments:
    let a1 = (float(i) / float(segments)) * 6.2831853
    let a2 = (float(i + 1) / float(segments)) * 6.2831853
    let segHue = (float(i) / float(segments)) * 360.0
    let segHex = auraHsvToRgbHex(segHue, 100.0, 100.0)
    let x1 = cx + cos(a1) * ringR
    let y1 = cy + sin(a1) * ringR
    let x2 = cx + cos(a2) * ringR
    let y2 = cy + sin(a2) * ringR
    drawLine(x1, y1, x2, y2, colorHex(segHex), ringThick)
    i = i + 1
  drawCircleOutline(cx, cy, rOuter + 1.0, 1.5, colorHex(ctx.theme.outlineVariant))
  drawCircleOutline(cx, cy, maxFloat(2.0, rInner - 1.0), 1.5, colorHex(ctx.theme.outlineVariant))
  let activeHex = auraHsvToRgbHex(hDeg, sPct, vPct)
  let innerWellR = maxFloat(6.0, rInner - 5.0)
  drawCircle(cx, cy, innerWellR, colorHex(activeHex))
  let hRad = (hDeg * 3.14159265) / 180.0
  let hx = cx + cos(hRad) * ringR
  let hy = cy + sin(hRad) * ringR
  drawCircle(hx, hy, ringThick * 0.45 + 1.5, colorHex(0xFFFFFF))
  drawCircle(hx, hy, ringThick * 0.32, colorHex(auraHsvToRgbHex(hDeg, 100.0, 100.0)))
  if ctx.mouseDown or ctx.mouseClicked:
    let dx = ctx.mouseX - cx
    let dy = ctx.mouseY - cy
    let dist = sqrt(dx * dx + dy * dy)
    if dist >= rInner - 4.0 and dist <= rOuter + 6.0:
      mut angDeg = (atan2(dy, dx) * 180.0) / 3.14159265
      if angDeg < 0.0:
        angDeg = angDeg + 360.0
      ret auraHsvToRgbHex(angDeg, sPct, vPct)
  ret activeHex

/// Renders a team-aware kill feed entry with custom killer and victim faction colors.
pub fn auraKillFeedEntryColored(ctx: AuraContext, x: float, y: float, killer: str, killerCol: int, weapon: str, victim: str, victimCol: int, isHeadshot: bool = false): void:
  let hsTag = if isHeadshot: " [HS] " else: " "
  let fullStr = killer + " [" + weapon + "]" + hsTag + victim
  let w = measureTextWidthPx(fullStr, 0.8) + 20.0
  let h = 22.0
  drawRoundedRect(x, y, w, h, 4.0, rgba(10, 14, 24, 0.78))
  drawRoundedRectOutline(x, y, w, h, 4.0, 1.0, colorHex(if isHeadshot: ctx.theme.danger else: ctx.theme.outlineVariant))
  mut cx = x + 10.0
  let ty = y + 5.0
  drawText(killer, cx, ty, 0.8, colorHex(killerCol))
  cx = cx + measureTextWidthPx(killer + " ", 0.8)
  let wepStr = "[" + weapon + "]" + hsTag
  drawText(wepStr, cx, ty, 0.8, colorHex(if isHeadshot: ctx.theme.warning else: ctx.theme.textMuted))
  cx = cx + measureTextWidthPx(wepStr, 0.8)
  drawText(victim, cx, ty, 0.8, colorHex(victimCol))

/// Renders an interactive RTS minimap with camera frustum box and returns updated `(camX, camY)` as `Vec2`.
pub fn auraMinimapRTS(ctx: AuraContext, id: str, rect: AuraRect, worldW: float, worldH: float, camX: float, camY: float, viewW: float, viewH: float, blipPositions: [Vec2], blipColors: [int]): Vec2:
  auraMinimapFrame(ctx, rect, worldW, worldH, blipPositions, blipColors)
  let safeW = maxFloat(1.0, worldW)
  let safeH = maxFloat(1.0, worldH)
  let fx = rect.x + clampFloat(camX / safeW, 0.0, 1.0) * rect.w
  let fy = rect.y + clampFloat(camY / safeH, 0.0, 1.0) * rect.h
  let fw = clampFloat((viewW / safeW) * rect.w, 12.0, rect.w)
  let fh = clampFloat((viewH / safeH) * rect.h, 10.0, rect.h)
  drawRectOutline(clampFloat(fx, rect.x, rect.x + rect.w - fw), clampFloat(fy, rect.y, rect.y + rect.h - fh), fw, fh, 1.5, colorHex(0xFFFFFF))
  if auraIsHovered(ctx, rect) and (ctx.mouseClicked or ctx.mouseDown):
    let nx = clampFloat((ctx.mouseX - rect.x) / maxFloat(1.0, rect.w), 0.0, 1.0) * safeW - viewW * 0.5
    let ny = clampFloat((ctx.mouseY - rect.y) / maxFloat(1.0, rect.h), 0.0, 1.0) * safeH - viewH * 0.5
    ret Vec2(x = clampFloat(nx, 0.0, maxFloat(0.0, safeW - viewW)), y = clampFloat(ny, 0.0, maxFloat(0.0, safeH - viewH)))
  ret Vec2(x = camX, y = camY)

/// Renders a top-left RTS style stacked Hero portrait column (`F1..F3`) and returns the clicked hero index.
pub fn auraHeroPortraitStackRTS(ctx: AuraContext, id: str, x: float, y: float, names: [str], levels: [int], hpRatios: [float], manaRatios: [float], selectedIdx: int): int:
  mut chosen = selectedIdx
  let cardW = 148.0
  let cardH = 44.0
  mut i = 0
  while i < names.len:
    let cy = y + float(i) * (cardH + 6.0)
    let r = AuraRect(x = x, y = cy, w = cardW, h = cardH)
    let isSel = (i == chosen)
    drawRoundedRect(r.x, r.y, r.w, r.h, 5.0, colorHex(if isSel: ctx.theme.surface2 else: ctx.theme.surface0))
    drawRoundedRectOutline(r.x, r.y, r.w, r.h, 5.0, if isSel: 2.0 else: 1.0, colorHex(if isSel: ctx.theme.warning else: ctx.theme.outline))
    let lvl = if i < levels.len: levels[i] else: 1
    let hp = if i < hpRatios.len: clampFloat(hpRatios[i], 0.0, 1.0) else: 1.0
    let mp = if i < manaRatios.len: clampFloat(manaRatios[i], 0.0, 1.0) else: 1.0
    drawText("F" + str(i + 1) + " Lv." + str(lvl) + " " + truncateText(names[i], 84.0, 0.74), r.x + 8.0, r.y + 5.0, 0.74, colorHex(ctx.theme.textPrimary))
    drawRect(r.x + 8.0, r.y + 22.0, cardW - 16.0, 6.0, colorHex(0x1E293B))
    drawRect(r.x + 8.0, r.y + 22.0, (cardW - 16.0) * hp, 6.0, colorHex(ctx.theme.success))
    drawRect(r.x + 8.0, r.y + 31.0, cardW - 16.0, 6.0, colorHex(0x1E293B))
    drawRect(r.x + 8.0, r.y + 31.0, (cardW - 16.0) * mp, 6.0, colorHex(ctx.theme.info))
    if auraIsClicked(ctx, r):
      chosen = i
    i = i + 1
  ret chosen

/// Renders a side-by-side split diff comparison view highlighting modified lines.
pub fn auraSplitDiffView(ctx: AuraContext, id: str, rect: AuraRect, leftTitle: str, leftLines: [str], rightTitle: str, rightLines: [str], scrollY: float): void:
  let halfW = (rect.w - 6.0) * 0.5
  let rLeft = AuraRect(x = rect.x, y = rect.y, w = halfW, h = rect.h)
  let rRight = AuraRect(x = rect.x + halfW + 6.0, y = rect.y, w = halfW, h = rect.h)
  drawRoundedRect(rLeft.x, rLeft.y, rLeft.w, rLeft.h, 4.0, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rLeft.x, rLeft.y, rLeft.w, rLeft.h, 4.0, 1.0, colorHex(ctx.theme.outlineVariant))
  drawRoundedRect(rRight.x, rRight.y, rRight.w, rRight.h, 4.0, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rRight.x, rRight.y, rRight.w, rRight.h, 4.0, 1.0, colorHex(ctx.theme.outlineVariant))
  drawRect(rLeft.x + 1.0, rLeft.y + 1.0, rLeft.w - 2.0, 24.0, colorHex(ctx.theme.surface2))
  drawRect(rRight.x + 1.0, rRight.y + 1.0, rRight.w - 2.0, 24.0, colorHex(ctx.theme.surface2))
  drawText(truncateText(leftTitle, halfW - 16.0, 0.78), rLeft.x + 8.0, rLeft.y + 6.0, 0.78, colorHex(ctx.theme.textPrimary))
  drawText(truncateText(rightTitle, halfW - 16.0, 0.78), rRight.x + 8.0, rRight.y + 6.0, 0.78, colorHex(ctx.theme.textPrimary))
  let maxLines = maxInt(leftLines.len, rightLines.len)
  let firstLine = maxInt(0, int(scrollY / 18.0))
  mut i = firstLine
  while i < maxLines:
    let ly = rect.y + 28.0 + float(i - firstLine) * 18.0
    if ly + 18.0 > rect.y + rect.h:
      break
    let lStr = if i < leftLines.len: leftLines[i] else: ""
    let rStr = if i < rightLines.len: rightLines[i] else: ""
    let isDiff = (lStr != rStr)
    if isDiff:
      drawRect(rLeft.x + 2.0, ly, halfW - 4.0, 17.0, rgba(239, 68, 68, 0.16))
      drawRect(rRight.x + 2.0, ly, halfW - 4.0, 17.0, rgba(34, 197, 94, 0.16))
    drawText(truncateText(lStr, halfW - 16.0, 0.76), rLeft.x + 8.0, ly + 2.0, 0.76, colorHex(ctx.theme.textSecondary))
    drawText(truncateText(rStr, halfW - 16.0, 0.76), rRight.x + 8.0, ly + 2.0, 0.76, colorHex(ctx.theme.textPrimary))
    i = i + 1

/// Renders ARPG style Life & Mana orbs directly centered at `(leftX, centerY)` and `(rightX, centerY)`.
pub fn auraOrbsHealthManaCentered(ctx: AuraContext, leftX: float, rightX: float, centerY: float, radius: float, hpRatio: float, manaRatio: float): void:
  auraOrbsHealthMana(ctx, leftX, rightX, centerY + radius, radius, hpRatio, manaRatio)

/// Renders a RTS style 12-icon multi-unit subgroup selection strip with individual mini HP/Mana bars and active subgroup gold border.
pub fn auraSubgroupStripRTS(ctx: AuraContext, x: float, y: float, slotW: float, slotH: float, gap: float, names: [str], hpRatios: [float], manaRatios: [float], activeIdx: int): int:
  mut chosen = activeIdx
  mut i = 0
  while i < names.len and i < 12:
    let sx = x + float(i) * (slotW + gap)
    let r = AuraRect(x = sx, y = y, w = slotW, h = slotH)
    let isAct = (i == chosen)
    drawRoundedRect(r.x, r.y, r.w, r.h, 3.0, colorHex(if isAct: ctx.theme.surface2 else: ctx.theme.surface0))
    drawRoundedRectOutline(r.x, r.y, r.w, r.h, 3.0, if isAct: 2.0 else: 1.0, colorHex(if isAct: 0xFFE042 else: ctx.theme.outlineVariant))
    drawText(truncateText(names[i], slotW - 4.0, 0.65), r.x + 2.0, r.y + 2.0, 0.65, colorHex(ctx.theme.textPrimary))
    let hp = if i < hpRatios.len: clampFloat(hpRatios[i], 0.0, 1.0) else: 1.0
    let mp = if i < manaRatios.len: clampFloat(manaRatios[i], 0.0, 1.0) else: 0.0
    drawRect(r.x + 2.0, r.y + slotH - 7.0, (slotW - 4.0) * hp, 3.0, colorHex(ctx.theme.success))
    drawRect(r.x + 2.0, r.y + slotH - 3.5, (slotW - 4.0) * mp, 2.5, colorHex(ctx.theme.info))
    if auraIsClicked(ctx, r):
      chosen = i
    i = i + 1
  ret chosen

/// Renders a compact inline mathematical expression pill (`$...$`) and returns its horizontal advance width.
pub fn auraInlineMathPill(ctx: AuraContext, x: float, y: float, mathText: str): float:
  let tw = float(measureTextWidthPx(mathText, 0.78))
  let pw = tw + 10.0
  drawRoundedRect(x, y - 1.0, pw, 16.0, 4.0, auraGlassColor(ctx.theme.surfaceGlass))
  drawRoundedRectOutline(x, y - 1.0, pw, 16.0, 4.0, 1.0, colorHex(ctx.theme.tertiary))
  drawText(mathText, x + 5.0, y + 1.0, 0.78, colorHex(ctx.theme.tertiary))
  ret pw + 2.0

// =============================================================================
// 13.10 AuraDS 5.5 Composite Studio, Enterprise & Game HUD Primitives (v0.4.0)
// =============================================================================

/// Renders a multi-stage enterprise conversion funnel chart (`stages`, `values`) with centered proportional bars and conversion percentages.
pub fn auraFunnelChart(ctx: AuraContext, rect: AuraRect, stages: [str], values: [float]): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let count = minInt(stages.len, values.len)
  if count <= 0:
    ret
  mut maxV = 1.0
  mut mi = 0
  while mi < count:
    if values[mi] > maxV:
      maxV = values[mi]
    mi = mi + 1
  let pad = 8.0
  let rowGap = 4.0
  let availH = maxFloat(24.0, rect.h - pad * 2.0)
  let rowH = maxFloat(16.0, (availH - float(count - 1) * rowGap) / float(count))
  let maxBarW = maxFloat(60.0, rect.w - pad * 2.0)
  mut i = 0
  while i < count:
    let ratio = clampFloat(values[i] / maxV, 0.14, 1.0)
    let barW = maxBarW * ratio
    let bx = rect.x + (rect.w - barW) * 0.5
    let by = rect.y + pad + float(i) * (rowH + rowGap)
    let col = if i == 0: ctx.theme.primary else: (if i == count - 1: ctx.theme.success else: ctx.theme.secondary)
    drawRoundedRect(bx, by, barW, rowH, 4.0, colorHex(ctx.theme.surface2))
    drawRoundedRect(bx, by, barW, rowH, 4.0, rgba((col / 65536) % 256, (col / 256) % 256, col % 256, 175))
    drawRoundedRectOutline(bx, by, barW, rowH, 4.0, 1.0, colorHex(col))
    let pct = int(clampFloat(values[i] / maxV, 0.0, 1.0) * 100.0)
    let lbl = truncateText(stages[i], barW * 0.55, 0.72)
    let valTxt = str(int(values[i])) + " (" + str(pct) + "%)"
    drawText(lbl, bx + 8.0, by + (rowH - 11.0) * 0.5, 0.72, colorHex(ctx.theme.textPrimary))
    drawTextRight(valTxt, bx + barW - 8.0, by + (rowH - 11.0) * 0.5, 0.72, colorHex(ctx.theme.textPrimary))
    i = i + 1

/// Renders a tactical / RPG boss encounter health bar plaque with centered boss name and immunity subtitle.
pub fn auraBossHealthBar(ctx: AuraContext, rect: AuraRect, bossName: str, hpRatio: float, immunities: str): void:
  let rClamped = clampFloat(hpRatio, 0.0, 1.0)
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(0x110C0A))
  let innerPad = 3.0
  let barW = maxFloat(0.0, (rect.w - innerPad * 2.0) * rClamped)
  let barH = maxFloat(10.0, rect.h - innerPad * 2.0)
  if barW > 0.5:
    drawRect(rect.x + innerPad, rect.y + innerPad, barW, barH, colorHex(0x881313))
    drawRect(rect.x + innerPad, rect.y + innerPad, barW, barH * 0.38, colorHex(0xDC2626))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.5, colorHex(0xCA8A04))
  drawTextCentered(truncateText(bossName, rect.w - 16.0, 0.82), rect.x + rect.w * 0.5, rect.y + (rect.h - 12.0) * 0.5, 0.82, colorHex(0xFEF08A))
  if immunities.len > 0:
    drawTextCentered(truncateText(immunities, rect.w + 40.0, 0.70), rect.x + rect.w * 0.5, rect.y + rect.h + 4.0, 0.70, colorHex(ctx.theme.textSecondary))

/// Renders a RTS / ARPG command card slot with hotkey badge, `#FFE042` golden autocast corners, and radial/vertical cooldown sweep.
pub fn auraRadialCooldownSlot(ctx: AuraContext, rect: AuraRect, label: str, hotkey: str, cooldownRatio: float, isAutocast: bool): bool:
  let cd = clampFloat(cooldownRatio, 0.0, 1.0)
  let hov = auraIsHovered(ctx, rect)
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(if hov and cd <= 0.001: ctx.theme.surface3 else: ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.2, colorHex(if hov and cd <= 0.001: ctx.theme.primary else: ctx.theme.outline))
  if isAutocast:
    let cCol = colorHex(0xFFE042)
    let cl = minFloat(8.0, rect.w * 0.25)
    drawLine(rect.x + 2.0, rect.y + 2.0, rect.x + 2.0 + cl, rect.y + 2.0, cCol, 2.0)
    drawLine(rect.x + 2.0, rect.y + 2.0, rect.x + 2.0, rect.y + 2.0 + cl, cCol, 2.0)
    drawLine(rect.x + rect.w - 2.0, rect.y + 2.0, rect.x + rect.w - 2.0 - cl, rect.y + 2.0, cCol, 2.0)
    drawLine(rect.x + rect.w - 2.0, rect.y + 2.0, rect.x + rect.w - 2.0, rect.y + 2.0 + cl, cCol, 2.0)
    drawLine(rect.x + 2.0, rect.y + rect.h - 2.0, rect.x + 2.0 + cl, rect.y + rect.h - 2.0, cCol, 2.0)
    drawLine(rect.x + 2.0, rect.y + rect.h - 2.0, rect.x + 2.0, rect.y + rect.h - 2.0 - cl, cCol, 2.0)
    drawLine(rect.x + rect.w - 2.0, rect.y + rect.h - 2.0, rect.x + rect.w - 2.0 - cl, rect.y + rect.h - 2.0, cCol, 2.0)
    drawLine(rect.x + rect.w - 2.0, rect.y + rect.h - 2.0, rect.x + rect.w - 2.0, rect.y + rect.h - 2.0 - cl, cCol, 2.0)
  drawTextCentered(truncateText(label, rect.w - 6.0, 0.72), rect.x + rect.w * 0.5, rect.y + rect.h * 0.45, 0.72, colorHex(ctx.theme.textPrimary))
  if hotkey.len > 0:
    drawText(hotkey, rect.x + 4.0, rect.y + 3.0, 0.68, colorHex(0xFFE042))
  if cd > 0.001:
    let maskH = (rect.h - 4.0) * cd
    drawRect(rect.x + 2.0, rect.y + 2.0, rect.w - 4.0, maskH, rgba(4, 8, 16, 185))
    let pct = int(cd * 100.0)
    drawTextCentered(str(pct) + "%", rect.x + rect.w * 0.5, rect.y + rect.h * 0.68, 0.66, colorHex(ctx.theme.warning))
  ret cd <= 0.001 and auraIsClicked(ctx, rect)

/// Renders a horizontal or vertical pixel coordinate ruler with major/minor ticks and live cursor hairline indicator.
pub fn auraPixelRulerBar(ctx: AuraContext, rect: AuraRect, horizontal: bool, maxUnits: int, cursorUnit: int): void:
  drawRect(rect.x, rect.y, rect.w, rect.h, colorHex(ctx.theme.surface1))
  drawRectOutline(rect.x, rect.y, rect.w, rect.h, 1.0, colorHex(ctx.theme.outlineVariant))
  let safeMax = maxInt(1, maxUnits)
  let step = maxInt(8, safeMax / 8)
  let minorStep = maxInt(2, step / 4)
  if horizontal:
    mut u = 0
    while u <= safeMax:
      let px = rect.x + (float(u) / float(safeMax)) * rect.w
      let isMajor = (u % step) == 0
      let tickH = if isMajor: rect.h * 0.55 else: rect.h * 0.28
      drawLine(px, rect.y + rect.h - tickH, px, rect.y + rect.h, colorHex(ctx.theme.textMuted), 1.0)
      if isMajor and px + 22.0 < rect.x + rect.w:
        drawText(str(u), px + 2.0, rect.y + 2.0, 0.62, colorHex(ctx.theme.textSecondary))
      u = u + minorStep
    if cursorUnit >= 0 and cursorUnit <= safeMax:
      let cx = rect.x + (float(cursorUnit) / float(safeMax)) * rect.w
      drawLine(cx, rect.y, cx, rect.y + rect.h, colorHex(ctx.theme.primary), 2.0)
  else:
    mut u = 0
    while u <= safeMax:
      let py = rect.y + (float(u) / float(safeMax)) * rect.h
      let isMajor = (u % step) == 0
      let tickW = if isMajor: rect.w * 0.55 else: rect.w * 0.28
      drawLine(rect.x + rect.w - tickW, py, rect.x + rect.w, py, colorHex(ctx.theme.textMuted), 1.0)
      if isMajor and py + 12.0 < rect.y + rect.h:
        drawText(str(u), rect.x + 2.0, py + 1.0, 0.60, colorHex(ctx.theme.textSecondary))
      u = u + minorStep
    if cursorUnit >= 0 and cursorUnit <= safeMax:
      let cy = rect.y + (float(cursorUnit) / float(safeMax)) * rect.h
      drawLine(rect.x, cy, rect.x + rect.w, cy, colorHex(ctx.theme.primary), 2.0)

/// Renders an Aseprite/Krita-style animation cel timeline strip (`1..frameCount`) with onion-skin indicator and returns the active frame index.
pub fn auraTimelineCelStrip(ctx: AuraContext, rect: AuraRect, frameCount: int, activeFrame: int, onionSkin: bool): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let count = maxInt(1, frameCount)
  mut chosen = clampInt(activeFrame, 0, count - 1)
  let pad = 4.0
  let gap = 4.0
  let cellW = maxFloat(22.0, (rect.w - pad * 2.0 - float(count - 1) * gap) / float(count))
  let cellH = maxFloat(16.0, rect.h - pad * 2.0)
  mut i = 0
  while i < count:
    let cx = rect.x + pad + float(i) * (cellW + gap)
    let cy = rect.y + pad
    let r = AuraRect(x = cx, y = cy, w = cellW, h = cellH)
    let isAct = (i == chosen)
    let isOnion = onionSkin and (i == chosen - 1 or i == chosen + 1)
    let bg = if isAct: ctx.theme.primaryContainer else: (if isOnion: ctx.theme.surface3 else: ctx.theme.surface1)
    let bdr = if isAct: ctx.theme.primary else: (if isOnion: ctx.theme.secondary else: ctx.theme.outlineVariant)
    drawRoundedRect(r.x, r.y, r.w, r.h, 3.0, colorHex(bg))
    drawRoundedRectOutline(r.x, r.y, r.w, r.h, 3.0, if isAct: 2.0 else: 1.0, colorHex(bdr))
    drawTextCentered("F" + str(i + 1), r.x + r.w * 0.5, r.y + (r.h - 11.0) * 0.5, 0.70, colorHex(if isAct: ctx.theme.onPrimary else: ctx.theme.textPrimary))
    if auraIsClicked(ctx, r):
      chosen = i
    i = i + 1
  ret chosen

/// Renders a translucent tactical automap overlay centered around `(playerX, playerY)` at `zoom`.
pub fn auraAutomapOverlay(ctx: AuraContext, rect: AuraRect, playerX: float, playerY: float, zoom: float): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 6.0, rgba(8, 16, 20, 150))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 6.0, 1.5, rgba(202, 138, 4, 190))
  let cx = rect.x + rect.w * 0.5
  let cy = rect.y + rect.h * 0.5
  let z = clampFloat(zoom, 0.5, 4.0)
  let step = maxFloat(8.0, 18.0 * z)
  let rawOffX = (playerX * z) % step
  let offX = clampFloat(if rawOffX < 0.0: rawOffX + step else: rawOffX, 0.0, step)
  let rawOffY = (playerY * z) % step
  let offY = clampFloat(if rawOffY < 0.0: rawOffY + step else: rawOffY, 0.0, step)
  mut gx = rect.x + 8.0 - offX
  mut gxSteps = 0
  while gx < rect.x + rect.w - 8.0 and gxSteps < 64:
    if gx > rect.x + 6.0:
      drawLine(gx, rect.y + 6.0, gx, rect.y + rect.h - 6.0, rgba(56, 189, 248, 42), 1.0)
    gx = gx + step
    gxSteps = gxSteps + 1
  mut gy = rect.y + 8.0 - offY
  mut gySteps = 0
  while gy < rect.y + rect.h - 8.0 and gySteps < 64:
    if gy > rect.y + 6.0:
      drawLine(rect.x + 6.0, gy, rect.x + rect.w - 6.0, gy, rgba(56, 189, 248, 42), 1.0)
    gy = gy + step
    gySteps = gySteps + 1
  drawLine(cx - 8.0, cy, cx + 8.0, cy, colorHex(0x22C55E), 1.5)
  drawLine(cx, cy - 8.0, cx, cy + 8.0, colorHex(0x22C55E), 1.5)
  drawCircle(cx, cy, 3.5, colorHex(0xFEF08A))

/// Renders a dual-series stacked area / line comparison chart over an explicit `[minVal, maxVal]` shared vertical domain.
pub fn auraStackedAreaChartDomain(ctx: AuraContext, rect: AuraRect, seriesA: [float], seriesB: [float], minVal: float, maxVal: float): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let span = maxFloat(1.0, maxVal - minVal)
  let pad = 8.0
  let plotW = maxFloat(10.0, rect.w - pad * 2.0)
  let plotH = maxFloat(10.0, rect.h - pad * 2.0)
  let nA = seriesA.len
  if nA >= 2:
    mut i = 0
    while i < nA - 1:
      let x1 = rect.x + pad + (float(i) / float(nA - 1)) * plotW
      let x2 = rect.x + pad + (float(i + 1) / float(nA - 1)) * plotW
      let y1 = rect.y + pad + plotH * (1.0 - clampFloat((seriesA[i] - minVal) / span, 0.0, 1.0))
      let y2 = rect.y + pad + plotH * (1.0 - clampFloat((seriesA[i + 1] - minVal) / span, 0.0, 1.0))
      drawLine(x1, y1, x2, y2, colorHex(ctx.theme.primary), 2.0)
      i = i + 1
  let nB = seriesB.len
  if nB >= 2:
    mut j = 0
    while j < nB - 1:
      let x1 = rect.x + pad + (float(j) / float(nB - 1)) * plotW
      let x2 = rect.x + pad + (float(j + 1) / float(nB - 1)) * plotW
      let y1 = rect.y + pad + plotH * (1.0 - clampFloat((seriesB[j] - minVal) / span, 0.0, 1.0))
      let y2 = rect.y + pad + plotH * (1.0 - clampFloat((seriesB[j + 1] - minVal) / span, 0.0, 1.0))
      drawLine(x1, y1, x2, y2, colorHex(ctx.theme.secondary), 2.0)
      j = j + 1

/// Renders a styled KaTeX display equation card (`$$...$$`) with header badge and centered mathematical typography.
pub fn auraKaTeXMathBlock(ctx: AuraContext, rect: AuraRect, latexExpr: str, caption: str): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.2, colorHex(ctx.theme.tertiary))
  drawRect(rect.x, rect.y, 4.0, rect.h, colorHex(ctx.theme.tertiary))
  drawText(if caption.len > 0: caption else: "KATEX DISPLAY EQUATION", rect.x + 12.0, rect.y + 6.0, 0.68, colorHex(ctx.theme.tertiary))
  drawTextCentered(truncateText(latexExpr, rect.w - 24.0, 0.90), rect.x + rect.w * 0.5, rect.y + rect.h * 0.52, 0.90, colorHex(ctx.theme.textPrimary))

/// Renders a bidirectional WikiLink / dependency graph around `centerLabel` with incoming (`inLabels`) and outgoing (`outLabels`) nodes.
pub fn auraBidirectionalGraph(ctx: AuraContext, rect: AuraRect, centerLabel: str, outLabels: [str], inLabels: [str]): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, colorHex(ctx.theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, ctx.theme.radiusSm, 1.0, colorHex(ctx.theme.outlineVariant))
  let cx = rect.x + rect.w * 0.5
  let cy = rect.y + rect.h * 0.5
  mut clickedIdx = -1
  mut i = 0
  while i < inLabels.len:
    let ny = rect.y + 20.0 + float(i) * 28.0
    let nr = AuraRect(x = rect.x + 10.0, y = ny, w = 84.0, h = 20.0)
    drawLine(nr.x + nr.w, nr.y + 10.0, cx - 44.0, cy, colorHex(ctx.theme.secondary), 1.5)
    drawRoundedRect(nr.x, nr.y, nr.w, nr.h, 4.0, colorHex(ctx.theme.surface2))
    drawRoundedRectOutline(nr.x, nr.y, nr.w, nr.h, 4.0, 1.0, colorHex(ctx.theme.secondary))
    drawTextCentered(truncateText(inLabels[i], 76.0, 0.66), nr.x + nr.w * 0.5, nr.y + 4.0, 0.66, colorHex(ctx.theme.textPrimary))
    if auraIsClicked(ctx, nr):
      clickedIdx = i
    i = i + 1
  mut j = 0
  while j < outLabels.len:
    let ny = rect.y + 20.0 + float(j) * 28.0
    let nr = AuraRect(x = rect.x + rect.w - 94.0, y = ny, w = 84.0, h = 20.0)
    drawLine(cx + 44.0, cy, nr.x, nr.y + 10.0, colorHex(ctx.theme.primary), 1.5)
    drawRoundedRect(nr.x, nr.y, nr.w, nr.h, 4.0, colorHex(ctx.theme.surface2))
    drawRoundedRectOutline(nr.x, nr.y, nr.w, nr.h, 4.0, 1.0, colorHex(ctx.theme.primary))
    drawTextCentered(truncateText(outLabels[j], 76.0, 0.66), nr.x + nr.w * 0.5, nr.y + 4.0, 0.66, colorHex(ctx.theme.textPrimary))
    if auraIsClicked(ctx, nr):
      clickedIdx = 100 + j
    j = j + 1
  drawRoundedRect(cx - 44.0, cy - 12.0, 88.0, 24.0, 5.0, colorHex(ctx.theme.primaryContainer))
  drawRoundedRectOutline(cx - 44.0, cy - 12.0, 88.0, 24.0, 5.0, 1.5, colorHex(ctx.theme.primary))
  drawTextCentered(truncateText(centerLabel, 80.0, 0.72), cx, cy - 5.0, 0.72, colorHex(ctx.theme.onPrimary))
  ret clickedIdx

/// Renders a tactical killfeed banner with headshot icon and multi-kill streak badge (`AuraDS 5.6`).
pub fn auraKillfeedBanner(ctx: AuraContext, rect: AuraRect, killer: str, weapon: str, victim: str, isHeadshot: bool, streakCount: int): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, rgba(10, 14, 22, 185))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.2, colorHex(if isHeadshot: 0xEF4444 else: ctx.theme.outlineVariant))
  let hsTag = if isHeadshot: " [HS]" else: ""
  let msg = killer + " [" + weapon + hsTag + "] " + victim
  drawText(truncateText(msg, rect.w - 48.0, 0.72), rect.x + 8.0, rect.y + (rect.h - 10.0) * 0.5, 0.72, colorHex(ctx.theme.textPrimary))
  if streakCount > 1:
    drawRoundedRect(rect.x + rect.w - 38.0, rect.y + 3.0, 32.0, rect.h - 6.0, 3.0, colorHex(0xF59E0B))
    drawTextCentered(str(streakCount) + "x", rect.x + rect.w - 22.0, rect.y + (rect.h - 10.0) * 0.5, 0.68, colorHex(0x0B0F19))

/// Renders a survival-horror / medical ECG heartbeat monitor with BPM readout and condition status (`AuraDS 5.6`).
pub fn auraECGHeartbeatMonitor(ctx: AuraContext, rect: AuraRect, bpm: int, conditionLabel: str, phase: float): void:
  auraECGStatusMonitor(ctx, rect, phase, if bpm > 120: 25.0 else: 85.0, conditionLabel)
  drawText(str(bpm) + " BPM", rect.x + rect.w - 58.0, rect.y + 6.0, 0.68, colorHex(ctx.theme.textSecondary))

/// Renders a horizontal or vertical thermal color-scale legend (`minTempK..maxTempK`) with live `currentTempK` marker (`AuraDS 5.6`).
pub fn auraThermalScaleLegend(ctx: AuraContext, rect: AuraRect, minTempK: float, maxTempK: float, currentTempK: float): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(ctx.theme.surface1))
  let stops = [0x1E3A8A, 0x06B6D4, 0x22C55E, 0xEAB308, 0xEF4444, 0xFFFBEB]
  let segW = (rect.w - 8.0) / float(stops.len)
  mut i = 0
  while i < stops.len:
    drawRect(rect.x + 4.0 + float(i) * segW, rect.y + 4.0, segW, rect.h - 8.0, colorHex(stops[i]))
    i += 1
  let span = maxFloat(1.0, maxTempK - minTempK)
  let t = clampFloat((currentTempK - minTempK) / span, 0.0, 1.0)
  let mx = rect.x + 4.0 + t * (rect.w - 8.0)
  drawLine(mx, rect.y + 1.0, mx, rect.y + rect.h - 1.0, colorHex(0xFFFFFF), 2.0)

/// Renders an orthogonal/angled skill-tree dependency connector with directional arrowhead (`AuraDS 5.6`).
pub fn auraHeroSkillTreeConnector(ctx: AuraContext, x1: float, y1: float, x2: float, y2: float, unlocked: bool): void:
  let col = colorHex(if unlocked: 0xFACC15 else: ctx.theme.outlineVariant)
  drawLine(x1, y1, x2, y2, col, if unlocked: 2.2 else: 1.2)
  drawCircle(x2, y2, 3.0, col)

/// Renders a socketed glyphword / gem stone badge with inner emissive rune glyph (`AuraDS 5.6`).
pub fn auraSocketedRuneBadge(ctx: AuraContext, cx: float, cy: float, radius: float, runeName: str, glowHex: int): void:
  drawCircle(cx, cy, radius, colorHex(ctx.theme.surface0))
  drawCircleOutline(cx, cy, radius, 1.5, colorHex(glowHex))
  drawCircle(cx, cy, radius * 0.65, rgba((glowHex / 65536) % 256, (glowHex / 256) % 256, glowHex % 256, 85))
  drawTextCentered(runeName, cx, cy - 4.0, 0.65, colorHex(0xFEF08A))

/// Renders a side-by-side Git diff minimap bar showing added (`+`) and removed (`-`) line markers (`AuraDS 5.6`).
pub fn auraSplitDiffMinimap(ctx: AuraContext, rect: AuraRect, addedLines: [int], removedLines: [int], totalLines: int, viewportRatio: float): void:
  drawRect(rect.x, rect.y, rect.w, rect.h, colorHex(ctx.theme.surface0))
  let safeTotal = maxInt(1, totalLines)
  mut i = 0
  while i < addedLines.len:
    let py = rect.y + (float(clampInt(addedLines[i], 0, safeTotal)) / float(safeTotal)) * rect.h
    drawRect(rect.x + rect.w * 0.5, py, rect.w * 0.5, 2.0, colorHex(0x22C55E))
    i += 1
  mut j = 0
  while j < removedLines.len:
    let py = rect.y + (float(clampInt(removedLines[j], 0, safeTotal)) / float(safeTotal)) * rect.h
    drawRect(rect.x, py, rect.w * 0.5, 2.0, colorHex(0xEF4444))
    j += 1
  let vh = clampFloat(viewportRatio, 0.08, 1.0) * rect.h
  drawRectOutline(rect.x + 1.0, rect.y + 1.0, rect.w - 2.0, vh, 1.0, colorHex(ctx.theme.primary))

/// Renders a UML / Mermaid `classDiagram` node box with class header, fields compartment, and methods compartment (`AuraDS 5.6`).
pub fn auraMermaidClassBox(ctx: AuraContext, rect: AuraRect, className: str, fields: [str], methods: [str]): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.2, colorHex(ctx.theme.primary))
  drawTextCentered(className, rect.x + rect.w * 0.5, rect.y + 5.0, 0.74, colorHex(ctx.theme.primary))
  drawLine(rect.x, rect.y + 20.0, rect.x + rect.w, rect.y + 20.0, colorHex(ctx.theme.outlineVariant), 1.0)
  mut y = rect.y + 24.0
  mut i = 0
  while i < fields.len and y + 12.0 < rect.y + rect.h:
    drawText(truncateText(fields[i], rect.w - 10.0, 0.64), rect.x + 5.0, y, 0.64, colorHex(ctx.theme.textSecondary))
    y += 12.0
    i += 1
  drawLine(rect.x, y + 2.0, rect.x + rect.w, y + 2.0, colorHex(ctx.theme.outlineVariant), 1.0)
  y += 6.0
  mut j = 0
  while j < methods.len and y + 12.0 < rect.y + rect.h:
    drawText(truncateText(methods[j], rect.w - 10.0, 0.64), rect.x + 5.0, y, 0.64, colorHex(ctx.theme.textPrimary))
    y += 12.0
    j += 1

/// Renders a Kanban stage-gate swimlane header with WIP limit indicator (`dealCount / wipLimit`) and stage value (`AuraDS 5.6`).
pub fn auraKanbanSwimlaneHeader(ctx: AuraContext, rect: AuraRect, title: str, dealCount: int, wipLimit: int, totalValueStr: str): void:
  let overWip = wipLimit > 0 and dealCount > wipLimit
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(ctx.theme.surface2))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.2, colorHex(if overWip: 0xEF4444 else: ctx.theme.outlineVariant))
  drawText(truncateText(title, rect.w * 0.55, 0.74), rect.x + 8.0, rect.y + 5.0, 0.74, colorHex(ctx.theme.textPrimary))
  let wipTxt = "WIP " + str(dealCount) + "/" + str(maxInt(1, wipLimit))
  drawText(wipTxt, rect.x + rect.w - 64.0, rect.y + 5.0, 0.66, colorHex(if overWip: 0xEF4444 else: ctx.theme.secondary))
  drawText(totalValueStr, rect.x + 8.0, rect.y + rect.h - 14.0, 0.66, colorHex(ctx.theme.textMuted))

/// Renders an animation onion-skin control pill (`prev/next` ghost tint + FPS + Play/Pause toggle) (`AuraDS 5.6`).
pub fn auraAnimationOnionSkin(ctx: AuraContext, rect: AuraRect, prevAlphaPct: int, nextAlphaPct: int, fps: int, playing: bool): bool:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.0, colorHex(ctx.theme.outlineVariant))
  let stateLbl = if playing: "PLAYING" else: "PAUSED"
  let txt = "ONION " + str(prevAlphaPct) + "%/" + str(nextAlphaPct) + "% | " + str(fps) + " FPS | " + stateLbl
  drawTextCentered(truncateText(txt, rect.w - 12.0, 0.68), rect.x + rect.w * 0.5, rect.y + (rect.h - 10.0) * 0.5, 0.68, colorHex(ctx.theme.textPrimary))
  ret if auraIsClicked(ctx, rect): not playing else: playing

/// Renders a spectator & match header HUD bar (`AuraDS 5.7`).
pub fn auraSpectatorHudBar(ctx: AuraContext, rect: AuraRect, mapName: str, roundTimeStr: str, ctScore: int, tScore: int, specTargetName: str, specWeapon: str, specViewers: int): void:
  drawRect(rect.x, rect.y, rect.w, rect.h, rgba(8, 10, 14, 215))
  drawLine(rect.x, rect.y + rect.h, rect.x + rect.w, rect.y + rect.h, colorHex(0xFFA000), 1.5)
  drawText(mapName + " | " + roundTimeStr + " | CT " + str(ctScore) + " : " + str(tScore) + " T", rect.x + 12.0, rect.y + 6.0, 0.72, colorHex(0xFFA000))
  drawTextRight("SPEC: " + specTargetName + " [" + specWeapon + "] | VIEWERS: " + str(specViewers), rect.x + rect.w - 12.0, rect.y + 6.0, 0.70, colorHex(ctx.theme.textPrimary))

pub fn auraRollWeightedModifiers(weights: [int], rollVal: int): int:
  mut total = 0
  for w in weights:
    total += maxInt(0, w)
  if total <= 0:
    ret 0
  let target = rollVal % total
  mut acc = 0
  mut idx = 0
  while idx < weights.len:
    acc += maxInt(0, weights[idx])
    if target < acc:
      ret idx
    idx += 1
  ret maxInt(0, weights.len - 1)

pub fn auraRollWeightedAffix(weights: [int], rollVal: int): int:
  ret auraRollWeightedModifiers(weights, rollVal)

pub fn auraCombineRecipeItems(ctx: AuraContext, rect: AuraRect, itemA: str, itemB: str, resultItem: str, combineReady: bool): bool:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.2, colorHex(if combineReady: 0x22C55E else: ctx.theme.outlineVariant))
  drawText(truncateText(itemA + " + " + itemB + " => " + resultItem, rect.w - 16.0, 0.70), rect.x + 8.0, rect.y + (rect.h - 10.0) * 0.5, 0.70, colorHex(if combineReady: 0x86EFAC else: ctx.theme.textSecondary))
  ret combineReady and auraIsClicked(ctx, rect)

pub fn auraItemCombineSlotStrip(ctx: AuraContext, rect: AuraRect, itemA: str, itemB: str, resultItem: str, combineReady: bool): bool:
  ret auraCombineRecipeItems(ctx, rect, itemA, itemB, resultItem, combineReady)

pub fn auraCanUnlockDagNode(nodeId: int, prereqIds: [int], unlockedMask: [bool]): bool:
  if nodeId < 0:
    ret false
  if prereqIds.len == 0:
    ret true
  mut i = 0
  while i < prereqIds.len:
    let pid = prereqIds[i]
    if pid >= 0 and pid < unlockedMask.len:
      if not unlockedMask[pid]:
        ret false
    i += 1
  ret true

pub fn auraRtsCanUnlockTech(nodeId: int, prereqIds: [int], unlockedMask: [bool]): bool:
  ret auraCanUnlockDagNode(nodeId, prereqIds, unlockedMask)

pub fn auraStepCellularGrid(grid: [int], w: int, h: int, ruleIndex: int): [int]:
  mut outGrid: [int] = []
  let total = w * h
  mut i = 0
  while i < total:
    outGrid.push(grid[i])
    i += 1
  mut y = h - 2
  while y >= 0:
    mut x = 0
    while x < w:
      let idx = y * w + x
      let cell = grid[idx]
      if cell > 0:
        let belowIdx = (y + 1) * w + x
        if outGrid[belowIdx] == 0:
          outGrid[belowIdx] = cell
          outGrid[idx] = 0
      x += 1
    y -= 1
  ret outGrid

pub fn auraSandStepGrid(grid: [int], w: int, h: int): [int]:
  ret auraStepCellularGrid(grid, w, h, 0)

pub fn auraApplyCellularRuleMatrix(srcCell: int, neighborSum: int, birthMask: int, surviveMask: int): int:
  if srcCell == 0:
    if (birthMask & (1 << neighborSum)) != 0:
      ret 1
    ret 0
  if (surviveMask & (1 << neighborSum)) != 0:
    ret srcCell
  ret 0

pub fn auraStepScalarFieldDiffusion(field: [float], w: int, h: int, rate: float): [float]:
  mut outField: [float] = []
  let total = w * h
  mut i = 0
  while i < total:
    outField.push(field[i])
    i += 1
  let r = clampFloat(rate, 0.0, 0.25)
  mut y = 1
  while y < h - 1:
    mut x = 1
    while x < w - 1:
      let idx = y * w + x
      let c = field[idx]
      let n = field[(y - 1) * w + x]
      let s = field[(y + 1) * w + x]
      let e = field[y * w + (x + 1)]
      let west = field[y * w + (x - 1)]
      let diff = (n + s + e + west) - 4.0 * c
      outField[idx] = c + r * diff
      x += 1
    y += 1
  ret outField

pub fn auraStampGridCircle(grid: [int], w: int, h: int, cx: int, cy: int, radius: int, val: int): [int]:
  mut outGrid: [int] = []
  let total = w * h
  mut i = 0
  while i < total:
    outGrid.push(grid[i])
    i += 1
  let r = maxInt(0, radius)
  let r2 = r * r
  mut dy = -r
  while dy <= r:
    let gy = cy + dy
    if gy >= 0 and gy < h:
      mut dx = -r
      while dx <= r:
        let gx = cx + dx
        if gx >= 0 and gx < w:
          if dx * dx + dy * dy <= r2:
            outGrid[gy * w + gx] = val
        dx += 1
    dy += 1
  ret outGrid

pub fn auraSandStampCircle(grid: [int], w: int, h: int, cx: int, cy: int, radius: int, val: int): [int]:
  ret auraStampGridCircle(grid, w, h, cx, cy, radius, val)

/// Renders a Newtonian gravity field telemetry overlay badge (`activeWells`, `maxForceG`) (`AuraDS 5.7`).
pub fn auraGravityFieldOverlay(ctx: AuraContext, rect: AuraRect, activeWells: int, maxForceG: float, newtonianMode: bool): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, rgba(12, 16, 28, 200))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.0, colorHex(if newtonianMode: 0xA855F7 else: ctx.theme.outlineVariant))
  let modeStr = if newtonianMode: "N-BODY ON" else: "VERTICAL G"
  drawText("GRAV: " + modeStr + " | Wells:" + str(activeWells) + " | Max:" + str(int(maxForceG * 10.0)) + "dG", rect.x + 8.0, rect.y + (rect.h - 10.0) * 0.5, 0.68, colorHex(0xE9D5FF))

/// Renders an RTS tech-tree tier progression card (`Tier 1..3`) with progress bar (`AuraDS 5.7`).
pub fn auraTechTreeTierCard(ctx: AuraContext, rect: AuraRect, tierLevel: int, tierName: str, prereqText: str, progressPct: int): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.2, colorHex(0xFACC15))
  drawText("T" + str(tierLevel) + ": " + truncateText(tierName, rect.w - 40.0, 0.72), rect.x + 8.0, rect.y + 4.0, 0.72, colorHex(0xFEF08A))
  drawText(truncateText(prereqText, rect.w - 16.0, 0.64), rect.x + 8.0, rect.y + 18.0, 0.64, colorHex(ctx.theme.textMuted))
  let ratio = clampFloat(float(progressPct) / 100.0, 0.0, 1.0)
  drawRect(rect.x + 8.0, rect.y + rect.h - 8.0, (rect.w - 16.0) * ratio, 4.0, colorHex(0x22C55E))

/// Renders an ARPG Mercenary companion equipment paperdoll card (`Helm`, `Armor`, `Weapon`, `Aura`) (`AuraDS 5.7`).
pub fn auraMercenaryEquipPaperdoll(ctx: AuraContext, rect: AuraRect, mercName: str, mercClass: str, helmName: str, armorName: str, weaponName: str, auraName: str): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 5.0, rgba(16, 14, 12, 220))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 5.0, 1.4, colorHex(0xCA8A04))
  drawText(mercName + " (" + mercClass + ")", rect.x + 8.0, rect.y + 5.0, 0.72, colorHex(0xFEF08A))
  drawText("Helm: " + helmName + " | Armor: " + armorName, rect.x + 8.0, rect.y + 20.0, 0.64, colorHex(ctx.theme.textSecondary))
  drawText("Wep: " + weaponName + " | Aura: " + auraName, rect.x + 8.0, rect.y + 33.0, 0.64, colorHex(0x38BDF8))

/// Renders a multi-stage Sankey pipeline conversion flow strip (`AuraDS 5.7`).
pub fn auraSankeyConversionFlow(ctx: AuraContext, rect: AuraRect, stageNames: [str], stageValues: [int], conversionPcts: [int]): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(ctx.theme.surface0))
  let n = maxInt(1, stageNames.len)
  let stepW = (rect.w - 16.0) / float(n)
  mut i = 0
  while i < stageNames.len and i < stageValues.len:
    let sx = rect.x + 8.0 + float(i) * stepW
    let pct = if i < conversionPcts.len: conversionPcts[i] else: 100
    drawRoundedRect(sx, rect.y + 6.0, stepW - 6.0, rect.h - 12.0, 3.0, colorHex(ctx.theme.surface2))
    drawText(truncateText(stageNames[i], stepW - 10.0, 0.64), sx + 4.0, rect.y + 9.0, 0.64, colorHex(ctx.theme.textPrimary))
    drawText(str(pct) + "%", sx + 4.0, rect.y + rect.h - 16.0, 0.62, colorHex(ctx.theme.secondary))
    i += 1

/// Renders a Mermaid `sequenceDiagram` participant lifeline & message arrow row (`AuraDS 5.7`).
pub fn auraMermaidSequenceLifeline(ctx: AuraContext, rect: AuraRect, actorA: str, actorB: str, msgLabel: str, isAsync: bool, activationDepth: int): void:
  let xA = rect.x + 36.0
  let xB = rect.x + rect.w - 36.0
  let midY = rect.y + rect.h * 0.55
  drawLine(xA, rect.y + 4.0, xA, rect.y + rect.h - 4.0, colorHex(ctx.theme.outlineVariant), 1.2)
  drawLine(xB, rect.y + 4.0, xB, rect.y + rect.h - 4.0, colorHex(ctx.theme.outlineVariant), 1.2)
  drawLine(xA, midY, xB, midY, colorHex(if isAsync: ctx.theme.secondary else: ctx.theme.primary), 1.6)
  drawCircle(xB, midY, 2.5 + float(clampInt(activationDepth, 0, 2)), colorHex(ctx.theme.primary))
  drawTextCentered(actorA + " -> " + actorB + ": " + msgLabel, rect.x + rect.w * 0.5, rect.y + 4.0, 0.66, colorHex(ctx.theme.textPrimary))

/// Renders a fuzzy-search Command Palette modal list with right-aligned keybinding pills (`AuraDS 5.7`).
pub fn auraCommandPaletteModal(ctx: AuraContext, rect: AuraRect, queryStr: str, items: [str], shortcuts: [str], selectedIdx: int): int:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 6.0, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 6.0, 1.5, colorHex(ctx.theme.primary))
  drawText("> " + queryStr, rect.x + 12.0, rect.y + 8.0, 0.76, colorHex(ctx.theme.textPrimary))
  mut chosen = selectedIdx
  mut i = 0
  while i < items.len and i < 6:
    let ry = rect.y + 28.0 + float(i) * 22.0
    let rRow = AuraRect(x = rect.x + 6.0, y = ry, w = rect.w - 12.0, h = 20.0)
    if i == selectedIdx:
      drawRoundedRect(rRow.x, rRow.y, rRow.w, rRow.h, 3.0, colorHex(ctx.theme.primaryContainer))
    drawText(truncateText(items[i], rect.w - 88.0, 0.68), rRow.x + 6.0, rRow.y + 4.0, 0.68, colorHex(ctx.theme.textPrimary))
    if i < shortcuts.len:
      drawTextRight(shortcuts[i], rRow.x + rRow.w - 6.0, rRow.y + 4.0, 0.64, colorHex(ctx.theme.textMuted))
    if auraIsClicked(ctx, rRow):
      chosen = i
    i += 1
  ret chosen

/// Renders a cubic Bezier vector path inspector showing control-handle coordinates `(C1, C2)` (`AuraDS 5.7`).
pub fn auraBezierPathInspector(ctx: AuraContext, rect: AuraRect, nodeCount: int, c1x: float, c1y: float, c2x: float, c2y: float, closedPath: bool): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(ctx.theme.surface1))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.0, colorHex(ctx.theme.outlineVariant))
  let tag = if closedPath: "CLOSED" else: "OPEN"
  drawText("BEZIER [" + tag + " | " + str(nodeCount) + " pts] C1(" + str(int(c1x)) + "," + str(int(c1y)) + ") C2(" + str(int(c2x)) + "," + str(int(c2y)) + ")", rect.x + 8.0, rect.y + (rect.h - 10.0) * 0.5, 0.66, colorHex(ctx.theme.textSecondary))

/// Renders a tactical radar minimap widget with hostile/friendly contact counters (`AuraDS 5.8`).
pub fn auraTacticalRadarMinimap(x: float, y: float, r: float, angleDeg: float, hostiles: int, friendlies: int): void:
  let rad = if r < 16.0: 48.0 else: r
  drawCircle(x, y, rad, rgba(6, 22, 14, 195))
  drawCircleOutline(x, y, rad, 1.8, colorHex(0x22C55E))
  drawCircleOutline(x, y, rad * 0.55, 1.0, rgba(34, 197, 94, 110))
  let ang = angleDeg * 0.0174533
  drawLine(x, y, x + cos(ang) * rad, y + sin(ang) * rad, colorHex(0x4ADE80), 1.8)
  drawText("F:" + str(friendlies) + " H:" + str(hostiles), x - rad * 0.65, y + rad + 4.0, 0.64, colorHex(0x86EFAC))

/// Renders a survival-horror puzzle wire circuit junction box with voltage gauge (`AuraDS 5.8`).
pub fn auraPuzzleWireCircuitBox(x: float, y: float, w: float, h: float, title: str, voltagePct: int, solved: bool): void:
  drawRoundedRect(x, y, w, h, 4.0, rgba(16, 20, 28, 225))
  let rimCol = if solved: colorHex(0x22C55E) else: colorHex(0xF59E0B)
  drawRoundedRectOutline(x, y, w, h, 4.0, 1.4, rimCol)
  let st = if solved: "SOLVED" else: "ACTIVE"
  drawText(title + " [" + str(voltagePct) + "%V | " + st + "]", x + 8.0, y + 6.0, 0.68, rimCol)
  let ratio = clampFloat(float(voltagePct) / 100.0, 0.0, 1.0)
  drawRect(x + 8.0, y + h - 8.0, (w - 16.0) * ratio, 4.0, rimCol)

