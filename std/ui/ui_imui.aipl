  let _t = ctx.theme
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(0x111827))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.0, colorHex(0x8B5CF6))
  drawSubpixelAASpan(rect.x + 8.0, rect.y + rect.h - 5.0, maxFloat(24.0, rect.w * 0.56), 2.5, 0.90, 0x8B5CF6, 0x111827)
  drawText("SM-2 Due:" + str(dueCount) + " EF:" + str(efScoreX100 / 100) + "." + str(efScoreX100 % 100) + " | Deck Slide " + str(slideIdx) + "/" + str(totalSlides), rect.x + 8.0, rect.y + 4.0, 0.62, colorHex(0xEDE9FE))
  ret dueCount

pub fn auraHttpScratchpadStatusCard(ctx: AuraContext, rect: AuraRect, methodLabel: str, statusCode: int, latencyMs: int, crdtPeers: int): int:
  let _t = ctx.theme
  let colHex = if statusCode >= 200 and statusCode < 300: 0x22C55E elif statusCode >= 400: 0xEF4444 else: 0x38BDF8
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(0x0F172A))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.0, colorHex(colHex))
  drawSubpixelAASpan(rect.x + 8.0, rect.y + rect.h - 5.0, maxFloat(24.0, rect.w * 0.52), 2.5, 0.90, colHex, 0x0F172A)
  drawText("HTTP [" + methodLabel + "] " + str(statusCode) + " (" + str(latencyMs) + "ms) | CRDT Peers:" + str(crdtPeers), rect.x + 8.0, rect.y + 4.0, 0.62, colorHex(0xE0F2FE))
  ret statusCode

pub fn auraPbrNormalMapPreviewCard(ctx: AuraContext, rect: AuraRect, wrapModeOn: bool, sobelStrengthX10: int, lightAzimuthDeg: int): int:
  let _t = ctx.theme
  let wrapTag = if wrapModeOn: "3x3 WRAP ON" else: "WRAP OFF"
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(0x18181B))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.0, colorHex(0xEC4899))
  drawParticleRibbonTrail(rect.x + 10.0, rect.y + rect.h - 5.0, rect.x + rect.w * 0.58, rect.y + rect.h - 5.0, 1.2, 2.6, 0xEC4899)
  drawText("PBR [" + wrapTag + "] Sobel:" + str(sobelStrengthX10 / 10) + "." + str(sobelStrengthX10 % 10) + " | Light:" + str(lightAzimuthDeg) + "deg", rect.x + 8.0, rect.y + 4.0, 0.62, colorHex(0xFCE7F3))
  ret lightAzimuthDeg

