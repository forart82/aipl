// §5. Public Operations / Methods
// ============================================================================

pub fn auraDrawButtonSimple(rect: AuraRect, label: str, theme: AuraTheme, isHovered: bool): bool:
  let bg = if isHovered: theme.primaryContainer else: theme.surface1
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, theme.radiusMd, colorHex(bg))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, theme.radiusMd, 1.0, colorHex(theme.outline))
  drawTextCentered(label, rect.x + rect.w * 0.5, rect.y + rect.h * 0.5 - 6.0, 14, colorHex(theme.textPrimary))
  ret isHovered

pub fn auraDrawCardSimple(rect: AuraRect, title: str, theme: AuraTheme): void:
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, theme.radiusLg, colorHex(theme.surface0))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, theme.radiusLg, 1.0, colorHex(theme.outlineVariant))
  drawText(title, rect.x + 12.0, rect.y + 12.0, 16, colorHex(theme.textPrimary))
