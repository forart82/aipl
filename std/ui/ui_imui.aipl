pub fn auraDemoTimelineScrubberBar(ctx: AuraContext, rect: AuraRect, demoName: str, curTick: int, maxTick: int, speedMult: str): int:
  let _t = ctx.theme
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(0x0F172A))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.0, colorHex(0x38BDF8))
  let denom = if maxTick > 0: maxTick else: 1
  let ratio = clampFloat(float(curTick) / float(denom), 0.0, 1.0)
  let barW = maxFloat(40.0, rect.w - 16.0)
  drawSubpixelAASpan(rect.x + 8.0, rect.y + rect.h - 6.0, barW * ratio, 3.0, 0.92, 0x38BDF8, 0x1E293B)
  drawText("DEMO [" + demoName + "] " + str(curTick) + "/" + str(maxTick) + " (" + speedMult + ")", rect.x + 8.0, rect.y + 4.0, 0.64, colorHex(0xE0F2FE))
  ret curTick

pub fn auraEcgVitalMonitorStrip(ctx: AuraContext, rect: AuraRect, statusLabel: str, bpm: int, poisonFlag: int): int:
  let _t = ctx.theme
  let colHex = if poisonFlag != 0: 0xA855F7 elif bpm > 110: 0xEF4444 elif bpm > 85: 0xF59E0B else: 0x22C55E
  drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 4.0, colorHex(0x091410))
  drawRoundedRectOutline(rect.x, rect.y, rect.w, rect.h, 4.0, 1.0, colorHex(colHex))
  drawParticleRibbonTrail(rect.x + 8.0, rect.y + rect.h * 0.65, rect.x + rect.w * 0.45, rect.y + rect.h * 0.35, 1.2, 2.6, colHex)
  let tag = if poisonFlag != 0: statusLabel + " [POISON]" else: statusLabel
  drawText("ECG " + tag + " | " + str(bpm) + " BPM", rect.x + 8.0, rect.y + 4.0, 0.64, colorHex(0xDCFCE7))
  ret bpm

