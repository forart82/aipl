// =============================================================================
// Generic Reusable Waveform Plot, Dual-Badge Status HUD & AuraFileDialog Modal
// =============================================================================

/// Generic reusable 2D waveform trace plot over normalized `[-1.0..1.0]` or `[0.0..1.0]` samples.
pub fn auraWaveformPlot(x: float, y: float, w: float, h: float, samples: [float], accentHex: int, bgHex: int): int:
  let fx = float(x)
  let fy = float(y)
  let fw = float(w)
  let fh = float(h)
  drawRoundedRect(fx, fy, fw, fh, 4.0, colorHex(bgHex))
  drawRoundedRectOutline(fx, fy, fw, fh, 4.0, 1.0, colorHex(accentHex))
  let n = samples.len
  if n >= 2:
    let stepX = (fw - 8.0) / float(n - 1)
    let midY = fy + fh * 0.5
    let amp = (fh - 6.0) * 0.45
    mut i = 0
    while i < n - 1:
      let x0 = fx + 4.0 + float(i) * stepX
      let y0 = midY - clampFloat(samples[i], -1.0, 1.0) * amp
      let x1 = fx + 4.0 + float(i + 1) * stepX
      let y1 = midY - clampFloat(samples[i + 1], -1.0, 1.0) * amp
      drawLine(x0, y0, x1, y1, colorHex(accentHex), 1.5)
      i += 1
  ret n

/// Generic reusable dual-badge status HUD bar replacing domain-specific boilerplate.
pub fn auraDualBadgeStatusHud(x: float, y: float, w: float, h: float, leftLabel: str, leftValue: str, rightLabel: str, rightValue: str, accentHex: int, bgHex: int, textHex: int, useRibbon: bool): int:
  let fx = float(x)
  let fy = float(y)
  let fw = float(w)
  let fh = float(h)
  drawRoundedRect(fx, fy, fw, fh, 4.0, colorHex(bgHex))
  drawRoundedRectOutline(fx, fy, fw, fh, 4.0, 1.0, colorHex(accentHex))
  if useRibbon:
    drawParticleRibbonTrail(fx + 10.0, fy + fh - 5.0, fx + fw * 0.5, fy + fh - 5.0, 1.3, 2.7, accentHex)
  else:
    drawSubpixelAASpan(fx + 8.0, fy + fh - 5.0, maxFloat(24.0, fw * 0.5), 2.5, 0.90, accentHex, bgHex)
  drawText(leftLabel + " [" + str(leftValue) + "] | " + rightLabel + ": " + str(rightValue), fx + 8.0, fy + 4.0, 0.62, colorHex(textHex))
  ret 1

pub enum FileDialogMode:
  Open
  Save
  SelectFolder

pub struct AuraFileDialogState(isOpen: bool, currentDir: str, selectedPath: str, fileNameInput: str, extensionFilter: str, entries: [str], breadcrumbs: [str], confirmed: bool, cancelled: bool, scrollOffset: float, sortAscending: bool = true, confirmOverwrite: bool = false)

fn auraMergeSortStrings(arr: [str], ascending: bool): [str]:
  let n = arr.len
  if n <= 1:
    ret arr.clone()
  mut src = arr.clone()
  mut dst = arr.clone()
  mut width = 1
  while width < n:
    mut i = 0
    while i < n:
      let left = i
      let mid = if i + width < n: i + width else: n
      let right = if i + width * 2 < n: i + width * 2 else: n
      mut l = left
      mut r = mid
      mut k = left
      while k < right:
        mut takeLeft = false
        if l < mid:
          if r >= right:
            takeLeft = true
          elif ascending:
            takeLeft = src[l] <= src[r]
          else:
            takeLeft = src[l] >= src[r]
        if takeLeft:
          dst[k] = src[l]
          l += 1
        else:
          dst[k] = src[r]
          r += 1
        k += 1
      i += width * 2
    let tmp = src
    src = dst
    dst = tmp
    width *= 2
  ret src

/// Sorts directory entries with directories first (`/`), then lexicographically in O(N log N) time.
pub fn auraFileDialogSortEntries(entries: [str], ascending: bool): [str]:
  mut dirs: [str] = []
  mut files: [str] = []
  mut i = 0
  while i < entries.len:
    let e = entries[i]
    if e.endsWith("/"):
      dirs.push(e)
    else:
      files.push(e)
    i += 1
  let sortedDirs = auraMergeSortStrings(dirs, ascending)
  let sortedFiles = auraMergeSortStrings(files, ascending)
  mut out: [str] = []
  mut k = 0
  while k < sortedDirs.len:
    out.push(sortedDirs[k])
    k += 1
  mut m = 0
  while m < sortedFiles.len:
    out.push(sortedFiles[m])
    m += 1
  ret out

/// Splits a directory path into navigable breadcrumb segments.
pub fn auraFileDialogSplitBreadcrumbs(dirPath: str): [str]:
  let norm = dirPath.replace("\\", "/")
  let raw = norm.split("/")
  mut out: [str] = []
  mut i = 0
  while i < raw.len:
    let seg = raw[i].trim()
    if seg.len > 0:
      out.push(seg)
    i += 1
  if out.len == 0:
    out.push("/")
  ret out

/// Filters directory entry names by extension filter (e.g. `".aipl"` or `".aipl,.json"` or `"*"`).
pub fn auraFileDialogFilterEntries(entries: [str], extFilter: str): [str]:
  let filt = extFilter.trim()
  if filt.len == 0 or filt == "*" or filt == "*.*":
    ret entries
  let exts = filt.split(",")
  mut out: [str] = []
  mut i = 0
  while i < entries.len:
    let ent = entries[i]
    if ent.endsWith("/"):
      out.push(ent)
    else:
      mut matched = false
      mut j = 0
      while j < exts.len:
        let pat = exts[j].trim().replace("*", "")
        if pat.len == 0 or ent.endsWith(pat):
          matched = true
        j += 1
      if matched:
        out.push(ent)
    i += 1
  ret out

/// Navigates one directory level up from `dirPath`.
pub fn auraFileDialogNavigateUp(dirPath: str): str:
  let crumbs = auraFileDialogSplitBreadcrumbs(dirPath)
  if crumbs.len <= 1:
    ret "/"
  mut parentParts: [str] = []
  mut i = 0
  while i < crumbs.len - 1:
    parentParts.push(crumbs[i])
    i += 1
  let prefix = if dirPath.startsWith("/"): "/" else: ""
  ret prefix + parentParts.join("/")

/// /// Loads real OS directory entries (directories suffixed with `/`, plus files) into `state.entries`.
pub fn auraFileDialogLoadOsDir(mut state: AuraFileDialogState): AuraFileDialogState:
  mut dir = if state.currentDir.len > 0: state.currentDir else: "."
  if not isDir(dir):
    if isDir("../" + dir):
      dir = "../" + dir
    elif isDir("../../" + dir):
      dir = "../../" + dir
    else:
      ret state
  let rawNames = listDir(dir)
  mut loaded: [str] = []
  let sep = if dir.endsWith("/"): "" else: "/"
  mut i = 0
  while i < rawNames.len:
    let name = rawNames[i]
    if name != "." and name != "..":
      let fullPath = dir + sep + name
      if isDir(fullPath):
        loaded.push(name + "/")
      else:
        loaded.push(name)
    i += 1
  state.currentDir = dir
  state.entries = loaded
  state.breadcrumbs = auraFileDialogSplitBreadcrumbs(state.currentDir)
  ret state

/// POSIX single-quote shell escaping for arguments interpolated into shell command lines.
pub fn auraShellQuote(s: str): str:
  ret "'" + s.replace("'", "'\\''") + "'"

/// Opens the native OS File Open Dialog box (via zenity/kdialog on Linux, or deterministic mock/directory fallback in headless mode)
/// and returns the selected file path (or `""` if cancelled).
pub fn auraOpenOsFileDialog(title: str, initialDir: str, extensionFilter: str): str:
  let mockPath = "/tmp/aipl_os_file_dialog_mock.txt"
  if isHeadlessMode() and fileExists(mockPath):
    let mocked = readFile(mockPath).trim()
    if mocked.len > 0:
      ret mocked
  mut startDir = if initialDir.len > 0: initialDir else: cwd()
  if not isDir(startDir):
    if isDir("../" + startDir):
      startDir = "../" + startDir
    elif isDir("../../" + startDir):
      startDir = "../../" + startDir
  let safeTitle = if title.len > 0: title else: "Open File"
  let sep = if startDir.endsWith("/"): "" else: "/"
  if isHeadlessMode():
    if isDir(startDir):
      let names = listDir(startDir)
      let filtered = auraFileDialogSortEntries(auraFileDialogFilterEntries(names, extensionFilter), true)
      mut i = 0
      while i < filtered.len:
        if not filtered[i].endsWith("/"):
          ret startDir + sep + filtered[i]
        i += 1
    ret ""
  if fileExists("/usr/bin/zenity"):
    mut filterArg = ""
    if extensionFilter.len > 0 and extensionFilter != "*" and extensionFilter != "*.*":
      let cleanExt = extensionFilter.trim()
      let pat = if cleanExt.startsWith("*"): cleanExt else: "*" + cleanExt
      filterArg = " --file-filter=" + auraShellQuote(pat)
    let cmd = "/usr/bin/zenity --file-selection --title=" + auraShellQuote(safeTitle) + " --filename=" + auraShellQuote(startDir + sep) + filterArg + " 2>/dev/null"
    // execCommand(cmd, []) runs the command line through the shell; a cancelled dialog exits non-zero
    let dlgRes = execCommand(cmd, [])
    if dlgRes.isOk() and dlgRes.unwrap().status == 0:
      ret dlgRes.unwrap().stdout.trim()
    ret ""
  if fileExists("/usr/bin/kdialog"):
    let cmd = "/usr/bin/kdialog --getopenfilename " + auraShellQuote(startDir) + " 2>/dev/null"
    // execCommand(cmd, []) runs the command line through the shell; a cancelled dialog exits non-zero
    let dlgRes = execCommand(cmd, [])
    if dlgRes.isOk() and dlgRes.unwrap().status == 0:
      ret dlgRes.unwrap().stdout.trim()
    ret ""
  ret ""

/// Initializes a new `AuraFileDialogState` for `auraFileDialog` and populates real OS directory entries.
pub fn auraFileDialogStateNew(initialDir: str, extensionFilter: str): AuraFileDialogState:
  let dir = if initialDir.len > 0: initialDir else: "/"
  mut st = AuraFileDialogState(
    isOpen = true,
    currentDir = dir,
    selectedPath = "",
    fileNameInput = "",
    extensionFilter = extensionFilter,
    entries = [],
    breadcrumbs = auraFileDialogSplitBreadcrumbs(dir),
    confirmed = false,
    cancelled = false,
    scrollOffset = 0.0,
    sortAscending = true,
    confirmOverwrite = false
  )
  st = auraFileDialogLoadOsDir(st)
  ret st

/// Renders and updates a self-contained AuraDS File Picker Modal (`Open`, `Save`, or `SelectFolder`)
/// with real OS directory navigation, native OS dialog bridge, breadcrumbs, sorting, new folder creation, and overwrite confirmation.
pub fn auraFileDialog(mut state: AuraFileDialogState, mode: FileDialogMode): AuraFileDialogState:
  if not state.isOpen:
    ret state
  if state.entries.len == 0 and isDir(state.currentDir):
    state = auraFileDialogLoadOsDir(state)
  state.breadcrumbs = auraFileDialogSplitBreadcrumbs(state.currentDir)
  let rawFiltered = auraFileDialogFilterEntries(state.entries, state.extensionFilter)
  let filtered = auraFileDialogSortEntries(rawFiltered, state.sortAscending)
  let modalX = 120.0
  let modalY = 70.0
  let modalW = 560.0
  let modalH = 380.0
  drawRoundedRect(modalX, modalY, modalW, modalH, 12.0, colorHex(0x111827))
  drawRoundedRectOutline(modalX, modalY, modalW, modalH, 12.0, 2.0, colorHex(0x00F5D4))
  let modeTitle = match mode:
    Open => "Open File"
    Save => "Save File"
    SelectFolder => "Select Folder"
  drawText(modeTitle + " — " + state.currentDir, modalX + 16.0, modalY + 14.0, 0.90, colorHex(0xF8FAFC))

  // Native OS File Dialog launcher button
  drawRoundedRect(modalX + modalW - 248.0, modalY + 10.0, 84.0, 24.0, 4.0, colorHex(0x1E3A8A))
  drawText("OS Dialog...", modalX + modalW - 240.0, modalY + 16.0, 0.72, colorHex(0x93C5FD))
  if isRectClicked(modalX + modalW - 248.0, modalY + 10.0, 84.0, 24.0):
    let osChosen = auraOpenOsFileDialog(modeTitle, state.currentDir, state.extensionFilter)
    if osChosen.len > 0:
      state.selectedPath = osChosen
      let slashParts = osChosen.replace("\\", "/").split("/")
      if slashParts.len > 0:
        state.fileNameInput = slashParts[slashParts.len - 1]
      state.confirmed = true
      state.confirmOverwrite = false
      state.isOpen = false
      ret state

  // Sort & New Folder toolbar buttons
  drawRoundedRect(modalX + modalW - 156.0, modalY + 10.0, 64.0, 24.0, 4.0, colorHex(0x1E293B))
  drawText(if state.sortAscending: "A-Z" else: "Z-A", modalX + modalW - 138.0, modalY + 16.0, 0.75, colorHex(0x38BDF8))
  if isRectClicked(modalX + modalW - 156.0, modalY + 10.0, 64.0, 24.0):
    state.sortAscending = not state.sortAscending

  drawRoundedRect(modalX + modalW - 84.0, modalY + 10.0, 68.0, 24.0, 4.0, colorHex(0x1E293B))
  drawText("+ Folder", modalX + modalW - 76.0, modalY + 16.0, 0.75, colorHex(0x22C55E))
  if isRectClicked(modalX + modalW - 84.0, modalY + 10.0, 68.0, 24.0):
    state.entries.push("new_folder/")

  // Breadcrumb bar + Up button
  let upClicked = isRectClicked(modalX + 16.0, modalY + 42.0, 48.0, 24.0)
  drawRoundedRect(modalX + 16.0, modalY + 42.0, 48.0, 24.0, 4.0, colorHex(0x1E293B))
  drawText(".. Up", modalX + 22.0, modalY + 48.0, 0.75, colorHex(0x38BDF8))
  if upClicked:
    state.currentDir = auraFileDialogNavigateUp(state.currentDir)
    state = auraFileDialogLoadOsDir(state)

  mut bcX = modalX + 72.0
  mut bi = 0
  while bi < state.breadcrumbs.len:
    let seg = state.breadcrumbs[bi]
    let segW = maxFloat(36.0, measureTextWidthPx(seg, 0.75) + 14.0)
    drawRoundedRect(bcX, modalY + 42.0, segW, 24.0, 4.0, colorHex(0x1E293B))
    drawText(seg, bcX + 7.0, modalY + 48.0, 0.75, colorHex(0xCBD5E1))
    if isRectClicked(bcX, modalY + 42.0, segW, 24.0):
      mut navParts: [str] = []
      mut bj = 0
      while bj <= bi:
        navParts.push(state.breadcrumbs[bj])
        bj += 1
      let prefix = if state.currentDir.startsWith("/"): "/" else: ""
      state.currentDir = prefix + navParts.join("/")
      state = auraFileDialogLoadOsDir(state)
    bcX += segW + 6.0
    bi += 1

  // File list area
  let listX = modalX + 16.0
  let listY = modalY + 74.0
  let listW = modalW - 32.0
  let listH = 216.0
  drawRoundedRect(listX, listY, listW, listH, 6.0, colorHex(0x0B0F19))
  let wy = mouseWheelY()
  if wy != 0.0 and isMouseInRect(listX, listY, listW, listH):
    let maxScroll = float(maxInt(0, filtered.len - 8))
    state.scrollOffset = clampFloat(state.scrollOffset - wy, 0.0, maxScroll)
  let startIdx = maxInt(0, int(state.scrollOffset))
  mut ei = 0
  while (startIdx + ei) < filtered.len and ei < 8:
    let ent = filtered[startIdx + ei]
    let rowY = listY + 6.0 + float(ei) * 25.0
    let isSel = state.fileNameInput == ent
    if isSel:
      drawRoundedRect(listX + 4.0, rowY, listW - 8.0, 22.0, 4.0, colorHex(0x312E81))
    if isRectClicked(listX + 4.0, rowY, listW - 8.0, 22.0):
      if ent.endsWith("/"):
        let cleanEnt = ent.slice(0, ent.len - 1)
        state.currentDir = if state.currentDir.endsWith("/"): state.currentDir + cleanEnt else: state.currentDir + "/" + cleanEnt
        state.scrollOffset = 0.0
        state = auraFileDialogLoadOsDir(state)
      else:
        let wasSelected = state.fileNameInput == ent
        state.fileNameInput = ent
        state.confirmOverwrite = false
        let isOpenMode = match mode:
          Open => true
          _ => false
        if isOpenMode and (isMouseDoubleClicked() or wasSelected):
          let sep = if state.currentDir.endsWith("/"): "" else: "/"
          state.selectedPath = state.currentDir + sep + ent
          state.confirmed = true
          state.isOpen = false
          ret state
    drawText(ent, listX + 12.0, rowY + 4.0, 0.80, colorHex(0xF8FAFC))
    ei += 1

  // Filename & filter footer
  let footerMsg = if state.confirmOverwrite: "Overwrite '" + state.fileNameInput + "'? Click Save again to confirm" else: "File: " + state.fileNameInput + "  (Filter: " + state.extensionFilter + ")"
  drawText(footerMsg, modalX + 16.0, modalY + 302.0, 0.80, colorHex(if state.confirmOverwrite: 0xF59E0B else: 0x94A3B8))

  // Cancel & Confirm buttons
  drawRoundedRect(modalX + modalW - 196.0, modalY + modalH - 42.0, 84.0, 28.0, 6.0, colorHex(0x334155))
  drawText("Cancel", modalX + modalW - 174.0, modalY + modalH - 34.0, 0.80, colorHex(0xF8FAFC))
  if isRectClicked(modalX + modalW - 196.0, modalY + modalH - 42.0, 84.0, 28.0) or isKeyPressed("Escape"):
    state.cancelled = true
    state.confirmOverwrite = false
    state.isOpen = false

  drawRoundedRect(modalX + modalW - 100.0, modalY + modalH - 42.0, 84.0, 28.0, 6.0, colorHex(0x6366F1))
  drawText(modeTitle, modalX + modalW - 86.0, modalY + modalH - 34.0, 0.80, colorHex(0xFFFFFF))
  if isRectClicked(modalX + modalW - 100.0, modalY + modalH - 42.0, 84.0, 28.0) or isKeyPressed("Enter"):
    mut existsInEntries = false
    mut ci = 0
    while ci < state.entries.len:
      if state.entries[ci] == state.fileNameInput and state.fileNameInput.len > 0:
        existsInEntries = true
      ci += 1
    let isSaveMode = match mode:
      Save => true
      _ => false
    if isSaveMode and existsInEntries and not state.confirmOverwrite:
      state.confirmOverwrite = true
    else:
      let sep = if state.currentDir.endsWith("/"): "" else: "/"
      state.selectedPath = if state.fileNameInput.len > 0: state.currentDir + sep + state.fileNameInput else: state.currentDir
      state.confirmed = true
      state.confirmOverwrite = false
      state.isOpen = false

  ret state

