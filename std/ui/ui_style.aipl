  ret AuraTypographyToken(role = "label-medium", fontSizePx = 12.0, lineHeightPx = 16.0, fontWeight = 500, letterSpacingPx = 0.5)

pub struct ColorGradeLut3D(blackPoint: int, whitePoint: int, gammaX100: int, contrastBoost: int)

/// Evaluates a cubic tone-curve channel (`[0..255]`) with `shadowLift` black-floor offset,
/// parabolic/cubic `midtoneBias` centered at `50%` luma, and `highlightGainPct` (`100` = `1.0x`).
/// Uses explicit `float(...)` casts on division operands for `--target html` JS parity.
pub fn lutEvalCubicCurveChannel(val255: int, shadowLift: int, midtoneBias: int, highlightGainPct: int): int:
  let v = clampInt(val255, 0, 255)
  let t = float(v) / float(255.0)
  let invT = 1.0 - t
  let gain = float(maxInt(0, highlightGainPct)) / float(100.0)
  let baseVal = float(v) * gain
  let shadowTerm = float(shadowLift) * invT * invT
  let midTerm = float(midtoneBias) * 4.0 * t * invT
  let outVal = int(baseVal + shadowTerm + midTerm + 0.5)
  ret clampInt(outVal, 0, 255)

/// Maps input channel `val255` (`[0..255]`) from input black/white point range `[inBlack..inWhite]`
/// into output levels range `[outBlack..outWhite]`, clamped to `[0..255]`.
pub fn lutApplyLevelsGammaChannel(val255: int, inBlack: int, inWhite: int, outBlack: int, outWhite: int): int:
  let v = clampInt(val255, 0, 255)
  let inB = clampInt(inBlack, 0, 254)
  let inW = clampInt(maxInt(inB + 1, inWhite), 1, 255)
  let outB = clampInt(outBlack, 0, 255)
  let outW = clampInt(outWhite, 0, 255)
  if v <= inB:
    ret outB
  if v >= inW:
    ret outW
  let spanIn = maxInt(1, inW - inB)
  let t = clampFloat(float(v - inB) / float(spanIn), 0.0, 1.0)
  let mapped = float(outB) + t * float(outW - outB)
  ret clampInt(int(mapped + 0.5), 0, 255)

/// Evaluates a 3-stop Gradient Map color ramp (`lowHex` at `0`, `midHex` at `128`, `highHex` at `255`)
/// for perceptual luminance `luma255` (`[0..255]`), returning packed `0xRRGGBB`.
pub fn lutMapGradientStopColor(luma255: int, lowHex: int, midHex: int, highHex: int): int:
  let lum = clampInt(luma255, 0, 255)
  let r0 = (lowHex >> 16) & 255
  let g0 = (lowHex >> 8) & 255
  let b0 = lowHex & 255
  let r1 = (midHex >> 16) & 255
  let g1 = (midHex >> 8) & 255
  let b1 = midHex & 255
  let r2 = (highHex >> 16) & 255
  let g2 = (highHex >> 8) & 255
  let b2 = highHex & 255
  if lum <= 0:
    ret (r0 << 16) | (g0 << 8) | b0
  if lum >= 255:
    ret (r2 << 16) | (g2 << 8) | b2
  if lum == 128:
    ret (r1 << 16) | (g1 << 8) | b1
  if lum < 128:
    let t = clampFloat(float(lum) / float(128.0), 0.0, 1.0)
    let r = clampInt(int(float(r0) + float(r1 - r0) * t + 0.5), 0, 255)
    let g = clampInt(int(float(g0) + float(g1 - g0) * t + 0.5), 0, 255)
    let b = clampInt(int(float(b0) + float(b1 - b0) * t + 0.5), 0, 255)
    ret (r << 16) | (g << 8) | b
  let tHigh = clampFloat(float(lum - 128) / float(127.0), 0.0, 1.0)
  let rH = clampInt(int(float(r1) + float(r2 - r1) * tHigh + 0.5), 0, 255)
  let gH = clampInt(int(float(g1) + float(g2 - g1) * tHigh + 0.5), 0, 255)
  let bH = clampInt(int(float(b1) + float(b2 - b1) * tHigh + 0.5), 0, 255)
  ret (rH << 16) | (gH << 8) | bH

/// Evaluates a 3-stop Gradient Map color ramp in perceptual Oklab space (`lowHex` at `0`, `midHex` at `128`, `highHex` at `255`).
pub fn lutMapGradientStopOklab(luma255: int, lowHex: int, midHex: int, highHex: int): int:
  let lum = clampInt(luma255, 0, 255)
  if lum <= 0:
    ret lowHex
  if lum >= 255:
    ret highHex
  if lum == 128:
    ret midHex
  if lum < 128:
    let t = clampFloat(float(lum) / 128.0, 0.0, 1.0)
    ret lerpOklabHex(lowHex, midHex, t)
  let tHigh = clampFloat(float(lum - 128) / 127.0, 0.0, 1.0)
  ret lerpOklabHex(midHex, highHex, tHigh)

/// Generates a 1D perceptual color Lookup Table (LUT) interpolated in Oklab space.
pub fn generateColorLut1D(startHex: int, endHex: int, steps: int): [int]:
  mut n = steps
  if n < 2:
    n = 2
  mut lut: [int] = []
  mut i = 0
  while i < n:
    let t = float(i) / float(n - 1)
    lut.push(lerpOklabHex(startHex, endHex, t))
    i += 1
  ret lut

/// Renders a green/custom phosphor night-vision (`NVG` / CRT) horizontal scanline and rolling
/// refresh beam overlay across `(viewX, viewY, viewW, viewH)` animated by `tick`.
pub fn drawFxNightVisionPhosphorScanlines2D(viewX: float, viewY: float, viewW: float, viewH: float, tick: int, phosphorHex: int):
  let safeW = maxFloat(8.0, viewW)
  let safeH = maxFloat(8.0, viewH)
  let r = (phosphorHex >> 16) & 255
  let g = (phosphorHex >> 8) & 255
  let b = phosphorHex & 255
  let lineCol = rgba(r, g, b, 0.18)
  let beamCol = rgba(minInt(255, r + 40), minInt(255, g + 40), minInt(255, b + 40), 0.36)
  let lines = 10
  mut i = 0
  while i < lines:
    let ly = viewY + (float(i) / float(lines)) * safeH
    drawLine(viewX, ly, viewX + safeW, ly, lineCol, 1.0)
    i += 1
  let sweepFrac = float(maxInt(0, tick) % 100) / float(100.0)
  let beamY = viewY + sweepFrac * safeH
  drawLine(viewX, beamY, viewX + safeW, beamY, beamCol, 2.2)
  ret
