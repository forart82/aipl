  ret AuraTypographyToken(role = "title-medium", fontSizePx = 16.0, lineHeightPx = 24.0, fontWeight = 600, letterSpacingPx = 0.15)

pub fn auraTypoBodyLarge(): AuraTypographyToken:
  ret AuraTypographyToken(role = "body-large", fontSizePx = 16.0, lineHeightPx = 24.0, fontWeight = 400, letterSpacingPx = 0.5)

pub fn auraTypoBodyMedium(): AuraTypographyToken:
  ret AuraTypographyToken(role = "body-medium", fontSizePx = 14.0, lineHeightPx = 20.0, fontWeight = 400, letterSpacingPx = 0.25)

