/// # Module: `std/ui/ui_anim` (`UiAnimMod`)
///
/// ## Purpose & Domain Scope
/// UI transition tweens and semi-implicit Euler damped harmonic oscillator springs.
module UiAnimMod

pub struct UiSpring(position: float, target: float, velocity: float, stiffness: float, damping: float)

pub fn updateUiSpring(spring: UiSpring, dt: float): UiSpring:
  let displacement = spring.position - spring.target
  let force = -spring.stiffness * displacement - spring.damping * spring.velocity
  let nextVel = spring.velocity + force * dt
  let nextPos = spring.position + nextVel * dt
  ret UiSpring(
    position = nextPos,
    target = spring.target,
    velocity = nextVel,
    stiffness = spring.stiffness,
    damping = spring.damping
  )
