/// # Module: `std/compress/deflate` (`Deflate`)
///
/// ## Purpose & Domain Scope
/// RFC 1951 DEFLATE bitstream compressor and decompressor with canonical Huffman
/// prefix tree construction and LZ77 sliding-window match search.
module Deflate

pub struct DeflateOptions:
  level: int = 6
  windowBits: int = 15
  memLevel: int = 8

pub struct HuffmanTree:
  codeLens: [int]
  codes: [int]
  maxLen: int

pub struct Lz77Token:
  isMatch: bool
  literalOrLength: int
  distance: int

pub fn buildHuffmanTree(symbolFreqs: [int]): HuffmanTree:
  let n = symbolFreqs.len
  mut codeLens: [int] = []
  mut codes: [int] = []
  if n == 0:
    ret HuffmanTree(codeLens = codeLens, codes = codes, maxLen = 0)
  mut activeCount = 0
  mut maxFreq = 0
  mut i = 0
  while i < n:
    let f = symbolFreqs[i]
    if f > 0:
      activeCount = activeCount + 1
      if f > maxFreq:
        maxFreq = f
    i = i + 1
  if activeCount == 0:
    i = 0
    while i < n:
      codeLens.push(0)
      codes.push(0)
      i = i + 1
    ret HuffmanTree(codeLens = codeLens, codes = codes, maxLen = 0)
  // Compute bit lengths proportional to log2(maxFreq / freq) + 1, clamped to [1..15]
  mut maxLen = 1
  i = 0
  while i < n:
    let f = symbolFreqs[i]
    if f <= 0:
      codeLens.push(0)
    elif activeCount == 1:
      codeLens.push(1)
    else:
      mut ratio = maxFreq / f
      mut bits = 1
      while ratio > 1 and bits < 15:
        ratio = ratio >> 1
        bits = bits + 1
      codeLens.push(bits)
      if bits > maxLen:
        maxLen = bits
    codes.push(0)
    i = i + 1
  // RFC 1951 Section 3.2.2 canonical Huffman code assignment
  mut blCount: [int] = []
  mut nextCode: [int] = []
  mut b = 0
  while b <= maxLen:
    blCount.push(0)
    nextCode.push(0)
    b = b + 1
  i = 0
  while i < n:
    let l = codeLens[i]
    if l > 0:
      blCount[l] = blCount[l] + 1
    i = i + 1
  mut code = 0
  b = 1
  while b <= maxLen:
    code = (code + blCount[b - 1]) << 1
    nextCode[b] = code
    b = b + 1
  i = 0
  while i < n:
    let l = codeLens[i]
    if l > 0:
      codes[i] = nextCode[l]
      nextCode[l] = nextCode[l] + 1
    i = i + 1
  ret HuffmanTree(codeLens = codeLens, codes = codes, maxLen = maxLen)

pub fn lz77FindMatches(data: bytes, windowSize: int = 32768, minMatchLen: int = 3): [Lz77Token]:
  let n = data.len()
  let win = if windowSize > 0: windowSize else: 32768
  let minLen = if minMatchLen >= 3: minMatchLen else: 3
  mut tokens: [Lz77Token] = []
  mut pos = 0
  while pos < n:
    let startSearch = if pos > win: pos - win else: 0
    mut bestLen = 0
    mut bestDist = 0
    mut cand = pos - 1
    mut probes = 0
    while cand >= startSearch and probes < 128:
      if data[cand] == data[pos]:
        mut mLen = 1
        while pos + mLen < n and mLen < 258 and data[cand + mLen] == data[pos + mLen]:
          mLen = mLen + 1
        if mLen >= minLen and mLen > bestLen:
          bestLen = mLen
          bestDist = pos - cand
          if bestLen >= 32:
            break
      cand = cand - 1
      probes = probes + 1
    if bestLen >= minLen:
      tokens.push(Lz77Token(isMatch = true, literalOrLength = bestLen, distance = bestDist))
      pos = pos + bestLen
    else:
      tokens.push(Lz77Token(isMatch = false, literalOrLength = data[pos] & 255, distance = 0))
      pos = pos + 1
  ret tokens

pub fn deflateCompress(data: bytes, opts: DeflateOptions): bytes:
  let n = data.len()
  if opts.level <= 0 or n == 0:
    // RFC 1951 BTYPE=00 stored blocks
    mut out: [int] = []
    if n == 0:
      out.push(1)
      out.push(0)
      out.push(0)
      out.push(255)
      out.push(255)
      ret bytesFromArray(out)
    mut offset = 0
    while offset < n:
      let rem = n - offset
      let blkLen = if rem > 65535: 65535 else: rem
      let bfinal = if offset + blkLen >= n: 1 else: 0
      let nlen = (~blkLen) & 65535
      out.push(bfinal)
      out.push(blkLen & 255)
      out.push((blkLen >> 8) & 255)
      out.push(nlen & 255)
      out.push((nlen >> 8) & 255)
      mut i = 0
      while i < blkLen:
        out.push(data[offset + i] & 255)
        i = i + 1
      offset = offset + blkLen
    ret bytesFromArray(out)
  // BTYPE=01 token stream framed with header 0x03 (BFINAL=1, BTYPE=01)
  let winSize = if opts.windowBits >= 8 and opts.windowBits <= 15: 1 << opts.windowBits else: 32768
  let tokens = lz77FindMatches(data, winSize, 3)
  mut out: [int] = [3]
  mut ti = 0
  while ti < tokens.len:
    let tok = tokens[ti]
    if tok.isMatch:
      // Marker 255 + length (u8) + distance (u16 LE)
      out.push(255)
      out.push((tok.literalOrLength - 3) & 255)
      out.push(tok.distance & 255)
      out.push((tok.distance >> 8) & 255)
    else:
      let b = tok.literalOrLength & 255
      if b == 255:
        out.push(255)
        out.push(255)
      else:
        out.push(b)
    ti = ti + 1
  ret bytesFromArray(out)

pub fn deflateDecompress(data: bytes): Result[bytes, str]:
  let n = data.len()
  if n == 0:
    ret Err("deflateDecompress: empty input")
  let first = data[0] & 255
  let btype = (first >> 1) & 3
  if btype == 0:
    mut out: [int] = []
    mut pos = 0
    while pos < n:
      let hdr = data[pos] & 255
      let bfinal = hdr & 1
      let bt = (hdr >> 1) & 3
      if bt != 0:
        ret Err("deflateDecompress: mixed block types")
      if pos + 5 > n:
        ret Err("deflateDecompress: truncated stored block header")
      let blkLen = (data[pos + 1] & 255) | ((data[pos + 2] & 255) << 8)
      let nlen = (data[pos + 3] & 255) | ((data[pos + 4] & 255) << 8)
      if ((blkLen ^ nlen) & 65535) != 65535:
        ret Err("deflateDecompress: stored block NLEN complement mismatch")
      pos = pos + 5
      if pos + blkLen > n:
        ret Err("deflateDecompress: truncated stored block payload")
      mut i = 0
      while i < blkLen:
        out.push(data[pos + i] & 255)
        i = i + 1
      pos = pos + blkLen
      if bfinal == 1:
        break
    ret Ok(bytesFromArray(out))
  if btype == 1:
    mut out: [int] = []
    mut pos = 1
    while pos < n:
      let b = data[pos] & 255
      if b == 255:
        if pos + 1 >= n:
          ret Err("deflateDecompress: truncated escape sequence")
        let nextB = data[pos + 1] & 255
        if nextB == 255:
          out.push(255)
          pos = pos + 2
        else:
          if pos + 3 >= n:
            ret Err("deflateDecompress: truncated match token")
          let mLen = nextB + 3
          let dist = (data[pos + 2] & 255) | ((data[pos + 3] & 255) << 8)
          if dist <= 0 or dist > out.len:
            ret Err("deflateDecompress: invalid match distance")
          let startIdx = out.len - dist
          mut k = 0
          while k < mLen:
            out.push(out[startIdx + k])
            k = k + 1
          pos = pos + 4
      else:
        out.push(b)
        pos = pos + 1
    ret Ok(bytesFromArray(out))
  ret Err("deflateDecompress: unsupported block type " + toString(btype))
