/// # Module: `std/compress/compress_mod` (`CompressMod`)
///
/// ## Purpose & Domain Scope
/// Root barrel aggregator for `std/compress`: RFC 1951 DEFLATE, RFC 1952 Gzip,
/// RFC 1950 Zlib, LZ4 block/frame, Zstandard (RFC 8878), and POSIX UStar `.tar` archives.
module CompressMod

pub import {
  DeflateOptions, HuffmanTree, Lz77Token,
  buildHuffmanTree, lz77FindMatches, deflateCompress, deflateDecompress
} from "./deflate.aipl"

pub import {
  GzipHeader, ZlibHeader,
  computeAdler32, computeCrc32,
  gzipCompress, gzipDecompress, zlibCompress, zlibDecompress
} from "./gzip.aipl"

pub import {
  Lz4BlockHeader, Lz4FrameHeader,
  lz4CompressBlock, lz4DecompressBlock, lz4CompressFrame, lz4DecompressFrame
} from "./lz4.aipl"

pub import {
  ZstdFrameHeader, ZstdBlockHeader,
  zstdCompress, zstdDecompress
} from "./zstd.aipl"

pub import {
  TarEntry, TarArchive,
  tarPack, tarUnpack
} from "./tar_archive.aipl"

pub import * from "./apk_zip_writer.aipl"
pub fn compressGzip(data: bytes): bytes:
  ret gzipCompress(data, "", 0)

pub fn decompressGzip(data: bytes): Result[bytes, str]:
  ret gzipDecompress(data)

pub fn compressLz4(data: bytes): bytes:
  ret lz4CompressFrame(data)

pub fn decompressLz4(data: bytes): Result[bytes, str]:
  ret lz4DecompressFrame(data)

pub fn compressZstd(data: bytes, level: int = 3): bytes:
  ret zstdCompress(data, level)

pub fn decompressZstd(data: bytes): Result[bytes, str]:
  ret zstdDecompress(data)
