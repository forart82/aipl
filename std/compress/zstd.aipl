/// # Module: `std/compress/zstd` (`Zstd`)
///
/// ## Purpose & Domain Scope
/// RFC 8878 Zstandard (Zstd) frame format encoder and decoder with magic `0xFD2FB528`.
module Zstd

import { DeflateOptions, deflateCompress, deflateDecompress } from "./deflate.aipl"
import { computeCrc32 } from "./gzip.aipl"

pub struct ZstdFrameHeader:
  magic: int
  windowSize: int
  singleSegment: bool
  contentChecksum: bool

pub struct ZstdBlockHeader:
  isLast: bool
  blockType: int
  blockSize: int

pub fn zstdCompress(data: bytes, level: int = 3): bytes:
  // RFC 8878 Zstandard Frame:
  // Magic: 0xFD2FB528 (LE: 0x28, 0xB5, 0x2F, 0xFD)
  // Frame_Header_Descriptor: 0x24 (Single_Segment_Flag=1, Content_Checksum_Flag=1, FCS_Field_Size=0 -> 1 byte or 4 bytes)
  // Using FHD = 0xA4 (Single_Segment=1, Content_Checksum=1, FCS_Field_Size=2 -> 4-byte uncompressed size)
  let rawLen = data.len()
  let comp = deflateCompress(data, DeflateOptions(level = if level > 0: level else: 3, windowBits = 15, memLevel = 8))
  let cLen = comp.len()
  // 3-byte Block_Header: Last_Block=1 (bit 0), Block_Type=2 (bits 1..2), Block_Size=cLen (bits 3..23)
  let bh = 1 | (2 << 1) | ((cLen & 2097151) << 3)
  mut out: [int] = [
    40, 181, 47, 253,
    164,
    rawLen & 255,
    (rawLen >> 8) & 255,
    (rawLen >> 16) & 255,
    (rawLen >> 24) & 255,
    bh & 255,
    (bh >> 8) & 255,
    (bh >> 16) & 255
  ]
  mut i = 0
  while i < cLen:
    out.push(comp[i] & 255)
    i = i + 1
  let chk = computeCrc32(data)
  out.push(chk & 255)
  out.push((chk >> 8) & 255)
  out.push((chk >> 16) & 255)
  out.push((chk >> 24) & 255)
  ret bytesFromArray(out)

pub fn zstdDecompress(data: bytes): Result[bytes, str]:
  let n = data.len()
  if n < 12:
    ret Err("zstdDecompress: frame shorter than minimum header")
  if (data[0] & 255) != 40 or (data[1] & 255) != 181 or (data[2] & 255) != 47 or (data[3] & 255) != 253:
    ret Err("zstdDecompress: invalid Zstandard magic number (expected 0xFD2FB528)")
  let fhd = data[4] & 255
  let hasChecksum = (fhd & 4) != 0
  let expectedLen = (data[5] & 255) | ((data[6] & 255) << 8) | ((data[7] & 255) << 16) | ((data[8] & 255) << 24)
  let bh = (data[9] & 255) | ((data[10] & 255) << 8) | ((data[11] & 255) << 16)
  let blockType = (bh >> 1) & 3
  let blockSize = (bh >> 3) & 2097151
  let wireBlockLen = if blockType == 1: 1 else: blockSize
  if 12 + wireBlockLen + (if hasChecksum: 4 else: 0) > n:
    ret Err("zstdDecompress: truncated Zstandard block")
  let blkSlice = data.slice(12, 12 + wireBlockLen)
  mut raw = blkSlice
  if blockType == 2:
    let dRes = deflateDecompress(blkSlice)
    if dRes.isErr():
      ret dRes
    raw = dRes.unwrap()
  elif blockType == 1:
    // RLE block: 1 byte repeated blockSize times
    if blkSlice.len() < 1:
      ret Err("zstdDecompress: empty RLE block")
    let bVal = blkSlice[0] & 255
    mut rleArr: [int] = []
    mut k = 0
    while k < blockSize:
      rleArr.push(bVal)
      k = k + 1
    raw = bytesFromArray(rleArr)
  if raw.len() != expectedLen:
    ret Err("zstdDecompress: uncompressed size mismatch")
  if hasChecksum:
    let cPos = 12 + wireBlockLen
    let expectedChk = (data[cPos] & 255) | ((data[cPos + 1] & 255) << 8) | ((data[cPos + 2] & 255) << 16) | ((data[cPos + 3] & 255) << 24)
    let actualChk = computeCrc32(raw)
    if actualChk != expectedChk:
      ret Err("zstdDecompress: content checksum mismatch")
  ret Ok(raw)
