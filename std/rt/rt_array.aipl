/// # Module: `std/rt/rt_array` (`RtArray`)
///
/// ## Purpose & Domain Scope
/// Self-hosted runtime dynamic array growth kernel and geometric reallocation engine.
module RtArray

import { ptrAlloc, ptrFree, ptrReadU8, ptrWriteU8, ptrReadU16LE, ptrWriteU16LE, ptrReadU32LE, ptrWriteU32LE, ptrReadI64, ptrWriteI64, ptrCopy, ptrMemcpy } from "std/rt/rt_ptr"
pub struct RtArrayHeader:
  dataPtr: int
  length: int
  capacity: int
  elementSize: int

pub struct RtArray:
  data: int
  len: int
  cap: int
  dataPtr: int
  length: int
  capacity: int
  elementSize: int

pub fn rtArrayNew(initialCapacity: int = 8, elemSize: int = 8): RtArray:
  let realCap = if initialCapacity > 0: initialCapacity else: 8
  let es = if elemSize > 0: elemSize else: 8
  let byteSize = realCap * es
  let ptr = ptrAlloc(byteSize)
  ret RtArray(
    data = ptr,
    len = 0,
    cap = realCap,
    dataPtr = ptr,
    length = 0,
    capacity = realCap,
    elementSize = es
  )

pub fn rtArrayReserve(mut arr: RtArray, minCap: int): void:
  if arr.cap >= minCap:
    ret
  mut newCap = if arr.cap > 0: arr.cap * 2 else: 8
  if newCap < minCap:
    newCap = minCap
  let es = if arr.elementSize > 0: arr.elementSize else: 8
  let newByteSize = newCap * es
  let newPtr = ptrAlloc(newByteSize)
  if newPtr != 0:
    if arr.len > 0 and arr.data != 0:
      ptrCopy(newPtr, arr.data, arr.len * es)
    if arr.data != 0:
      ptrFree(arr.data)
    arr.data = newPtr
    arr.dataPtr = newPtr
    arr.cap = newCap
    arr.capacity = newCap
  ret

pub fn rtArrayEnsureCap(mut arr: RtArray, requiredCap: int): void:
  rtArrayReserve(arr, requiredCap)
  ret

pub fn rtArrayPush(mut arr: RtArray, val: int): int:
  if arr.len >= arr.cap:
    rtArrayReserve(arr, arr.len + 1)
  let idx = arr.len
  if arr.data != 0 and arr.len < arr.cap:
    let es = if arr.elementSize > 0: arr.elementSize else: 8
    if es == 1:
      ptrWriteU8(arr.data, idx, val & 255)
    elif es == 2:
      ptrWriteU16LE(arr.data, idx * 2, val)
    elif es == 4:
      ptrWriteU32LE(arr.data, idx * 4, val)
    else:
      ptrWriteI64(arr.data, idx * es, val)
    arr.len += 1
    arr.length = arr.len
  ret idx

pub fn rtArrayGet(arr: RtArray, index: int): int:
  if index < 0 or index >= arr.len or arr.data == 0:
    ret 0
  let es = if arr.elementSize > 0: arr.elementSize else: 8
  if es == 1:
    ret ptrReadU8(arr.data, index)
  if es == 2:
    ret ptrReadU16LE(arr.data, index * 2)
  if es == 4:
    ret ptrReadU32LE(arr.data, index * 4)
  ret ptrReadI64(arr.data, index * es)

pub fn rtArraySet(mut arr: RtArray, index: int, val: int): bool:
  if index < 0 or index >= arr.len or arr.data == 0:
    ret false
  let es = if arr.elementSize > 0: arr.elementSize else: 8
  if es == 1:
    ptrWriteU8(arr.data, index, val & 255)
  elif es == 2:
    ptrWriteU16LE(arr.data, index * 2, val)
  elif es == 4:
    ptrWriteU32LE(arr.data, index * 4, val)
  else:
    ptrWriteI64(arr.data, index * es, val)
  ret true

pub fn rtArrayPop(mut arr: RtArray): int:
  if arr.len <= 0 or arr.data == 0:
    ret 0
  arr.len -= 1
  arr.length = arr.len
  let es = if arr.elementSize > 0: arr.elementSize else: 8
  if es == 1:
    ret ptrReadU8(arr.data, arr.len)
  if es == 2:
    ret ptrReadU16LE(arr.data, arr.len * 2)
  if es == 4:
    ret ptrReadU32LE(arr.data, arr.len * 4)
  ret ptrReadI64(arr.data, arr.len * es)

pub fn rtArrayLen(arr: RtArray): int:
  ret arr.len

pub fn rtArrayClear(mut arr: RtArray): void:
  arr.len = 0
  arr.length = 0
  ret

pub fn rtArrayFree(mut arr: RtArray): void:
  if arr.data != 0:
    ptrFree(arr.data)
    arr.data = 0
    arr.dataPtr = 0
  arr.len = 0
  arr.length = 0
  arr.cap = 0
  arr.capacity = 0
  ret

pub fn rtArrayHeaderNew(elemSize: int, initialCap: int): RtArrayHeader:
  let es = if elemSize > 0: elemSize else: 8
  let cap = if initialCap > 0: initialCap else: 8
  let ptr = ptrAlloc(cap * es)
  ret RtArrayHeader(dataPtr = ptr, length = 0, capacity = cap, elementSize = es)

pub fn rtArrayHeaderEnsureCap(mut hdr: RtArrayHeader, requiredCap: int): void:
  if hdr.capacity >= requiredCap:
    ret
  mut newCap = if hdr.capacity > 0: hdr.capacity + (hdr.capacity / 2) + 4 else: 8
  if newCap < requiredCap:
    newCap = requiredCap
  let newPtr = ptrAlloc(newCap * hdr.elementSize)
  if newPtr != 0:
    if hdr.length > 0 and hdr.dataPtr != 0:
      ptrMemcpy(newPtr, 0, hdr.dataPtr, 0, hdr.length * hdr.elementSize)
    if hdr.dataPtr != 0:
      ptrFree(hdr.dataPtr)
    hdr.dataPtr = newPtr
    hdr.capacity = newCap
  ret

pub fn rtArrayHeaderAddrAt(hdr: RtArrayHeader, index: int): int:
  if index < 0 or index >= hdr.length or hdr.dataPtr == 0:
    ret 0
  ret hdr.dataPtr + (index * hdr.elementSize)

pub fn rtArrayHeaderFree(mut hdr: RtArrayHeader): void:
  if hdr.dataPtr != 0:
    ptrFree(hdr.dataPtr)
    hdr.dataPtr = 0
  hdr.length = 0
  hdr.capacity = 0
  ret
