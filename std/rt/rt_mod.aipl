/// # Module: `std/rt/rt_mod` (`RtMod`)
///
/// ## Purpose & Domain Scope
/// Root barrel manifest for `std/rt/` (Layer 0 Self-Hosted Pure-AIPL Runtime Kernels).
/// Re-exports `rt_ptr`, `rt_alloc`, `rt_array`, `rt_string`, `rt_map`, `rt_canvas_x11`, and `rt_audio_mixer`.
module RtMod

pub import * from "std/rt/rt_ptr"
pub import * from "std/rt/rt_alloc"
pub import * from "std/rt/rt_array"
pub import * from "std/rt/rt_string"
pub import * from "std/rt/rt_map"
pub import * from "std/rt/rt_canvas_x11"
pub import * from "std/rt/rt_audio_mixer"
