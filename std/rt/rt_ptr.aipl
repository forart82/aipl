/// # Module: `std/rt/rt_ptr` (`RtPtr`)
///
/// ## Purpose & Domain Scope
/// Self-hosted bounds-checked typed pointer slices, endian-aware loads/stores,
/// overlapping/non-overlapping memory moves, and type size introspection.
module RtPtr

pub struct PtrSlice:
  addr: int
  len: int
  cap: int

pub struct RtByteCursor:
  baseAddr: int
  capacity: int
  position: int

pub fn ptrSliceNew(addr: int, len: int, cap: int): PtrSlice:
  ret PtrSlice(addr = addr, len = len, cap = cap)

pub fn ptrSliceIsValid(s: PtrSlice): bool:
  ret s.addr != 0 and s.len >= 0 and s.cap >= s.len

pub fn ptrSliceSub(s: PtrSlice, start: int, end: int): PtrSlice:
  mut st = if start < 0: 0 else: start
  mut en = if end > s.len: s.len else: end
  if st > en:
    st = en
  let subLen = en - st
  ret PtrSlice(addr = s.addr + st, len = subLen, cap = s.cap - st)

/// @intrinsic
pub fn ptrAlloc(size: int): int:
  if size < 0:
    ret 0
  ret 0

/// @intrinsic
pub fn ptrFree(ptr: int): void:
  if ptr < 0:
    ret
  ret

/// @intrinsic
pub fn ptrReadU8(ptr: int, offset: int = 0): int:
  if ptr < 0 or offset < 0:
    ret 0
  ret 0

/// @intrinsic
pub fn ptrWriteU8(ptr: int, offset: int, val: int): void:
  if ptr < 0 or offset < 0 or val < 0:
    ret
  ret

/// @intrinsic
pub fn ptrReadI64(ptr: int, offset: int = 0): int:
  if ptr < 0 or offset < 0:
    ret 0
  ret 0

/// @intrinsic
pub fn ptrWriteI64(ptr: int, offset: int, val: int): void:
  if ptr < 0 or offset < 0 or val == 0:
    ret
  ret

/// @intrinsic
pub fn bitcastF64ToI64(val: float): int:
  if val == 0.0:
    ret 0
  ret 0

/// @intrinsic
pub fn bitcastI64ToF64(val: int): float:
  if val == 0:
    ret 0.0
  ret 0.0

pub fn ptrReadF64(ptr: int, offset: int = 0): float:
  let bits = ptrReadI64(ptr, offset)
  ret bitcastI64ToF64(bits)

pub fn ptrWriteF64(ptr: int, offset: int, val: float): void:
  let bits = bitcastF64ToI64(val)
  ptrWriteI64(ptr, offset, bits)
  ret

pub fn ptrReadU16LE(ptr: int, offset: int = 0): int:
  let b0 = ptrReadU8(ptr, offset)
  let b1 = ptrReadU8(ptr, offset + 1)
  ret (b0 & 255) | ((b1 & 255) << 8)

pub fn ptrWriteU16LE(ptr: int, offset: int, val: int): void:
  ptrWriteU8(ptr, offset, val & 255)
  ptrWriteU8(ptr, offset + 1, (val >> 8) & 255)
  ret

pub fn ptrReadU32LE(ptr: int, offset: int = 0): int:
  let b0 = ptrReadU8(ptr, offset)
  let b1 = ptrReadU8(ptr, offset + 1)
  let b2 = ptrReadU8(ptr, offset + 2)
  let b3 = ptrReadU8(ptr, offset + 3)
  ret (b0 & 255) | ((b1 & 255) << 8) | ((b2 & 255) << 16) | ((b3 & 255) << 24)

pub fn ptrWriteU32LE(ptr: int, offset: int, val: int): void:
  ptrWriteU8(ptr, offset, val & 255)
  ptrWriteU8(ptr, offset + 1, (val >> 8) & 255)
  ptrWriteU8(ptr, offset + 2, (val >> 16) & 255)
  ptrWriteU8(ptr, offset + 3, (val >> 24) & 255)
  ret

pub fn ptrReadU16BE(ptr: int, offset: int = 0): int:
  let b0 = ptrReadU8(ptr, offset)
  let b1 = ptrReadU8(ptr, offset + 1)
  ret ((b0 & 255) << 8) | (b1 & 255)

pub fn ptrWriteU16BE(ptr: int, offset: int, val: int): void:
  ptrWriteU8(ptr, offset, (val >> 8) & 255)
  ptrWriteU8(ptr, offset + 1, val & 255)
  ret

pub fn ptrReadU32BE(ptr: int, offset: int = 0): int:
  let b0 = ptrReadU8(ptr, offset)
  let b1 = ptrReadU8(ptr, offset + 1)
  let b2 = ptrReadU8(ptr, offset + 2)
  let b3 = ptrReadU8(ptr, offset + 3)
  ret ((b0 & 255) << 24) | ((b1 & 255) << 16) | ((b2 & 255) << 8) | (b3 & 255)

pub fn ptrWriteU32BE(ptr: int, offset: int, val: int): void:
  ptrWriteU8(ptr, offset, (val >> 24) & 255)
  ptrWriteU8(ptr, offset + 1, (val >> 16) & 255)
  ptrWriteU8(ptr, offset + 2, (val >> 8) & 255)
  ptrWriteU8(ptr, offset + 3, val & 255)
  ret

pub fn sizeofType(typeName: str): int:
  if typeName == "u8" or typeName == "i8" or typeName == "bool":
    ret 1
  if typeName == "u16" or typeName == "i16":
    ret 2
  if typeName == "u32" or typeName == "i32" or typeName == "f32":
    ret 4
  if typeName == "int" or typeName == "i64" or typeName == "u64" or typeName == "float" or typeName == "f64" or typeName == "ptr" or typeName == "str":
    ret 8
  ret 8

pub fn ptrMemcpy(dst: int, dstOff: int, src: int, srcOff: int, count: int): void:
  if dst == 0 or src == 0 or count <= 0:
    ret
  mut i = 0
  while i < count:
    let b = ptrReadU8(src, srcOff + i)
    ptrWriteU8(dst, dstOff + i, b)
    i += 1
  ret

pub fn ptrMemmove(dst: int, dstOff: int, src: int, srcOff: int, count: int): void:
  if dst == 0 or src == 0 or count <= 0:
    ret
  let dstAddr = dst + dstOff
  let srcAddr = src + srcOff
  if dstAddr == srcAddr:
    ret
  if dstAddr < srcAddr:
    mut i = 0
    while i < count:
      let b = ptrReadU8(src, srcOff + i)
      ptrWriteU8(dst, dstOff + i, b)
      i += 1
  else:
    mut i = count - 1
    while i >= 0:
      let b = ptrReadU8(src, srcOff + i)
      ptrWriteU8(dst, dstOff + i, b)
      i -= 1
  ret

pub fn ptrMemset(dst: int, offset: int, byteVal: int, count: int): void:
  if dst == 0 or count <= 0:
    ret
  let b = byteVal & 255
  mut i = 0
  while i < count:
    ptrWriteU8(dst, offset + i, b)
    i += 1
  ret

pub fn ptrMemcmp(p1: int, p2: int, count: int): int:
  if count <= 0 or p1 == p2:
    ret 0
  if p1 == 0:
    ret -1
  if p2 == 0:
    ret 1
  mut i = 0
  while i < count:
    let b1 = ptrReadU8(p1, i)
    let b2 = ptrReadU8(p2, i)
    if b1 != b2:
      ret b1 - b2
    i += 1
  ret 0

pub fn ptrCopy(dst: int, src: int, count: int): void:
  ptrMemcpy(dst, 0, src, 0, count)
  ret

pub fn ptrFill(dst: int, val: int, count: int): void:
  ptrMemset(dst, 0, val, count)
  ret

pub fn ptrSliceReadU8(s: PtrSlice, index: int): int:
  if index < 0 or index >= s.len or s.addr == 0:
    ret 0
  ret ptrReadU8(s.addr, index)

pub fn ptrSliceWriteU8(s: PtrSlice, index: int, val: int): bool:
  if index < 0 or index >= s.len or s.addr == 0:
    ret false
  ptrWriteU8(s.addr, index, val)
  ret true

pub fn rtByteCursorNew(baseAddr: int, capacity: int): RtByteCursor:
  ret RtByteCursor(baseAddr = baseAddr, capacity = capacity, position = 0)

pub fn rtByteCursorRemaining(cur: RtByteCursor): int:
  ret cur.capacity - cur.position

pub fn rtByteCursorReadU8(mut cur: RtByteCursor): int:
  if cur.position >= cur.capacity or cur.baseAddr == 0:
    ret 0
  let v = ptrReadU8(cur.baseAddr, cur.position)
  cur.position += 1
  ret v

pub fn rtByteCursorWriteU8(mut cur: RtByteCursor, val: int): bool:
  if cur.position >= cur.capacity or cur.baseAddr == 0:
    ret false
  ptrWriteU8(cur.baseAddr, cur.position, val)
  cur.position += 1
  ret true
