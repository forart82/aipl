/// # Module: `std/gfx25d/gfx25d_mod` (`Gfx25dMod`)
///
/// ## Purpose & Domain Scope
/// Continuous 2.5D/3D World Engine barrel module re-exporting `std/gfx25d/camera25d`,
/// `std/gfx25d/mesh25d`, `std/gfx25d/ribbon25d`, `std/gfx25d/light25d`,
/// `std/gfx25d/sprite25d`, and `std/gfx25d/weather25d`.
///
/// ## Architectural Boundary
/// - `std/gfx2d/tilemap_renderer2d`: Discrete 2D retro grid / tactical board games.
/// - `std/gfx25d/*` + `std/gfx3d/terrain3d`: Continuous heightfield terrains, rivers, mountains, dark-fantasy lighting, 8-dir isometric rigs, weather, and 2.5D worlds.
///
/// ## Runnable Example
/// ```aipl
/// import { createCamera25D, drawHeightfieldPatch25D, drawHeightfieldSplat25D, drawSplineRibbon25D, drawPrism25D, createPointLight25D, createIsoSpriteRig25D, createRainSystem25D } from "std/gfx25d/gfx25d_mod"
/// ```
module Gfx25dMod

pub import { AABB2D, Camera25D, createCamera25D, project3DToIso, unprojectIsoTo3D, getVisibleWorldAABB, updateCamera25D } from "./camera25d"
pub import { Vertex25D, IndexedMesh25D, Vertex25DTextured, IndexedMesh25DTextured, shadeVertex25D, drawHeightfieldPatch25D, drawHeightfieldPatchTextured25D, drawHeightfieldSplat25D, drawGroundDecal25D, drawIndexedMesh25D, drawIndexedMeshTextured25D, drawPrism25D, drawPrismTextured25D, drawCone25D, drawBillboard25D } from "./mesh25d"
pub import { RibbonVertex25D, extrudeSplineRibbon25D, drawSplineRibbon25D, drawSplineRibbonTextured25D } from "./ribbon25d"
pub import { PointLight25D, createPointLight25D, drawAmbientDarknessPass25D, drawLightCookie25D, renderLightingPass25D } from "./light25d"
pub import { IsoSpriteRig25D, direction8FromVelocity, createIsoSpriteRig25D, stepIsoSpriteRig25D, drawContactShadow25D, drawSpriteBillboard25D, drawIsoSpriteRig25D } from "./sprite25d"
pub import { RainDrop25D, RainSystem25D, createRainSystem25D, stepAndDrawRain25D, EmberParticle25D, EmberSmokeEmitter25D, createEmberSmokeEmitter25D, stepAndDrawEmberSmoke25D, drawGroundMist25D } from "./weather25d"
