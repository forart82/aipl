/// # Module: `std/alloc/alloc_mod` (`AllocMod`)
///
/// ## Purpose & Domain Scope
/// Root barrel manifest for `std/alloc/` (Layer 0 Memory Allocators & Zero-Allocation Substrates).
/// Re-exports `arena`, `gpa`, `page_alloc`, `pool_alloc`, and `ring_alloc`.
module AllocMod

pub import * from "std/alloc/arena"
pub import * from "std/alloc/gpa"
pub import * from "std/alloc/page_alloc"
pub import * from "std/alloc/pool_alloc"
pub import * from "std/alloc/ring_alloc"
