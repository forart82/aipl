/// # Module: `std/gfx3d/decal3d` (`Decal3DMod`)
///
/// ## Purpose & Domain Scope
/// Projected Oriented Bounding Box (OBB) surface decals and Sutherland-Hodgman
/// geometric polygon clipping against the 6 axis-aligned box projection planes.
module Decal3DMod

import { EPSILON } from "std/math/consts"
import { Vec3 } from "std/math/vec_math"
import { Quat } from "std/math/quat"

pub struct DecalProjector(position: Vec3, rotation: Quat, extents: Vec3, textureId: int)

pub fn createDecalProjector(pos: Vec3, rot: Quat, extents: Vec3, texId: int): DecalProjector:
  ret DecalProjector(
    position = pos,
    rotation = rot,
    extents = extents,
    textureId = texId
  )

fn clipPolygonAgainstPlane(pts: [Vec3], nx: float, ny: float, nz: float, limit: float): [Vec3]:
  let count = pts.len
  if count == 0:
    ret []
  mut outPts: [Vec3] = []
  mut i = 0
  while i < count:
    let curr = pts[i]
    let prev = pts[(i + count - 1) % count]
    let dCurr = limit - (curr.x * nx + curr.y * ny + curr.z * nz)
    let dPrev = limit - (prev.x * nx + prev.y * ny + prev.z * nz)
    let currInside = dCurr >= 0.0
    let prevInside = dPrev >= 0.0

    if currInside != prevInside:
      let denom = dPrev - dCurr
      let t = if denom > EPSILON or denom < -EPSILON: dPrev / denom else: 0.5
      outPts.push(Vec3(
        x = prev.x + (curr.x - prev.x) * t,
        y = prev.y + (curr.y - prev.y) * t,
        z = prev.z + (curr.z - prev.z) * t
      ))
    if currInside:
      outPts.push(curr)
    i = i + 1
  ret outPts

pub fn clipTriangleAgainstBoxPlanes(triPts: [Vec3], boxExtents: Vec3): [Vec3]:
  mut poly = triPts
  poly = clipPolygonAgainstPlane(poly,  1.0,  0.0,  0.0, boxExtents.x)
  poly = clipPolygonAgainstPlane(poly, -1.0,  0.0,  0.0, boxExtents.x)
  poly = clipPolygonAgainstPlane(poly,  0.0,  1.0,  0.0, boxExtents.y)
  poly = clipPolygonAgainstPlane(poly,  0.0, -1.0,  0.0, boxExtents.y)
  poly = clipPolygonAgainstPlane(poly,  0.0,  0.0,  1.0, boxExtents.z)
  poly = clipPolygonAgainstPlane(poly,  0.0,  0.0, -1.0, boxExtents.z)
  ret poly
