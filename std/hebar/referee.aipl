/// # Module: `std/hebar/referee` (`HebarRefereeAliasMod`)
///
/// ## Purpose & Domain Scope
/// Canonical alias module re-exporting the Human-Equivalent Bot Automated Referee
/// (`std/ai/hebar_referee`) under the `std/hebar/referee` namespace.
/// Enforces all 5 biological fairness bounds:
/// 1. 150-250ms FIFO reaction latency queue (`hebarEnqueueAction`, `hebarPopReadyActions`)
/// 2. `<= 15 Hz` (900 APM) input frequency clamp (`hebarIsWithinApmLimit`)
/// 3. `<= 780 px/s` smooth cursor trajectory interpolation (`hebarStepCursorTrajectory`)
/// 4. `<= 2*PI rad/s` angular velocity slew clamp (`hebarClampAngularSlew`)
/// 5. Zero direct memory/state tampering verification (`hebarVerifyZeroTampering`)
/// Plus deterministic IPC window handshake (`connectTargetWindow`), live referee HUD
/// (`renderHebarRefereeDashboard`), and telemetry export (`exportHebarTelemetryJson`).
///
/// ## Runnable Example
/// ```aipl
/// import { Vec2 } from "std/math/vec_math"
/// import { hebarRefereeNew, hebarStepCursorTrajectory, hebarClampAngularSlew, hebarVerifyZeroTampering, connectTargetWindow } from "std/hebar/referee"
///
/// let refState = hebarRefereeNew(150, 250, 900)
/// let nextCursor = hebarStepCursorTrajectory(Vec2(x = 0.0, y = 0.0), Vec2(x = 500.0, y = 0.0), 780.0, 0.016667)
/// let nextAngle = hebarClampAngularSlew(0.0, 3.14159, 6.2831853, 0.016667)
/// let ok = hebarVerifyZeroTampering(refState, 0)
/// ```
module HebarRefereeAliasMod

pub import {
  HebarActionRecord,
  HebarReferee,
  hebarRefereeNew,
  hebarEnqueueAction,
  hebarPopReadyActions,
  hebarIsWithinApmLimit,
  hebarClampReactionDelayMs,
  hebarStepCursorTrajectory,
  hebarClampAngularSlew,
  hebarVerifyZeroTampering,
  connectTargetWindow,
  renderHebarRefereeDashboard,
  exportHebarTelemetryJson,
  hebarQuantizeFloat,
  hebarHashInt,
  hebarHashFloat,
  hebarVerifyDeterminism,
  hebarStepDamageTrail
} from "std/ai/hebar_referee"
