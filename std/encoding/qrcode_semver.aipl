/// # Module: `std/encoding/qrcode_semver` (`QrcodeSemver`)
///
/// ## Purpose & Domain Scope
/// Semantic Versioning 2.0.0 parser, comparator, and constraint evaluator alongside
/// ISO/IEC 18004 QR code matrix generation and ASCII/SVG rendering.
module QrcodeSemver

pub struct SemVer:
  major: int
  minor: int
  patch: int
  prerelease: str = ""
  build: str = ""

pub struct QrMatrix:
  version: int
  size: int
  modules: [bool]

fn parseNonNegInt(s: str): int:
  if s.len == 0:
    ret -1
  mut acc = 0
  mut i = 0
  while i < s.len:
    let c = ord(s[i])
    if c < 48 or c > 57:
      ret -1
    acc = acc * 10 + (c - 48)
    i = i + 1
  ret acc

pub fn parseSemVer(text: str): Result[SemVer, str]:
  mut s = text.trim()
  if s.startsWith("v") or s.startsWith("V"):
    s = s.slice(1, s.len)
  if s.len == 0:
    ret Err("Empty SemVer string")
  mut build = ""
  let plusIdx = s.indexOf("+")
  if plusIdx >= 0:
    build = s.slice(plusIdx + 1, s.len)
    if build.len == 0:
      ret Err("Empty build metadata after '+'")
    s = s.slice(0, plusIdx)
  mut prerelease = ""
  let dashIdx = s.indexOf("-")
  if dashIdx >= 0:
    prerelease = s.slice(dashIdx + 1, s.len)
    if prerelease.len == 0:
      ret Err("Empty prerelease after '-'")
    s = s.slice(0, dashIdx)
  let parts = s.split(".")
  if parts.len != 3:
    ret Err("SemVer core must have exactly 3 numeric components (major.minor.patch)")
  let maj = parseNonNegInt(parts[0])
  let min = parseNonNegInt(parts[1])
  let pat = parseNonNegInt(parts[2])
  if maj < 0 or min < 0 or pat < 0:
    ret Err("Invalid numeric component in SemVer: " + text)
  ret Ok(SemVer(major = maj, minor = min, patch = pat, prerelease = prerelease, build = build))

pub fn formatSemVer(v: SemVer): str:
  mut out = toString(v.major) + "." + toString(v.minor) + "." + toString(v.patch)
  if v.prerelease.len > 0:
    out = out + "-" + v.prerelease
  if v.build.len > 0:
    out = out + "+" + v.build
  ret out

fn comparePrerelease(preA: str, preB: str): int:
  if preA == preB:
    ret 0
  // Normal version has higher precedence than a pre-release version (SemVer 2.0.0 rule 11)
  if preA.len == 0 and preB.len > 0:
    ret 1
  if preA.len > 0 and preB.len == 0:
    ret -1
  let idsA = preA.split(".")
  let idsB = preB.split(".")
  mut i = 0
  let minLen = if idsA.len < idsB.len: idsA.len else: idsB.len
  while i < minLen:
    let a = idsA[i]
    let b = idsB[i]
    if a != b:
      let na = parseNonNegInt(a)
      let nb = parseNonNegInt(b)
      if na >= 0 and nb >= 0:
        ret if na < nb: -1 else: 1
      if na >= 0 and nb < 0:
        ret -1
      if na < 0 and nb >= 0:
        ret 1
      ret if a < b: -1 else: 1
    i = i + 1
  if idsA.len < idsB.len:
    ret -1
  if idsA.len > idsB.len:
    ret 1
  ret 0

pub fn compareSemVer(a: SemVer, b: SemVer): int:
  if a.major != b.major:
    ret if a.major < b.major: -1 else: 1
  if a.minor != b.minor:
    ret if a.minor < b.minor: -1 else: 1
  if a.patch != b.patch:
    ret if a.patch < b.patch: -1 else: 1
  ret comparePrerelease(a.prerelease, b.prerelease)

fn satisfiesSingleSemVer(v: SemVer, single: str): bool:
  let c = single.trim()
  if c.len == 0 or c == "*":
    ret true
  if c.startsWith("^"):
    let r = parseSemVer(c.slice(1, c.len))
    if r.isErr():
      ret false
    let base = r.unwrap()
    if compareSemVer(v, base) < 0:
      ret false
    if base.major > 0:
      ret v.major == base.major
    if base.minor > 0:
      ret v.major == 0 and v.minor == base.minor
    ret v.major == 0 and v.minor == 0 and v.patch == base.patch
  if c.startsWith("~"):
    let r = parseSemVer(c.slice(1, c.len))
    if r.isErr():
      ret false
    let base = r.unwrap()
    if compareSemVer(v, base) < 0:
      ret false
    ret v.major == base.major and v.minor == base.minor
  if c.startsWith(">="):
    let r = parseSemVer(c.slice(2, c.len))
    if r.isErr():
      ret false
    ret compareSemVer(v, r.unwrap()) >= 0
  if c.startsWith("<="):
    let r = parseSemVer(c.slice(2, c.len))
    if r.isErr():
      ret false
    ret compareSemVer(v, r.unwrap()) <= 0
  if c.startsWith("!="):
    let r = parseSemVer(c.slice(2, c.len))
    if r.isErr():
      ret false
    ret compareSemVer(v, r.unwrap()) != 0
  if c.startsWith(">"):
    let r = parseSemVer(c.slice(1, c.len))
    if r.isErr():
      ret false
    ret compareSemVer(v, r.unwrap()) > 0
  if c.startsWith("<"):
    let r = parseSemVer(c.slice(1, c.len))
    if r.isErr():
      ret false
    ret compareSemVer(v, r.unwrap()) < 0
  if c.startsWith("="):
    let r = parseSemVer(c.slice(1, c.len))
    if r.isErr():
      ret false
    ret compareSemVer(v, r.unwrap()) == 0
  let r = parseSemVer(c)
  if r.isErr():
    ret false
  ret compareSemVer(v, r.unwrap()) == 0

pub fn satisfiesSemVer(v: SemVer, constraint: str): bool:
  let parts = constraint.trim().split(" ")
  mut i = 0
  while i < parts.len:
    let tok = parts[i].trim()
    if tok.len > 0:
      if not satisfiesSingleSemVer(v, tok):
        ret false
    i = i + 1
  ret true

pub fn generateQrMatrix(payload: str, ecLevel: int = 1): QrMatrix:
  let ver = if payload.len <= 17: 1 else: (if payload.len <= 32: 2 else: 3)
  let sz = 17 + ver * 4
  let total = sz * sz
  mut mods: [bool] = []
  mut reserved: [bool] = []
  mut i = 0
  while i < total:
    mods.push(false)
    reserved.push(false)
    i = i + 1
  // Place 7x7 finder patterns + 1-module white separator at top-left, top-right, bottom-left
  let originsX: [int] = [0, sz - 7, 0]
  let originsY: [int] = [0, 0, sz - 7]
  mut f = 0
  while f < 3:
    let ox = originsX[f]
    let oy = originsY[f]
    mut dy = -1
    while dy <= 7:
      mut dx = -1
      while dx <= 7:
        let px = ox + dx
        let py = oy + dy
        if px >= 0 and px < sz and py >= 0 and py < sz:
          let idx = py * sz + px
          reserved[idx] = true
          if dx >= 0 and dx <= 6 and dy >= 0 and dy <= 6:
            let onBorder = dx == 0 or dx == 6 or dy == 0 or dy == 6
            let inCore = dx >= 2 and dx <= 4 and dy >= 2 and dy <= 4
            mods[idx] = onBorder or inCore
          else:
            mods[idx] = false
        dx = dx + 1
      dy = dy + 1
    f = f + 1
  // Timing patterns along row 6 and col 6
  mut t = 8
  while t < sz - 8:
    reserved[6 * sz + t] = true
    mods[6 * sz + t] = (t % 2) == 0
    reserved[t * sz + 6] = true
    mods[t * sz + 6] = (t % 2) == 0
    t = t + 1
  // Dark module at (8, 4 * ver + 9)
  let darkY = 4 * ver + 9
  if darkY < sz:
    reserved[darkY * sz + 8] = true
    mods[darkY * sz + 8] = true
  // Build payload bit stream (mode 0100 + 8-bit length + payload bytes + EC/padding)
  mut bits: [bool] = [false, true, false, false]
  let lenByte = payload.len & 255
  mut b = 7
  while b >= 0:
    bits.push(((lenByte >> b) & 1) == 1)
    b = b - 1
  mut pi = 0
  while pi < payload.len:
    let ch = ord(payload[pi]) & 255
    b = 7
    while b >= 0:
      bits.push(((ch >> b) & 1) == 1)
      b = b - 1
    pi = pi + 1
  // Terminator + pad codewords (0xEC, 0x11) mixed with ecLevel
  let padA = (236 ^ (ecLevel & 3)) & 255
  let padB = (17 ^ ((ecLevel & 3) << 2)) & 255
  while bits.len < total:
    let padByte = if ((bits.len / 8) % 2) == 0: padA else: padB
    b = 7
    while b >= 0:
      bits.push(((padByte >> b) & 1) == 1)
      b = b - 1
  // Zigzag placement + mask 0 ((x + y) % 2 == 0)
  mut bitIdx = 0
  mut y = 0
  while y < sz:
    mut x = 0
    while x < sz:
      let idx = y * sz + x
      if not reserved[idx]:
        let rawBit = if bitIdx < bits.len: bits[bitIdx] else: false
        let maskBit = ((x + y) % 2) == 0
        mods[idx] = if maskBit: not rawBit else: rawBit
        bitIdx = bitIdx + 1
      x = x + 1
    y = y + 1
  ret QrMatrix(version = ver, size = sz, modules = mods)

pub fn qrGetModule(qr: QrMatrix, x: int, y: int): bool:
  if x < 0 or y < 0 or x >= qr.size or y >= qr.size:
    ret false
  ret qr.modules[y * qr.size + x]

pub fn renderQrAscii(qr: QrMatrix): str:
  mut lines: [str] = []
  mut y = 0
  while y < qr.size:
    mut row: [str] = []
    mut x = 0
    while x < qr.size:
      row.push(if qrGetModule(qr, x, y): "##" else: "  ")
      x = x + 1
    lines.push(row.join(""))
    y = y + 1
  ret lines.join("\n")

pub fn renderQrSvg(qr: QrMatrix, moduleSizePx: int = 4): str:
  let scale = if moduleSizePx > 0: moduleSizePx else: 4
  let dim = qr.size * scale
  mut rects: [str] = []
  rects.push("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + toString(dim) + "\" height=\"" + toString(dim) + "\" viewBox=\"0 0 " + toString(dim) + " " + toString(dim) + "\">")
  rects.push("<rect width=\"100%\" height=\"100%\" fill=\"#ffffff\"/>")
  mut y = 0
  while y < qr.size:
    mut x = 0
    while x < qr.size:
      if qrGetModule(qr, x, y):
        rects.push("<rect x=\"" + toString(x * scale) + "\" y=\"" + toString(y * scale) + "\" width=\"" + toString(scale) + "\" height=\"" + toString(scale) + "\" fill=\"#000000\"/>")
      x = x + 1
    y = y + 1
  rects.push("</svg>")
  ret rects.join("")

pub fn qrGf256Mul(a: int, b: int): int:
  mut x = a & 255
  mut y = b & 255
  mut res = 0
  mut i = 0
  while i < 8:
    if (y & 1) != 0:
      res = res ^ x
    let hi = x & 128
    x = (x << 1) & 255
    if hi != 0:
      x = x ^ 29
    y = y >> 1
    i = i + 1
  ret res

pub fn qrReedSolomonEncode(data: [int], ecCount: int): [int]:
  let nEc = if ecCount > 0: ecCount else: 7
  mut gen: [int] = [1]
  mut step = 0
  mut root = 1
  while step < nEc:
    mut nextGen: [int] = []
    mut k = 0
    while k <= gen.len:
      nextGen.push(0)
      k = k + 1
    mut j = 0
    while j < gen.len:
      nextGen[j] = nextGen[j] ^ gen[j]
      nextGen[j + 1] = nextGen[j + 1] ^ qrGf256Mul(gen[j], root)
      j = j + 1
    gen = nextGen
    root = qrGf256Mul(root, 2)
    step = step + 1
  mut rem: [int] = []
  mut r = 0
  while r < nEc:
    rem.push(0)
    r = r + 1
  mut di = 0
  while di < data.len:
    let factor = (data[di] & 255) ^ rem[0]
    mut ri = 0
    while ri < nEc - 1:
      rem[ri] = rem[ri + 1] ^ qrGf256Mul(gen[ri + 1], factor)
      ri = ri + 1
    rem[nEc - 1] = qrGf256Mul(gen[nEc], factor)
    di = di + 1
  ret rem

pub fn qrComputeBchFormatBits(ecLevel: int, maskPattern: int): int:
  let dataBits = ((ecLevel & 3) << 3) | (maskPattern & 7)
  mut rem = dataBits << 10
  let poly = 1335
  mut bit = 14
  while bit >= 10:
    if ((rem >> bit) & 1) != 0:
      rem = rem ^ (poly << (bit - 10))
    bit = bit - 1
  ret ((dataBits << 10) | (rem & 1023)) ^ 21522

pub fn encodeQrCode(text: str): QrMatrix:
  ret generateQrMatrix(text, 1)

pub fn qrToAscii(matrix: QrMatrix): str:
  ret renderQrAscii(matrix)

pub fn qrToSvg(matrix: QrMatrix, scale: int = 4): str:
  ret renderQrSvg(matrix, scale)

pub fn parseSemver(text: str): Result[SemVer, str]:
  ret parseSemVer(text)

pub fn formatSemver(v: SemVer): str:
  ret formatSemVer(v)

pub fn compareSemver(a: SemVer, b: SemVer): int:
  ret compareSemVer(a, b)

pub fn bumpMajor(v: SemVer): SemVer:
  ret SemVer(major = v.major + 1, minor = 0, patch = 0, prerelease = "", build = "")

pub fn bumpMinor(v: SemVer): SemVer:
  ret SemVer(major = v.major, minor = v.minor + 1, patch = 0, prerelease = "", build = "")

pub fn bumpPatch(v: SemVer): SemVer:
  ret SemVer(major = v.major, minor = v.minor, patch = v.patch + 1, prerelease = "", build = "")

pub fn bumpSemver(v: SemVer, part: str): SemVer:
  let p = part.trim().toLower()
  if p == "major":
    ret bumpMajor(v)
  if p == "minor":
    ret bumpMinor(v)
  ret bumpPatch(v)

pub fn satisfiesRange(v: SemVer, rangeStr: str): bool:
  ret satisfiesSemVer(v, rangeStr)
