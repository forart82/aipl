/// # Module: `std/encoding/encoding_mod` (`EncodingMod`)
///
/// ## Purpose & Domain Scope
/// Root aggregator for `std/encoding`: JSON, Bincode/MessagePack, Base64, Hex, CSV/TSV,
/// TOML, YAML, XML, HTML5 DOM, INI/.env, Markdown, SemVer 2.0.0, and QR code matrices.
module EncodingMod

pub import * from "./json.aipl"
pub import * from "./bincode.aipl"
pub import * from "./base64.aipl"
pub import * from "./hex.aipl"
pub import * from "./csv.aipl"
pub import * from "./toml.aipl"
pub import * from "./yaml.aipl"
pub import * from "./xml.aipl"
pub import * from "./html_dom.aipl"
pub import * from "./ini_dotenv.aipl"
pub import * from "./markdown.aipl"
pub import * from "./qrcode_semver.aipl"

pub const ENCODING_MODULE_VERSION: int = 1
