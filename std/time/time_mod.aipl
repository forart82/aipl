// ============================================================================
// Module: std/time/time_mod (TimeMod)
// Layer 1 (Core Primitives & Math) — Time, Clocks, Calendars & Pacing Barrel
// ============================================================================
module TimeMod

pub import std.time.instant
pub import std.time.duration
pub import std.time.datetime
pub import std.time.cooldown_timer
pub import std.time.frame_pacer
pub import std.time.cron_schedule

import { nowUnixMs, nowMonoNs, sleepMs } from "./instant"
import { Duration, NANOS_PER_MILLI } from "./duration"
import { DateTimeUtc, unixToDateTimeUtc } from "./datetime"

pub fn epochSeconds(): int:
  ret nowUnixMs() / 1000

pub fn epochMillis(): int:
  ret nowUnixMs()

pub fn epochNanos(): int:
  let mono = nowMonoNs()
  let ms = nowUnixMs()
  if ms > 0:
    ret ms * NANOS_PER_MILLI
  ret mono

pub fn nowUtc(): DateTimeUtc:
  let ms = nowUnixMs()
  let sec = ms / 1000
  let remNs = (ms % 1000) * NANOS_PER_MILLI
  ret unixToDateTimeUtc(sec, remNs)

pub fn sleep(duration: Duration): void:
  let ms = duration.toMillis()
  if ms > 0:
    sleepMs(ms)
