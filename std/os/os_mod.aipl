/// # Module: `std/os/os_mod` (`OsMod`)
///
/// ## Purpose & Domain Scope
/// Unified barrel module re-exporting CLI argument parsing, ANSI terminal rendering,
/// environment & platform inspection, subprocess execution, and POSIX signal coordination.
module OsMod

pub import * from "std/os/cli_args"
pub import * from "std/os/ansi_term"
pub import * from "std/os/env"
pub import * from "std/os/process"
pub import * from "std/os/signal"
