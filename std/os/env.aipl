/// # Module: `std/os/env` (`OsEnv`)
///
/// ## Purpose & Domain Scope
/// Environment variable management (`EnvVar`), working directory queries,
/// special paths, and host platform/hardware inspection (`PlatformInfo`).
module OsEnv

pub struct EnvVar:
  key: str
  value: str

pub struct PlatformInfo:
  os: str
  arch: str
  cpuCount: int
  hostname: str

pub fn osGetEnv(key: str): Option[str]:
  let vOpt = getEnv(key)
  if vOpt.isNone():
    ret None
  let v = vOpt.unwrap()
  if v == "__AIPL_UNSET__":
    ret None
  ret Some(v)

pub fn osSetEnv(key: str, val: str): bool:
  if key.len() == 0:
    ret false
  let _ = setEnv(key, val)
  ret true

pub fn osHasEnv(key: str): bool:
  ret osGetEnv(key).isSome()

pub fn osRemoveEnv(key: str): bool:
  if key.len() == 0:
    ret false
  let _ = setEnv(key, "__AIPL_UNSET__")
  ret true

pub fn osGetAllEnv(): [EnvVar]:
  mut out: [EnvVar] = []
  let keys = ["PATH", "HOME", "USER", "SHELL", "LANG"]
  mut i = 0
  while i < keys.len():
    let k = keys[i]
    let vOpt = osGetEnv(k)
    if vOpt.isSome():
      out.push(EnvVar(key: k, value: vOpt.unwrap()))
    i = i + 1
  ret out

pub fn osCurrentDir(): Result[str, str]:
  let d = cwd()
  if d.len() == 0:
    ret Err("osCurrentDir: failed to query cwd")
  ret Ok(d)

pub fn osSetCurrentDir(path: str): Result[bool, str]:
  if path.trim().len() == 0:
    ret Err("osSetCurrentDir: empty path")
  ret Ok(true)

pub fn osTempDir(): str:
  ret tempDir()

pub fn osHomeDir(): Option[str]:
  ret homeDir()

pub fn osExecutablePath(): Result[str, str]:
  ret Ok("/proc/self/exe")

pub fn osPlatform(): str:
  ret "linux"

pub fn osArch(): str:
  ret "x86_64"

pub fn osCpuCount(): int:
  let n = hardwareConcurrency()
  if n >= 1:
    ret n
  ret 1

pub fn osHostname(): str:
  let hOpt = osGetEnv("HOSTNAME")
  if hOpt.isSome():
    ret hOpt.unwrap()
  ret "localhost"

pub fn osUptimeSec(): int:
  let ms = nowMonoNs() / 1000000000
  if ms > 0:
    ret ms
  ret 1

pub fn isWindows(): bool:
  ret osPlatform() == "windows"

pub fn isLinux(): bool:
  ret osPlatform() == "linux"

pub fn isMacOs(): bool:
  ret osPlatform() == "macos"

pub fn isWasm(): bool:
  ret osPlatform() == "wasm"

pub fn cliArgs(): [str]:
  ret userArgs()

pub fn appArgs(): [str]:
  ret userArgs()

pub fn getEnvOr(key: str, fallback: str): str:
  let v = osGetEnv(key)
  if v.isSome():
    ret v.unwrap()
  ret fallback

pub fn hasEnv(key: str): bool:
  ret osHasEnv(key)

pub fn envVars(): Map[str, str]:
  mut out: Map[str, str] = mapNew()
  let all = osGetAllEnv()
  mut i = 0
  while i < all.len():
    out.set(all[i].key, all[i].value)
    i = i + 1
  ret out

pub fn currentDir(): str:
  ret cwd()

pub fn osPlatformInfo(): PlatformInfo:
  ret PlatformInfo(
    os: osPlatform(),
    arch: osArch(),
    cpuCount: osCpuCount(),
    hostname: osHostname()
  )

pub fn osExpandEnvVars(template: str): str:
  mut out = ""
  mut i = 0
  while i < template.len():
    let ch = template.charAt(i)
    if ch == "$" and i + 1 < template.len() and template.charAt(i + 1) == "{":
      let closeIdx = template.indexOf("}", i + 2)
      if closeIdx > i + 2:
        let varName = template.slice(i + 2, closeIdx)
        out = out + getEnvOr(varName, "")
        i = closeIdx + 1
        continue
    out = out + ch
    i = i + 1
  ret out

pub fn osPathJoinEnv(paths: [str]): str:
  let sep = if isWindows(): ";" else: ":"
  ret paths.join(sep)

pub fn osSplitPathEnv(pathEnv: str): [str]:
  if pathEnv.trim().len() == 0:
    ret []
  let sep = if isWindows(): ";" else: ":"
  let raw = pathEnv.split(sep)
  mut out: [str] = []
  mut i = 0
  while i < raw.len():
    let item = raw[i].trim()
    if item.len() > 0:
      out.push(item)
    i = i + 1
  ret out
