/// # Module: `std/phys2d/phys2d_mod` (`Phys2DMod`)
///
/// ## Purpose & Domain Scope
/// Unified barrel module re-exporting the full 2D physics and fluid API.
module Phys2DMod

pub import {
  BodyType2D, MassProperties2D, RigidBody2D, rigidBody2dNew,
  rigidBody2dSetMass, rigidBody2dApplyForce, rigidBody2dApplyLinearImpulse,
  rigidBody2dApplyAngularImpulse, rigidBody2dIntegrateVelocity,
  rigidBody2dIntegratePosition
} from "std/phys2d/rigid_body2d"

pub import {
  ColliderShapeType2D, PhysicsMaterial2D, Collider2D,
  circleColliderNew, boxColliderNew, capsuleColliderNew,
  polygonColliderNew, colliderComputeAABB
} from "std/phys2d/collider2d"

pub import {
  BroadphasePair2D, DynamicAABBNode2D, DynamicAABBTree2D,
  dynamicAABBTreeNew, dynamicAABBTreeInsert, dynamicAABBTreeUpdate,
  dynamicAABBTreeRemove, dynamicAABBTreeFindPairs
} from "std/phys2d/broadphase2d"

pub import {
  ContactPoint2D, ContactManifold2D, testCircleCircle,
  testCircleBoxSAT, testBoxBoxSAT, testGjkEpa2D
} from "std/phys2d/narrowphase2d"

pub import {
  JointType2D, Joint2D, distanceJointNew, springJointNew,
  revoluteJointNew, jointSolveVelocity, jointSolvePosition
} from "std/phys2d/joint2d"

pub import {
  RayHit2D, raycast2dSegment, raycast2dCircle,
  raycast2dBox, shapeCastCircle2D
} from "std/phys2d/phys_query2d"

pub import {
  VerletParticle2D, VerletStick2D, VerletClothGrid2D,
  verletParticleNew, verletClothGridNew, verletStepSimulation
} from "std/phys2d/verlet2d"

pub import {
  SphParticle2D, SphFluidWorld2D, CellularSandGrid2D,
  sphFluidWorldNew, sphFluidStep, cellularSandStep
} from "std/phys2d/fluid2d"

pub import {
  PhysWorldSettings2D, PhysicsWorld2D, physWorld2dNew,
  physWorld2dAddBody, physWorld2dAddCollider, physWorld2dAddJoint,
  physWorld2dStep
} from "std/phys2d/phys_world2d"
