/// # Module: `std/spatial/ortho_tile_world2d` (`OrthoTileWorld2DMod`)
///
/// ## Purpose & Domain Scope
/// Orthogonal 2D tile world supporting multi-layer integer tile grids,
/// Bresenham line-of-sight, BFS flood fill, and 2D DDA raycasting.
module OrthoTileWorld2DMod

import { absInt, absFloat, minFloat } from "../math/consts"
import { floor, sqrt } from "../math/trig"
import { Vec2, IVec2 } from "../math/vec_math"
pub import {
  Grid2D, SpatialGrid2D,
  gridNew, gridInBounds, gridGet, gridSet, gridGetWrapped,
  gridNeighbors4, gridNeighbors8, gridFloodFill, gridCountLineOfSight,
  grid2dNew, grid2dInBounds, grid2dGet, grid2dSet, grid2dRow, grid2dCol,
  grid2dCollapseRows, grid2dRayCount, grid2dRotate90CW, grid2dFlipHorizontal,
  grid2dNeighbors4, grid2dNeighbors8,
  spatialGridNew, spatialGridInsert, spatialGridQuery, spatialGridQueryRadius, spatialGridClear,
  gridLineOfSight
} from "../ai/pathfind"

pub struct OrthoTileCell2D(tileId: int, solid: bool, elevation: float, flags: int, userData: int)

pub struct OrthoTileWorld2D(width: int, height: int, cellSize: float, layers: int, cells: [OrthoTileCell2D], wrapX: bool, wrapY: bool)

pub fn orthoTileWorldNew(width: int, height: int, cellSize: float, layers: int): OrthoTileWorld2D:
  let total = layers * width * height
  mut cells: [OrthoTileCell2D] = []
  let emptyCell = OrthoTileCell2D(tileId = 0, solid = false, elevation = 0.0, flags = 0, userData = 0)
  mut i = 0
  while i < total:
    cells.push(emptyCell)
    i = i + 1
  ret OrthoTileWorld2D(
    width = width,
    height = height,
    cellSize = cellSize,
    layers = layers,
    cells = cells,
    wrapX = false,
    wrapY = false
  )

fn resolveOrthoCoords(world: OrthoTileWorld2D, layer: int, col: int, row: int): int:
  if layer < 0 or layer >= world.layers or world.width <= 0 or world.height <= 0:
    ret -1
  mut c = col
  mut r = row
  if world.wrapX:
    c = ((c % world.width) + world.width) % world.width
  else:
    if c < 0 or c >= world.width:
      ret -1
  if world.wrapY:
    r = ((r % world.height) + world.height) % world.height
  else:
    if r < 0 or r >= world.height:
      ret -1
  ret (layer * world.height + r) * world.width + c

pub fn orthoTileGet(world: OrthoTileWorld2D, layer: int, col: int, row: int): Option[OrthoTileCell2D]:
  let idx = resolveOrthoCoords(world, layer, col, row)
  if idx < 0 or idx >= world.cells.len:
    ret None
  ret Some(world.cells[idx])

pub fn orthoTileSet(mut world: OrthoTileWorld2D, layer: int, col: int, row: int, cell: OrthoTileCell2D): bool:
  let idx = resolveOrthoCoords(world, layer, col, row)
  if idx < 0 or idx >= world.cells.len:
    ret false
  mut cArr = world.cells
  cArr[idx] = cell
  world.cells = cArr
  ret true

pub fn orthoWorldToCell(world: OrthoTileWorld2D, wx: float, wy: float): IVec2:
  let cs = if world.cellSize > 0.0: world.cellSize else: 1.0
  ret IVec2(
    x = int(floor(wx / cs)),
    y = int(floor(wy / cs))
  )

pub fn orthoCellToWorldCenter(world: OrthoTileWorld2D, col: int, row: int): Vec2:
  ret Vec2(
    x = (float(col) + 0.5) * world.cellSize,
    y = (float(row) + 0.5) * world.cellSize
  )

pub fn orthoNeighbors4(world: OrthoTileWorld2D, col: int, row: int): [IVec2]:
  mut out: [IVec2] = []
  let dxs = [0, 1, 0, -1]
  let dys = [-1, 0, 1, 0]
  mut i = 0
  while i < 4:
    let nc = col + dxs[i]
    let nr = row + dys[i]
    if resolveOrthoCoords(world, 0, nc, nr) >= 0:
      out.push(IVec2(x = nc, y = nr))
    i = i + 1
  ret out

pub fn orthoNeighbors8(world: OrthoTileWorld2D, col: int, row: int): [IVec2]:
  mut out: [IVec2] = []
  mut dy = -1
  while dy <= 1:
    mut dx = -1
    while dx <= 1:
      if not (dx == 0 and dy == 0):
        let nc = col + dx
        let nr = row + dy
        if resolveOrthoCoords(world, 0, nc, nr) >= 0:
          out.push(IVec2(x = nc, y = nr))
      dx = dx + 1
    dy = dy + 1
  ret out

pub fn orthoLineOfSightBresenham(world: OrthoTileWorld2D, layer: int, c0: int, r0: int, c1: int, r1: int): bool:
  mut x = c0
  mut y = r0
  let dx = absInt(c1 - c0)
  let dy = absInt(r1 - r0)
  let sx = if c0 < c1: 1 else: -1
  let sy = if r0 < r1: 1 else: -1
  mut err = dx - dy

  while true:
    let opt = orthoTileGet(world, layer, x, y)
    if opt.isNone():
      ret false
    let cell: OrthoTileCell2D = opt.unwrap()
    if cell.solid:
      ret false
    if x == c1 and y == r1:
      ret true
    let e2 = 2 * err
    if e2 > -dy:
      err = err - dy
      x = x + sx
    if e2 < dx:
      err = err + dx
      y = y + sy
  ret true

pub fn orthoFloodFill(mut world: OrthoTileWorld2D, layer: int, startCol: int, startRow: int, targetTileId: int, fillTileId: int): int:
  if targetTileId == fillTileId:
    ret 0
  let startOpt = orthoTileGet(world, layer, startCol, startRow)
  if startOpt.isNone():
    ret 0
  let startCell: OrthoTileCell2D = startOpt.unwrap()
  if startCell.tileId != targetTileId:
    ret 0

  mut queue: [IVec2] = [IVec2(x = startCol, y = startRow)]
  orthoTileSet(world, layer, startCol, startRow, OrthoTileCell2D(
    tileId = fillTileId,
    solid = startCell.solid,
    elevation = startCell.elevation,
    flags = startCell.flags,
    userData = startCell.userData
  ))
  mut painted = 1
  mut head = 0
  while head < queue.len:
    let curr: IVec2 = queue[head]
    head = head + 1
    let nbrs = orthoNeighbors4(world, curr.x, curr.y)
    mut i = 0
    while i < nbrs.len:
      let nb: IVec2 = nbrs[i]
      let nbOpt = orthoTileGet(world, layer, nb.x, nb.y)
      if nbOpt.isSome():
        let nbCell: OrthoTileCell2D = nbOpt.unwrap()
        if nbCell.tileId == targetTileId:
          orthoTileSet(world, layer, nb.x, nb.y, OrthoTileCell2D(
            tileId = fillTileId,
            solid = nbCell.solid,
            elevation = nbCell.elevation,
            flags = nbCell.flags,
            userData = nbCell.userData
          ))
          painted = painted + 1
          queue.push(nb)
      i = i + 1
  ret painted

pub fn orthoRaycastCells(world: OrthoTileWorld2D, layer: int, start: Vec2, dir: Vec2, maxDist: float): [IVec2]:
  mut out: [IVec2] = []
  let cs = if world.cellSize > 0.0: world.cellSize else: 1.0
  let lenDir = sqrt(dir.x * dir.x + dir.y * dir.y)
  if lenDir <= 0.000001 or maxDist <= 0.0:
    ret out
  let dx = dir.x / lenDir
  let dy = dir.y / lenDir

  mut cx = int(floor(start.x / cs))
  mut cy = int(floor(start.y / cs))
  let stepX = if dx >= 0.0: 1 else: -1
  let stepY = if dy >= 0.0: 1 else: -1

  let nextBoundX = if stepX > 0: float(cx + 1) * cs else: float(cx) * cs
  let nextBoundY = if stepY > 0: float(cy + 1) * cs else: float(cy) * cs

  mut tMaxX = if absFloat(dx) > 0.000001: (nextBoundX - start.x) / dx else: 1000000000.0
  mut tMaxY = if absFloat(dy) > 0.000001: (nextBoundY - start.y) / dy else: 1000000000.0
  let tDeltaX = if absFloat(dx) > 0.000001: cs / absFloat(dx) else: 1000000000.0
  let tDeltaY = if absFloat(dy) > 0.000001: cs / absFloat(dy) else: 1000000000.0

  mut t = 0.0
  while t <= maxDist:
    if resolveOrthoCoords(world, layer, cx, cy) >= 0:
      out.push(IVec2(x = cx, y = cy))
    if tMaxX < tMaxY:
      t = tMaxX
      tMaxX = tMaxX + tDeltaX
      cx = cx + stepX
    else:
      t = tMaxY
      tMaxY = tMaxY + tDeltaY
      cy = cy + stepY
  ret out
