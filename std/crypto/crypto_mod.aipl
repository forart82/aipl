/// # Module: `std/crypto/crypto_mod` (`CryptoMod`)
///
/// ## Purpose & Domain Scope
/// Unified barrel module for `std/crypto/` re-exporting cryptographic digests,
/// HMACs, KDFs, AEAD ciphers, CSPRNG/UUID generators, and TLS 1.3 record utilities.
module CryptoMod

import {
  Sha256Hasher,
  Sha512Hasher,
  Blake3Hasher,
  XxHash64,
  sha256,
  sha256Str,
  sha512,
  sha512Str,
  blake3,
  blake3Str,
  fnv1a64,
  xxhash64,
  siphash24,
  crc32,
  sha256HasherNew
} from "./hash.aipl"

import {
  HmacSha256,
  hmacSha256,
  hmacSha256Str,
  hmacSha512,
  hmacSha512Str,
  constantTimeEqual,
  constantTimeEqualStr
} from "./hmac.aipl"

import {
  Pbkdf2Params,
  Argon2Params,
  hkdfExtract,
  hkdfExpand,
  hkdfSha256,
  pbkdf2HmacSha256,
  argon2idHash,
  argon2idVerify
} from "./kdf.aipl"

import {
  AeadCiphertext,
  chacha20Poly1305Encrypt,
  chacha20Poly1305Decrypt,
  aes256GcmEncrypt,
  aes256GcmDecrypt,
  zeroize
} from "./aead.aipl"

import {
  CsprngStream,
  Uuid,
  csprngRandomBytes,
  csprngRandomInt,
  csprngRandomFloat,
  uuidNil,
  uuidV4,
  uuidV7,
  isValidUuid,
  parseUuid,
  ulidGenerate
} from "./csprng.aipl"

import {
  TlsRecord,
  TlsClientHello,
  X509Cert,
  tlsFrameRecord,
  tlsParseRecord,
  tlsBuildClientHello,
  verifyX509Validity
} from "./tls.aipl"

pub fn sha256Hex(data: str): str:
  ret sha256Str(data)

pub fn sha512Hex(data: str): str:
  ret sha512Str(data)

pub fn blake3Hex(data: str): str:
  ret blake3Str(data)

pub fn hmacSha256Hex(key: str, msg: str): str:
  ret hmacSha256Str(key, msg)
