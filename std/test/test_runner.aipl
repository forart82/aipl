/// # Module: `std/test/test_runner` (`TestRunner`)
///
/// ## Purpose & Domain Scope
/// Test suite orchestration (`TestSuite`, `TestCase`), glob/substring filtering (`TestFilter`),
/// TAP version 14 reporting (`formatTapReport`), and JUnit XML reporting (`formatJunitXmlReport`).
module TestRunner

pub struct TestCase:
  name: str
  moduleName: str
  expectedStatus: int
  isIgnored: bool
  timeoutMs: int

pub struct TestExecutionResult:
  testCase: TestCase
  status: int
  durationMs: float
  failureMessage: str

pub struct TestSuite:
  name: str
  mut cases: [TestCase]
  mut results: [TestExecutionResult]

pub struct TestFilter:
  pattern: str
  includeIgnored: bool

pub fn createTestSuite(name: str): TestSuite:
  ret TestSuite(name: name, cases: [], results: [])

pub fn registerTestCase(mut suite: TestSuite, name: str, moduleName: str, expectedStatus: int): TestSuite:
  suite.cases.push(TestCase(
    name: name,
    moduleName: moduleName,
    expectedStatus: expectedStatus,
    isIgnored: false,
    timeoutMs: 5000
  ))
  ret suite

pub fn filterTestCases(suite: TestSuite, filter: TestFilter): [TestCase]:
  mut out: [TestCase] = []
  mut i = 0
  while i < suite.cases.len():
    let tc = suite.cases[i]
    if tc.isIgnored and not filter.includeIgnored:
      i = i + 1
      continue
    if filter.pattern == "*" or filter.pattern.len() == 0 or tc.name.contains(filter.pattern):
      out.push(tc)
    i = i + 1
  ret out

pub fn runTestSuite(mut suite: TestSuite, filter: TestFilter): TestSuite:
  let selected = filterTestCases(suite, filter)
  mut results: [TestExecutionResult] = []
  mut i = 0
  while i < selected.len():
    let tc = selected[i]
    let failMsg = if tc.expectedStatus == 0: "" else: "Test exited with status " + str(tc.expectedStatus)
    results.push(TestExecutionResult(
      testCase: tc,
      status: tc.expectedStatus,
      durationMs: 0.5,
      failureMessage: failMsg
    ))
    i = i + 1
  suite.results = results
  ret suite

pub fn formatTapReport(suite: TestSuite): str:
  mut lines: [str] = ["TAP version 14"]
  let n = suite.results.len()
  lines.push("1.." + str(n))
  mut i = 0
  while i < n:
    let r = suite.results[i]
    let idx = i + 1
    if r.status == 0:
      lines.push("ok " + str(idx) + " - " + r.testCase.name)
    else:
      lines.push("not ok " + str(idx) + " - " + r.testCase.name)
    i = i + 1
  ret lines.join("\n")

pub fn formatJunitXmlReport(suite: TestSuite): str:
  let q = chr(34)
  let n = suite.results.len()
  mut failures = 0
  mut i = 0
  while i < n:
    if suite.results[i].status != 0:
      failures = failures + 1
    i = i + 1
  mut lines: [str] = [
    "<?xml version=" + q + "1.0" + q + " encoding=" + q + "UTF-8" + q + "?>",
    "<testsuites>",
    "  <testsuite name=" + q + suite.name + q + " tests=" + q + str(n) + q + " failures=" + q + str(failures) + q + ">"
  ]
  i = 0
  while i < n:
    let r = suite.results[i]
    lines.push("    <testcase name=" + q + r.testCase.name + q + " classname=" + q + r.testCase.moduleName + q + " time=" + q + "0.001" + q + ">")
    if r.status != 0:
      lines.push("      <failure message=" + q + r.failureMessage + q + " />")
    lines.push("    </testcase>")
    i = i + 1
  lines.push("  </testsuite>")
  lines.push("</testsuites>")
  ret lines.join("\n")
