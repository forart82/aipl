module WindowCursor

// ============================================================================
// std/window/cursor.aipl — Hardware Cursor Styling & Capture Modes
// ============================================================================

pub const CURSOR_SHAPE_DEFAULT: int = 0
pub const CURSOR_SHAPE_ARROW: int = 1
pub const CURSOR_SHAPE_POINTER: int = 2
pub const CURSOR_SHAPE_CROSSHAIR: int = 3
pub const CURSOR_SHAPE_TEXT: int = 4
pub const CURSOR_SHAPE_RESIZE_EW: int = 5
pub const CURSOR_SHAPE_RESIZE_NS: int = 6

pub const CURSOR_MODE_NORMAL: int = 0
pub const CURSOR_MODE_HIDDEN: int = 1
pub const CURSOR_MODE_CONFINED: int = 2
pub const CURSOR_MODE_LOCKED: int = 3

pub struct CursorState(mode: int, shape: int, positionX: float, positionY: float, deltaX: float, deltaY: float, isVisible: bool)

pub fn createCursorState(): CursorState:
  ret CursorState(
    mode = CURSOR_MODE_NORMAL,
    shape = CURSOR_SHAPE_DEFAULT,
    positionX = 0.0,
    positionY = 0.0,
    deltaX = 0.0,
    deltaY = 0.0,
    isVisible = true
  )

pub fn setCursorShape(state: CursorState, shape: int): CursorState:
  ret CursorState(
    mode = state.mode,
    shape = shape,
    positionX = state.positionX,
    positionY = state.positionY,
    deltaX = state.deltaX,
    deltaY = state.deltaY,
    isVisible = state.isVisible
  )

pub fn setCursorMode(state: CursorState, mode: int): CursorState:
  let visible = mode == CURSOR_MODE_NORMAL or mode == CURSOR_MODE_CONFINED
  ret CursorState(
    mode = mode,
    shape = state.shape,
    positionX = state.positionX,
    positionY = state.positionY,
    deltaX = 0.0,
    deltaY = 0.0,
    isVisible = visible
  )

pub fn updateCursorPosition(state: CursorState, newX: float, newY: float): CursorState:
  if state.mode == CURSOR_MODE_LOCKED:
    ret CursorState(
      mode = state.mode,
      shape = state.shape,
      positionX = state.positionX,
      positionY = state.positionY,
      deltaX = newX,
      deltaY = newY,
      isVisible = state.isVisible
    )
  let dx = newX - state.positionX
  let dy = newY - state.positionY
  ret CursorState(
    mode = state.mode,
    shape = state.shape,
    positionX = newX,
    positionY = newY,
    deltaX = dx,
    deltaY = dy,
    isVisible = state.isVisible
  )

pub fn isCursorLocked(state: CursorState): bool:
  ret state.mode == CURSOR_MODE_LOCKED
