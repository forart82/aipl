module AudioCodecMod

// ============================================================================
// std/audio/audio_codec.aipl — RIFF WAV PCM Codec & Sample Rate Conversion
// ============================================================================

import { absFloat } from "../math/consts"
import { sqrt } from "../math/trig"
import { writeBytes } from "../fs/file"

pub struct PcmAudioBuffer(sampleRate: int, channels: int, totalFrames: int, samples: [float])

pub struct WavHeader(audioFormat: int, numChannels: int, sampleRate: int, byteRate: int, blockAlign: int, bitsPerSample: int, dataSize: int)

fn readU16LEWav(b: [int], off: int): int:
  if off + 2 > b.len:
    ret 0
  ret (b[off] & 255) | ((b[off + 1] & 255) << 8)

fn readI16LEWav(b: [int], off: int): int:
  let u = readU16LEWav(b, off)
  if u >= 32768:
    ret u - 65536
  ret u

fn readU32LEWav(b: [int], off: int): int:
  if off + 4 > b.len:
    ret 0
  ret (b[off] & 255) | ((b[off + 1] & 255) << 8) | ((b[off + 2] & 255) << 16) | ((b[off + 3] & 255) << 24)

fn pushU16LEWav(mut out: [int], val: int): [int]:
  out.push(val & 255)
  out.push((val >> 8) & 255)
  ret out

fn pushU32LEWav(mut out: [int], val: int): [int]:
  out.push(val & 255)
  out.push((val >> 8) & 255)
  out.push((val >> 16) & 255)
  out.push((val >> 24) & 255)
  ret out

pub fn decodeWav(bytes: [int]): Option[PcmAudioBuffer]:
  if bytes.len < 44:
    ret None
  // 'RIFF' = 0x52, 0x49, 0x46, 0x46; 'WAVE' = 0x57, 0x41, 0x56, 0x45
  if bytes[0] != 82 or bytes[1] != 73 or bytes[2] != 70 or bytes[3] != 70:
    ret None
  if bytes[8] != 87 or bytes[9] != 65 or bytes[10] != 86 or bytes[11] != 69:
    ret None

  let audioFormat = readU16LEWav(bytes, 20)
  let channels = readU16LEWav(bytes, 22)
  let sampleRate = readU32LEWav(bytes, 24)
  let bitsPerSample = readU16LEWav(bytes, 34)
  let dataSize = readU32LEWav(bytes, 40)

  if audioFormat != 1 or channels <= 0 or sampleRate <= 0 or bitsPerSample != 16:
    ret None

  let bytesPerSample = 2
  let totalSamples = dataSize / bytesPerSample
  mut samples: [float] = []
  mut i = 0
  mut off = 44
  while i < totalSamples and off + 2 <= bytes.len:
    let raw = readI16LEWav(bytes, off)
    samples.push(float(raw) / 32768.0)
    off += 2
    i += 1

  let totalFrames = samples.len / channels
  ret Some(PcmAudioBuffer(
    sampleRate = sampleRate,
    channels = channels,
    totalFrames = totalFrames,
    samples = samples
  ))

pub fn encodeWav(buffer: PcmAudioBuffer): [int]:
  mut out: [int] = []
  let channels = if buffer.channels > 0: buffer.channels else: 1
  let sr = if buffer.sampleRate > 0: buffer.sampleRate else: 44100
  let dataSize = buffer.samples.len * 2
  let fileSizeMinus8 = 36 + dataSize
  let byteRate = sr * channels * 2
  let blockAlign = channels * 2

  // 'RIFF'
  out.push(82); out.push(73); out.push(70); out.push(70)
  out = pushU32LEWav(out, fileSizeMinus8)
  // 'WAVE'
  out.push(87); out.push(65); out.push(86); out.push(69)
  // 'fmt '
  out.push(102); out.push(109); out.push(116); out.push(32)
  out = pushU32LEWav(out, 16)
  out = pushU16LEWav(out, 1)
  out = pushU16LEWav(out, channels)
  out = pushU32LEWav(out, sr)
  out = pushU32LEWav(out, byteRate)
  out = pushU16LEWav(out, blockAlign)
  out = pushU16LEWav(out, 16)
  // 'data'
  out.push(100); out.push(97); out.push(116); out.push(97)
  out = pushU32LEWav(out, dataSize)

  mut i = 0
  while i < buffer.samples.len:
    mut s = buffer.samples[i]
    if s < -1.0:
      s = -1.0
    if s > 1.0:
      s = 1.0
    mut pcm16 = int(s * 32768.0)
    if pcm16 > 32767:
      pcm16 = 32767
    if pcm16 < -32768:
      pcm16 = -32768
    let u16 = if pcm16 < 0: pcm16 + 65536 else: pcm16
    out = pushU16LEWav(out, u16)
    i += 1
  ret out

pub fn resamplePcmLinear(buffer: PcmAudioBuffer, targetSampleRate: int): PcmAudioBuffer:
  if targetSampleRate <= 0 or buffer.sampleRate <= 0 or buffer.totalFrames <= 0:
    ret buffer
  let ch = buffer.channels
  if ch <= 0 or buffer.samples.len < buffer.totalFrames * ch:
    ret PcmAudioBuffer(sampleRate = targetSampleRate, channels = if ch > 0: ch else: 1, totalFrames = 0, samples = [])
  let ratio = float(buffer.sampleRate) / float(targetSampleRate)
  let outFrames = int(float(buffer.totalFrames) / ratio)
  mut outSamples: [float] = []
  mut f = 0
  while f < outFrames:
    let srcPos = float(f) * ratio
    let idx0 = int(srcPos)
    let frac = srcPos - float(idx0)
    let idx1 = if idx0 + 1 < buffer.totalFrames: idx0 + 1 else: idx0
    mut c = 0
    while c < ch:
      let s0 = buffer.samples[idx0 * ch + c]
      let s1 = buffer.samples[idx1 * ch + c]
      outSamples.push(s0 + (s1 - s0) * frac)
      c += 1
    f += 1
  ret PcmAudioBuffer(
    sampleRate = targetSampleRate,
    channels = ch,
    totalFrames = outFrames,
    samples = outSamples
  )

pub fn resamplePcmCubic(buffer: PcmAudioBuffer, targetSampleRate: int): PcmAudioBuffer:
  if targetSampleRate <= 0 or buffer.sampleRate <= 0 or buffer.totalFrames <= 0:
    ret buffer
  let ch = buffer.channels
  if ch <= 0 or buffer.samples.len < buffer.totalFrames * ch:
    ret PcmAudioBuffer(sampleRate = targetSampleRate, channels = if ch > 0: ch else: 1, totalFrames = 0, samples = [])
  let ratio = float(buffer.sampleRate) / float(targetSampleRate)
  let outFrames = int(float(buffer.totalFrames) / ratio)
  mut outSamples: [float] = []
  mut f = 0
  while f < outFrames:
    let srcPos = float(f) * ratio
    let idx1 = int(srcPos)
    let t = srcPos - float(idx1)
    let idx0 = if idx1 > 0: idx1 - 1 else: 0
    let idx2 = if idx1 + 1 < buffer.totalFrames: idx1 + 1 else: idx1
    let idx3 = if idx1 + 2 < buffer.totalFrames: idx1 + 2 else: idx2
    mut c = 0
    while c < ch:
      let y0 = buffer.samples[idx0 * ch + c]
      let y1 = buffer.samples[idx1 * ch + c]
      let y2 = buffer.samples[idx2 * ch + c]
      let y3 = buffer.samples[idx3 * ch + c]
      let a0 = -0.5 * y0 + 1.5 * y1 - 1.5 * y2 + 0.5 * y3
      let a1 = y0 - 2.5 * y1 + 2.0 * y2 - 0.5 * y3
      let a2 = -0.5 * y0 + 0.5 * y2
      let a3 = y1
      let val = ((a0 * t + a1) * t + a2) * t + a3
      outSamples.push(val)
      c += 1
    f += 1
  ret PcmAudioBuffer(
    sampleRate = targetSampleRate,
    channels = ch,
    totalFrames = outFrames,
    samples = outSamples
  )

pub fn encodeWavPcm16(samples: [float], sampleRate: int = 44100, numChannels: int = 1): bytes:
  let n = samples.len
  let channels = if numChannels > 0: numChannels else: 1
  let sRate = if sampleRate > 0: sampleRate else: 44100
  let byteRate = sRate * channels * 2
  let blockAlign = channels * 2
  let dataSize = n * 2
  let fileSize = 36 + dataSize

  mut out: [int] = []
  out.push(82)
  out.push(73)
  out.push(70)
  out.push(70)
  out.push(fileSize & 255)
  out.push((fileSize >> 8) & 255)
  out.push((fileSize >> 16) & 255)
  out.push((fileSize >> 24) & 255)
  out.push(87)
  out.push(65)
  out.push(86)
  out.push(69)
  out.push(102)
  out.push(109)
  out.push(116)
  out.push(32)
  out.push(16)
  out.push(0)
  out.push(0)
  out.push(0)
  out.push(1)
  out.push(0)
  out.push(channels & 255)
  out.push((channels >> 8) & 255)
  out.push(sRate & 255)
  out.push((sRate >> 8) & 255)
  out.push((sRate >> 16) & 255)
  out.push((sRate >> 24) & 255)
  out.push(byteRate & 255)
  out.push((byteRate >> 8) & 255)
  out.push((byteRate >> 16) & 255)
  out.push((byteRate >> 24) & 255)
  out.push(blockAlign & 255)
  out.push((blockAlign >> 8) & 255)
  out.push(16)
  out.push(0)
  out.push(100)
  out.push(97)
  out.push(116)
  out.push(97)
  out.push(dataSize & 255)
  out.push((dataSize >> 8) & 255)
  out.push((dataSize >> 16) & 255)
  out.push((dataSize >> 24) & 255)

  mut i = 0
  while i < n:
    mut s = samples[i]
    if s < -1.0:
      s = -1.0
    if s > 1.0:
      s = 1.0
    mut raw = int(s * 32767.0)
    if raw < 0:
      raw += 65536
    out.push(raw & 255)
    out.push((raw >> 8) & 255)
    i += 1

  ret bytesFromArray(out)

pub fn decodeWavPcm16(data: bytes): Result[[float], str]:
  if data.len < 44:
    ret Err("WAV data too short")
  if data[0] != 82 or data[1] != 73 or data[2] != 70 or data[3] != 70:
    ret Err("Not a RIFF file")
  if data[8] != 87 or data[9] != 65 or data[10] != 86 or data[11] != 69:
    ret Err("Not a WAVE file")
  mut idx = 12
  mut dataOffset = -1
  mut dataLen = 0
  while idx + 8 <= data.len:
    if data[idx] == 100 and data[idx + 1] == 97 and data[idx + 2] == 116 and data[idx + 3] == 97:
      dataLen = data[idx + 4] | (data[idx + 5] << 8) | (data[idx + 6] << 16) | (data[idx + 7] << 24)
      dataOffset = idx + 8
      idx = data.len
    else:
      let chunkSize = data[idx + 4] | (data[idx + 5] << 8) | (data[idx + 6] << 16) | (data[idx + 7] << 24)
      if chunkSize < 0:
        idx = data.len
      else:
        idx = idx + 8 + chunkSize + (chunkSize & 1)
  if dataOffset < 0:
    ret Err("Missing data chunk in WAV")
  let numSamples = dataLen / 2
  mut samples: [float] = []
  mut i = 0
  while i < numSamples:
    let byteIdx = dataOffset + i * 2
    if byteIdx + 1 < data.len:
      let lo = data[byteIdx]
      let hi = data[byteIdx + 1]
      mut raw = lo | (hi << 8)
      if raw >= 32768:
        raw -= 65536
      samples.push(float(raw) / 32767.0)
    i += 1
  ret Ok(samples)

pub fn writeWavFilePcm16(path: str, samples: [int], sampleRate: int = 44100, channels: int = 1): Result[bool, str]:
  mut hasLargeInt = false
  mut i = 0
  while i < samples.len:
    let v = float(samples[i])
    if v > 1.5 or v < -1.5:
      hasLargeInt = true
    i += 1
  mut normalized: [float] = []
  mut j = 0
  while j < samples.len:
    let sVal = float(samples[j])
    if hasLargeInt:
      normalized.push(sVal / 32767.0)
    else:
      normalized.push(sVal)
    j += 1
  let wavBytes = encodeWavPcm16(normalized, sampleRate, channels)
  ret writeBytes(path, wavBytes)

pub fn writeWavFilePcm16Float(path: str, samples: [float], sampleRate: int = 44100, channels: int = 1): Result[bool, str]:
  let wavBytes = encodeWavPcm16(samples, sampleRate, channels)
  ret writeBytes(path, wavBytes)

pub fn inspectPcmBuffer(samples: [float]): [float]:
  let n = samples.len
  if n == 0:
    ret [0.0, 0.0, 0.0]
  mut sumSq = 0.0
  mut peak = 0.0
  mut zc = 0
  mut i = 0
  while i < n:
    let s = samples[i]
    let a = absFloat(s)
    sumSq = sumSq + s * s
    if a > peak:
      peak = a
    if i > 0:
      let prev = samples[i - 1]
      if (prev < 0.0 and s >= 0.0) or (prev >= 0.0 and s < 0.0):
        zc = zc + 1
    i += 1
  ret [sqrt(sumSq / float(n)), peak, float(zc)]
