/// # Module: `std/ecs/ecs_event` (`EcsEventMod`)
///
/// ## Purpose & Domain Scope
/// Double-buffered typed event queues (`EventBus`, `EventReader`) supporting
/// frame-persistent event delivery.
module EcsEventMod

pub struct EventEnvelope(eventTypeId: int, sourceEntityIndex: int, payloadA: float, payloadB: float)

pub struct EventBus(currentQueue: [EventEnvelope], previousQueue: [EventEnvelope], generation: int = 0)

pub struct EventReader(readCursorPrev: int, readCursorCurr: int, generation: int = 0)

pub fn createEventBus(): EventBus:
  mut curr: [EventEnvelope] = []
  mut prev: [EventEnvelope] = []
  ret EventBus(currentQueue = curr, previousQueue = prev, generation = 0)

pub fn publishEvent(bus: EventBus, ev: EventEnvelope): EventBus:
  mut curr = bus.currentQueue
  curr.push(ev)
  ret EventBus(currentQueue = curr, previousQueue = bus.previousQueue, generation = bus.generation)

pub fn swapEventBuffers(bus: EventBus): EventBus:
  mut freshCurr: [EventEnvelope] = []
  ret EventBus(currentQueue = freshCurr, previousQueue = bus.currentQueue, generation = bus.generation + 1)

pub fn readNewEvents(bus: EventBus, reader: EventReader, eventTypeId: int): ([EventEnvelope], EventReader):
  mut out: [EventEnvelope] = []
  let genDiff = bus.generation - reader.generation
  mut pCursor = if genDiff <= 0: reader.readCursorPrev elif genDiff == 1: reader.readCursorCurr else: 0
  mut cCursor = if genDiff <= 0: reader.readCursorCurr else: 0
  if pCursor < 0:
    pCursor = 0
  if cCursor < 0:
    cCursor = 0
  while pCursor < bus.previousQueue.len:
    let ev: EventEnvelope = bus.previousQueue[pCursor]
    if ev.eventTypeId == eventTypeId:
      out.push(ev)
    pCursor = pCursor + 1

  while cCursor < bus.currentQueue.len:
    let ev: EventEnvelope = bus.currentQueue[cCursor]
    if ev.eventTypeId == eventTypeId:
      out.push(ev)
    cCursor = cCursor + 1

  ret (
    out,
    EventReader(readCursorPrev = pCursor, readCursorCurr = cCursor, generation = bus.generation)
  )
