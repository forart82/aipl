/// # Module: `std/ecs/ecs_mod` (`EcsMod`)
///
/// ## Purpose & Domain Scope
/// Public umbrella facade re-exporting all ECS modules.
module EcsMod

pub import {
  EntityId, EntityPool, createEntityPool, allocateEntity,
  recycleEntity, isEntityAlive, packEntityU64, unpackEntityU64
} from "std/ecs/entity"

pub import {
  ComponentColumn, ArchetypeTable, createArchetypeTable,
  insertArchetypeRow, swapRemoveArchetypeRow, migrateEntityBetweenArchetypes
} from "std/ecs/archetype"

pub import {
  EntityLocation, EcsWorld, createEcsWorld, spawnEntity,
  despawnEntity, setWorldResource, getWorldResource
} from "std/ecs/ecs_world"

pub import {
  QueryFilter, matchesQueryFilter, findMatchingArchetypes, queryEntities
} from "std/ecs/ecs_query"

pub import {
  CMD_SPAWN, CMD_DESPAWN, CMD_SET_RESOURCE, EcsCommand, EcsCommandBuffer,
  createCommandBuffer, recordSpawnCommand, recordDespawnCommand, flushCommandBuffer
} from "std/ecs/ecs_command"

pub import {
  EventEnvelope, EventBus, EventReader, createEventBus,
  publishEvent, swapEventBuffers, readNewEvents
} from "std/ecs/ecs_event"

pub import {
  STAGE_PRE_UPDATE, STAGE_UPDATE, STAGE_FIXED_UPDATE, STAGE_POST_UPDATE,
  STAGE_RENDER, SystemDescriptor, systemsConflict, sortSystemsByPriority,
  buildParallelBatches
} from "std/ecs/ecs_schedule"
