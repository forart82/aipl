pub fn drawLines(points: [Vec2], thickness: float, color: int):
  let col = colorHex(color)
  mut i = 0
  while i + 1 < points.len:
    drawLine(points[i].x, points[i].y, points[i + 1].x, points[i + 1].y, col, thickness)
    i += 1
  ret

pub fn drawCircles(centers: [Vec2], radius: float, color: int):
  let col = colorHex(color)
  mut i = 0
  while i < centers.len:
    drawCircle(centers[i].x, centers[i].y, radius, col)
    i += 1
  ret

