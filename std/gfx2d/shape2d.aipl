pub fn measureTextWidthPx(text: str, size: float): float:
  ret float(text.len) * maxFloat(1.0, size) * 0.6

pub fn measureTextHeight(text: str, size: float): float:
  ret if text.len > 0: maxFloat(8.0, size * 1.2) else: 0.0

pub fn measureText(text: str, size: float): Vec2:
  ret Vec2(x = measureTextWidthPx(text, size), y = measureTextHeight(text, size))

pub fn truncateText(text: str, maxWidth: float, size: float): str:
  let fullW = measureTextWidthPx(text, size)
  if fullW <= maxWidth or maxWidth <= 0.0:
    ret text
  let charW = maxFloat(1.0, size * 0.6)
  let maxChars = maxInt(0, int(maxWidth / charW))
  if maxChars >= text.len:
    ret text
  ret text.slice(0, maxChars)

pub fn drawTextBox(text: str, x: float, y: float, maxWidth: float, size: float, color: Color):
