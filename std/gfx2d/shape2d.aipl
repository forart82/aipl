module Gfx2dShapeMod

// ============================================================================
// std/gfx2d/shape2d.aipl — Vector Primitive Rasterization & Cubic Beziers
// ============================================================================

import { Vec2 } from "../math/vec_math"
import { ColorRgba8 } from "../gfx/color"
import { BatchVertex2D } from "./batch2d"

pub struct StrokeStyle2D(width: float, color: ColorRgba8, capStyle: int, joinStyle: int)

fn packRgbaInt(c: ColorRgba8): int:
  ret ((c.r & 255) << 24) | ((c.g & 255) << 16) | ((c.b & 255) << 8) | (c.a & 255)

pub fn buildLineQuads(p0: Vec2, p1: Vec2, stroke: StrokeStyle2D): [BatchVertex2D]:
  let dx = p1.x - p0.x
  let dy = p1.y - p0.y
  let len = sqrt(dx * dx + dy * dy)
  let hw = (if stroke.width > 0.0: stroke.width else: 1.0) * 0.5
  let nx = if len > 0.0001: (-dy / len) * hw else: 0.0
  let ny = if len > 0.0001: (dx / len) * hw else: hw
  let col = packRgbaInt(stroke.color)
  ret [
    BatchVertex2D(x = p0.x + nx, y = p0.y + ny, u = 0.0, v = 0.0, colorRgba = col),
    BatchVertex2D(x = p1.x + nx, y = p1.y + ny, u = 1.0, v = 0.0, colorRgba = col),
    BatchVertex2D(x = p1.x - nx, y = p1.y - ny, u = 1.0, v = 1.0, colorRgba = col),
    BatchVertex2D(x = p0.x - nx, y = p0.y - ny, u = 0.0, v = 1.0, colorRgba = col)
  ]

pub fn buildCircleTris(center: Vec2, radius: float, color: ColorRgba8, segments: int = 32): [BatchVertex2D]:
  let segs = if segments >= 3: segments else: 16
  let col = packRgbaInt(color)
  let step = (2.0 * 3.141592653589793) / float(segs)
  mut out: [BatchVertex2D] = []
  mut i = 0
  while i < segs:
    let a0 = float(i) * step
    let a1 = float(i + 1) * step
    out.push(BatchVertex2D(x = center.x, y = center.y, u = 0.5, v = 0.5, colorRgba = col))
    out.push(BatchVertex2D(x = center.x + cos(a0) * radius, y = center.y + sin(a0) * radius, u = 1.0, v = 0.5, colorRgba = col))
    out.push(BatchVertex2D(x = center.x + cos(a1) * radius, y = center.y + sin(a1) * radius, u = 0.5, v = 1.0, colorRgba = col))
    i += 1
  ret out

pub fn buildCapsuleTris(startPt: Vec2, endPt: Vec2, radius: float, color: ColorRgba8, segments: int = 16): [BatchVertex2D]:
  let stroke = StrokeStyle2D(width = radius * 2.0, color = color, capStyle = 1, joinStyle = 1)
  mut out = buildLineQuads(startPt, endPt, stroke)
  let capA = buildCircleTris(startPt, radius, color, segments)
  mut i = 0
  while i < capA.len:
    out.push(capA[i])
    i += 1
  ret out

pub fn buildCubicBezierPoints(p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, subdivisions: int = 32): [Vec2]:
  let steps = if subdivisions >= 2: subdivisions else: 16
  mut pts: [Vec2] = []
  mut i = 0
  while i <= steps:
    let t = float(i) / float(steps)
    let u = 1.0 - t
    let b0 = u * u * u
    let b1 = 3.0 * u * u * t
    let b2 = 3.0 * u * t * t
    let b3 = t * t * t
    let x = b0 * p0.x + b1 * p1.x + b2 * p2.x + b3 * p3.x
    let y = b0 * p0.y + b1 * p1.y + b2 * p2.y + b3 * p3.y
    pts.push(Vec2(x = x, y = y))
    i += 1
  ret pts

/// @intrinsic("aipl_rt_blendModeMultiplied")
pub fn blendModeMultiplied(): int:
  ret 2

/// @intrinsic("aipl_rt_blendModeScreen")
pub fn blendModeScreen(): int:
  ret 3

pub struct Color(r: float, g: float, b: float, a: float)

pub struct Transform2D(tx: float, ty: float, rotRad: float, sx: float, sy: float)

pub fn rgba(r: int, g: int, b: int, a: float): Color:
  let rf = clampFloat(float(r) / 255.0, 0.0, 1.0)
  let gf = clampFloat(float(g) / 255.0, 0.0, 1.0)
  let bf = clampFloat(float(b) / 255.0, 0.0, 1.0)
  let af = if a > 1.0: clampFloat(a / 255.0, 0.0, 1.0) else: clampFloat(a, 0.0, 1.0)
  ret Color(r = rf, g = gf, b = bf, a = af)

pub fn rgba8Color(r: int, g: int, b: int, a: int): Color:
  ret rgba(r, g, b, float(clampInt(a, 0, 255)) / 255.0)

pub fn rgb(r: int, g: int, b: int): Color:
  ret rgba(r, g, b, 1.0)

pub struct PointerEvent(x: float, y: float, button: int, kind: str)

pub fn colorHexRgb(hex: int): Color:
  let r = (hex / 65536) % 256
  let g = (hex / 256) % 256
  let b = hex % 256
  ret rgb(r, g, b)

pub fn colorHexRgba(hex: int): Color:
  let r = (hex / 16777216) % 256
  let g = (hex / 65536) % 256
  let b = (hex / 256) % 256
  let a = float(hex % 256) / 255.0
  ret rgba(r, g, b, a)

pub fn colorHex(hex: int): Color:
  if hex > 16777215:
    ret colorHexRgba(hex)
  ret colorHexRgb(hex)

fn canvasHexDigit(code: int): int:
  if code >= 48 and code <= 57:
    ret code - 48
  if code >= 65 and code <= 70:
    ret code - 55
  if code >= 97 and code <= 102:
    ret code - 87
  ret 0

pub fn colorFromHexStr(hexStr: str): Color:
  let s = hexStr.trim()
  let clean = if s.startsWith("#"): s.slice(1, s.len) elif s.startsWith("0x") or s.startsWith("0X"): s.slice(2, s.len) else: s
  if clean.len == 3:
    let r = canvasHexDigit(clean.charCodeAt(0)) * 17
    let g = canvasHexDigit(clean.charCodeAt(1)) * 17
    let b = canvasHexDigit(clean.charCodeAt(2)) * 17
    ret rgb(r, g, b)
  if clean.len >= 6:
    let r = canvasHexDigit(clean.charCodeAt(0)) * 16 + canvasHexDigit(clean.charCodeAt(1))
    let g = canvasHexDigit(clean.charCodeAt(2)) * 16 + canvasHexDigit(clean.charCodeAt(3))
    let b = canvasHexDigit(clean.charCodeAt(4)) * 16 + canvasHexDigit(clean.charCodeAt(5))
    if clean.len >= 8:
      let a = canvasHexDigit(clean.charCodeAt(6)) * 16 + canvasHexDigit(clean.charCodeAt(7))
      ret rgba8Color(r, g, b, a)
    ret rgb(r, g, b)
  ret rgb(56, 189, 248)

pub fn colorHexStr(hexStr: str): Color:
  ret colorFromHexStr(hexStr)

pub fn packColorRgba32(c: Color): int:
  let r = clampInt(int(clampFloat(c.r, 0.0, 1.0) * 255.0 + 0.5), 0, 255)
  let g = clampInt(int(clampFloat(c.g, 0.0, 1.0) * 255.0 + 0.5), 0, 255)
  let b = clampInt(int(clampFloat(c.b, 0.0, 1.0) * 255.0 + 0.5), 0, 255)
  let a = clampInt(int(clampFloat(c.a, 0.0, 1.0) * 255.0 + 0.5), 0, 255)
  ret (a << 24) | (r << 16) | (g << 8) | b

pub fn colorToInt(c: Color): int:
  ret packColorRgba32(c)

pub fn pushTransform(tx: float, ty: float, rotRad: float, sx: float, sy: float): Transform2D:
