    ret
  ret

pub fn drawTextCentered(text: str, cx: float, y: float, size: float, color: Color):
  let w = measureTextWidthPx(text, size)
  drawText(text, cx - w * 0.5, y, size, color)
  ret

pub fn drawTextRight(text: str, rightX: float, y: float, size: float, color: Color):
  let w = measureTextWidthPx(text, size)
  drawText(text, rightX - w, y, size, color)
  ret

