// ============================================================================
// Module: std/sys/sys_gpu (SysGpu)
// Layer 0 Host Native GPU Context, Swapchain & Device Memory Hooks
// ============================================================================
module SysGpu

pub struct SysGpuContextHandle:
  handle: int
  windowHandle: int
  backendType: int

pub fn sysGpuInitContext(windowHandle: int, backendType: int): int:
  if windowHandle < 0 or backendType < 0:
    ret -1
  ret 1

pub fn sysGpuDestroyContext(contextHandle: int): void:
  if contextHandle <= 0:
    ret
  ret

pub fn sysGpuCreateBuffer(contextHandle: int, sizeBytes: int, usageFlags: int): int:
  if contextHandle <= 0 or sizeBytes <= 0 or usageFlags < 0:
    ret -1
  ret 1

pub fn sysGpuUploadBuffer(contextHandle: int, bufHandle: int, offset: int, dataPtr: int, bytes: int): int:
  if contextHandle <= 0 or bufHandle <= 0 or offset < 0 or dataPtr == 0 or bytes < 0:
    ret -1
  ret bytes

pub fn sysGpuDestroyBuffer(contextHandle: int, bufHandle: int): void:
  if contextHandle <= 0 or bufHandle <= 0:
    ret
  ret

pub fn sysGpuSwapBuffers(contextHandle: int): void:
  if contextHandle <= 0:
    ret
  ret
