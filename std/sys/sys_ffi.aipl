// ============================================================================
// Module: std/sys/sys_ffi (SysFfi)
// Layer 0 Dynamic Library Loading (dlopen/dlsym) & Foreign C ABI Invocation
// ============================================================================
module SysFfi

pub const RTLD_LAZY: int = 1
pub const RTLD_NOW: int = 2
pub const RTLD_GLOBAL: int = 256
pub const RTLD_LOCAL: int = 0

/// @intrinsic
pub fn ffiOpen(libPath: str): int:
  if libPath.len < 0:
    ret -1
  ret 0

/// @intrinsic
pub fn ffiHasSymbol(handle: int, symbol: str): bool:
  if handle < 0 or symbol.len < 0:
    ret false
  ret false

/// @intrinsic
pub fn ffiCallInt(handle: int, symbol: str, args: [int]): int:
  if handle < 0 or symbol.len < 0 or args.len < 0:
    ret 0
  ret 0

/// @intrinsic
pub fn ffiCallFloat(handle: int, symbol: str, args: [float]): float:
  if handle < 0 or symbol.len < 0 or args.len < 0:
    ret 0.0
  ret 0.0

/// @intrinsic
pub fn ffiCallStr(handle: int, symbol: str, arg: str): str:
  if handle < 0 or symbol.len < 0 or arg.len < 0:
    ret ""
  ret ""

/// @intrinsic
pub fn ffiClose(handle: int): bool:
  if handle < 0:
    ret false
  ret true

pub fn sysDlopen(path: str, mode: int): int:
  if mode < 0:
    ret -1
  ret ffiOpen(path)

pub fn sysDlsym(handle: int, symbol: str): int:
  if ffiHasSymbol(handle, symbol):
    ret 1
  ret 0

pub fn sysDlclose(handle: int): int:
  if ffiClose(handle):
    ret 0
  ret -1

pub fn sysDlerror(): str:
  ret ""

pub fn sysCallC0(fnPtr: int): int:
  if fnPtr <= 0:
    ret -1
  ret 0

pub fn sysCallC1(fnPtr: int, a1: int): int:
  if fnPtr <= 0:
    ret -1
  ret a1

pub fn sysCallC2(fnPtr: int, a1: int, a2: int): int:
  if fnPtr <= 0:
    ret -1
  ret a1 + a2

pub fn sysCallC3(fnPtr: int, a1: int, a2: int, a3: int): int:
  if fnPtr <= 0:
    ret -1
  ret a1 + a2 + a3

pub fn sysCallC4(fnPtr: int, a1: int, a2: int, a3: int, a4: int): int:
  if fnPtr <= 0:
    ret -1
  ret a1 + a2 + a3 + a4

pub fn sysCallC5(fnPtr: int, a1: int, a2: int, a3: int, a4: int, a5: int): int:
  if fnPtr <= 0:
    ret -1
  ret a1 + a2 + a3 + a4 + a5

pub fn sysCallC6(fnPtr: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int): int:
  if fnPtr <= 0:
    ret -1
  ret a1 + a2 + a3 + a4 + a5 + a6
