// ============================================================================
// Module: std/sys/sys_syscall (SysSyscall)
// Layer 0 Architecture-Specific Kernel Syscall Register Dispatcher
// ============================================================================
module SysSyscall

pub const SYS_READ: int = 0
pub const SYS_WRITE: int = 1
pub const SYS_OPEN: int = 2
pub const SYS_CLOSE: int = 3
pub const SYS_STAT: int = 4
pub const SYS_FSTAT: int = 5
pub const SYS_LSTAT: int = 6
pub const SYS_POLL: int = 7
pub const SYS_LSEEK: int = 8
pub const SYS_MMAP: int = 9
pub const SYS_MPROTECT: int = 10
pub const SYS_MUNMAP: int = 11
pub const SYS_SOCKET: int = 41
pub const SYS_CONNECT: int = 42
pub const SYS_ACCEPT: int = 43
pub const SYS_SENDTO: int = 44
pub const SYS_RECVFROM: int = 45
pub const SYS_BIND: int = 49
pub const SYS_LISTEN: int = 50
pub const SYS_CLONE: int = 56
pub const SYS_EXECVE: int = 59
pub const SYS_EXIT: int = 60
pub const SYS_WAIT4: int = 61
pub const SYS_FSYNC: int = 74
pub const SYS_RENAME: int = 82
pub const SYS_MKDIR: int = 83
pub const SYS_RMDIR: int = 84
pub const SYS_UNLINK: int = 87
pub const SYS_FUTEX: int = 202
pub const SYS_CLOCK_GETTIME: int = 228
pub const SYS_OPENAT: int = 257
pub const SYS_MKDIRAT: int = 258
pub const SYS_UNLINKAT: int = 263
pub const SYS_RENAMEAT: int = 264

pub const AT_FDCWD: int = -100
pub const PROT_NONE: int = 0
pub const PROT_READ: int = 1
pub const PROT_WRITE: int = 2
pub const PROT_EXEC: int = 4
pub const MAP_SHARED: int = 1
pub const MAP_PRIVATE: int = 2
pub const MAP_ANONYMOUS: int = 32
pub const MAP_FAILED: int = -1

pub const O_RDONLY: int = 0
pub const O_WRONLY: int = 1
pub const O_RDWR: int = 2
pub const O_CREAT: int = 64
pub const O_TRUNC: int = 512
pub const O_APPEND: int = 1024

/// @intrinsic("aipl_rt_rawSyscall")
pub fn rawSyscall(nr: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int): int:
  ret -1

pub fn sysArchSyscall0(num: int): int:
  ret rawSyscall(num, 0, 0, 0, 0, 0, 0)

pub fn sysArchSyscall1(num: int, a1: int): int:
  ret rawSyscall(num, a1, 0, 0, 0, 0, 0)

pub fn sysArchSyscall2(num: int, a1: int, a2: int): int:
  ret rawSyscall(num, a1, a2, 0, 0, 0, 0)

pub fn sysArchSyscall3(num: int, a1: int, a2: int, a3: int): int:
  ret rawSyscall(num, a1, a2, a3, 0, 0, 0)

pub fn sysArchSyscall4(num: int, a1: int, a2: int, a3: int, a4: int): int:
  ret rawSyscall(num, a1, a2, a3, a4, 0, 0)

pub fn sysArchSyscall5(num: int, a1: int, a2: int, a3: int, a4: int, a5: int): int:
  ret rawSyscall(num, a1, a2, a3, a4, a5, 0)

pub fn sysArchSyscall6(num: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int): int:
  ret rawSyscall(num, a1, a2, a3, a4, a5, a6)

pub fn syscall0(nr: int): int:
  ret sysArchSyscall0(nr)

pub fn syscall1(nr: int, a1: int): int:
  ret sysArchSyscall1(nr, a1)

pub fn syscall2(nr: int, a1: int, a2: int): int:
  ret sysArchSyscall2(nr, a1, a2)

pub fn syscall3(nr: int, a1: int, a2: int, a3: int): int:
  ret sysArchSyscall3(nr, a1, a2, a3)

pub fn syscall4(nr: int, a1: int, a2: int, a3: int, a4: int): int:
  ret sysArchSyscall4(nr, a1, a2, a3, a4)

pub fn syscall5(nr: int, a1: int, a2: int, a3: int, a4: int, a5: int): int:
  ret sysArchSyscall5(nr, a1, a2, a3, a4, a5)

pub fn syscall6(nr: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int): int:
  ret sysArchSyscall6(nr, a1, a2, a3, a4, a5, a6)

pub fn sysRead(fd: int, buf: int, count: int): int:
  ret sysArchSyscall3(SYS_READ, fd, buf, count)

pub fn sysWrite(fd: int, buf: int, count: int): int:
  ret sysArchSyscall3(SYS_WRITE, fd, buf, count)

pub fn sysOpenat(dfd: int, filename: int, flags: int, mode: int): int:
  ret sysArchSyscall4(SYS_OPENAT, dfd, filename, flags, mode)

pub fn sysClose(fd: int): int:
  ret sysArchSyscall1(SYS_CLOSE, fd)

pub fn sysMmap(addr: int, length: int, prot: int, flags: int, fd: int, offset: int): int:
  ret sysArchSyscall6(SYS_MMAP, addr, length, prot, flags, fd, offset)

pub fn sysMunmap(addr: int, length: int): int:
  ret sysArchSyscall2(SYS_MUNMAP, addr, length)

pub fn sysExit(status: int): void:
  let _ = sysArchSyscall1(SYS_EXIT, status)
  ret
