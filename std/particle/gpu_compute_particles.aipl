/// # Module: `std/particle/gpu_compute_particles` (`GpuComputeParticlesMod`)
///
/// ## Purpose & Domain Scope
/// High-throughput Structure-of-Arrays (SoA) particle layout for 100k+ particles
/// and WGSL compute shader generation for GPU particle advection.
module GpuComputeParticlesMod

pub struct GpuParticleSoA(posX: [float], posY: [float], posZ: [float], velX: [float], velY: [float], velZ: [float], age: [float], lifetime: [float], colorRgba: [int], capacity: int, liveCount: int)

pub struct GpuComputeParticlePipeline(wgslSource: str, workgroupSizeX: int, maxParticles: int)

pub fn createGpuParticleSoA(capacity: int): GpuParticleSoA:
  let cap = if capacity > 0: capacity else: 0
  mut px: [float] = []
  mut py: [float] = []
  mut pz: [float] = []
  mut vx: [float] = []
  mut vy: [float] = []
  mut vz: [float] = []
  mut ag: [float] = []
  mut lt: [float] = []
  mut col: [int] = []

  mut i = 0
  while i < cap:
    px.push(0.0)
    py.push(0.0)
    pz.push(0.0)
    vx.push(0.0)
    vy.push(0.0)
    vz.push(0.0)
    ag.push(0.0)
    lt.push(1.0)
    col.push(0xFFFFFFFF)
    i = i + 1

  ret GpuParticleSoA(
    posX = px,
    posY = py,
    posZ = pz,
    velX = vx,
    velY = vy,
    velZ = vz,
    age = ag,
    lifetime = lt,
    colorRgba = col,
    capacity = cap,
    liveCount = 0
  )

pub fn buildComputeParticleShaderWgsl(workgroupSize: int = 64): str:
  let wg = if workgroupSize > 0: workgroupSize else: 64
  ret "@compute @workgroup_size(" + str(wg) + ")\nfn cs_main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let idx = gid.x;\n  // Advect particle position and decay lifetime in VRAM\n}\n"

pub fn createComputeParticlePipeline(maxParticles: int = 65536, workgroupSizeX: int = 64): GpuComputeParticlePipeline:
  let wg = if workgroupSizeX > 0: workgroupSizeX else: 64
  let cap = if maxParticles > 0: maxParticles else: 1024
  ret GpuComputeParticlePipeline(
    wgslSource = buildComputeParticleShaderWgsl(wg),
    workgroupSizeX = wg,
    maxParticles = cap
  )

pub fn spawnGpuParticleSoA(mut soa: GpuParticleSoA, px: float, py: float, pz: float, vx: float, vy: float, vz: float, lifetime: float, rgba: int): GpuParticleSoA:
  if soa.liveCount < 0 or soa.liveCount >= soa.capacity or soa.liveCount >= soa.posX.len:
    ret soa
  let idx = soa.liveCount
  soa.posX[idx] = px
  soa.posY[idx] = py
  soa.posZ[idx] = pz
  soa.velX[idx] = vx
  soa.velY[idx] = vy
  soa.velZ[idx] = vz
  soa.age[idx] = 0.0
  soa.lifetime[idx] = if lifetime > 0.0: lifetime else: 1.0
  soa.colorRgba[idx] = rgba
  soa.liveCount = idx + 1
  ret soa

pub fn stepGpuParticleSoACpuFallback(mut soa: GpuParticleSoA, dt: float, gravityY: float): GpuParticleSoA:
  mut limit = if soa.liveCount < soa.posX.len: soa.liveCount else: soa.posX.len
  if limit < 0:
    limit = 0
  soa.liveCount = limit
  mut i = 0
  while i < soa.liveCount:
    let nextAge = soa.age[i] + dt
    if nextAge < soa.lifetime[i]:
      let nvy = soa.velY[i] + gravityY * dt
      soa.velY[i] = nvy
      soa.posX[i] = soa.posX[i] + soa.velX[i] * dt
      soa.posY[i] = soa.posY[i] + nvy * dt
      soa.posZ[i] = soa.posZ[i] + soa.velZ[i] * dt
      soa.age[i] = nextAge
      i = i + 1
    else:
      let last = soa.liveCount - 1
      soa.posX[i] = soa.posX[last]
      soa.posY[i] = soa.posY[last]
      soa.posZ[i] = soa.posZ[last]
      soa.velX[i] = soa.velX[last]
      soa.velY[i] = soa.velY[last]
      soa.velZ[i] = soa.velZ[last]
      soa.age[i] = soa.age[last]
      soa.lifetime[i] = soa.lifetime[last]
      soa.colorRgba[i] = soa.colorRgba[last]
      soa.liveCount = last
  ret soa
