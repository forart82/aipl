/// # Module: `std/math/quat` (`QuatMod`)
///
/// ## Purpose & Domain Scope
/// 3D spatial orientation quaternions (`Quat`), Hamilton product, axis-angle / Euler
/// conversion, spherical linear interpolation (`slerp`), and vector rotation.
module QuatMod

import { sin, cos, acos, sqrt } from "std/math/trig"
import { Vec3 } from "std/math/vec_math"
import { Mat4 } from "std/math/mat"

pub struct Quat:
  x: float
  y: float
  z: float
  w: float

pub fn Quat.identity(): Quat:
  ret Quat(x = 0.0, y = 0.0, z = 0.0, w = 1.0)

pub fn Quat.fromAxisAngle(axis: Vec3, rad: float): Quat:
  let n = axis.norm()
  let half = rad * 0.5
  let s = sin(half)
  let c = cos(half)
  ret Quat(x = n.x * s, y = n.y * s, z = n.z * s, w = c)

pub fn Quat.fromEuler(pitch: float, yaw: float, roll: float): Quat:
  let cp = cos(pitch * 0.5)
  let sp = sin(pitch * 0.5)
  let cy = cos(yaw * 0.5)
  let sy = sin(yaw * 0.5)
  let cr = cos(roll * 0.5)
  let sr = sin(roll * 0.5)
  ret Quat(
    x = sr * cp * cy - cr * sp * sy,
    y = cr * sp * cy + sr * cp * sy,
    z = cr * cp * sy - sr * sp * cy,
    w = cr * cp * cy + sr * sp * sy
  )

pub fn (self: Quat) lenSq(): float:
  ret self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w

pub fn (self: Quat) len(): float:
  ret sqrt(self.lenSq())

pub fn (self: Quat) norm(): Quat:
  let l = self.len()
  if l > 0.0:
    ret Quat(x = self.x / l, y = self.y / l, z = self.z / l, w = self.w / l)
  ret Quat.identity()

pub fn (self: Quat) conjugate(): Quat:
  ret Quat(x = -self.x, y = -self.y, z = -self.z, w = self.w)

pub fn (self: Quat) mul(other: Quat): Quat:
  ret Quat(
    x = self.w * other.x + self.x * other.w + self.y * other.z - self.z * other.y,
    y = self.w * other.y - self.x * other.z + self.y * other.w + self.z * other.x,
    z = self.w * other.z + self.x * other.y - self.y * other.x + self.z * other.w,
    w = self.w * other.w - self.x * other.x - self.y * other.y - self.z * other.z
  )

pub fn (self: Quat) slerp(target: Quat, t: float): Quat:
  mut q2 = target
  mut dot = self.x * q2.x + self.y * q2.y + self.z * q2.z + self.w * q2.w
  if dot < 0.0:
    dot = -dot
    q2 = Quat(x = -q2.x, y = -q2.y, z = -q2.z, w = -q2.w)
  if dot > 0.9995:
    let rx = self.x + (q2.x - self.x) * t
    let ry = self.y + (q2.y - self.y) * t
    let rz = self.z + (q2.z - self.z) * t
    let rw = self.w + (q2.w - self.w) * t
    ret Quat(x = rx, y = ry, z = rz, w = rw).norm()
  let theta0 = acos(dot)
  let theta = theta0 * t
  let sinTheta = sin(theta)
  let sinTheta0 = sin(theta0)
  let s1 = sinTheta / sinTheta0
  let s0 = cos(theta) - dot * s1
  ret Quat(
    x = self.x * s0 + q2.x * s1,
    y = self.y * s0 + q2.y * s1,
    z = self.z * s0 + q2.z * s1,
    w = self.w * s0 + q2.w * s1
  ).norm()

pub fn (self: Quat) rotateVec3(v: Vec3): Vec3:
  let u = Vec3(x = self.x, y = self.y, z = self.z)
  let t = u.cross(v).scale(2.0)
  ret v.add(t.scale(self.w)).add(u.cross(t))

pub fn (self: Quat) toMat4(): Mat4:
  let xx = self.x * self.x
  let yy = self.y * self.y
  let zz = self.z * self.z
  let xy = self.x * self.y
  let xz = self.x * self.z
  let yz = self.y * self.z
  let wx = self.w * self.x
  let wy = self.w * self.y
  let wz = self.w * self.z
  ret Mat4(
    m00 = 1.0 - 2.0 * (yy + zz), m01 = 2.0 * (xy - wz),       m02 = 2.0 * (xz + wy),       m03 = 0.0,
    m10 = 2.0 * (xy + wz),       m11 = 1.0 - 2.0 * (xx + zz), m12 = 2.0 * (yz - wx),       m13 = 0.0,
    m20 = 2.0 * (xz - wy),       m21 = 2.0 * (yz + wx),       m22 = 1.0 - 2.0 * (xx + yy), m23 = 0.0,
    m30 = 0.0,                   m31 = 0.0,                   m32 = 0.0,                   m33 = 1.0
  )
