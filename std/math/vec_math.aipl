/// # Module: `std/math/vec_math` (`VecMath`)
///
/// ## Purpose & Domain Scope
/// Fixed-dimension 2D, 3D, and 4D linear algebra vectors (floating-point and integer).
module VecMath

import { sqrt } from "std/math/trig"

pub struct Vec2(x: float, y: float)
pub struct Vector2(x: float, y: float)
pub struct Vec3(x: float, y: float, z: float)
pub struct Vector3(x: float, y: float, z: float)
pub struct Vec4(x: float, y: float, z: float, w: float)
pub struct Vector4(x: float, y: float, z: float, w: float)
pub struct IVec2(x: int, y: int)
pub struct IVec3(x: int, y: int, z: int)
pub struct IVec4(x: int, y: int, z: int, w: int)
pub struct UVec2(x: int, y: int)

pub fn Vec2.new(x: float, y: float): Vec2:
  ret Vec2(x = x, y = y)

pub fn Vector2.new(x: float, y: float): Vector2:
  ret Vector2(x = x, y = y)

pub fn (self: Vec2) toVector2(): Vector2:
  ret Vector2(x = self.x, y = self.y)

pub fn (self: Vector2) toVec2(): Vec2:
  ret Vec2(x = self.x, y = self.y)

pub fn (self: Vec2) add(other: Vec2): Vec2:
  ret Vec2(x = self.x + other.x, y = self.y + other.y)

pub fn (self: Vec2) sub(other: Vec2): Vec2:
  ret Vec2(x = self.x - other.x, y = self.y - other.y)

pub fn (self: Vec2) scale(s: float): Vec2:
  ret Vec2(x = self.x * s, y = self.y * s)

pub fn (self: Vec2) dot(other: Vec2): float:
  ret self.x * other.x + self.y * other.y

pub fn (self: Vec2) cross(other: Vec2): float:
  ret self.x * other.y - self.y * other.x

pub fn (self: Vec2) lenSq(): float:
  ret self.x * self.x + self.y * self.y

pub fn (self: Vec2) len(): float:
  ret sqrt(self.lenSq())

pub fn (self: Vec2) length(): float:
  ret self.len()

pub fn (self: Vec2) norm(): Vec2:
  let l = self.len()
  if l > 0.0:
    ret Vec2(x = self.x / l, y = self.y / l)
  ret Vec2(x = 0.0, y = 0.0)

pub fn (self: Vec2) normalize(): Vec2:
  ret self.norm()

pub fn (self: Vec2) dist(other: Vec2): float:
  ret self.sub(other).len()

pub fn (self: Vec2) lerp(other: Vec2, t: float): Vec2:
  ret Vec2(x = self.x + (other.x - self.x) * t, y = self.y + (other.y - self.y) * t)

pub fn (self: Vector2) add(other: Vector2): Vector2:
  ret Vector2(x = self.x + other.x, y = self.y + other.y)

pub fn (self: Vector2) sub(other: Vector2): Vector2:
  ret Vector2(x = self.x - other.x, y = self.y - other.y)

pub fn (self: Vector2) scale(s: float): Vector2:
  ret Vector2(x = self.x * s, y = self.y * s)

pub fn (self: Vector2) dot(other: Vector2): float:
  ret self.x * other.x + self.y * other.y

pub fn (self: Vector2) length(): float:
  ret sqrt(self.x * self.x + self.y * self.y)

pub fn (self: Vector2) normalize(): Vector2:
  let l = self.length()
  if l > 0.0:
    ret Vector2(x = self.x / l, y = self.y / l)
  ret Vector2(x = 0.0, y = 0.0)

pub fn Vec3.new(x: float, y: float, z: float): Vec3:
  ret Vec3(x = x, y = y, z = z)

pub fn Vector3.new(x: float, y: float, z: float): Vector3:
  ret Vector3(x = x, y = y, z = z)

pub fn (self: Vec3) add(other: Vec3): Vec3:
  ret Vec3(x = self.x + other.x, y = self.y + other.y, z = self.z + other.z)

pub fn (self: Vec3) sub(other: Vec3): Vec3:
  ret Vec3(x = self.x - other.x, y = self.y - other.y, z = self.z - other.z)

pub fn (self: Vec3) scale(s: float): Vec3:
  ret Vec3(x = self.x * s, y = self.y * s, z = self.z * s)

pub fn (self: Vec3) dot(other: Vec3): float:
  ret self.x * other.x + self.y * other.y + self.z * other.z

pub fn (self: Vec3) cross(other: Vec3): Vec3:
  ret Vec3(
    x = self.y * other.z - self.z * other.y,
    y = self.z * other.x - self.x * other.z,
    z = self.x * other.y - self.y * other.x
  )

pub fn (self: Vec3) lenSq(): float:
  ret self.x * self.x + self.y * self.y + self.z * self.z

pub fn (self: Vec3) len(): float:
  ret sqrt(self.lenSq())

pub fn (self: Vec3) length(): float:
  ret self.len()

pub fn (self: Vec3) norm(): Vec3:
  let l = self.len()
  if l > 0.0:
    ret Vec3(x = self.x / l, y = self.y / l, z = self.z / l)
  ret Vec3(x = 0.0, y = 0.0, z = 0.0)

pub fn (self: Vec3) normalize(): Vec3:
  ret self.norm()

pub fn (self: Vec3) distanceSquared(other: Vec3): float:
  ret self.sub(other).lenSq()

pub fn (self: Vec3) dist(other: Vec3): float:
  ret self.sub(other).len()

pub fn (self: Vec3) lerp(other: Vec3, t: float): Vec3:
  ret Vec3(
    x = self.x + (other.x - self.x) * t,
    y = self.y + (other.y - self.y) * t,
    z = self.z + (other.z - self.z) * t
  )

pub fn (self: Vector3) add(other: Vector3): Vector3:
  ret Vector3(x = self.x + other.x, y = self.y + other.y, z = self.z + other.z)

pub fn (self: Vector3) sub(other: Vector3): Vector3:
  ret Vector3(x = self.x - other.x, y = self.y - other.y, z = self.z - other.z)

pub fn (self: Vector3) scale(s: float): Vector3:
  ret Vector3(x = self.x * s, y = self.y * s, z = self.z * s)

pub fn (self: Vector3) dot(other: Vector3): float:
  ret self.x * other.x + self.y * other.y + self.z * other.z

pub fn (self: Vector3) length(): float:
  ret sqrt(self.x * self.x + self.y * self.y + self.z * self.z)

pub fn (self: Vector3) normalize(): Vector3:
  let l = self.length()
  if l > 0.0:
    ret Vector3(x = self.x / l, y = self.y / l, z = self.z / l)
  ret Vector3(x = 0.0, y = 0.0, z = 0.0)

pub fn (self: Vector3) distanceSquared(other: Vector3): float:
  let dx = self.x - other.x
  let dy = self.y - other.y
  let dz = self.z - other.z
  ret dx * dx + dy * dy + dz * dz

pub fn (self: Vector3) lerp(other: Vector3, t: float): Vector3:
  ret Vector3(
    x = self.x + (other.x - self.x) * t,
    y = self.y + (other.y - self.y) * t,
    z = self.z + (other.z - self.z) * t
  )

pub fn Vec4.new(x: float, y: float, z: float, w: float): Vec4:
  ret Vec4(x = x, y = y, z = z, w = w)

pub fn (self: Vec4) add(other: Vec4): Vec4:
  ret Vec4(x = self.x + other.x, y = self.y + other.y, z = self.z + other.z, w = self.w + other.w)

pub fn (self: Vec4) sub(other: Vec4): Vec4:
  ret Vec4(x = self.x - other.x, y = self.y - other.y, z = self.z - other.z, w = self.w - other.w)

pub fn (self: Vec4) scale(s: float): Vec4:
  ret Vec4(x = self.x * s, y = self.y * s, z = self.z * s, w = self.w * s)

pub fn (self: Vec4) dot(other: Vec4): float:
  ret self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w

pub fn (self: Vec4) lenSq(): float:
  ret self.dot(self)

pub fn (self: Vec4) len(): float:
  ret sqrt(self.lenSq())

pub fn (self: Vec4) norm(): Vec4:
  let l = self.len()
  if l > 0.0:
    ret self.scale(1.0 / l)
  ret Vec4(x = 0.0, y = 0.0, z = 0.0, w = 0.0)

pub fn distSq2D(x1: int, y1: int, x2: int, y2: int): int:
  let dx = x1 - x2
  let dy = y1 - y2
  ret dx * dx + dy * dy

pub fn inDisk2D(x: int, y: int, cx: int, cy: int, radius: int): bool:
  if radius < 0:
    ret false
  ret distSq2D(x, y, cx, cy) <= (radius * radius)

pub fn distSq2Df(x1: float, y1: float, x2: float, y2: float): float:
  let dx = x1 - x2
  let dy = y1 - y2
  ret dx * dx + dy * dy

pub fn inDisk2Df(x: float, y: float, cx: float, cy: float, radius: float): bool:
  if radius < 0.0:
    ret false
  ret distSq2Df(x, y, cx, cy) <= (radius * radius)

pub fn distSq2DFloat(x1: float, y1: float, x2: float, y2: float): float:
  ret distSq2Df(x1, y1, x2, y2)

pub fn inDisk2DFloat(x: float, y: float, cx: float, cy: float, radius: float): bool:
  ret inDisk2Df(x, y, cx, cy, radius)

pub fn vec4(x: float, y: float, z: float, w: float): Vector4:
  ret Vector4(x = x, y = y, z = z, w = w)

pub fn vec2Lerp(a: Vec2, b: Vec2, t: float): Vec2:
  ret Vec2(x = a.x + (b.x - a.x) * t, y = a.y + (b.y - a.y) * t)

pub fn vec2Distance(a: Vec2, b: Vec2): float:
  ret sqrt(distSq2Df(a.x, a.y, b.x, b.y))

pub fn vec2DistanceSquared(a: Vec2, b: Vec2): float:
  ret distSq2Df(a.x, a.y, b.x, b.y)
