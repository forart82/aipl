/// # Module: `std/math/ease` (`MathEase`)
///
/// ## Purpose & Domain Scope
/// Standard Robert Penner tweening easing curves (linear, quad, cubic, quart,
/// back, elastic, bounce, smoothstep, smootherstep).
module MathEase

import { PI, clampFloat } from "std/math/consts"
import { sin, pow } from "std/math/trig"

pub fn easeLinear(t: float): float:
  ret clampFloat(t, 0.0, 1.0)

pub fn easeInQuad(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  ret c * c

pub fn easeOutQuad(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  ret c * (2.0 - c)

pub fn easeInOutQuad(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  if c < 0.5:
    ret 2.0 * c * c
  ret -1.0 + (4.0 - 2.0 * c) * c

pub fn easeInCubic(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  ret c * c * c

pub fn easeOutCubic(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  let u = c - 1.0
  ret u * u * u + 1.0

pub fn easeInOutCubic(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  if c < 0.5:
    ret 4.0 * c * c * c
  let u = -2.0 * c + 2.0
  ret 1.0 - (u * u * u) * 0.5

pub fn easeInQuart(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  ret c * c * c * c

pub fn easeOutQuart(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  let u = 1.0 - c
  ret 1.0 - u * u * u * u

pub fn easeInOutQuart(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  if c < 0.5:
    ret 8.0 * c * c * c * c
  let u = -2.0 * c + 2.0
  ret 1.0 - (u * u * u * u) * 0.5

pub fn easeInBack(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  let c1 = 1.70158
  let c3 = 2.70158
  ret c3 * c * c * c - c1 * c * c

pub fn easeOutBack(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  let c1 = 1.70158
  let c3 = 2.70158
  let u = c - 1.0
  ret 1.0 + c3 * u * u * u + c1 * u * u

pub fn easeInOutBack(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  let c1 = 1.70158
  let c2 = c1 * 1.525
  if c < 0.5:
    let u = 2.0 * c
    ret (u * u * ((c2 + 1.0) * u - c2)) * 0.5
  let u = 2.0 * c - 2.0
  ret (u * u * ((c2 + 1.0) * u + c2) + 2.0) * 0.5

pub fn easeInElastic(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  if c <= 0.0:
    ret 0.0
  if c >= 1.0:
    ret 1.0
  let c4 = (2.0 * PI) / 3.0
  ret -pow(2.0, 10.0 * c - 10.0) * sin((c * 10.0 - 10.75) * c4)

pub fn easeOutElastic(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  if c <= 0.0:
    ret 0.0
  if c >= 1.0:
    ret 1.0
  let c4 = (2.0 * PI) / 3.0
  ret pow(2.0, -10.0 * c) * sin((c * 10.0 - 0.75) * c4) + 1.0

pub fn easeInOutElastic(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  if c <= 0.0:
    ret 0.0
  if c >= 1.0:
    ret 1.0
  let c5 = (2.0 * PI) / 4.5
  if c < 0.5:
    ret -(pow(2.0, 20.0 * c - 10.0) * sin((20.0 * c - 11.125) * c5)) * 0.5
  ret (pow(2.0, -20.0 * c + 10.0) * sin((20.0 * c - 11.125) * c5)) * 0.5 + 1.0

pub fn easeOutBounce(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  let n1 = 7.5625
  let d1 = 2.75
  if c < 1.0 / d1:
    ret n1 * c * c
  if c < 2.0 / d1:
    let u = c - 1.5 / d1
    ret n1 * u * u + 0.75
  if c < 2.5 / d1:
    let u = c - 2.25 / d1
    ret n1 * u * u + 0.9375
  let u = c - 2.625 / d1
  ret n1 * u * u + 0.984375

pub fn easeInBounce(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  ret 1.0 - easeOutBounce(1.0 - c)

pub fn easeInOutBounce(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  if c < 0.5:
    ret (1.0 - easeOutBounce(1.0 - 2.0 * c)) * 0.5
  ret (1.0 + easeOutBounce(2.0 * c - 1.0)) * 0.5

pub fn easeSmoothstep(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  ret c * c * (3.0 - 2.0 * c)

pub fn easeSmootherstep(t: float): float:
  let c = clampFloat(t, 0.0, 1.0)
  ret c * c * c * (c * (c * 6.0 - 15.0) + 10.0)

pub fn evalEase(mode: int, t: float): float:
  if mode == 1: ret easeInQuad(t)
  if mode == 2: ret easeOutQuad(t)
  if mode == 3: ret easeInOutQuad(t)
  if mode == 4: ret easeInCubic(t)
  if mode == 5: ret easeOutCubic(t)
  if mode == 6: ret easeInOutCubic(t)
  if mode == 7: ret easeInQuart(t)
  if mode == 8: ret easeOutQuart(t)
  if mode == 9: ret easeInOutQuart(t)
  if mode == 10: ret easeInBack(t)
  if mode == 11: ret easeOutBack(t)
  if mode == 12: ret easeInOutBack(t)
  if mode == 13: ret easeOutElastic(t)
  if mode == 14: ret easeOutBounce(t)
  if mode == 15: ret easeSmoothstep(t)
  if mode == 16: ret easeSmootherstep(t)
  ret easeLinear(t)
