/// # Module: `std/math/curve` (`MathCurve`)
///
/// ## Purpose & Domain Scope
/// Parametric curves and trajectory splines: quadratic/cubic Bezier, Catmull-Rom,
/// Hermite splines, tangents, normals, and arc-length sampling.
module MathCurve

import { sqrt } from "std/math/trig"
import { Vec2, Vector2 } from "std/math/vec_math"

pub fn vector2ToVec2(v: Vector2): Vec2:
  ret Vec2(x = v.x, y = v.y)

pub fn vec2ToVector2(v: Vec2): Vector2:
  ret Vector2(x = v.x, y = v.y)

pub fn quadraticBezier2D(p0: Vec2, p1: Vec2, p2: Vec2, t: float): Vec2:
  let u = 1.0 - t
  ret Vec2(
    x = u * u * p0.x + 2.0 * u * t * p1.x + t * t * p2.x,
    y = u * u * p0.y + 2.0 * u * t * p1.y + t * t * p2.y
  )

pub fn cubicBezier2D(p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, t: float): Vec2:
  let u = 1.0 - t
  let tt = t * t
  let uu = u * u
  let uuu = uu * u
  let ttt = tt * t
  ret Vec2(
    x = uuu * p0.x + 3.0 * uu * t * p1.x + 3.0 * u * tt * p2.x + ttt * p3.x,
    y = uuu * p0.y + 3.0 * uu * t * p1.y + 3.0 * u * tt * p2.y + ttt * p3.y
  )

pub fn catmullRom2D(p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, t: float): Vec2:
  let tt = t * t
  let ttt = tt * t
  ret Vec2(
    x = 0.5 * ((2.0 * p1.x) + (-p0.x + p2.x) * t + (2.0 * p0.x - 5.0 * p1.x + 4.0 * p2.x - p3.x) * tt + (-p0.x + 3.0 * p1.x - 3.0 * p2.x + p3.x) * ttt),
    y = 0.5 * ((2.0 * p1.y) + (-p0.y + p2.y) * t + (2.0 * p0.y - 5.0 * p1.y + 4.0 * p2.y - p3.y) * tt + (-p0.y + 3.0 * p1.y - 3.0 * p2.y + p3.y) * ttt)
  )

pub fn hermite2D(p0: Vec2, m0: Vec2, p1: Vec2, m1: Vec2, t: float): Vec2:
  let tt = t * t
  let ttt = tt * t
  let h00 = 2.0 * ttt - 3.0 * tt + 1.0
  let h10 = ttt - 2.0 * tt + t
  let h01 = -2.0 * ttt + 3.0 * tt
  let h11 = ttt - tt
  ret Vec2(
    x = h00 * p0.x + h10 * m0.x + h01 * p1.x + h11 * m1.x,
    y = h00 * p0.y + h10 * m0.y + h01 * p1.y + h11 * m1.y
  )

pub fn evaluateQuadraticBezier(p0: Vector2, p1: Vector2, p2: Vector2, t: float): Vector2:
  let r = quadraticBezier2D(vector2ToVec2(p0), vector2ToVec2(p1), vector2ToVec2(p2), t)
  ret vec2ToVector2(r)

pub fn evaluateQuadraticBezierVec2(p0: Vec2, p1: Vec2, p2: Vec2, t: float): Vec2:
  ret quadraticBezier2D(p0, p1, p2, t)

pub fn evaluateCubicBezier(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, t: float): Vector2:
  let r = cubicBezier2D(vector2ToVec2(p0), vector2ToVec2(p1), vector2ToVec2(p2), vector2ToVec2(p3), t)
  ret vec2ToVector2(r)

pub fn evaluateCubicBezierVec2(p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, t: float): Vec2:
  ret cubicBezier2D(p0, p1, p2, p3, t)

pub fn evaluateCubicBezierTangentVec2(p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, t: float): Vec2:
  let u = 1.0 - t
  let c0 = 3.0 * u * u
  let c1 = 6.0 * u * t
  let c2 = 3.0 * t * t
  ret Vec2(
    x = c0 * (p1.x - p0.x) + c1 * (p2.x - p1.x) + c2 * (p3.x - p2.x),
    y = c0 * (p1.y - p0.y) + c1 * (p2.y - p1.y) + c2 * (p3.y - p2.y)
  )

pub fn evaluateCubicBezierTangent(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, t: float): Vector2:
  let r = evaluateCubicBezierTangentVec2(vector2ToVec2(p0), vector2ToVec2(p1), vector2ToVec2(p2), vector2ToVec2(p3), t)
  ret vec2ToVector2(r)

pub fn evaluateCubicBezierNormalVec2(p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, t: float): Vec2:
  let tan = evaluateCubicBezierTangentVec2(p0, p1, p2, p3, t)
  let l = sqrt(tan.x * tan.x + tan.y * tan.y)
  if l <= 0.000001:
    ret Vec2(x = 0.0, y = 1.0)
  ret Vec2(x = -tan.y / l, y = tan.x / l)

pub fn evaluateCubicBezierNormal(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, t: float): Vector2:
  let r = evaluateCubicBezierNormalVec2(vector2ToVec2(p0), vector2ToVec2(p1), vector2ToVec2(p2), vector2ToVec2(p3), t)
  ret vec2ToVector2(r)

pub fn evaluateCatmullRomVec2(p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, t: float): Vec2:
  ret catmullRom2D(p0, p1, p2, p3, t)

pub fn evaluateCatmullRom(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, t: float): Vector2:
  let r = catmullRom2D(vector2ToVec2(p0), vector2ToVec2(p1), vector2ToVec2(p2), vector2ToVec2(p3), t)
  ret vec2ToVector2(r)

pub fn evaluateUniformCubicBSplineVec2(p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, t: float): Vec2:
  let u = 1.0 - t
  let tt = t * t
  let ttt = tt * t
  let b0 = (u * u * u) / 6.0
  let b1 = (3.0 * ttt - 6.0 * tt + 4.0) / 6.0
  let b2 = (-3.0 * ttt + 3.0 * tt + 3.0 * t + 1.0) / 6.0
  let b3 = ttt / 6.0
  ret Vec2(
    x = b0 * p0.x + b1 * p1.x + b2 * p2.x + b3 * p3.x,
    y = b0 * p0.y + b1 * p1.y + b2 * p2.y + b3 * p3.y
  )

pub fn evaluateUniformCubicBSpline(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, t: float): Vector2:
  let r = evaluateUniformCubicBSplineVec2(vector2ToVec2(p0), vector2ToVec2(p1), vector2ToVec2(p2), vector2ToVec2(p3), t)
  ret vec2ToVector2(r)

pub fn evaluateCubicBezierArcLengthVec2(p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, steps: int): float:
  let n = if steps < 4: 16 else: steps
  mut total = 0.0
  mut prev = p0
  mut i = 1
  while i <= n:
    let curr = evaluateCubicBezierVec2(p0, p1, p2, p3, float(i) / float(n))
    let dx = curr.x - prev.x
    let dy = curr.y - prev.y
    total += sqrt(dx * dx + dy * dy)
    prev = curr
    i += 1
  ret total

pub fn evaluateCubicBezierArcLength(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, steps: int): float:
  ret evaluateCubicBezierArcLengthVec2(vector2ToVec2(p0), vector2ToVec2(p1), vector2ToVec2(p2), vector2ToVec2(p3), steps)
