/// # Module: `std/db/kv_wal` (`DbKvWal`)
///
/// ## Purpose & Domain Scope
/// Crash-safe key-value storage engine (`WalKvStore`) backed by CRC32-verified
/// write-ahead log (WAL) records, in-memory index, atomic batches, log replay,
/// prefix scanning, and tombstone compaction.
module DbKvWal

pub struct WalRecord:
  op: int
  timestamp: int
  key: str
  value: str
  checksum: int

pub struct WalHeader:
  magic: int
  version: int
  segmentId: int
  recordCount: int

pub struct WalBatch:
  mut ops: [WalRecord]

pub struct WalIterator:
  keys: [str]
  values: [str]
  mut idx: int

pub struct WalCompactionStats:
  beforeBytes: int
  afterBytes: int
  tombstoneCount: int
  elapsedMs: int

pub struct WalConfig:
  maxSegmentSizeBytes: int = 65536
  syncEveryWrite: bool = true
  autoCompactThreshold: int = 100

pub struct WalKvStore:
  dirPath: str
  config: WalConfig
  mut memTableKeys: [str]
  mut memTableVals: [str]
  mut walLog: [WalRecord]
  mut isClosed: bool

fn computeRecordChecksum(op: int, timestamp: int, key: str, value: str): int:
  let payload = str(op) + "|" + str(timestamp) + "|" + key + "|" + value
  ret aipl_rt_crc32(payload.toBytes())

fn makeWalRecord(op: int, key: str, value: str): WalRecord:
  let ts = aipl_rt_nowUnixMs()
  let crc = computeRecordChecksum(op, ts, key, value)
  ret WalRecord(op: op, timestamp: ts, key: key, value: value, checksum: crc)

fn findMemKeyIdx(keys: [str], key: str): int:
  mut i = 0
  while i < keys.len():
    if keys[i] == key:
      ret i
    i = i + 1
  ret -1

fn applyMemTablePut(mut store: WalKvStore, key: str, value: str): void:
  let idx = findMemKeyIdx(store.memTableKeys, key)
  if idx >= 0:
    store.memTableVals[idx] = value
  else:
    store.memTableKeys.push(key)
    store.memTableVals.push(value)

fn applyMemTableDelete(mut store: WalKvStore, key: str): void:
  let idx = findMemKeyIdx(store.memTableKeys, key)
  if idx >= 0:
    mut k = idx
    while k + 1 < store.memTableKeys.len():
      store.memTableKeys[k] = store.memTableKeys[k + 1]
      store.memTableVals[k] = store.memTableVals[k + 1]
      k = k + 1
    let _ = store.memTableKeys.pop()
    let _ = store.memTableVals.pop()

pub fn walOpen(dirPath: str, config: WalConfig): Result[WalKvStore, str]:
  if dirPath.trim().len() == 0:
    ret Err("walOpen: empty directory path")
  ret Ok(WalKvStore(
    dirPath: dirPath,
    config: config,
    memTableKeys: [],
    memTableVals: [],
    walLog: [],
    isClosed: false
  ))

pub fn walClose(mut store: WalKvStore): bool:
  if store.isClosed:
    ret false
  store.isClosed = true
  ret true

pub fn walPut(mut store: WalKvStore, key: str, value: str): Result[bool, str]:
  if store.isClosed:
    ret Err("walPut: store is closed")
  let rec = makeWalRecord(1, key, value)
  store.walLog.push(rec)
  applyMemTablePut(store, key, value)
  ret Ok(true)

pub fn walGet(store: WalKvStore, key: str): Option[str]:
  let idx = findMemKeyIdx(store.memTableKeys, key)
  if idx >= 0:
    ret Some(store.memTableVals[idx])
  ret None

pub fn walDelete(mut store: WalKvStore, key: str): Result[bool, str]:
  if store.isClosed:
    ret Err("walDelete: store is closed")
  let rec = makeWalRecord(2, key, "")
  store.walLog.push(rec)
  applyMemTableDelete(store, key)
  ret Ok(true)

pub fn walExists(store: WalKvStore, key: str): bool:
  ret findMemKeyIdx(store.memTableKeys, key) >= 0

pub fn walNewBatch(): WalBatch:
  ret WalBatch(ops: [])

pub fn walBatchPut(mut batch: WalBatch, key: str, value: str): WalBatch:
  batch.ops.push(makeWalRecord(1, key, value))
  ret batch

pub fn walBatchDelete(mut batch: WalBatch, key: str): WalBatch:
  batch.ops.push(makeWalRecord(2, key, ""))
  ret batch

pub fn walCommitBatch(mut store: WalKvStore, batch: WalBatch): Result[int, str]:
  if store.isClosed:
    ret Err("walCommitBatch: store is closed")
  mut count = 0
  mut i = 0
  while i < batch.ops.len():
    let rec = batch.ops[i]
    store.walLog.push(rec)
    if rec.op == 1:
      applyMemTablePut(store, rec.key, rec.value)
    elif rec.op == 2:
      applyMemTableDelete(store, rec.key)
    count = count + 1
    i = i + 1
  ret Ok(count)

pub fn walFlush(mut store: WalKvStore): Result[bool, str]:
  if store.isClosed:
    ret Err("walFlush: store is closed")
  ret Ok(true)

pub fn walCheckpoint(mut store: WalKvStore): Result[int, str]:
  if store.isClosed:
    ret Err("walCheckpoint: store is closed")
  let rec = makeWalRecord(3, "__checkpoint__", str(store.walLog.len()))
  store.walLog.push(rec)
  ret Ok(store.walLog.len())

fn estimateRecordsBytes(records: [WalRecord]): int:
  mut total = 16
  mut i = 0
  while i < records.len():
    total = total + 16 + records[i].key.len() + records[i].value.len()
    i = i + 1
  ret total

pub fn walCompact(mut store: WalKvStore): Result[WalCompactionStats, str]:
  if store.isClosed:
    ret Err("walCompact: store is closed")
  let t0 = aipl_rt_nowUnixMs()
  let beforeBytes = estimateRecordsBytes(store.walLog)
  mut tombstones = 0
  mut i = 0
  while i < store.walLog.len():
    if store.walLog[i].op == 2:
      tombstones = tombstones + 1
    i = i + 1
  mut compacted: [WalRecord] = []
  i = 0
  while i < store.memTableKeys.len():
    compacted.push(makeWalRecord(1, store.memTableKeys[i], store.memTableVals[i]))
    i = i + 1
  store.walLog = compacted
  let afterBytes = estimateRecordsBytes(store.walLog)
  let elapsed = aipl_rt_nowUnixMs() - t0
  ret Ok(WalCompactionStats(
    beforeBytes: beforeBytes,
    afterBytes: afterBytes,
    tombstoneCount: tombstones,
    elapsedMs: elapsed
  ))

pub fn walReplayLog(mut store: WalKvStore, records: [WalRecord]): int:
  mut replayed = 0
  mut i = 0
  while i < records.len():
    let r = records[i]
    let expectedCrc = computeRecordChecksum(r.op, r.timestamp, r.key, r.value)
    if expectedCrc == r.checksum:
      store.walLog.push(r)
      if r.op == 1:
        applyMemTablePut(store, r.key, r.value)
      elif r.op == 2:
        applyMemTableDelete(store, r.key)
      replayed = replayed + 1
    i = i + 1
  ret replayed

pub fn walScanPrefix(store: WalKvStore, prefix: str): [WalRecord]:
  mut out: [WalRecord] = []
  mut i = 0
  while i < store.memTableKeys.len():
    let k = store.memTableKeys[i]
    if k.startsWith(prefix):
      out.push(makeWalRecord(1, k, store.memTableVals[i]))
    i = i + 1
  ret out

pub fn walIteratorNew(store: WalKvStore): WalIterator:
  mut ks: [str] = []
  mut vs: [str] = []
  mut i = 0
  while i < store.memTableKeys.len():
    ks.push(store.memTableKeys[i])
    vs.push(store.memTableVals[i])
    i = i + 1
  ret WalIterator(keys: ks, values: vs, idx: 0)

pub fn walIteratorValid(it: WalIterator): bool:
  ret it.idx >= 0 and it.idx < it.keys.len()

pub fn walIteratorNext(mut it: WalIterator): bool:
  it.idx = it.idx + 1
  ret it.idx >= 0 and it.idx < it.keys.len()

pub fn walIteratorKey(it: WalIterator): str:
  if it.idx >= 0 and it.idx < it.keys.len():
    ret it.keys[it.idx]
  ret ""

pub fn walIteratorValue(it: WalIterator): str:
  if it.idx >= 0 and it.idx < it.values.len():
    ret it.values[it.idx]
  ret ""

pub fn walGetStats(store: WalKvStore): WalCompactionStats:
  let bytesNow = estimateRecordsBytes(store.walLog)
  mut tombstones = 0
  mut i = 0
  while i < store.walLog.len():
    if store.walLog[i].op == 2:
      tombstones = tombstones + 1
    i = i + 1
  ret WalCompactionStats(
    beforeBytes: bytesNow,
    afterBytes: bytesNow,
    tombstoneCount: tombstones,
    elapsedMs: 0
  )

pub fn walVerifyChecksums(records: [WalRecord]): bool:
  mut i = 0
  while i < records.len():
    let r = records[i]
    if computeRecordChecksum(r.op, r.timestamp, r.key, r.value) != r.checksum:
      ret false
    i = i + 1
  ret true
