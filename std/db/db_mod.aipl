/// # Module: `std/db/db_mod` (`DbMod`)
///
/// ## Purpose & Domain Scope
/// Barrel manifest for `std/db/`, re-exporting the embedded relational SQL engine
/// (`sqlite`) and write-ahead log key-value store (`kv_wal`).
module DbMod

import {
  SqliteDb,
  SqliteStmt,
  SqliteRow,
  SqliteTable,
  SqliteValue,
  SqliteConfig,
  SqlMigration,
  SqlMigrationPlan,
  sqliteOpen,
  sqliteOpenInMemory,
  sqliteClose,
  sqliteExec,
  sqliteQuery,
  sqlitePrepare,
  stmtBindInt,
  stmtBindFloat,
  stmtBindStr,
  stmtBindBlob,
  stmtBindNull,
  stmtStep,
  stmtColInt,
  stmtColFloat,
  stmtColStr,
  stmtColBytes,
  stmtColIsNull,
  stmtColName,
  stmtColCount,
  stmtReset,
  stmtFinalize,
  sqliteBegin,
  sqliteCommit,
  sqliteRollback,
  sqliteSavepoint,
  sqliteRollbackTo,
  sqliteReleaseSavepoint,
  sqliteTableExists,
  sqliteGetSchema,
  sqliteCreateMigrationPlan,
  sqliteApplyMigrations,
  sqlRowGet,
  sqlRowCount,
  sqlTableNew,
  sqlTableFilter,
  sqlTableProject
} from "./sqlite.aipl"

import {
  WalKvStore,
  WalRecord,
  WalHeader,
  WalBatch,
  WalIterator,
  WalCompactionStats,
  WalConfig,
  walOpen,
  walClose,
  walPut,
  walGet,
  walDelete,
  walExists,
  walNewBatch,
  walBatchPut,
  walBatchDelete,
  walCommitBatch,
  walFlush,
  walCheckpoint,
  walCompact,
  walReplayLog,
  walScanPrefix,
  walIteratorNew,
  walIteratorNext,
  walIteratorValid,
  walIteratorKey,
  walIteratorValue,
  walGetStats,
  walVerifyChecksums
} from "./kv_wal.aipl"
