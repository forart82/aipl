// ============================================================================
// Module: std/fmt/fmt_mod
// Layer 1: Standard Formatting, Text Manipulation & Unicode Barrel
// ============================================================================
module FmtMod

pub import std.fmt.num_parse
pub import std.fmt.str_builder
pub import std.fmt.text_print
pub import std.fmt.unicode_utf8

import { formatInterpolated, TableColumn, tableNew } from "./text_print.aipl"

pub fn format(templateStr: str, args: [str]): str:
  ret formatInterpolated(templateStr, args)

pub fn printTable(columns: [TableColumn], rows: [[str]]): str:
  mut tbl = tableNew(columns, true)
  mut i = 0
  while i < rows.len:
    tbl.addRow(rows[i])
    i += 1
  ret tbl.render()
