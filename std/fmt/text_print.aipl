// ============================================================================
// Module: std/fmt/text_print
// Layer 1: Standard Formatting, Text Manipulation & Unicode
// Positional template interpolation, formatted multi-column text tables,
// word wrapping, and human-readable units.
// ============================================================================
module FmtTextPrint

import { formatFloatFixed } from "./num_parse.aipl"
import { padLeft, padRight, padCenter, repeat, words } from "./str_builder.aipl"

pub struct TableColumn:
  header: str
  width: int
  align: str

pub struct FormattedTable:
  columns: [TableColumn]
  rows: [[str]]
  hasBorder: bool

pub struct PrintFormatOptions:
  indent: int
  maxDepth: int
  colored: bool

pub fn formatInterpolated(templateStr: str, args: [str]): str:
  mut out = ""
  mut i = 0
  let n = templateStr.len
  mut autoIdx = 0
  while i < n:
    let ch = templateStr.charAt(i)
    if ch == "{" and i + 1 < n:
      if templateStr.charAt(i + 1) == "{":
        out = out + "{"
        i += 2
        continue
      let closeIdx = templateStr.indexOfFrom("}", i + 1)
      if closeIdx > i:
        let token = templateStr.slice(i + 1, closeIdx)
        if token.len == 0:
          if autoIdx < args.len:
            out = out + args[autoIdx]
          autoIdx += 1
          i = closeIdx + 1
          continue
        mut idxVal = 0
        mut validIdx = true
        mut k = 0
        while k < token.len:
          let tc = token.charAt(k)
          if tc >= "0" and tc <= "9":
            idxVal = (idxVal * 10) + (tc.charCodeAt(0) - 48)
          else:
            validIdx = false
            break
          k += 1
        if validIdx and idxVal >= 0 and idxVal < args.len:
          out = out + args[idxVal]
          i = closeIdx + 1
          continue
    elif ch == "}" and i + 1 < n and templateStr.charAt(i + 1) == "}":
      out = out + "}"
      i += 2
      continue
    out = out + ch
    i += 1
  ret out

pub fn tableNew(columns: [TableColumn], hasBorder: bool = true): FormattedTable:
  mut emptyRows: [[str]] = []
  ret FormattedTable(columns = columns, rows = emptyRows, hasBorder = hasBorder)

fn formatTableCell(text: str, width: int, align: str): str:
  let w = if width > 0: width else: 1
  let clipped = if text.len > w: text.slice(0, w) else: text
  if align == "right":
    ret padLeft(clipped, w, " ")
  if align == "center":
    ret padCenter(clipped, w, " ")
  ret padRight(clipped, w, " ")

pub fn (mut self: FormattedTable) addRow(cells: [str]): void:
  mut rowCells: [str] = []
  mut c = 0
  while c < self.columns.len:
    let cellVal = if c < cells.len: cells[c] else: ""
    rowCells.push(cellVal)
    c += 1
  self.rows.push(rowCells)

pub fn (self: FormattedTable) render(): str:
  mut lines: [str] = []
  mut borderParts: [str] = []
  mut headerCells: [str] = []
  mut c = 0
  while c < self.columns.len:
    let col = self.columns[c]
    let w = if col.width > 0: col.width else: 1
    borderParts.push(repeat("-", w + 2))
    headerCells.push(" " + formatTableCell(col.header, w, col.align) + " ")
    c += 1
  let borderLine = "+" + borderParts.join("+") + "+"
  if self.hasBorder:
    lines.push(borderLine)
    lines.push("|" + headerCells.join("|") + "|")
    lines.push(borderLine)
  else:
    lines.push(headerCells.join(" "))
  mut r = 0
  while r < self.rows.len:
    let row = self.rows[r]
    mut formattedCells: [str] = []
    c = 0
    while c < self.columns.len:
      let col = self.columns[c]
      let w = if col.width > 0: col.width else: 1
      let rawVal = if c < row.len: row[c] else: ""
      formattedCells.push(" " + formatTableCell(rawVal, w, col.align) + " ")
      c += 1
    if self.hasBorder:
      lines.push("|" + formattedCells.join("|") + "|")
    else:
      lines.push(formattedCells.join(" "))
    r += 1
  if self.hasBorder:
    lines.push(borderLine)
  ret lines.join("\n")

pub fn formatByteSize(bytes: int): str:
  if bytes < 1024:
    ret str(bytes) + " B"
  let kib = 1024.0
  let mib = 1048576.0
  let gib = 1073741824.0
  let tib = 1099511627776.0
  let fb = float(bytes)
  if fb < mib:
    ret formatFloatFixed(fb / kib, 2) + " KiB"
  if fb < gib:
    ret formatFloatFixed(fb / mib, 2) + " MiB"
  if fb < tib:
    ret formatFloatFixed(fb / gib, 2) + " GiB"
  ret formatFloatFixed(fb / tib, 2) + " TiB"

pub fn formatThousands(num: int, separator: str = ","): str:
  if num == 0:
    ret "0"
  mut isNeg = false
  mut v = num
  if v < 0:
    isNeg = true
    v = -v
  let raw = str(v)
  let n = raw.len
  mut out = ""
  mut i = 0
  while i < n:
    if i > 0 and ((n - i) % 3) == 0:
      out = out + separator
    out = out + raw.charAt(i)
    i += 1
  if isNeg:
    ret "-" + out
  ret out

pub fn wordWrap(text: str, columnWidth: int): [str]:
  mut maxW = columnWidth
  if maxW < 1:
    maxW = 1
  let tokens = words(text)
  mut lines: [str] = []
  if tokens.len == 0:
    ret lines
  mut current = ""
  mut i = 0
  while i < tokens.len:
    let w = tokens[i]
    if current.len == 0:
      current = w
    elif current.len + 1 + w.len <= maxW:
      current = current + " " + w
    else:
      lines.push(current)
      current = w
    i += 1
  if current.len > 0:
    lines.push(current)
  ret lines

pub fn truncateEllipsis(text: str, maxLen: int, ellipsis: str = "..."): str:
  if maxLen <= 0:
    ret ""
  if text.len <= maxLen:
    ret text
  if maxLen <= ellipsis.len:
    ret ellipsis.slice(0, maxLen)
  let keep = maxLen - ellipsis.len
  ret text.slice(0, keep) + ellipsis

pub fn stripAnsi(s: str): str:
  mut out = ""
  mut i = 0
  let n = s.len
  while i < n:
    if s.charCodeAt(i) == 27 and i + 1 < n and s.charAt(i + 1) == "[":
      i += 2
      while i < n:
        let c = s.charCodeAt(i)
        i += 1
        if (c >= 65 and c <= 90) or (c >= 97 and c <= 122):
          break
    else:
      out = out + s.charAt(i)
      i += 1
  ret out
