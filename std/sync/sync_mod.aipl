/// # Module: `std/sync/sync_mod` (`SyncMod`)
///
/// ## Purpose & Domain Scope
/// Unified barrel module re-exporting hardware atomics, thread barriers, MPSC/SPSC/Broadcast
/// channels, mutexes, spinlocks, condition variables, reader-writer locks, and sequence locks.
module SyncMod

pub import * from "./atomic.aipl"
pub import * from "./barrier.aipl"
pub import * from "./channel.aipl"
pub import * from "./mutex.aipl"
pub import * from "./rwlock.aipl"