module GfxGpuPipelineMod

// ============================================================================
// std/gfx/gpu_pipeline.aipl — Render Pipeline State, Blending & Depth/Stencil
// ============================================================================

import { GpuDevice } from "./gpu_device"
import { ShaderModule } from "./gpu_shader"

pub struct BlendMode(enabled: bool, srcColor: int, dstColor: int, opColor: int, srcAlpha: int, dstAlpha: int, opAlpha: int)

pub struct DepthStencilState(depthTest: bool, depthWrite: bool, depthCompareOp: int)

pub struct VertexAttribute(location: int, offsetBytes: int, formatSize: int)

pub struct VertexLayout(strideBytes: int, attributes: [VertexAttribute])

pub struct RenderPipelineState(pipelineId: int, shader: ShaderModule, blend: BlendMode, depth: DepthStencilState, vertexLayout: VertexLayout)

pub fn blendModeAlpha(): BlendMode:
  ret BlendMode(
    enabled = true,
    srcColor = 4,
    dstColor = 5,
    opColor = 0,
    srcAlpha = 1,
    dstAlpha = 5,
    opAlpha = 0
  )

pub fn blendModeAdditive(): BlendMode:
  ret BlendMode(
    enabled = true,
    srcColor = 4,
    dstColor = 1,
    opColor = 0,
    srcAlpha = 1,
    dstAlpha = 1,
    opAlpha = 0
  )

pub fn blendModeOpaque(): BlendMode:
  ret BlendMode(
    enabled = false,
    srcColor = 1,
    dstColor = 0,
    opColor = 0,
    srcAlpha = 1,
    dstAlpha = 0,
    opAlpha = 0
  )

pub fn createRenderPipeline(dev: GpuDevice, shader: ShaderModule, layout: VertexLayout, blend: BlendMode, depth: DepthStencilState): RenderPipelineState:
  let id = if dev.isAlive: 1 else: 0
  ret RenderPipelineState(
    pipelineId = id,
    shader = shader,
    blend = blend,
    depth = depth,
    vertexLayout = layout
  )
