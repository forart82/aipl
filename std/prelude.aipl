// ============================================================================
// Module: std/prelude (Prelude)
// Layer 1 Universal Prelude: Option, Result, Assertions, and Scalar Bounds
// ============================================================================
module Prelude

pub struct Option[T]:
  hasValue: bool
  value: T

pub struct Result[T, E]:
  isSuccess: bool
  value: T
  error: E

/// @intrinsic("aipl_some")
pub fn Some(val: any):
  ret val

/// @intrinsic("aipl_none")
pub fn None():
  ret nil

/// @intrinsic("aipl_opt_is_some")
pub fn (self: Option[T]) isSome(): bool:
  ret self.hasValue

/// @intrinsic("aipl_opt_is_none")
pub fn (self: Option[T]) isNone(): bool:
  ret not self.hasValue

/// @intrinsic("aipl_unwrap")
pub fn (self: Option[T]) unwrap(): T:
  ret self.value

/// @intrinsic("aipl_opt_unwrap_or")
pub fn (self: Option[T]) unwrapOr(defaultVal: T): T:
  if self.hasValue:
    ret self.value
  ret defaultVal

/// @intrinsic("aipl_ok")
pub fn Ok(val: any):
  ret val

/// @intrinsic("aipl_err")
pub fn Err(err: any):
  ret err

/// @intrinsic("aipl_res_is_ok")
pub fn (self: Result[T, E]) isOk(): bool:
  ret self.isSuccess

/// @intrinsic("aipl_res_is_err")
pub fn (self: Result[T, E]) isErr(): bool:
  ret not self.isSuccess

/// @intrinsic("aipl_unwrap")
pub fn (self: Result[T, E]) unwrap(): T:
  ret self.value

/// @intrinsic("aipl_unwrap_err")
pub fn (self: Result[T, E]) unwrapErr(): E:
  ret self.error

/// @intrinsic("aipl_opt_unwrap_or")
pub fn (self: Result[T, E]) unwrapOr(defaultVal: T): T:
  if self.isSuccess:
    ret self.value
  ret defaultVal

/// @intrinsic
pub fn panic(message: str): void:
  assert(false, message)

pub fn todo(message: str): void:
  panic("not yet implemented: " + message)

pub fn unreachable(message: str): void:
  panic("entered unreachable code: " + message)

/// @intrinsic
pub fn assert(cond: bool, message: str): void:
  if not cond:
    panic(message)

pub fn assertEqInt(actual: int, expected: int, message: str): void:
  if actual != expected:
    panic(message + " (actual=" + str(actual) + ", expected=" + str(expected) + ")")

pub fn assertEqStr(actual: str, expected: str, message: str): void:
  if actual != expected:
    panic(message + " (actual='" + actual + "', expected='" + expected + "')")

pub fn assertApproxEq(actual: float, expected: float, eps: float, message: str): void:
  let diff = if actual >= expected: actual - expected else: expected - actual
  if diff > eps:
    panic(message)

/// @intrinsic
pub fn minInt(a: int, b: int): int:
  if a < b:
    ret a
  ret b

/// @intrinsic
pub fn maxInt(a: int, b: int): int:
  if a > b:
    ret a
  ret b

/// @intrinsic
pub fn clampInt(v: int, lo: int, hi: int): int:
  if v < lo:
    ret lo
  if v > hi:
    ret hi
  ret v

/// @intrinsic
pub fn minFloat(a: float, b: float): float:
  if a < b:
    ret a
  ret b

/// @intrinsic
pub fn maxFloat(a: float, b: float): float:
  if a > b:
    ret a
  ret b

/// @intrinsic
pub fn clampFloat(v: float, lo: float, hi: float): float:
  if v < lo:
    ret lo
  if v > hi:
    ret hi
  ret v

pub fn inRangeInt(v: int, lo: int, hi: int): bool:
  ret v >= lo and v <= hi

pub fn inRangeFloat(v: float, lo: float, hi: float): bool:
  ret v >= lo and v <= hi

pub fn boolToInt(b: bool): int:
  if b:
    ret 1
  ret 0

pub fn intToBool(v: int): bool:
  ret v != 0

/// @intrinsic("aipl_rt_cloneStruct")
pub fn cloneStruct(s: any): any:
  ret s
