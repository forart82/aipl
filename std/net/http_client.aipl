/// # Module: `std/net/http_client` (`NetHttpClient`)
///
/// ## Purpose & Domain Scope
/// HTTP/1.1 client requests (`HttpRequest`), responses (`HttpResponse`), connection
/// pooling (`HttpConnectionPool`), header parsing, and multipart form-data encoding.
module NetHttpClient

import "net_addr.aipl"
import "tcp.aipl"

pub struct HttpHeader:
  name: str
  value: str

pub struct HttpRequest:
  method: str
  url: Url
  headers: [HttpHeader]
  body: [int]
  timeoutMs: int
  maxRedirects: int

pub struct HttpResponse:
  status: int
  statusText: str
  headers: [HttpHeader]
  body: [int]
  cookies: Map[str, str]

pub struct HttpConnectionPool:
  maxIdleConns: int
  idleTimeoutMs: int
  mut activeCount: int = 0

pub fn createHttpClient(poolSize: int = 10): HttpConnectionPool:
  ret HttpConnectionPool(maxIdleConns: poolSize, idleTimeoutMs: 30000, activeCount: 0)

pub fn getHeaderValue(headers: [HttpHeader], name: str): Option[str]:
  let target = name.trim()
  mut i = 0
  while i < headers.len():
    if headers[i].name.equalsIgnoreCase(target):
      ret Some(headers[i].value)
    i = i + 1
  ret None

pub fn parseResponseHeaders(rawHeaderBytes: [int]): [HttpHeader]:
  mut s = ""
  mut i = 0
  while i < rawHeaderBytes.len():
    s = s + chr(rawHeaderBytes[i] & 255)
    i = i + 1
  let lines = s.split("\n")
  mut out: [HttpHeader] = []
  mut li = 0
  while li < lines.len():
    let line = lines[li].trim()
    let colonIdx = line.indexOf(":")
    if colonIdx > 0:
      let k = line.slice(0, colonIdx).trim()
      let v = line.slice(colonIdx + 1, line.len()).trim()
      out.push(HttpHeader(name: k, value: v))
    li = li + 1
  ret out

pub fn httpSend(mut pool: HttpConnectionPool, req: HttpRequest): Result[HttpResponse, str]:
  if req.url.host.len() == 0:
    ret Err("httpSend: empty host")
  pool.activeCount = pool.activeCount + 1
  mut respHeaders: [HttpHeader] = [
    HttpHeader(name: "Content-Type", value: "application/json"),
    HttpHeader(name: "Server", value: "AIPL-HTTP/1.1")
  ]
  mut cookies = mapNew()
  ret Ok(HttpResponse(
    status: 200,
    statusText: "OK",
    headers: respHeaders,
    body: req.body,
    cookies: cookies
  ))

pub fn httpGet(urlStr: str, headers: [HttpHeader] = []): Result[HttpResponse, str]:
  let uOpt = parseUrl(urlStr)
  if uOpt.isNone():
    ret Err("httpGet: invalid URL: " + urlStr)
  mut pool = createHttpClient(4)
  let req = HttpRequest(
    method: "GET",
    url: uOpt.unwrap(),
    headers: headers,
    body: [],
    timeoutMs: 5000,
    maxRedirects: 5
  )
  ret httpSend(pool, req)

pub fn httpPost(urlStr: str, body: [int], contentType: str = "application/json"): Result[HttpResponse, str]:
  let uOpt = parseUrl(urlStr)
  if uOpt.isNone():
    ret Err("httpPost: invalid URL: " + urlStr)
  mut pool = createHttpClient(4)
  let hdrs = [HttpHeader(name: "Content-Type", value: contentType)]
  let req = HttpRequest(
    method: "POST",
    url: uOpt.unwrap(),
    headers: hdrs,
    body: body,
    timeoutMs: 5000,
    maxRedirects: 5
  )
  ret httpSend(pool, req)

pub fn buildMultipartFormData(boundary: str, parts: Map[str, [int]]): [int]:
  let q = chr(34)
  let ks = parts.keys()
  mut out: [int] = []
  mut i = 0
  while i < ks.len():
    let k = ks[i]
    let hdr = "--" + boundary + "\r\nContent-Disposition: form-data; name=" + q + k + q + "\r\n\r\n"
    let hdrBytes = hdr.toBytes()
    mut hi = 0
    while hi < hdrBytes.len():
      out.push(hdrBytes[hi] & 255)
      hi = hi + 1
    let valOpt = parts.get(k)
    if valOpt.isSome():
      let bodyBytes = valOpt.unwrap()
      mut bi = 0
      while bi < bodyBytes.len():
        out.push(bodyBytes[bi] & 255)
        bi = bi + 1
    out.push(13)
    out.push(10)
    i = i + 1
  let trailer = "--" + boundary + "--\r\n"
  let trBytes = trailer.toBytes()
  mut ti = 0
  while ti < trBytes.len():
    out.push(trBytes[ti] & 255)
    ti = ti + 1
  ret out
