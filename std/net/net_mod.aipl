/// # Module: `std/net/net_mod` (`NetMod`)
///
/// ## Purpose & Domain Scope
/// Unified barrel module re-exporting IPv4/IPv6/URL addressing, DNS wire packets,
/// TCP/UDP/RUDP transport sockets, HTTP/1.1 client/server, RFC 6455 WebSockets, and JSON-RPC 2.0.
module NetMod

import "net_addr.aipl"
import "dns.aipl"
import "tcp.aipl"
import "udp.aipl"
import "rudp.aipl"
import "http_client.aipl"
import "http_server.aipl"
import "ws.aipl"
import "rpc.aipl"
