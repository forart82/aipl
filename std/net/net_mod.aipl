/// # Module: `std/net/net_mod` (`NetMod`)
///
/// ## Purpose & Domain Scope
/// Unified barrel module re-exporting IPv4/IPv6/URL addressing, DNS wire packets,
/// TCP/UDP/RUDP transport sockets, HTTP/1.1 client/server, RFC 6455 WebSockets, and JSON-RPC 2.0.
module NetMod

pub import * from "./net_addr.aipl"
pub import * from "./dns.aipl"
pub import * from "./tcp.aipl"
pub import * from "./udp.aipl"
pub import * from "./rudp.aipl"
pub import * from "./http_client.aipl"
pub import * from "./http_server.aipl"
pub import * from "./ws.aipl"
pub import * from "./rpc.aipl"
pub import * from "./live_reload_sync.aipl"