module Ex169Gfx2dLight2dShadowRaycastWindow

import { Vec2 } from "../std/math/vec_math"
import { rgba8 } from "../std/gfx/color"
import {
  OccluderSegment2D, createPointLight2D,
  bakeShadowMap1D, sampleLight2DIntensity
} from "../std/gfx2d/light2d"
import {
  initWindow, windowShouldClose, beginDrawing, endDrawing,
  closeWindow, clearScreen, drawRect, drawRectOutline,
  drawCircle, drawLine, drawText, rgb
} from "../std/gfx2d/shape2d"

pub fn stepLight2DPosition(frame: int): Vec2:
  ret Vec2(
    x = 265.0 + float(frame % 37) * 2.8,
    y = 285.0 + float((frame * 3) % 29) * 1.8
  )

pub fn buildLight2dShadowRaycastAudit(): int:
  let col = rgba8(255, 220, 120, 255)
  let light = createPointLight2D(Vec2(x = 0.0, y = 0.0), 120.0, col, 1.0)
  let occluders = [
    OccluderSegment2D(p0 = Vec2(x = 60.0, y = -30.0), p1 = Vec2(x = 60.0, y = 30.0))
  ]
  let smap = bakeShadowMap1D(light, occluders, 36)
  let lit = sampleLight2DIntensity(light, smap, Vec2(x = 30.0, y = 0.0))
  let dark = sampleLight2DIntensity(light, smap, Vec2(x = 90.0, y = 0.0))
  ret smap.resolution + int(lit * 100.0) + int(dark * 100.0)

pub fn main(): int:
  let col = rgba8(255, 220, 120, 255)
  let occluders = [
    OccluderSegment2D(p0 = Vec2(x = 430.0, y = 210.0), p1 = Vec2(x = 430.0, y = 370.0)),
    OccluderSegment2D(p0 = Vec2(x = 220.0, y = 190.0), p1 = Vec2(x = 310.0, y = 190.0))
  ]
  let audit = buildLight2dShadowRaycastAudit()

  initWindow(1280, 720, "AIPL ex_169: 2D Point Light Shadow Map Raycast & Occluders")
  mut frame: int = 0
  while not windowShouldClose():
    let light = createPointLight2D(stepLight2DPosition(frame), 190.0, col, 1.0)
    let smap = bakeShadowMap1D(light, occluders, 48)
    beginDrawing()
    clearScreen(rgb(10, 13, 22))

    drawText("EX_169: 2D POINT LIGHT 1D POLAR SHADOW MAP RAYCAST & OCCLUDERS", 40.0, 28.0, 21.0, rgb(248, 250, 252))
    drawText("std/gfx2d/light2d: createPointLight2D | bakeShadowMap1D | sampleLight2DIntensity | Audit=" + str(audit), 40.0, 58.0, 16.0, rgb(148, 163, 184))

    // Left Panel: 2D Light Intensity Field & Occluder Walls
    drawRect(40.0, 96.0, 600.0, 410.0, rgb(15, 23, 42))
    drawRectOutline(40.0, 96.0, 600.0, 410.0, 2.0, rgb(250, 204, 21))
    drawText("2D ILLUMINATED FIELD & SHADOW UMBRA BEHIND WALLS", 60.0, 118.0, 16.0, rgb(253, 224, 71))

    mut gy: int = 0
    while gy < 12:
      mut gx: int = 0
      while gx < 18:
        let wx = 75.0 + float(gx) * 30.0
        let wy = 152.0 + float(gy) * 28.0
        let inten = sampleLight2DIntensity(light, smap, Vec2(x = wx, y = wy))
        let rVal = 15 + int(inten * 235.0)
        let gVal = 23 + int(inten * 180.0)
        let bVal = 42 + int(inten * 60.0)
        drawRect(wx - 13.0, wy - 12.0, 26.0, 24.0, rgb(rVal, gVal, bVal))
        gx = gx + 1
      gy = gy + 1

    // Draw polar raycast hits from bakeShadowMap1D
    mut ri: int = 0
    while ri < smap.resolution:
      let ang = float(ri) * (6.283185307179586 / float(smap.resolution))
      let hd = smap.distances[ri]
      if hd < light.radius * 0.98:
        let hx = light.position.x + cos(ang) * hd
        let hy = light.position.y + sin(ang) * hd
        drawLine(light.position.x, light.position.y, hx, hy, rgb(253, 224, 71), 1.5)
        drawCircle(hx, hy, 3.5, rgb(56, 189, 248))
      ri = ri + 1

    // Draw Occluder Segments from live occluders array and light.position
    mut oi: int = 0
    while oi < occluders.len():
      let seg = occluders[oi]
      drawLine(seg.p0.x, seg.p0.y, seg.p1.x, seg.p1.y, rgb(244, 63, 94), 6.0)
      oi = oi + 1
    drawCircle(light.position.x, light.position.y, 10.0, rgb(255, 255, 255))

    // Right Panel: 1D Polar Shadow Map Distance Profile (48 Angular Rays)
    drawRect(660.0, 96.0, 580.0, 410.0, rgb(15, 23, 42))
    drawRectOutline(660.0, 96.0, 580.0, 410.0, 2.0, rgb(56, 189, 248))
    drawText("1D POLAR SHADOW MAP DEPTH PROFILE (48 ANGULAR RAYS)", 680.0, 118.0, 16.0, rgb(125, 211, 252))

    mut rayIdx: int = 0
    while rayIdx < smap.resolution:
      let hitDist = smap.distances[rayIdx]
      let ratio = hitDist / light.radius
      let barH = ratio * 280.0
      let bx = 682.0 + float(rayIdx) * 11.0
      let isBlocked = ratio < 0.98
      drawRect(bx, 450.0 - barH, 8.0, barH, if isBlocked: rgb(244, 63, 94) else: rgb(56, 189, 248))
      rayIdx = rayIdx + 1

    drawText("Cyan = Full Light Radius (190 px) | Red = Ray Blocked by Occluder Wall", 682.0, 468.0, 14.0, rgb(203, 213, 225))

    // Bottom Telemetry Strip
    drawRect(40.0, 526.0, 1200.0, 150.0, rgb(15, 23, 42))
    drawRectOutline(40.0, 526.0, 1200.0, 150.0, 2.0, rgb(51, 65, 85))
    drawText("SHADOW MAP RAYCAST TELEMETRY", 60.0, 548.0, 18.0, rgb(56, 189, 248))
    let frontI = sampleLight2DIntensity(light, smap, Vec2(x = 390.0, y = 300.0))
    let backI = sampleLight2DIntensity(light, smap, Vec2(x = 490.0, y = 300.0))
    drawText("Light Pos=(" + str(int(light.position.x)) + "," + str(int(light.position.y)) + ") | In-Front (x=390): " + str(frontI) + " | Behind-Wall (x=490): " + str(backI), 60.0, 584.0, 16.0, rgb(226, 232, 240))
    drawText("Polar Rays=" + str(smap.resolution) + " | Occluder Segments=2 | Audit=" + str(audit), 60.0, 618.0, 16.0, rgb(134, 239, 172))

    endDrawing()
    frame = frame + 1

  closeWindow()
  ret 0
