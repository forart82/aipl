// ============================================================================
// Example 049: O(1) SparseSet Dense Component Registry (CLI)
// Demonstrates: sparseSetNew, .insert(), .contains(), .get(), .ids(),
//               .denseValues(), .remove(), and .clear() from
//               std/collections/sparse_set.
// ============================================================================
module Ex049CollectionsSparseSetRegistryCli

import { sparseSetNew } from "../std/collections/sparse_set"

pub fn evaluateSparseSetSwapRemoveDensity(): int:
  mut ss = sparseSetNew[int](64)
  ss.insert(42, 100)
  ss.insert(7, 200)
  ss.insert(19, 300)
  let removed = ss.remove(7)
  let dense = ss.denseValues()
  let ids = ss.ids()
  if removed and not ss.contains(7) and dense.len == 2 and ids.len == 2:
    ret dense[0] + dense[1]
  ret -1

pub fn verifySparseSetLookupAndClear(entityId: int, tag: str): str:
  mut ss = sparseSetNew[str](64)
  ss.insert(entityId, tag)
  let found = ss.get(entityId).unwrap()
  ss.clear()
  ret found + ":" + str(ss.len())

pub fn describeSparseSetComplexity(modeId: int): str:
  if modeId == 0:
    ret "SPARSESET:O1_INSERT_REMOVE_DENSE_ITER"
  ret "SPARSESET:PAGED_INDIRECT_ARRAY"

pub fn main(): int:
  let denseSum = evaluateSparseSetSwapRemoveDensity()
  let lookupTag = verifySparseSetLookupAndClear(42, "hero_actor")
  println("SparseSet Dense Values Sum After Swap-Remove: " + str(denseSum))
  println("Lookup & Clear Result: " + lookupTag + " (" + describeSparseSetComplexity(0) + ")")
  ret 0
