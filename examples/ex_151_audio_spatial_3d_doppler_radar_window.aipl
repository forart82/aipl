// ============================================================================
// Canonical Example 151: 3D Spatial Audio Attenuation & Doppler Radar (WINDOW)
// Target Profile: WINDOW | Standard Library Module: std/audio/audio_spatial
// ============================================================================
module Ex151AudioSpatial3dDopplerRadarWindow

import {
  AudioListener3D,
  AudioEmitter3D,
  SpatialGain,
  createAudioListener3D,
  createAudioEmitter3D,
  computeSpatialGain,
  computeInverseDistanceAttenuation,
  computeDopplerFactor
} from "../std/audio/audio_spatial.aipl"
import {
  initWindow,
  windowShouldClose,
  beginDrawing,
  endDrawing,
  closeWindow,
  clearScreen,
  drawRect,
  drawRectOutline,
  drawCircle,
  drawCircleOutline,
  drawLine,
  drawText,
  rgb
} from "../std/gfx2d/shape2d.aipl"
import { clampInt, maxInt } from "../std/std_root.aipl"
import { playToneEx } from "../std/audio/audio_device.aipl"

pub fn verifySpatialAudioGainAndDoppler(): int:
  let listener = createAudioListener3D()
  mut emitter = createAudioEmitter3D(1.0, 50.0)
  emitter.x = 10.0
  let gain = computeSpatialGain(listener, emitter, 343.0)
  assert(gain.gainRight > gain.gainLeft, "right ear gain dominates")

  let atten = computeInverseDistanceAttenuation(10.0, 1.0, 50.0, 1.0)
  let attenPm = int(atten * 1000.0 + 0.5)
  let doppler = computeDopplerFactor(0.0, 34.3, 343.0)
  let dopplerPm = int(doppler * 1000.0 + 0.5)
  ret attenPm + dopplerPm

pub fn computeDopplerShiftedFreqHz(baseFreqHz: int, dopplerPermille: int): int:
  let f = maxInt(20, baseFreqHz)
  let d = clampInt(dopplerPermille, 250, 4000)
  ret (f * d) / 1000

pub fn describeSpatialRolloffModel(modelId: int): str:
  if modelId == 1:
    ret "SPATIAL:INVERSE_DISTANCE_DOPPLER_343MS"
  ret "SPATIAL:LINEAR_DISTANCE_CLAMPED"

pub fn stepSpatialEmitterFrame(frameIndex: int): (AudioListener3D, AudioEmitter3D, SpatialGain):
  let listener = createAudioListener3D()
  mut emitter = createAudioEmitter3D(1.0, 50.0)
  let offsetPx = float(((frameIndex * 5) % 360) - 180)
  emitter.x = offsetPx / 15.0
  emitter.z = -4.5
  emitter.velX = 34.3
  let gain = computeSpatialGain(listener, emitter, 343.0)
  ret (listener, emitter, gain)

pub fn renderFrameStep(frameIndex: int, dt: float): int:
  let (_, _, gain) = stepSpatialEmitterFrame(frameIndex)
  let dopplerPm = int(gain.dopplerPitchShift * 1000.0 + 0.5)
  let shiftedHz = computeDopplerShiftedFreqHz(440, dopplerPm)
  let rGainPm = int(gain.gainRight * 1000.0 + 0.5)
  ret verifySpatialAudioGainAndDoppler() + shiftedHz + rGainPm + int(dt * 0.0)

pub fn renderSpatialDopplerRadarScene(frameIndex: int): void:
  let (listener, emitter, gain) = stepSpatialEmitterFrame(frameIndex)
  let dopplerPm = int(gain.dopplerPitchShift * 1000.0 + 0.5)
  let shiftedHz = computeDopplerShiftedFreqHz(440, dopplerPm)

  clearScreen(rgb(10, 14, 24))
  drawRect(32.0, 20.0, 1216.0, 54.0, rgb(18, 28, 48))
  drawRectOutline(32.0, 20.0, 1216.0, 54.0, 2.0, rgb(56, 189, 248))
  drawText("EX_151 // 3D SPATIAL AUDIO ATTENUATION RADAR & DOPPLER WAVEFRONT CONE", 52.0, 38.0, 20.0, rgb(240, 249, 255))

  // Left: Acoustic Radar Field driven by emitter.maxDistance
  let rcx = 430.0 + listener.x * 15.0
  let rcy = 385.0 + listener.z * 15.0
  let radarR = emitter.maxDistance * 5.0
  drawCircle(rcx, rcy, radarR, rgb(14, 21, 36))
  drawCircleOutline(rcx, rcy, radarR, 2.0, rgb(51, 65, 85))
  drawCircleOutline(rcx, rcy, radarR * 0.68, 1.5, rgb(30, 41, 59))
  drawCircleOutline(rcx, rcy, radarR * 0.36, 1.5, rgb(30, 41, 59))
  drawLine(rcx - radarR, rcy, rcx + radarR, rcy, rgb(30, 41, 59), 1.5)
  drawLine(rcx, rcy - radarR, rcx, rcy + radarR, rgb(30, 41, 59), 1.5)

  // Central Listener Head
  drawCircle(rcx, rcy, 14.0, rgb(34, 197, 94))
  drawText("LISTENER (0,0,0)", rcx - 60.0, rcy + 24.0, 14.0, rgb(134, 239, 172))

  // Moving Sound Emitter & Compressed Doppler Wavefront Rings driven by emitter.x/z & dopplerPitchShift
  let ex = rcx + emitter.x * 15.0
  let ey = rcy + emitter.z * 15.0
  drawCircle(ex, ey, 12.0, rgb(249, 115, 22))
  mut w = 1
  while w <= 4:
    let rad = float(w * 24)
    let shiftX = float(w) * (emitter.velX * 0.3) * gain.dopplerPitchShift
    drawCircleOutline(ex - shiftX, ey, rad, 1.5, rgb(56, 189, 248))
    w = w + 1
  drawLine(rcx, rcy, ex, ey, rgb(250, 204, 21), 2.0)

  // Right: Binaural Panning & Doppler Pitch Telemetry
  let px = 750.0
  drawRect(px, 104.0, 474.0, 560.0, rgb(16, 24, 42))
  drawRectOutline(px, 104.0, 474.0, 560.0, 2.0, rgb(56, 189, 248))
  drawText("BINAURAL & DOPPLER HUD", px + 24.0, 136.0, 18.0, rgb(56, 189, 248))
  drawText(describeSpatialRolloffModel(1), px + 24.0, 176.0, 14.0, rgb(74, 222, 128))
  drawText("Speed of Sound: 343.0 m/s | Emitter X=" + str(int(emitter.x)) + "m", px + 24.0, 216.0, 15.0, rgb(226, 232, 240))
  drawText("Doppler Pitch: 440Hz -> " + str(shiftedHz) + "Hz (" + str(dopplerPm) + " pm)", px + 24.0, 252.0, 15.0, rgb(250, 204, 21))

  // Left Ear vs Right Ear Gain Bars driven by gain.gainLeft and gain.gainRight
  let lW = clampInt(int(gain.gainLeft * 900.0), 12, 380)
  let rW = clampInt(int(gain.gainRight * 900.0), 12, 380)
  drawText("LEFT EAR GAIN (" + str(int(gain.gainLeft * 1000.0)) + " pm):", px + 24.0, 310.0, 15.0, rgb(125, 211, 252))
  drawRect(px + 24.0, 336.0, float(lW), 24.0, rgb(56, 189, 248))
  drawText("RIGHT EAR GAIN (" + str(int(gain.gainRight * 1000.0)) + " pm):", px + 24.0, 384.0, 15.0, rgb(216, 180, 254))
  drawRect(px + 24.0, 410.0, float(rW), 24.0, rgb(168, 85, 247))

  // Doppler Pitch Shift Gauge (440Hz center reference)
  drawText("DOPPLER FREQUENCY SHIFT GAUGE (REF 440 HZ):", px + 24.0, 468.0, 15.0, rgb(250, 204, 21))
  drawRect(px + 24.0, 496.0, 420.0, 28.0, rgb(24, 34, 56))
  drawRectOutline(px + 24.0, 496.0, 420.0, 28.0, 1.5, rgb(100, 116, 139))
  drawLine(px + 234.0, 490.0, px + 234.0, 530.0, rgb(226, 232, 240), 2.0)
  let freqDeltaPx = float(clampInt((shiftedHz - 440) * 3, -195, 195))
  let markerX = px + 234.0 + freqDeltaPx
  drawCircle(markerX, 510.0, 9.0, if shiftedHz >= 440: rgb(34, 197, 94) else: rgb(244, 63, 94))
  let regimeLabel = if shiftedHz >= 440: "APPROACHING (+BLUE SHIFT)" else: "RECEDING (-RED SHIFT)"
  drawText("Acoustic Regime: " + regimeLabel, px + 24.0, 552.0, 15.0, if shiftedHz >= 440: rgb(134, 239, 172) else: rgb(251, 113, 133))

pub fn main(): int:
  let m = verifySpatialAudioGainAndDoppler()
  assert(m == 1211, "spatial metric 1211")
  initWindow(1280, 720, "AIPL ex_151 - 3D Spatial Audio Attenuation & Doppler Radar")
  mut frame: int = 0
  while not windowShouldClose():
    if frame % 12 == 0:
      let (_, _, g) = stepSpatialEmitterFrame(frame)
      let dopplerHz = float(computeDopplerShiftedFreqHz(440, int(g.dopplerPitchShift * 1000.0 + 0.5)))
      let _ = playToneEx(dopplerHz, 160.0, 0.30, "triangle")
    beginDrawing()
    renderSpatialDopplerRadarScene(frame)
    endDrawing()
    frame = frame + 1
  closeWindow()
  ret 0
