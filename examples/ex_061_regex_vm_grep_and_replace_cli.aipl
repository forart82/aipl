// ============================================================================
// Example 061: PikeVM Regex Grep, Capture Groups & Replace (CLI)
// Demonstrates: regexCompile, .isMatch(), .find(), .findAll(), .captures(),
//               .replaceAll(), .split(), regexMatch, and regexReplaceAll
//               from std/regex.
// ============================================================================
module Ex061RegexVmGrepAndReplaceCli

import {
  regexCompile,
  regexMatch,
  regexReplaceAll
} from "../std/regex"

pub fn rewriteIsoDateWithCaptures(text: str): str:
  let reDate = regexCompile("(\\d{4})-(\\d{2})-(\\d{2})").unwrap()
  let caps = reDate.captures(text)
  if caps.len == 4:
    ret reDate.replaceAll(text, "$3/$2/$1")
  ret "ERR"

pub fn countGrepDigitMatchesAndSplit(): int:
  let reDigits = regexCompile("\\d+").unwrap()
  let matches = reDigits.findAll("a12b345c6")
  let reSep = regexCompile("[,;]+").unwrap()
  let tokens = reSep.split("a,b;;c,d")
  let masked = regexReplaceAll("\\d+", "id42_v7", "X")
  if regexMatch("\\d+", "id42") and masked == "idX_vX":
    ret matches.len + tokens.len
  ret -1

pub fn describePikeVmComplexity(modeId: int): str:
  if modeId == 0:
    ret "PIKE_VM:LINEAR_TIME_NO_REDOS"
  ret "PIKE_VM:SPARSE_STATE_SET"

pub fn main(): int:
  let rewritten = rewriteIsoDateWithCaptures("Release: 2026-11-06 OK")
  let grepCount = countGrepDigitMatchesAndSplit()
  println("Rewritten Date Capture: " + rewritten)
  println("Grep Digit Matches + Split Tokens: " + str(grepCount) + " (" + describePikeVmComplexity(0) + ")")
  ret 0
