module Ex215SpatialWaypointGraphWorldWindow

import { Vec3 } from "../std/math/vec_math"
import {
  WaypointNode, WaypointEdge, waypointGraphWorldNew, waypointAddNode, waypointAddEdge,
  waypointShortestPathDijkstra, waypointNodesInRadius
} from "../std/spatial/waypoint_graph_world"
import {
  initWindow, windowShouldClose, beginDrawing, endDrawing, closeWindow,
  clearScreen, drawRect, drawRectOutline, drawCircle, drawCircleOutline,
  drawLine, drawText, rgb
} from "../std/gfx2d/shape2d"

pub fn stepWaypointRoutePreset(frame: int): int:
  ret (frame / 8) % 3

pub fn stepTravelerSegmentT(frame: int): float:
  ret float((frame * 3) % 29) / 29.0

fn isNodeInList(ids: [int], target: int): bool:
  mut i = 0
  while i < ids.len():
    if ids[i] == target:
      ret true
    i = i + 1
  ret false

pub fn buildSpatialWaypointGraphAudit(): int:
  mut wgw = waypointGraphWorldNew()
  waypointAddNode(wgw, 1, "Alpha", Vec3(x = 0.0, y = 0.0, z = 0.0))
  waypointAddNode(wgw, 2, "Beta", Vec3(x = 10.0, y = 0.0, z = 0.0))
  waypointAddNode(wgw, 3, "Gamma", Vec3(x = 25.0, y = 0.0, z = 0.0))
  waypointAddEdge(wgw, 1, 2, 10.0, true)
  waypointAddEdge(wgw, 2, 3, 15.0, true)
  let path = waypointShortestPathDijkstra(wgw, 1, 3).unwrap()
  let radNodes = waypointNodesInRadius(wgw, Vec3(x = 0.0, y = 0.0, z = 0.0), 12.0)
  ret path.len() + path[0] + path[1] + path[2] + radNodes.len()

pub fn main(): int:
  let auditScore = buildSpatialWaypointGraphAudit()
  mut wgw = waypointGraphWorldNew()
  waypointAddNode(wgw, 1, "Hub-Alpha", Vec3(x = 190.0, y = 395.0, z = 0.0))
  waypointAddNode(wgw, 2, "Relay-North", Vec3(x = 460.0, y = 255.0, z = 0.0))
  waypointAddNode(wgw, 3, "Relay-South", Vec3(x = 460.0, y = 530.0, z = 0.0))
  waypointAddNode(wgw, 4, "Bridge-Core", Vec3(x = 790.0, y = 255.0, z = 0.0))
  waypointAddNode(wgw, 5, "Depot-South", Vec3(x = 790.0, y = 530.0, z = 0.0))
  waypointAddNode(wgw, 6, "Citadel-Omega", Vec3(x = 1070.0, y = 395.0, z = 0.0))

  waypointAddEdge(wgw, 1, 2, 12.0, true)
  waypointAddEdge(wgw, 1, 3, 14.0, true)
  waypointAddEdge(wgw, 2, 3, 19.0, true)
  waypointAddEdge(wgw, 2, 4, 10.0, true)
  waypointAddEdge(wgw, 3, 5, 11.0, true)
  waypointAddEdge(wgw, 4, 5, 15.0, true)
  waypointAddEdge(wgw, 4, 6, 11.0, true)
  waypointAddEdge(wgw, 5, 6, 16.0, true)

  initWindow(1280, 720, "AIPL ex_215: Spatial Waypoint Graph World & Dijkstra Shortest Path")
  mut frame = 0
  while not windowShouldClose():
    let preset = stepWaypointRoutePreset(frame)
    let startId = if preset == 0: 1 else: (if preset == 1: 3 else: 1)
    let goalId = if preset == 0: 6 else: (if preset == 1: 4 else: 5)
    let path = waypointShortestPathDijkstra(wgw, startId, goalId).unwrap()
    let segIdx = (frame / 11) % (path.len() - 1)
    let segT = stepTravelerSegmentT(frame)
    let pA: WaypointNode = wgw.nodes[path[segIdx] - 1]
    let pB: WaypointNode = wgw.nodes[path[segIdx + 1] - 1]
    let travelerPos = Vec3(
      x = pA.position.x + (pB.position.x - pA.position.x) * segT,
      y = pA.position.y + (pB.position.y - pA.position.y) * segT,
      z = 0.0
    )
    let radiusRange = 150.0
    let nearNodes = waypointNodesInRadius(wgw, travelerPos, radiusRange)

    beginDrawing()
    clearScreen(rgb(10, 14, 24))

    drawRect(32.0, 24.0, 1216.0, 68.0, rgb(18, 28, 48))
    drawRectOutline(32.0, 24.0, 1216.0, 68.0, 2.0, rgb(56, 189, 248))
    drawText("EX_215: WAYPOINT GRAPH WORLD (DIJKSTRA SHORTEST PATH & RADIUS QUERY)", 52.0, 40.0, 22.0, rgb(240, 249, 255))
    drawText("nodes=" + str(wgw.nodes.len()) + " edges=" + str(wgw.edges.len()) + " | route=#" + str(startId) + "->#" + str(goalId) + " (hops=" + str(path.len()) + ") | inRadius=" + str(nearNodes.len()) + " | audit=" + str(auditScore), 52.0, 66.0, 16.0, rgb(125, 211, 252))

    // Draw all topological graph edge lines first
    mut eLineIdx = 0
    while eLineIdx < wgw.edges.len():
      let ed0: WaypointEdge = wgw.edges[eLineIdx]
      let uN0: WaypointNode = wgw.nodes[ed0.fromId - 1]
      let vN0: WaypointNode = wgw.nodes[ed0.toId - 1]
      drawLine(uN0.position.x, uN0.position.y, vN0.position.x, vN0.position.y, rgb(51, 65, 85), 2.5)
      eLineIdx = eLineIdx + 1

    // Highlight Optimal Dijkstra Route lines before drawing weight pills
    mut pIdx = 0
    while pIdx + 1 < path.len():
      let uNode: WaypointNode = wgw.nodes[path[pIdx] - 1]
      let vNode: WaypointNode = wgw.nodes[path[pIdx + 1] - 1]
      drawLine(uNode.position.x, uNode.position.y, vNode.position.x, vNode.position.y, rgb(52, 211, 153), 5.0)
      pIdx = pIdx + 1

    // Draw edge weight badges cleanly on top of edge lines
    mut eIdx = 0
    while eIdx < wgw.edges.len():
      let ed: WaypointEdge = wgw.edges[eIdx]
      let uN: WaypointNode = wgw.nodes[ed.fromId - 1]
      let vN: WaypointNode = wgw.nodes[ed.toId - 1]
      let mx = (uN.position.x + vN.position.x) * 0.5
      let my = (uN.position.y + vN.position.y) * 0.5
      drawRect(mx - 23.0, my - 11.0, 46.0, 22.0, rgb(15, 23, 42))
      drawRectOutline(mx - 23.0, my - 11.0, 46.0, 22.0, 1.5, rgb(100, 116, 139))
      drawText("w=" + str(int(ed.weight)), mx - 17.0, my - 6.0, 12.0, rgb(226, 232, 240))
      eIdx = eIdx + 1

    // Highlight active route weight pill outlines
    mut pBadge = 0
    while pBadge + 1 < path.len():
      let uB: WaypointNode = wgw.nodes[path[pBadge] - 1]
      let vB: WaypointNode = wgw.nodes[path[pBadge + 1] - 1]
      let pmx = (uB.position.x + vB.position.x) * 0.5
      let pmy = (uB.position.y + vB.position.y) * 0.5
      drawRectOutline(pmx - 24.0, pmy - 12.0, 48.0, 24.0, 2.0, rgb(52, 211, 153))
      pBadge = pBadge + 1

    // Draw Spatial Radius Query around Traveler Agent
    drawCircleOutline(travelerPos.x, travelerPos.y, radiusRange, 1.8, rgb(250, 204, 21))
    drawCircle(travelerPos.x, travelerPos.y, 11.0, rgb(250, 204, 21))
    drawCircleOutline(travelerPos.x, travelerPos.y, 16.0, 2.0, rgb(250, 204, 21))

    // Draw Waypoint Nodes
    mut idx = 0
    while idx < wgw.nodes.len():
      let nd: WaypointNode = wgw.nodes[idx]
      let onPath = isNodeInList(path, nd.id)
      let inRad = isNodeInList(nearNodes, nd.id)
      let isEndpoint = nd.id == startId or nd.id == goalId
      let col = if isEndpoint: rgb(250, 204, 21) else: (if onPath: rgb(52, 211, 153) else: (if inRad: rgb(56, 189, 248) else: rgb(100, 116, 139)))
      let fillCol = if isEndpoint: rgb(66, 32, 6) else: (if onPath: rgb(6, 78, 59) else: rgb(17, 24, 39))
      drawCircle(nd.position.x, nd.position.y, 28.0, fillCol)
      drawCircleOutline(nd.position.x, nd.position.y, 28.0, 3.0, col)
      drawText("#" + str(nd.id), nd.position.x - 11.0, nd.position.y - 8.0, 16.0, rgb(248, 250, 252))
      let labelY = if nd.position.y < 300.0: nd.position.y - 50.0 else: nd.position.y + 36.0
      drawText(nd.name, nd.position.x - 48.0, labelY, 15.0, col)
      idx = idx + 1

    endDrawing()
    frame = frame + 1

  closeWindow()
  println("Audit score: " + str(auditScore))
  ret 0
