// ============================================================================
// Example 043: DynVec Growth, Slice Views & Natural Sorting (CLI)
// Demonstrates: dynVecNew, dynVecWithCapacity, .push(), .set(), .insert(),
//               .remove(), .reverse(), .asSlice(), .swapRemove(), sortInts,
//               sortStrings, and sortStringsNatural from std/collections/dyn_vec.
// ============================================================================
module Ex043CollectionsDynVecAndSortCli

import {
  dynVecNew,
  dynVecWithCapacity,
  sortInts,
  sortStrings,
  sortStringsNatural
} from "../std/collections/dyn_vec"

pub fn verifyDynVecMutationsAndSlice(): int:
  mut v = dynVecNew[int]()
  let vCap = dynVecWithCapacity[int](32)
  v.reserve(16)
  v.push(10)
  v.push(20)
  v.push(30)
  let _ = v.set(1, 25)
  let _ = v.insert(1, 15)
  let removed = v.remove(1).unwrap()
  v.reverse()
  let sl = v.asSlice(0, 2)
  let firstTwo = sl.get(0).unwrap() + sl.get(1).unwrap()
  let swapped = v.swapRemove(0).unwrap()
  if vCap.cap() == 32 and removed == 15 and swapped == 30:
    ret firstTwo
  ret -1

pub fn verifyLexicographicAndNaturalSorting(): str:
  let nums = sortInts([40, 10, 30, 20])
  let words = sortStrings(["zeta", "alpha", "beta"])
  let files = sortStringsNatural(["f10", "f2", "f100"])
  if words[0] == "alpha":
    ret files[0] + ":" + str(nums[0])
  ret "ERR"

pub fn describeSortStrategy(natural: bool): str:
  if natural:
    ret "SORT:ALPHANUMERIC_NATURAL"
  ret "SORT:LEXICOGRAPHIC_ASCII"

pub fn main(): int:
  let sliceSum = verifyDynVecMutationsAndSlice()
  let sortTag = verifyLexicographicAndNaturalSorting()
  println("DynVec Reversed Slice Sum: " + str(sliceSum))
  println("Natural Sort First Item & Min Int: " + sortTag + " (" + describeSortStrategy(true) + ")")
  ret 0
