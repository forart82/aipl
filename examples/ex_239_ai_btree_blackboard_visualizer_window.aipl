module Ex239AiBtreeBlackboardVisualizerWindow

import {
  BTreeNodeStatus, BTreeNodeType, Blackboard, BlackboardEntry, BehaviorTreeNode,
  blackboardNew, blackboardSet, blackboardGet, blackboardHasKey,
  btreeTickNode, btreeCreateSequence, btreeCreateSelector, btreeCreateAction,
  btSuccess, btFailure, btRunning, btInvert, btSequence, btSelector
} from "../std/ai/btree_ai"
import {
  initWindow, windowShouldClose, beginDrawing, endDrawing, closeWindow,
  clearScreen, drawRect, drawRectOutline, drawCircle, drawCircleOutline,
  drawLine, drawText, rgb
} from "../std/gfx2d/shape2d"

pub struct BtreeScene(bb: Blackboard, nodes: [BehaviorTreeNode], lastStatus: BTreeNodeStatus, rootSelectorStatus: BTreeNodeStatus, invAmmoStatus: BTreeNodeStatus, tickCount: int)

pub fn createBtreeScene(): BtreeScene:
  mut bb = blackboardNew()
  blackboardSet(bb, "targetId", 42)
  blackboardSet(bb, "ammoCount", 12)
  blackboardSet(bb, "alertLevel", 3)
  blackboardSet(bb, "reloadReady", 1)
  blackboardSet(bb, "burstShots", 0)
  let nSeq = btreeCreateSequence(0, [1, 2])
  let nAct1 = btreeCreateAction(1, "targetId")
  let nAct2 = btreeCreateAction(2, "ammoCount")
  let nRootSel = btreeCreateSelector(3, [0, 5])
  let nInvAmmo = BehaviorTreeNode(id = 4, nodeType = BTreeNodeType.Inverter, children = [2], cooldownSeconds = 0.0, actionName = "!ammo")
  let nReloadSeq = btreeCreateSequence(5, [4, 6])
  let nActReload = btreeCreateAction(6, "reloadReady")
  let nodes = [nSeq, nAct1, nAct2, nRootSel, nInvAmmo, nReloadSeq, nActReload]
  let st = btreeTickNode(nSeq, nodes, bb)
  let rootSt = btreeTickNode(nRootSel, nodes, bb)
  let invSt = btreeTickNode(nInvAmmo, nodes, bb)
  ret BtreeScene(
    bb = bb,
    nodes = nodes,
    lastStatus = st,
    rootSelectorStatus = rootSt,
    invAmmoStatus = invSt,
    tickCount = 0
  )

pub fn stepScene(mut scene: BtreeScene, frame: int, dt: float): void:
  mut bb = scene.bb
  let curAmmo = blackboardGet(bb, "ammoCount").unwrap()
  let curBursts = blackboardGet(bb, "burstShots").unwrap()
  let st = btreeTickNode(scene.nodes[0], scene.nodes, bb)
  let rootSt = btreeTickNode(scene.nodes[3], scene.nodes, bb)
  let invSt = btreeTickNode(scene.nodes[4], scene.nodes, bb)
  scene.lastStatus = st
  scene.rootSelectorStatus = rootSt
  scene.invAmmoStatus = invSt
  if curAmmo > 0:
    blackboardSet(bb, "ammoCount", curAmmo - 1)
    blackboardSet(bb, "burstShots", curBursts + 1)
  else:
    let nextClip = if scene.tickCount < 30: 15 else: 12
    blackboardSet(bb, "ammoCount", nextClip)
  blackboardSet(bb, "alertLevel", 1 + ((frame / 3) % 4))
  scene.bb = bb
  scene.tickCount = scene.tickCount + 1

pub fn auditAiBtreeBlackboardVisualizer(): int:
  mut bb = blackboardNew()
  blackboardSet(bb, "targetId", 42)
  blackboardSet(bb, "ammoCount", 12)
  let nAct = btreeCreateAction(1, "targetId")
  let nSeq = btreeCreateSequence(0, [1])
  let nSel = btreeCreateSelector(2, [1])
  let status = btreeTickNode(nSeq, [nSeq, nAct, nSel], bb)
  let tVal = blackboardGet(bb, "targetId").unwrap()
  mut ok = 0
  if status == BTreeNodeStatus.Success and blackboardHasKey(bb, "targetId"):
    ok = 1
  ret tVal + ok + btSequence([1, 1]) + btSelector([0, 1]) + btInvert(btFailure()) - btSuccess()

pub fn main(): int:
  let audit = auditAiBtreeBlackboardVisualizer()
  println("EX_239_AI_BTREE_AUDIT=" + str(audit))

  mut scene = createBtreeScene()

  initWindow(1280, 720, "AIPL ex_239: Behavior Tree & Blackboard Visualizer")
  mut frame = 0
  while not windowShouldClose():
    stepScene(scene, frame, 0.1)
    let isAttackOk = scene.lastStatus == BTreeNodeStatus.Success
    let isInvOk = scene.invAmmoStatus == BTreeNodeStatus.Success
    let stText = if isAttackOk: "FIRE_SEQ=SUCCESS" else: "FIRE_SEQ=FAIL -> FALLBACK_RELOAD=SUCCESS"
    let n1: BehaviorTreeNode = scene.nodes[1]
    let n2: BehaviorTreeNode = scene.nodes[2]
    let n6: BehaviorTreeNode = scene.nodes[6]
    let curAmmo = blackboardGet(scene.bb, "ammoCount").unwrap()

    beginDrawing()
    clearScreen(rgb(10, 14, 24))
    drawText("EX_239: BEHAVIOR TREE (SELECTOR / SEQUENCE / INVERTER) & BLACKBOARD", 36.0, 24.0, 22.0, rgb(241, 245, 249))
    drawText("Audit=" + str(audit) + " | " + stText + " | Ticks=" + str(scene.tickCount) + " | BlackboardKeys=" + str(scene.bb.entries.len()), 36.0, 52.0, 15.0, rgb(148, 163, 184))

    drawRect(44.0, 88.0, 744.0, 594.0, rgb(17, 24, 39))
    drawRectOutline(44.0, 88.0, 744.0, 594.0, 2.0, rgb(56, 189, 248))
    drawText("BEHAVIOR TREE DAG: SELECTOR (?) -> ATTACK SEQUENCE (->) / INVERTER (!) RELOAD", 64.0, 104.0, 14.0, rgb(125, 211, 252))

    let atkCol = if isAttackOk: rgb(16, 185, 129) else: rgb(239, 68, 68)
    let relCol = if isInvOk: rgb(250, 204, 21) else: rgb(71, 85, 105)

    drawLine(416.0, 196.0, 248.0, 290.0, atkCol, 3.5)
    drawLine(416.0, 196.0, 584.0, 290.0, relCol, 3.5)

    drawLine(248.0, 344.0, 148.0, 446.0, rgb(16, 185, 129), 3.0)
    drawLine(248.0, 344.0, 348.0, 446.0, atkCol, 3.0)

    drawLine(584.0, 344.0, 504.0, 446.0, relCol, 3.0)
    drawLine(584.0, 344.0, 672.0, 446.0, relCol, 3.0)

    drawRect(296.0, 140.0, 240.0, 56.0, rgb(30, 58, 138))
    drawRectOutline(296.0, 140.0, 240.0, 56.0, 2.5, rgb(56, 189, 248))
    drawText("[3] Root Selector (?)", 330.0, 154.0, 15.0, rgb(255, 255, 255))
    drawText("Status: SUCCESS", 352.0, 174.0, 12.0, rgb(110, 231, 183))

    drawRect(138.0, 290.0, 220.0, 56.0, if isAttackOk: rgb(6, 78, 59) else: rgb(127, 29, 29))
    drawRectOutline(138.0, 290.0, 220.0, 56.0, 2.5, atkCol)
    drawText("[0] Attack Sequence (->)", 156.0, 304.0, 14.0, rgb(255, 255, 255))
    drawText(if isAttackOk: "SUCCESS (Firing)" else: "FAILURE (Ammo=0)", 182.0, 324.0, 12.0, rgb(226, 232, 240))

    drawRect(474.0, 290.0, 220.0, 56.0, if isInvOk: rgb(120, 53, 15) else: rgb(30, 41, 59))
    drawRectOutline(474.0, 290.0, 220.0, 56.0, 2.5, relCol)
    drawText("[5] Reload Sequence (->)", 492.0, 304.0, 14.0, rgb(255, 255, 255))
    drawText(if isInvOk: "ACTIVE (Refilling)" else: "STANDBY (Skipped)", 516.0, 324.0, 12.0, rgb(226, 232, 240))

    drawRect(64.0, 446.0, 170.0, 62.0, rgb(6, 95, 70))
    drawRectOutline(64.0, 446.0, 170.0, 62.0, 2.0, rgb(52, 211, 153))
    drawText("[" + str(n1.id) + "] Cond: " + n1.actionName, 76.0, 462.0, 13.0, rgb(255, 255, 255))
    drawText("val=42 -> SUCCESS", 82.0, 484.0, 12.0, rgb(167, 243, 208))

    drawRect(256.0, 446.0, 180.0, 62.0, if isAttackOk: rgb(6, 95, 70) else: rgb(127, 29, 29))
    drawRectOutline(256.0, 446.0, 180.0, 62.0, 2.0, atkCol)
    drawText("[" + str(n2.id) + "] Act: " + n2.actionName, 268.0, 462.0, 13.0, rgb(255, 255, 255))
    drawText("ammo=" + str(curAmmo) + (if isAttackOk: " -> OK" else: " -> FAIL"), 274.0, 484.0, 12.0, rgb(241, 245, 249))

    drawRect(452.0, 446.0, 146.0, 62.0, if isInvOk: rgb(146, 64, 14) else: rgb(30, 41, 59))
    drawRectOutline(452.0, 446.0, 146.0, 62.0, 2.0, relCol)
    drawText("[4] Inverter (!)", 468.0, 462.0, 13.0, rgb(255, 255, 255))
    drawText(if isInvOk: "!FAIL -> OK" else: "!OK -> FAIL", 476.0, 484.0, 12.0, rgb(253, 224, 71))

    drawRect(612.0, 446.0, 156.0, 62.0, if isInvOk: rgb(6, 95, 70) else: rgb(30, 41, 59))
    drawRectOutline(612.0, 446.0, 156.0, 62.0, 2.0, relCol)
    drawText("[" + str(n6.id) + "] " + n6.actionName, 624.0, 462.0, 13.0, rgb(255, 255, 255))
    drawText("Refill -> 12", 642.0, 484.0, 12.0, rgb(167, 243, 208))

    drawRect(64.0, 532.0, 704.0, 130.0, rgb(11, 17, 30))
    drawRectOutline(64.0, 532.0, 704.0, 130.0, 1.0, rgb(51, 65, 85))
    drawText("MAGAZINE AMMO BELT & BTREE TICK TIMELINE (12 ROUNDS PER CLIP)", 82.0, 546.0, 13.0, rgb(125, 211, 252))
    mut slot = 0
    while slot < 12:
      let sx = 84.0 + float(slot) * 54.0
      let filled = slot < curAmmo
      drawRect(sx, 576.0, 42.0, 48.0, if filled: rgb(16, 185, 129) else: rgb(30, 41, 59))
      drawRectOutline(sx, 576.0, 42.0, 48.0, 1.5, if filled: rgb(52, 211, 153) else: rgb(71, 85, 105))
      drawText(str(slot + 1), sx + 12.0, 594.0, 13.0, if filled: rgb(255, 255, 255) else: rgb(100, 116, 139))
      slot = slot + 1
    drawText("Evaluator invariants: btSequence([1,1])=" + str(btSequence([1, 1])) + " | btSelector([0,1])=" + str(btSelector([0, 1])) + " | btInvert(0)=" + str(btInvert(0)), 82.0, 638.0, 13.0, rgb(148, 163, 184))

    drawRect(812.0, 88.0, 424.0, 594.0, rgb(17, 24, 39))
    drawRectOutline(812.0, 88.0, 424.0, 594.0, 2.0, rgb(245, 158, 11))
    drawText("SHARED BLACKBOARD KEY-VALUE MEMORY", 836.0, 104.0, 15.0, rgb(253, 224, 71))

    mut eIdx = 0
    while eIdx < scene.bb.entries.len():
      let entry: BlackboardEntry = scene.bb.entries[eIdx]
      let ey = 144.0 + float(eIdx) * 98.0
      drawRect(836.0, ey, 376.0, 82.0, rgb(11, 17, 30))
      drawRectOutline(836.0, ey, 376.0, 82.0, 1.5, rgb(51, 65, 85))
      drawText("Key [" + str(eIdx) + "]: \"" + entry.key + "\"", 854.0, ey + 14.0, 15.0, rgb(241, 245, 249))
      drawText("Value = " + str(entry.val), 1068.0, ey + 14.0, 15.0, rgb(56, 189, 248))

      let normW = if entry.val > 60: 340.0 else: (if entry.val <= 0: 6.0 else: float(entry.val) * 5.5 + 16.0)
      let clampW = if normW > 340.0: 340.0 else: normW
      let barCol = if entry.val > 0: rgb(56, 189, 248) else: rgb(239, 68, 68)
      drawRect(854.0, ey + 44.0, 340.0, 20.0, rgb(30, 41, 59))
      drawRect(854.0, ey + 44.0, clampW, 20.0, barCol)
      drawRectOutline(854.0, ey + 44.0, 340.0, 20.0, 1.0, rgb(71, 85, 105))
      eIdx = eIdx + 1

    endDrawing()
    frame = frame + 1
  closeWindow()
  ret 0
