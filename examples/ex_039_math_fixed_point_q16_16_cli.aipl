// ============================================================================
// Example 039: Deterministic Fixed-Point Q16.16 & Q32.32 Math (CLI)
// Demonstrates: fixedFromInt, fixedFromFloat, .toInt(), .toFloat(), .abs(),
//               .add(), .sub(), .mul(), .div(), and fixedQ32FromInt from
//               std/math/fixed_point.
// ============================================================================
module Ex039MathFixedPointQ1616Cli

import {
  fixedFromInt,
  fixedFromFloat,
  fixedQ32FromInt
} from "../std/math/fixed_point"

pub fn evaluateFixedQ16ArithmeticMilli(baseInt: int, negFloat: float): int:
  let f1 = fixedFromInt(baseInt)
  let f2 = fixedFromFloat(negFloat)
  let prod = f1.mul(fixedFromInt(3))
  let quot = f1.div(fixedFromInt(2))
  let absNeg = f2.abs()
  let total = prod.add(quot).add(absNeg)
  ret int(total.toFloat() * 1000.0 + 0.5)

pub fn evaluateFixedQ32Balance(a: int, b: int): int:
  let qa = fixedQ32FromInt(a)
  let qb = fixedQ32FromInt(b)
  let sum = qa.add(qb).toInt()
  let diff = qa.sub(qb).toInt()
  ret sum + diff

pub fn describeFixedPointFormat(fractionalBits: int): str:
  if fractionalBits == 16:
    ret "FIXED:Q16_16_DETERMINISTIC_LOCKSTEP"
  ret "FIXED:Q32_32_HIGH_RANGE"

pub fn main(): int:
  let q16Milli = evaluateFixedQ16ArithmeticMilli(5, -3.0)
  let q32Bal = evaluateFixedQ32Balance(10, 4)
  println("Q16.16 Arithmetic Total (milli): " + str(q16Milli) + " (" + describeFixedPointFormat(16) + ")")
  println("Q32.32 Sum+Diff Balance: " + str(q32Bal) + " (" + describeFixedPointFormat(32) + ")")
  ret 0
