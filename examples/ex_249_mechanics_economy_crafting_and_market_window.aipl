module Ex249MechanicsEconomyCraftingAndMarketWindow

import { ResourceLedger, CraftingIngredient, CraftingRecipe, TaxBracketTier, ProgressiveTaxBracket, resourceLedgerNew, ledgerDeposit, ledgerWithdraw, ledgerGetBalance, ledgerTransfer, craftingMaxBatchCount, craftingExecute, computeTieredBracketRatePct, computeProgressiveTaxAmount, computeSupplyDemandPrice, computeEloRatingDelta } from "../std/mechanics/economy_ledger"
import { initWindow, windowShouldClose, beginDrawing, endDrawing, closeWindow, clearScreen, drawRect, drawRectOutline, drawLine, drawText, rgb } from "../std/gfx2d/shape2d"

pub struct EconomyScene(ledger: ResourceLedger, recipe: CraftingRecipe, taxBracket: ProgressiveTaxBracket, marketSupply: int, marketDemand: int, marketPrice: float, stepCount: int)

pub fn initScene(): EconomyScene:
  mut ledger = resourceLedgerNew()
  ledgerDeposit(ledger, "treasury", 1000)
  ledgerDeposit(ledger, "player", 500)
  ledgerTransfer(ledger, "player", "treasury", 200)
  ledgerDeposit(ledger, "player:iron_ore", 4)
  ledgerDeposit(ledger, "player:coal", 2)
  let recipe = CraftingRecipe(
    recipeId = "smelt_steel",
    inputs = [CraftingIngredient(itemTag = "iron_ore", amount = 2), CraftingIngredient(itemTag = "coal", amount = 1)],
    outputs = [CraftingIngredient(itemTag = "steel_ingot", amount = 1)],
    craftDurationSec = 2.0
  )
  craftingExecute(ledger, "player", recipe)
  let taxBracket = ProgressiveTaxBracket(tiers = [
    TaxBracketTier(threshold = 50, ratePct = 10.0),
    TaxBracketTier(threshold = 200, ratePct = 20.0)
  ])
  let mktPrice = computeSupplyDemandPrice(10.0, 100, 150, 0.5)
  ret EconomyScene(
    ledger = ledger,
    recipe = recipe,
    taxBracket = taxBracket,
    marketSupply = 100,
    marketDemand = 150,
    marketPrice = mktPrice,
    stepCount = 0
  )

pub fn stepScene(mut scene: EconomyScene, frame: int, dt: float): EconomyScene:
  ledgerDeposit(scene.ledger, "player:iron_ore", 2 + (frame % 2))
  ledgerDeposit(scene.ledger, "player:coal", 1 + ((frame + 1) % 2))
  if craftingExecute(scene.ledger, "player", scene.recipe):
    scene.marketSupply = 95 + ((frame * 7) % 43)
    scene.marketDemand = 125 + ((frame * 13) % 53)
    scene.marketPrice = computeSupplyDemandPrice(10.0, scene.marketSupply, scene.marketDemand, 0.5)
    let lotSize = 1 + (frame % 7)
    let grossGold = int(scene.marketPrice * float(lotSize))
    ledgerDeposit(scene.ledger, "player", grossGold)
    let taxAmt = computeProgressiveTaxAmount(scene.taxBracket, grossGold)
    if taxAmt > 0:
      ledgerTransfer(scene.ledger, "player", "treasury", taxAmt)
    if ledgerGetBalance(scene.ledger, "player") > 8000:
      ledgerWithdraw(scene.ledger, "player", 6000)
      ledgerWithdraw(scene.ledger, "treasury", 1500)
      ledgerWithdraw(scene.ledger, "player:steel_ingot", 100)
  scene.stepCount = scene.stepCount + 1
  ret scene

pub fn auditMechanicsEconomyCraftingMarket(): int:
  let scene = initScene()
  let eloDelta = computeEloRatingDelta(1500.0, 1500.0, 1.0, 32.0)
  ret ledgerGetBalance(scene.ledger, "player") + int(eloDelta)

pub fn main(): int:
  let audit = auditMechanicsEconomyCraftingMarket()
  println("EX_249_MECHANICS_ECONOMY_AUDIT=" + str(audit))

  mut scene = initScene()
  mut frame = 0

  initWindow(1280, 720, "AIPL ex_249: Double-Entry Resource Ledger, Crafting & Market Pricing")
  while not windowShouldClose():
    scene = stepScene(scene, frame, 0.1)
    let pGold = ledgerGetBalance(scene.ledger, "player")
    let tGold = ledgerGetBalance(scene.ledger, "treasury")
    let ironRem = ledgerGetBalance(scene.ledger, "player:iron_ore")
    let coalRem = ledgerGetBalance(scene.ledger, "player:coal")
    let steelCount = ledgerGetBalance(scene.ledger, "player:steel_ingot")
    let maxBatches = craftingMaxBatchCount(scene.ledger, "player", scene.recipe)
    let lotSize = 1 + (frame % 7)
    let grossGold = int(scene.marketPrice * float(lotSize))
    let taxRate = computeTieredBracketRatePct(scene.taxBracket, grossGold)
    let taxAmt = computeProgressiveTaxAmount(scene.taxBracket, grossGold)
    let netGold = grossGold - taxAmt
    let priceX10 = int(scene.marketPrice * 10.0 + 0.5)

    beginDrawing()
    clearScreen(rgb(10, 14, 24))
    drawText("EX_249: DOUBLE-ENTRY ECONOMY LEDGER, CRAFTING FORGE & MARKET SINK", 36.0, 24.0, 21.0, rgb(241, 245, 249))
    drawText("Audit=" + str(audit) + " | PlayerGold=" + str(pGold) + " | Treasury=" + str(tGold) + " | Steel=x" + str(steelCount) + " | MarketPrice=" + str(priceX10 / 10) + "." + str(priceX10 % 10) + "g", 36.0, 54.0, 16.0, rgb(148, 163, 184))

    // Left Panel: Atomic Crafting Forge & Supply/Demand Market Pricing
    drawRect(44.0, 90.0, 584.0, 590.0, rgb(15, 23, 42))
    drawRectOutline(44.0, 90.0, 584.0, 590.0, 2.0, rgb(56, 189, 248))
    drawText("ATOMIC CRAFTING RECIPE (" + scene.recipe.recipeId + ") & MARKET EQUILIBRIUM", 68.0, 108.0, 15.0, rgb(125, 211, 252))

    // Crafting DAG nodes & directed pipes
    drawLine(294.0, 198.0, 376.0, 252.0, rgb(250, 204, 21), 4.0)
    drawLine(294.0, 306.0, 376.0, 252.0, rgb(250, 204, 21), 4.0)

    drawRect(68.0, 156.0, 226.0, 84.0, rgb(24, 33, 50))
    drawRectOutline(68.0, 156.0, 226.0, 84.0, 2.0, rgb(56, 189, 248))
    drawText("INPUT #1: 2x iron_ore", 84.0, 174.0, 14.0, rgb(255, 255, 255))
    drawText("Stockpile: " + str(ironRem) + " units", 84.0, 200.0, 13.0, rgb(125, 211, 252))

    drawRect(68.0, 264.0, 226.0, 84.0, rgb(24, 33, 50))
    drawRectOutline(68.0, 264.0, 226.0, 84.0, 2.0, rgb(56, 189, 248))
    drawText("INPUT #2: 1x coal", 84.0, 282.0, 14.0, rgb(255, 255, 255))
    drawText("Stockpile: " + str(coalRem) + " units", 84.0, 308.0, 13.0, rgb(125, 211, 252))

    drawRect(376.0, 198.0, 226.0, 108.0, rgb(6, 78, 59))
    drawRectOutline(376.0, 198.0, 226.0, 108.0, 3.0, rgb(52, 211, 153))
    drawText("OUTPUT: 1x steel_ingot", 394.0, 218.0, 14.0, rgb(255, 255, 255))
    drawText("Forged Total: x" + str(steelCount), 394.0, 246.0, 15.0, rgb(167, 243, 208))
    drawText("Craftable Batches: " + str(maxBatches), 394.0, 274.0, 12.0, rgb(250, 204, 21))

    // Supply & Demand Pricing Card
    drawRect(68.0, 376.0, 534.0, 280.0, rgb(22, 30, 46))
    drawRectOutline(68.0, 376.0, 534.0, 280.0, 1.0, rgb(71, 85, 105))
    drawText("SUPPLY / DEMAND PRICE DISCOVERY (Base=10.0g, Elasticity=0.5)", 86.0, 394.0, 14.0, rgb(253, 224, 71))

    drawText("Market Supply (S = " + str(scene.marketSupply) + " ingots)", 86.0, 430.0, 13.0, rgb(125, 211, 252))
    let supW = float(scene.marketSupply) * 2.2
    drawRect(86.0, 452.0, 480.0, 20.0, rgb(30, 41, 59))
    drawRect(86.0, 452.0, supW, 20.0, rgb(56, 189, 248))

    drawText("Market Demand (D = " + str(scene.marketDemand) + " orders)", 86.0, 488.0, 13.0, rgb(244, 114, 182))
    let demW = float(scene.marketDemand) * 2.2
    drawRect(86.0, 510.0, 480.0, 20.0, rgb(30, 41, 59))
    drawRect(86.0, 510.0, demW, 20.0, rgb(236, 72, 153))

    drawText("Spot Price: " + str(priceX10 / 10) + "." + str(priceX10 % 10) + " Gold/ingot  |  Trade Lot: " + str(lotSize) + " ingots -> Gross=" + str(grossGold) + "g", 86.0, 552.0, 14.0, rgb(52, 211, 153))
    let eloWin = int(computeEloRatingDelta(1500.0, 1500.0, 1.0, 32.0))
    let eloUpset = int(computeEloRatingDelta(1400.0, 1600.0, 1.0, 32.0))
    drawText("Merchant Guild Elo Rating Delta (K=32): Even Match +" + str(eloWin) + " | Upset Win +" + str(eloUpset), 86.0, 588.0, 12.0, rgb(148, 163, 184))
    drawText("Formula: P = Base * (1 + (D/S - 1) * Elasticity)", 86.0, 618.0, 12.0, rgb(148, 163, 184))

    // Right Panel: Double-Entry Ledger & Progressive Tax Bracket Sink
    drawRect(654.0, 90.0, 582.0, 590.0, rgb(15, 23, 42))
    drawRectOutline(654.0, 90.0, 582.0, 590.0, 2.0, rgb(245, 158, 11))
    drawText("DOUBLE-ENTRY LEDGER & PROGRESSIVE TAX SINK", 678.0, 108.0, 16.0, rgb(253, 224, 71))

    // Player Account Card
    drawRect(678.0, 148.0, 534.0, 88.0, rgb(30, 58, 138))
    drawRectOutline(678.0, 148.0, 534.0, 88.0, 2.0, rgb(96, 165, 250))
    drawText("ACCOUNT [player] — Active Merchant Wallet", 698.0, 166.0, 15.0, rgb(255, 255, 255))
    drawText("Balance: " + str(pGold) + " Gold  |  Last Net Credit: +" + str(netGold) + " Gold", 698.0, 198.0, 14.0, rgb(191, 219, 254))

    // Treasury Account Card
    drawRect(678.0, 254.0, 534.0, 88.0, rgb(120, 53, 15))
    drawRectOutline(678.0, 254.0, 534.0, 88.0, 2.0, rgb(250, 204, 21))
    drawText("ACCOUNT [treasury] — Sovereign Inflation Sink", 698.0, 272.0, 15.0, rgb(254, 240, 138))
    drawText("Balance: " + str(tGold) + " Gold  |  Last Tax Transfer: +" + str(taxAmt) + " Gold", 698.0, 304.0, 14.0, rgb(253, 224, 71))

    // Double-entry wealth distribution bar
    let totalGold = pGold + tGold
    let pShareW = if totalGold > 0: float(pGold) * 494.0 / float(totalGold) else: 247.0
    drawRect(678.0, 360.0, 534.0, 74.0, rgb(22, 30, 46))
    drawRectOutline(678.0, 360.0, 534.0, 74.0, 1.0, rgb(71, 85, 105))
    drawText("Monetary Base Conservation: Player + Treasury = " + str(totalGold) + " Gold", 698.0, 372.0, 13.0, rgb(226, 232, 240))
    drawRect(698.0, 398.0, pShareW, 18.0, rgb(59, 130, 246))
    drawRect(698.0 + pShareW, 398.0, 494.0 - pShareW, 18.0, rgb(245, 158, 11))
    drawRectOutline(698.0, 398.0, 494.0, 18.0, 1.0, rgb(148, 163, 184))

    // Progressive Tax Brackets Card
    drawRect(678.0, 452.0, 534.0, 204.0, rgb(22, 30, 46))
    drawRectOutline(678.0, 452.0, 534.0, 204.0, 1.0, rgb(71, 85, 105))
    drawText("PROGRESSIVE TAX BRACKET TIERS (Current Trade Gross = " + str(grossGold) + "g)", 698.0, 470.0, 14.0, rgb(216, 180, 254))

    let inTier1 = grossGold <= 50
    drawRect(698.0, 502.0, 494.0, 54.0, if inTier1: rgb(6, 78, 59) else: rgb(30, 41, 59))
    drawRectOutline(698.0, 502.0, 494.0, 54.0, 2.0, if inTier1: rgb(52, 211, 153) else: rgb(71, 85, 105))
    drawText("Tier #1 (Gross <= 50 Gold): 10% Tax Rate" + (if inTier1: "  [ACTIVE TIER]" else: ""), 714.0, 522.0, 14.0, rgb(255, 255, 255))

    let inTier2 = grossGold > 50
    drawRect(698.0, 568.0, 494.0, 54.0, if inTier2: rgb(88, 28, 135) else: rgb(30, 41, 59))
    drawRectOutline(698.0, 568.0, 494.0, 54.0, 2.0, if inTier2: rgb(192, 132, 252) else: rgb(71, 85, 105))
    drawText("Tier #2 (Gross > 50 Gold):  20% Tax Rate" + (if inTier2: "  [ACTIVE TIER]" else: ""), 714.0, 588.0, 14.0, rgb(255, 255, 255))

    drawText("Applied Rate: " + str(int(taxRate)) + "% -> Gross " + str(grossGold) + "g - Tax " + str(taxAmt) + "g = Net +" + str(netGold) + "g", 698.0, 632.0, 13.0, rgb(250, 204, 21))

    endDrawing()
    frame = frame + 1
  closeWindow()
  ret 0
