// ============================================================================
// Example 047: Binary Min/Max Heaps & Decrease-Key Task Scheduler (CLI)
// Demonstrates: minHeapNew, maxHeapNew, .push(), .peek(), .peekPriority(),
//               .pop(), pqNew, pqPush, pqDecreaseKey, pqPopMin, and
//               indexedPqNew from std/collections/priority_queue.
// ============================================================================
module Ex047CollectionsPriorityQueueSchedulerCli

import {
  minHeapNew,
  maxHeapNew,
  indexedPqNew,
  pqNew,
  pqPush,
  pqDecreaseKey,
  pqPopMin
} from "../std/collections/priority_queue"

pub fn scheduleMinAndMaxHeapTasks(): str:
  mut minH = minHeapNew[str]()
  minH.push("disk_sync", 40)
  minH.push("irq_handler", 10)
  minH.push("net_poll", 25)
  let earliest = minH.pop().unwrap()

  mut maxH = maxHeapNew[str]()
  maxH.push("bg_gc", 15)
  maxH.push("render_frame", 90)
  let highest = maxH.pop().unwrap()

  ret earliest + ":" + highest

pub fn verifyDecreaseKeyPriorityPromotion(): int:
  let ipq = indexedPqNew(8)
  mut pq = pqNew()
  pq = pqPush(pq, 101, 50)
  pq = pqPush(pq, 202, 20)
  let promoted = pqDecreaseKey(pq, 101, 5)
  if promoted and ipq.inverseHeap.len == 8:
    ret pqPopMin(pq).unwrap()
  ret -1

pub fn describeSchedulerHeapKind(kindId: int): str:
  if kindId == 0:
    ret "HEAP:BINARY_MIN_MAX_AND_INDEXED_PQ"
  ret "HEAP:FIBONACCI_PAIRING"

pub fn main(): int:
  let pair = scheduleMinAndMaxHeapTasks()
  let winner = verifyDecreaseKeyPriorityPromotion()
  println("MinHeap Earliest + MaxHeap Highest: " + pair)
  println("Decrease-Key Promoted Task ID: " + str(winner) + " (" + describeSchedulerHeapKind(0) + ")")
  ret 0
