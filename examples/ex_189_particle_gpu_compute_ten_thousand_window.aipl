module Ex189ParticleGpuComputeTenThousandWindow

import {
  createGpuParticleSoA, spawnGpuParticleSoA,
  stepGpuParticleSoACpuFallback, buildComputeParticleShaderWgsl,
  createComputeParticlePipeline
} from "../std/particle/gpu_compute_particles"
import {
  initWindow, windowShouldClose, beginDrawing, endDrawing, closeWindow,
  clearScreen, drawRect, drawRectOutline, drawCircle, drawCircleOutline,
  drawLine, drawText, rgb
} from "../std/gfx2d/shape2d"

pub fn stepGpuEmitterOriginX(frame: int): float:
  ret 405.0 + sin(float(frame) * 0.067) * 145.0

pub fn buildGpuComputeParticleAudit(): int:
  mut soa = createGpuParticleSoA(10000)
  soa = spawnGpuParticleSoA(soa, 1.0, 2.0, 3.0, 4.0, 0.0, 0.0, 2.0, -1)
  soa = stepGpuParticleSoACpuFallback(soa, 0.5, -10.0)
  let pipe = createComputeParticlePipeline(10000, 64)
  ret pipe.maxParticles + pipe.workgroupSizeX + int(soa.posX[0]) + soa.liveCount

pub fn main(): int:
  let auditScore = buildGpuComputeParticleAudit()
  let wgsl = buildComputeParticleShaderWgsl(64)
  let pipe = createComputeParticlePipeline(10000, 64)

  mut soa = createGpuParticleSoA(10000)
  mut s = 0
  while s < 192:
    let gx = float(s % 16) * 34.0 + 145.0
    let gy = float(s / 16) * 28.0 + 185.0
    let vx = float((s % 7) - 3) * 24.0
    let vy = -35.0 - float(s % 5) * 12.0
    let life = 0.6 + float(s % 12) * 0.14
    soa = spawnGpuParticleSoA(soa, gx, gy, 0.0, vx, vy, 0.0, life, -1)
    s = s + 1

  initWindow(1280, 720, "AIPL ex_189: GPU Compute 10,000 Particle SoA & WGSL Pipeline")
  mut frame = 0
  while not windowShouldClose():
    soa = stepGpuParticleSoACpuFallback(soa, 0.022, 42.0)

    // Continuously replenish GPU SoA buffers from orbiting emitter nozzle
    let emitX = stepGpuEmitterOriginX(frame)
    let emitY = 365.0 + cos(float(frame) * 0.053) * 95.0
    mut b = 0
    while b < 5:
      let ang = float(frame) * 0.19 + float(b) * 1.2566
      let spd = 55.0 + float((frame + b) % 4) * 18.0
      let bvx = cos(ang) * spd
      let bvy = sin(ang) * spd - 22.0
      soa = spawnGpuParticleSoA(soa, emitX, emitY, 0.0, bvx, bvy, 0.0, 1.45, -1)
      b = b + 1

    beginDrawing()
    clearScreen(rgb(8, 12, 22))

    drawRect(32.0, 24.0, 1216.0, 68.0, rgb(16, 24, 42))
    drawRectOutline(32.0, 24.0, 1216.0, 68.0, 2.0, rgb(56, 189, 248))
    drawText("EX_189: GPU COMPUTE 10,000 PARTICLE SoA & WGSL SHADER PIPELINE", 52.0, 40.0, 22.0, rgb(240, 249, 255))
    drawText("capacity=" + str(soa.capacity) + " | liveCount=" + str(soa.liveCount) + " | workgroupSizeX=" + str(pipe.workgroupSizeX) + " | frame=" + str(frame) + " | audit=" + str(auditScore), 52.0, 66.0, 16.0, rgb(125, 211, 252))

    // Left Panel: Live SoA Particle Advection & Swap-Compaction Viewport
    drawRect(32.0, 110.0, 740.0, 520.0, rgb(12, 18, 34))
    drawRectOutline(32.0, 110.0, 740.0, 520.0, 2.0, rgb(30, 58, 138))
    drawText("CONTIGUOUS SoA SIMD PARTICLE ADVECTION & SWAP-COMPACTION", 52.0, 130.0, 16.0, rgb(125, 211, 252))

    // Orbiting GPU emitter nozzle
    drawCircleOutline(emitX, emitY, 16.0, 2.0, rgb(250, 204, 21))
    drawCircle(emitX, emitY, 6.0, rgb(255, 251, 235))

    mut idx = 0
    while idx < soa.liveCount:
      let rawX = soa.posX[idx]
      let rawY = soa.posY[idx]
      let px = if rawX < 52.0: 52.0 else: (if rawX > 752.0: 752.0 else: rawX)
      let py = if rawY < 162.0: 162.0 else: (if rawY > 610.0: 610.0 else: rawY)
      let col = if idx % 3 == 0: rgb(56, 189, 248) else: (if idx % 3 == 1: rgb(168, 85, 247) else: rgb(52, 211, 153))
      drawCircle(px, py, 3.5, col)
      idx = idx + 1

    // Right Panel: SoA Contiguous Buffer Lanes & 64-Thread Workgroup Dispatch
    drawRect(792.0, 110.0, 456.0, 520.0, rgb(15, 23, 42))
    drawRectOutline(792.0, 110.0, 456.0, 520.0, 2.0, rgb(168, 85, 247))
    drawText("STRUCTURE-OF-ARRAYS (SoA) VRAM LAYOUT", 812.0, 130.0, 16.0, rgb(216, 180, 254))

    let fillW = if float(soa.liveCount) * 1.4 > 410.0: 410.0 else: float(soa.liveCount) * 1.4
    mut lane = 0
    while lane < 6:
      let ly = 168.0 + float(lane) * 52.0
      let laneName = if lane == 0: "posX[10000] (f32)" else: (if lane == 1: "posY[10000] (f32)" else: (if lane == 2: "velX[10000] (f32)" else: (if lane == 3: "velY[10000] (f32)" else: (if lane == 4: "age[10000]  (f32)" else: "life[10000] (f32)"))))
      let laneCol = if lane < 2: rgb(56, 189, 248) else: (if lane < 4: rgb(168, 85, 247) else: rgb(52, 211, 153))
      drawRect(812.0, ly, 416.0, 38.0, rgb(30, 41, 59))
      drawRect(812.0, ly, fillW, 38.0, laneCol)
      drawRectOutline(812.0, ly, 416.0, 38.0, 1.0, rgb(71, 85, 105))
      drawText(laneName, 824.0, ly + 11.0, 14.0, rgb(15, 23, 42))
      lane = lane + 1

    let activeGroups = (soa.liveCount + 63) / 64
    drawText("Active 64-Thread Workgroups: " + str(activeGroups) + " / 157", 812.0, 495.0, 15.0, rgb(250, 204, 21))
    mut wgIdx = 0
    while wgIdx < 8:
      let wgx = 812.0 + float(wgIdx) * 52.0
      let isHot = wgIdx < activeGroups
      drawRect(wgx, 525.0, 44.0, 44.0, if isHot: rgb(34, 197, 94) else: rgb(30, 41, 59))
      drawRectOutline(wgx, 525.0, 44.0, 44.0, 1.5, rgb(148, 163, 184))
      drawText("WG" + str(wgIdx), wgx + 6.0, 540.0, 12.0, rgb(248, 250, 252))
      wgIdx = wgIdx + 1
    drawText("O(1) Swap-With-Last Compaction on Expiry", 812.0, 590.0, 14.0, rgb(134, 239, 172))

    drawRect(32.0, 648.0, 1216.0, 44.0, rgb(15, 23, 42))
    drawText("WGSL: " + wgsl.slice(0, 28) + " fn cs_main | Dispatch: 157x64 | Nozzle=(" + str(int(emitX)) + "," + str(int(emitY)) + ")", 52.0, 662.0, 16.0, rgb(167, 243, 208))

    endDrawing()
    frame = frame + 1

  closeWindow()
  println("Audit score: " + str(auditScore))
  ret 0
