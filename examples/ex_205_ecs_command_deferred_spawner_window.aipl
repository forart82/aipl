module Ex205EcsCommandDeferredSpawnerWindow

import { createEcsWorld, spawnEntity } from "../std/ecs/ecs_world"
import { QueryFilter, queryEntities } from "../std/ecs/ecs_query"
import {
  CMD_SPAWN, CMD_DESPAWN, EcsCommand, createCommandBuffer,
  recordSpawnCommand, recordDespawnCommand, flushCommandBuffer
} from "../std/ecs/ecs_command"
import {
  initWindow, windowShouldClose, beginDrawing, endDrawing, closeWindow,
  clearScreen, drawRect, drawRectOutline, drawCircle, drawLine, drawText, rgb
} from "../std/gfx2d/shape2d"

pub fn stepStageBarrierProgress(frame: int): float:
  ret float(frame % 32) / 32.0

pub fn buildEcsCommandSpawnerAudit(): int:
  mut world = createEcsWorld()
  let (w1, e0) = spawnEntity(world)
  mut cmdBuf = createCommandBuffer()
  cmdBuf = recordSpawnCommand(cmdBuf)
  cmdBuf = recordSpawnCommand(cmdBuf)
  cmdBuf = recordDespawnCommand(cmdBuf, e0)
  let wFlushed = flushCommandBuffer(w1, cmdBuf)
  let ents = queryEntities(wFlushed, QueryFilter(withMask = 0, withoutMask = 0))
  ret cmdBuf.commands.len() + CMD_SPAWN + CMD_DESPAWN + ents.len()

pub fn main(): int:
  let auditScore = buildEcsCommandSpawnerAudit()

  mut world = createEcsWorld()
  let (w1, e0) = spawnEntity(world)
  let (w2, e1) = spawnEntity(w1)
  let (w3, _e2) = spawnEntity(w2)
  world = w3

  mut cmdBuf = createCommandBuffer()
  cmdBuf = recordSpawnCommand(cmdBuf)
  cmdBuf = recordDespawnCommand(cmdBuf, e0)
  cmdBuf = recordSpawnCommand(cmdBuf)
  cmdBuf = recordDespawnCommand(cmdBuf, e1)
  mut flushEpoch = 1

  initWindow(1280, 720, "AIPL ex_205: ECS Deferred CommandBuffer Queue & Barrier Flush")
  mut frame = 0
  while not windowShouldClose():
    let liveBefore = queryEntities(world, QueryFilter(withMask = 0, withoutMask = 0))
    if frame > 0 and frame % 32 == 0:
      world = flushCommandBuffer(world, cmdBuf)
      flushEpoch = flushEpoch + 1
      let afterFlushEnts = queryEntities(world, QueryFilter(withMask = 0, withoutMask = 0))
      cmdBuf = createCommandBuffer()
      if afterFlushEnts.len() >= 4:
        cmdBuf = recordDespawnCommand(cmdBuf, afterFlushEnts[0])
        cmdBuf = recordSpawnCommand(cmdBuf)
      else:
        cmdBuf = recordSpawnCommand(cmdBuf)
        if afterFlushEnts.len() > 0:
          cmdBuf = recordDespawnCommand(cmdBuf, afterFlushEnts[0])
    else:
      if frame > 0 and frame % 7 == 0 and cmdBuf.commands.len() < 6:
        if cmdBuf.commands.len() % 2 == 0:
          cmdBuf = recordSpawnCommand(cmdBuf)
        else:
          if liveBefore.len() > 1:
            let victimIdx = ( cmdBuf.commands.len() / 2 ) % liveBefore.len()
            cmdBuf = recordDespawnCommand(cmdBuf, liveBefore[victimIdx])
          else:
            cmdBuf = recordSpawnCommand(cmdBuf)

    let liveEnts = queryEntities(world, QueryFilter(withMask = 0, withoutMask = 0))
    mut netDelta = 0
    mut dIdx = 0
    while dIdx < cmdBuf.commands.len():
      let c: EcsCommand = cmdBuf.commands[dIdx]
      if c.cmdType == CMD_SPAWN:
        netDelta = netDelta + 1
      else:
        netDelta = netDelta - 1
      dIdx = dIdx + 1
    let projectedCount = liveEnts.len() + netDelta
    let stageT = stepStageBarrierProgress(frame)

    beginDrawing()
    clearScreen(rgb(10, 14, 24))

    drawRect(32.0, 24.0, 1216.0, 68.0, rgb(18, 28, 48))
    drawRectOutline(32.0, 24.0, 1216.0, 68.0, 2.0, rgb(56, 189, 248))
    drawText("EX_205: ECS DEFERRED COMMAND BUFFER (STAGE BARRIER FLUSH SPAWNER)", 52.0, 40.0, 22.0, rgb(240, 249, 255))
    drawText("epoch=#" + str(flushEpoch) + " | queuedCmds=" + str(cmdBuf.commands.len()) + " | worldLive=" + str(liveEnts.len()) + " -> afterFlush=" + str(projectedCount) + " | audit=" + str(auditScore), 52.0, 66.0, 16.0, rgb(125, 211, 252))

    // Left Command Queue Panel
    drawRect(60.0, 130.0, 500.0, 530.0, rgb(17, 24, 39))
    drawRectOutline(60.0, 130.0, 500.0, 530.0, 2.0, rgb(56, 189, 248))
    drawText("Recorded Deferred CommandBuffer:", 84.0, 152.0, 18.0, rgb(125, 211, 252))

    mut cIdx = 0
    while cIdx < cmdBuf.commands.len():
      let cmd: EcsCommand = cmdBuf.commands[cIdx]
      let ry = 192.0 + float(cIdx) * 68.0
      let isSpawn = cmd.cmdType == CMD_SPAWN
      let col = if isSpawn: rgb(52, 211, 153) else: rgb(248, 113, 113)
      drawRect(84.0, ry, 452.0, 54.0, if isSpawn: rgb(18, 42, 38) else: rgb(44, 20, 28))
      drawRectOutline(84.0, ry, 452.0, 54.0, 1.5, col)
      drawText(if isSpawn: "[" + str(cIdx) + "] CMD_SPAWN (Deferred Entity Alloc)" else: "[" + str(cIdx) + "] CMD_DESPAWN (Entity #" + str(cmd.targetEntity.index) + " v" + str(cmd.targetEntity.generation) + ")", 102.0, ry + 18.0, 16.0, col)
      cIdx = cIdx + 1

    // Center Stage Synchronization Barrier
    drawRect(574.0, 290.0, 132.0, 150.0, rgb(15, 23, 42))
    drawRectOutline(574.0, 290.0, 132.0, 150.0, 1.5, rgb(250, 204, 21))
    drawText("BARRIER", 604.0, 308.0, 16.0, rgb(250, 204, 21))
    drawText("Epoch #" + str(flushEpoch), 598.0, 332.0, 15.0, rgb(254, 240, 138))
    drawLine(584.0, 376.0, 696.0, 376.0, rgb(250, 204, 21), 3.0)
    drawCircle(584.0 + stageT * 112.0, 376.0, 8.0, rgb(56, 189, 248))
    drawRect(588.0, 408.0, 104.0 * stageT, 10.0, rgb(52, 211, 153))
    drawRectOutline(588.0, 408.0, 104.0, 10.0, 1.0, rgb(148, 163, 184))

    // Right Flushed World State
    drawRect(720.0, 130.0, 500.0, 530.0, rgb(17, 24, 39))
    drawRectOutline(720.0, 130.0, 500.0, 530.0, 2.0, rgb(52, 211, 153))
    drawText("Committed EcsWorld Entities (" + str(liveEnts.len()) + " active):", 744.0, 152.0, 18.0, rgb(110, 231, 183))

    mut eIdx = 0
    while eIdx < liveEnts.len() and eIdx < 5:
      let ent = liveEnts[eIdx]
      let ey = 196.0 + float(eIdx) * 88.0
      drawRect(744.0, ey, 452.0, 72.0, rgb(22, 38, 56))
      drawRectOutline(744.0, ey, 452.0, 72.0, 2.0, rgb(56, 189, 248))
      drawCircle(780.0, ey + 36.0, 15.0, rgb(52, 211, 153))
      drawText("Entity Slot #" + str(ent.index) + " | Generation v" + str(ent.generation), 810.0, ey + 18.0, 17.0, rgb(248, 250, 252))
      drawText("Archetype[0] Row #" + str(eIdx) + " (Post-Barrier Sync)", 810.0, ey + 44.0, 14.0, rgb(148, 163, 184))
      eIdx = eIdx + 1

    endDrawing()
    frame = frame + 1

  closeWindow()
  println("Audit score: " + str(auditScore))
  ret 0
