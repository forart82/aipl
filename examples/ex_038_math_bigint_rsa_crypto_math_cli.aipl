// ============================================================================
// Example 038: Multi-Limb BigInt (>64-bit) & Modular Arithmetic (CLI)
// Demonstrates: bigIntFromInt, bigIntFromString, .toString(), .toInt64(),
//               .add(), .sub(), .mul(), .div(), .mod(), .cmp(), bigIntDiv,
//               and bigIntMod from std/math/bigint.
// ============================================================================
module Ex038MathBigintRsaCryptoMathCli

import {
  bigIntFromInt,
  bigIntFromString,
  bigIntDiv,
  bigIntMod
} from "../std/math/bigint"

pub fn verifyMultiLimbBigIntAddSub(): str:
  let a = bigIntFromString("1000000000000000000000000000")
  let b = bigIntFromString("2500000000000000000000000000")
  let sum = a.add(b)
  let diff = b.sub(a)
  if a.cmp(b) == -1 and diff.toString() == "1500000000000000000000000000":
    ret sum.toString()
  ret "ERROR"

pub fn verifyMultiLimbBigIntMulDivMod(): int:
  let p = bigIntFromString("1000000000000")
  let q = bigIntFromString("3000000000000")
  let n = p.mul(q)
  let quot = bigIntDiv(n, p)
  let rem = bigIntMod(bigIntFromString("3000000000000000000000007"), p)
  let small = bigIntFromInt(7)
  if quot.toString() == "3000000000000" and rem.toString() == "7":
    ret small.toInt64()
  ret -1

pub fn describeBigIntPrecision(limbs: int): str:
  if limbs > 1:
    ret "BIGINT:MULTI_LIMB_ARBITRARY_PRECISION"
  ret "BIGINT:SINGLE_LIMB_64BIT"

pub fn main(): int:
  let sumStr = verifyMultiLimbBigIntAddSub()
  let remVal = verifyMultiLimbBigIntMulDivMod()
  println("Multi-Limb BigInt Sum: " + sumStr)
  println("Multi-Limb Mul/Div/Mod Remainder: " + str(remVal) + " (" + describeBigIntPrecision(4) + ")")
  ret 0
