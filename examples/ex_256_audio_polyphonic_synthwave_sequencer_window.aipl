// ============================================================================
// Canonical Example 256: Audio Polyphonic Synthwave Sequencer & Piano Roll (WINDOW)
// Target Profile: WINDOW | 4-Track Polyphonic Arrangement & 16-Band Spectrum
// ============================================================================
module Ex256AudioPolyphonicSynthwaveSequencerWindow

import {
  initWindow,
  windowShouldClose,
  beginDrawing,
  endDrawing,
  closeWindow,
  clearScreen,
  drawRect,
  drawRectOutline,
  drawRoundedRect,
  drawCircle,
  drawText,
  rgb
} from "../std/gfx2d/shape2d.aipl"
import { playToneEx, getAudioBand, getAudioEnergy } from "../std/audio/audio_device.aipl"
import { clampInt } from "../std/std_root.aipl"

pub fn computeSequencerTrackFreqHz(trackIdx: int, stepIdx: int): float:
  let s = clampInt(stepIdx % 16, 0, 15)
  if trackIdx == 0:
    // Track 0: Warm Bassline (A1, F1, C2, G1)
    let bass = [110.0, 110.0, 110.0, 110.0, 87.31, 87.31, 87.31, 87.31, 130.81, 130.81, 130.81, 130.81, 98.00, 98.00, 98.00, 98.00]
    ret bass[s]
  if trackIdx == 1:
    // Track 1: Lush 7th-Chord Pads
    let pads = [261.63, 329.63, 392.00, 493.88, 220.00, 261.63, 349.23, 440.00, 261.63, 329.63, 392.00, 523.25, 246.94, 293.66, 392.00, 493.88]
    ret pads[s]
  if trackIdx == 2:
    // Track 2: Pentatonic Bell Arpeggio
    let arp = [523.25, 659.25, 783.99, 880.00, 1046.50, 880.00, 783.99, 659.25, 587.33, 659.25, 783.99, 987.77, 880.00, 783.99, 659.25, 523.25]
    ret arp[s]
  // Track 3: Soft Brushed Percussion / Harmonic Pulse
  let perc = [164.81, 220.0, 164.81, 293.66, 164.81, 220.0, 196.0, 329.63, 164.81, 220.0, 164.81, 293.66, 164.81, 246.94, 220.0, 392.0]
  ret perc[s]

pub fn describePolyphonicSequencerArrangement(): str:
  ret "SEQUENCER:4TRACK_16STEP_SYNTHWAVE_POLYPHONIC"

pub fn triggerSequencerStepVoices(frameIndex: int): int:
  let stepIdx = (frameIndex / 8) % 16
  mut triggered = 0
  if frameIndex % 8 == 0:
    let bassHz = computeSequencerTrackFreqHz(0, stepIdx)
    let padHz = computeSequencerTrackFreqHz(1, stepIdx)
    let arpHz = computeSequencerTrackFreqHz(2, stepIdx)
    let _ = playToneEx(bassHz, 190.0, 0.36, "triangle")
    let _ = playToneEx(padHz, 320.0, 0.28, "warm_pad")
    let _ = playToneEx(arpHz, 160.0, 0.26, "bell")
    triggered = triggered + 3
    if stepIdx % 2 == 0:
      let percHz = computeSequencerTrackFreqHz(3, stepIdx)
      let _ = playToneEx(percHz, 95.0, 0.20, "pluck")
      triggered = triggered + 1
  ret triggered

pub fn renderPolyphonicSynthwaveSequencerScene(frameIndex: int): int:
  let stepIdx = (frameIndex / 8) % 16
  clearScreen(rgb(10, 14, 24))
  drawRect(24.0, 16.0, 1232.0, 50.0, rgb(18, 28, 48))
  drawRectOutline(24.0, 16.0, 1232.0, 50.0, 2.0, rgb(56, 189, 248))
  drawText("EX_256 // 16-STEP 4-TRACK POLYPHONIC SYNTHWAVE SEQUENCER & SPECTRUM", 44.0, 34.0, 19.0, rgb(240, 249, 255))

  let trackNames = ["BASS (Warm Sub)", "PAD (Lush 7th)", "ARP (Bell Lead)", "PERC (Harmonic)"]
  mut totalFreqMetric = 0
  mut t = 0
  while t < 4:
    let ry = 88.0 + float(t * 78)
    drawText(trackNames[t], 32.0, ry + 24.0, 15.0, rgb(125, 211, 252))
    mut s = 0
    while s < 16:
      let cx = 230.0 + float(s * 62)
      let hz = computeSequencerTrackFreqHz(t, s)
      let isPlayhead = s == stepIdx
      let col = if isPlayhead: rgb(34, 197, 94) else: (if (s + t) % 2 == 0: rgb(30, 58, 138) else: rgb(20, 34, 60))
      drawRoundedRect(cx, ry, 54.0, 62.0, 6.0, col)
      drawRectOutline(cx, ry, 54.0, 62.0, 1.5, if isPlayhead: rgb(250, 204, 21) else: rgb(51, 65, 85))
      drawText(str(int(hz)), cx + 8.0, ry + 24.0, 12.0, rgb(240, 249, 255))
      if isPlayhead:
        totalFreqMetric = totalFreqMetric + int(hz)
      s = s + 1
    t = t + 1

  // Bottom 16-Band Spectrum Visualizer
  let sx = 24.0
  let sy = 416.0
  let sw = 1232.0
  let sh = 280.0
  drawRect(sx, sy, sw, sh, rgb(14, 21, 36))
  drawRectOutline(sx, sy, sw, sh, 2.0, rgb(168, 85, 247))
  drawText(describePolyphonicSequencerArrangement() + " | Active Step #" + str(stepIdx + 1) + "/16", sx + 24.0, sy + 18.0, 15.0, rgb(216, 180, 254))

  mut b = 0
  while b < 16:
    let bx = sx + 36.0 + float(b * 73)
    let liveBand = getAudioBand(b)
    let synthEnv = 0.25 + float(((b * 13 + stepIdx * 7 + frameIndex) % 65)) / 100.0
    let amp = if liveBand > 0.05: liveBand else: synthEnv
    let barH = 24.0 + amp * 190.0
    let by = sy + sh - 24.0 - barH
    drawRect(bx, by, 48.0, barH, if b % 2 == 0: rgb(56, 189, 248) else: rgb(168, 85, 247))
    drawCircle(bx + 24.0, by, 5.0, rgb(250, 204, 21))
    b = b + 1

  ret totalFreqMetric + stepIdx * 17 + int(getAudioEnergy() * 100.0)

pub fn renderFrameStep(frameIndex: int, dt: float): int:
  let v = triggerSequencerStepVoices(frameIndex)
  let m = renderPolyphonicSynthwaveSequencerScene(frameIndex)
  ret m + v * 10 + int(dt * 0.0)

pub fn main(): int:
  initWindow(1280, 720, "AIPL ex_256 - Polyphonic Synthwave Sequencer & 16-Band Spectrum")
  mut frame: int = 0
  while not windowShouldClose():
    let _ = triggerSequencerStepVoices(frame)
    beginDrawing()
    let _ = renderPolyphonicSynthwaveSequencerScene(frame)
    endDrawing()
    frame = frame + 1
  closeWindow()
  ret 0
