// ============================================================================
// Canonical Example 148: Audio Synth Oscillators & ADSR Envelope (WINDOW)
// Target Profile: WINDOW | Standard Library Module: std/audio/audio_synth
// ============================================================================
module Ex148AudioSynthOscillatorsAndAdsrWindow

import {
  FmOperator,
  createAdsr,
  evaluateAdsr,
  generateWaveformSample,
  synthesizeToneBuffer,
  renderFmPatch4Op,
  OSC_SINE,
  OSC_SQUARE
} from "../std/audio/audio_synth.aipl"
import { playToneEx } from "../std/audio/audio_device.aipl"
import {
  initWindow,
  windowShouldClose,
  beginDrawing,
  endDrawing,
  closeWindow,
  clearScreen,
  drawRect,
  drawRectOutline,
  drawCircle,
  drawLine,
  drawText,
  rgb
} from "../std/gfx2d/shape2d.aipl"
import { maxInt } from "../std/std_root.aipl"

pub fn verifyOscillatorsFmAndAdsrEnvelope(): int:
  let sq = generateWaveformSample(OSC_SQUARE, 0.25)
  assert(sq == 1.0, "square wave at 0.25 phase == 1.0")
  let tone = synthesizeToneBuffer(440.0, 10.0, 0.8, OSC_SINE, 44100)
  let fmOps = [
    FmOperator(ratio = 1.0, modulationIndex = 1.0, phase = 0.0, detuneHz = 0.0),
    FmOperator(ratio = 2.0, modulationIndex = 1.5, phase = 0.0, detuneHz = 0.0)
  ]
  let fmBuf = renderFmPatch4Op(440.0, 0.01, fmOps, 44100)
  let adsr = createAdsr(0.05, 0.05, 0.6, 0.1, 0.005)
  let sustainPm = int(evaluateAdsr(adsr, 0.10, true, 0.0) * 1000.0 + 0.5)
  ret tone.len() + fmBuf.len() + sustainPm

pub fn computeTotalAdsrDurationMs(attackMs: int, decayMs: int, releaseMs: int): int:
  ret maxInt(1, attackMs) + maxInt(1, decayMs) + maxInt(1, releaseMs)

pub fn describeOscillatorWaveform(modeId: int): str:
  if modeId == 1:
    ret "SYNTH:POLYBLEP_SAWTOOTH_AND_4OP_FM"
  ret "SYNTH:PURE_SINE_OSCILLATOR"

pub fn renderFrameStep(frameIndex: int, dt: float): int:
  let adsr = createAdsr(0.05, 0.05, 0.60, 0.10, 0.005)
  let playheadStep = (frameIndex * 2 + (frameIndex / 13)) % 35
  let playT = float(playheadStep) * 0.01
  let playVal = evaluateAdsr(adsr, playT, playT < 0.20, 0.20)
  let phaseShift = (frameIndex * 3) % 97
  ret verifyOscillatorsFmAndAdsrEnvelope() + int(playVal * 1000.0 + 0.5) + phaseShift + int(dt * 0.0)

pub fn renderSynthAndAdsrWorkbenchScene(frameIndex: int): void:
  let tone = synthesizeToneBuffer(440.0, 10.0, 0.85, OSC_SINE, 44100)
  let modIdx = 1.0 + float((frameIndex / 7) % 5) * 0.35
  let fmOps = [
    FmOperator(ratio = 1.0, modulationIndex = 1.0, phase = 0.0, detuneHz = 0.0),
    FmOperator(ratio = 2.0, modulationIndex = modIdx, phase = 0.0, detuneHz = 0.0)
  ]
  let fmBuf = renderFmPatch4Op(440.0, 0.01, fmOps, 44100)
  let adsr = createAdsr(0.05, 0.05, 0.60, 0.10, 0.005)

  clearScreen(rgb(10, 14, 24))
  drawRect(32.0, 20.0, 1216.0, 54.0, rgb(18, 28, 48))
  drawRectOutline(32.0, 20.0, 1216.0, 54.0, 2.0, rgb(56, 189, 248))
  drawText("EX_148 // PROCEDURAL AUDIO SYNTHESIZER OSCILLOSCOPE & ADSR ENVELOPE", 52.0, 38.0, 20.0, rgb(240, 249, 255))

  // Top Panel: Real-Time Synthesized Waveform Oscilloscope (Sine + 4-Op FM)
  let ox = 56.0
  let oy = 94.0
  let ow = 1168.0
  let oh = 240.0
  drawRect(ox, oy, ow, oh, rgb(14, 21, 36))
  drawRectOutline(ox, oy, ow, oh, 2.0, rgb(56, 189, 248))
  drawText("OSCILLOSCOPE TRACE (440HZ A4 SINE + 4-OP FM HARMONICS)", ox + 20.0, oy + 18.0, 15.0, rgb(125, 211, 252))
  let midY = oy + 135.0
  drawLine(ox + 20.0, midY, ox + ow - 20.0, midY, rgb(30, 41, 59), 1.5)

  let phaseShift = (frameIndex * 3) % 97
  mut s = 0
  while s < 70:
    let s1 = tone[(s * 2 + phaseShift) % tone.len()]
    let s2 = tone[((s + 1) * 2 + phaseShift) % tone.len()]
    let f1 = fmBuf[(s * 2 + phaseShift) % fmBuf.len()]
    let f2 = fmBuf[((s + 1) * 2 + phaseShift) % fmBuf.len()]
    let x1 = ox + 32.0 + float(s * 16)
    let y1 = midY - s1 * 80.0
    let x2 = ox + 32.0 + float((s + 1) * 16)
    let y2 = midY - s2 * 80.0
    drawLine(x1, midY - f1 * 65.0, x2, midY - f2 * 65.0, rgb(168, 85, 247), 1.5)
    drawLine(x1, y1, x2, y2, rgb(56, 189, 248), 3.0)
    s = s + 1

  // Bottom Panel: Anti-Click ADSR Envelope Curve (Attack -> Decay -> Sustain -> Release)
  let ex = 56.0
  let ey = 360.0
  let ew = 1168.0
  let eh = 240.0
  drawRect(ex, ey, ew, eh, rgb(14, 21, 36))
  drawRectOutline(ex, ey, ew, eh, 2.0, rgb(34, 197, 94))
  drawText("ANTI-CLICK ADSR ENVELOPE (A=50ms, D=50ms, S=60%, R=100ms)", ex + 20.0, ey + 18.0, 15.0, rgb(134, 239, 172))
  let baseEnvY = ey + 210.0

  mut step = 0
  while step < 35:
    let t1 = float(step) * 0.01
    let t2 = float(step + 1) * 0.01
    let gate1 = t1 < 0.20
    let gate2 = t2 < 0.20
    let e1 = evaluateAdsr(adsr, t1, gate1, 0.20)
    let e2 = evaluateAdsr(adsr, t2, gate2, 0.20)
    let px1 = ex + 40.0 + float(step * 31)
    let py1 = baseEnvY - e1 * 150.0
    let px2 = ex + 40.0 + float((step + 1) * 31)
    let py2 = baseEnvY - e2 * 150.0
    drawLine(px1, py1, px2, py2, rgb(34, 197, 94), 3.5)
    step = step + 1

  let playheadStep = (frameIndex * 2 + (frameIndex / 13)) % 35
  let playT = float(playheadStep) * 0.01
  let playVal = evaluateAdsr(adsr, playT, playT < 0.20, 0.20)
  let phX = ex + 40.0 + float(playheadStep * 31)
  let phY = baseEnvY - playVal * 150.0
  drawLine(phX, ey + 46.0, phX, baseEnvY, rgb(250, 204, 21), 1.5)
  drawCircle(phX, phY, 8.0, rgb(250, 204, 21))

  // Footer
  drawRect(56.0, 622.0, 1168.0, 56.0, rgb(16, 24, 42))
  drawRectOutline(56.0, 622.0, 1168.0, 56.0, 1.5, rgb(71, 85, 105))
  drawText(describeOscillatorWaveform(1) + " | Total Envelope=" + str(computeTotalAdsrDurationMs(50, 50, 100)) + "ms | Gain=" + str(int(playVal * 100.0)) + "%", 80.0, 643.0, 15.0, rgb(226, 232, 240))

pub fn main(): int:
  let m = verifyOscillatorsFmAndAdsrEnvelope()
  assert(m == 1482, "synth + ADSR metric 1482")
  initWindow(1280, 720, "AIPL ex_148 - Audio Synth Oscillators & ADSR Envelope")
  mut frame: int = 0
  while not windowShouldClose():
    if frame % 20 == 0:
      let notes = [261.63, 329.63, 392.00, 523.25]
      let _ = playToneEx(notes[(frame / 20) % 4], 240.0, 0.35, "fm_epiano")
    beginDrawing()
    renderSynthAndAdsrWorkbenchScene(frame)
    endDrawing()
    frame = frame + 1
  closeWindow()
  ret 0
