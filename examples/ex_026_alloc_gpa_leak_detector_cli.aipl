// ============================================================================
// Example 026: General Purpose Allocator (GPA) & Leak Detector (CLI)
// Demonstrates: gpaInit, gpaAlloc, gpaValidatePtr, gpaRealloc, gpaFree,
//               gpaGetStats, and gpaReportLeaks from std/alloc/gpa.
// ============================================================================
module Ex026AllocGpaLeakDetectorCli

import {
  gpaInit,
  gpaAlloc,
  gpaValidatePtr,
  gpaFree,
  gpaRealloc,
  gpaGetStats,
  gpaReportLeaks
} from "../std/alloc/gpa"

pub fn auditCleanGpaAllocationCycle(initialBytes: int, grownBytes: int): int:
  gpaInit()
  let p1 = gpaAlloc(initialBytes, 100)
  if p1 == 0 or not gpaValidatePtr(p1):
    ret -1
  let p2 = gpaRealloc(p1, grownBytes)
  if p2 == 0 or not gpaValidatePtr(p2):
    ret -2
  let st = gpaGetStats()
  if st.liveAllocations != 1 or st.totalAllocated < grownBytes:
    ret -3
  let freed = gpaFree(p2)
  if not freed:
    ret -4
  ret gpaReportLeaks()

pub fn detectIntentionalLeakAndReclaim(leakBytes: int, callsiteTag: int): int:
  gpaInit()
  let leakedPtr = gpaAlloc(leakBytes, callsiteTag)
  let detectedCount = gpaReportLeaks()
  let _ = gpaFree(leakedPtr)
  let postFreeLeaks = gpaReportLeaks()
  if postFreeLeaks == 0:
    ret detectedCount
  ret -1

pub fn describeGpaLeakAudit(leakCount: int): str:
  if leakCount == 0:
    ret "GPA:ZERO_LEAKS_VERIFIED"
  ret "GPA:LEAK_DETECTED"

pub fn main(): int:
  let cleanLeaks = auditCleanGpaAllocationCycle(256, 512)
  let caughtCount = detectIntentionalLeakAndReclaim(128, 707)
  println("Clean GPA Cycle Leaks: " + str(cleanLeaks) + " (" + describeGpaLeakAudit(cleanLeaks) + ")")
  println("Caught & Reclaimed Leak Count: " + str(caughtCount))
  ret 0
