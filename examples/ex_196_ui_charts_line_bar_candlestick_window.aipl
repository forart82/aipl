module Ex196UiChartsLineBarCandlestickWindow

import { Rect } from "../std/math/geom2d"
import { ColorRgba8 } from "../std/gfx/color"
import { AuraRect } from "../std/ui/ui_layout"
import {
  ChartDataSeries, LineChartWidget, autoScaleChartRange,
  computeDataPointScreenCoords, createChartSeries, auraDrawSparkline
} from "../std/ui/ui_charts"
import {
  initWindow, windowShouldClose, beginDrawing, endDrawing, closeWindow,
  clearScreen, drawRect, drawRectOutline, drawCircle, drawLine, drawText, rgb, colorHex
} from "../std/gfx2d/shape2d"

pub fn stepChartSeriesValues(frame: int): [float]:
  let ph = float(frame) * 0.065
  ret [
    22.0 + sin(ph) * 10.0,
    44.0 + cos(ph * 0.9) * 12.0,
    36.0 + sin(ph * 1.2 + 0.8) * 14.0,
    68.0 + cos(ph * 1.1 + 1.4) * 15.0,
    58.0 + sin(ph * 0.8 + 2.1) * 14.0,
    84.0 + cos(ph * 1.3 + 0.5) * 12.0,
    74.0 + sin(ph * 1.0 + 1.9) * 16.0,
    96.0 + sin(ph * 1.4) * 18.0
  ]

pub fn buildUiChartsAudit(): int:
  let s1 = ChartDataSeries(
    name = "Throughput",
    values = [10.0, 50.0, 90.0],
    color = ColorRgba8(r = 56, g = 189, b = 248, a = 255)
  )
  let chart = autoScaleChartRange([s1])
  let midPt = computeDataPointScreenCoords(chart, 0, 1)
  let cs = createChartSeries("Candles", [100.0, 112.0, 108.0, 125.0], 0x22C55E)
  ret int(chart.minVal) + int(chart.maxVal) + int(midPt.x) + int(midPt.y) + cs.values.len()

pub fn main(): int:
  let auditScore = buildUiChartsAudit()

  initWindow(1280, 720, "AIPL ex_196: UI Charts - Auto-Scaled Line, Bar & Candlestick OHLC")
  mut frame = 0
  while not windowShouldClose():
    let vals = stepChartSeriesValues(frame)
    let dynTail = vals[7]
    let sCpu = ChartDataSeries(
      name = "GPU Compute GFLOPS",
      values = vals,
      color = ColorRgba8(r = 56, g = 189, b = 248, a = 255)
    )
    let baseChart = autoScaleChartRange([sCpu])
    let chart = LineChartWidget(
      series = baseChart.series,
      minVal = baseChart.minVal,
      maxVal = baseChart.maxVal,
      bounds = Rect(x = 110.0, y = 176.0, w = 480.0, h = 216.0),
      showGrid = true
    )
    let cs = createChartSeries(
      "OHLC Close",
      [
        102.0 + vals[0] * 0.25,
        115.0 + vals[1] * 0.22,
        106.0 + vals[2] * 0.20,
        128.0 + vals[3] * 0.22,
        118.0 + vals[5] * 0.18,
        132.0 + dynTail * 0.20
      ],
      0x22C55E
    )

    beginDrawing()
    clearScreen(rgb(10, 14, 24))

    drawRect(32.0, 24.0, 1216.0, 68.0, rgb(18, 28, 48))
    drawRectOutline(32.0, 24.0, 1216.0, 68.0, 2.0, rgb(56, 189, 248))
    drawText("EX_196: UI CHARTS - AUTO-SCALED LINE, BAR & CANDLESTICK VISUALIZER", 52.0, 40.0, 22.0, rgb(240, 249, 255))
    drawText("autoScaleRange=[" + str(int(chart.minVal)) + ".." + str(int(chart.maxVal)) + " GFLOPS] | series=" + cs.name + " | tail=" + str(int(dynTail)) + " | audit=" + str(auditScore), 52.0, 66.0, 15.0, rgb(125, 211, 252))

    // Left Line Chart Panel
    drawRect(60.0, 118.0, 560.0, 310.0, rgb(17, 24, 39))
    drawRectOutline(60.0, 118.0, 560.0, 310.0, 2.0, rgb(56, 189, 248))
    drawText("1. Auto-Scaled LineChartWidget (computeDataPointScreenCoords):", 80.0, 134.0, 16.0, rgb(125, 211, 252))

    // Grid lines & Y-axis labels
    mut g = 0
    while g <= 4:
      let gy = chart.bounds.y + (float(g) / 4.0) * chart.bounds.h
      let gVal = chart.maxVal - (float(g) / 4.0) * (chart.maxVal - chart.minVal)
      drawLine(chart.bounds.x, gy, chart.bounds.x + chart.bounds.w, gy, rgb(30, 41, 59), 1.0)
      drawText(str(int(gVal)), 72.0, gy - 6.0, 13.0, rgb(148, 163, 184))
      g = g + 1

    mut idx = 0
    while idx < 7:
      let p0 = computeDataPointScreenCoords(chart, 0, idx)
      let p1 = computeDataPointScreenCoords(chart, 0, idx + 1)
      drawLine(p0.x, p0.y, p1.x, p1.y, rgb(56, 189, 248), 3.0)
      drawCircle(p0.x, p0.y, 5.0, rgb(240, 249, 255))
      drawText(str(int(vals[idx])), p0.x - 10.0, p0.y - 18.0, 12.0, rgb(186, 230, 253))
      idx = idx + 1
    let pLast = computeDataPointScreenCoords(chart, 0, 7)
    drawCircle(pLast.x, pLast.y, 6.0, rgb(250, 204, 21))
    drawText(str(int(vals[7])), pLast.x - 12.0, pLast.y - 18.0, 12.0, rgb(250, 204, 21))

    // Right Candlestick & Volume Bar Panel
    drawRect(660.0, 118.0, 560.0, 310.0, rgb(17, 24, 39))
    drawRectOutline(660.0, 118.0, 560.0, 310.0, 2.0, rgb(52, 211, 153))
    drawText("2. OHLC Candlesticks & Volume Histogram Bars:", 680.0, 134.0, 16.0, rgb(110, 231, 183))

    mut cIdx = 0
    while cIdx < cs.values.len():
      let cx = 706.0 + float(cIdx) * 82.0
      let isBull = cIdx % 2 != 1
      let col = if isBull: rgb(34, 197, 94) else: rgb(239, 68, 68)
      let closeV = cs.values[cIdx]
      let topY = 344.0 - (closeV - 90.0) * 2.4
      let bodyH = 26.0 + float((cIdx * 7 + frame / 6) % 18)
      // High/Low wick + Open/Close body
      drawLine(cx + 16.0, topY - 18.0, cx + 16.0, topY + bodyH + 18.0, col, 2.0)
      drawRect(cx, topY, 32.0, bodyH, col)
      drawRectOutline(cx, topY, 32.0, bodyH, 1.0, rgb(240, 249, 255))
      drawText(str(int(closeV)), cx + 2.0, topY - 34.0, 12.0, rgb(209, 250, 229))
      // Bottom Volume Bar
      let volH = 18.0 + (vals[cIdx] / 115.0) * 48.0
      drawRect(cx + 4.0, 412.0 - volH, 24.0, volH, if isBull: rgb(16, 185, 129) else: rgb(185, 28, 28))
      cIdx = cIdx + 1

    // Bottom Sparkline Strip
    drawText("3. Real-Time Telemetry Sparkline (auraDrawSparkline):", 60.0, 448.0, 17.0, rgb(203, 213, 225))
    auraDrawSparkline(
      AuraRect(x = 60.0, y = 476.0, w = 1160.0, h = 196.0),
      sCpu.values,
      chart.minVal - 5.0,
      chart.maxVal + 5.0,
      colorHex(0x38BDF8),
      colorHex(0x111827)
    )

    endDrawing()
    frame = frame + 1

  closeWindow()
  println("Audit score: " + str(auditScore))
  ret 0
