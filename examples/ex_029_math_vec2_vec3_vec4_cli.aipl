// ============================================================================
// Example 029: 2D/3D/4D Vector Algebra & Orthonormal Basis (CLI)
// Demonstrates: Vec2, Vec3, Vec4, distSq2D, inDisk2D, vec2Lerp, and
//               vec2Distance from std/math/vec_math.
// ============================================================================
module Ex029MathVec2Vec3Vec4Cli

import {
  Vec2,
  Vec3,
  Vec4,
  distSq2D,
  inDisk2D,
  vec2Lerp,
  vec2Distance
} from "../std/math/vec_math"

pub fn verifyVec2DotCrossAndDisk(ax: float, ay: float, bx: float, by: float): int:
  let a = Vec2.new(ax, ay)
  let b = Vec2.new(bx, by)
  let d = a.dot(b)
  let c = a.cross(b)
  let l = a.len()
  let mid = vec2Lerp(a, b, 0.5)
  let distAB = vec2Distance(a, b)
  if inDisk2D(1, 1, 0, 0, 2) and distSq2D(0, 0, 3, 4) == 25 and mid.x == 2.0 and distAB > 2.0:
    ret int(d + c + l)
  ret -1

pub fn verifyVec3OrthonormalCrossBasis(): int:
  let iAxis = Vec3.new(1.0, 0.0, 0.0)
  let jAxis = Vec3.new(0.0, 1.0, 0.0)
  let kAxis = iAxis.cross(jAxis)
  if iAxis.dot(jAxis) == 0.0 and kAxis.z == 1.0 and kAxis.len() == 1.0:
    ret 1
  ret 0

pub fn verifyVec4HomogeneousNormMilli(x: float, y: float, z: float, w: float): int:
  let v = Vec4.new(x, y, z, w)
  let u = v.norm()
  ret int(u.w * 1000.0 + 0.5)

pub fn describeVectorSpaceDim(dim: int): str:
  if dim == 2:
    ret "VEC:R2_PLANAR"
  if dim == 3:
    ret "VEC:R3_EUCLIDEAN_BASIS"
  ret "VEC:R4_HOMOGENEOUS_CLIP"

pub fn main(): int:
  let v2Metric = verifyVec2DotCrossAndDisk(3.0, 4.0, 1.0, 2.0)
  let basisOk = verifyVec3OrthonormalCrossBasis()
  let wNorm = verifyVec4HomogeneousNormMilli(1.0, 2.0, 2.0, 4.0)
  println("Vec2 Dot+Cross+Len Metric: " + str(v2Metric))
  println("Vec3 Orthonormal Cross Basis (i x j = k): " + str(basisOk) + " (" + describeVectorSpaceDim(3) + ")")
  println("Vec4 Normalized W (milli): " + str(wNorm))
  ret 0
