// ============================================================================
// Example 046: BTreeMap Ordered Keys, Min/Max & Range Scan (CLI)
// Demonstrates: btreeNodeNew, btreeMapNew, .insert(), .get(), .containsKey(),
//               .minKey(), .maxKey(), .range(), .keys(), and .values() from
//               std/collections/btree_map.
// ============================================================================
module Ex046CollectionsBtreeMapRangeQueryCli

import { btreeNodeNew, btreeMapNew } from "../std/collections/btree_map"

pub fn evaluateBTreeRangeAndExtremes(): int:
  let leafCheck = btreeNodeNew[int, str](true)
  mut tree = btreeMapNew[int, str](2)
  tree.insert(50, "fifty")
  tree.insert(20, "twenty")
  tree.insert(70, "seventy")
  tree.insert(10, "ten")
  tree.insert(30, "thirty")
  let minK = tree.minKey().unwrap()
  let maxK = tree.maxKey().unwrap()
  let subRange = tree.range(20, 50)
  if leafCheck.isLeaf and tree.keys().len == 5 and tree.values().len == 5:
    ret minK + maxK + subRange.len
  ret -1

pub fn verifyBTreeOrderedKeyLookup(queryKey: int): str:
  mut tree = btreeMapNew[int, str](2)
  tree.insert(10, "ten")
  tree.insert(20, "twenty")
  tree.insert(30, "thirty")
  if tree.containsKey(queryKey):
    ret tree.get(queryKey).unwrap()
  ret "MISSING"

pub fn describeBTreeOrder(minDegree: int): str:
  if minDegree == 2:
    ret "BTREE:MIN_DEGREE_2_ORDERED_INDEX"
  ret "BTREE:HIGH_FANOUT_NODE"

pub fn main(): int:
  let metric = evaluateBTreeRangeAndExtremes()
  let val30 = verifyBTreeOrderedKeyLookup(30)
  println("BTreeMap Min+Max+RangeLen Metric: " + str(metric))
  println("BTreeMap Lookup(30): " + val30 + " (" + describeBTreeOrder(2) + ")")
  ret 0
