// ============================================================================
// Example 065: Duration Arithmetic, Parsing & Humanizer Formatting (CLI)
// Demonstrates: durationFromMinutes, durationFromSeconds, durationFromMillis,
//               parseDuration, parseDurationMs, formatDurationMs, formatMmSs,
//               formatDurationHMS, and formatDurationHhMmSsMs from std/time.
// ============================================================================
module Ex065TimeDurationHumanizerCli

import {
  durationFromMinutes,
  durationFromSeconds,
  durationFromMillis,
  parseDuration,
  parseDurationMs,
  formatDurationMs,
  formatMmSs,
  formatDurationHMS,
  formatDurationHhMmSsMs
} from "../std/time"

// Combines minutes, seconds, and milliseconds using Duration arithmetic.
pub fn computeCombinedDurationMillis(mins: int, secs: int, millis: int): int:
  let dMin = durationFromMinutes(mins)
  let dSec = durationFromSeconds(secs)
  let dMs = durationFromMillis(millis)
  let combined = dMin.add(dSec).add(dMs)
  assert(combined.isPositive(), "combined duration is positive")
  ret combined.toMillis()

// Formats total milliseconds into a high-precision HH:MM:SS.mmm stopwatch readout.
pub fn formatStopwatchClockHhMmSsMs(totalMs: int): str:
  let totalSec = totalMs / 1000
  let hms = formatDurationHMS(totalSec)
  assert(hms.len == 8, "HMS format length is 8 chars")
  ret formatDurationHhMmSsMs(totalMs)

// Parses a duration specification string via both parseDuration and parseDurationMs.
pub fn parseAndVerifyDurationSpecMs(spec: str): int:
  let parsedObj = parseDuration(spec).unwrap()
  let parsedMs = parseDurationMs(spec).unwrap()
  assert(parsedObj.toMillis() == parsedMs, "parseDuration and parseDurationMs agree")
  ret parsedMs

pub fn main(): int:
  let combinedMs = computeCombinedDurationMillis(2, 15, 500)
  let mmss = formatMmSs(125)
  assert(mmss == "02:05", "125s formats as 02:05")
  assert(formatDurationMs(500) == "500ms", "500ms humanizer")

  let clockStr = formatStopwatchClockHhMmSsMs(3661500)
  let specMs = parseAndVerifyDurationSpecMs("2s")
  println("ex_065_time_duration_humanizer_cli: combinedMs=" + str(combinedMs) + " clock=" + clockStr + " specMs=" + str(specMs))
  ret 0
