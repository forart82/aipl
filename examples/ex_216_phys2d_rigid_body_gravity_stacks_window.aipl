module Ex216Phys2dRigidBodyGravityStacksWindow

import { Vec2 } from "../std/math/vec_math"
import {
  BodyType2D, RigidBody2D, rigidBody2dNew, rigidBody2dSetMass,
  rigidBody2dApplyLinearImpulse, rigidBody2dApplyAngularImpulse,
  rigidBody2dIntegrateVelocity, rigidBody2dIntegratePosition
} from "../std/phys2d/rigid_body2d"
import {
  initWindow, windowShouldClose, beginDrawing, endDrawing, closeWindow,
  clearScreen, drawRect, drawRectOutline, drawCircle, drawCircleOutline,
  drawLine, drawText, rgb
} from "../std/gfx2d/shape2d"

pub fn computeAwakeBodyCount(totalDynamic: int, sleepingCount: int): int:
  let awake = totalDynamic - sleepingCount
  ret if awake > 0: awake else: 0

pub fn stepSymplecticVelocityMmPerSec(velMmPerSec: int, accelStepMmPerSec: int): int:
  ret velMmPerSec + accelStepMmPerSec

pub fn stepStackCycleFrame(frame: int): int:
  ret frame % 80

pub fn stepShotEpoch(frame: int): int:
  ret frame / 80

pub fn buildPhys2dRigidBodyAudit(): int:
  let awake = computeAwakeBodyCount(55, 40)
  let vStep = stepSymplecticVelocityMmPerSec(1200, 163)
  mut b = rigidBody2dNew(1, BodyType2D.Dynamic, Vec2(x = 0.0, y = 0.0), 0.0)
  rigidBody2dSetMass(b, 2.0, 4.0)
  rigidBody2dApplyLinearImpulse(b, Vec2(x = 10.0, y = 0.0))
  rigidBody2dApplyAngularImpulse(b, 8.0)
  rigidBody2dIntegrateVelocity(b, Vec2(x = 0.0, y = -10.0), 0.1)
  rigidBody2dIntegratePosition(b, 1.0)
  ret awake + vStep + int(b.position.x) + int(b.angularVelocity)

pub fn main(): int:
  let auditScore = buildPhys2dRigidBodyAudit()

  mut stackBodies: [RigidBody2D] = []
  mut i = 0
  while i < 6:
    mut rb = rigidBody2dNew(10 + i, BodyType2D.Dynamic, Vec2(x = 460.0, y = 548.0 - float(i) * 64.0), 0.0)
    rigidBody2dSetMass(rb, 2.0, 4.0)
    stackBodies.push(rb)
    i = i + 1

  mut projectile = rigidBody2dNew(99, BodyType2D.Dynamic, Vec2(x = 120.0, y = 320.0), 0.0)
  rigidBody2dSetMass(projectile, 1.5, 2.0)

  initWindow(1280, 720, "AIPL ex_216: Phys2D Symplectic Euler Rigid Body Gravity Stacks")
  mut frame = 0
  while not windowShouldClose():
    let cycleFrame = stepStackCycleFrame(frame)
    let shotEpoch = stepShotEpoch(frame)

    // Periodically restack toppled crates and respawn projectile every 80 frames
    if cycleFrame == 0:
      mut ri = 0
      while ri < stackBodies.len():
        mut srb: RigidBody2D = stackBodies[ri]
        srb.position = Vec2(x = 460.0, y = 548.0 - float(ri) * 64.0)
        srb.angle = 0.0
        srb.linearVelocity = Vec2(x = 0.0, y = 0.0)
        srb.angularVelocity = 0.0
        stackBodies[ri] = srb
        ri = ri + 1
      let launchY = 360.0 - float(shotEpoch % 3) * 55.0
      projectile.position = Vec2(x = 120.0, y = launchY)
      projectile.angle = 0.0
      projectile.linearVelocity = Vec2(x = 0.0, y = 0.0)
      projectile.angularVelocity = 0.0
      rigidBody2dApplyLinearImpulse(projectile, Vec2(x = 1260.0, y = -90.0))
      rigidBody2dApplyAngularImpulse(projectile, 9.0)

    // Symplectic Euler integration before beginDrawing()
    rigidBody2dIntegrateVelocity(projectile, Vec2(x = 0.0, y = 260.0), 0.016)
    rigidBody2dIntegratePosition(projectile, 0.016)
    if projectile.position.y > 554.0:
      projectile.position = Vec2(x = projectile.position.x, y = 554.0)
      projectile.linearVelocity = Vec2(x = projectile.linearVelocity.x * 0.82, y = -abs(projectile.linearVelocity.y) * 0.45)
    if projectile.position.x > 1100.0:
      projectile.position = Vec2(x = 1100.0, y = projectile.position.y)
      projectile.linearVelocity = Vec2(x = -abs(projectile.linearVelocity.x) * 0.6, y = projectile.linearVelocity.y)

    mut movingCrates = 0
    mut si = 0
    while si < stackBodies.len():
      mut sb: RigidBody2D = stackBodies[si]
      let floorTargetY = 548.0 - float(si) * 64.0
      if projectile.position.x + 56.0 >= sb.position.x and projectile.position.x <= sb.position.x + 140.0:
        if sb.linearVelocity.x < 10.0:
          rigidBody2dApplyLinearImpulse(sb, Vec2(x = 340.0 + float(si) * 85.0, y = -120.0 - float(si) * 25.0))
          rigidBody2dApplyAngularImpulse(sb, 6.0 + float(si) * 1.5)
      if sb.linearVelocity.x > 0.5 or sb.linearVelocity.x < -0.5 or sb.position.y < floorTargetY:
        movingCrates = movingCrates + 1
        rigidBody2dIntegrateVelocity(sb, Vec2(x = 0.0, y = 380.0), 0.016)
        rigidBody2dIntegratePosition(sb, 0.016)
        if sb.position.y > 548.0:
          sb.position = Vec2(x = sb.position.x, y = 548.0)
          sb.linearVelocity = Vec2(x = sb.linearVelocity.x * 0.88, y = -abs(sb.linearVelocity.y) * 0.35)
        if sb.position.x > 1010.0:
          sb.position = Vec2(x = 1010.0, y = sb.position.y)
          sb.linearVelocity = Vec2(x = -abs(sb.linearVelocity.x) * 0.65, y = sb.linearVelocity.y)
      stackBodies[si] = sb
      si = si + 1

    beginDrawing()
    clearScreen(rgb(10, 14, 24))

    drawRect(32.0, 24.0, 1216.0, 68.0, rgb(18, 28, 48))
    drawRectOutline(32.0, 24.0, 1216.0, 68.0, 2.0, rgb(56, 189, 248))
    drawText("EX_216: PHYS2D RIGID BODY SYMPLECTIC EULER & GRAVITY STACKS", 52.0, 40.0, 22.0, rgb(240, 249, 255))
    drawText("shotEpoch=#" + str(shotEpoch + 1) + " (cycle=" + str(cycleFrame) + "/80) | displacedCrates=" + str(movingCrates) + "/6 | projPos=(" + str(int(projectile.position.x)) + "," + str(int(projectile.position.y)) + ") | audit=" + str(auditScore), 52.0, 66.0, 16.0, rgb(125, 211, 252))

    // Static Ground Floor & Right Backstop Wall
    drawRect(80.0, 610.0, 1120.0, 38.0, rgb(30, 41, 59))
    drawRectOutline(80.0, 610.0, 1120.0, 38.0, 2.0, rgb(148, 163, 184))
    drawText("STATIC GROUND COLLIDER (invMass = 0.0, restitution = 0.35)", 410.0, 621.0, 16.0, rgb(203, 213, 225))
    drawRect(1152.0, 140.0, 28.0, 470.0, rgb(30, 41, 59))
    drawRectOutline(1152.0, 140.0, 28.0, 470.0, 2.0, rgb(148, 163, 184))

    // Stacked Dynamic Crates rendered directly from b.position, b.angle, and b.linearVelocity
    mut k = 0
    while k < stackBodies.len():
      let b: RigidBody2D = stackBodies[k]
      let isHit = b.linearVelocity.x > 1.0 or b.linearVelocity.x < -1.0
      let cx = b.position.x + 114.0
      let cy = b.position.y + 30.0
      drawRect(b.position.x, b.position.y, 140.0, 60.0, if isHit: rgb(30, 64, 115) else: rgb(22, 48, 72))
      drawRectOutline(b.position.x, b.position.y, 140.0, 60.0, 2.2, if isHit: rgb(250, 204, 21) else: rgb(56, 189, 248))
      // Dedicated angular orientation dial on right of crate
      drawCircleOutline(cx, cy, 16.0, 1.2, rgb(71, 85, 105))
      let ax = cx + cos(b.angle) * 15.0
      let ay = cy + sin(b.angle) * 15.0
      drawLine(cx, cy, ax, ay, rgb(125, 211, 252), 2.0)
      if isHit:
        drawLine(cx, cy, cx + b.linearVelocity.x * 0.14, cy + b.linearVelocity.y * 0.14, rgb(250, 204, 21), 2.5)
      drawText("Body #" + str(b.id), b.position.x + 12.0, b.position.y + 12.0, 15.0, rgb(240, 249, 255))
      drawText("m=2kg I=4", b.position.x + 12.0, b.position.y + 34.0, 13.0, rgb(148, 163, 184))
      k = k + 1

    // Dynamic Projectile Crate with Angular Indicator & Velocity Vector
    let pcx = projectile.position.x + 28.0
    let pcy = projectile.position.y + 28.0
    drawRect(projectile.position.x, projectile.position.y, 56.0, 56.0, rgb(16, 185, 129))
    drawRectOutline(projectile.position.x, projectile.position.y, 56.0, 56.0, 2.5, rgb(167, 243, 208))
    drawCircle(pcx, pcy, 5.0, rgb(250, 204, 21))
    drawLine(pcx, pcy, pcx + cos(projectile.angle) * 22.0, pcy + sin(projectile.angle) * 22.0, rgb(248, 250, 252), 2.5)
    drawLine(pcx, pcy, pcx + projectile.linearVelocity.x * 0.08, pcy + projectile.linearVelocity.y * 0.08, rgb(250, 204, 21), 2.8)
    drawText("#99", projectile.position.x + 12.0, projectile.position.y + 6.0, 13.0, rgb(6, 78, 59))

    endDrawing()
    frame = frame + 1

  closeWindow()
  println("Audit score: " + str(auditScore))
  ret 0
