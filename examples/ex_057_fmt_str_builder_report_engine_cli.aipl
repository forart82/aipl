// ============================================================================
// Example 057: StringBuilder Report Engine & Casing/Similarity (CLI)
// Demonstrates: TextRange, stringBuilderNew, sbAppendIndent, sbAppendLine,
//               sbToString, toCamelCase, toSnakeCase, toKebabCase,
//               toPascalCase, levenshteinDistance, and jaroWinklerSimilarity
//               from std/fmt/str_builder.
// ============================================================================
module Ex057FmtStrBuilderReportEngineCli

import {
  TextRange,
  stringBuilderNew,
  sbAppendIndent,
  sbAppendLine,
  sbToString,
  toCamelCase,
  toSnakeCase,
  toKebabCase,
  toPascalCase,
  levenshteinDistance,
  jaroWinklerSimilarity
} from "../std/fmt/str_builder"

pub fn buildStructuredReportAndCasing(ident: str): str:
  mut sb = stringBuilderNew(64)
  sb = sbAppendIndent(sb, 1, "  ")
  sb = sbAppendLine(sb, ident)
  let camel = toCamelCase(ident)
  let pascal = toPascalCase(ident)
  let kebab = toKebabCase(camel)
  let snake = toSnakeCase(camel)
  if sbToString(sb).contains(ident) and snake == ident:
    ret camel + ":" + pascal + ":" + kebab
  ret "ERR"

pub fn evaluateStringSimilarityMetrics(): int:
  let tr = TextRange.new(2, 7)
  let lev = levenshteinDistance("kitten", "sitting")
  let jw = jaroWinklerSimilarity("martha", "marhta")
  if jw > 0.9:
    ret lev + tr.len()
  ret -1

pub fn describeReportBuilderMode(modeId: int): str:
  if modeId == 0:
    ret "STR_BUILDER:ZERO_REALLOC_INDENTED"
  ret "STR_BUILDER:ROPE_CHAIN"

pub fn main(): int:
  let cased = buildStructuredReportAndCasing("user_profile")
  let simMetric = evaluateStringSimilarityMetrics()
  println("Identifier Casing Variants: " + cased)
  println("Levenshtein + TextRange Metric: " + str(simMetric) + " (" + describeReportBuilderMode(0) + ")")
  ret 0
