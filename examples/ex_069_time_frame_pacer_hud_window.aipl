// ============================================================================
// Example 069: Fixed-Timestep Accumulator & Frame Pacer HUD Window
// Demonstrates: fixedTimestepAccumulatorNew, frameRateGovernorNew,
//               instantFromMillis, durationFromMillis, and formatDurationMs
//               from std/time, rendered as an interactive 60Hz VSync frame
//               time budget histogram and alpha residual HUD on 1280x720.
// ============================================================================
module Ex069TimeFramePacerHudWindow

import { clampInt } from "../std/prelude"
import {
  fixedTimestepAccumulatorNew,
  frameRateGovernorNew,
  instantFromMillis,
  durationFromMillis,
  formatDurationMs
} from "../std/time"
import {
  initWindow,
  windowShouldClose,
  beginDrawing,
  endDrawing,
  closeWindow,
  clearScreen,
  drawRect,
  drawRectOutline,
  drawLine,
  drawText,
  rgb
} from "../std/gfx2d/shape2d"

pub struct FramePacerHudState:
  substepsExecuted: int
  alphaPermille: int
  stepBudgetMs: int

pub fn evaluateAccumulatorSubsteps(targetHz: int, deltaMs: int): int:
  mut pacer = fixedTimestepAccumulatorNew(targetHz, 5)
  let t0 = instantFromMillis(1000)
  pacer.reset(t0)
  let t1 = t0.addDuration(durationFromMillis(deltaMs))
  ret pacer.advance(t1)

pub fn describeFramePacerVSyncMode(targetHz: int): str:
  if targetHz == 60:
    ret "PACER:VSYNC_60HZ_16_67MS"
  ret "PACER:HIGH_REFRESH_120HZ"

pub fn buildFramePacerHudState(frameIdx: int): FramePacerHudState:
  mut pacer = fixedTimestepAccumulatorNew(60, 5)
  mut curTime = instantFromMillis(1000)
  pacer.reset(curTime)
  let burstDur = durationFromMillis(18 + ((frameIdx * 7) % 24))
  curTime = curTime.addDuration(burstDur)
  let ticks = pacer.advance(curTime)
  let alphaPm = clampInt(int(pacer.alpha() * 1000.0), 0, 1000)
  let stepMs = pacer.targetDt.toMillis()
  ret FramePacerHudState(
    substepsExecuted = ticks,
    alphaPermille = alphaPm,
    stepBudgetMs = stepMs
  )

pub fn renderFrameStep(frameIndex: int, dt: float): int:
  let st = buildFramePacerHudState(frameIndex)
  let dtPad = clampInt(int(dt * 0.0), 0, 0)
  ret st.substepsExecuted * 100 + st.alphaPermille + frameIndex + dtPad

pub fn renderFramePacerHudScene(frameIdx: int): void:
  let st = buildFramePacerHudState(frameIdx)
  mut gov = frameRateGovernorNew(60)
  gov.setTargetFps(60)
  gov.beginFrame()
  mut pacer = fixedTimestepAccumulatorNew(60, 5)
  mut simNow = instantFromMillis(1000)
  pacer.reset(simNow)

  clearScreen(rgb(11, 16, 27))
  drawRect(0.0, 0.0, 1280.0, 56.0, rgb(18, 28, 46))
  drawText("AIPL ex_069: FixedTimestepAccumulator & FrameRateGovernor 60Hz Telemetry HUD", 24.0, 18.0, 20.0, rgb(226, 232, 240))

  // Left Panel: 32-Bar Frame Duration & Residual Accumulator Histogram vs VSync Ceiling
  let px = 56.0
  let py = 96.0
  let pw = 720.0
  let ph = 520.0
  drawRect(px, py, pw, ph, rgb(16, 24, 40))
  drawRectOutline(px, py, pw, ph, 2.0, rgb(56, 189, 248))

  let govTargetMs = float(gov.targetFrameDuration.toMillis())
  let pacerStepMs = pacer.stepSeconds() * 1000.0
  let vsync60Y = py + ph - pacerStepMs * 10.0
  let vsync30Y = py + ph - govTargetMs * 20.0

  for barIdx in 0..32:
    let frameDur = durationFromMillis(11 + ((barIdx * 5 + frameIdx) % 16))
    simNow = simNow.addDuration(frameDur)
    let ticksThisBar = pacer.advance(simNow)
    let barTotalMs = float(frameDur.toMillis())
    let residualMs = pacer.alpha() * pacerStepMs
    let barH = barTotalMs * 10.0
    let resH = residualMs * 10.0
    let bx = px + 24.0 + float(barIdx * 21)
    let by = py + ph - barH
    let barColor = if ticksThisBar <= 1: rgb(56, 189, 248) else: rgb(250, 204, 21)
    drawRect(bx, by, 15.0, barH, barColor)
    drawRect(bx + 3.0, py + ph - resH, 9.0, resH, rgb(168, 85, 247))

  // VSync threshold lines read from FrameRateGovernor.targetFrameDuration and FixedTimestepAccumulator.targetDt
  drawLine(px, vsync60Y, px + pw, vsync60Y, rgb(74, 222, 128), 2.0)
  drawRect(px + 10.0, vsync60Y - 22.0, 200.0, 20.0, rgb(16, 24, 40))
  drawText(formatDurationMs(pacer.targetDt.toMillis()) + " (" + str(gov.targetFps) + " FPS Target)", px + 14.0, vsync60Y - 20.0, 14.0, rgb(74, 222, 128))
  drawLine(px, vsync30Y, px + pw, vsync30Y, rgb(248, 113, 113), 1.5)
  drawText("2x Frame Spike Ceiling", px + 14.0, vsync30Y - 20.0, 14.0, rgb(248, 113, 113))

  // Right Panel: Substep & Interpolation Alpha Gauge
  let rx = 812.0
  drawRect(rx, py, 412.0, ph, rgb(17, 25, 42))
  drawRectOutline(rx, py, 412.0, ph, 2.0, rgb(71, 85, 105))
  drawText("Mode: " + describeFramePacerVSyncMode(gov.targetFps), rx + 24.0, py + 36.0, 18.0, rgb(125, 211, 252))
  drawText("Fixed Substeps Executed: " + str(st.substepsExecuted), rx + 24.0, py + 78.0, 16.0, rgb(74, 222, 128))
  drawText("Step Quantum: " + formatDurationMs(st.stepBudgetMs), rx + 24.0, py + 114.0, 16.0, rgb(250, 204, 21))
  drawText("Residual Alpha: " + str(st.alphaPermille) + " permille", rx + 24.0, py + 150.0, 16.0, rgb(203, 213, 225))

  // Alpha progress bar
  drawRect(rx + 24.0, py + 190.0, 360.0, 28.0, rgb(30, 41, 59))
  let fillW = float((st.alphaPermille * 360) / 1000)
  drawRect(rx + 24.0, py + 190.0, fillW, 28.0, rgb(168, 85, 247))
  drawRectOutline(rx + 24.0, py + 190.0, 360.0, 28.0, 2.0, rgb(216, 180, 254))
  drawText("Frame Index: " + str(frameIdx), rx + 24.0, py + 242.0, 16.0, rgb(148, 163, 184))

pub fn main(): int:
  initWindow(1280, 720, "AIPL ex_069 - Fixed Timestep Frame Pacer Telemetry HUD")
  mut frame = 0
  while not windowShouldClose():
    beginDrawing()
    renderFramePacerHudScene(frame)
    endDrawing()
    frame = frame + 1
  closeWindow()
  ret 0
