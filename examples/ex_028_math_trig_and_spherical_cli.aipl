// ============================================================================
// Example 028: Trigonometry, Polar Hypotenuse & Angle Wrapping (CLI)
// Demonstrates: degToRad, radToDeg, sin, cos, atan2, hypot, wrapAngleDeg,
//               angleDeltaDeg, vec2RotateFixed, sincFloat, and cosineWave
//               from std/math/trig.
// ============================================================================
module Ex028MathTrigAndSphericalCli

import { absFloat } from "../std/math/consts"
import {
  degToRad,
  radToDeg,
  sin,
  cos,
  atan2,
  hypot,
  wrapAngleDeg,
  angleDeltaDeg,
  vec2RotateFixed,
  sincFloat,
  cosineWave
} from "../std/math/trig"

pub fn verifyPythagoreanTrigAndHypot(dx: float, dy: float): int:
  let rad = degToRad(37.0)
  let s = sin(rad)
  let c = cos(rad)
  let pyth = (s * s) + (c * c)
  let h = hypot(dx, dy)
  let bearingDeg = radToDeg(atan2(1.0, 1.0))
  let sinc0 = sincFloat(0.0)
  let cw0 = cosineWave(1.0, 1.0, 0.0)
  if absFloat(pyth - 1.0) < 0.01 and absFloat(bearingDeg - 45.0) < 0.5 and sinc0 == 1.0 and cw0 == 1.0:
    ret int(h)
  ret -1

pub fn computeShortestHeadingTurnDeg(fromDeg: float, toDeg: float): int:
  let wrapped = wrapAngleDeg(540.0)
  let delta = angleDeltaDeg(toDeg, fromDeg)
  if absFloat(wrapped - (-180.0)) < 0.01:
    ret int(delta + 0.5)
  ret -999

pub fn verifyFixedAngleQuarterRotation(x: int, y: int): int:
  let (rx, ry) = vec2RotateFixed(x, y, 64)
  ret rx + ry

pub fn describeQuadrantBearing(deg: int): str:
  let norm = ((deg % 360) + 360) % 360
  if norm < 90:
    ret "BEARING:NE_QUADRANT"
  if norm < 180:
    ret "BEARING:SE_QUADRANT"
  if norm < 270:
    ret "BEARING:SW_QUADRANT"
  ret "BEARING:NW_QUADRANT"

pub fn main(): int:
  let hyp = verifyPythagoreanTrigAndHypot(3.0, 4.0)
  let turn = computeShortestHeadingTurnDeg(350.0, 10.0)
  let rotSum = verifyFixedAngleQuarterRotation(10, 0)
  println("Pythagorean & Hypot(3, 4): " + str(hyp))
  println("Shortest Heading Turn (350 -> 10 deg): +" + str(turn) + " deg")
  println("Fixed-Angle 90-deg Rotation (10,0): " + str(rotSum) + " | " + describeQuadrantBearing(45))
  ret 0
