// ============================================================================
// Example 056: Number Radix Parsing, Dragonbox & Scientific Fmt (CLI)
// Demonstrates: parseInt, parseIntRadix, parseIntEx, ParseIntOptions,
//               formatIntPadded, formatHex, formatBinary, formatOctal,
//               parseFloat, formatFloatFixed, formatFloatDragonbox, and
//               formatFloatScientific from std/fmt/num_parse.
// ============================================================================
module Ex056FmtNumRadixAndScientificCli

import {
  ParseIntOptions,
  parseInt,
  parseIntRadix,
  parseIntEx,
  formatIntPadded,
  formatHex,
  formatBinary,
  formatOctal,
  parseFloat,
  formatFloatFixed,
  formatFloatDragonbox,
  formatFloatScientific
} from "../std/fmt/num_parse"

pub fn evaluateRadixParseAndFormat(): int:
  let dec = parseInt("12345").unwrap()
  let hex = parseIntRadix("ff", 16).unwrap()
  let opts = ParseIntOptions(radix = 10, strict = true, allowLeadingSign = true, allowUnderscores = true)
  let under = parseIntEx("1_000", opts).unwrap()
  let pad = formatIntPadded(7, 4, "0")
  let hx = formatHex(255, false, true)
  let bn = formatBinary(10, true, 8)
  let oc = formatOctal(8, true)
  if pad == "0007" and hx == "0xff" and bn == "0b00001010" and oc == "0o10":
    ret dec + hex + under
  ret -1

pub fn verifyFloatDragonboxAndScientific(): str:
  let parsed = parseFloat("2.5").unwrap()
  let fixed = formatFloatFixed(3.14159, 3)
  let dbox = formatFloatDragonbox(123.45)
  let sci = formatFloatScientific(1500.0, 2)
  if parsed == 2.5 and sci.contains("e+03"):
    ret fixed + ":" + dbox
  ret "ERR"

pub fn describeNumericRadixFormat(radix: int): str:
  if radix == 16:
    ret "RADIX:HEXADECIMAL_BASE16"
  if radix == 2:
    ret "RADIX:BINARY_BASE2"
  ret "RADIX:DECIMAL_BASE10"

pub fn main(): int:
  let sumParsed = evaluateRadixParseAndFormat()
  let fltStr = verifyFloatDragonboxAndScientific()
  println("Parsed Radix Sum (12345 + 0xff + 1_000): " + str(sumParsed) + " (" + describeNumericRadixFormat(16) + ")")
  println("Fixed & Dragonbox Float: " + fltStr)
  ret 0
