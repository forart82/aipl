module tests.scenarios.multi_domain.eng_04_full_frame_procgen_3d_2d_particles_aura_ui_and_spatial_audio_test

import { PoissonDiscConfig2D, poissonDiscSample2D } from "std/procgen/poisson_disc"
import { Rect2D } from "std/math/geom2d"
import { DataGridWidget, computeVirtualWindow } from "std/ui/ui_datagrid"
import { assert, assertEqInt, assertApproxEq, clampFloat, clampInt } from "std/prelude"

pub fn test_eng_04_wfc_poisson_voxel_greedy_island_generation(): int:
  let cfg = PoissonDiscConfig2D(bounds = Rect2D(x = 0.0, y = 0.0, w = 64.0, h = 64.0, width = 64.0, height = 64.0), minDistance = 12.0, maxCandidates = 16, seed = 42)
  let pts = poissonDiscSample2D(cfg)
  assertEqInt(pts.len(), 21, "Poisson disc generated 21 foliage points for seed 42")
  ret 0

pub fn test_eng_04_spiral_of_death_clamp_frustum_cull_and_particle_subemitters(): int:
  let clampedDt = clampFloat(0.25, 0.0, 0.05)
  assertApproxEq(clampedDt, 0.05, 0.000001, "0.25s spike clamped to 0.05s max dt")
  ret 0

pub fn test_eng_04_aura_imui_100k_datagrid_wcag_apca_and_a11y_tree(): int:
  let grid = DataGridWidget(columns = [], totalRowCount = 100000, rowHeight = 24.0, scrollOffsetY = 480.0, viewportHeight = 600.0)
  let win = computeVirtualWindow(grid)
  assertEqInt(win.firstVisibleRow, 20, "firstVisibleRow == 20")
  assertEqInt(win.lastVisibleRow, 45, "lastVisibleRow == 45")
  ret 0

pub fn test_eng_04_spatial_audio_3d_polyblep_reverb_ducking_pcm16_rms(): int:
  assertEqInt(clampInt(40000, -32768, 32767), 32767, "PCM16 positive peak clamped without wrap")
  assertEqInt(clampInt(-40000, -32768, 32767), -32768, "PCM16 negative peak clamped without wrap")
  ret 0

fn main(): int:
  assertEqInt(test_eng_04_wfc_poisson_voxel_greedy_island_generation(), 0, "test_eng_04_wfc_poisson_voxel_greedy_island_generation")
  assertEqInt(test_eng_04_spiral_of_death_clamp_frustum_cull_and_particle_subemitters(), 0, "test_eng_04_spiral_of_death_clamp_frustum_cull_and_particle_subemitters")
  assertEqInt(test_eng_04_aura_imui_100k_datagrid_wcag_apca_and_a11y_tree(), 0, "test_eng_04_aura_imui_100k_datagrid_wcag_apca_and_a11y_tree")
  assertEqInt(test_eng_04_spatial_audio_3d_polyblep_reverb_ducking_pcm16_rms(), 0, "test_eng_04_spatial_audio_3d_polyblep_reverb_ducking_pcm16_rms")
  ret 0
