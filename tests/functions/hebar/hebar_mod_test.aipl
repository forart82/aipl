module HebarModTest

import { assert, assertEqInt } from "../../../std/prelude.aipl"
import {
  hebarRefereeNew,
  hebarClampReactionDelayMs,
  hebarIsWithinApmLimit,
  hebarVerifyZeroTampering
} from "../../../std/hebar/hebar_mod.aipl"

pub fn test_hebar_barrel_reexports(): int:
  let refState = hebarRefereeNew(150, 250, 900)
  assertEqInt(hebarClampReactionDelayMs(50, 150, 250), 150, "clamp low reaction delay to 150ms")
  assertEqInt(hebarClampReactionDelayMs(400, 150, 250), 250, "clamp high reaction delay to 250ms")
  assert(hebarIsWithinApmLimit(10, 1000, 900) == true, "10 actions in 1000ms <= 15Hz")
  assert(hebarVerifyZeroTampering(refState, 0) == true, "zero tampering verified")
  ret 0

pub fn main(): int:
  test_hebar_barrel_reexports()
  println("PASS: hebar_mod_test")
  ret 0
