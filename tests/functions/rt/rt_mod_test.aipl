// ============================================================================
// Step 3.14: Exhaustive Per-Function Unit Tests for std/rt/rt_mod.aipl
// Target: tests/functions/rt/rt_mod_test.aipl
// ============================================================================
module RtModTest

import {
  assert,
  assertEqInt
} from "../../../std/prelude.aipl"

import {
  ptrAlloc,
  ptrFree,
  rtArenaNew,
  rtArenaFree,
  rtArrayNew,
  rtArrayFree,
  rtMapNew,
  rtCanvasNew,
  rtCanvasFree,
  rtAudioMixerNew
} from "../../../std/rt/rt_mod.aipl"

pub fn test_rt_mod_barrel(): int:
  let p = ptrAlloc(32)
  assert(p > 0, "barrel ptrAlloc")
  ptrFree(p)

  mut a = rtArenaNew(512)
  assert(a.base > 0, "barrel rtArenaNew")
  rtArenaFree(a)

  mut arr = rtArrayNew(8, 8)
  assert(arr.data > 0, "barrel rtArrayNew")
  rtArrayFree(arr)

  let m = rtMapNew(8)
  assert(m.capacity >= 8, "barrel rtMapNew")

  mut c = rtCanvasNew(16, 16)
  assert(c.pixelsPtr > 0, "barrel rtCanvasNew")
  rtCanvasFree(c)

  let mixer = rtAudioMixerNew(44100, 2)
  assertEqInt(mixer.sampleRate, 44100, "barrel rtAudioMixerNew")
  ret 0

pub fn main(): int:
  test_rt_mod_barrel()
  println("PASS: rt_mod_test")
  ret 0
