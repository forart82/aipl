pub fn test_process_ProcessOutput_contains_1(): int:
  let recv_self = ProcessOutput(status = 2, stdout = "test", stderr = "test")
  let edge_self = ProcessOutput(status = 0, stdout = "a", stderr = "a")
  let arg_sub = "test"
  let edge_sub = "a"
  let resNom = recv_self.contains(arg_sub)
  let resEdge = edge_self.contains(edge_sub)
  assert(resNom == true, "contains nominal resNom == true")
  assert(resEdge == true, "contains boundary resEdge == true")
  ret 0

