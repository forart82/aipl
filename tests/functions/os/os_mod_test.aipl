module tests.functions.os.os_mod_test

import * from "std/os/os_mod"
import { assert, assertEqStr } from "std/prelude"

pub fn test_step_9_16_barrel(): int:
  mut app = cliAppNew("demo")
  app = cliAddOption(app, "c", "config", "Config path", "", true)
  assert(cliParse(app, []).isErr() == true, "missing required CLI option rejected")
  let okParse = cliParse(app, ["--config=prod.toml"])
  assert(okParse.isOk() == true, "supplied required CLI option accepted")
  assertEqStr(cliGetStr(okParse.unwrap(), "config").unwrapOr(""), "prod.toml", "cliGetStr returns prod.toml")
  mut pb = progressBarNew(0, 10)
  let rendered = progressBarUpdate(pb, 0)
  assert(rendered.contains("0%"), "zero-total progress bar avoids div-by-zero")
  ret 0

pub fn main(): int:
  test_step_9_16_barrel()
  println("PASS: tests/functions/os/os_mod_test.aipl")
  ret 0
