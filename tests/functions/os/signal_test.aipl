pub fn test_signal_unregisterSignalHandler_3(): int:
  let arg_handler = SignalHandler(signal = 4, callbackId = 4, active = true)
  let edge_handler = SignalHandler(signal = 1, callbackId = 1, active = false)
  let resNom = unregisterSignalHandler(arg_handler)
  let resEdge = unregisterSignalHandler(edge_handler)
  assert(resNom == true, "unregisterSignalHandler nominal resNom == true")
  assert(resEdge == false, "unregisterSignalHandler boundary resEdge == false")
  ret 0

pub fn test_signal_pollSignal_4(): int:
