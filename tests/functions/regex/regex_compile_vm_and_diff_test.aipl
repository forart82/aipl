pub fn test_text_diff_parseUnifiedPatch_5(): int:
  let diffText = formatUnifiedDiff("a.txt", "b.txt", "line1\nold\nline3", "line1\nnew\nline3", 1)
  let resNom = parseUnifiedPatch(diffText)
  assert(resNom.isOk() == true, "parseUnifiedPatch nominal resNom.isOk() == true")
  let p = resNom.unwrap()
  assert(p.addedCount > 0, "parseUnifiedPatch addedCount > 0")
  assert(p.deletedCount > 0, "parseUnifiedPatch deletedCount > 0")
  let resEdge = parseUnifiedPatch("not a patch")
  assert(resEdge.isOk() == false, "parseUnifiedPatch boundary resEdge.isOk() == false")
  ret 0

pub fn test_text_diff_applyUnifiedPatch_6(): int:
  let original = "line1\nold\nline3"
  let target = "line1\nnew\nline3"
  let diffText = formatUnifiedDiff("a.txt", "b.txt", original, target, 1)
  let parsed = parseUnifiedPatch(diffText).unwrap()
  let applied = applyUnifiedPatch(original, parsed)
  assert(applied.isOk() == true, "applyUnifiedPatch nominal applied.isOk() == true")
  assertEqStr(applied.unwrap(), target, "applyUnifiedPatch nominal matches target")
  ret 0

