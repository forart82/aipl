pub fn test_regex_mod_regexIsMatch_2(): int:
  let reRes = regexCompile("^[a-z]+$")
  assert(reRes.isOk() == true, "regexCompile ok")
  let re = reRes.unwrap()
  let mTrue = regexIsMatch(re, "hello")
  let mFalse = regexIsMatch(re, "123")
  assert(mTrue == true, "regexIsMatch matching alpha string")
  assert(mFalse == false, "regexIsMatch rejecting digits string")
  ret 0

pub fn test_regex_mod_regexSplit_3(): int:
  let reRes = regexCompile(",")
  assert(reRes.isOk() == true, "regexCompile ok")
  let re = reRes.unwrap()
  let parts = regexSplit(re, "alpha,beta,gamma")
  assertEqInt(parts.len(), 3, "regexSplit returns 3 elements")
  assertEqStr(parts[0], "alpha", "regexSplit item 0")
  assertEqStr(parts[1], "beta", "regexSplit item 1")
  assertEqStr(parts[2], "gamma", "regexSplit item 2")
  let partsSingle = regexSplit(re, "single")
  assertEqInt(partsSingle.len(), 1, "regexSplit without delimiter returns 1 element")
  assertEqStr(partsSingle[0], "single", "regexSplit single item")
  ret 0

