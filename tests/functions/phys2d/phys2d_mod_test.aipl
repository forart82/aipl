module tests.functions.phys2d.phys2d_mod_test

import * from "std/phys2d/phys2d_mod"
import { Vec2 } from "std/math/vec_math"
import { assert, assertEqInt } from "std/prelude"

pub fn test_phys2d_mod_reexports(): int:
  mut bA = rigidBody2dNew(1, BodyType2D.Dynamic, Vec2(x = 0.0, y = 0.0), 0.0)
  mut bB = rigidBody2dNew(2, BodyType2D.Dynamic, Vec2(x = 3.0, y = 0.0), 0.0)
  bA.linearVelocity = Vec2(x = 1.0, y = 0.0)
  bB.linearVelocity = Vec2(x = -1.0, y = 0.0)
  let rope = Joint2D(id = 1, jointType = JointType2D.Rope, bodyIdA = 1, bodyIdB = 2, localAnchorA = Vec2(x = 0.0, y = 0.0), localAnchorB = Vec2(x = 0.0, y = 0.0), targetDistance = 5.0, springStiffness = 0.0, springDamping = 0.0, minLimit = 0.0, maxLimit = 5.0, enableLimits = true)
  jointSolvePosition(rope, bA, bB)
  assert(bB.position.x < 3.5, "slack rope joint does not push bodies apart")
  ret 0

fn main(): int:
  assertEqInt(test_phys2d_mod_reexports(), 0, "test_phys2d_mod_reexports")
  ret 0
