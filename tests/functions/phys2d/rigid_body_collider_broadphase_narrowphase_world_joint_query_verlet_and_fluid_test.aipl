  let edge_b = Rect2D(x = 0.5, y = 0.5, w = 1.0, h = 1.0, width = 1.0, height = 1.0)
  let resNom = rectsOverlap2D(arg_a, arg_b)
  let resEdge = rectsOverlap2D(edge_a, edge_b)
