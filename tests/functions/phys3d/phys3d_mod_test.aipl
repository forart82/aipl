module tests.functions.phys3d.phys3d_mod_test

import * from "std/phys3d/phys3d_mod"
import { Vec3 } from "std/math/vec_math"
import { Quat } from "std/math/quat"
import { Ray3D } from "std/math/geom3d"
import { assert, assertEqInt, assertApproxEq } from "std/prelude"

pub fn test_phys3d_mod_reexports(): int:
  mut kin = rigidBody3dNew(1, BodyType3D.Kinematic, Vec3(x = 0.0, y = 0.0, z = 0.0), Quat(x = 0.0, y = 0.0, z = 0.0, w = 1.0))
  kin.linearVelocity = Vec3(x = 2.0, y = 0.0, z = 0.0)
  rigidBody3dIntegrate(kin, Vec3(x = 0.0, y = -9.8, z = 0.0), 0.5)
  assertApproxEq(kin.position.x, 1.0, 0.001, "kinematic body integrates linear velocity")
  assertApproxEq(kin.position.y, 0.0, 0.001, "kinematic body ignores gravity")

  let zeroRay = Ray3D(origin = Vec3(x = 0.0, y = 0.0, z = 0.0), dir = Vec3(x = 0.0, y = 0.0, z = 0.0), direction = Vec3(x = 0.0, y = 0.0, z = 0.0), maxDistance = 10.0)
  assert(not raycast3dSphere(zeroRay, Vec3(x = 2.0, y = 0.0, z = 0.0), 1.0).isSome(), "zero-dir raycast3dSphere returns None")
  ret 0

fn main(): int:
  assertEqInt(test_phys3d_mod_reexports(), 0, "test_phys3d_mod_reexports")
  ret 0
