// ============================================================================
// Step 3.6: Exhaustive Per-Function Unit Tests for std/sys/sys_mod.aipl
// Target: tests/functions/sys/sys_mod_test.aipl
// ============================================================================
module SysModTest

import {
  assert,
  assertEqInt
} from "../../../std/prelude.aipl"

import {
  sysPtrAlloc,
  sysPtrFree,
  sysAudioOpenStream,
  sysAudioCloseStream,
  sysGpuInitContext,
  sysGpuDestroyContext
} from "../../../std/sys/sys_mod.aipl"

pub fn test_sys_mod_barrel(): int:
  let p = sysPtrAlloc(32)
  assert(p > 0, "barrel sysPtrAlloc")
  sysPtrFree(p)

  let a = sysAudioOpenStream(2, 44100, 256)
  assert(a > 0, "barrel sysAudioOpenStream")
  assertEqInt(sysAudioCloseStream(a), 0, "barrel sysAudioCloseStream")

  let g = sysGpuInitContext(0, 0)
  assert(g > 0, "barrel sysGpuInitContext")
  sysGpuDestroyContext(g)
  ret 0

pub fn main(): int:
  test_sys_mod_barrel()
  println("PASS: sys_mod_test")
  ret 0
