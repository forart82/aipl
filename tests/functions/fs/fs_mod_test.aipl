module tests.functions.fs.fs_mod_test

import * from "std/fs/fs_mod"
import { assert, assertEqStr } from "std/prelude"

pub fn test_step_9_9_barrel(): int:
  assertEqStr(pathParent("C:/foo"), "C:/", "Windows drive root parent of C:/foo is C:/")
  assertEqStr(pathParent("C:/"), "C:/", "Windows drive root parent of C:/ is C:/")
  assertEqStr(pathRelativeTo("/a/b", "a/b"), "a/b", "mismatched root vs relative does not return '.'")
  assertEqStr(pathRelativeTo("/a/b", "/a/c"), "../c", "same-root relative path")
  ret 0

pub fn main(): int:
  test_step_9_9_barrel()
  println("PASS: tests/functions/fs/fs_mod_test.aipl")
  ret 0
