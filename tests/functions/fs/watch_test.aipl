pub fn test_watch_fsWatcherNew_1(): int:
  let arg_debounceMs = 4
  let edge_debounceMs = 1
  let resNom = fsWatcherNew(arg_debounceMs)
  let resEdge = fsWatcherNew(edge_debounceMs)
  assertEqInt(resNom.watchedRoots.len(), 0, "fsWatcherNew nominal resNom.watchedRoots.len() == 0")
  assertEqInt(resEdge.watchedRoots.len(), 0, "fsWatcherNew boundary resEdge.watchedRoots.len() == 0")
  ret 0

pub fn test_watch_fsWatcherAddPath_2(): int:
  let arg_w = FsWatcher(watchedRoots = [], debounceWindowMs = 4, pendingEvents = [])
  let edge_w = FsWatcher(watchedRoots = [], debounceWindowMs = 1, pendingEvents = [])
  let arg_path = "/tmp/aipl_test_path"
  let edge_path = "/tmp/aipl_test_path"
  let resNom = fsWatcherAddPath(arg_w, arg_path)
  let resEdge = fsWatcherAddPath(edge_w, edge_path)
  assertEqInt(resNom.watchedRoots.len(), 1, "fsWatcherAddPath nominal resNom.watchedRoots.len() == 1")
  assertEqInt(resEdge.watchedRoots.len(), 1, "fsWatcherAddPath boundary resEdge.watchedRoots.len() == 1")
  ret 0

