pub fn test_file_textToIntBytes_1(): int:
  let arg_text = "42"
  let edge_text = "0"
  let resNom = textToIntBytes(arg_text)
  let resEdge = textToIntBytes(edge_text)
  assertEqInt(resNom.len(), 2, "textToIntBytes nominal resNom.len() == 2")
  assertEqInt(resEdge.len(), 1, "textToIntBytes boundary resEdge.len() == 1")
  ret 0

