module tests.functions.fs.metadata_test

import * from "std/fs/metadata"
import { Option, Result, Some, None, Ok, Err, assert, assertEqInt, assertEqStr, assertApproxEq } from "std/prelude"

pub fn test_metadata_fsPermsFromOctal_1(): int:
  let arg_mode = 4
  let edge_mode = 1
  let resNom = fsPermsFromOctal(arg_mode)
  let resEdge = fsPermsFromOctal(edge_mode)
  assertEqInt(resNom.modeOctal, 4, "fsPermsFromOctal nominal resNom.modeOctal == 4")
  assertEqInt(resEdge.modeOctal, 1, "fsPermsFromOctal boundary resEdge.modeOctal == 1")
  ret 0

pub fn test_metadata_fsPermsToOctal_2(): int:
  let arg_perms = FsPermissions(modeOctal = 4, readable = true, writable = true, executable = true)
  let edge_perms = FsPermissions(modeOctal = 1, readable = false, writable = false, executable = false)
  let resNom = fsPermsToOctal(arg_perms)
  let resEdge = fsPermsToOctal(edge_perms)
  assertEqInt(resNom, 4, "fsPermsToOctal nominal resNom == 4")
  assertEqInt(resEdge, 1, "fsPermsToOctal boundary resEdge == 1")
  ret 0

pub fn test_metadata_fsPermsIsReadOnly_3(): int:
  let arg_perms = FsPermissions(modeOctal = 4, readable = true, writable = true, executable = true)
  let edge_perms = FsPermissions(modeOctal = 1, readable = false, writable = false, executable = false)
  let resNom = fsPermsIsReadOnly(arg_perms)
  let resEdge = fsPermsIsReadOnly(edge_perms)
  assert(resNom == false, "fsPermsIsReadOnly nominal resNom == false")
  assert(resEdge == false, "fsPermsIsReadOnly boundary resEdge == false")
  ret 0

