pub fn test_metadata_fsMetaIsFile_7(): int:
  let arg_m = FsMetadata(path = "/tmp/aipl_test_path", nodeType = FsNodeType.RegularFile, sizeBytes = 4, permissions = FsPermissions(modeOctal = 4, readable = true, writable = true, executable = true), modifiedUnixMs = 4, createdUnixMs = 4, accessedUnixMs = 4, symlinkTarget = "test")
  let edge_m = FsMetadata(path = "/tmp/aipl_test_path", nodeType = FsNodeType.RegularFile, sizeBytes = 1, permissions = FsPermissions(modeOctal = 1, readable = false, writable = false, executable = false), modifiedUnixMs = 1, createdUnixMs = 1, accessedUnixMs = 1, symlinkTarget = "a")
  let resNom = fsMetaIsFile(arg_m)
  let resEdge = fsMetaIsFile(edge_m)
  assert(resNom == true, "fsMetaIsFile nominal resNom == true")
  assert(resEdge == true, "fsMetaIsFile boundary resEdge == true")
  ret 0

