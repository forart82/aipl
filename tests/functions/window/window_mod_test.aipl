module tests.functions.window.window_mod_test

import "std/window/window_mod"
import { setWindowMode, getWindowMode } from "std/gfx2d/shape2d"
import { assert } from "std/prelude"

pub fn test_step_10_6_barrel(): int:
  setWindowMode("x11")
  assert(getWindowMode() == "x11", "window_mod_test x11 window mode")
  setWindowMode("glx")
  assert(getWindowMode() == "glx", "window_mod_test glx window mode")
  setWindowMode("auto")
  assert(getWindowMode() == "auto", "window_mod_test auto window mode")
  ret 0

