module tests.functions.window.window_mod_test

import * from "std/window/window_mod"
import { setWindowMode, getWindowMode } from "std/gfx2d/shape2d"
import { assert, assertEqInt } from "std/prelude"

pub fn test_step_10_6_barrel(): int:
  setWindowMode("x11")
  assert(getWindowMode() == "x11", "window_mod_test x11 window mode")
  setWindowMode("glx")
  assert(getWindowMode() == "glx", "window_mod_test glx window mode")
  setWindowMode("auto")
  assert(getWindowMode() == "auto", "window_mod_test auto window mode")
  assertEqInt(scaleLogicalToPhysical(10.0, 2.0), 20, "positive DPI rounding")
  assertEqInt(scaleLogicalToPhysical(-10.0, 2.0), -20, "negative symmetric DPI rounding")
  assertEqInt(scaleLogicalToPhysical(-1.4, 1.0), -1, "negative -1.4 rounds to -1")
  let clip = setClipboardText(createClipboardState(), "hello")
  assert(hasClipboardText(clip) == true, "window_mod reexports clipboard")
  ret 0

pub fn main(): int:
  test_step_10_6_barrel()
  println("PASS: tests/functions/window/window_mod_test.aipl")
  ret 0
