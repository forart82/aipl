fn main(): int:
  assertEqInt(test_economy_ledger_resourceLedgerNew_1(), 0, "test_economy_ledger_resourceLedgerNew_1")
  assertEqInt(test_economy_ledger_ledgerDeposit_2(), 0, "test_economy_ledger_ledgerDeposit_2")
  assertEqInt(test_economy_ledger_ledgerGetBalance_3(), 0, "test_economy_ledger_ledgerGetBalance_3")
  assertEqInt(test_economy_ledger_ledgerHasFunds_4(), 0, "test_economy_ledger_ledgerHasFunds_4")
  assertEqInt(test_economy_ledger_ledgerWithdraw_5(), 0, "test_economy_ledger_ledgerWithdraw_5")
  assertEqInt(test_economy_ledger_ledgerTotalSupply_6(), 0, "test_economy_ledger_ledgerTotalSupply_6")
  assertEqInt(test_economy_ledger_ledgerTransfer_7(), 0, "test_economy_ledger_ledgerTransfer_7")
  assertEqInt(test_economy_ledger_computeTieredBracketRatePct_8(), 0, "test_economy_ledger_computeTieredBracketRatePct_8")
  assertEqInt(test_economy_ledger_computeProgressiveTaxAmount_9(), 0, "test_economy_ledger_computeProgressiveTaxAmount_9")
  assertEqInt(test_economy_ledger_computeNetAfterTax_10(), 0, "test_economy_ledger_computeNetAfterTax_10")
  assertEqInt(test_economy_ledger_computeCompoundInterest_11(), 0, "test_economy_ledger_computeCompoundInterest_11")
  assertEqInt(test_economy_ledger_computeSupplyDemandPrice_12(), 0, "test_economy_ledger_computeSupplyDemandPrice_12")
  assertEqInt(test_economy_ledger_craftingCanFulfill_13(), 0, "test_economy_ledger_craftingCanFulfill_13")
  assertEqInt(test_economy_ledger_craftingMaxBatchCount_14(), 0, "test_economy_ledger_craftingMaxBatchCount_14")
  assertEqInt(test_economy_ledger_craftingExecute_15(), 0, "test_economy_ledger_craftingExecute_15")
  assertEqInt(test_economy_ledger_computeEloRatingDelta_16(), 0, "test_economy_ledger_computeEloRatingDelta_16")
  assertEqInt(test_economy_ledger_recipeKeyCommutative2_17(), 0, "test_economy_ledger_recipeKeyCommutative2_17")
  assertEqInt(test_economy_ledger_recipeKeyCommutative3_18(), 0, "test_economy_ledger_recipeKeyCommutative3_18")
  assertEqInt(test_economy_ledger_recipeCombinatorCommutative2_19(), 0, "test_economy_ledger_recipeCombinatorCommutative2_19")
  assertEqInt(test_economy_ledger_computeItemCombineRecipeId_20(), 0, "test_economy_ledger_computeItemCombineRecipeId_20")
  assertEqInt(test_economy_ledger_recipeOutputLevel_21(), 0, "test_economy_ledger_recipeOutputLevel_21")
  assertEqInt(test_economy_ledger_rateScaledCapacityPerSec_22(), 0, "test_economy_ledger_rateScaledCapacityPerSec_22")
  assertEqInt(test_economy_ledger_forecastMonteCarloQuantile_23(), 0, "test_economy_ledger_forecastMonteCarloQuantile_23")
  assertEqInt(test_economy_ledger_computeMonteCarloPercentile_24(), 0, "test_economy_ledger_computeMonteCarloPercentile_24")
  ret 0
