pub fn test_inventory_container_inventoryCanPlaceItem2D_24(): int:
  let arg_container = InventoryContainer(width = 4, height = 4, slots = [])
  let edge_container = InventoryContainer(width = 4, height = 4, slots = [])
  let arg_itemW = 4
  let edge_itemW = 1
  let arg_itemH = 4
  let edge_itemH = 1
  let arg_startX = 1
  let edge_startX = 0
  let arg_startY = 1
  let edge_startY = 0
  let resNom = inventoryCanPlaceItem2D(arg_container, arg_itemW, arg_itemH, arg_startX, arg_startY)
  let resEdge = inventoryCanPlaceItem2D(edge_container, edge_itemW, edge_itemH, edge_startX, edge_startY)
  assert(resNom == false, "inventoryCanPlaceItem2D nominal resNom == false")
  assert(resEdge == true, "inventoryCanPlaceItem2D boundary resEdge == true")
  ret 0

pub fn test_inventory_container_inventoryPackItem2D_25(): int:
  let arg_container = InventoryContainer(width = 4, height = 4, slots = [])
  let edge_container = InventoryContainer(width = 4, height = 4, slots = [])
  let arg_itemW = 4
  let edge_itemW = 1
  let arg_itemH = 4
  let edge_itemH = 1
  let arg_itemId = 4
  let edge_itemId = 1
  let resNom = inventoryPackItem2D(arg_container, arg_itemW, arg_itemH, arg_itemId)
  let resEdge = inventoryPackItem2D(edge_container, edge_itemW, edge_itemH, edge_itemId)
  let (n_t0, n_t1, n_t2, n_t3) = resNom
  let (e_t0, e_t1, e_t2, e_t3) = resEdge
  assertEqInt(n_t0.width, 4, "inventoryPackItem2D nominal n_t0.width == 4")
  assertEqInt(e_t0.width, 4, "inventoryPackItem2D boundary e_t0.width == 4")
  ret 0

fn main(): int:
  assertEqInt(test_inventory_container_slotListNew_1(), 0, "test_inventory_container_slotListNew_1")
  assertEqInt(test_inventory_container_slotListInsert_2(), 0, "test_inventory_container_slotListInsert_2")
  assertEqInt(test_inventory_container_slotListCountTag_3(), 0, "test_inventory_container_slotListCountTag_3")
  assertEqInt(test_inventory_container_slotListRemoveQuantity_4(), 0, "test_inventory_container_slotListRemoveQuantity_4")
  assertEqInt(test_inventory_container_slotListTotalWeight_5(), 0, "test_inventory_container_slotListTotalWeight_5")
  assertEqInt(test_inventory_container_slotListFreeSlotCount_6(), 0, "test_inventory_container_slotListFreeSlotCount_6")
  assertEqInt(test_inventory_container_spatialMatrixNew_7(), 0, "test_inventory_container_spatialMatrixNew_7")
  assertEqInt(test_inventory_container_spatialMatrixCanFit_8(), 0, "test_inventory_container_spatialMatrixCanFit_8")
  assertEqInt(test_inventory_container_spatialMatrixInsert_9(), 0, "test_inventory_container_spatialMatrixInsert_9")
  assertEqInt(test_inventory_container_spatialMatrixRemoveAt_10(), 0, "test_inventory_container_spatialMatrixRemoveAt_10")
  assertEqInt(test_inventory_container_spatialMatrixOccupiedCells_11(), 0, "test_inventory_container_spatialMatrixOccupiedCells_11")
  assertEqInt(test_inventory_container_spatialMatrixTotalWeight_12(), 0, "test_inventory_container_spatialMatrixTotalWeight_12")
  assertEqInt(test_inventory_container_weightedLootTableNew_13(), 0, "test_inventory_container_weightedLootTableNew_13")
  assertEqInt(test_inventory_container_weightedLootTableRoll_14(), 0, "test_inventory_container_weightedLootTableRoll_14")
  assertEqInt(test_inventory_container_weightedLootRollQuantity_15(), 0, "test_inventory_container_weightedLootRollQuantity_15")
  assertEqInt(test_inventory_container_inventorySlotNew_16(), 0, "test_inventory_container_inventorySlotNew_16")
  assertEqInt(test_inventory_container_inventorySlotIsEmpty_17(), 0, "test_inventory_container_inventorySlotIsEmpty_17")
  assertEqInt(test_inventory_container_inventoryContainerNew_18(), 0, "test_inventory_container_inventoryContainerNew_18")
  assertEqInt(test_inventory_container_inventorySlotCanAccept_19(), 0, "test_inventory_container_inventorySlotCanAccept_19")
  assertEqInt(test_inventory_container_inventoryContainerGetSlot_20(), 0, "test_inventory_container_inventoryContainerGetSlot_20")
  assertEqInt(test_inventory_container_inventoryContainerSetSlot_21(), 0, "test_inventory_container_inventoryContainerSetSlot_21")
  assertEqInt(test_inventory_container_inventoryContainerAddItem_22(), 0, "test_inventory_container_inventoryContainerAddItem_22")
  assertEqInt(test_inventory_container_inventoryContainerCountItem_23(), 0, "test_inventory_container_inventoryContainerCountItem_23")
  assertEqInt(test_inventory_container_inventoryCanPlaceItem2D_24(), 0, "test_inventory_container_inventoryCanPlaceItem2D_24")
  assertEqInt(test_inventory_container_inventoryPackItem2D_25(), 0, "test_inventory_container_inventoryPackItem2D_25")
  ret 0
