  let edge_itemId = 1
  let arg_quantity = 4
  let edge_quantity = 1
  let resNom = inventoryContainerAddItem(arg_container, arg_itemId, arg_quantity)
  let resEdge = inventoryContainerAddItem(edge_container, edge_itemId, edge_quantity)
  let (n_t0, n_t1) = resNom
  let (e_t0, e_t1) = resEdge
