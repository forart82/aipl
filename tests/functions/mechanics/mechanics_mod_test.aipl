module tests.functions.mechanics.mechanics_mod_test

import * from "std/mechanics/mechanics_mod"
import { assert, assertEqInt, assertApproxEq } from "std/prelude"

pub fn test_mechanics_mod_reexports(): int:
  mut ledger = resourceLedgerNew()
  let _ = ledgerDeposit(ledger, "alice", 100)
  assert(ledgerTransfer(ledger, "alice", "alice", 40), "self-transfer with sufficient funds succeeds")
  assertEqInt(ledgerGetBalance(ledger, "alice"), 100, "self-transfer preserves total supply")

  mut mat = spatialMatrixNew(4, 4)
  let item = InventoryItem(id = 1, itemTag = "shield", quantity = 1, maxStack = 1, gridWidth = 2, gridHeight = 2, unitWeight = 5.0)
  assert(spatialMatrixInsert(mat, item, 0, 0), "spatialMatrixInsert places 2x2 item")
  mat = spatialMatrixRemoveAt(mat, 0, 0)
  assertApproxEq(spatialMatrixTotalWeight(mat), 0.0, 0.001, "spatialMatrixRemoveAt clears removed item weight")
  ret 0

fn main(): int:
  assertEqInt(test_mechanics_mod_reexports(), 0, "test_mechanics_mod_reexports")
  ret 0
