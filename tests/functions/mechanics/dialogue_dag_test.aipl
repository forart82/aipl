pub fn test_dialogue_dag_computeApmCounter_21(): int:
  let arg_validActions = 4
  let edge_validActions = 1
  let arg_elapsedMs = 4
  let edge_elapsedMs = 1
  let resNom = computeApmCounter(arg_validActions, arg_elapsedMs)
  let resEdge = computeApmCounter(edge_validActions, edge_elapsedMs)
  assertEqInt(resNom, 60000, "computeApmCounter nominal resNom == 60000")
  assertEqInt(resEdge, 60000, "computeApmCounter boundary resEdge == 60000")
  ret 0

pub fn test_dialogue_dag_selectZoneWithHysteresis_22(): int:
  let arg_currentZone = 4
  let edge_currentZone = 1
  let arg_entityX = 1.0
  let edge_entityX = 0.5
  let arg_entityY = 1.0
  let edge_entityY = 0.5
  let arg_zonesMinX = [0.0]
  let edge_zonesMinX = []
  let arg_zonesMinY = [0.0]
  let edge_zonesMinY = []
  let arg_zonesMaxX = [2.0]
  let edge_zonesMaxX = []
  let arg_zonesMaxY = [2.0]
  let edge_zonesMaxY = []
  let arg_margin = 1.0
  let edge_margin = 0.5
  let resNom = selectZoneWithHysteresis(arg_currentZone, arg_entityX, arg_entityY, arg_zonesMinX, arg_zonesMinY, arg_zonesMaxX, arg_zonesMaxY, arg_margin)
  let resEdge = selectZoneWithHysteresis(edge_currentZone, edge_entityX, edge_entityY, edge_zonesMinX, edge_zonesMinY, edge_zonesMaxX, edge_zonesMaxY, edge_margin)
  assertEqInt(resNom, 0, "selectZoneWithHysteresis nominal resNom == 0")
  assertEqInt(resEdge, -1, "selectZoneWithHysteresis boundary resEdge == -1")
  ret 0

fn main(): int:
  assertEqInt(test_dialogue_dag_dialogueGraphNew_1(), 0, "test_dialogue_dag_dialogueGraphNew_1")
  assertEqInt(test_dialogue_dag_dialogueAddNode_2(), 0, "test_dialogue_dag_dialogueAddNode_2")
  assertEqInt(test_dialogue_dag_dialogueNodeCount_3(), 0, "test_dialogue_dag_dialogueNodeCount_3")
  assertEqInt(test_dialogue_dag_dialogueFindNode_4(), 0, "test_dialogue_dag_dialogueFindNode_4")
  assertEqInt(test_dialogue_dag_hasFlagInSlice_5(), 0, "test_dialogue_dag_hasFlagInSlice_5")
  assertEqInt(test_dialogue_dag_dialogueGetAvailableChoices_6(), 0, "test_dialogue_dag_dialogueGetAvailableChoices_6")
  assertEqInt(test_dialogue_dag_dialogueAdvanceChoice_7(), 0, "test_dialogue_dag_dialogueAdvanceChoice_7")
  assertEqInt(test_dialogue_dag_objectiveDagNew_8(), 0, "test_dialogue_dag_objectiveDagNew_8")
  assertEqInt(test_dialogue_dag_objectiveAddPrerequisite_9(), 0, "test_dialogue_dag_objectiveAddPrerequisite_9")
  assertEqInt(test_dialogue_dag_objectiveIsUnlocked_10(), 0, "test_dialogue_dag_objectiveIsUnlocked_10")
  assertEqInt(test_dialogue_dag_objectiveComplete_11(), 0, "test_dialogue_dag_objectiveComplete_11")
  assertEqInt(test_dialogue_dag_objectiveIsCompleted_12(), 0, "test_dialogue_dag_objectiveIsCompleted_12")
  assertEqInt(test_dialogue_dag_objectiveGetPrerequisites_13(), 0, "test_dialogue_dag_objectiveGetPrerequisites_13")
  assertEqInt(test_dialogue_dag_objectiveGetAvailableTasks_14(), 0, "test_dialogue_dag_objectiveGetAvailableTasks_14")
  assertEqInt(test_dialogue_dag_objectiveCompletionRatio_15(), 0, "test_dialogue_dag_objectiveCompletionRatio_15")
  assertEqInt(test_dialogue_dag_dagCanUnlockNode_16(), 0, "test_dialogue_dag_dagCanUnlockNode_16")
  assertEqInt(test_dialogue_dag_dagAdvanceNodeRank_17(), 0, "test_dialogue_dag_dagAdvanceNodeRank_17")
  assertEqInt(test_dialogue_dag_dagCalculateTotalInvested_18(), 0, "test_dialogue_dag_dagCalculateTotalInvested_18")
  assertEqInt(test_dialogue_dag_computeSm2NextEasiness_19(), 0, "test_dialogue_dag_computeSm2NextEasiness_19")
  assertEqInt(test_dialogue_dag_computeSm2NextIntervalDays_20(), 0, "test_dialogue_dag_computeSm2NextIntervalDays_20")
  assertEqInt(test_dialogue_dag_computeApmCounter_21(), 0, "test_dialogue_dag_computeApmCounter_21")
  assertEqInt(test_dialogue_dag_selectZoneWithHysteresis_22(), 0, "test_dialogue_dag_selectZoneWithHysteresis_22")
  ret 0
