  ret 0

pub fn test_attribute_pipeline_rollAttributeRange_23(): int:
  let arg_minValue = 4
  let edge_minValue = 1
  let arg_maxValue = 4
  let edge_maxValue = 1
  let arg_rollRatio = 1.0
  let edge_rollRatio = 0.5
  let resNom = rollAttributeRange(arg_minValue, arg_maxValue, arg_rollRatio)
  let resEdge = rollAttributeRange(edge_minValue, edge_maxValue, edge_rollRatio)
  assertEqInt(resNom, 4, "rollAttributeRange nominal resNom == 4")
  assertEqInt(resEdge, 1, "rollAttributeRange boundary resEdge == 1")
  ret 0

pub fn test_attribute_pipeline_rollItemAffixBonus_24(): int:
  let arg_baseStat = 4
  let edge_baseStat = 1
  let arg_tier = 2
  let edge_tier = 0
  let arg_qualityMult = 1.0
  let edge_qualityMult = 0.5
  let resNom = rollItemAffixBonus(arg_baseStat, arg_tier, arg_qualityMult)
  let resEdge = rollItemAffixBonus(edge_baseStat, edge_tier, edge_qualityMult)
  assertEqInt(resNom, 14, "rollItemAffixBonus nominal resNom == 14")
  assertEqInt(resEdge, 6, "rollItemAffixBonus boundary resEdge == 6")
  ret 0

fn main(): int:
  assertEqInt(test_attribute_pipeline_evalStatModifierStack_1(), 0, "test_attribute_pipeline_evalStatModifierStack_1")
  assertEqInt(test_attribute_pipeline_computeFractionalCurrentHpDamage_2(), 0, "test_attribute_pipeline_computeFractionalCurrentHpDamage_2")
  assertEqInt(test_attribute_pipeline_computeDamageOverTimeTick_3(), 0, "test_attribute_pipeline_computeDamageOverTimeTick_3")
  assertEqInt(test_attribute_pipeline_computeCooldownWithReduction_4(), 0, "test_attribute_pipeline_computeCooldownWithReduction_4")
  assertEqInt(test_attribute_pipeline_computeLinearScaledCost_5(), 0, "test_attribute_pipeline_computeLinearScaledCost_5")
  assertEqInt(test_attribute_pipeline_attributePoolNew_6(), 0, "test_attribute_pipeline_attributePoolNew_6")
  assertEqInt(test_attribute_pipeline_attributePoolStepRegen_7(), 0, "test_attribute_pipeline_attributePoolStepRegen_7")
  assertEqInt(test_attribute_pipeline_attributePoolSpend_8(), 0, "test_attribute_pipeline_attributePoolSpend_8")
  assertEqInt(test_attribute_pipeline_attributePoolRestore_9(), 0, "test_attribute_pipeline_attributePoolRestore_9")
  assertEqInt(test_attribute_pipeline_attributePoolRatio_10(), 0, "test_attribute_pipeline_attributePoolRatio_10")
  assertEqInt(test_attribute_pipeline_statusEffectTickerNew_11(), 0, "test_attribute_pipeline_statusEffectTickerNew_11")
  assertEqInt(test_attribute_pipeline_statusEffectTickerStep_12(), 0, "test_attribute_pipeline_statusEffectTickerStep_12")
  assertEqInt(test_attribute_pipeline_statusEffectIsExpired_13(), 0, "test_attribute_pipeline_statusEffectIsExpired_13")
  assertEqInt(test_attribute_pipeline_stepStatModifierDurations_14(), 0, "test_attribute_pipeline_stepStatModifierDurations_14")
  assertEqInt(test_attribute_pipeline_filterStatModifiersByTag_15(), 0, "test_attribute_pipeline_filterStatModifiersByTag_15")
  assertEqInt(test_attribute_pipeline_computeArmorMitigationRatio_16(), 0, "test_attribute_pipeline_computeArmorMitigationRatio_16")
  assertEqInt(test_attribute_pipeline_applyMitigatedDamage_17(), 0, "test_attribute_pipeline_applyMitigatedDamage_17")
  assertEqInt(test_attribute_pipeline_computeCriticalStrikeMultiplier_18(), 0, "test_attribute_pipeline_computeCriticalStrikeMultiplier_18")
  assertEqInt(test_attribute_pipeline_computeDiminishingReturns_19(), 0, "test_attribute_pipeline_computeDiminishingReturns_19")
  assertEqInt(test_attribute_pipeline_computeExponentialLevelXp_20(), 0, "test_attribute_pipeline_computeExponentialLevelXp_20")
  assertEqInt(test_attribute_pipeline_computeAttributeSoftCap_21(), 0, "test_attribute_pipeline_computeAttributeSoftCap_21")
  assertEqInt(test_attribute_pipeline_rollWeightedIndex_22(), 0, "test_attribute_pipeline_rollWeightedIndex_22")
  assertEqInt(test_attribute_pipeline_rollAttributeRange_23(), 0, "test_attribute_pipeline_rollAttributeRange_23")
  assertEqInt(test_attribute_pipeline_rollItemAffixBonus_24(), 0, "test_attribute_pipeline_rollItemAffixBonus_24")
  ret 0
