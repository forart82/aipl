  let arg_weights = [2]
  let edge_weights = []
  let arg_rollVal = 2
  let edge_rollVal = 0
  let resNom = rollWeightedIndex(arg_weights, arg_rollVal)
  let resEdge = rollWeightedIndex(edge_weights, edge_rollVal)
