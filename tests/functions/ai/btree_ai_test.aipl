module tests.functions.ai.btree_ai_test

import * from "std/ai/btree_ai"
import { Option, Result, Some, None, Ok, Err, assert, assertEqInt, assertEqStr, assertApproxEq } from "std/prelude"

pub fn test_btree_ai_blackboardNew_1(): int:
  let resNom = blackboardNew()
  let resEdge = blackboardNew()
  assertEqInt(resNom.entries.len(), 0, "blackboardNew nominal resNom.entries.len() == 0")
  assertEqInt(resEdge.entries.len(), 0, "blackboardNew boundary resEdge.entries.len() == 0")
  ret 0

pub fn test_btree_ai_blackboardSet_2(): int:
  let arg_bb = Blackboard(entries = [])
  let edge_bb = Blackboard(entries = [])
  let arg_key = "test"
  let edge_key = "a"
  let arg_val = 2
  let edge_val = 0
  blackboardSet(arg_bb, arg_key, arg_val)
  blackboardSet(edge_bb, edge_key, edge_val)
  assertEqInt(arg_bb.entries.len(), 1, "blackboardSet nominal arg_bb.entries.len() == 1")
  assertEqInt(edge_bb.entries.len(), 1, "blackboardSet boundary edge_bb.entries.len() == 1")
  ret 0

pub fn test_btree_ai_blackboardGet_3(): int:
  let arg_bb = Blackboard(entries = [])
  let edge_bb = Blackboard(entries = [])
  let arg_key = "test"
  let edge_key = "a"
  let resNom = blackboardGet(arg_bb, arg_key)
  let resEdge = blackboardGet(edge_bb, edge_key)
  assert(resNom.isSome() == false, "blackboardGet nominal resNom.isSome() == false")
  assert(resEdge.isSome() == false, "blackboardGet boundary resEdge.isSome() == false")
  ret 0

pub fn test_btree_ai_btreeTickNode_4(): int:
  let arg_node = BehaviorTreeNode(id = 1, nodeType = BTreeNodeType.Sequence, children = [], cooldownSeconds = 2.0, actionName = "test")
  let edge_node = BehaviorTreeNode(id = 0, nodeType = BTreeNodeType.Sequence, children = [], cooldownSeconds = 1.0, actionName = "a")
  let arg_allNodes = [BehaviorTreeNode(id = 1, nodeType = BTreeNodeType.Sequence, children = [], cooldownSeconds = 2.0, actionName = "test")]
  let edge_allNodes = []
  let arg_bb = Blackboard(entries = [])
  let edge_bb = Blackboard(entries = [])
  let resNom = btreeTickNode(arg_node, arg_allNodes, arg_bb)
  let resEdge = btreeTickNode(edge_node, edge_allNodes, edge_bb)
  assert(resNom == BTreeNodeStatus.Success, "btreeTickNode nominal resNom == BTreeNodeStatus.Success")
  assert(resEdge == BTreeNodeStatus.Success, "btreeTickNode boundary resEdge == BTreeNodeStatus.Success")
  ret 0

pub fn test_btree_ai_blackboardHasKey_5(): int:
  let arg_bb = Blackboard(entries = [])
  let edge_bb = Blackboard(entries = [])
  let arg_key = "test"
  let edge_key = "a"
  let resNom = blackboardHasKey(arg_bb, arg_key)
  let resEdge = blackboardHasKey(edge_bb, edge_key)
  assert(resNom == false, "blackboardHasKey nominal resNom == false")
  assert(resEdge == false, "blackboardHasKey boundary resEdge == false")
  ret 0

pub fn test_btree_ai_blackboardClear_6(): int:
  let arg_bb = Blackboard(entries = [])
  let edge_bb = Blackboard(entries = [])
  let resNom = blackboardClear(arg_bb)
  let resEdge = blackboardClear(edge_bb)
  assertEqInt(resNom.entries.len(), 0, "blackboardClear nominal resNom.entries.len() == 0")
  assertEqInt(resEdge.entries.len(), 0, "blackboardClear boundary resEdge.entries.len() == 0")
  ret 0

pub fn test_btree_ai_btreeCreateSequence_7(): int:
  let arg_id = 1
  let edge_id = 0
  let arg_children = [4]
  let edge_children = []
  let resNom = btreeCreateSequence(arg_id, arg_children)
  let resEdge = btreeCreateSequence(edge_id, edge_children)
  assertEqInt(resNom.id, 1, "btreeCreateSequence nominal resNom.id == 1")
  assertEqInt(resEdge.id, 0, "btreeCreateSequence boundary resEdge.id == 0")
  ret 0

pub fn test_btree_ai_btreeCreateSelector_8(): int:
  let arg_id = 1
  let edge_id = 0
  let arg_children = [4]
  let edge_children = []
  let resNom = btreeCreateSelector(arg_id, arg_children)
  let resEdge = btreeCreateSelector(edge_id, edge_children)
  assertEqInt(resNom.id, 1, "btreeCreateSelector nominal resNom.id == 1")
  assertEqInt(resEdge.id, 0, "btreeCreateSelector boundary resEdge.id == 0")
  ret 0

pub fn test_btree_ai_btreeCreateAction_9(): int:
  let arg_id = 1
  let edge_id = 0
  let arg_actionName = "test"
  let edge_actionName = "a"
  let resNom = btreeCreateAction(arg_id, arg_actionName)
  let resEdge = btreeCreateAction(edge_id, edge_actionName)
  assertEqInt(resNom.id, 1, "btreeCreateAction nominal resNom.id == 1")
  assertEqInt(resEdge.id, 0, "btreeCreateAction boundary resEdge.id == 0")
  ret 0

pub fn test_btree_ai_btSuccess_10(): int:
  let resNom = btSuccess()
  let resEdge = btSuccess()
  assertEqInt(resNom, 1, "btSuccess nominal resNom == 1")
  assertEqInt(resEdge, 1, "btSuccess boundary resEdge == 1")
  ret 0

pub fn test_btree_ai_btFailure_11(): int:
  let resNom = btFailure()
  let resEdge = btFailure()
  assertEqInt(resNom, 0, "btFailure nominal resNom == 0")
  assertEqInt(resEdge, 0, "btFailure boundary resEdge == 0")
  ret 0

pub fn test_btree_ai_btRunning_12(): int:
  let resNom = btRunning()
  let resEdge = btRunning()
  assertEqInt(resNom, 2, "btRunning nominal resNom == 2")
  assertEqInt(resEdge, 2, "btRunning boundary resEdge == 2")
  ret 0

pub fn test_btree_ai_btInvert_13(): int:
  let arg_status = 2
  let edge_status = 0
  let resNom = btInvert(arg_status)
  let resEdge = btInvert(edge_status)
  assertEqInt(resNom, 2, "btInvert nominal resNom == 2")
  assertEqInt(resEdge, 1, "btInvert boundary resEdge == 1")
  ret 0

pub fn test_btree_ai_btSequence_14(): int:
  let arg_statuses = [2]
  let edge_statuses = []
  let resNom = btSequence(arg_statuses)
  let resEdge = btSequence(edge_statuses)
  assertEqInt(resNom, 2, "btSequence nominal resNom == 2")
  assertEqInt(resEdge, 1, "btSequence boundary resEdge == 1")
  ret 0

pub fn test_btree_ai_btSelector_15(): int:
  let arg_statuses = [2]
  let edge_statuses = []
  let resNom = btSelector(arg_statuses)
  let resEdge = btSelector(edge_statuses)
  assertEqInt(resNom, 2, "btSelector nominal resNom == 2")
  assertEqInt(resEdge, 0, "btSelector boundary resEdge == 0")
  ret 0

fn main(): int:
  assertEqInt(test_btree_ai_blackboardNew_1(), 0, "test_btree_ai_blackboardNew_1")
  assertEqInt(test_btree_ai_blackboardSet_2(), 0, "test_btree_ai_blackboardSet_2")
  assertEqInt(test_btree_ai_blackboardGet_3(), 0, "test_btree_ai_blackboardGet_3")
  assertEqInt(test_btree_ai_btreeTickNode_4(), 0, "test_btree_ai_btreeTickNode_4")
  assertEqInt(test_btree_ai_blackboardHasKey_5(), 0, "test_btree_ai_blackboardHasKey_5")
  assertEqInt(test_btree_ai_blackboardClear_6(), 0, "test_btree_ai_blackboardClear_6")
  assertEqInt(test_btree_ai_btreeCreateSequence_7(), 0, "test_btree_ai_btreeCreateSequence_7")
  assertEqInt(test_btree_ai_btreeCreateSelector_8(), 0, "test_btree_ai_btreeCreateSelector_8")
  assertEqInt(test_btree_ai_btreeCreateAction_9(), 0, "test_btree_ai_btreeCreateAction_9")
  assertEqInt(test_btree_ai_btSuccess_10(), 0, "test_btree_ai_btSuccess_10")
  assertEqInt(test_btree_ai_btFailure_11(), 0, "test_btree_ai_btFailure_11")
  assertEqInt(test_btree_ai_btRunning_12(), 0, "test_btree_ai_btRunning_12")
  assertEqInt(test_btree_ai_btInvert_13(), 0, "test_btree_ai_btInvert_13")
  assertEqInt(test_btree_ai_btSequence_14(), 0, "test_btree_ai_btSequence_14")
  assertEqInt(test_btree_ai_btSelector_15(), 0, "test_btree_ai_btSelector_15")
  ret 0
