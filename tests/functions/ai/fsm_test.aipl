module tests.functions.ai.fsm_test

import * from "std/ai/fsm"
import { Option, Result, Some, None, Ok, Err, assert, assertEqInt, assertEqStr, assertApproxEq } from "std/prelude"

pub fn test_fsm_fsmNew_1(): int:
  let arg_initialStateId = 4
  let edge_initialStateId = 1
  let resNom = fsmNew(arg_initialStateId)
  let resEdge = fsmNew(edge_initialStateId)
  assertEqInt(resNom.currentStateId, 4, "fsmNew nominal resNom.currentStateId == 4")
  assertEqInt(resEdge.currentStateId, 1, "fsmNew boundary resEdge.currentStateId == 1")
  ret 0

pub fn test_fsm_fsmAddState_2(): int:
  let arg_fsm = HierarchicalStateMachine(currentStateId = 4, states = [], transitions = [])
  let edge_fsm = HierarchicalStateMachine(currentStateId = 1, states = [], transitions = [])
  let arg_id = 1
  let edge_id = 0
  let arg_name = "test"
  let edge_name = "a"
  fsmAddState(arg_fsm, arg_id, arg_name)
  fsmAddState(edge_fsm, edge_id, edge_name)
  assertEqInt(arg_fsm.states.len(), 1, "fsmAddState nominal arg_fsm.states.len() == 1")
  assertEqInt(edge_fsm.states.len(), 1, "fsmAddState boundary edge_fsm.states.len() == 1")
  ret 0

pub fn test_fsm_fsmAddTransition_3(): int:
  let arg_fsm = HierarchicalStateMachine(currentStateId = 4, states = [], transitions = [])
  let edge_fsm = HierarchicalStateMachine(currentStateId = 1, states = [], transitions = [])
  let arg_fromId = 4
  let edge_fromId = 1
  let arg_toId = 1
  let edge_toId = 0
  let arg_event = "test"
  let edge_event = "a"
  fsmAddTransition(arg_fsm, arg_fromId, arg_toId, arg_event)
  fsmAddTransition(edge_fsm, edge_fromId, edge_toId, edge_event)
  assertEqInt(arg_fsm.transitions.len(), 1, "fsmAddTransition nominal arg_fsm.transitions.len() == 1")
  assertEqInt(edge_fsm.transitions.len(), 1, "fsmAddTransition boundary edge_fsm.transitions.len() == 1")
  ret 0

pub fn test_fsm_fsmTriggerEvent_4(): int:
  let arg_fsm = HierarchicalStateMachine(currentStateId = 4, states = [], transitions = [])
  let edge_fsm = HierarchicalStateMachine(currentStateId = 1, states = [], transitions = [])
  let arg_event = "test"
  let edge_event = "a"
  let resNom = fsmTriggerEvent(arg_fsm, arg_event)
  let resEdge = fsmTriggerEvent(edge_fsm, edge_event)
  assert(resNom == false, "fsmTriggerEvent nominal resNom == false")
  assert(resEdge == false, "fsmTriggerEvent boundary resEdge == false")
  ret 0

pub fn test_fsm_fsmCurrentStateId_5(): int:
  let arg_fsm = HierarchicalStateMachine(currentStateId = 4, states = [], transitions = [])
  let edge_fsm = HierarchicalStateMachine(currentStateId = 1, states = [], transitions = [])
  let resNom = fsmCurrentStateId(arg_fsm)
  let resEdge = fsmCurrentStateId(edge_fsm)
  assertEqInt(resNom, 4, "fsmCurrentStateId nominal resNom == 4")
  assertEqInt(resEdge, 1, "fsmCurrentStateId boundary resEdge == 1")
  ret 0

pub fn test_fsm_fsmCurrentStateName_6(): int:
  let arg_fsm = HierarchicalStateMachine(currentStateId = 4, states = [], transitions = [])
  let edge_fsm = HierarchicalStateMachine(currentStateId = 1, states = [], transitions = [])
  let resNom = fsmCurrentStateName(arg_fsm)
  let resEdge = fsmCurrentStateName(edge_fsm)
  assertEqStr(resNom, "", "fsmCurrentStateName nominal string matches")
  assertEqStr(resEdge, "", "fsmCurrentStateName boundary string matches")
  ret 0

pub fn test_fsm_fsmHasState_7(): int:
  let arg_fsm = HierarchicalStateMachine(currentStateId = 4, states = [], transitions = [])
  let edge_fsm = HierarchicalStateMachine(currentStateId = 1, states = [], transitions = [])
  let arg_stateId = 1
  let edge_stateId = 0
  let resNom = fsmHasState(arg_fsm, arg_stateId)
  let resEdge = fsmHasState(edge_fsm, edge_stateId)
  assert(resNom == false, "fsmHasState nominal resNom == false")
  assert(resEdge == false, "fsmHasState boundary resEdge == false")
  ret 0

pub fn test_fsm_fsmReset_8(): int:
  let arg_fsm = HierarchicalStateMachine(currentStateId = 4, states = [], transitions = [])
  let edge_fsm = HierarchicalStateMachine(currentStateId = 1, states = [], transitions = [])
  let arg_stateId = 1
  let edge_stateId = 0
  let resNom = fsmReset(arg_fsm, arg_stateId)
  let resEdge = fsmReset(edge_fsm, edge_stateId)
  assertEqInt(resNom.currentStateId, 1, "fsmReset nominal resNom.currentStateId == 1")
  assertEqInt(resEdge.currentStateId, 0, "fsmReset boundary resEdge.currentStateId == 0")
  ret 0

pub fn test_fsm_fsmGetValidEvents_9(): int:
  let arg_fsm = HierarchicalStateMachine(currentStateId = 4, states = [], transitions = [])
  let edge_fsm = HierarchicalStateMachine(currentStateId = 1, states = [], transitions = [])
  let resNom = fsmGetValidEvents(arg_fsm)
  let resEdge = fsmGetValidEvents(edge_fsm)
  assertEqInt(resNom.len(), 0, "fsmGetValidEvents nominal resNom.len() == 0")
  assertEqInt(resEdge.len(), 0, "fsmGetValidEvents boundary resEdge.len() == 0")
  ret 0

fn main(): int:
  assertEqInt(test_fsm_fsmNew_1(), 0, "test_fsm_fsmNew_1")
  assertEqInt(test_fsm_fsmAddState_2(), 0, "test_fsm_fsmAddState_2")
  assertEqInt(test_fsm_fsmAddTransition_3(), 0, "test_fsm_fsmAddTransition_3")
  assertEqInt(test_fsm_fsmTriggerEvent_4(), 0, "test_fsm_fsmTriggerEvent_4")
  assertEqInt(test_fsm_fsmCurrentStateId_5(), 0, "test_fsm_fsmCurrentStateId_5")
  assertEqInt(test_fsm_fsmCurrentStateName_6(), 0, "test_fsm_fsmCurrentStateName_6")
  assertEqInt(test_fsm_fsmHasState_7(), 0, "test_fsm_fsmHasState_7")
  assertEqInt(test_fsm_fsmReset_8(), 0, "test_fsm_fsmReset_8")
  assertEqInt(test_fsm_fsmGetValidEvents_9(), 0, "test_fsm_fsmGetValidEvents_9")
  ret 0
