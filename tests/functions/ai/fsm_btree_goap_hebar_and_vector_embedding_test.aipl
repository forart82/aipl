  ret 0

pub fn test_btree_ai_btreeTickNode_4(): int:
  let arg_node = BehaviorTreeNode(id = 1, nodeType = BTreeNodeType.Sequence, children = [], cooldownSeconds = 2.0, actionName = "test")
  let edge_node = BehaviorTreeNode(id = 0, nodeType = BTreeNodeType.Sequence, children = [], cooldownSeconds = 1.0, actionName = "a")
  let arg_allNodes = [BehaviorTreeNode(id = 1, nodeType = BTreeNodeType.Sequence, children = [], cooldownSeconds = 2.0, actionName = "test")]
  let edge_allNodes = []
  let arg_bb = Blackboard(entries = [])
  let edge_bb = Blackboard(entries = [])
  let resNom = btreeTickNode(arg_node, arg_allNodes, arg_bb)
  let resEdge = btreeTickNode(edge_node, edge_allNodes, edge_bb)
  assert(resNom == BTreeNodeStatus.Success, "btreeTickNode nominal resNom == BTreeNodeStatus.Success")
  assert(resEdge == BTreeNodeStatus.Success, "btreeTickNode boundary resEdge == BTreeNodeStatus.Success")
  ret 0

