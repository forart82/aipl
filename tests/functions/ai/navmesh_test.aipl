pub fn test_navmesh_navComputeNavMeshAreaCost_13(): int:
  let arg_areaWidth = 2.0
  let edge_areaWidth = 1.0
  let arg_areaHeight = 2.0
  let edge_areaHeight = 1.0
  let arg_dangerPenalty = 1.0
  let edge_dangerPenalty = 0.5
  let arg_crouchPenalty = 2.0
  let edge_crouchPenalty = 1.0
  let arg_baseDist = 1.0
  let edge_baseDist = 0.5
  let resNom = navComputeNavMeshAreaCost(arg_areaWidth, arg_areaHeight, arg_dangerPenalty, arg_crouchPenalty, arg_baseDist)
  let resEdge = navComputeNavMeshAreaCost(edge_areaWidth, edge_areaHeight, edge_dangerPenalty, edge_crouchPenalty, edge_baseDist)
  assertApproxEq(resNom, 4.25, 0.001, "navComputeNavMeshAreaCost nominal resNom ~= 4.25")
  assertApproxEq(resEdge, 2.75, 0.001, "navComputeNavMeshAreaCost boundary resEdge ~= 2.75")
  ret 0

pub fn test_navmesh_navComputePortalShortcutDist_14(): int:
  let arg_directDist = 1.0
  let edge_directDist = 0.5
  let arg_distToGateA = 1.0
  let edge_distToGateA = 0.5
  let arg_distFromGateB = 1.0
  let edge_distFromGateB = 0.5
  let arg_gateCost = 1.0
  let edge_gateCost = 0.5
  let resNom = navComputePortalShortcutDist(arg_directDist, arg_distToGateA, arg_distFromGateB, arg_gateCost)
  let resEdge = navComputePortalShortcutDist(edge_directDist, edge_distToGateA, edge_distFromGateB, edge_gateCost)
  assertApproxEq(resNom, 1.0, 0.001, "navComputePortalShortcutDist nominal resNom ~= 1.0")
  assertApproxEq(resEdge, 0.5, 0.001, "navComputePortalShortcutDist boundary resEdge ~= 0.5")
  ret 0

pub fn test_navmesh_navBuildFlowField2D_15(): int:
  let arg_width = 4
  let edge_width = 1
  let arg_height = 4
  let edge_height = 1
  let arg_costField = [2]
  let edge_costField = []
  let arg_goalX = 1
  let edge_goalX = 0
  let arg_goalY = 1
  let edge_goalY = 0
  let resNom = navBuildFlowField2D(arg_width, arg_height, arg_costField, arg_goalX, arg_goalY)
  let resEdge = navBuildFlowField2D(edge_width, edge_height, edge_costField, edge_goalX, edge_goalY)
  assertEqInt(resNom.width, 4, "navBuildFlowField2D nominal resNom.width == 4")
  assertEqInt(resEdge.width, 1, "navBuildFlowField2D boundary resEdge.width == 1")
  ret 0

pub fn test_navmesh_navSampleFlowField2D_16(): int:
  let arg_ff = CrowdFlowField2D(width = 4, height = 4, goalX = 1, goalY = 1, costField = [], integrationField = [], flowDirX = [], flowDirY = [])
  let edge_ff = CrowdFlowField2D(width = 4, height = 4, goalX = 0, goalY = 0, costField = [], integrationField = [], flowDirX = [], flowDirY = [])
  let arg_cellX = 1
  let edge_cellX = 0
  let arg_cellY = 1
  let edge_cellY = 0
  let resNom = navSampleFlowField2D(arg_ff, arg_cellX, arg_cellY)
  let resEdge = navSampleFlowField2D(edge_ff, edge_cellX, edge_cellY)
  assertEqInt(resNom.len(), 2, "navSampleFlowField2D nominal resNom.len() == 2")
  assertEqInt(resEdge.len(), 2, "navSampleFlowField2D boundary resEdge.len() == 2")
  ret 0

fn main(): int:
  assertEqInt(test_navmesh_navMeshNew_1(), 0, "test_navmesh_navMeshNew_1")
  assertEqInt(test_navmesh_findClosestPolyIndex_2(), 0, "test_navmesh_findClosestPolyIndex_2")
  assertEqInt(test_navmesh_navMeshFindPath_3(), 0, "test_navmesh_navMeshFindPath_3")
  assertEqInt(test_navmesh_navPortalsCross2D_4(), 0, "test_navmesh_navPortalsCross2D_4")
  assertEqInt(test_navmesh_navFunnelSmoothPortals_5(), 0, "test_navmesh_navFunnelSmoothPortals_5")
  assertEqInt(test_navmesh_navHeuristicOctile_6(), 0, "test_navmesh_navHeuristicOctile_6")
  assertEqInt(test_navmesh_navStepTowardTarget_7(), 0, "test_navmesh_navStepTowardTarget_7")
  assertEqInt(test_navmesh_navBresenhamLineOfSight_8(), 0, "test_navmesh_navBresenhamLineOfSight_8")
  assertEqInt(test_navmesh_navComputeBhopVelocity_9(), 0, "test_navmesh_navComputeBhopVelocity_9")
  assertEqInt(test_navmesh_navIsWithinLeashRadius_10(), 0, "test_navmesh_navIsWithinLeashRadius_10")
  assertEqInt(test_navmesh_gridComputeRadialVisibility_11(), 0, "test_navmesh_gridComputeRadialVisibility_11")
  assertEqInt(test_navmesh_rtsUpdateFogOfWarGrid_12(), 0, "test_navmesh_rtsUpdateFogOfWarGrid_12")
  assertEqInt(test_navmesh_navComputeNavMeshAreaCost_13(), 0, "test_navmesh_navComputeNavMeshAreaCost_13")
  assertEqInt(test_navmesh_navComputePortalShortcutDist_14(), 0, "test_navmesh_navComputePortalShortcutDist_14")
  assertEqInt(test_navmesh_navBuildFlowField2D_15(), 0, "test_navmesh_navBuildFlowField2D_15")
  assertEqInt(test_navmesh_navSampleFlowField2D_16(), 0, "test_navmesh_navSampleFlowField2D_16")
  ret 0
