pub fn test_steering_steerBoidsFlocking2D_5(): int:
  let arg_agentIdx = 4
  let edge_agentIdx = 1
  let arg_positions = [Vec2(x = 1.0, y = 1.0)]
  let edge_positions = []
  let arg_velocities = [Vec2(x = 1.0, y = 1.0)]
  let edge_velocities = []
  let arg_settings = BoidSettings2D(separationDistance = 1.0, alignmentDistance = 1.0, cohesionDistance = 2.0, weightSeparation = 2.0, weightAlignment = 2.0, weightCohesion = 2.0, maxSpeed = 2.0, maxForce = 2.0)
  let edge_settings = BoidSettings2D(separationDistance = 0.5, alignmentDistance = 0.5, cohesionDistance = 1.0, weightSeparation = 1.0, weightAlignment = 1.0, weightCohesion = 1.0, maxSpeed = 1.0, maxForce = 1.0)
  let resNom = steerBoidsFlocking2D(arg_agentIdx, arg_positions, arg_velocities, arg_settings)
  let resEdge = steerBoidsFlocking2D(edge_agentIdx, edge_positions, edge_velocities, edge_settings)
  assertApproxEq(resNom.angular, 0.0, 0.001, "steerBoidsFlocking2D nominal resNom.angular ~= 0.0")
  assertApproxEq(resEdge.angular, 0.0, 0.001, "steerBoidsFlocking2D boundary resEdge.angular ~= 0.0")
  ret 0

pub fn test_steering_computeRadialFormationSlot2D_6(): int:
  let arg_center = Vec2(x = 1.0, y = 1.0)
  let edge_center = Vec2(x = 0.5, y = 0.5)
  let arg_radius = 2.0
  let edge_radius = 1.0
  let arg_slotIndex = 4
  let edge_slotIndex = 1
  let arg_totalSlots = 1
  let edge_totalSlots = 0
  let resNom = computeRadialFormationSlot2D(arg_center, arg_radius, arg_slotIndex, arg_totalSlots)
  let resEdge = computeRadialFormationSlot2D(edge_center, edge_radius, edge_slotIndex, edge_totalSlots)
  assertApproxEq(resNom.x, 3.0, 0.001, "computeRadialFormationSlot2D nominal resNom.x ~= 3.0")
  assertApproxEq(resEdge.x, 1.5, 0.001, "computeRadialFormationSlot2D boundary resEdge.x ~= 1.5")
  ret 0

