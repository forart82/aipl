pub fn test_steering_navContextInjectInterest_16(): int:
  let arg_cmap = ContextMap8(interest = [], danger = [])
  let edge_cmap = ContextMap8(interest = [], danger = [])
  let arg_dirX = 1.0
  let edge_dirX = 0.5
  let arg_dirY = 1.0
  let edge_dirY = 0.5
  let arg_weight = 2.0
  let edge_weight = 1.0
  let resNom = navContextInjectInterest(arg_cmap, arg_dirX, arg_dirY, arg_weight)
  let resEdge = navContextInjectInterest(edge_cmap, edge_dirX, edge_dirY, edge_weight)
  assertEqInt(resNom.interest.len(), 0, "navContextInjectInterest nominal resNom.interest.len() == 0")
  assertEqInt(resEdge.interest.len(), 0, "navContextInjectInterest boundary resEdge.interest.len() == 0")
  ret 0

