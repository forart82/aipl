pub fn test_steering_steerPursue_11(): int:
  let arg_a = Agent2D(x = 1.0, y = 1.0, vx = 1.0, vy = 1.0, maxSpeed = 2.0, maxForce = 2.0)
  let edge_a = Agent2D(x = 0.5, y = 0.5, vx = 0.5, vy = 0.5, maxSpeed = 1.0, maxForce = 1.0)
  let arg_targetX = 1.0
  let edge_targetX = 0.5
  let arg_targetY = 1.0
  let edge_targetY = 0.5
  let arg_targetVx = 1.0
  let edge_targetVx = 0.5
  let arg_targetVy = 1.0
  let edge_targetVy = 0.5
  let arg_lookahead = 0.0
  let edge_lookahead = 0.0
  let resNom = steerPursue(arg_a, arg_targetX, arg_targetY, arg_targetVx, arg_targetVy, arg_lookahead)
  let resEdge = steerPursue(edge_a, edge_targetX, edge_targetY, edge_targetVx, edge_targetVy, edge_lookahead)
  assertEqInt(resNom.len(), 2, "steerPursue nominal resNom.len() == 2")
  assertEqInt(resEdge.len(), 2, "steerPursue boundary resEdge.len() == 2")
  ret 0

pub fn test_steering_agentStep_12(): int:
  let arg_a = Agent2D(x = 1.0, y = 1.0, vx = 1.0, vy = 1.0, maxSpeed = 2.0, maxForce = 2.0)
  let edge_a = Agent2D(x = 0.5, y = 0.5, vx = 0.5, vy = 0.5, maxSpeed = 1.0, maxForce = 1.0)
  let arg_fx = 1.0
  let edge_fx = 0.5
  let arg_fy = 1.0
  let edge_fy = 0.5
  let arg_dt = 2.0
  let edge_dt = 1.0
  let resNom = agentStep(arg_a, arg_fx, arg_fy, arg_dt)
  let resEdge = agentStep(edge_a, edge_fx, edge_fy, edge_dt)
  assertApproxEq(resNom.x, 3.82843, 0.001, "agentStep nominal resNom.x ~= 3.82843")
  assertApproxEq(resEdge.x, 1.20711, 0.001, "agentStep boundary resEdge.x ~= 1.20711")
  ret 0

