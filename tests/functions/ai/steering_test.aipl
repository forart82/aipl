pub fn test_steering_navContextResolveDirection_18(): int:
  let arg_cmap = ContextMap8(interest = [], danger = [])
  let edge_cmap = ContextMap8(interest = [], danger = [])
  let arg_dangerThreshold = 2.0
  let edge_dangerThreshold = 1.0
  let resNom = navContextResolveDirection(arg_cmap, arg_dangerThreshold)
  let resEdge = navContextResolveDirection(edge_cmap, edge_dangerThreshold)
