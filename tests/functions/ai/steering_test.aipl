pub fn test_steering_navSolveOrcaVelocity2D_19(): int:
  let arg_ax = 1.0
  let edge_ax = 0.5
  let arg_ay = 1.0
  let edge_ay = 0.5
  let arg_avx = 1.0
  let edge_avx = 0.5
  let arg_avy = 1.0
  let edge_avy = 0.5
  let arg_prefVx = 1.0
  let edge_prefVx = 0.5
  let arg_prefVy = 1.0
  let edge_prefVy = 0.5
  let arg_bx = 1.0
  let edge_bx = 0.5
  let arg_by = 1.0
  let edge_by = 0.5
  let arg_bvx = 1.0
  let edge_bvx = 0.5
  let arg_bvy = 1.0
  let edge_bvy = 0.5
  let arg_combinedRadius = 2.0
  let edge_combinedRadius = 1.0
  let arg_tau = 1.0
  let edge_tau = 0.5
  let resNom = navSolveOrcaVelocity2D(arg_ax, arg_ay, arg_avx, arg_avy, arg_prefVx, arg_prefVy, arg_bx, arg_by, arg_bvx, arg_bvy, arg_combinedRadius, arg_tau)
  let resEdge = navSolveOrcaVelocity2D(edge_ax, edge_ay, edge_avx, edge_avy, edge_prefVx, edge_prefVy, edge_bx, edge_by, edge_bvx, edge_bvy, edge_combinedRadius, edge_tau)
  assertEqInt(resNom.len(), 2, "navSolveOrcaVelocity2D nominal resNom.len() == 2")
  assertEqInt(resEdge.len(), 2, "navSolveOrcaVelocity2D boundary resEdge.len() == 2")
  ret 0

fn main(): int:
  assertEqInt(test_steering_clampVec2Mag_1(), 0, "test_steering_clampVec2Mag_1")
  assertEqInt(test_steering_steerSeek2D_2(), 0, "test_steering_steerSeek2D_2")
  assertEqInt(test_steering_steerFlee2D_3(), 0, "test_steering_steerFlee2D_3")
  assertEqInt(test_steering_steerArrive2D_4(), 0, "test_steering_steerArrive2D_4")
  assertEqInt(test_steering_steerBoidsFlocking2D_5(), 0, "test_steering_steerBoidsFlocking2D_5")
  assertEqInt(test_steering_computeRadialFormationSlot2D_6(), 0, "test_steering_computeRadialFormationSlot2D_6")
  assertEqInt(test_steering_agent2DNew_7(), 0, "test_steering_agent2DNew_7")
  assertEqInt(test_steering_steerSeek_8(), 0, "test_steering_steerSeek_8")
  assertEqInt(test_steering_steerFlee_9(), 0, "test_steering_steerFlee_9")
  assertEqInt(test_steering_steerArrive_10(), 0, "test_steering_steerArrive_10")
  assertEqInt(test_steering_steerPursue_11(), 0, "test_steering_steerPursue_11")
  assertEqInt(test_steering_agentStep_12(), 0, "test_steering_agentStep_12")
  assertEqInt(test_steering_navContextMapNew_13(), 0, "test_steering_navContextMapNew_13")
  assertEqInt(test_steering_contextBinDirX_14(), 0, "test_steering_contextBinDirX_14")
  assertEqInt(test_steering_contextBinDirY_15(), 0, "test_steering_contextBinDirY_15")
  assertEqInt(test_steering_navContextInjectInterest_16(), 0, "test_steering_navContextInjectInterest_16")
  assertEqInt(test_steering_navContextInjectDanger_17(), 0, "test_steering_navContextInjectDanger_17")
  assertEqInt(test_steering_navContextResolveDirection_18(), 0, "test_steering_navContextResolveDirection_18")
  assertEqInt(test_steering_navSolveOrcaVelocity2D_19(), 0, "test_steering_navSolveOrcaVelocity2D_19")
  ret 0
