module tests.functions.ai.steering_test

import * from "std/ai/steering"
import { TAU } from "std/math/consts"
import { sin, cos, sqrt, hypot } from "std/math/trig"
import { Vec2 } from "std/math/vec_math"
import { Option, Result, Some, None, Ok, Err, assert, assertEqInt, assertEqStr, assertApproxEq } from "std/prelude"

pub fn test_steering_clampVec2Mag_1(): int:
  let arg_v = Vec2(x = 1.0, y = 1.0)
  let edge_v = Vec2(x = 0.5, y = 0.5)
  let arg_maxLen = 2.0
  let edge_maxLen = 1.0
  let resNom = clampVec2Mag(arg_v, arg_maxLen)
  let resEdge = clampVec2Mag(edge_v, edge_maxLen)
  assertApproxEq(resNom.x, 1.0, 0.001, "clampVec2Mag nominal resNom.x ~= 1.0")
  assertApproxEq(resEdge.x, 0.5, 0.001, "clampVec2Mag boundary resEdge.x ~= 0.5")
  ret 0

pub fn test_steering_steerSeek2D_2(): int:
  let arg_pos = Vec2(x = 1.0, y = 1.0)
  let edge_pos = Vec2(x = 0.5, y = 0.5)
  let arg_currentVel = Vec2(x = 1.0, y = 1.0)
  let edge_currentVel = Vec2(x = 0.5, y = 0.5)
  let arg_target = Vec2(x = 1.0, y = 1.0)
  let edge_target = Vec2(x = 0.5, y = 0.5)
  let arg_maxSpeed = 2.0
  let edge_maxSpeed = 1.0
  let arg_maxForce = 2.0
  let edge_maxForce = 1.0
  let resNom = steerSeek2D(arg_pos, arg_currentVel, arg_target, arg_maxSpeed, arg_maxForce)
  let resEdge = steerSeek2D(edge_pos, edge_currentVel, edge_target, edge_maxSpeed, edge_maxForce)
  assertApproxEq(resNom.angular, 0.0, 0.001, "steerSeek2D nominal resNom.angular ~= 0.0")
  assertApproxEq(resEdge.angular, 0.0, 0.001, "steerSeek2D boundary resEdge.angular ~= 0.0")
  ret 0

