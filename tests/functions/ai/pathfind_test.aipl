pub fn test_pathfind_reconstructGridPath_36(): int:
  let arg_cameFrom = [4]
  let edge_cameFrom = []
  let arg_width = 4
  let edge_width = 1
  let arg_startIdx = 1
  let edge_startIdx = 0
  let arg_goalIdx = 1
  let edge_goalIdx = 0
  let resNom = reconstructGridPath(arg_cameFrom, arg_width, arg_startIdx, arg_goalIdx)
  let resEdge = reconstructGridPath(edge_cameFrom, edge_width, edge_startIdx, edge_goalIdx)
  assertEqInt(resNom.len(), 1, "reconstructGridPath nominal resNom.len() == 1")
