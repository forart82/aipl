module tests.functions.ai.ai_mod_test

import * from "std/ai/ai_mod"
import { Vec2, IVec2 } from "std/math/vec_math"
import { CellularGrid2D } from "std/procgen/cellular_automata"
import { assert, assertEqInt } from "std/prelude"

pub fn test_ai_mod_reexports(): int:
  let blockedCorner = CellularGrid2D(width = 2, height = 2, cells = [0, 1, 1, 0])
  let res = aStarPathfind(blockedCorner, IVec2(x = 0, y = 0), IVec2(x = 1, y = 1), true)
  assert(not res.found, "aStarPathfind blocks diagonal corner cutting through pinched walls")

  mut sg = spatialGridNew(10.0)
  sg = spatialGridInsert(sg, 99, -5.0, -5.0, 1.0, 1.0)
  let hits = spatialGridQuery(sg, -15.0, -15.0, 2.0, 2.0)
  assertEqInt(hits.len, 0, "negative spatialGrid cells do not alias toward zero")

  assert(not hebarIsWithinApmLimit(909, 60000, 900), "hebarIsWithinApmLimit rejects fractional APM overflow")
  ret 0

fn main(): int:
  assertEqInt(test_ai_mod_reexports(), 0, "test_ai_mod_reexports")
  ret 0
