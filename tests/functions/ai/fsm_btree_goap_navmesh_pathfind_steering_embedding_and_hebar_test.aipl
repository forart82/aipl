pub fn test_hebar_referee_hebarEnqueueAction_2(): int:
  let arg_referee = HebarReferee(minReactionDelayMs = 4, maxReactionDelayMs = 4, maxActionsPerMinute = 4, actionHistory = [], lastPopTimestampMs = 4)
  let edge_referee = HebarReferee(minReactionDelayMs = 1, maxReactionDelayMs = 1, maxActionsPerMinute = 1, actionHistory = [], lastPopTimestampMs = 1)
  let arg_action = HebarActionRecord(timestampMs = 4, actionTag = "test", targetPos = Vec2(x = 1.0, y = 1.0))
  let edge_action = HebarActionRecord(timestampMs = 1, actionTag = "a", targetPos = Vec2(x = 0.5, y = 0.5))
  let arg_currentTimestampMs = 4
  let edge_currentTimestampMs = 1
  let resNom = hebarEnqueueAction(arg_referee, arg_action, arg_currentTimestampMs)
  let resEdge = hebarEnqueueAction(edge_referee, edge_action, edge_currentTimestampMs)
  assert(resNom == true, "hebarEnqueueAction nominal resNom == true")
  assert(resEdge == true, "hebarEnqueueAction boundary resEdge == true")
  ret 0

