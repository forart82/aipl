pub fn test_hebar_referee_hebarIsWithinApmLimit_4(): int:
  let arg_actionsInWindow = 4
  let edge_actionsInWindow = 1
  let arg_windowDurationMs = 4
  let edge_windowDurationMs = 1
  let arg_maxApm = 4
