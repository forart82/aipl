module tests.functions.ai.vector_embedding_test

import * from "std/ai/vector_embedding"
import { minInt } from "std/math/consts"
import { sqrt } from "std/math/trig"
import { tensorMatmul, tensorCosineSimilarity } from "std/math/simd"
import { jsonQuery, escapeJsonString } from "std/encoding/json"
import { Map } from "std/collections/hash_map"
import { Option, Result, Some, None, Ok, Err, assert, assertEqInt, assertEqStr, assertApproxEq } from "std/prelude"

pub fn test_vector_embedding_cosineSimilarity_1(): int:
  let arg_v1 = VectorEmbedding(dims = 4, values = [])
  let edge_v1 = VectorEmbedding(dims = 1, values = [])
  let arg_v2 = VectorEmbedding(dims = 4, values = [])
  let edge_v2 = VectorEmbedding(dims = 1, values = [])
  let resNom = cosineSimilarity(arg_v1, arg_v2)
  let resEdge = cosineSimilarity(edge_v1, edge_v2)
  assertApproxEq(resNom, 0.0, 0.001, "cosineSimilarity nominal resNom ~= 0.0")
  assertApproxEq(resEdge, 0.0, 0.001, "cosineSimilarity boundary resEdge ~= 0.0")
  ret 0

pub fn test_vector_embedding_l2Distance_2(): int:
  let arg_v1 = VectorEmbedding(dims = 4, values = [])
  let edge_v1 = VectorEmbedding(dims = 1, values = [])
  let arg_v2 = VectorEmbedding(dims = 4, values = [])
  let edge_v2 = VectorEmbedding(dims = 1, values = [])
  let resNom = l2Distance(arg_v1, arg_v2)
  let resEdge = l2Distance(edge_v1, edge_v2)
  assertApproxEq(resNom, 0.0, 0.001, "l2Distance nominal resNom ~= 0.0")
  assertApproxEq(resEdge, 0.0, 0.001, "l2Distance boundary resEdge ~= 0.0")
  ret 0

pub fn test_vector_embedding_knnLinearSearch_3(): int:
  let arg_query = VectorEmbedding(dims = 4, values = [])
  let edge_query = VectorEmbedding(dims = 1, values = [])
  let arg_dataset = [VectorEmbedding(dims = 4, values = [])]
  let edge_dataset = []
  let arg_topK = 4
  let edge_topK = 1
  let resNom = knnLinearSearch(arg_query, arg_dataset, arg_topK)
  let resEdge = knnLinearSearch(edge_query, edge_dataset, edge_topK)
  assertEqInt(resNom.len(), 1, "knnLinearSearch nominal resNom.len() == 1")
  assertEqInt(resEdge.len(), 0, "knnLinearSearch boundary resEdge.len() == 0")
  ret 0

pub fn test_vector_embedding_buildGeminiRequest_4(): int:
  let arg_model = "[s]\nk=v"
  let edge_model = "[s]\nk=v"
  let arg_systemPrompt = "[s]\nk=v"
  let edge_systemPrompt = "[s]\nk=v"
  let arg_userPrompt = "[s]\nk=v"
  let edge_userPrompt = "[s]\nk=v"
  let arg_responseSchemaJson = "{\"a\":1}"
  let edge_responseSchemaJson = "{}"
  let resNom = buildGeminiRequest(arg_model, arg_systemPrompt, arg_userPrompt, arg_responseSchemaJson)
  let resEdge = buildGeminiRequest(edge_model, edge_systemPrompt, edge_userPrompt, edge_responseSchemaJson)
  assertEqInt(resNom.len(), 215, "buildGeminiRequest nominal string length == 215")
  assertEqInt(resEdge.len(), 210, "buildGeminiRequest boundary string length == 210")
  ret 0

