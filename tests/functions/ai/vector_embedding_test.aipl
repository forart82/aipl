pub fn test_vector_embedding_denseLayerForward_17(): int:
  let arg_input = [1.0]
  let edge_input = []
  let arg_weights = [2.0]
  let edge_weights = []
  let arg_bias = [1.0]
  let edge_bias = []
  let arg_inDim = 4
  let edge_inDim = 1
  let arg_outDim = 4
  let edge_outDim = 1
  let resNom = denseLayerForward(arg_input, arg_weights, arg_bias, arg_inDim, arg_outDim)
  let resEdge = denseLayerForward(edge_input, edge_weights, edge_bias, edge_inDim, edge_outDim)
  assertEqInt(resNom.len(), 4, "denseLayerForward nominal resNom.len() == 4")
  assertEqInt(resEdge.len(), 1, "denseLayerForward boundary resEdge.len() == 1")
  ret 0

fn main(): int:
  assertEqInt(test_vector_embedding_cosineSimilarity_1(), 0, "test_vector_embedding_cosineSimilarity_1")
  assertEqInt(test_vector_embedding_l2Distance_2(), 0, "test_vector_embedding_l2Distance_2")
  assertEqInt(test_vector_embedding_knnLinearSearch_3(), 0, "test_vector_embedding_knnLinearSearch_3")
  assertEqInt(test_vector_embedding_buildGeminiRequest_4(), 0, "test_vector_embedding_buildGeminiRequest_4")
  assertEqInt(test_vector_embedding_buildOpenAiRequest_5(), 0, "test_vector_embedding_buildOpenAiRequest_5")
  assertEqInt(test_vector_embedding_buildAnthropicRequest_6(), 0, "test_vector_embedding_buildAnthropicRequest_6")
  assertEqInt(test_vector_embedding_buildOllamaRequest_7(), 0, "test_vector_embedding_buildOllamaRequest_7")
  assertEqInt(test_vector_embedding_tryExtractToolCallPair_8(), 0, "test_vector_embedding_tryExtractToolCallPair_8")
  assertEqInt(test_vector_embedding_parseAiToolCall_9(), 0, "test_vector_embedding_parseAiToolCall_9")
  assertEqInt(test_vector_embedding_hasJsonKey_10(), 0, "test_vector_embedding_hasJsonKey_10")
  assertEqInt(test_vector_embedding_extractStringArrayElements_11(), 0, "test_vector_embedding_extractStringArrayElements_11")
  assertEqInt(test_vector_embedding_extractRequiredKeys_12(), 0, "test_vector_embedding_extractRequiredKeys_12")
  assertEqInt(test_vector_embedding_validateJsonAgainstSchema_13(), 0, "test_vector_embedding_validateJsonAgainstSchema_13")
  assertEqInt(test_vector_embedding_renderPromptTemplate_14(), 0, "test_vector_embedding_renderPromptTemplate_14")
  assertEqInt(test_vector_embedding_estimateTokenCount_15(), 0, "test_vector_embedding_estimateTokenCount_15")
  assertEqInt(test_vector_embedding_rankEmbeddingsByCosine_16(), 0, "test_vector_embedding_rankEmbeddingsByCosine_16")
  assertEqInt(test_vector_embedding_denseLayerForward_17(), 0, "test_vector_embedding_denseLayerForward_17")
  ret 0
