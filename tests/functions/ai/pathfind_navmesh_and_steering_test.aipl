pub fn test_navmesh_navMeshNew_1(): int:
  let arg_polygons = [NavMeshPoly2D(id = 1, vertices = [], center = Vec2(x = 1.0, y = 1.0), portals = [])]
  let edge_polygons = []
  let resNom = navMeshNew(arg_polygons)
  let resEdge = navMeshNew(edge_polygons)
  assertEqInt(resNom.polygons.len(), 1, "navMeshNew nominal resNom.polygons.len() == 1")
  assertEqInt(resEdge.polygons.len(), 0, "navMeshNew boundary resEdge.polygons.len() == 0")
  ret 0

pub fn test_navmesh_findClosestPolyIndex_2(): int:
  let arg_mesh = NavMesh2D(polygons = [])
  let edge_mesh = NavMesh2D(polygons = [])
  let arg_pt = Vec2(x = 1.0, y = 1.0)
  let edge_pt = Vec2(x = 0.5, y = 0.5)
  let resNom = findClosestPolyIndex(arg_mesh, arg_pt)
  let resEdge = findClosestPolyIndex(edge_mesh, edge_pt)
  assertEqInt(resNom, -1, "findClosestPolyIndex nominal resNom == -1")
  assertEqInt(resEdge, -1, "findClosestPolyIndex boundary resEdge == -1")
  ret 0

pub fn test_navmesh_navMeshFindPath_3(): int:
  let arg_mesh = NavMesh2D(polygons = [])
  let edge_mesh = NavMesh2D(polygons = [])
  let arg_start = Vec2(x = 1.0, y = 1.0)
  let edge_start = Vec2(x = 0.5, y = 0.5)
  let arg_goal = Vec2(x = 1.0, y = 1.0)
  let edge_goal = Vec2(x = 0.5, y = 0.5)
  let resNom = navMeshFindPath(arg_mesh, arg_start, arg_goal)
  let resEdge = navMeshFindPath(edge_mesh, edge_start, edge_goal)
  assert(resNom.isSome() == false, "navMeshFindPath nominal resNom.isSome() == false")
  assert(resEdge.isSome() == false, "navMeshFindPath boundary resEdge.isSome() == false")
  ret 0

pub fn test_navmesh_navPortalsCross2D_4(): int:
  let arg_ax = 1.0
  let edge_ax = 0.5
  let arg_ay = 1.0
  let edge_ay = 0.5
  let arg_bx = 1.0
  let edge_bx = 0.5
  let arg_by = 1.0
  let edge_by = 0.5
  let arg_cx = 1.0
  let edge_cx = 0.5
  let arg_cy = 1.0
  let edge_cy = 0.5
  let resNom = navPortalsCross2D(arg_ax, arg_ay, arg_bx, arg_by, arg_cx, arg_cy)
  let resEdge = navPortalsCross2D(edge_ax, edge_ay, edge_bx, edge_by, edge_cx, edge_cy)
  assertApproxEq(resNom, 0.0, 0.001, "navPortalsCross2D nominal resNom ~= 0.0")
  assertApproxEq(resEdge, 0.0, 0.001, "navPortalsCross2D boundary resEdge ~= 0.0")
  ret 0

