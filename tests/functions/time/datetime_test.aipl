pub fn test_datetime_rfc2822_timezone_and_validation(): int:
  let dt = unixToDateTimeUtc(1762259400, 0).toLocal(timeZoneOffsetNew(120, "+0200"))
  let formatted = formatRfc2822(dt)
  let parsed = parseRfc2822(formatted)
  assert(parsed.isOk() == true, "parseRfc2822 valid +0200")
  assertEqInt(parsed.unwrap().toUnixSeconds(), 1762259400, "RFC-2822 +0200 preserves exact UTC instant")
  assertEqStr(formatRfc2822(parsed.unwrap()), formatted, "RFC-2822 roundtrips local offset")
  assert(parseRfc2822("Wed, 31 Feb 2026 12:00:00 +0000").isOk() == false, "Feb 31 rejected")
  ret 0
