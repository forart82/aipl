  let resNom = recv_self.elapsedAt(arg_now)
  let resEdge = edge_self.elapsedAt(edge_now)
  assertEqInt(resNom.nanos, 4, "elapsedAt nominal resNom.nanos == 4")
  assertEqInt(resEdge.nanos, 1, "elapsedAt boundary resEdge.nanos == 1")
  ret 0

