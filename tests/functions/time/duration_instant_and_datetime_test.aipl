pub fn test_instant_Instant_checkedDurationSince_15(): int:
  let recv_self = Instant(nanos = 4)
  let edge_self = Instant(nanos = 1)
  let arg_earlier = Instant(nanos = 4)
  let edge_earlier = Instant(nanos = 1)
