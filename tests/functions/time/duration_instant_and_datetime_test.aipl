pub fn test_datetime_parseIso8601_30(): int:
  let validIso = "2026-11-07T21:30:00Z"
  let resNom = parseIso8601(validIso)
  assert(resNom.isOk() == true, "parseIso8601 nominal valid string returns Ok")
  let dt = resNom.unwrap()
  assertEqInt(dt.year, 2026, "parseIso8601 year")
  assertEqInt(dt.month, 11, "parseIso8601 month")
  assertEqInt(dt.day, 7, "parseIso8601 day")
  assertEqInt(dt.hour, 21, "parseIso8601 hour")
  assertEqInt(dt.minute, 30, "parseIso8601 minute")
  let resBad = parseIso8601("not-a-datetime")
  assert(resBad.isOk() == false, "parseIso8601 invalid string returns Err")
  ret 0

