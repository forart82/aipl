pub fn test_duration_parseUnsignedDigits_36(): int:
  let arg_s = "test"
  let edge_s = "a"
  let resNom = parseUnsignedDigits(arg_s)
  let resEdge = parseUnsignedDigits(edge_s)
  assert(resNom.isOk() == false, "parseUnsignedDigits nominal resNom.isOk() == false")
  assert(resEdge.isOk() == false, "parseUnsignedDigits boundary resEdge.isOk() == false")
  ret 0

pub fn test_duration_parseDuration_37(): int:
  let resNom = parseDuration("250ms")
  assert(resNom.isOk() == true, "parseDuration nominal resNom.isOk() == true")
  assertEqInt(resNom.unwrap().toMillis(), 250, "parseDuration toMillis == 250")
  let resSec = parseDuration("3s")
  assert(resSec.isOk() == true, "parseDuration 3s is Ok")
  assertEqInt(resSec.unwrap().toSeconds(), 3, "parseDuration toSeconds == 3")
  let resEdge = parseDuration("invalid")
  assert(resEdge.isOk() == false, "parseDuration boundary resEdge.isOk() == false")
  ret 0

pub fn test_duration_parseDurationMs_38(): int:
  let resNom = parseDurationMs("500ms")
  assert(resNom.isOk() == true, "parseDurationMs nominal resNom.isOk() == true")
  assertEqInt(resNom.unwrap(), 500, "parseDurationMs == 500")
  let resSec = parseDurationMs("4s")
  assert(resSec.isOk() == true, "parseDurationMs 4s is Ok")
  assertEqInt(resSec.unwrap(), 4000, "parseDurationMs == 4000")
  let resEdge = parseDurationMs("invalid")
  assert(resEdge.isOk() == false, "parseDurationMs boundary resEdge.isOk() == false")
  ret 0

