pub fn test_instant_sleepMs_3(): int:
  mut completedCalls = 0
  let arg_ms = 4
  let edge_ms = 1
  sleepMs(arg_ms)
  sleepMs(edge_ms)
  completedCalls = completedCalls + 2
  assertEqInt(completedCalls, 2, "sleepMs nominal and boundary void calls completed")
  ret 0

