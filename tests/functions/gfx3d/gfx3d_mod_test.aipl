module tests.functions.gfx3d.gfx3d_mod_test

import * from "std/gfx3d/gfx3d_mod"
import { Vec3 } from "std/math/vec_math"
import { Mat4 } from "std/math/mat"
import { assert, assertApproxEq } from "std/prelude"

pub fn test_step_11_26_barrel(): int:
  let nMat = mat3NormalFromMat4(Mat4.scaling(2.0, 1.0, 1.0))
  assertApproxEq(nMat.m00, 0.5, 0.001, "non-uniform scale normal matrix inverse-transpose m00 == 0.5")
  let mat = material3DPbr(0x222222, 0.0, 0.5, 1.0, 0x00FF00)
  let darkLight = DirectionalLight3D(direction = Vec3(x = 0.0, y = -1.0, z = 0.0), colorHex = 0xFFFFFF, intensity = 0.0)
  let lit = evaluateMaterial3DWithLight(mat, Vec3(x = 0.0, y = 1.0, z = 0.0), Vec3(x = 0.0, y = 0.0, z = 0.0), Vec3(x = 0.0, y = 0.0, z = 1.0), darkLight)
  assert(lit == 0x00FF00, "emissive material glows when directional light intensity is 0")
  ret 0

pub fn main(): int:
  test_step_11_26_barrel()
  println("PASS: tests/functions/gfx3d/gfx3d_mod_test.aipl")
  ret 0
