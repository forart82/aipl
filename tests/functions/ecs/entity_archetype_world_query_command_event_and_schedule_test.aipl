  assertEqInt(test_ecs_event_readNewEvents_4(), 0, "test_ecs_event_readNewEvents_4")
  assertEqInt(test_ecs_query_matchesQueryFilter_1(), 0, "test_ecs_query_matchesQueryFilter_1")
  assertEqInt(test_ecs_query_findMatchingArchetypes_2(), 0, "test_ecs_query_findMatchingArchetypes_2")
  assertEqInt(test_ecs_query_queryEntities_3(), 0, "test_ecs_query_queryEntities_3")
  assertEqInt(test_ecs_schedule_systemsConflict_1(), 0, "test_ecs_schedule_systemsConflict_1")
  assertEqInt(test_ecs_schedule_sortSystemsByPriority_2(), 0, "test_ecs_schedule_sortSystemsByPriority_2")
  assertEqInt(test_ecs_schedule_buildParallelBatches_3(), 0, "test_ecs_schedule_buildParallelBatches_3")
  assertEqInt(test_ecs_world_createEcsWorld_1(), 0, "test_ecs_world_createEcsWorld_1")
  assertEqInt(test_ecs_world_spawnEntity_2(), 0, "test_ecs_world_spawnEntity_2")
