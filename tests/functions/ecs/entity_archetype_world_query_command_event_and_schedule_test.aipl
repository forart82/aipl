  let resEdge = sortSystemsByPriority(edge_systems, edge_stage)
  assertEqInt(resNom.len(), 1, "sortSystemsByPriority nominal resNom.len() == 1")
  assertEqInt(resEdge.len(), 0, "sortSystemsByPriority boundary resEdge.len() == 0")
  ret 0

