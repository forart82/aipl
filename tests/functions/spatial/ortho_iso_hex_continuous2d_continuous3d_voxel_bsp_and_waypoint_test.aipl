pub fn test_voxel_chunk_world3d_voxelGetBlock_4(): int:
  mut arg_world = VoxelChunkWorld3D(chunkSize = 4, chunks = [])
  let edge_world = VoxelChunkWorld3D(chunkSize = 1, chunks = [])
  let arg_gx = 1
  let edge_gx = 0
  let arg_gy = 1
  let edge_gy = 0
  let arg_gz = 1
  let edge_gz = 0
  let resNom = voxelGetBlock(arg_world, arg_gx, arg_gy, arg_gz)
  let resEdge = voxelGetBlock(edge_world, edge_gx, edge_gy, edge_gz)
  assert(resNom.isSome() == false, "voxelGetBlock nominal resNom.isSome() == false")
  assert(resEdge.isSome() == false, "voxelGetBlock boundary resEdge.isSome() == false")
  let testBlock = VoxelBlock(blockId = 77, metadata = 2, lightLevel = 1)
  voxelSetBlock(arg_world, -5, -6, -7, testBlock)
  let got = voxelGetBlock(arg_world, -5, -6, -7)
  assert(got.isSome() == true, "voxelGetBlock retrieves block at negative coordinates")
  assertEqInt(got.unwrap().blockId, 77, "retrieved blockId matches 77")
  ret 0

pub fn test_voxel_chunk_world3d_voxelSetBlock_5(): int:
  mut arg_world = VoxelChunkWorld3D(chunkSize = 4, chunks = [])
  mut edge_world = VoxelChunkWorld3D(chunkSize = 1, chunks = [])
  let arg_gx = 1
  let edge_gx = 0
  let arg_gy = 1
  let edge_gy = 0
  let arg_gz = 1
  let edge_gz = 0
  let arg_block = VoxelBlock(blockId = 4, metadata = 4, lightLevel = 2)
  let edge_block = VoxelBlock(blockId = 1, metadata = 1, lightLevel = 0)
  let resNom = voxelSetBlock(arg_world, arg_gx, arg_gy, arg_gz, arg_block)
  let resEdge = voxelSetBlock(edge_world, edge_gx, edge_gy, edge_gz, edge_block)
  assert(resNom == true, "voxelSetBlock nominal resNom == true")
  assert(resEdge == true, "voxelSetBlock boundary resEdge == true")
  let negBlock = VoxelBlock(blockId = 99, metadata = 1, lightLevel = 5)
  let resNeg = voxelSetBlock(arg_world, -2, -1, -3, negBlock)
  assert(resNeg == true, "voxelSetBlock negative coord resNeg == true")
  let gotNeg = voxelGetBlock(arg_world, -2, -1, -3)
  assert(gotNeg.isSome() == true, "voxelGetBlock negative coord isSome == true")
  assertEqInt(gotNeg.unwrap().blockId, 99, "voxelGetBlock negative coord blockId == 99")
  ret 0

