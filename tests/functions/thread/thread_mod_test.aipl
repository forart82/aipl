module tests.functions.thread.thread_mod_test

import * from "std/thread/thread_mod"
import { assert, assertEqInt } from "std/prelude"

pub fn test_step_9_28_barrel(): int:
  mut js = jobSystemNew(2)
  let h = jobSubmit(js, 42)
  assertEqInt(h.result, 42, "jobSubmit via thread_mod barrel")
  mut zeroJs = JobSystem(workerCount: 0, workerQueues: [], dagNodes: [], completedJobs: [], stolenCount: 0, isRunning: true, nextJobId: 0)
  let zh = jobSubmitWithPriority(zeroJs, 99, 1)
  assertEqInt(zh.result, 99, "zero-worker synthetic JobSystem avoids div-by-zero & OOB")
  ret 0

pub fn main(): int:
  test_step_9_28_barrel()
  println("PASS: tests/functions/thread/thread_mod_test.aipl")
  ret 0
