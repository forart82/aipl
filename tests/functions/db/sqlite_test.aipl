  let resNom = cloneTablesList(arg_tables)
  let resEdge = cloneTablesList(edge_tables)
  assertEqInt(resNom.len(), 1, "cloneTablesList nominal resNom.len() == 1")
  assertEqInt(resEdge.len(), 0, "cloneTablesList boundary resEdge.len() == 0")
  ret 0

pub fn test_sqlite_replaceTablesInPlace_8(): int:
  let arg_target = [SqliteTable(name = "test", columns = [], rows = [])]
  let edge_target = []
  let arg_src = [SqliteTable(name = "test", columns = [], rows = [])]
  let edge_src = []
  replaceTablesInPlace(arg_target, arg_src)
  replaceTablesInPlace(edge_target, edge_src)
  assertEqInt(arg_target.len(), 1, "replaceTablesInPlace nominal arg_target.len() == 1")
  assertEqInt(edge_target.len(), 0, "replaceTablesInPlace boundary edge_target.len() == 0")
  ret 0

