pub fn test_sqlite_sqliteRollbackTo_40(): int:
  mut db = sqliteOpenInMemory()
  sqliteExec(db, "CREATE TABLE items (id INT)")
  sqliteSavepoint(db, "sp1")
  sqliteExec(db, "INSERT INTO items VALUES (1)")
  let rbRes = sqliteRollbackTo(db, "sp1")
  assert(rbRes.isOk() == true, "sqliteRollbackTo valid savepoint isOk")
  let rbBad = sqliteRollbackTo(db, "nonexistent")
  assert(rbBad.isOk() == false, "sqliteRollbackTo missing savepoint is Err")
  ret 0

pub fn test_sqlite_sqliteReleaseSavepoint_41(): int:
