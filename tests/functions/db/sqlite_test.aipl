pub fn test_sqlite_parseSqlLiteralOrParam_11(): int:
  let arg_raw = "test"
  let edge_raw = "a"
  let arg_params = [SqliteValue(kind = 4, intVal = 4, floatVal = 0.0, strVal = "test", isNull = true, blobVal = [])]
  let edge_params = []
  let arg_paramCursor = [4]
  let edge_paramCursor = []
  let resNom = parseSqlLiteralOrParam(arg_raw, arg_params, arg_paramCursor)
  let resEdge = parseSqlLiteralOrParam(edge_raw, edge_params, edge_paramCursor)
  assertEqInt(resNom.kind, 3, "parseSqlLiteralOrParam nominal resNom.kind == 3")
  assertEqInt(resEdge.kind, 3, "parseSqlLiteralOrParam boundary resEdge.kind == 3")
  ret 0

pub fn test_sqlite_sqlValueMatches_12(): int:
  let arg_a = SqliteValue(kind = 4, intVal = 4, floatVal = 0.0, strVal = "test", isNull = true, blobVal = [])
  let edge_a = SqliteValue(kind = 1, intVal = 1, floatVal = 0.0, strVal = "a", isNull = false, blobVal = [])
  let arg_b = SqliteValue(kind = 4, intVal = 4, floatVal = 0.0, strVal = "test", isNull = true, blobVal = [])
  let edge_b = SqliteValue(kind = 1, intVal = 1, floatVal = 0.0, strVal = "a", isNull = false, blobVal = [])
  let resNom = sqlValueMatches(arg_a, arg_b)
  let resEdge = sqlValueMatches(edge_a, edge_b)
  assert(resNom == true, "sqlValueMatches nominal resNom == true")
  assert(resEdge == true, "sqlValueMatches boundary resEdge == true")
  ret 0

pub fn test_sqlite_execOnTables_13(): int:
  let arg_tables = [SqliteTable(name = "test", columns = [], rows = [])]
  let edge_tables = []
  let arg_sql = "test"
  let edge_sql = "a"
  let arg_params = [SqliteValue(kind = 4, intVal = 4, floatVal = 0.0, strVal = "test", isNull = true, blobVal = [])]
  let edge_params = []
  let resNom = execOnTables(arg_tables, arg_sql, arg_params)
  let resEdge = execOnTables(edge_tables, edge_sql, edge_params)
  assert(resNom.isOk() == false, "execOnTables nominal resNom.isOk() == false")
  assert(resEdge.isOk() == false, "execOnTables boundary resEdge.isOk() == false")
  ret 0

pub fn test_sqlite_sqliteOpen_14(): int:
  let arg_path = "/tmp/aipl_test_path"
  let edge_path = "/tmp/aipl_test_path"
  let arg_config = SqliteConfig(busyTimeoutMs = 4, readOnly = true, journalMode = "test", cacheSize = 4)
  let edge_config = SqliteConfig(busyTimeoutMs = 1, readOnly = false, journalMode = "a", cacheSize = 1)
  let resNom = sqliteOpen(arg_path, arg_config)
  let resEdge = sqliteOpen(edge_path, edge_config)
  assert(resNom.isOk() == true, "sqliteOpen nominal resNom.isOk() == true")
  assert(resEdge.isOk() == true, "sqliteOpen boundary resEdge.isOk() == true")
  ret 0

pub fn test_sqlite_sqliteOpenInMemory_15(): int:
