pub fn test_sqlite_ensureParamSlot_20(): int:
  let arg_stmt = SqliteStmt(dbPath = "/tmp/aipl_test_path", sql = "test", boundParams = [], rows = [], cursorIdx = 1, finalized = true, tablesRef = [])
  let edge_stmt = SqliteStmt(dbPath = "/tmp/aipl_test_path", sql = "a", boundParams = [], rows = [], cursorIdx = 0, finalized = false, tablesRef = [])
  let arg_idx = 1
  let edge_idx = 0
  ensureParamSlot(arg_stmt, arg_idx)
  ensureParamSlot(edge_stmt, edge_idx)
  assertEqInt(arg_stmt.boundParams.len(), 1, "ensureParamSlot nominal arg_stmt.boundParams.len() == 1")
  assertEqInt(edge_stmt.boundParams.len(), 0, "ensureParamSlot boundary edge_stmt.boundParams.len() == 0")
  ret 0

