pub fn test_sqlite_cloneSqliteValue_6(): int:
  let arg_v = SqliteValue(kind = 4, intVal = 4, floatVal = 0.0, strVal = "test", isNull = true, blobVal = [])
  let edge_v = SqliteValue(kind = 1, intVal = 1, floatVal = 0.0, strVal = "a", isNull = false, blobVal = [])
  let resNom = cloneSqliteValue(arg_v)
  let resEdge = cloneSqliteValue(edge_v)
  assertEqInt(resNom.kind, 4, "cloneSqliteValue nominal resNom.kind == 4")
  assertEqInt(resEdge.kind, 1, "cloneSqliteValue boundary resEdge.kind == 1")
  ret 0

pub fn test_sqlite_cloneTablesList_7(): int:
  let arg_tables = [SqliteTable(name = "test", columns = [], rows = [])]
