module tests.functions.db.sqlite_test

import * from "std/db/sqlite"
import * from "std/prelude"
import { Option, Result, Some, None, Ok, Err, assert, assertEqInt, assertEqStr, assertApproxEq } from "std/prelude"

pub fn test_sqlite_sqlValNull_1(): int:
  let resNom = sqlValNull()
  let resEdge = sqlValNull()
  assertEqInt(resNom.kind, 0, "sqlValNull nominal resNom.kind == 0")
  assertEqInt(resEdge.kind, 0, "sqlValNull boundary resEdge.kind == 0")
  ret 0

pub fn test_sqlite_sqlValInt_2(): int:
  let arg_v = 2
  let edge_v = 0
  let resNom = sqlValInt(arg_v)
  let resEdge = sqlValInt(edge_v)
  assertEqInt(resNom.kind, 1, "sqlValInt nominal resNom.kind == 1")
  assertEqInt(resEdge.kind, 1, "sqlValInt boundary resEdge.kind == 1")
  ret 0

pub fn test_sqlite_sqlValFloat_3(): int:
  let arg_v = 1.0
