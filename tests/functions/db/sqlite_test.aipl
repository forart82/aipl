  sqliteSavepoint(db, "sp1")
  let relRes = sqliteReleaseSavepoint(db, "sp1")
  assert(relRes.isOk() == true, "sqliteReleaseSavepoint valid savepoint isOk")
  let relBad = sqliteReleaseSavepoint(db, "nonexistent")
  assert(relBad.isOk() == false, "sqliteReleaseSavepoint missing savepoint is Err")
  ret 0

