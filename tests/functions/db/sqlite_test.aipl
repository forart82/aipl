  assertEqStr(resNom.path, ":memory:", "sqliteOpenInMemory nominal string matches")
  assertEqStr(resEdge.path, ":memory:", "sqliteOpenInMemory boundary string matches")
  ret 0

pub fn test_sqlite_sqliteClose_16(): int:
  let arg_db = SqliteDb(path = "/tmp/aipl_test_path", inMemory = true, config = SqliteConfig(busyTimeoutMs = 4, readOnly = true, journalMode = "test", cacheSize = 4), tables = [], inTransaction = true, savepoints = [], isOpen = true, txSnapshot = [], spSnapshots = [])
  let edge_db = SqliteDb(path = "/tmp/aipl_test_path", inMemory = false, config = SqliteConfig(busyTimeoutMs = 1, readOnly = false, journalMode = "a", cacheSize = 1), tables = [], inTransaction = false, savepoints = [], isOpen = false, txSnapshot = [], spSnapshots = [])
  let resNom = sqliteClose(arg_db)
  let resEdge = sqliteClose(edge_db)
  assert(resNom == true, "sqliteClose nominal resNom == true")
  assert(resEdge == false, "sqliteClose boundary resEdge == false")
  ret 0

