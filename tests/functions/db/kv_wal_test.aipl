pub fn test_kv_wal_applyMemTablePut_4(): int:
  let arg_store = WalKvStore(dirPath = "/tmp/aipl_test_path", config = WalConfig(maxSegmentSizeBytes = 4, syncEveryWrite = true, autoCompactThreshold = 4), memTableKeys = [], memTableVals = [], walLog = [], isClosed = true)
  let edge_store = WalKvStore(dirPath = "/tmp/aipl_test_path", config = WalConfig(maxSegmentSizeBytes = 1, syncEveryWrite = false, autoCompactThreshold = 1), memTableKeys = [], memTableVals = [], walLog = [], isClosed = false)
  let arg_key = "test"
  let edge_key = "a"
  let arg_value = "test"
  let edge_value = "a"
  applyMemTablePut(arg_store, arg_key, arg_value)
  applyMemTablePut(edge_store, edge_key, edge_value)
  assertEqInt(arg_store.memTableKeys.len(), 1, "applyMemTablePut nominal arg_store.memTableKeys.len() == 1")
  assertEqInt(edge_store.memTableKeys.len(), 1, "applyMemTablePut boundary edge_store.memTableKeys.len() == 1")
  ret 0

pub fn test_kv_wal_applyMemTableDelete_5(): int:
  mut store = WalKvStore(dirPath = "/tmp/aipl_test_path", config = WalConfig(maxSegmentSizeBytes = 4, syncEveryWrite = true, autoCompactThreshold = 4), memTableKeys = ["k1"], memTableVals = ["v1"], walLog = [], isClosed = false)
  applyMemTableDelete(store, "k1")
  assertEqInt(store.memTableKeys.len(), 0, "applyMemTableDelete removed key")
  assertEqInt(store.memTableVals.len(), 0, "applyMemTableDelete removed val")
  ret 0

pub fn test_kv_wal_walOpen_6(): int:
  let arg_dirPath = "/tmp/aipl_test_path"
  let edge_dirPath = "/tmp/aipl_test_path"
  let arg_config = WalConfig(maxSegmentSizeBytes = 4, syncEveryWrite = true, autoCompactThreshold = 4)
  let edge_config = WalConfig(maxSegmentSizeBytes = 1, syncEveryWrite = false, autoCompactThreshold = 1)
  let resNom = walOpen(arg_dirPath, arg_config)
  let resEdge = walOpen(edge_dirPath, edge_config)
  assert(resNom.isOk() == true, "walOpen nominal resNom.isOk() == true")
  assert(resEdge.isOk() == true, "walOpen boundary resEdge.isOk() == true")
  ret 0

