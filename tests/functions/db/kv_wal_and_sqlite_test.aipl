pub fn test_sqlite_sqlRowCount_47(): int:
  let arg_tbl = SqliteTable(name = "test", columns = [], rows = [])
  let edge_tbl = SqliteTable(name = "a", columns = [], rows = [])
  let resNom = sqlRowCount(arg_tbl)
  let resEdge = sqlRowCount(edge_tbl)
  assertEqInt(resNom, 0, "sqlRowCount nominal resNom == 0")
  assertEqInt(resEdge, 0, "sqlRowCount boundary resEdge == 0")
  ret 0

pub fn test_sqlite_sqlTableNew_48(): int:
  let arg_name = "test"
  let edge_name = "a"
  let arg_cols = ["test"]
  let edge_cols = []
  let resNom = sqlTableNew(arg_name, arg_cols)
  let resEdge = sqlTableNew(edge_name, edge_cols)
  assertEqStr(resNom.name, "test", "sqlTableNew nominal string matches")
  assertEqStr(resEdge.name, "a", "sqlTableNew boundary string matches")
  ret 0

pub fn test_sqlite_sqlTableFilter_49(): int:
  let arg_tbl = SqliteTable(name = "test", columns = [], rows = [])
  let edge_tbl = SqliteTable(name = "a", columns = [], rows = [])
  let arg_colName = "test"
  let edge_colName = "a"
  let arg_expectedVal = "test"
  let edge_expectedVal = "a"
  let resNom = sqlTableFilter(arg_tbl, arg_colName, arg_expectedVal)
  let resEdge = sqlTableFilter(edge_tbl, edge_colName, edge_expectedVal)
  assertEqStr(resNom.name, "test", "sqlTableFilter nominal string matches")
  assertEqStr(resEdge.name, "a", "sqlTableFilter boundary string matches")
  ret 0

pub fn test_sqlite_sqlTableProject_50(): int:
  let arg_tbl = SqliteTable(name = "test", columns = [], rows = [])
  let edge_tbl = SqliteTable(name = "a", columns = [], rows = [])
  let arg_cols = ["test"]
  let edge_cols = []
  let resNom = sqlTableProject(arg_tbl, arg_cols)
  let resEdge = sqlTableProject(edge_tbl, edge_cols)
  assertEqStr(resNom.name, "test", "sqlTableProject nominal string matches")
  assertEqStr(resEdge.name, "a", "sqlTableProject boundary string matches")
  ret 0

pub fn test_db_mod_barrel(): int:
  let dbRes = sqliteOpenInMemory()
  assert(dbRes.isOk(), "sqliteOpenInMemory via db_mod")
  ret 0
