pub fn test_sqlite_sqlValueMatches_12(): int:
  let arg_a = SqliteValue(kind = 4, intVal = 4, floatVal = 0.0, strVal = "test", isNull = true, blobVal = [])
  let edge_a = SqliteValue(kind = 1, intVal = 1, floatVal = 0.0, strVal = "a", isNull = false, blobVal = [])
  let arg_b = SqliteValue(kind = 4, intVal = 4, floatVal = 0.0, strVal = "test", isNull = true, blobVal = [])
  let edge_b = SqliteValue(kind = 1, intVal = 1, floatVal = 0.0, strVal = "a", isNull = false, blobVal = [])
  let resNom = sqlValueMatches(arg_a, arg_b)
  let resEdge = sqlValueMatches(edge_a, edge_b)
  assert(resNom == true, "sqlValueMatches nominal resNom == true")
  assert(resEdge == true, "sqlValueMatches boundary resEdge == true")
  ret 0

pub fn test_sqlite_execOnTables_13(): int:
  let arg_tables = [SqliteTable(name = "test", columns = [], rows = [])]
  let edge_tables = []
  let arg_sql = "test"
  let edge_sql = "a"
  let arg_params = [SqliteValue(kind = 4, intVal = 4, floatVal = 0.0, strVal = "test", isNull = true, blobVal = [])]
