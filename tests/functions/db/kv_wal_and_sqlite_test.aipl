pub fn test_kv_wal_walGet_9(): int:
  let cfg = WalConfig(maxSegmentSizeBytes = 1024, syncEveryWrite = false, autoCompactThreshold = 10)
  let storeRes = walOpen("/tmp/aipl_test_wal_get", cfg)
  assert(storeRes.isOk() == true, "walOpen isOk")
  mut store = storeRes.unwrap()
  walPut(store, "key1", "val1")
  let resSome = walGet(store, "key1")
  let resNone = walGet(store, "missing")
  assert(resSome.isSome() == true, "walGet existing key isSome")
  assertEqStr(resSome.unwrap(), "val1", "walGet existing key value matches")
  assert(resNone.isSome() == false, "walGet missing key isNone")
  ret 0

pub fn test_kv_wal_walDelete_10(): int:
  let cfg = WalConfig(maxSegmentSizeBytes = 1024, syncEveryWrite = false, autoCompactThreshold = 10)
  let storeRes = walOpen("/tmp/aipl_test_wal_del", cfg)
  assert(storeRes.isOk() == true, "walOpen isOk")
  mut store = storeRes.unwrap()
  walPut(store, "delKey", "delVal")
  assert(walExists(store, "delKey") == true, "walExists before delete is true")
  let delRes = walDelete(store, "delKey")
  assert(delRes.isOk() == true, "walDelete isOk")
  assert(walExists(store, "delKey") == false, "walExists after delete is false")
  assert(walGet(store, "delKey").isSome() == false, "walGet after delete is None")
  ret 0

