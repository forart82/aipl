module tests.functions.gfx.gfx_mod_test

import * from "std/gfx/gfx_mod"
import { assert, assertEqInt } from "std/prelude"

pub fn test_step_11_3_barrel(): int:
  assertEqInt(alignOffsetStd140(5, 12), 12, "alignOffsetStd140 non-power-of-two")
  assertEqInt(alignOffsetStd140(-3, 16), 0, "alignOffsetStd140 negative clamped to 0")
  let dev = createGpuDevice()
  let fbNoDepth = createFramebuffer(dev, 64, 64, false, 1)
  let fbResized = resizeFramebuffer(dev, fbNoDepth, 128, 128)
  assert(fbResized.depthAttachment.format.isDepth == false, "hasDepth=false preserved across resize")
  ret 0

pub fn main(): int:
  test_step_11_3_barrel()
  println("PASS: tests/functions/gfx/gfx_mod_test.aipl")
  ret 0
