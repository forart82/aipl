module tests.functions.collections.btree_map_test

import * from "std/collections/btree_map"
import * from "std/prelude"
import { Option, Result, Some, None, Ok, Err, assert, assertEqInt, assertEqStr, assertApproxEq } from "std/prelude"

pub fn test_btree_map_btreeNodeNew_1(): int:
  let arg_isLeaf = true
  let edge_isLeaf = false
  let resNom = btreeNodeNew(arg_isLeaf)
  let resEdge = btreeNodeNew(edge_isLeaf)
  assert(resNom.isLeaf == true, "btreeNodeNew nominal resNom.isLeaf == true")
  assert(resEdge.isLeaf == false, "btreeNodeNew boundary resEdge.isLeaf == false")
  ret 0

pub fn test_btree_map_btreeMapNew_2(): int:
  let arg_order = 2
  let edge_order = 0
  let resNom = btreeMapNew(arg_order)
  let resEdge = btreeMapNew(edge_order)
  assertEqInt(resNom.order, 2, "btreeMapNew nominal resNom.order == 2")
  assertEqInt(resEdge.order, 2, "btreeMapNew boundary resEdge.order == 2")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__insert_3(): int:
  let mut recv_self = BTreeMap(root = None(), order = 2, count = 0)
  let mut edge_self = BTreeMap(root = None(), order = 0, count = 0)
  let arg_key = 1
  let edge_key = 0
  let arg_val = 1
  let edge_val = 0
  recv_self.insert(arg_key, arg_val)
  edge_self.insert(edge_key, edge_val)
  assertEqInt(recv_self.count, 1, "insert nominal recv_self.count == 1")
  assertEqInt(edge_self.count, 1, "insert boundary edge_self.count == 1")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__get_4(): int:
  let mut m = btreeMapNew(2)
  m.insert(10, 100)
  m.insert(20, 200)
  let hit = m.get(10)
  assert(hit.isSome() == true, "get finds key 10")
  assertEqInt(hit.unwrap(), 100, "get 10 returns 100")
  let miss = m.get(99)
  assert(miss.isSome() == false, "get 99 returns None")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__containsKey_5(): int:
  let mut m = btreeMapNew(2)
  m.insert(42, 100)
  assert(m.containsKey(42) == true, "containsKey returns true for 42")
  assert(m.containsKey(99) == false, "containsKey returns false for missing 99")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__len_6(): int:
  let mut m = btreeMapNew(2)
  assertEqInt(m.len(), 0, "len is 0 initially")
  m.insert(1, 10)
  m.insert(2, 20)
  assertEqInt(m.len(), 2, "len is 2 after two inserts")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__isEmpty_7(): int:
  let mut m = btreeMapNew(2)
  assert(m.isEmpty() == true, "isEmpty is true on new map")
  m.insert(1, 10)
  assert(m.isEmpty() == false, "isEmpty is false after insert")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__range_8(): int:
  let mut m = btreeMapNew(2)
  m.insert(10, 100)
  m.insert(20, 200)
  m.insert(30, 300)
  let items = m.range(15, 35)
  assertEqInt(items.len(), 2, "range(15, 35) returns 2 items")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__minKey_9(): int:
  let mut m = btreeMapNew(2)
  assert(m.minKey().isNone() == true, "minKey empty is None")
  m.insert(30, 3)
  m.insert(10, 1)
  m.insert(20, 2)
  assertEqInt(m.minKey().unwrap(), 10, "minKey returns smallest key 10")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__maxKey_10(): int:
  let mut m = btreeMapNew(2)
  assert(m.maxKey().isNone() == true, "maxKey empty is None")
  m.insert(30, 3)
  m.insert(10, 1)
  m.insert(20, 2)
  assertEqInt(m.maxKey().unwrap(), 30, "maxKey returns largest key 30")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__keys_11(): int:
  let mut m = btreeMapNew(2)
  m.insert(1, 10)
  m.insert(2, 20)
  let k = m.keys()
  assertEqInt(k.len(), 2, "keys len == 2")
  assertEqInt(k[0], 1, "first key == 1")
  assertEqInt(k[1], 2, "second key == 2")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__values_12(): int:
  let mut m = btreeMapNew(2)
  m.insert(1, 10)
  m.insert(2, 20)
  let v = m.values()
  assertEqInt(v.len(), 2, "values len == 2")
  assertEqInt(v[0], 10, "first value == 10")
  assertEqInt(v[1], 20, "second value == 20")
  ret 0
