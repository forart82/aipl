pub fn test_deque_Deque_T__popFront_4(): int:
  mut d = dequeNew()
  assert(d.popFront().isSome() == false, "popFront empty is None")
  d.pushBack(10)
  d.pushBack(20)
  let p = d.popFront()
  assert(p.isSome() == true, "popFront is Some")
  assertEqInt(p.unwrap(), 10, "popFront returns 10")
  assertEqInt(d.len(), 1, "len after popFront is 1")
  ret 0

pub fn test_deque_Deque_T__popBack_5(): int:
  mut d = dequeNew()
  assert(d.popBack().isSome() == false, "popBack empty is None")
  d.pushBack(10)
  d.pushBack(20)
  let p = d.popBack()
  assert(p.isSome() == true, "popBack is Some")
  assertEqInt(p.unwrap(), 20, "popBack returns 20")
