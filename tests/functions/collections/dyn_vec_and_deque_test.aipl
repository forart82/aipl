pub fn test_deque_Deque_T__peekFront_6(): int:
  mut d = dequeNew()
  assert(d.peekFront().isSome() == false, "peekFront empty is None")
  d.pushBack(42)
  let p = d.peekFront()
  assert(p.isSome() == true, "peekFront is Some")
  assertEqInt(p.unwrap(), 42, "peekFront returns 42")
  assertEqInt(d.len(), 1, "peekFront does not remove item")
  ret 0

pub fn test_deque_Deque_T__peekBack_7(): int:
  mut d = dequeNew()
  assert(d.peekBack().isSome() == false, "peekBack empty is None")
  d.pushBack(42)
  d.pushBack(84)
  let p = d.peekBack()
  assert(p.isSome() == true, "peekBack is Some")
  assertEqInt(p.unwrap(), 84, "peekBack returns 84")
  assertEqInt(d.len(), 2, "peekBack does not remove item")
  ret 0

