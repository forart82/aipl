pub fn test_btree_map_BTreeMap_K__V__insert_3(): int:
  let mut recv_self = BTreeMap(root = None(), order = 2, count = 0)
  let mut edge_self = BTreeMap(root = None(), order = 0, count = 0)
  let arg_key = 1
  let edge_key = 0
  let arg_val = 1
  let edge_val = 0
  recv_self.insert(arg_key, arg_val)
  edge_self.insert(edge_key, edge_val)
  assertEqInt(recv_self.count, 1, "insert nominal recv_self.count == 1")
  assertEqInt(edge_self.count, 1, "insert boundary edge_self.count == 1")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__get_4(): int:
  let mut m = btreeMapNew(2)
  m.insert(10, 100)
  m.insert(20, 200)
  let hit = m.get(10)
  assert(hit.isSome() == true, "get finds key 10")
  assertEqInt(hit.unwrap(), 100, "get 10 returns 100")
  let miss = m.get(99)
  assert(miss.isSome() == false, "get 99 returns None")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__containsKey_5(): int:
  let mut m = btreeMapNew(2)
  m.insert(42, 100)
  assert(m.containsKey(42) == true, "containsKey returns true for 42")
  assert(m.containsKey(99) == false, "containsKey returns false for missing 99")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__len_6(): int:
  let mut m = btreeMapNew(2)
  assertEqInt(m.len(), 0, "len is 0 initially")
  m.insert(1, 10)
  m.insert(2, 20)
  assertEqInt(m.len(), 2, "len is 2 after two inserts")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__isEmpty_7(): int:
  let mut m = btreeMapNew(2)
  assert(m.isEmpty() == true, "isEmpty is true on new map")
  m.insert(1, 10)
  assert(m.isEmpty() == false, "isEmpty is false after insert")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__range_8(): int:
