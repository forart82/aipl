  let items = m.range(15, 35)
  assertEqInt(items.len(), 2, "range(15, 35) returns 2 items")
  ret 0

pub fn test_btree_map_BTreeMap_K__V__minKey_9(): int:
  let mut m = btreeMapNew(2)
  assert(m.minKey().isNone() == true, "minKey empty is None")
  m.insert(30, 3)
  m.insert(10, 1)
  m.insert(20, 2)
  assertEqInt(m.minKey().unwrap(), 10, "minKey returns smallest key 10")
  ret 0

