pub fn test_audio_dsp_processBiquadSample_3(): int:
  let arg_filter = BiquadFilter(filterType = 1, b0 = 1.0, b1 = 1.0, b2 = 1.0, a1 = 1.0, a2 = 1.0, x1 = 1.0, x2 = 1.0, y1 = 1.0, y2 = 1.0)
