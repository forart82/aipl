module tests.functions.audio.audio_mod_test

import * from "std/audio/audio_mod"
import { assert } from "std/prelude"

pub fn test_step_10_25_barrel(): int:
  let envVal = evalAdsrEnvelope(0.06, 0.1, 0.1, 0.5, 0.2, 0.05)
  assert(envVal > 0.0 and envVal < 0.51, "early note-off decays from attack level")
  let lpf = createBiquadLowPass(8000.0, 20000.0, 0.7071)
  assert(lpf.b0 == lpf.b0, "Nyquist-clamped biquad finite")
  ret 0

pub fn main(): int:
  test_step_10_25_barrel()
  println("PASS: tests/functions/audio/audio_mod_test.aipl")
  ret 0
