pub fn test_stdio_stdioPrint_4(): int:
  let arg_text = "42"
  let edge_text = "0"
  let resNom = stdioPrint(arg_text)
  let resEdge = stdioPrint(edge_text)
  assertEqInt(resNom, 2, "stdioPrint nominal resNom == 2")
  assertEqInt(resEdge, 1, "stdioPrint boundary resEdge == 1")
  ret 0

pub fn test_stdio_stdioPrintln_5(): int:
