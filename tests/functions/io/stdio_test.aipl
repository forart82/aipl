pub fn test_stdio_stdioFlush_10(): int:
  let arg_handle = StdioHandle(fd = 1, isTty = true, buffer = [])
  let edge_handle = StdioHandle(fd = 0, isTty = false, buffer = [])
  let resNom = stdioFlush(arg_handle)
  let resEdge = stdioFlush(edge_handle)
  assert(resNom == true, "stdioFlush nominal resNom == true")
  assert(resEdge == true, "stdioFlush boundary resEdge == true")
  ret 0

