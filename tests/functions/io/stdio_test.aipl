module tests.functions.io.stdio_test

import * from "std/io/io_traits"
import * from "std/io/stdio"
import { Option, Result, Some, None, Ok, Err, assert, assertEqInt, assertEqStr, assertApproxEq } from "std/prelude"

pub fn test_stdio_stdioStdin_1(): int:
  let resNom = stdioStdin()
  let resEdge = stdioStdin()
  assertEqInt(resNom.fd, 0, "stdioStdin nominal resNom.fd == 0")
  assertEqInt(resEdge.fd, 0, "stdioStdin boundary resEdge.fd == 0")
  ret 0

pub fn test_stdio_stdioStdout_2(): int:
  let resNom = stdioStdout()
  let resEdge = stdioStdout()
  assertEqInt(resNom.fd, 1, "stdioStdout nominal resNom.fd == 1")
  assertEqInt(resEdge.fd, 1, "stdioStdout boundary resEdge.fd == 1")
  ret 0

