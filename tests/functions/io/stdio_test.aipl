pub fn test_stdio_stdioWriteBytes_8(): int:
  let arg_handle = StdioHandle(fd = 1, isTty = true, buffer = [])
  let edge_handle = StdioHandle(fd = 0, isTty = false, buffer = [])
  let arg_data = [2]
  let edge_data = []
  let resNom = stdioWriteBytes(arg_handle, arg_data)
  let resEdge = stdioWriteBytes(edge_handle, edge_data)
  assertEqInt(resNom, 1, "stdioWriteBytes nominal resNom == 1")
  assertEqInt(resEdge, 0, "stdioWriteBytes boundary resEdge == 0")
  ret 0

pub fn test_stdio_stdioReadLineMock_9(): int:
  let arg_handle = StdioHandle(fd = 1, isTty = true, buffer = [])
  let edge_handle = StdioHandle(fd = 0, isTty = false, buffer = [])
  let resNom = stdioReadLineMock(arg_handle)
  let resEdge = stdioReadLineMock(edge_handle)
  assert(resNom.isSome() == false, "stdioReadLineMock nominal resNom.isSome() == false")
  assert(resEdge.isSome() == false, "stdioReadLineMock boundary resEdge.isSome() == false")
