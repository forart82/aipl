module tests.functions.io.io_mod_test

import * from "std/io/io_mod"
import { assert, assertEqInt } from "std/prelude"

pub fn test_step_9_4_barrel(): int:
  mut cur = cursorNew([10, 20, 30])
  let bRes = cursorReadByte(cur)
  assert(bRes.isOk() == true, "cursorReadByte via io_mod barrel")
  assertEqInt(bRes.unwrap(), 10, "first byte == 10")
  cur.pos = 5
  cur = cursorWriteByte(cur, 99)
  assertEqInt(cur.buf.len(), 6, "sparse cursorWriteByte pads intermediate bytes safely")
  assertEqInt(cur.buf[5], 99, "written byte at pos 5 == 99")
  ret 0

pub fn main(): int:
  test_step_9_4_barrel()
  println("PASS: tests/functions/io/io_mod_test.aipl")
  ret 0
