pub fn test_io_traits_ioErrNew_1(): int:
  let arg_kind = IoErrorKind.NotFound
  let edge_kind = IoErrorKind.NotFound
  let arg_message = "test"
  let edge_message = "a"
  let resNom = ioErrNew(arg_kind, arg_message)
  let resEdge = ioErrNew(edge_kind, edge_message)
  assertEqStr(resNom.message, "test", "ioErrNew nominal string matches")
  assertEqStr(resEdge.message, "a", "ioErrNew boundary string matches")
  ret 0

