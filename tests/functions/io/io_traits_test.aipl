pub fn test_io_traits_ioErrToString_6(): int:
  let arg_err = IoError(kind = IoErrorKind.NotFound, message = "test", code = 2)
  let edge_err = IoError(kind = IoErrorKind.NotFound, message = "a", code = 0)
  let resNom = ioErrToString(arg_err)
  let resEdge = ioErrToString(edge_err)
  assertEqStr(resNom, "IoError(NotFound, code=2): test", "ioErrToString nominal string matches")
  assertEqStr(resEdge, "IoError(NotFound, code=0): a", "ioErrToString boundary string matches")
  ret 0

pub fn test_io_traits_ioSeekResolve_7(): int:
  let arg_currentPos = 4
  let edge_currentPos = 1
  let arg_totalLen = 4
  let edge_totalLen = 1
  let arg_from = SeekFrom.Start(4)
  let edge_from = SeekFrom.Start(1)
  let resNom = ioSeekResolve(arg_currentPos, arg_totalLen, arg_from)
  let resEdge = ioSeekResolve(edge_currentPos, edge_totalLen, edge_from)
  assert(resNom.isOk() == true, "ioSeekResolve nominal resNom.isOk() == true")
  assert(resEdge.isOk() == true, "ioSeekResolve boundary resEdge.isOk() == true")
  ret 0

