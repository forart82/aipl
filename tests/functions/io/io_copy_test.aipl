pub fn test_io_copy_ioCopyCursor_1(): int:
  let arg_src = ByteCursor(buf = [], pos = 0, limit = 4)
  let edge_src = ByteCursor(buf = [], pos = 0, limit = 4)
  let arg_dst = ByteCursor(buf = [], pos = 0, limit = 4)
  let edge_dst = ByteCursor(buf = [], pos = 0, limit = 4)
  let arg_chunkSize = 4
  let edge_chunkSize = 1
  let resNom = ioCopyCursor(arg_src, arg_dst, arg_chunkSize)
  let resEdge = ioCopyCursor(edge_src, edge_dst, edge_chunkSize)
  assertEqInt(resNom, 4, "ioCopyCursor nominal resNom == 4")
  assertEqInt(resEdge, 4, "ioCopyCursor boundary resEdge == 4")
  ret 0

