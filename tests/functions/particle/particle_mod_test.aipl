module tests.functions.particle.particle_mod_test

import * from "std/particle/particle_mod"
import { Vec3 } from "std/math/vec_math"
import { rgba8 } from "std/gfx/color"
import { assert } from "std/prelude"

pub fn test_step_11_39_barrel(): int:
  mut pool = createParticlePool3D(8)
  pool.particles.push(Particle3D(pos = Vec3(x = 1.0, y = 0.0, z = 0.0), vel = Vec3(x = 0.0, y = 0.0, z = 0.0), color = rgba8(255, 255, 255, 255), size = 1.0, ageSec = 0.0, lifetimeSec = 2.0, isAlive = true))
  let attr = ParticleAffector(affectorType = AFFECTOR_POINT_ATTRACTOR, strength = 10.0, center = Vec3(x = 5.0, y = 0.0, z = 0.0), direction = Vec3(x = 0.0, y = 0.0, z = 0.0), falloffDistance = 100.0, frequency = 1.0)
  let stepped = stepParticlePool3D(pool, 0.1, [attr])
  assert(stepped.particles[0].vel.x > 0.0, "point attractor pulls particle toward +X")
  ret 0

pub fn main(): int:
  test_step_11_39_barrel()
  println("PASS: tests/functions/particle/particle_mod_test.aipl")
  ret 0
