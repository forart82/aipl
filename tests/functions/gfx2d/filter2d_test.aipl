pub fn test_filter2d_drawVignetteOverlay_37(): int:
  mut completedCalls = 0
  let arg_viewW = 2.0
  let edge_viewW = 1.0
  let arg_viewH = 2.0
  let edge_viewH = 1.0
  let arg_thickness = 2.0
  let edge_thickness = 1.0
  let arg_maxAlpha = 2.0
  let edge_maxAlpha = 1.0
