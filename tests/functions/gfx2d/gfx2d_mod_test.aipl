module tests.functions.gfx2d.gfx2d_mod_test

import * from "std/gfx2d/gfx2d_mod"
import { assert, assertEqInt, assertApproxEq } from "std/prelude"

pub fn test_step_11_14_barrel(): int:
  let cam = createCamera2D(800.0, 600.0, 1.0)
  assertApproxEq(cam.x, 0.0, 0.001, "createCamera2D x initialized to 0.0")
  assertApproxEq(cam.y, 0.0, 0.001, "createCamera2D y initialized to 0.0")
  let wang = createWangBlob47Autotiler()
  assertEqInt(wang.transitionTable[255], 46, "Wang47 full mask -> 46")
  assertEqInt(wang.transitionTable[1], 1, "Wang47 N mask -> canonical index 1")
  ret 0

pub fn main(): int:
  test_step_11_14_barrel()
  println("PASS: tests/functions/gfx2d/gfx2d_mod_test.aipl")
  ret 0
