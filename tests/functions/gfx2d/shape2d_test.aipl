pub fn test_shape2d_getWindowMode_175(): int:
  setWindowMode("x11")
  let resNom = getWindowMode()
  setWindowMode("glx")
  let resEdge = getWindowMode()
  assertEqStr(resNom, "x11", "getWindowMode nominal x11")
  assertEqStr(resEdge, "glx", "getWindowMode boundary glx")
  setWindowMode("x11")
  clearScreen(rgb(0, 0, 0))
  drawEllipse(40.0, 40.0, 12.0, 8.0, rgb(255, 0, 0))
  assertEqInt(getPixel(40, 40), (255 << 24) | (0 << 16) | (0 << 8) | 255, "getPixel BGRA->RGBA exact red channel")
  drawTriangle(10.0, 10.0, 30.0, 10.0, 20.0, 30.0, rgb(0, 255, 0))
  assertEqInt(getPixel(20, 18), (0 << 24) | (255 << 16) | (0 << 8) | 255, "getPixel BGRA->RGBA exact green channel")
  drawCircleOutline(60.0, 60.0, 10.0, 3.0, rgb(0, 0, 255))
  assertEqInt(getPixel(70, 60), (0 << 24) | (0 << 16) | (255 << 8) | 255, "getPixel BGRA->RGBA exact blue channel")
  ret 0

pub fn test_shape2d_depth_and_gouraud_176(): int:
  setDepthTest(true)
  clearDepth()
  beginWorldPass()
  setUiTracking(false)
  clearScreen(rgb(0, 0, 0))
  drawTriangleGouraud(10.0, 10.0, 50.0, 10.0, 30.0, 50.0, rgb(255, 0, 0), rgb(0, 255, 0), rgb(0, 0, 255))
  let pGouraud = getPixel(30, 25)
  assert(((pGouraud >> 24) & 255) > 20 and ((pGouraud >> 16) & 255) > 20 and ((pGouraud >> 8) & 255) > 20, "drawTriangleGouraud interpolates RGB across centroid")

  clearScreen(rgb(0, 0, 0))
  clearDepth()
  // Draw closer red 3D Gouraud triangle (z = 0.2) then farther green 3D Gouraud triangle (z = 0.8)
  drawTriangle3DGouraud(20.0, 20.0, 0.2, 60.0, 20.0, 0.2, 40.0, 60.0, 0.2, rgb(255, 0, 0), rgb(255, 0, 0), rgb(255, 0, 0))
  drawTriangle3DGouraud(20.0, 20.0, 0.8, 60.0, 20.0, 0.8, 40.0, 60.0, 0.8, rgb(0, 255, 0), rgb(0, 255, 0), rgb(0, 255, 0))
  assertEqInt(getPixel(40, 35), (255 << 24) | (0 << 16) | (0 << 8) | 255, "drawTriangle3DGouraud respects Z-buffer occlusion")

  drawQuad3DGouraud(70.0, 20.0, 0.3, 100.0, 20.0, 0.3, 100.0, 50.0, 0.3, 70.0, 50.0, 0.3, rgb(0, 0, 255), rgb(0, 0, 255), rgb(0, 0, 255), rgb(0, 0, 255))
  assertEqInt(getPixel(85, 35), (0 << 24) | (0 << 16) | (255 << 8) | 255, "drawQuad3DGouraud renders quad pixels")

  // Small world-space circle inside beginWorldPass must not register as a tiny UI widget
  drawCircle(15.0, 15.0, 2.0, rgb(255, 255, 0))
  let shotPath = "/tmp/aipl_test_inloop_shot.ppm"
  saveScreenshot(shotPath)
  assert(fileExists(shotPath), "in-loop saveScreenshot writes PPM file")
  let ppmHeader = readFile(shotPath)
  assert(ppmHeader.startsWith("P6"), "in-loop saveScreenshot writes binary P6 PPM header")

  endWorldPass()
  setUiTracking(true)
  setDepthTest(false)
  ret 0

pub fn test_shape2d_uv_texture_pipeline_177(): int:
  initCanvas(160, 120)
  clearScreen(rgb(0, 0, 0))
  setDepthTest(true)
  clearDepth()

  let cRed = packColorRgba32(rgb(240, 20, 20))
  let cBlue = packColorRgba32(rgb(20, 60, 240))
  mut rgbaBuf: [int] = []
  mut py = 0
  while py < 8:
    mut px = 0
    while px < 8:
      let col = if px < 4: cRed else: cBlue
      rgbaBuf.push(col)
      px += 1
    py += 1
  let customTex = createTextureFromRgba(8, 8, rgbaBuf)
  assert(customTex >= 1, "createTextureFromRgba returns valid handle >= 1")
  assertEqInt(getImageWidth(customTex), 8, "createTextureFromRgba width is 8")
  assertEqInt(getImageHeight(customTex), 8, "createTextureFromRgba height is 8")

  let kinds = ["grass", "rock", "cliff", "dirt", "cobble", "water", "wood", "bark", "foliage", "brick", "roof", "sand", "snow"]
  mut ki = 0
  while ki < kinds.len:
    let tid = createProceduralTexture(kinds[ki], 16, 16, 100 + ki)
    assert(tid >= 1, "createProceduralTexture returns handle >= 1")
    assertEqInt(getImageWidth(tid), 16, "procedural texture width == 16")
    assertEqInt(getImageHeight(tid), 16, "procedural texture height == 16")
    ki += 1

  let ppmPath = "/tmp/aipl_shape2d_test_tex.ppm"
  assert(saveTextureToPpm(customTex, ppmPath), "saveTextureToPpm writes P6 file")
  let loadedRes = loadImage(ppmPath)
  assert(loadedRes.isOk(), "loadImage loads saved PPM texture")
  assertEqInt(getImageWidth(loadedRes.unwrap()), 8, "reloaded PPM texture width == 8")

  let white = rgb(255, 255, 255)
  drawQuad3DTextured(
    customTex,
    10.0, 10.0, 0.2, 0.0, 0.0,
    50.0, 10.0, 0.2, 1.0, 0.0,
    50.0, 50.0, 0.2, 1.0, 1.0,
    10.0, 50.0, 0.2, 0.0, 1.0,
    white, white, white, white
  )
  let leftPx = getPixel(18, 25)
  let rightPx = getPixel(42, 25)
  let leftR = (leftPx >> 24) & 255
  let rightB = (rightPx >> 8) & 255
  assert(leftR > 180, "drawQuad3DTextured samples left UV half (red)")
  assert(rightB > 180, "drawQuad3DTextured samples right UV half (blue)")

  drawTriangle3DTextured(
    customTex,
    70.0, 10.0, 0.3, 0.0, 0.0,
    110.0, 10.0, 0.3, 0.4, 0.0,
    90.0, 50.0, 0.3, 0.2, 0.4,
    white, white, white
  )
  let triPx = getPixel(88, 22)
  assert(((triPx >> 24) & 255) > 180, "drawTriangle3DTextured samples red UV region")

  // Verify drawImageEx horizontal flip (flipX = true swaps left red half and right blue half)
  drawImageEx(customTex, 10.0, 65.0, 40.0, 40.0, 0.0, 0.0, 0.0, packColorRgba32(white), true, false)
  let flipLeftPx = getPixel(18, 80)
  let flipRightPx = getPixel(42, 80)
  assert(((flipLeftPx >> 8) & 255) > 180, "drawImageEx flipX=true puts blue on left")
  assert(((flipRightPx >> 24) & 255) > 180, "drawImageEx flipX=true puts red on right")

  // Verify procedural texture cache hit and bounded slot eviction (> 260 unique seeds)
  let cachedGrassA = createProceduralTexture("grass", 16, 16, 100)
  let cachedGrassB = createProceduralTexture("grass", 16, 16, 100)
  assertEqInt(cachedGrassA, cachedGrassB, "createProceduralTexture caches identical (kind, w, h, seed)")
  mut stressIdx = 0
  while stressIdx < 280:
    let stId = createProceduralTexture("rock", 8, 8, 5000 + stressIdx)
    assert(stId >= 1 and stId < 512, "procedural texture stress allocation stays within bounded slot table")
    stressIdx += 1

  setDepthTest(false)
  ret 0

pub fn test_shape2d_blend_modes_and_iso_sprites_178(): int:
  initCanvas(128, 128)
  assertEqInt(blendModeAlpha(), 0, "blendModeAlpha() == 0")
  assertEqInt(blendModeAdditive(), 1, "blendModeAdditive() == 1")
  assertEqInt(blendModeMultiplied(), 2, "blendModeMultiplied() == 2")
  assertEqInt(blendModeScreen(), 3, "blendModeScreen() == 3")

  // 1. Additive blend math: dst=100 + src=120 (a=1.0) -> 220
  setBlendMode(blendModeAlpha())
  clearScreen(rgb(100, 100, 100))
  setBlendMode(blendModeAdditive())
  assertEqInt(getBlendMode(), 1, "getBlendMode() == 1 after setBlendMode(blendModeAdditive())")
  drawRect(10.0, 10.0, 20.0, 20.0, rgba(120, 40, 20, 1.0))
  let addPx = getPixel(15, 15)
  assertEqInt((addPx >> 24) & 255, 220, "additive blend red channel: 100 + 120 == 220")
  assertEqInt((addPx >> 16) & 255, 140, "additive blend green channel: 100 + 40 == 140")

  // 2. Multiplied blend math: dst=200 * src=128 / 255 -> ~100
  setBlendMode(blendModeAlpha())
  clearScreen(rgb(200, 200, 200))
  setBlendMode(blendModeMultiplied())
  assertEqInt(getBlendMode(), 2, "getBlendMode() == 2 after setBlendMode(blendModeMultiplied())")
  drawRect(10.0, 10.0, 20.0, 20.0, rgba(128, 128, 128, 1.0))
  let mulPx = getPixel(15, 15)
  let mulR = (mulPx >> 24) & 255
  assert(mulR >= 98 and mulR <= 102, "multiplied blend channel: (200 * 128)/255 ~= 100")

  // 3. Screen blend math: 255 - ((255 - 120) * (255 - 100)) / 255 ~= 173
  setBlendMode(blendModeAlpha())
  clearScreen(rgb(100, 100, 100))
  setBlendMode(blendModeScreen())
  assertEqInt(getBlendMode(), 3, "getBlendMode() == 3 after setBlendMode(blendModeScreen())")
  drawRect(10.0, 10.0, 20.0, 20.0, rgba(120, 120, 120, 1.0))
  let scrPx = getPixel(15, 15)
  let scrR = (scrPx >> 24) & 255
  assert(scrR >= 170 and scrR <= 176, "screen blend channel ~= 173")

  setBlendMode(blendModeAlpha())
  assertEqInt(getBlendMode(), 0, "restored blendModeAlpha()")

  // 4. Verify new procedural textures and createIsometricSpriteSheet
  let cookieId = createProceduralTexture("light_cookie", 32, 32, 7)
  let mistId = createProceduralTexture("mist", 32, 32, 8)
  let palisadeId = createProceduralTexture("palisade", 32, 32, 9)
  assert(cookieId > 0 and mistId > 0 and palisadeId > 0, "atmospheric procedural textures created")

  let knightSheet = createIsometricSpriteSheet("hero_knight", 32, 32, 8, 4, 42)
  assert(knightSheet > 0, "createIsometricSpriteSheet returns valid texture id")
  assertEqInt(getImageWidth(knightSheet), 128, "sprite sheet width == 32 * 4 == 128")
  assertEqInt(getImageHeight(knightSheet), 256, "sprite sheet height == 32 * 8 == 256")

  let paladinTall = createIsometricSpriteSheet("paladin", 16, 64, 8, 4, 42)
  let rogueSheet = createIsometricSpriteSheet("rogue", 24, 24, 8, 4, 42)
  let demonSheet = createIsometricSpriteSheet("demon", 24, 24, 8, 4, 42)
  let deadTreeSheet = createIsometricSpriteSheet("dead_tree", 32, 48, 1, 4, 42)
  assert(paladinTall > 0 and rogueSheet > 0 and demonSheet > 0 and deadTreeSheet > 0, "all isometric sprite archetypes synthesized")
  assertEqInt(getImageWidth(paladinTall), 64, "non-square 16x64 sprite sheet width == 16 * 4 == 64")
  assertEqInt(getImageHeight(paladinTall), 512, "non-square 16x64 sprite sheet height == 64 * 8 == 512")
  ret 0

