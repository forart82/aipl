module tests.functions.gfx25d.gfx25d_mod_test

import * from "std/gfx25d/gfx25d_mod"
import { assert, assertApproxEq } from "std/prelude"

pub fn test_gfx25d_mod_barrel(): int:
  let cam = createCamera25D(1280.0, 720.0, 1.5, 45.0, 30.0)
  let iso = project3DToIso(cam, 120.0, 80.0, 24.0)
  let unp = unprojectIsoTo3D(cam, iso.x, iso.y, 24.0)
  assertApproxEq(unp.x, 120.0, 0.05, "gfx25d_mod camera roundtrip x")
  assertApproxEq(unp.y, 80.0, 0.05, "gfx25d_mod camera roundtrip y")
  let light = createPointLight25D(0.0, 2.0, 0.0, 8.0, 0xFF8800, 1.0)
  assertApproxEq(light.radius, 8.0, 0.001, "gfx25d_mod createPointLight25D")
  let dir = direction8FromVelocity(1.0, 0.0)
  assert(dir >= 0 and dir < 8, "gfx25d_mod direction8FromVelocity")
  ret 0

pub fn main(): int:
  test_gfx25d_mod_barrel()
  println("PASS: tests/functions/gfx25d/gfx25d_mod_test.aipl")
  ret 0
