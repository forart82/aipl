pub fn test_csprng_isValidUuid_9(): int:
  let valid = "01234567-89ab-cdef-0123-456789abcdef"
  assert(isValidUuid(valid) == true, "isValidUuid returns true for valid uuid")
  assert(isValidUuid("invalid-uuid") == false, "isValidUuid returns false for invalid uuid")
  assert(isValidUuid("0123456789abcdef0123456789abcdef0123") == false, "isValidUuid returns false without hyphens")
  ret 0

pub fn test_csprng_parseUuid_10(): int:
  let valid = "01234567-89ab-cdef-0123-456789abcdef"
  let parsed = parseUuid(valid)
  assert(parsed.isOk() == true, "parseUuid returns Ok for valid uuid")
  assertEqStr(parsed.unwrap().toString(), valid, "parseUuid round-trip toString matches")
  let bad = parseUuid("not-a-valid-uuid")
  assert(bad.isOk() == false, "parseUuid returns Err for invalid uuid")
  ret 0

pub fn test_csprng_Uuid_toString_11(): int:
  let rawBytes = bytesFromArray([0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef, 0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef])
  let u = Uuid(bytes16 = rawBytes)
  assertEqStr(u.toString(), "01234567-89ab-cdef-0123-456789abcdef", "Uuid.toString formats canonical RFC 4122 string")
  ret 0

