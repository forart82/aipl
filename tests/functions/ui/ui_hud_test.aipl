pub fn test_ui_hud_computeRadialGaugeSweep_1(): int:
  let arg_gauge = RadialGaugeWidget(currentValue = 1.0, maxValue = 2.0, startAngleRad = 0.0, sweepAngleRad = 2.0, innerRadius = 2.0, outerRadius = 2.0, fillColor = ColorRgba8(r = 2, g = 2, b = 4, a = 2))
  let edge_gauge = RadialGaugeWidget(currentValue = 0.5, maxValue = 1.0, startAngleRad = 0.0, sweepAngleRad = 1.0, innerRadius = 1.0, outerRadius = 1.0, fillColor = ColorRgba8(r = 0, g = 0, b = 1, a = 0))
  let resNom = computeRadialGaugeSweep(arg_gauge)
  let resEdge = computeRadialGaugeSweep(edge_gauge)
  assertApproxEq(resNom, 1.0, 0.001, "computeRadialGaugeSweep nominal resNom ~= 1.0")
  assertApproxEq(resEdge, 0.5, 0.001, "computeRadialGaugeSweep boundary resEdge ~= 0.5")
  ret 0

pub fn test_ui_hud_evaluateActionSlotUsability_2(): int:
  let arg_slot = CooldownActionSlot(slotId = 1, iconTextureId = 4, cooldownPct = 2.0, remainingSeconds = 1.0, isUsable = true)
  let edge_slot = CooldownActionSlot(slotId = 0, iconTextureId = 1, cooldownPct = 1.0, remainingSeconds = 0.5, isUsable = false)
  let resNom = evaluateActionSlotUsability(arg_slot)
  let resEdge = evaluateActionSlotUsability(edge_slot)
  assert(resNom == false, "evaluateActionSlotUsability nominal resNom == false")
  assert(resEdge == false, "evaluateActionSlotUsability boundary resEdge == false")
  ret 0

