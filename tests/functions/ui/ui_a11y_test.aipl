pub fn test_ui_a11y_createA11yNode_1(): int:
  let arg_id = 1
  let edge_id = 0
  let arg_role = 2
  let edge_role = 0
  let arg_label = "test"
  let edge_label = "a"
  let arg_bounds = Rect(x = 1.0, y = 1.0, w = 2.0, h = 2.0)
  let edge_bounds = Rect(x = 0.5, y = 0.5, w = 1.0, h = 1.0)
  let resNom = createA11yNode(arg_id, arg_role, arg_label, arg_bounds)
  let resEdge = createA11yNode(edge_id, edge_role, edge_label, edge_bounds)
  assertEqInt(resNom.nodeId, 1, "createA11yNode nominal resNom.nodeId == 1")
  assertEqInt(resEdge.nodeId, 0, "createA11yNode boundary resEdge.nodeId == 0")
  ret 0

pub fn test_ui_a11y_collectFocusableIds_2(): int:
  let arg_node = A11yNode(nodeId = 4, role = 2, label = "test", valueText = "test", bounds = Rect(x = 1.0, y = 1.0, w = 2.0, h = 2.0), isFocusable = true, isFocused = true, children = [])
  let edge_node = A11yNode(nodeId = 1, role = 0, label = "a", valueText = "a", bounds = Rect(x = 0.5, y = 0.5, w = 1.0, h = 1.0), isFocusable = false, isFocused = false, children = [])
  let arg_acc = [2]
  let edge_acc = []
  let resNom = collectFocusableIds(arg_node, arg_acc)
  let resEdge = collectFocusableIds(edge_node, edge_acc)
  assertEqInt(resNom.len(), 2, "collectFocusableIds nominal resNom.len() == 2")
  assertEqInt(resEdge.len(), 0, "collectFocusableIds boundary resEdge.len() == 0")
  ret 0

pub fn test_ui_a11y_findNextFocusableNode_3(): int:
  let arg_root = A11yNode(nodeId = 4, role = 2, label = "test", valueText = "test", bounds = Rect(x = 1.0, y = 1.0, w = 2.0, h = 2.0), isFocusable = true, isFocused = true, children = [])
  let edge_root = A11yNode(nodeId = 1, role = 0, label = "a", valueText = "a", bounds = Rect(x = 0.5, y = 0.5, w = 1.0, h = 1.0), isFocusable = false, isFocused = false, children = [])
  let arg_currentId = 4
  let edge_currentId = 1
  let resNom = findNextFocusableNode(arg_root, arg_currentId)
  let resEdge = findNextFocusableNode(edge_root, edge_currentId)
  assertEqInt(resNom, 4, "findNextFocusableNode nominal resNom == 4")
  assertEqInt(resEdge, -1, "findNextFocusableNode boundary resEdge == -1")
  ret 0

pub fn test_ui_a11y_wcagContrastRatioLuma_4(): int:
  let arg_luma1 = 1.0
  let edge_luma1 = 0.5
