pub fn test_ui_canvas_pushScissor_1(): int:
  let arg_canvas = UiCanvas(width = 2.0, height = 2.0, scissorStack = [])
  let edge_canvas = UiCanvas(width = 1.0, height = 1.0, scissorStack = [])
  let arg_rect = ScissorRect(x = 1, y = 1, w = 2, h = 2)
  let edge_rect = ScissorRect(x = 0, y = 0, w = 0, h = 0)
  let resNom = pushScissor(arg_canvas, arg_rect)
  let resEdge = pushScissor(edge_canvas, edge_rect)
  assertApproxEq(resNom.width, 2.0, 0.001, "pushScissor nominal resNom.width ~= 2.0")
  assertApproxEq(resEdge.width, 1.0, 0.001, "pushScissor boundary resEdge.width ~= 1.0")
  ret 0

