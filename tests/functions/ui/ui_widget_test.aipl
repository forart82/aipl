  let arg_nameCol = Color(r = 1.0, g = 1.0, b = 1.0, a = 1.0)
  let edge_nameCol = Color(r = 0.5, g = 0.5, b = 0.5, a = 0.5)
  let arg_valCol = Color(r = 1.0, g = 1.0, b = 1.0, a = 1.0)
  let edge_valCol = Color(r = 0.5, g = 0.5, b = 0.5, a = 0.5)
  let resNom = drawDebuggerWatchPill(arg_x, arg_y, arg_exprName, arg_exprVal, arg_typeTag, arg_bgCol, arg_nameCol, arg_valCol)
  let resEdge = drawDebuggerWatchPill(edge_x, edge_y, edge_exprName, edge_exprVal, edge_typeTag, edge_bgCol, edge_nameCol, edge_valCol)
  assertApproxEq(resNom, 41.2, 0.001, "drawDebuggerWatchPill nominal resNom ~= 41.2")
  assertApproxEq(resEdge, 35.8, 0.001, "drawDebuggerWatchPill boundary resEdge ~= 35.8")
  ret 0

