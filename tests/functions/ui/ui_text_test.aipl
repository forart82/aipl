// Generated function test suite for std/ui/ui_text.aipl (6 functions)
module tests.functions.ui.ui_text_test

import * from "std/ui/ui_text"
import { ColorRgba8 } from "std/gfx/color"
import { Option, Result, Some, None, Ok, Err, assert, assertEqInt, assertEqStr, assertApproxEq } from "std/prelude"
import { maxFloat } from "std/math/consts"

pub fn test_ui_text_measureTextWidth_1(): int:
  let arg_text = "test"
  let edge_text = "a"
  let arg_style = TextStyle(fontId = 4, fontSize = 1.0, lineHeight = 2.0, color = ColorRgba8(r = 2, g = 2, b = 4, a = 2), letterSpacing = 1.0)
  let edge_style = TextStyle(fontId = 1, fontSize = 0.5, lineHeight = 1.0, color = ColorRgba8(r = 0, g = 0, b = 1, a = 0), letterSpacing = 0.5)
  let resNom = measureTextWidth(arg_text, arg_style)
  let resEdge = measureTextWidth(edge_text, edge_style)
  assertApproxEq(resNom, 5.4, 0.001, "measureTextWidth nominal resNom ~= 5.4")
  assertApproxEq(resEdge, 0.3, 0.001, "measureTextWidth boundary resEdge ~= 0.3")
  ret 0

pub fn test_ui_text_wrapTextToLines_2(): int:
  let arg_text = "test"
  let edge_text = "a"
  let arg_maxWidth = 2.0
  let edge_maxWidth = 1.0
  let arg_style = TextStyle(fontId = 4, fontSize = 1.0, lineHeight = 2.0, color = ColorRgba8(r = 2, g = 2, b = 4, a = 2), letterSpacing = 1.0)
  let edge_style = TextStyle(fontId = 1, fontSize = 0.5, lineHeight = 1.0, color = ColorRgba8(r = 0, g = 0, b = 1, a = 0), letterSpacing = 0.5)
  let resNom = wrapTextToLines(arg_text, arg_maxWidth, arg_style)
  let resEdge = wrapTextToLines(edge_text, edge_maxWidth, edge_style)
  assertEqInt(resNom.lines.len(), 1, "wrapTextToLines nominal resNom.lines.len() == 1")
  assertEqInt(resEdge.lines.len(), 1, "wrapTextToLines boundary resEdge.lines.len() == 1")
  ret 0

pub fn test_ui_text_truncateTextWithEllipsis_3(): int:
  let arg_text = "127.0.0.1"
  let edge_text = "127.0.0.1"
  let arg_maxWidth = 2.0
  let edge_maxWidth = 1.0
  let arg_style = TextStyle(fontId = 4, fontSize = 1.0, lineHeight = 2.0, color = ColorRgba8(r = 2, g = 2, b = 4, a = 2), letterSpacing = 1.0)
  let edge_style = TextStyle(fontId = 1, fontSize = 0.5, lineHeight = 1.0, color = ColorRgba8(r = 0, g = 0, b = 1, a = 0), letterSpacing = 0.5)
  let resNom = truncateTextWithEllipsis(arg_text, arg_maxWidth, arg_style)
  let resEdge = truncateTextWithEllipsis(edge_text, edge_maxWidth, edge_style)
  assertEqStr(resNom, "...", "truncateTextWithEllipsis nominal string matches")
  assertEqStr(resEdge, "...", "truncateTextWithEllipsis boundary string matches")
  ret 0

pub fn test_ui_text_richSpanPlain_4(): int:
  let arg_text = "test"
  let edge_text = "a"
  let arg_colorHex = 1
  let edge_colorHex = 0
  let resNom = richSpanPlain(arg_text, arg_colorHex)
  let resEdge = richSpanPlain(edge_text, edge_colorHex)
  assertEqStr(resNom.text, "test", "richSpanPlain nominal string matches")
  assertEqStr(resEdge.text, "a", "richSpanPlain boundary string matches")
  ret 0

pub fn test_ui_text_richSpansTotalLength_5(): int:
  let arg_spans = [RichTextSpan(text = "test", colorHex = 1, bold = true, code = true)]
  let edge_spans = []
  let resNom = richSpansTotalLength(arg_spans)
  let resEdge = richSpansTotalLength(edge_spans)
  assertEqInt(resNom, 4, "richSpansTotalLength nominal resNom == 4")
  assertEqInt(resEdge, 0, "richSpansTotalLength boundary resEdge == 0")
  ret 0

pub fn test_ui_text_measureRichLineWidth_6(): int:
  let arg_spans = [TextSpan(text = "test", fontSize = 1.0, colorHex = 1)]
  let edge_spans = []
  let resNom = measureRichLineWidth(arg_spans)
  let resEdge = measureRichLineWidth(edge_spans)
  assertApproxEq(resNom, 2.4, 0.001, "measureRichLineWidth nominal resNom ~= 2.4")
  assertApproxEq(resEdge, 0.0, 0.001, "measureRichLineWidth boundary resEdge ~= 0.0")
  ret 0

