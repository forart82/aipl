pub fn test_ui_nodegraph_computeBezierWireControlPoints_1(): int:
  let arg_startPt = Vec2(x = 1.0, y = 1.0)
  let edge_startPt = Vec2(x = 0.5, y = 0.5)
  let arg_endPt = Vec2(x = 1.0, y = 1.0)
  let edge_endPt = Vec2(x = 0.5, y = 0.5)
  let resNom = computeBezierWireControlPoints(arg_startPt, arg_endPt)
  let resEdge = computeBezierWireControlPoints(edge_startPt, edge_endPt)
  assertEqInt(resNom.len(), 4, "computeBezierWireControlPoints nominal resNom.len() == 4")
  assertEqInt(resEdge.len(), 4, "computeBezierWireControlPoints boundary resEdge.len() == 4")
  ret 0

pub fn test_ui_nodegraph_validatePinConnection_2(): int:
  let arg_outPin = GraphPin(pinId = 4, nodeId = 4, name = "test", isOutput = true, dataType = 1, pinPosition = Vec2(x = 1.0, y = 1.0))
  let edge_outPin = GraphPin(pinId = 1, nodeId = 1, name = "a", isOutput = false, dataType = 0, pinPosition = Vec2(x = 0.5, y = 0.5))
  let arg_inPin = GraphPin(pinId = 4, nodeId = 4, name = "test", isOutput = true, dataType = 1, pinPosition = Vec2(x = 1.0, y = 1.0))
  let edge_inPin = GraphPin(pinId = 1, nodeId = 1, name = "a", isOutput = false, dataType = 0, pinPosition = Vec2(x = 0.5, y = 0.5))
  let resNom = validatePinConnection(arg_outPin, arg_inPin)
  let resEdge = validatePinConnection(edge_outPin, edge_inPin)
  assert(resNom == false, "validatePinConnection nominal resNom == false")
  assert(resEdge == false, "validatePinConnection boundary resEdge == false")
  ret 0

pub fn test_ui_nodegraph_auraUndoHistoryNew_3(): int:
  let arg_maxDepth = 4
  let edge_maxDepth = 1
  let resNom = auraUndoHistoryNew(arg_maxDepth)
  let resEdge = auraUndoHistoryNew(edge_maxDepth)
  assertEqInt(resNom.undoStack.len(), 0, "auraUndoHistoryNew nominal resNom.undoStack.len() == 0")
  assertEqInt(resEdge.undoStack.len(), 0, "auraUndoHistoryNew boundary resEdge.undoStack.len() == 0")
  ret 0

pub fn test_ui_nodegraph_auraUndoHistoryPush_4(): int:
  let arg_h = AuraUndoHistory(undoStack = [], redoStack = [], maxDepth = 4)
  let edge_h = AuraUndoHistory(undoStack = [], redoStack = [], maxDepth = 4)
  let arg_current = "test"
  let edge_current = "a"
  let resNom = auraUndoHistoryPush(arg_h, arg_current)
  let resEdge = auraUndoHistoryPush(edge_h, edge_current)
  assertEqInt(resNom.undoStack.len(), 1, "auraUndoHistoryPush nominal resNom.undoStack.len() == 1")
  assertEqInt(resEdge.undoStack.len(), 1, "auraUndoHistoryPush boundary resEdge.undoStack.len() == 1")
  ret 0

