pub fn test_ui_charts_autoScaleChartRange_1(): int:
  let arg_series = [ChartDataSeries(name = "test", values = [], color = ColorRgba8(r = 2, g = 2, b = 4, a = 2))]
  let edge_series = []
  let resNom = autoScaleChartRange(arg_series)
  let resEdge = autoScaleChartRange(edge_series)
  assertEqInt(resNom.series.len(), 1, "autoScaleChartRange nominal resNom.series.len() == 1")
  assertEqInt(resEdge.series.len(), 0, "autoScaleChartRange boundary resEdge.series.len() == 0")
  ret 0

pub fn test_ui_charts_computeDataPointScreenCoords_2(): int:
  let arg_chart = LineChartWidget(series = [], minVal = 0.0, maxVal = 2.0, bounds = Rect(x = 1.0, y = 1.0, w = 2.0, h = 2.0), showGrid = true)
  let edge_chart = LineChartWidget(series = [], minVal = 0.0, maxVal = 1.0, bounds = Rect(x = 0.5, y = 0.5, w = 1.0, h = 1.0), showGrid = false)
  let arg_seriesIdx = 1
  let edge_seriesIdx = 0
  let arg_valIdx = 1
  let edge_valIdx = 0
  let resNom = computeDataPointScreenCoords(arg_chart, arg_seriesIdx, arg_valIdx)
  let resEdge = computeDataPointScreenCoords(edge_chart, edge_seriesIdx, edge_valIdx)
  assertApproxEq(resNom.x, 1.0, 0.001, "computeDataPointScreenCoords nominal resNom.x ~= 1.0")
  assertApproxEq(resEdge.x, 0.5, 0.001, "computeDataPointScreenCoords boundary resEdge.x ~= 0.5")
  ret 0

pub fn test_ui_charts_createChartSeries_3(): int:
  let arg_name = "test"
  let edge_name = "a"
  let arg_values = [1.0]
  let edge_values = []
  let arg_colHex = 1
  let edge_colHex = 0
  let resNom = createChartSeries(arg_name, arg_values, arg_colHex)
  let resEdge = createChartSeries(edge_name, edge_values, edge_colHex)
  assertEqStr(resNom.name, "test", "createChartSeries nominal string matches")
  assertEqStr(resEdge.name, "a", "createChartSeries boundary string matches")
  ret 0

