module tests.functions.ui.ui_mod_test

import * from "std/ui/ui_mod"
import { assert, assertEqInt, assertEqStr } from "std/prelude"

pub fn test_step_12_9_barrel(): int:
  let c = packedHexToRgb(0xFF8040)
  assertEqInt(c.r, 255, "packedHexToRgb r")
  assertEqInt(c.g, 128, "packedHexToRgb g")
  assertEqInt(c.b, 64, "packedHexToRgb b")
  assert(parseCssColor("#GGGGGG").isErr() == true, "invalid hex rejected")
  assertEqStr(toCssHsl(HslColor(h = 359.9, s = 1.0, l = 0.5)), "hsl(0, 100%, 50%)", "359.9 deg wraps to 0")
  assertEqInt(cycleFocusIndex(-5, 4, false), 0, "negative focus index wraps into [0, count)")
  let hud = createWatcherHudState(60, 24)
  assertEqInt(hud.pillHitboxDp, 48, "ui_mod reexports ui_watcher_hud")
  ret 0

pub fn main(): int:
  test_step_12_9_barrel()
  println("PASS: tests/functions/ui/ui_mod_test.aipl")
  ret 0
