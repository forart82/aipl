module tests.functions.sync.sync_mod_test

import * from "std/sync/sync_mod"
import { assert, assertEqInt } from "std/prelude"

pub fn test_step_9_24_barrel(): int:
  mut cv = condVarNew()
  condVarSignal(cv)
  assertEqInt(cv.signaledCount, 0, "signal with 0 waiters does not accumulate phantom signal")
  mut ch = mpscChannelNew(4)
  assert(mpscSend(ch, 77).isOk() == true, "mpscSend via sync_mod barrel")
  assertEqInt(mpscRecv(ch).unwrap(), 77, "mpscRecv == 77")
  ret 0

pub fn main(): int:
  test_step_9_24_barrel()
  println("PASS: tests/functions/sync/sync_mod_test.aipl")
  ret 0
