pub fn test_gamepad_applyAxialDeadzone_4(): int:
  let arg_x = 1.0
  let edge_x = 0.5
  let arg_y = 1.0
  let edge_y = 0.5
  let arg_deadzone = 1.0
  let edge_deadzone = 0.5
  let resNom = applyAxialDeadzone(arg_x, arg_y, arg_deadzone)
