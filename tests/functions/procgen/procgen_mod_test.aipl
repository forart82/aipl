module tests.functions.procgen.procgen_mod_test

import * from "std/procgen/procgen_mod"
import { Vec2, IVec2 } from "std/math/vec_math"
import { Rect2D } from "std/math/geom2d"
import { assert, assertEqInt } from "std/prelude"

pub fn test_procgen_mod_reexports(): int:
  let rA = DungeonRoom(id = 10, bounds = Rect2D(x = 1.0, y = 1.0, w = 3.0, h = 3.0, width = 3.0, height = 3.0), center = Vec2(x = 2.5, y = 2.5), connectedRooms = [])
  let rB = DungeonRoom(id = 20, bounds = Rect2D(x = 8.0, y = 8.0, w = 3.0, h = 3.0, width = 3.0, height = 3.0), center = Vec2(x = 9.5, y = 9.5), connectedRooms = [])
  let rC = DungeonRoom(id = 30, bounds = Rect2D(x = 15.0, y = 2.0, w = 3.0, h = 3.0, width = 3.0, height = 3.0), center = Vec2(x = 16.5, y = 3.5), connectedRooms = [])
  let cors = minimumSpanningTreeCorridors([rA, rB, rC], [IVec2(x = 10, y = 20), IVec2(x = 20, y = 30), IVec2(x = 10, y = 30)], 0.0, 42)
  assertEqInt(cors.len, 2, "MST corridors resolve non-index room IDs and prune cycle when extraEdgeProbability == 0")
  let emptyGrid = carveDungeonGrid([], [], 0, 0)
  assertEqInt(emptyGrid.cells.len, 0, "carveDungeonGrid handles zero dimensions")
  ret 0

fn main(): int:
  assertEqInt(test_procgen_mod_reexports(), 0, "test_procgen_mod_reexports")
  ret 0
