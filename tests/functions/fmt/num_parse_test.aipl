pub fn test_num_parse_formatFloatScientific_21(): int:
  let arg_val = 1.0
  let edge_val = 0.5
  let arg_precision = 4
  let edge_precision = 1
  let resNom = formatFloatScientific(arg_val, arg_precision)
  let resEdge = formatFloatScientific(edge_val, edge_precision)
  assertEqStr(resNom, "1.0000e+00", "formatFloatScientific nominal string matches")
  assertEqStr(resEdge, "5.0e-01", "formatFloatScientific boundary string matches")
  ret 0
pub fn test_num_parse_int64_min_and_scientific_rounding(): int:
  let minI64 = (-9223372036854775807) - 1
  assertEqStr(formatInt(minI64, 10), "-9223372036854775808", "formatInt INT64_MIN")
  assertEqStr(formatHex(minI64, false, true), "-0x8000000000000000", "formatHex INT64_MIN")
  assertEqStr(formatFloatScientific(9.999, 2), "1.00e+01", "scientific carry 9.999 -> 1.00e+01")
  let hugeExp = parseFloat("1e1000000000")
  assert(hugeExp.isOk() == true, "huge exponent parses in O(1)")
  let tinyExp = parseFloat("1e-1000000000")
  assertApproxEq(tinyExp.unwrap(), 0.0, 0.0001, "huge negative exponent underflows cleanly to 0")
  ret 0
