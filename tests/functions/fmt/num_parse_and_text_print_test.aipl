  let edge_val = 0
  let arg_prefix = true
  let edge_prefix = false
  let resNom = formatOctal(arg_val, arg_prefix)
  let resEdge = formatOctal(edge_val, edge_prefix)
  assertEqStr(resNom, "0o2", "formatOctal nominal string matches")
