module tests.functions.test.test_mod_test

import * from "std/test/test_mod"
import { assert } from "std/prelude"

pub fn test_step_9_42_barrel(): int:
  let zeroGen = FuzzGenerator(seed: 0, state: 0)
  let (g1, v1) = fuzzNextInt(zeroGen, 10, 100)
  let (_, v2) = fuzzNextInt(g1, 10, 100)
  assert(g1.state != 0, "zero-state FuzzGenerator recovers from 0 lockup")
  assert(v1 >= 10 and v1 <= 100 and v2 >= 10 and v2 <= 100, "fuzzNextInt within bounds")
  ret 0

pub fn main(): int:
  test_step_9_42_barrel()
  println("PASS: tests/functions/test/test_mod_test.aipl")
  ret 0
