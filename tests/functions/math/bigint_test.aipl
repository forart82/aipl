pub fn test_bigint_mulAbsLimbs_6(): int:
  let arg_a = [2]
  let edge_a = []
  let arg_b = [4]
  let edge_b = []
  let resNom = mulAbsLimbs(arg_a, arg_b)
  let resEdge = mulAbsLimbs(edge_a, edge_b)
  assertEqInt(resNom.len(), 1, "mulAbsLimbs nominal resNom.len() == 1")
