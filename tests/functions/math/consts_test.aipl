pub fn test_consts_abs_4(): int:
  let arg_x = 1
  let edge_x = 0
  let resNom = abs(arg_x)
  let resEdge = abs(edge_x)
  assertEqInt(resNom, 1, "abs nominal resNom == 1")
  assertEqInt(resEdge, 0, "abs boundary resEdge == 0")
  ret 0

