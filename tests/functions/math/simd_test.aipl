  let arg_b = [1.0]
  let edge_b = []
  let resNom = tensorDot(arg_a, arg_b)
  let resEdge = tensorDot(edge_a, edge_b)
  assertApproxEq(resNom, 1.0, 0.001, "tensorDot nominal resNom ~= 1.0")
  assertApproxEq(resEdge, 0.0, 0.001, "tensorDot boundary resEdge ~= 0.0")
