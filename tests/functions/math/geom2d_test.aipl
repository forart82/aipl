pub fn test_geom2d_width_height_and_direction_aliases(): int:
  let r = Rect2D(x = 10.0, y = 20.0, width = 30.0, height = 40.0)
  assert(rectContainsPoint(r, Vec2(x = 25.0, y = 45.0)) == true, "width/height alias containment")
  let ray = Ray2D(origin = Vec2(x = 25.0, y = 0.0), direction = Vec2(x = 0.0, y = 1.0))
  let hit = rayIntersectsRect2D(ray, r)
  assert(hit.isSome() == true, "Ray2D.direction alias hit")
  assertApproxEq(hit.unwrap(), 20.0, 0.001, "Ray2D hit t == 20")
  ret 0
