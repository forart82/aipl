pub fn test_geom2d_collideCircles_33(): int:
  let arg_a = Circle2D(x = 1.0, y = 1.0, r = 1.0, cx = 1.0, cy = 1.0)
  let edge_a = Circle2D(x = 0.5, y = 0.5, r = 0.5, cx = 0.5, cy = 0.5)
