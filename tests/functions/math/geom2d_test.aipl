pub fn test_geom2d_vec2Normalize_35(): int:
  let arg_v = Vec2(x = 1.0, y = 1.0)
  let edge_v = Vec2(x = 0.5, y = 0.5)
  let resNom = vec2Normalize(arg_v)
  let resEdge = vec2Normalize(edge_v)
