  let edge_targetDeg = 0.5
  let arg_sourceDeg = 1.0
  let edge_sourceDeg = 0.5
  let resNom = angleDeltaDeg(arg_targetDeg, arg_sourceDeg)
  let resEdge = angleDeltaDeg(edge_targetDeg, edge_sourceDeg)
