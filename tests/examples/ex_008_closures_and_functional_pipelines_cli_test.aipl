// ============================================================================
// Twin Test Suite 008: Anonymous Lambdas, Array Combinators & Pipelines CLI
// Verifies examples/ex_008_closures_and_functional_pipelines_cli.aipl
// ============================================================================
module Ex008ClosuresAndFunctionalPipelinesCliTest

import {
  PipelineTelemetry,
  filterAndSquarePositive,
  sumArrayElements,
  classifyPipelinePredicates,
  buildPipelineTelemetry
} from "../../examples/ex_008_closures_and_functional_pipelines_cli.aipl"

pub fn test_map_and_filter_lambdas(): int:
  let out = filterAndSquarePositive([-3, 0, 2, 4, -1, 5])
  assert(out.len == 3, "3 positive elements [2, 4, 5]")
  assert(out[0] == 4 and out[1] == 16 and out[2] == 25, "squares are [4, 16, 25]")
  assert(sumArrayElements(out) == 45, "4 + 16 + 25 == 45")
  ret 0

pub fn test_pipeline_telemetry_metrics(): int:
  let tel = buildPipelineTelemetry([-3, 0, 2, 4, -1, 5])
  assert(tel.inputCount == 6, "inputCount == 6")
  assert(tel.activeCount == 3, "activeCount == 3")
  assert(tel.squaredSum == 45, "squaredSum == 45")
  assert(tel.allSquaredPositive == true, "all squared values > 0")
  ret 0

pub fn test_predicate_combinators(): int:
  assert(classifyPipelinePredicates([2, 4, 6]) == "PIPE:ALL_POSITIVE_WITH_PEAK", "all > 0 and any >= 5")
  assert(classifyPipelinePredicates([1, 2, 3]) == "PIPE:ALL_POSITIVE_LOW", "all > 0 and none >= 5")
  assert(classifyPipelinePredicates([-2, 3, 8]) == "PIPE:CONTAINS_NON_POSITIVE", "has negative")
  ret 0

pub fn main(): int:
  test_map_and_filter_lambdas()
  test_pipeline_telemetry_metrics()
  test_predicate_combinators()
  println("PASS: ex_008_closures_and_functional_pipelines_cli_test")
  ret 0
