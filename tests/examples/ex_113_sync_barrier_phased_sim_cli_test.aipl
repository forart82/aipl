// ============================================================================
// Twin Test Suite 113: ThreadBarrier, WaitGroup, CountDownLatch & OnceInit (CLI)
// Verifies examples/ex_113_sync_barrier_phased_sim_cli.aipl
// ============================================================================
module Ex113SyncBarrierPhasedSimCliTest

import {
  evaluatePhasedBarrierAndWaitGroupSteps,
  verifyCountDownLatchAndOnceInit,
  describeBarrierPhaseLeader
} from "../../examples/ex_113_sync_barrier_phased_sim_cli.aipl"

pub fn test_sync_barrier_phased_sim_cli(): int:
  assert(evaluatePhasedBarrierAndWaitGroupSteps() == 4, "1 barrier leader arrival + 3 WaitGroup tasks completed == 4")
  assert(verifyCountDownLatchAndOnceInit() == 1, "countDownLatch 2->1->0 and onceInitDo idempotence pass")
  assert(describeBarrierPhaseLeader(true) == "BARRIER:PHASE_LEADER_ELECTED", "leader arrival label")
  ret 0

pub fn main(): int:
  test_sync_barrier_phased_sim_cli()
  println("PASS: ex_113_sync_barrier_phased_sim_cli_test")
  ret 0
