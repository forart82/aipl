// ============================================================================
// Twin Test Suite 070: JSON AST Construction, Serialization & JQ Path Query (CLI)
// Verifies examples/ex_070_encoding_json_jq_query_cli.aipl
// ============================================================================
module Ex070EncodingJsonJqQueryCliTest

import {
  computeJsonAstFootprint,
  computePrettyIndentSpaces,
  describeJsonValueKind,
  evaluateJsonJqQueryPipeline
} from "../../examples/ex_070_encoding_json_jq_query_cli.aipl"

pub fn test_encoding_json_jq_query_cli(): int:
  assert(computeJsonAstFootprint(10, 25) == 720, "10 object nodes * 32 + 25 scalar leaves * 16 == 720")
  assert(computePrettyIndentSpaces(4, 2) == 8, "depth 4 * 2 spaces == 8")
  assert(describeJsonValueKind(1) == "JSON:OBJECT_MAP", "typeTag 1 is JSON:OBJECT_MAP")
  assert(evaluateJsonJqQueryPipeline() == "safe:42", "jq query extracts tags[1] ('safe') and count (42)")
  ret 0

pub fn main(): int:
  test_encoding_json_jq_query_cli()
  println("PASS: ex_070_encoding_json_jq_query_cli_test")
  ret 0
