// ============================================================================
// Twin Test Suite 120: UDP Datagram Multicast & Broadcaster (CLI)
// Verifies examples/ex_120_net_udp_datagram_broadcaster_cli.aipl
// ============================================================================
module Ex120NetUdpDatagramBroadcasterCliTest

import {
  verifyUdpMulticastAndDatagramExchange,
  computeSafeUdpPayloadUnderMtu,
  describeUdpMulticastScope
} from "../../examples/ex_120_net_udp_datagram_broadcaster_cli.aipl"

pub fn test_net_udp_datagram_broadcaster_cli(): int:
  assert(verifyUdpMulticastAndDatagramExchange() == 3, "UDP bind/multicast/sendTo/recvFrom transfers 3-byte datagram")
  assert(computeSafeUdpPayloadUnderMtu(1500) == 1472, "1500 Ethernet MTU - 20 IPv4 - 8 UDP == 1472 bytes")
  assert(describeUdpMulticastScope(239) == "UDP:ADMIN_SCOPED_MULTICAST_239", "239.x.x.x admin-scoped multicast")
  ret 0

pub fn main(): int:
  test_net_udp_datagram_broadcaster_cli()
  println("PASS: ex_120_net_udp_datagram_broadcaster_cli_test")
  ret 0
