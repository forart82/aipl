// ============================================================================
// Twin Test Suite 046: BTreeMap Ordered Keys, Min/Max & Range Scan (CLI)
// Verifies examples/ex_046_collections_btree_map_range_query_cli.aipl
// ============================================================================
module Ex046CollectionsBtreeMapRangeQueryCliTest

import {
  evaluateBTreeRangeAndExtremes,
  verifyBTreeOrderedKeyLookup,
  describeBTreeOrder
} from "../../examples/ex_046_collections_btree_map_range_query_cli.aipl"

pub fn test_btree_range_and_extremes(): int:
  // Keys [10, 20, 30, 50, 70]: minKey(10) + maxKey(70) + range(20, 50).len(3) == 83
  assert(evaluateBTreeRangeAndExtremes() == 83, "min(10) + max(70) + range_len(3) == 83")
  assert(verifyBTreeOrderedKeyLookup(30) == "thirty", "key 30 maps to 'thirty'")
  assert(describeBTreeOrder(2) == "BTREE:MIN_DEGREE_2_ORDERED_INDEX", "degree 2")
  ret 0

pub fn main(): int:
  test_btree_range_and_extremes()
  println("PASS: ex_046_collections_btree_map_range_query_cli_test")
  ret 0
