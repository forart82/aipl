// ============================================================================
// Twin Test Suite 073: RFC-4180 CSV & TSV Columnar Analytics (CLI)
// Verifies examples/ex_073_encoding_csv_analytics_cli.aipl
// ============================================================================
module Ex073EncodingCsvAnalyticsCliTest

import {
  evaluateCsvRowAndRecordCounts,
  verifyCsvAndTsvRoundTrip,
  describeCsvDialectMode
} from "../../examples/ex_073_encoding_csv_analytics_cli.aipl"

pub fn test_encoding_csv_analytics_cli(): int:
  assert(evaluateCsvRowAndRecordCounts() == 8, "3 raw CSV rows + 2 header-mapped records + 3 column cells == 8")
  assert(verifyCsvAndTsvRoundTrip() == 1, "serializeCsv, stringifyTsv, and CsvReader round-trip valid")
  assert(describeCsvDialectMode(",") == "CSV:RFC4180_COMMA_QUOTED", "comma delimiter dialect")
  ret 0

pub fn main(): int:
  test_encoding_csv_analytics_cli()
  println("PASS: ex_073_encoding_csv_analytics_cli_test")
  ret 0
