// ============================================================================
// Twin Test Suite 126: JSON-RPC 2.0 Method Dispatcher & Error Envelopes (CLI)
// Verifies examples/ex_126_net_rpc_jsonrpc2_dispatcher_cli.aipl
// ============================================================================
module Ex126NetRpcJsonrpc2DispatcherCliTest

import {
  verifyJsonRpc2DispatcherAndEnvelopes,
  computeExpectedRpcResponses,
  encodeJsonRpcErrorMetric,
  describeJsonRpcErrorCode
} from "../../examples/ex_126_net_rpc_jsonrpc2_dispatcher_cli.aipl"

pub fn test_net_rpc_jsonrpc2_dispatcher_cli(): int:
  assert(verifyJsonRpc2DispatcherAndEnvelopes() == 1, "JSON-RPC 2.0 method registration, dispatch, and envelope formatting pass")
  assert(computeExpectedRpcResponses(12, 3) == 9, "12 batch items - 3 notifications == 9 expected responses")
  assert(encodeJsonRpcErrorMetric(32601, 0) == 326010, "32601 * 10 + 0 == 326010")
  assert(describeJsonRpcErrorCode(32601) == "RPC:METHOD_NOT_FOUND_32601", "JSON-RPC -32601 method not found label")
  ret 0

pub fn main(): int:
  test_net_rpc_jsonrpc2_dispatcher_cli()
  println("PASS: ex_126_net_rpc_jsonrpc2_dispatcher_cli_test")
  ret 0
