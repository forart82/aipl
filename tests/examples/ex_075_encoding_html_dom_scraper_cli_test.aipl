// ============================================================================
// Twin Test Suite 075: HTML5 DOM Selector Scraper & XSS Sanitizer (CLI)
// Verifies examples/ex_075_encoding_html_dom_scraper_cli.aipl
// ============================================================================
module Ex075EncodingHtmlDomScraperCliTest

import {
  scrapeHtmlCardInnerTextAndRole,
  verifyHtmlSanitizerAndSelectors,
  describeHtmlSanitizeVerdict
} from "../../examples/ex_075_encoding_html_dom_scraper_cli.aipl"

pub fn test_encoding_html_dom_scraper_cli(): int:
  assert(scrapeHtmlCardInnerTextAndRole() == "panel:Hello", "extracts data-role='panel' and innerText='Hello'")
  assert(verifyHtmlSanitizerAndSelectors() == 1, "querySelector, getElementsByClassName, and sanitizeUrl pass")
  assert(describeHtmlSanitizeVerdict("about:blank") == "HTML:XSS_URI_NEUTRALIZED", "javascript URI sanitized to about:blank")
  ret 0

pub fn main(): int:
  test_encoding_html_dom_scraper_cli()
  println("PASS: ex_075_encoding_html_dom_scraper_cli_test")
  ret 0
