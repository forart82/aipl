// ============================================================================
// Twin Test Suite 137: Mouse Brush Drawing & Wheel Zoom Inspector (WINDOW)
// Verifies examples/ex_137_input_mouse_drawing_and_wheel_zoom_window.aipl
// ============================================================================
module Ex137InputMouseDrawingAndWheelZoomWindowTest

import {
  verifyMouseDeltaScrollAndButtons,
  computeWheelZoomPercent,
  describeMouseBrushTool,
  renderFrameStep
} from "../../examples/ex_137_input_mouse_drawing_and_wheel_zoom_window.aipl"

pub fn test_input_mouse_drawing_and_wheel_zoom_window(): int:
  assert(verifyMouseDeltaScrollAndButtons() == 203, "dx(120) + dy(80) + scrollY(3) == 203")
  assert(computeWheelZoomPercent(100, 3) == 175, "100% + 3 * 25% == 175% zoom")
  assert(describeMouseBrushTool(175) == "MOUSE:BRUSH_ZOOM_175PCT", "175% brush zoom label")
  let f0 = renderFrameStep(0, 0.016)
  let f1 = renderFrameStep(1, 0.016)
  let f20 = renderFrameStep(20, 0.016)
  let f100 = renderFrameStep(100, 0.016)
  assert(f0 == 1000, "frame 0 starts at 100% zoom via MouseState scrollDeltaY")
  assert(f1 > f0, "frame 1 advances brush head position via MouseState")
  assert(f20 > f1, "frame 20 increases wheel zoom percent via MouseState")
  assert(f100 > f20, "frame 100 continues advancing wheel zoom and brush trail")
  ret 0

pub fn main(): int:
  test_input_mouse_drawing_and_wheel_zoom_window()
  println("PASS: ex_137_input_mouse_drawing_and_wheel_zoom_window_test")
  ret 0
