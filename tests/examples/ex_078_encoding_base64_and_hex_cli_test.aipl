// ============================================================================
// Twin Test Suite 078: Hex, Base64, Base64URL, Base62 & Crockford Base32 (CLI)
// Verifies examples/ex_078_encoding_base64_and_hex_cli.aipl
// ============================================================================
module Ex078EncodingBase64AndHexCliTest

import {
  evaluateMultiRadixEncodedLengths,
  verifyAllRadixCodecRoundTrips,
  describeRadixAlphabetVariant
} from "../../examples/ex_078_encoding_base64_and_hex_cli.aipl"

pub fn test_encoding_base64_and_hex_cli(): int:
  assert(evaluateMultiRadixEncodedLengths("AIPL-2026") == 30, "9-byte input -> 18 hex chars + 12 base64 chars == 30")
  assert(verifyAllRadixCodecRoundTrips() == 1, "Hex, Base64, Base64Url, Base62, CrockfordBase32, and URL percent codecs round-trip")
  assert(describeRadixAlphabetVariant(64) == "RADIX:RFC4648_BASE64_PADDED", "radix 64 label")
  ret 0

pub fn main(): int:
  test_encoding_base64_and_hex_cli()
  println("PASS: ex_078_encoding_base64_and_hex_cli_test")
  ret 0
