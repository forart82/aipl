// ============================================================================
// Twin Test Suite 047: Binary Min/Max Heaps & Decrease-Key Task Scheduler (CLI)
// Verifies examples/ex_047_collections_priority_queue_scheduler_cli.aipl
// ============================================================================
module Ex047CollectionsPriorityQueueSchedulerCliTest

import {
  scheduleMinAndMaxHeapTasks,
  verifyDecreaseKeyPriorityPromotion,
  describeSchedulerHeapKind
} from "../../examples/ex_047_collections_priority_queue_scheduler_cli.aipl"

pub fn test_min_max_heap_and_decrease_key(): int:
  assert(scheduleMinAndMaxHeapTasks() == "irq_handler:render_frame", "minHeap pops irq_handler(10) and maxHeap pops render_frame(90)")
  assert(verifyDecreaseKeyPriorityPromotion() == 101, "task 101 promoted from cost 50 to cost 5 pops first")
  assert(describeSchedulerHeapKind(0) == "HEAP:BINARY_MIN_MAX_AND_INDEXED_PQ", "kind 0")
  ret 0

pub fn main(): int:
  test_min_max_heap_and_decrease_key()
  println("PASS: ex_047_collections_priority_queue_scheduler_cli_test")
  ret 0
