// ============================================================================
// Twin Test Suite 111: Mutex Guard, SpinLock & CondVar Shared Ledger (CLI)
// Verifies examples/ex_111_sync_mutex_shared_ledger_cli.aipl
// ============================================================================
module Ex111SyncMutexSharedLedgerCliTest

import {
  evaluateProtectedLedgerBalance,
  verifySpinLockAndCondVarWakeup,
  describeMutexContentionState
} from "../../examples/ex_111_sync_mutex_shared_ledger_cli.aipl"

pub fn test_sync_mutex_shared_ledger_cli(): int:
  assert(evaluateProtectedLedgerBalance(500, 250, 120) == 630, "500 + 250 - 120 == 630 under Mutex critical sections")
  assert(verifySpinLockAndCondVarWakeup() == 1, "spinLockAcquire/Release and condVarSignal/WaitTimeout/Broadcast pass")
  assert(describeMutexContentionState(true) == "MUTEX:EXCLUSIVE_GUARD_HELD", "locked mutex descriptor")
  ret 0

pub fn main(): int:
  test_sync_mutex_shared_ledger_cli()
  println("PASS: ex_111_sync_mutex_shared_ledger_cli_test")
  ret 0
