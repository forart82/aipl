// ============================================================================
// Twin Test Suite 146: PAK1 Asset Bundle TOC & Archive Viewer (WINDOW)
// Verifies examples/ex_146_asset_bundle_pak_archive_viewer_window.aipl
// ============================================================================
module Ex146AssetBundlePakArchiveViewerWindowTest

import {
  verifyPakAssetBundleTocAndExtraction,
  computeBundleCompressionSavingsPct,
  describePakBundleHeader,
  renderFrameStep
} from "../../examples/ex_146_asset_bundle_pak_archive_viewer_window.aipl"

pub fn test_asset_bundle_pak_archive_viewer_window(): int:
  assert(verifyPakAssetBundleTocAndExtraction() == 266, "extracted 'ABCD' bytes (65+66+67+68) == 266 and PAK1 magic header opens")
  assert(computeBundleCompressionSavingsPct(400, 1000) == 60, "(1000 - 400) * 100 / 1000 == 60% savings")
  assert(describePakBundleHeader(1) == "PAK:MAGIC_PAK1_TOC_INDEXED", "PAK1 magic header label")
  let f0 = renderFrameStep(0, 0.016)
  let f1 = renderFrameStep(1, 0.016)
  let f20 = renderFrameStep(20, 0.016)
  let f100 = renderFrameStep(100, 0.016)
  assert(f0 > 266, "frame 0 extracts active bundle entry payload bytes")
  assert(f0 != f1, "archive byte stream cursor advances between frame 0 and frame 1")
  assert(f1 != f20, "extracted bundle entry payload advances between frame 1 and frame 20")
  assert(f20 != f100, "extracted bundle entry payload advances between frame 20 and frame 100")
  ret 0

pub fn main(): int:
  test_asset_bundle_pak_archive_viewer_window()
  println("PASS: ex_146_asset_bundle_pak_archive_viewer_window_test")
  ret 0
