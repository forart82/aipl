// ============================================================================
// Twin Test Suite 083: RFC-1952 Gzip, RFC-1950 Zlib & CRC32/Adler32 Tool (CLI)
// Verifies examples/ex_083_compress_gzip_crc32_tool_cli.aipl
// ============================================================================
module Ex083CompressGzipCrc32ToolCliTest

import {
  evaluateGzipAndZlibHeaderBytesSum,
  verifyGzipZlibAndChecksumsRoundTrip,
  describeGzipHeaderMagic
} from "../../examples/ex_083_compress_gzip_crc32_tool_cli.aipl"

pub fn test_compress_gzip_crc32_tool_cli(): int:
  assert(evaluateGzipAndZlibHeaderBytesSum() == 290, "gzip magic 31 + 139 + zlib header 120 == 290")
  assert(verifyGzipZlibAndChecksumsRoundTrip() == 1, "gzip/zlib round-trip and non-zero CRC32/Adler32")
  assert(describeGzipHeaderMagic(31, 139) == "GZIP:RFC1952_MAGIC_1F8B_OK", "0x1F 0x8B magic verified")
  ret 0

pub fn main(): int:
  test_compress_gzip_crc32_tool_cli()
  println("PASS: ex_083_compress_gzip_crc32_tool_cli_test")
  ret 0
