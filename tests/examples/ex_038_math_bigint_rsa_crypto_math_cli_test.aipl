// ============================================================================
// Twin Test Suite 038: Multi-Limb BigInt (>64-bit) & Modular Arithmetic (CLI)
// Verifies examples/ex_038_math_bigint_rsa_crypto_math_cli.aipl
// ============================================================================
module Ex038MathBigintRsaCryptoMathCliTest

import {
  verifyMultiLimbBigIntAddSub,
  verifyMultiLimbBigIntMulDivMod,
  describeBigIntPrecision
} from "../../examples/ex_038_math_bigint_rsa_crypto_math_cli.aipl"

pub fn test_bigint_multi_limb_operations(): int:
  assert(verifyMultiLimbBigIntAddSub() == "3500000000000000000000000000", "28-digit >64-bit BigInt addition")
  assert(verifyMultiLimbBigIntMulDivMod() == 7, "25-digit product div/mod remainder == 7")
  assert(describeBigIntPrecision(4) == "BIGINT:MULTI_LIMB_ARBITRARY_PRECISION", "4 limbs")
  ret 0

pub fn main(): int:
  test_bigint_multi_limb_operations()
  println("PASS: ex_038_math_bigint_rsa_crypto_math_cli_test")
  ret 0
