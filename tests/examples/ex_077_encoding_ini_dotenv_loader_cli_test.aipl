// ============================================================================
// Twin Test Suite 077: INI Configuration & DotEnv Schema Validator (CLI)
// Verifies examples/ex_077_encoding_ini_dotenv_loader_cli.aipl
// ============================================================================
module Ex077EncodingIniDotenvLoaderCliTest

import {
  extractIniHostAndEnvMode,
  verifyDotEnvSchemaAndIniRoundTrip,
  describeDotEnvSchemaVerdict
} from "../../examples/ex_077_encoding_ini_dotenv_loader_cli.aipl"

pub fn test_encoding_ini_dotenv_loader_cli(): int:
  assert(extractIniHostAndEnvMode() == "127.0.0.1:prod", "extracts INI db.host and DotEnv MODE")
  assert(verifyDotEnvSchemaAndIniRoundTrip() == 1, "validateDotEnvSchema and serializeIni pass")
  assert(describeDotEnvSchemaVerdict(true) == "DOTENV:SCHEMA_VALIDATED_OK", "schema valid verdict")
  ret 0

pub fn main(): int:
  test_encoding_ini_dotenv_loader_cli()
  println("PASS: ex_077_encoding_ini_dotenv_loader_cli_test")
  ret 0
