// ============================================================================
// Twin Test Suite 098: Stream Adapters (Chain, Take, Tee) & Zero-Copy Pipe (CLI)
// Verifies examples/ex_098_io_copy_and_stream_pipe_cli.aipl
// ============================================================================
module Ex098IoCopyAndStreamPipeCliTest

import {
  evaluateChainTakeAndTeeByteCounts,
  verifyCursorCopySinkAndRepeat,
  describeStreamPipeTopology
} from "../../examples/ex_098_io_copy_and_stream_pipe_cli.aipl"

pub fn test_io_copy_and_stream_pipe_cli(): int:
  assert(evaluateChainTakeAndTeeByteCounts() == 12, "chained(6) + taken(3) + teeCopied(3) == 12")
  assert(verifyCursorCopySinkAndRepeat() == 1, "ioCopyCursor, ioCopyLimited, ioSinkWrite, ioEmptyRead, and ioRepeatRead pass")
  assert(describeStreamPipeTopology(true) == "PIPE:DUAL_TEE_FANOUT_ACTIVE", "dual tee fanout descriptor")
  ret 0

pub fn main(): int:
  test_io_copy_and_stream_pipe_cli()
  println("PASS: ex_098_io_copy_and_stream_pipe_cli_test")
  ret 0
