// ============================================================================
// Twin Test Suite 059: UTF-8 Codepoint Codec, East-Asian Width & Graphemes (CLI)
// Verifies examples/ex_059_fmt_unicode_utf8_inspector_cli.aipl
// ============================================================================
module Ex059FmtUnicodeUtf8InspectorCliTest

import {
  verifyUtf8RuneRoundtripAndByteLen,
  evaluateEastAsianDisplayWidthAndClusters,
  describeUtf8EncodingPlane
} from "../../examples/ex_059_fmt_unicode_utf8_inspector_cli.aipl"

pub fn test_utf8_rune_and_display_width(): int:
  // Rune 19990 ('世') encodes to 3 UTF-8 bytes -> 19990 + 3 == 19993
  assert(verifyUtf8RuneRoundtripAndByteLen(19990) == 19993, "decoded rune(19990) + byteLen(3) == 19993")
  // "A世" has 2 codepoints + displayWidth 3 + 2 grapheme clusters == 7
  assert(evaluateEastAsianDisplayWidthAndClusters() == 7, "codepointCount(2) + displayWidth(3) + graphemes(2) == 7")
  assert(describeUtf8EncodingPlane(3) == "UTF8:BMP_3BYTE_CJK_PLANE", "3-byte UTF-8")
  ret 0

pub fn main(): int:
  test_utf8_rune_and_display_width()
  println("PASS: ex_059_fmt_unicode_utf8_inspector_cli_test")
  ret 0
