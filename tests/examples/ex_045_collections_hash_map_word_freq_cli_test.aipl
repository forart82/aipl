// ============================================================================
// Twin Test Suite 045: HashMap Word Frequency, HashSet & LRU Eviction (CLI)
// Verifies examples/ex_045_collections_hash_map_word_freq_cli.aipl
// ============================================================================
module Ex045CollectionsHashMapWordFreqCliTest

import {
  countWordFrequencyAndUniqueSet,
  verifyLruCacheEvictionPolicy,
  describeHashTableCollisionPolicy
} from "../../examples/ex_045_collections_hash_map_word_freq_cli.aipl"

pub fn test_word_frequency_and_lru_eviction(): int:
  // Words ["aipl", "fast", "aipl", "safe", "aipl"] -> "aipl" freq(3) + unique set len(3) == 6
  assert(countWordFrequencyAndUniqueSet() == 6, "freq('aipl')==3 + unique words(3) == 6")
  assert(verifyLruCacheEvictionPolicy() == 103, "LRU keeps 'a'(100) and 'c'(3) while evicting 'b'")
  assert(describeHashTableCollisionPolicy(0) == "HASHMAP:ROBIN_HOOD_OPEN_ADDRESSING", "policy 0")
  ret 0

pub fn main(): int:
  test_word_frequency_and_lru_eviction()
  println("PASS: ex_045_collections_hash_map_word_freq_cli_test")
  ret 0
