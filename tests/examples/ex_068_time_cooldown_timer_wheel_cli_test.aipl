// ============================================================================
// Twin Test Suite 068: Cooldown Timer, Repeating Ticker & Debounce Wheel (CLI)
// Verifies examples/ex_068_time_cooldown_timer_wheel_cli.aipl
// ============================================================================
module Ex068TimeCooldownTimerWheelCliTest

import {
  simulateCooldownRemainingMsAt,
  pollRepeatingTickerAndDebounce,
  describeCooldownReadiness
} from "../../examples/ex_068_time_cooldown_timer_wheel_cli.aipl"

pub fn test_time_cooldown_timer_wheel_cli(): int:
  assert(simulateCooldownRemainingMsAt(50, 1000, 1025) == 25, "50ms cooldown triggered at 1000ms has 25ms left at 1025ms")
  assert(pollRepeatingTickerAndDebounce(20, 30, 1000, 1060) == 4, "3 repeating ticks (60/20) + 1 debounce ready == 4")
  assert(describeCooldownReadiness(0) == "COOLDOWN:READY_TO_FIRE", "0ms remaining is ready")
  assert(describeCooldownReadiness(25) == "COOLDOWN:RECHARGING", "25ms remaining is recharging")
  ret 0

pub fn main(): int:
  test_time_cooldown_timer_wheel_cli()
  println("PASS: ex_068_time_cooldown_timer_wheel_cli_test")
  ret 0
