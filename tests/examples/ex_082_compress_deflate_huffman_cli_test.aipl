// ============================================================================
// Twin Test Suite 082: RFC-1951 DEFLATE, LZ77 Sliding Window & Huffman Tree (CLI)
// Verifies examples/ex_082_compress_deflate_huffman_cli.aipl
// ============================================================================
module Ex082CompressDeflateHuffmanCliTest

import {
  evaluateHuffmanCodeLenCountAndMax,
  verifyDeflateAndLz77RoundTrip,
  describeDeflateCompressionLevel
} from "../../examples/ex_082_compress_deflate_huffman_cli.aipl"

pub fn test_compress_deflate_huffman_cli(): int:
  assert(evaluateHuffmanCodeLenCountAndMax() >= 5, "4 Huffman symbols + maxLen >= 1 -> >= 5")
  assert(verifyDeflateAndLz77RoundTrip() == 1, "lz77FindMatches and deflateCompress/deflateDecompress roundtrip exact")
  assert(describeDeflateCompressionLevel(6) == "DEFLATE:RFC1951_DYNAMIC_HUFFMAN_L6", "level 6 descriptor")
  ret 0

pub fn main(): int:
  test_compress_deflate_huffman_cli()
  println("PASS: ex_082_compress_deflate_huffman_cli_test")
  ret 0
