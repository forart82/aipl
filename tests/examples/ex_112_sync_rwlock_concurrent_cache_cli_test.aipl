// ============================================================================
// Twin Test Suite 112: RwLock Shared-Reader Cache & Optimistic SeqLock (CLI)
// Verifies examples/ex_112_sync_rwlock_concurrent_cache_cli.aipl
// ============================================================================
module Ex112SyncRwlockConcurrentCacheCliTest

import {
  evaluateConcurrentReaderPeakCount,
  verifyRwLockWriterExclusionAndSeqLockRetry,
  describeCacheConcurrencyMode
} from "../../examples/ex_112_sync_rwlock_concurrent_cache_cli.aipl"

pub fn test_sync_rwlock_concurrent_cache_cli(): int:
  assert(evaluateConcurrentReaderPeakCount() == 2, "2 shared readers active simultaneously before unlock")
  assert(verifyRwLockWriterExclusionAndSeqLockRetry() == 1, "writer exclusion during reads and optimistic SeqLock retry detection pass")
  assert(describeCacheConcurrencyMode(true) == "CACHE:OPTIMISTIC_SEQLOCK_READ", "optimistic seqlock descriptor")
  ret 0

pub fn main(): int:
  test_sync_rwlock_concurrent_cache_cli()
  println("PASS: ex_112_sync_rwlock_concurrent_cache_cli_test")
  ret 0
