// ============================================================================
// Twin Test Suite 039: Deterministic Fixed-Point Q16.16 & Q32.32 Math (CLI)
// Verifies examples/ex_039_math_fixed_point_q16_16_cli.aipl
// ============================================================================
module Ex039MathFixedPointQ1616CliTest

import {
  evaluateFixedQ16ArithmeticMilli,
  evaluateFixedQ32Balance,
  describeFixedPointFormat
} from "../../examples/ex_039_math_fixed_point_q16_16_cli.aipl"

pub fn test_fixed_q16_and_q32_arithmetic(): int:
  // (5 * 3) + (5 / 2.0) + |-3.0| == 15 + 2.5 + 3.0 == 20.5 -> 20500 milli
  assert(evaluateFixedQ16ArithmeticMilli(5, -3.0) == 20500, "Q16.16 mul + div + abs == 20500 milli")
  assert(evaluateFixedQ32Balance(10, 4) == 20, "(10 + 4) + (10 - 4) == 20")
  assert(describeFixedPointFormat(16) == "FIXED:Q16_16_DETERMINISTIC_LOCKSTEP", "Q16.16")
  assert(describeFixedPointFormat(32) == "FIXED:Q32_32_HIGH_RANGE", "Q32.32")
  ret 0

pub fn main(): int:
  test_fixed_q16_and_q32_arithmetic()
  println("PASS: ex_039_math_fixed_point_q16_16_cli_test")
  ret 0
