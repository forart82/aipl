// ============================================================================
// Twin Test Suite 119: TCP Echo Stream & Length-Prefixed Framing (CLI)
// Verifies examples/ex_119_net_tcp_echo_and_framing_cli.aipl
// ============================================================================
module Ex119NetTcpEchoAndFramingCliTest

import {
  verifyTcpEchoStreamAndSocketOptions,
  encodeLengthPrefixedFrameSize,
  describeTcpSocketTuning
} from "../../examples/ex_119_net_tcp_echo_and_framing_cli.aipl"

pub fn test_net_tcp_echo_and_framing_cli(): int:
  assert(verifyTcpEchoStreamAndSocketOptions() == 4, "TCP listen/accept/connect writes & reads 4-byte framed payload")
  assert(encodeLengthPrefixedFrameSize(256, 4) == 260, "256-byte body + 4-byte length header == 260")
  assert(describeTcpSocketTuning(1, 5000) == "TCP:NODELAY_ON_KEEPALIVE_5000MS", "TCP socket tuning label")
  ret 0

pub fn main(): int:
  test_net_tcp_echo_and_framing_cli()
  println("PASS: ex_119_net_tcp_echo_and_framing_cli_test")
  ret 0
