// ============================================================================
// Twin Test Suite 030: Mat3/Mat4 Affine Transforms, LookAt & Inversion (CLI)
// Verifies examples/ex_030_math_mat3_mat4_transforms_cli.aipl
// ============================================================================
module Ex030MathMat3Mat4TransformsCliTest

import {
  verifyMat3DeterminantAndTransform,
  verifyMat4AffineInverseRoundtrip,
  verifyCameraViewProjectionMatrix,
  describeMatrixSpace
} from "../../examples/ex_030_math_mat3_mat4_transforms_cli.aipl"

pub fn test_mat3_and_mat4_affine_roundtrip(): int:
  assert(verifyMat3DeterminantAndTransform(2.0, 3.0, 4.0) == 9, "Mat3 identity transforms (2, 3, 4) with sum 9 and det 1")
  assert(verifyMat4AffineInverseRoundtrip(10.0, 20.0, 30.0) == 66, "translated (1,2,3) -> (11,22,33) sum=66 and inverse restores (1,2,3)")
  ret 0

pub fn test_camera_view_projection(): int:
  assert(verifyCameraViewProjectionMatrix() == 1, "Mat4.lookAt and Mat4.perspective produce valid non-singular matrices")
  assert(describeMatrixSpace(4) == "MAT4:HOMOGENEOUS_AFFINE_3D", "4x4 matrix")
  ret 0

pub fn main(): int:
  test_mat3_and_mat4_affine_roundtrip()
  test_camera_view_projection()
  println("PASS: ex_030_math_mat3_mat4_transforms_cli_test")
  ret 0
