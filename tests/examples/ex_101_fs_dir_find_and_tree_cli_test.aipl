// ============================================================================
// Twin Test Suite 101: Directory Walker, Glob Filter & TempDir Cleanup (CLI)
// Verifies examples/ex_101_fs_dir_find_and_tree_cli.aipl
// ============================================================================
module Ex101FsDirFindAndTreeCliTest

import {
  evaluateVisibleAndGlobMatchedEntryCounts,
  verifyDirSortingWildcardAndTempCleanup,
  describeDirWalkFilterMode
} from "../../examples/ex_101_fs_dir_find_and_tree_cli.aipl"

pub fn test_fs_dir_find_and_tree_cli(): int:
  assert(evaluateVisibleAndGlobMatchedEntryCounts() == 5, "3 visible non-hidden entries + 2 *.aipl matches == 5")
  assert(verifyDirSortingWildcardAndTempCleanup() == 1, "fsDirSortByName, ? wildcard glob, and fsTempDirCleanup pass")
  assert(describeDirWalkFilterMode(false) == "WALK:SKIP_HIDDEN_DOTFILES", "includeHidden=false descriptor")
  ret 0

pub fn main(): int:
  test_fs_dir_find_and_tree_cli()
  println("PASS: ex_101_fs_dir_find_and_tree_cli_test")
  ret 0
