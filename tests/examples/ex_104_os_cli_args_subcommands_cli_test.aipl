// ============================================================================
// Twin Test Suite 104: CLI Argument Parser, Subcommands & Shell Completion (CLI)
// Verifies examples/ex_104_os_cli_args_subcommands_cli.aipl
// ============================================================================
module Ex104OsCliArgsSubcommandsCliTest

import {
  evaluateParsedSubcommandAndOptLevel,
  verifyCliHelpCompletionsAndClusteredFlags,
  describeCliSubcommandDispatch
} from "../../examples/ex_104_os_cli_args_subcommands_cli.aipl"

pub fn test_os_cli_args_subcommands_cli(): int:
  assert(evaluateParsedSubcommandAndOptLevel() == "test:3:src/main.aipl", "parses subcommand test, opt-level 3, and positional src/main.aipl")
  assert(verifyCliHelpCompletionsAndClusteredFlags() == 1, "help, bash/zsh completions, and clustered -ab short flags pass")
  assert(describeCliSubcommandDispatch("test") == "CLI:SUBCOMMAND_TEST_SUITE", "test subcommand dispatch label")
  ret 0

pub fn main(): int:
  test_os_cli_args_subcommands_cli()
  println("PASS: ex_104_os_cli_args_subcommands_cli_test")
  ret 0
