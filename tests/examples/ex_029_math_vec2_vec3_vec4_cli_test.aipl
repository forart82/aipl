// ============================================================================
// Twin Test Suite 029: 2D/3D/4D Vector Algebra & Orthonormal Basis (CLI)
// Verifies examples/ex_029_math_vec2_vec3_vec4_cli.aipl
// ============================================================================
module Ex029MathVec2Vec3Vec4CliTest

import {
  verifyVec2DotCrossAndDisk,
  verifyVec3OrthonormalCrossBasis,
  verifyVec4HomogeneousNormMilli,
  describeVectorSpaceDim
} from "../../examples/ex_029_math_vec2_vec3_vec4_cli.aipl"

pub fn test_vec2_and_vec3_algebra(): int:
  assert(verifyVec2DotCrossAndDisk(3.0, 4.0, 1.0, 2.0) == 18, "dot(11) + cross(2) + len(5) == 18")
  assert(verifyVec3OrthonormalCrossBasis() == 1, "i x j == k with zero dot product")
  ret 0

pub fn test_vec4_homogeneous_norm(): int:
  assert(verifyVec4HomogeneousNormMilli(1.0, 2.0, 2.0, 4.0) == 800, "w / len == 4 / 5 == 0.8 (800 milli)")
  assert(describeVectorSpaceDim(3) == "VEC:R3_EUCLIDEAN_BASIS", "dim 3")
  assert(describeVectorSpaceDim(4) == "VEC:R4_HOMOGENEOUS_CLIP", "dim 4")
  ret 0

pub fn main(): int:
  test_vec2_and_vec3_algebra()
  test_vec4_homogeneous_norm()
  println("PASS: ex_029_math_vec2_vec3_vec4_cli_test")
  ret 0
