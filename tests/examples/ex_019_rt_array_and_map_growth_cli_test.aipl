// ============================================================================
// Twin Test Suite 019: Runtime Array Capacity Growth & Robin-Hood Map Rehash CLI
// Verifies examples/ex_019_rt_array_and_map_growth_cli.aipl
// ============================================================================
module Ex019RtArrayAndMapGrowthCliTest

import {
  RtGrowthReport,
  populateRtArraySum,
  verifyRtMapRehashLookup,
  describeGrowthFactor,
  buildRtGrowthReport
} from "../../examples/ex_019_rt_array_and_map_growth_cli.aipl"

pub fn test_rt_array_push_and_rehash_lookup(): int:
  assert(populateRtArraySum(10, 20, 30) == 60, "rtArrayPush + rtArrayGet sum == 60")
  assert(verifyRtMapRehashLookup(777, 101, 9001) == 9001, "rtMapInsert + rtMapRehash + rtMapFind == 9001")
  ret 0

pub fn test_growth_factor_description(): int:
  assert(describeGrowthFactor(4, 16) == "GROWTH:QUAD_4X", "4 -> 16 is 4x")
  assert(describeGrowthFactor(8, 16) == "GROWTH:DOUBLE_2X", "8 -> 16 is 2x")
  ret 0

pub fn test_build_rt_growth_report(): int:
  let rep = buildRtGrowthReport(10, 20, 30)
  assert(rep.arraySum == 60, "arraySum == 60")
  assert(rep.mapSize == 2, "rtMapSize == 2")
  assert(rep.rehashedVal == 5001, "rehashedVal == 5001")
  assert(rep.statusTag == "GROWTH:DOUBLE_2X", "statusTag")
  ret 0

pub fn main(): int:
  test_rt_array_push_and_rehash_lookup()
  test_growth_factor_description()
  test_build_rt_growth_report()
  println("PASS: ex_019_rt_array_and_map_growth_cli_test")
  ret 0
