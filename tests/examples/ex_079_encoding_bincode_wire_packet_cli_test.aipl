// ============================================================================
// Twin Test Suite 079: Bincode Binary Wire Packet & BitStream Serializer (CLI)
// Verifies examples/ex_079_encoding_bincode_wire_packet_cli.aipl
// ============================================================================
module Ex079EncodingBincodeWirePacketCliTest

import {
  roundTripBincodeWirePacketSum,
  verifyBitStreamAndIntArrayPack,
  describeBincodeEndianMode
} from "../../examples/ex_079_encoding_bincode_wire_packet_cli.aipl"

pub fn test_encoding_bincode_wire_packet_cli(): int:
  assert(roundTripBincodeWirePacketSum() == 550, "u8(250) + varInt(300) == 550 after full wire packet round-trip")
  assert(verifyBitStreamAndIntArrayPack() == 1, "bitStream 4+4 bits == 90 and bincodePackIntArray round-trip")
  assert(describeBincodeEndianMode(true) == "BINCODE:LITTLE_ENDIAN_LEB128", "little-endian descriptor")
  ret 0

pub fn main(): int:
  test_encoding_bincode_wire_packet_cli()
  println("PASS: ex_079_encoding_bincode_wire_packet_cli_test")
  ret 0
