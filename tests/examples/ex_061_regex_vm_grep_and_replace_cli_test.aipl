// ============================================================================
// Twin Test Suite 061: PikeVM Regex Grep, Capture Groups & Replace (CLI)
// Verifies examples/ex_061_regex_vm_grep_and_replace_cli.aipl
// ============================================================================
module Ex061RegexVmGrepAndReplaceCliTest

import {
  rewriteIsoDateWithCaptures,
  countGrepDigitMatchesAndSplit,
  describePikeVmComplexity
} from "../../examples/ex_061_regex_vm_grep_and_replace_cli.aipl"

pub fn test_regex_captures_and_grep(): int:
  assert(rewriteIsoDateWithCaptures("Release: 2026-11-06 OK") == "Release: 06/11/2026 OK", "capture group $3/$2/$1 reorder")
  // findAll("a12b345c6") -> 3 matches + split("a,b;;c,d") -> 4 tokens == 7
  assert(countGrepDigitMatchesAndSplit() == 7, "3 digit matches + 4 split tokens == 7")
  assert(describePikeVmComplexity(0) == "PIKE_VM:LINEAR_TIME_NO_REDOS", "PikeVM linear time")
  ret 0

pub fn main(): int:
  test_regex_captures_and_grep()
  println("PASS: ex_061_regex_vm_grep_and_replace_cli_test")
  ret 0
