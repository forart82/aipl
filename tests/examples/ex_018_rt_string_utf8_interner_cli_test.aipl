// ============================================================================
// Twin Test Suite 018: Runtime String Interning, FNV Hashing & Raw UTF-8 CLI
// Verifies examples/ex_018_rt_string_utf8_interner_cli.aipl
// ============================================================================
module Ex018RtStringUtf8InternerCliTest

import {
  InternerStats,
  verifyStringDeduplication,
  convertIntViaRtStr,
  classifyInternTableLoad,
  buildInternerStats
} from "../../examples/ex_018_rt_string_utf8_interner_cli.aipl"

pub fn test_intern_deduplication_and_int_to_str(): int:
  assert(verifyStringDeduplication(0x4142434445464748) == true, "identical 8-byte words intern to same ID and hash")
  assert(convertIntViaRtStr(98765) == 5, "rtIntToStr(98765) has length 5")
  ret 0

pub fn test_intern_table_load_classification(): int:
  assert(classifyInternTableLoad(4, 16) == "INTERN:LOW_LOAD", "25% load")
  assert(classifyInternTableLoad(14, 16) == "INTERN:NEAR_CAPACITY", ">= 75% load")
  ret 0

pub fn test_build_interner_stats(): int:
  let st = buildInternerStats(16, 123456)
  assert(st.deduplicated == true, "deduplicated == true")
  assert(st.equalCompare == 0, "rtStringCompare == 0")
  assert(st.formattedDigits == 6, "rtIntToStr(123456) length == 6")
  assert(st.tableBuckets == 16, "tableBuckets == 16")
  ret 0

pub fn main(): int:
  test_intern_deduplication_and_int_to_str()
  test_intern_table_load_classification()
  test_build_interner_stats()
  println("PASS: ex_018_rt_string_utf8_interner_cli_test")
  ret 0
