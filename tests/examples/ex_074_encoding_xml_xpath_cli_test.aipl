// ============================================================================
// Twin Test Suite 074: XML DOM Tree Parser & Element Query Inspector (CLI)
// Verifies examples/ex_074_encoding_xml_xpath_cli.aipl
// ============================================================================
module Ex074EncodingXmlXpathCliTest

import {
  extractXmlCatalogBookTitle,
  verifyXmlEntitiesAndSerialization,
  describeXmlQueryStatus
} from "../../examples/ex_074_encoding_xml_xpath_cli.aipl"

pub fn test_encoding_xml_xpath_cli(): int:
  assert(extractXmlCatalogBookTitle() == "b1:AIPL Guide", "extracts book id b1 and title AIPL Guide")
  assert(verifyXmlEntitiesAndSerialization() == 1, "encodeXmlEntities, decodeXmlEntities, and serializeXml roundtrip")
  assert(describeXmlQueryStatus(1) == "XML:DOM_ELEMENT_FOUND", "element found status")
  ret 0

pub fn main(): int:
  test_encoding_xml_xpath_cli()
  println("PASS: ex_074_encoding_xml_xpath_cli_test")
  ret 0
