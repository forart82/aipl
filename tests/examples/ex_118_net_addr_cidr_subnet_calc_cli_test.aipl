// ============================================================================
// Twin Test Suite 118: IPv4/IPv6, CIDR Subnet & URL Parser Calculator (CLI)
// Verifies examples/ex_118_net_addr_cidr_subnet_calc_cli.aipl
// ============================================================================
module Ex118NetAddrCidrSubnetCalcCliTest

import {
  verifyIpv4Ipv6CidrAndUrlRoundtrip,
  evaluateUsableSubnetHostCapacity,
  describeCidrPrefixClass
} from "../../examples/ex_118_net_addr_cidr_subnet_calc_cli.aipl"

pub fn test_net_addr_cidr_subnet_calc_cli(): int:
  assert(verifyIpv4Ipv6CidrAndUrlRoundtrip() == 8443, "IPv4/IPv6/CIDR/URL roundtrip returns parsed URL port 8443")
  assert(evaluateUsableSubnetHostCapacity(24) == 254, "/24 subnet has 254 usable host addresses")
  assert(describeCidrPrefixClass(24) == "NET:SUBNET_SLASH_24", "CIDR /24 label")
  ret 0

pub fn main(): int:
  test_net_addr_cidr_subnet_calc_cli()
  println("PASS: ex_118_net_addr_cidr_subnet_calc_cli_test")
  ret 0
