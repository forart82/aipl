// ============================================================================
// Twin Test Suite 088: RFC-2104 HMAC-SHA256/512 & Constant-Time JWT Verifier (CLI)
// Verifies examples/ex_088_crypto_hmac_jwt_token_cli.aipl
// ============================================================================
module Ex088CryptoHmacJwtTokenCliTest

import {
  evaluateHmacSha256And512LengthsSum,
  verifyJwtHmacAndConstantTimeMac,
  describeJwtMacVerificationStatus
} from "../../examples/ex_088_crypto_hmac_jwt_token_cli.aipl"

pub fn test_crypto_hmac_jwt_token_cli(): int:
  assert(evaluateHmacSha256And512LengthsSum("secret", "hello") == 96, "32-byte HMAC-SHA256 + 64-byte HMAC-SHA512 == 96")
  assert(verifyJwtHmacAndConstantTimeMac() == 1, "RFC-2104 HMAC-SHA256 vector and constantTimeEqualStr verification pass")
  assert(describeJwtMacVerificationStatus(true) == "JWT:HS256_CONSTANT_TIME_VERIFIED", "HS256 verified descriptor")
  ret 0

pub fn main(): int:
  test_crypto_hmac_jwt_token_cli()
  println("PASS: ex_088_crypto_hmac_jwt_token_cli_test")
  ret 0
