// ============================================================================
// Twin Test Suite 108: ANSI TrueColor Terminal Table, ProgressBar & Sparkline (CLI)
// Verifies examples/ex_108_os_ansi_term_dashboard_cli.aipl
// ============================================================================
module Ex108OsAnsiTermDashboardCliTest

import {
  evaluateVisibleWidthAndSparklineLen,
  verifyTermTableProgressBarAndSpinner,
  describeAnsiColorCapability
} from "../../examples/ex_108_os_ansi_term_dashboard_cli.aipl"

pub fn test_os_ansi_term_dashboard_cli(): int:
  assert(evaluateVisibleWidthAndSparklineLen() == 11, "visibleWidth('Dashboard')(9) + sparklineLen(4) - 2 == 11")
  assert(verifyTermTableProgressBarAndSpinner() == 1, "termTableRender, progressBarUpdate/Finish, and spinnerTick/Finish pass")
  assert(describeAnsiColorCapability(24) == "TERM:TRUECOLOR_24BIT_RGB", "24-bit TrueColor capability")
  ret 0

pub fn main(): int:
  test_os_ansi_term_dashboard_cli()
  println("PASS: ex_108_os_ansi_term_dashboard_cli_test")
  ret 0
