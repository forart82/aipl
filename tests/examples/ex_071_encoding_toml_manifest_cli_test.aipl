// ============================================================================
// Twin Test Suite 071: TOML Project Manifest Parser & Serializer (CLI)
// Verifies examples/ex_071_encoding_toml_manifest_cli.aipl
// ============================================================================
module Ex071EncodingTomlManifestCliTest

import {
  extractTomlServerPortAndScale,
  verifyTomlSectionRoundTrip,
  describeTomlManifestProfile
} from "../../examples/ex_071_encoding_toml_manifest_cli.aipl"

pub fn test_encoding_toml_manifest_cli(): int:
  assert(extractTomlServerPortAndScale() == 8105, "port 8080 + int(ratio 2.5 * 10) == 8105")
  assert(verifyTomlSectionRoundTrip() == 1, "parseTomlSection and toToml round-trip valid")
  assert(describeTomlManifestProfile(true) == "TOML:PROD_SERVER_ENABLED", "enabled true profile")
  ret 0

pub fn main(): int:
  test_encoding_toml_manifest_cli()
  println("PASS: ex_071_encoding_toml_manifest_cli_test")
  ret 0
