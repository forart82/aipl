// ============================================================================
// Twin Test Suite 102: Inode Stat Metadata, Octal Permissions & Disk Usage (CLI)
// Verifies examples/ex_102_fs_metadata_stat_du_cli.aipl
// ============================================================================
module Ex102FsMetadataStatDuCliTest

import {
  evaluateOctalPermsAndFileSizeSum,
  verifyMetadataNodeTypesAndReadOnly,
  describeOctalPermissionMask
} from "../../examples/ex_102_fs_metadata_stat_du_cli.aipl"

pub fn test_fs_metadata_stat_du_cli(): int:
  assert(evaluateOctalPermsAndFileSizeSum() == 2468, "0o644(420) + config.json(2048 bytes) == 2468")
  assert(verifyMetadataNodeTypesAndReadOnly() == 1, "file, dir, symlink metadata predicates and 0o444 read-only check pass")
  assert(describeOctalPermissionMask(292) == "STAT:MODE_0444_IMMUTABLE_RO", "0o444 (292) read-only mask")
  ret 0

pub fn main(): int:
  test_fs_metadata_stat_du_cli()
  println("PASS: ex_102_fs_metadata_stat_du_cli_test")
  ret 0
