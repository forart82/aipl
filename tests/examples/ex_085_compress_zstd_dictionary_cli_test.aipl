// ============================================================================
// Twin Test Suite 085: RFC-8878 Zstandard (Zstd) Frame & FSE Entropy Codec (CLI)
// Verifies examples/ex_085_compress_zstd_dictionary_cli.aipl
// ============================================================================
module Ex085CompressZstdDictionaryCliTest

import {
  evaluateZstdDecompressedLength,
  verifyZstdDualApiAndIntegrity,
  describeZstdEntropyLevel
} from "../../examples/ex_085_compress_zstd_dictionary_cli.aipl"

pub fn test_compress_zstd_dictionary_cli(): int:
  assert(evaluateZstdDecompressedLength("Zstandard modern compression verification payload with FSE entropy") == 66, "decompressed length equals 66 bytes")
  assert(verifyZstdDualApiAndIntegrity() == 1, "zstdCompress/zstdDecompress and compressZstd/decompressZstd match with CRC32")
  assert(describeZstdEntropyLevel(3) == "ZSTD:RFC8878_FSE_LEVEL_3_DEFAULT", "level 3 default descriptor")
  ret 0

pub fn main(): int:
  test_compress_zstd_dictionary_cli()
  println("PASS: ex_085_compress_zstd_dictionary_cli_test")
  ret 0
