// ============================================================================
// Twin Test Suite 080: SemVer 2.0 Parser, Range Matcher & Dependency Solver (CLI)
// Verifies examples/ex_080_encoding_semver_dependency_solver_cli.aipl
// ============================================================================
module Ex080EncodingSemverDependencySolverCliTest

import {
  evaluateSemVerBumpedVersionSum,
  verifySemVerRangeAndPreReleaseOrder,
  describeSemVerCompatibilityVerdict
} from "../../examples/ex_080_encoding_semver_dependency_solver_cli.aipl"

pub fn test_encoding_semver_dependency_solver_cli(): int:
  assert(evaluateSemVerBumpedVersionSum("1.2.3") == 9, "bumpMajor(2) + bumpMinor(3) + bumpPatch(4) == 9")
  assert(verifySemVerRangeAndPreReleaseOrder() == 1, "1.2.3-alpha.1 < 1.2.3 and satisfies '^1.0.0 >=1.2.0'")
  assert(describeSemVerCompatibilityVerdict(true) == "SEMVER:CARET_RANGE_SATISFIED", "caret range satisfied")
  ret 0

pub fn main(): int:
  test_encoding_semver_dependency_solver_cli()
  println("PASS: ex_080_encoding_semver_dependency_solver_cli_test")
  ret 0
