module Ex180Gfx3dSkybox3dPreethamAtmosphereWindowTest

import {
  buildSkybox3dAtmosphereAudit, stepSunDirection
} from "../../examples/ex_180_gfx3d_skybox3d_preetham_atmosphere_window"
import { Vec3 } from "../../std/math/vec_math"
import {
  AtmosphereSettings, computeAtmosphericScattering, sampleEquirectangularUv
} from "../../std/gfx3d/skybox3d"

pub fn test_gfx3d_skybox3d_preetham_atmosphere(): void:
  let atmo = AtmosphereSettings(
    sunDirection = Vec3(x = 0.0, y = 1.0, z = 0.0),
    rayleighCoeff = Vec3(x = 0.058, y = 0.135, z = 0.331),
    mieCoeff = 0.02,
    sunIntensity = 20.0
  )
  let zenithCol = computeAtmosphericScattering(Vec3(x = 0.0, y = 0.8, z = 0.6), atmo)
  assert(zenithCol.z > zenithCol.x, "Rayleigh scattering produces stronger blue channel than red")

  let uvHorizon = sampleEquirectangularUv(Vec3(x = 1.0, y = 0.0, z = 0.0))
  assert(uvHorizon.x >= 0.0 and uvHorizon.x <= 1.0, "Equirectangular U in [0..1]")
  assert(uvHorizon.y > 0.49 and uvHorizon.y < 0.51, "Equirectangular V at horizon y=0 is 0.5")

  let uvNorth = sampleEquirectangularUv(Vec3(x = 0.0, y = 0.0, z = 1.0))
  assert(uvNorth.x > 0.74 and uvNorth.x < 0.76, "Equirectangular U at +Z (0,0,1) preserves Z component (u=0.75)")
  assert(buildSkybox3dAtmosphereAudit() > 70, "buildSkybox3dAtmosphereAudit returns valid Rayleigh + UV score")

  // Multi-frame progression across t=0 -> t=1 -> t=20 -> t=100
  let s0 = stepSunDirection(0)
  let s1 = stepSunDirection(1)
  let s20 = stepSunDirection(20)
  let s100 = stepSunDirection(100)
  assert(s0.y != s1.y or s0.x != s1.x, "Sun direction advances from t=0 to t=1")
  assert(s1.y != s20.y, "Sun elevation advances from t=1 to t=20")
  assert(s20.y != s100.y, "Sun elevation advances from t=20 to t=100 without freezing")

  let uv0 = sampleEquirectangularUv(s0)
  let uv20 = sampleEquirectangularUv(s20)
  let uv100 = sampleEquirectangularUv(s100)
  assert(uv0.x != uv20.x and uv20.x != uv100.x, "Equirectangular sun longitude U evolves across frames")
  assert(uv0.y > 0.5 and uv20.y > 0.5 and uv100.y > 0.5, "Sun remains above horizon across cycle")

pub fn main(): int:
  test_gfx3d_skybox3d_preetham_atmosphere()
  println("PASS: ex_180_gfx3d_skybox3d_preetham_atmosphere_window_test")
  ret 0
