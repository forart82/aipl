// ============================================================================
// Twin Test Suite 049: O(1) SparseSet Dense Component Registry (CLI)
// Verifies examples/ex_049_collections_sparse_set_registry_cli.aipl
// ============================================================================
module Ex049CollectionsSparseSetRegistryCliTest

import {
  evaluateSparseSetSwapRemoveDensity,
  verifySparseSetLookupAndClear,
  describeSparseSetComplexity
} from "../../examples/ex_049_collections_sparse_set_registry_cli.aipl"

pub fn test_sparse_set_density_and_lookup(): int:
  // Insert IDs 42(100), 7(200), 19(300), remove ID 7 -> remaining dense values sum to 400
  assert(evaluateSparseSetSwapRemoveDensity() == 400, "remaining dense payloads after O(1) swap-remove sum to 400")
  assert(verifySparseSetLookupAndClear(42, "hero_actor") == "hero_actor:0", "lookup returns hero_actor and clear resets len to 0")
  assert(describeSparseSetComplexity(0) == "SPARSESET:O1_INSERT_REMOVE_DENSE_ITER", "complexity 0")
  ret 0

pub fn main(): int:
  test_sparse_set_density_and_lookup()
  println("PASS: ex_049_collections_sparse_set_registry_cli_test")
  ret 0
