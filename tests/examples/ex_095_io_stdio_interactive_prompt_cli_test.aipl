// ============================================================================
// Twin Test Suite 095: Standard I/O Descriptors, Prompt Queue & Error Codes (CLI)
// Verifies examples/ex_095_io_stdio_interactive_prompt_cli.aipl
// ============================================================================
module Ex095IoStdioInteractivePromptCliTest

import {
  evaluateStdioDescriptorAndByteCounts,
  verifyInteractivePromptQueueAndErrors,
  describeStdioStreamChannel
} from "../../examples/ex_095_io_stdio_interactive_prompt_cli.aipl"

pub fn test_io_stdio_interactive_prompt_cli(): int:
  assert(evaluateStdioDescriptorAndByteCounts() == 15, "fdSum(0+1+2) + print(2) + println(3) + eprint(3) + eprintln(4) == 15")
  assert(verifyInteractivePromptQueueAndErrors() == 1, "stdioWriteBytes, stdioReadLineMock, and IoError codes verified")
  assert(describeStdioStreamChannel(1) == "STDIO:FD1_STDOUT_BUFFERED", "fd 1 is stdout")
  ret 0

pub fn main(): int:
  test_io_stdio_interactive_prompt_cli()
  println("PASS: ex_095_io_stdio_interactive_prompt_cli_test")
  ret 0
