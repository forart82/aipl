// ============================================================================
// Twin Test Suite 141: Multi-Device Action Map & Key Rebinding Menu (WINDOW)
// Verifies examples/ex_141_input_action_map_rebind_menu_window.aipl
// ============================================================================
module Ex141InputActionMapRebindMenuWindowTest

import {
  verifyCompositeActionMapKeyboardAndGamepad,
  computeTotalBoundChordCount,
  describeActionBindingDevice,
  renderFrameStep
} from "../../examples/ex_141_input_action_map_rebind_menu_window.aipl"

pub fn test_input_action_map_rebind_menu_window(): int:
  assert(verifyCompositeActionMapKeyboardAndGamepad() == 1000, "Jump action fires via both KEY_SPACE and GAMEPAD_A with value 1000 permille")
  assert(computeTotalBoundChordCount(5, 2) == 10, "5 semantic actions * 2 device slots == 10 bindings")
  assert(describeActionBindingDevice(1) == "ACTION:BOUND_KEYBOARD_AND_GAMEPAD", "dual-device binding label")
  let a0 = renderFrameStep(0, 0.016)
  let a1 = renderFrameStep(1, 0.016)
  let a20 = renderFrameStep(20, 0.016)
  let a100 = renderFrameStep(100, 0.016)
  assert(a0 > 1000, "frame 0 evaluates active action map with positive permille signal")
  assert(a0 != a1, "evaluated action map signal advances between frame 0 and frame 1")
  assert(a1 != a20, "evaluated action map signal advances between frame 1 and frame 20")
  assert(a20 != a100, "evaluated action map signal advances between frame 20 and frame 100")
  ret 0

pub fn main(): int:
  test_input_action_map_rebind_menu_window()
  println("PASS: ex_141_input_action_map_rebind_menu_window_test")
  ret 0
