// ============================================================================
// Twin Test Suite 258: Audio Interactive FM Electric Piano & Chords (WINDOW)
// Verifies examples/ex_258_audio_interactive_fm_piano_and_chords_window.aipl
// ============================================================================
module Ex258AudioInteractiveFmPianoAndChordsWindowTest

import {
  describeFmPianoChordVoicing,
  computeFmPianoVoicingNotesHz,
  renderFrameStep
} from "../../examples/ex_258_audio_interactive_fm_piano_and_chords_window.aipl"

pub fn test_audio_interactive_fm_piano_and_chords_window(): int:
  assert(describeFmPianoChordVoicing(0) == "Cmaj9 (C4-E4-G4-B4-D5)", "Cmaj9 voicing label")
  assert(describeFmPianoChordVoicing(1) == "Amin11 (A3-E4-G4-C5-D5)", "Amin11 voicing label")
  assert(describeFmPianoChordVoicing(2) == "Fmaj9 (F3-A3-C4-E4-G4)", "Fmaj9 voicing label")
  assert(describeFmPianoChordVoicing(3) == "G13 (G3-D4-F4-B4-E5)", "G13 voicing label")
  let c0 = computeFmPianoVoicingNotesHz(0)
  assert(c0.len == 5 and int(c0[0]) == 261, "Cmaj9 has 5 notes starting at C4 261Hz")
  let f0 = renderFrameStep(0, 0.016)
  let f6 = renderFrameStep(6, 0.016)
  let f30 = renderFrameStep(30, 0.016)
  assert(f0 > 1800, "Cmaj9 harmonic overtone sum > 1800")
  assert(f0 != f6, "arpeggio note advances at frame 6")
  assert(f6 != f30, "chord voicing advances to Amin11 at frame 30")
  ret 0

pub fn main(): int:
  test_audio_interactive_fm_piano_and_chords_window()
  println("PASS: ex_258_audio_interactive_fm_piano_and_chords_window_test")
  ret 0
