// ============================================================================
// Twin Test Suite 122: DNS Packet Wire Encoder & Record Resolver (CLI)
// Verifies examples/ex_122_net_dns_packet_resolver_cli.aipl
// ============================================================================
module Ex122NetDnsPacketResolverCliTest

import {
  verifyDnsPacketRoundtripAndRecordExtraction,
  computeDnsWireHeaderAndQnameSize,
  describeDnsRecordType
} from "../../examples/ex_122_net_dns_packet_resolver_cli.aipl"

pub fn test_net_dns_packet_resolver_cli(): int:
  assert(verifyDnsPacketRoundtripAndRecordExtraction() == 6699, "DNS query/decode roundtrip returns transaction ID 6699")
  assert(computeDnsWireHeaderAndQnameSize(8) == 26, "12-byte header + (8+2) QNAME + 4-byte QTYPE/QCLASS == 26")
  assert(describeDnsRecordType(1) == "DNS:RECORD_A_IPV4_TYPE_1", "DNS Type 1 A record label")
  ret 0

pub fn main(): int:
  test_net_dns_packet_resolver_cli()
  println("PASS: ex_122_net_dns_packet_resolver_cli_test")
  ret 0
