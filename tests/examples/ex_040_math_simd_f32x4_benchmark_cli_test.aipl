// ============================================================================
// Twin Test Suite 040: SIMD F32x4 Lanes, 8-Wide Dot/AXPY & Tensor Ops (CLI)
// Verifies examples/ex_040_math_simd_f32x4_benchmark_cli.aipl
// ============================================================================
module Ex040MathSimdF32x4BenchmarkCliTest

import {
  evaluateF32x4And8WideDot,
  verifyTensorSoftmaxAndLayerNorm,
  describeSimdVectorizationPlan
} from "../../examples/ex_040_math_simd_f32x4_benchmark_cli.aipl"

pub fn test_simd_f32x4_and_8wide(): int:
  // f32x4Dot([1,2,3,4],[4,3,2,1]) == 20 + simdDotProduct8Wide([1..9],[1..1]) == 45 -> 65
  assert(evaluateF32x4And8WideDot() == 65, "F32x4 dot(20) + 8-wide dot(45) == 65")
  assert(verifyTensorSoftmaxAndLayerNorm() == 1, "softmax, cosine similarity, layer norm, and matmul pass")
  assert(describeSimdVectorizationPlan(64, 256) == "SIMD:AVX2_256BIT_8_ITERS", "64 elements @ 256-bit -> 8 vector iterations")
  ret 0

pub fn main(): int:
  test_simd_f32x4_and_8wide()
  println("PASS: ex_040_math_simd_f32x4_benchmark_cli_test")
  ret 0
