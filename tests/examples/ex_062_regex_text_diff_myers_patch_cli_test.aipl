// ============================================================================
// Twin Test Suite 062: Myers Diff, Unified Patch & 3-Way Merge (CLI)
// Verifies examples/ex_062_regex_text_diff_myers_patch_cli.aipl
// ============================================================================
module Ex062RegexTextDiffMyersPatchCliTest

import {
  computeMyersEditDistance,
  computePostPatchLineCount,
  describeDiffChangeKind,
  verifyUnifiedPatchRoundtripAndMerge
} from "../../examples/ex_062_regex_text_diff_myers_patch_cli.aipl"

pub fn test_myers_diff_metrics(): int:
  assert(computeMyersEditDistance(18, 7) == 25, "18 + 7 == 25")
  assert(computePostPatchLineCount(400, 11) == 411, "400 + 11 == 411")
  assert(describeDiffChangeKind(0) == "DIFF:IDENTICAL", "editKind 0 is identical")
  assert(describeDiffChangeKind(1) == "DIFF:INSERTION_HUNK", "editKind 1")
  ret 0

pub fn test_real_unified_patch_and_three_way_merge(): int:
  // myersDiffLines(3) + buildUnifiedHunks(1) == 4 when patch & 3-way merge succeed
  assert(verifyUnifiedPatchRoundtripAndMerge() == 4, "unified diff/patch roundtrip + 3-way merge verified")
  ret 0

pub fn main(): int:
  test_myers_diff_metrics()
  test_real_unified_patch_and_three_way_merge()
  println("PASS: ex_062_regex_text_diff_myers_patch_cli_test")
  ret 0
