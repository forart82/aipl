// ============================================================================
// Twin Test Suite 125: WebSocket RFC-6455 Handshake & Frame Codec (CLI)
// Verifies examples/ex_125_net_ws_websocket_chat_protocol_cli.aipl
// ============================================================================
module Ex125NetWsWebsocketChatProtocolCliTest

import {
  verifyWebSocketHandshakeAndFrameCodec,
  computeWsFramedByteLength,
  describeWsOpcodeSemantics
} from "../../examples/ex_125_net_ws_websocket_chat_protocol_cli.aipl"

pub fn test_net_ws_websocket_chat_protocol_cli(): int:
  assert(verifyWebSocketHandshakeAndFrameCodec() == 27, "5-byte decoded payload + Ping(9) + Pong(10) + Close(8) - 5 == 27")
  assert(computeWsFramedByteLength(5, 1) == 11, "2-byte header + 4-byte mask key + 5-byte payload == 11")
  assert(describeWsOpcodeSemantics(1) == "WS:OPCODE_TEXT_FRAME_1", "opcode 1 text frame label")
  ret 0

pub fn main(): int:
  test_net_ws_websocket_chat_protocol_cli()
  println("PASS: ex_125_net_ws_websocket_chat_protocol_cli_test")
  ret 0
