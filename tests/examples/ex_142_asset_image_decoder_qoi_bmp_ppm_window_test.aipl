// ============================================================================
// Twin Test Suite 142: Image Decoder QOI, BMP & PPM Pixel Inspector (WINDOW)
// Verifies examples/ex_142_asset_image_decoder_qoi_bmp_ppm_window.aipl
// ============================================================================
module Ex142AssetImageDecoderQoiBmpPpmWindowTest

import {
  verifyQoiBmpAndPpmDecoders,
  computeUncompressedRgbaStrideBytes,
  describeImageFormatMagic,
  renderFrameStep
} from "../../examples/ex_142_asset_image_decoder_qoi_bmp_ppm_window.aipl"

pub fn test_asset_image_decoder_qoi_bmp_ppm_window(): int:
  assert(verifyQoiBmpAndPpmDecoders() == 450, "decoded QOI pixel R(100) + G(150) + B(200) == 450 and PPM roundtrip passes")
  assert(computeUncompressedRgbaStrideBytes(256, 4) == 1024, "256px * 4 channels == 1024-byte row stride")
  assert(describeImageFormatMagic(3) == "IMAGE:CODEC_QOI_LOSSLESS_O1", "QOI format label")
  let p0 = renderFrameStep(0, 0.016)
  let p1 = renderFrameStep(1, 0.016)
  let p20 = renderFrameStep(20, 0.016)
  let p100 = renderFrameStep(100, 0.016)
  assert(p0 > 450, "frame 0 returns verified QOI sum plus inspected decoded texel RGB")
  assert(p0 != p1, "inspected decoded texel RGB advances between frame 0 and frame 1")
  assert(p1 != p20, "inspected decoded texel RGB advances between frame 1 and frame 20")
  assert(p20 != p100, "inspected decoded texel RGB advances between frame 20 and frame 100")
  ret 0

pub fn main(): int:
  test_asset_image_decoder_qoi_bmp_ppm_window()
  println("PASS: ex_142_asset_image_decoder_qoi_bmp_ppm_window_test")
  ret 0
