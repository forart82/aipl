// ============================================================================
// Twin Test Suite 129: Microbenchmark Timer & IQR Outlier Rejection (CLI)
// Verifies examples/ex_129_test_bench_microbenchmark_cli.aipl
// ============================================================================
module Ex129TestBenchMicrobenchmarkCliTest

import {
  verifyBenchmarkIqrOutlierAndStats,
  computeBenchmarkThroughputMops,
  describeBenchmarkStability
} from "../../examples/ex_129_test_bench_microbenchmark_cli.aipl"

pub fn test_test_bench_microbenchmark_cli(): int:
  assert(verifyBenchmarkIqrOutlierAndStats() == 203, "cleaned minNs(100) + maxNs(103) == 203 after IQR outlier 1000 removal")
  assert(computeBenchmarkThroughputMops(100) == 10, "1000 / 100ns == 10 MOps/s")
  assert(describeBenchmarkStability(1) == "BENCH:IQR_CLEANED_1_OUTLIERS", "1 IQR outlier removed label")
  ret 0

pub fn main(): int:
  test_test_bench_microbenchmark_cli()
  println("PASS: ex_129_test_bench_microbenchmark_cli_test")
  ret 0
