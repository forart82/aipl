// ============================================================================
// Twin Test Suite 044: Deque Double-Ended Window, Undo Stack & RingBuffer (CLI)
// Verifies examples/ex_044_collections_deque_sliding_window_cli.aipl
// ============================================================================
module Ex044CollectionsDequeSlidingWindowCliTest

import {
  evaluateDequeEndsAndRingBuffer,
  verifyUndoRedoHistoryRoundtrip,
  describeDequeQueueMode
} from "../../examples/ex_044_collections_deque_sliding_window_cli.aipl"

pub fn test_deque_ring_and_undo_stack(): int:
  // popFront(5) + popBack(25) + ringBufferGet(0)(20) + circularDequeue(1) == 51
  assert(evaluateDequeEndsAndRingBuffer() == 51, "deque ends + ring overwrite + circular queue == 51")
  assert(verifyUndoRedoHistoryRoundtrip("snapshot_v1") == "snapshot_v1", "undoStep followed by redoStep restores snapshot_v1")
  assert(describeDequeQueueMode(0) == "DEQUE:DOUBLE_ENDED_SLIDING_WINDOW", "mode 0")
  ret 0

pub fn main(): int:
  test_deque_ring_and_undo_stack()
  println("PASS: ex_044_collections_deque_sliding_window_cli_test")
  ret 0
