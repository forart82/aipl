// ============================================================================
// Twin Test Suite 090: ChaCha20-Poly1305, AES-256-GCM AEAD & Zeroize (CLI)
// Verifies examples/ex_090_crypto_aead_chacha20_poly1305_cli.aipl
// ============================================================================
module Ex090CryptoAeadChacha20Poly1305CliTest

import {
  computeAeadSealedLength,
  computeChaCha20BlockCounter,
  describeAeadOpenResult,
  verifyChaCha20AndAesGcmRoundTrip
} from "../../examples/ex_090_crypto_aead_chacha20_poly1305_cli.aipl"

pub fn test_crypto_aead_chacha20_poly1305_cli(): int:
  assert(computeAeadSealedLength(256, 16) == 272, "256 plaintext + 16 tag == 272 bytes")
  assert(computeChaCha20BlockCounter(1, 256) == 5, "initial counter 1 + 4 64-byte blocks == 5")
  assert(describeAeadOpenResult(0) == "AEAD:AUTHENTICATED_OK", "verifyCode 0 is AEAD:AUTHENTICATED_OK")
  assert(verifyChaCha20AndAesGcmRoundTrip() == 1, "ChaCha20-Poly1305, AES-256-GCM, and zeroize pass")
  ret 0

pub fn main(): int:
  test_crypto_aead_chacha20_poly1305_cli()
  println("PASS: ex_090_crypto_aead_chacha20_poly1305_cli_test")
  ret 0
