// ============================================================================
// Twin Test Suite 103: File Watcher Inotify Debounce & Hot-Reload Trigger (CLI)
// Verifies examples/ex_103_fs_watch_hot_reload_cli.aipl
// ============================================================================
module Ex103FsWatchHotReloadCliTest

import {
  evaluateCoalescedWatchEventCount,
  verifyWatcherSubscriptionAndBurstWindow,
  describeHotReloadTriggerPolicy
} from "../../examples/ex_103_fs_watch_hot_reload_cli.aipl"

pub fn test_fs_watch_hot_reload_cli(): int:
  assert(evaluateCoalescedWatchEventCount() == 2, "two rapid /src/main.aipl edits within 100ms coalesce + 1 /src/lexer.aipl edit == 2")
  assert(verifyWatcherSubscriptionAndBurstWindow() == 1, "fsWatcherAddPath, fsWatcherRemovePath, and multi-window burst separation pass")
  assert(describeHotReloadTriggerPolicy(100) == "WATCH:INOTIFY_DEBOUNCE_100MS", "100ms debounce policy")
  ret 0

pub fn main(): int:
  test_fs_watch_hot_reload_cli()
  println("PASS: ex_103_fs_watch_hot_reload_cli_test")
  ret 0
