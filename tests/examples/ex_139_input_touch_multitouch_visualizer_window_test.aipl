// ============================================================================
// Twin Test Suite 139: Multi-Touch Pointer ID Isolation Visualizer (WINDOW)
// Verifies examples/ex_139_input_touch_multitouch_visualizer_window.aipl
// ============================================================================
module Ex139InputTouchMultitouchVisualizerWindowTest

import {
  verifyTouchPointerIsolationAndCancel,
  computeMultiTouchCentroidX,
  describeTouchPointerLifecycle,
  renderFrameStep
} from "../../examples/ex_139_input_touch_multitouch_visualizer_window.aipl"

pub fn test_input_touch_multitouch_visualizer_window(): int:
  assert(verifyTouchPointerIsolationAndCancel() == 905, "pointer 1(100) + pointer 2(805) == 905 before isolated cancel")
  assert(computeMultiTouchCentroidX(200, 600) == 400, "centroid of x=200 and x=600 is 400")
  assert(describeTouchPointerLifecycle(3) == "TOUCH:CANCELLED_ISOLATED_CLEANUP", "TOUCH_CANCELLED (3) label")
  let c0 = renderFrameStep(0, 0.016)
  let c1 = renderFrameStep(1, 0.016)
  let c20 = renderFrameStep(20, 0.016)
  let c100 = renderFrameStep(100, 0.016)
  assert(c0 > 200, "frame 0 tracks 2 simultaneous touch pointers and computes centroid")
  assert(c0 != c1, "multi-touch centroid advances between frame 0 and frame 1")
  assert(c1 != c20, "multi-touch centroid advances between frame 1 and frame 20")
  assert(c20 != c100, "multi-touch centroid advances between frame 20 and frame 100")
  ret 0

pub fn main(): int:
  test_input_touch_multitouch_visualizer_window()
  println("PASS: ex_139_input_touch_multitouch_visualizer_window_test")
  ret 0
