// ============================================================================
// Twin Test Suite 064: Monotonic Instant & Stopwatch Benchmark Timer (CLI)
// Verifies examples/ex_064_time_instant_benchmark_timer_cli.aipl
// ============================================================================
module Ex064TimeInstantBenchmarkTimerCliTest

import {
  measureSyntheticBenchmarkMs,
  runStopwatchSplitAudit,
  describeBenchmarkThroughputTier
} from "../../examples/ex_064_time_instant_benchmark_timer_cli.aipl"

pub fn test_time_instant_benchmark_timer_cli(): int:
  assert(measureSyntheticBenchmarkMs(1000, 1250) == 250, "instant durationSince measures 250ms delta")
  assert(runStopwatchSplitAudit(5000, 5120, 5350) == 350, "stopwatch split audit accumulates 350ms")
  assert(describeBenchmarkThroughputTier(120) == "BENCH:ULTRA_FAST_SUB200MS", "sub-200ms benchmark tier")
  assert(describeBenchmarkThroughputTier(450) == "BENCH:NOMINAL_THROUGHPUT", "nominal throughput tier")
  ret 0

pub fn main(): int:
  test_time_instant_benchmark_timer_cli()
  println("PASS: ex_064_time_instant_benchmark_timer_cli_test")
  ret 0
