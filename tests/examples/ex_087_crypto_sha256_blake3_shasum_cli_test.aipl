// ============================================================================
// Twin Test Suite 087: SHA-256, SHA-512, BLAKE3 & Streaming Shasum Tool (CLI)
// Verifies examples/ex_087_crypto_sha256_blake3_shasum_cli.aipl
// ============================================================================
module Ex087CryptoSha256Blake3ShasumCliTest

import {
  evaluateDigestByteLengthsSum,
  verifyStreamingSha256AndVectors,
  describeHashDigestAlgorithm
} from "../../examples/ex_087_crypto_sha256_blake3_shasum_cli.aipl"

pub fn test_crypto_sha256_blake3_shasum_cli(): int:
  assert(evaluateDigestByteLengthsSum("hello") == 128, "sha256(32) + blake3(32) + sha256HexLen(64) == 128")
  assert(verifyStreamingSha256AndVectors() == 1, "streaming Sha256Hasher matches NIST 'hello' vector and SipHash/xxHash64 non-zero")
  assert(describeHashDigestAlgorithm(256) == "HASH:FIPS180_SHA256_AND_BLAKE3", "256-bit algorithm label")
  ret 0

pub fn main(): int:
  test_crypto_sha256_blake3_shasum_cli()
  println("PASS: ex_087_crypto_sha256_blake3_shasum_cli_test")
  ret 0
