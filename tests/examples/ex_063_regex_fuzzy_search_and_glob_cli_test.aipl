// ============================================================================
// Twin Test Suite 063: Fuzzy Edit Distance, Similarity Ratio & Glob Match (CLI)
// Verifies examples/ex_063_regex_fuzzy_search_and_glob_cli.aipl
// ============================================================================
module Ex063RegexFuzzySearchAndGlobCliTest

import {
  evaluateFuzzyEditAndSimilarityPermille,
  verifyDiffTextsAndSpanGlob,
  describeFuzzySearchRanking
} from "../../examples/ex_063_regex_fuzzy_search_and_glob_cli.aipl"

pub fn test_fuzzy_edit_and_glob(): int:
  // editDistance("kitten","sitting") == 3 + similarityRatio("abc","abc")*1000 == 1003
  assert(evaluateFuzzyEditAndSimilarityPermille() == 1003, "editDistance(3) + similarityRatio(1000) == 1003")
  assert(verifyDiffTextsAndSpanGlob("src/main.aipl") == 1, "diffTexts/applyPatch roundtrip + regex glob match")
  assert(describeFuzzySearchRanking(950) == "FUZZY:HIGH_CONFIDENCE_MATCH", "950 permille")
  ret 0

pub fn main(): int:
  test_fuzzy_edit_and_glob()
  println("PASS: ex_063_regex_fuzzy_search_and_glob_cli_test")
  ret 0
