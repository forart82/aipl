// ============================================================================
// Twin Test Suite 037: Probability Distributions, Summary Stats & Kalman 1D (CLI)
// Verifies examples/ex_037_math_prob_stats_regression_cli.aipl
// ============================================================================
module Ex037MathProbStatsRegressionCliTest

import {
  analyzeDatasetSummaryStats,
  evaluateKalmanFilterConvergenceMilli,
  verifyWeightedAndPoissonSampling,
  describeKalmanConvergence
} from "../../examples/ex_037_math_prob_stats_regression_cli.aipl"

pub fn test_summary_stats_and_distributions(): int:
  // For [2, 4, 4, 4, 5, 5, 7, 9]: mean(5) + variance(4) + stdDev(2) + max(9) == 20
  assert(analyzeDatasetSummaryStats() == 20, "mean(5) + var(4) + stdDev(2) + max(9) == 20")
  assert(verifyWeightedAndPoissonSampling() == 1, "weighted index & inverse-CDF Poisson match")
  ret 0

pub fn test_kalman_1d_convergence(): int:
  let estMilli = evaluateKalmanFilterConvergenceMilli(10.0)
  assert(estMilli > 8000 and estMilli <= 10000, "4 steps of Kalman filter toward 10.0 converges > 8000 milli")
  assert(describeKalmanConvergence(estMilli) == "KALMAN1D:CONVERGED_LOCK", "converged")
  ret 0

pub fn main(): int:
  test_summary_stats_and_distributions()
  test_kalman_1d_convergence()
  println("PASS: ex_037_math_prob_stats_regression_cli_test")
  ret 0
