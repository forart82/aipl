// ============================================================================
// Twin Test Suite 252: Desktop Vector Diagram Studio (WINDOW - X11 MIT-SHM)
// Verifies examples/ex_252_desktop_vector_diagram_studio_window.aipl
// ============================================================================
module Ex252DesktopVectorDiagramStudioWindowTest

import {
  snapCoordinateToGrid,
  describeDiagramStudioMode,
  renderFrameStep
} from "../../examples/ex_252_desktop_vector_diagram_studio_window.aipl"
import { getWindowMode } from "../../std/gfx2d/shape2d.aipl"

pub fn test_desktop_vector_diagram_studio_window(): int:
  assert(snapCoordinateToGrid(163, 16) == 160, "163 snaps to 160 on 16px grid")
  assert(snapCoordinateToGrid(171, 16) == 176, "171 snaps to 176 on 16px grid")
  assert(describeDiagramStudioMode(16) == "CAD_STUDIO:x11:GRID_16PX", "CAD studio mode description")
  assert(getWindowMode() == "x11", "window mode is x11")
  let f0 = renderFrameStep(0, 0.016)
  let f3 = renderFrameStep(3, 0.016)
  let f15 = renderFrameStep(15, 0.016)
  assert(f0 > 800, "frame 0 diagram layout score > 800")
  assert(f0 != f3, "diagram nodes animate across frames 0 and 3")
  assert(f3 != f15, "diagram nodes animate across frames 3 and 15")
  ret 0

pub fn main(): int:
  test_desktop_vector_diagram_studio_window()
  println("PASS: ex_252_desktop_vector_diagram_studio_window_test")
  ret 0
