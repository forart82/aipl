// ============================================================================
// Twin Test Suite 058: Formatted Tables, Byte Sizes & Text Wrapping (CLI)
// Verifies examples/ex_058_fmt_text_print_hexdump_cli.aipl
// ============================================================================
module Ex058FmtTextPrintHexdumpCliTest

import {
  renderDiagnosticTableAndByteSize,
  evaluateWordWrapAndTruncation,
  describeTableLayoutMode
} from "../../examples/ex_058_fmt_text_print_hexdump_cli.aipl"

pub fn test_table_byte_size_and_wrap(): int:
  assert(renderDiagnosticTableAndByteSize(1024, 1000000) == "1.00 KiB:1,000,000", "1024 -> 1.00 KiB and 1000000 -> 1,000,000")
  assert(evaluateWordWrapAndTruncation() == "ab...:3", "truncateEllipsis('abcdef',5) == 'ab...' and wordWrap lines >= 3")
  assert(describeTableLayoutMode(true) == "TEXT_PRINT:UNICODE_BORDER_TABLE", "bordered table")
  ret 0

pub fn main(): int:
  test_table_byte_size_and_wrap()
  println("PASS: ex_058_fmt_text_print_hexdump_cli_test")
  ret 0
