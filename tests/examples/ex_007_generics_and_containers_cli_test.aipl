// ============================================================================
// Twin Test Suite 007: Generic Containers, DynVec[T], ArraySlice[T] & Sorting CLI
// Verifies examples/ex_007_generics_and_containers_cli.aipl
// ============================================================================
module Ex007GenericsAndContainersCliTest

import {
  ContainerBatchSummary,
  collectSortedWindowSlice,
  firstNaturalOrderedTag,
  describeContainerLoad,
  buildContainerBatchSummary
} from "../../examples/ex_007_generics_and_containers_cli.aipl"

pub fn test_dyn_vec_and_sorted_slice(): int:
  let win = collectSortedWindowSlice([42, 7, 19, 3, 25], 1, 4)
  assert(win.len == 3, "slice [1..4] has length 3")
  assert(win[0] == 7 and win[1] == 19 and win[2] == 25, "sorted [3, 7, 19, 25, 42] slice [1..4] == [7, 19, 25]")
  ret 0

pub fn test_natural_string_sort_and_summary(): int:
  let firstTag = firstNaturalOrderedTag(["step_10", "step_2", "step_1"])
  assert(firstTag == "step_1", "sortStringsNatural orders step_1 before step_2 and step_10")
  let summary = buildContainerBatchSummary([42, 7, 19, 3, 25])
  assert(summary.count == 5, "count == 5")
  assert(summary.minItem == 3, "minItem == 3")
  assert(summary.maxItem == 42, "maxItem == 42")
  assert(summary.capacity == 8, "dynVecWithCapacity(4) doubles to 8 after 5 pushes")
  ret 0

pub fn test_container_load_classification(): int:
  assert(describeContainerLoad(0, 8) == "VEC:EMPTY", "0 items is empty")
  assert(describeContainerLoad(5, 8) == "VEC:ACTIVE_5_OF_8", "active load ratio")
  ret 0

pub fn main(): int:
  test_dyn_vec_and_sorted_slice()
  test_natural_string_sort_and_summary()
  test_container_load_classification()
  println("PASS: ex_007_generics_and_containers_cli_test")
  ret 0
