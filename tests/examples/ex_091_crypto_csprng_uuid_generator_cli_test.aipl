// ============================================================================
// Twin Test Suite 091: CSPRNG Entropy, RFC-9562 UUID v4/v7 & ULID Generator (CLI)
// Verifies examples/ex_091_crypto_csprng_uuid_generator_cli.aipl
// ============================================================================
module Ex091CryptoCsprngUuidGeneratorCliTest

import {
  evaluateCsprngUuidAndUlidLengths,
  verifyUuidV4V7AndTimeOrdering,
  describeUuidVersionVariant
} from "../../examples/ex_091_crypto_csprng_uuid_generator_cli.aipl"

pub fn test_crypto_csprng_uuid_generator_cli(): int:
  assert(evaluateCsprngUuidAndUlidLengths() == 94, "32 CSPRNG bytes + 36 UUID chars + 26 ULID chars == 94")
  assert(verifyUuidV4V7AndTimeOrdering() == 1, "uuidV4, uuidV7 lexicographic time ordering, and parseUuid roundtrip pass")
  assert(describeUuidVersionVariant(7) == "UUID:RFC9562_V7_TIME_ORDERED", "version 7 label")
  ret 0

pub fn main(): int:
  test_crypto_csprng_uuid_generator_cli()
  println("PASS: ex_091_crypto_csprng_uuid_generator_cli_test")
  ret 0
