module Ex187ParticleSubEmitterFireworksWindowTest

import {
  buildParticleSubEmitterFireworksAudit, stepFireworkApexPos3D
} from "../../examples/ex_187_particle_sub_emitter_fireworks_window"
import { Vec3 } from "../../std/math/vec_math"
import { createParticlePool3D, stepParticlePool3D } from "../../std/particle/emitter3d"
import { createGravityAffector } from "../../std/particle/affector"
import {
  SUB_TRIGGER_DEATH, bindSubEmitter, shouldTriggerSubEmitter,
  dispatchSubEmitterEvent, dispatchSubEmitterCone, mergeSubEmitterSpawn3D
} from "../../std/particle/sub_emitter"

pub fn test_particle_sub_emitter_fireworks(): void:
  let bind = bindSubEmitter(SUB_TRIGGER_DEATH, 1, 12, 0.5)
  assert(shouldTriggerSubEmitter(bind, SUB_TRIGGER_DEATH), "Sub-emitter triggers on death event")

  let burst = dispatchSubEmitterEvent(bind, Vec3(x = 0.0, y = 50.0, z = 0.0), Vec3(x = 0.0, y = 20.0, z = 0.0))
  assert(burst.len() == 12, "dispatchSubEmitterEvent spawns 12 child sparks")

  let coneBurst = dispatchSubEmitterCone(bind, Vec3(x = 0.0, y = 50.0, z = 0.0), Vec3(x = 0.0, y = 1.0, z = 0.0), 30.0, 1.5)
  assert(coneBurst.len() == 12, "dispatchSubEmitterCone spawns 12 directional cone sparks")

  let pool0 = mergeSubEmitterSpawn3D(createParticlePool3D(64, 20.0), coneBurst)
  assert(pool0.liveCount == 12, "mergeSubEmitterSpawn3D inserts 12 child sparks into 3D pool")
  let grav = createGravityAffector(Vec3(x = 0.0, y = 35.0, z = 0.0))
  let pool1 = stepParticlePool3D(pool0, 0.1, [grav])
  assert(pool1.particles[0].pos.y != pool0.particles[0].pos.y, "Sub-emitter child sparks move across frames")
  assert(buildParticleSubEmitterFireworksAudit() == 37, "buildParticleSubEmitterFireworksAudit returns 12 + 12 + 12 + 1 == 37")

  // Multi-frame progression across t=0 -> t=1 -> t=20 -> t=100
  let a0 = stepFireworkApexPos3D(0)
  let a1 = stepFireworkApexPos3D(1)
  let a20 = stepFireworkApexPos3D(20)
  let a100 = stepFireworkApexPos3D(100)
  assert(a0.x != a1.x or a0.y != a1.y, "Firework apex position advances from t=0 to t=1")
  assert(a1.x != a20.x or a1.y != a20.y, "Firework apex position advances from t=1 to t=20")
  assert(a20.x != a100.x or a20.y != a100.y, "Firework apex position advances from t=20 to t=100 without freezing")

pub fn main(): int:
  test_particle_sub_emitter_fireworks()
  println("PASS: ex_187_particle_sub_emitter_fireworks_window_test")
  ret 0
