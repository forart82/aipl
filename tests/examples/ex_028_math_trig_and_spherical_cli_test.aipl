// ============================================================================
// Twin Test Suite 028: Trigonometry, Polar Hypotenuse & Angle Wrapping (CLI)
// Verifies examples/ex_028_math_trig_and_spherical_cli.aipl
// ============================================================================
module Ex028MathTrigAndSphericalCliTest

import {
  verifyPythagoreanTrigAndHypot,
  computeShortestHeadingTurnDeg,
  verifyFixedAngleQuarterRotation,
  describeQuadrantBearing
} from "../../examples/ex_028_math_trig_and_spherical_cli.aipl"

pub fn test_trig_identities_and_hypot(): int:
  assert(verifyPythagoreanTrigAndHypot(3.0, 4.0) == 5, "sin^2+cos^2 == 1 and hypot(3, 4) == 5")
  ret 0

pub fn test_heading_delta_and_fixed_rotation(): int:
  assert(computeShortestHeadingTurnDeg(350.0, 10.0) == 20, "shortest turn from 350 deg to 10 deg is +20 deg")
  assert(verifyFixedAngleQuarterRotation(10, 0) == 10, "(10, 0) rotated by 64/256 turn becomes (0, 10)")
  assert(describeQuadrantBearing(45) == "BEARING:NE_QUADRANT", "45 deg is NE")
  assert(describeQuadrantBearing(225) == "BEARING:SW_QUADRANT", "225 deg is SW")
  ret 0

pub fn main(): int:
  test_trig_identities_and_hypot()
  test_heading_delta_and_fixed_rotation()
  println("PASS: ex_028_math_trig_and_spherical_cli_test")
  ret 0
