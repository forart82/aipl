// ============================================================================
// Twin Test Suite 106: Subprocess Spawner, ProcessBuilder & Shell Pipeline (CLI)
// Verifies examples/ex_106_os_process_pipeline_runner_cli.aipl
// ============================================================================
module Ex106OsProcessPipelineRunnerCliTest

import {
  evaluateCommandAndPipelineOutput,
  verifyProcessBuilderAndWaitStatus,
  describeProcessExitVerdict
} from "../../examples/ex_106_os_process_pipeline_runner_cli.aipl"

pub fn test_os_process_pipeline_runner_cli(): int:
  assert(evaluateCommandAndPipelineOutput() == "Hello Subprocess:ALPHA", "runCommand echo + execPipeline tr a-z A-Z")
  assert(verifyProcessBuilderAndWaitStatus() == 1, "processBuilderNew, spawnProcess, childPid, and childWait pass")
  assert(describeProcessExitVerdict(0) == "PROC:EXIT_ZERO_SUCCESS", "exit code 0 descriptor")
  ret 0

pub fn main(): int:
  test_os_process_pipeline_runner_cli()
  println("PASS: ex_106_os_process_pipeline_runner_cli_test")
  ret 0
