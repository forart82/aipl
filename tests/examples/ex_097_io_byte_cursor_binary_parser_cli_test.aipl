// ============================================================================
// Twin Test Suite 097: In-Memory ByteCursor Seek, ReadExact & Binary Parser (CLI)
// Verifies examples/ex_097_io_byte_cursor_binary_parser_cli.aipl
// ============================================================================
module Ex097IoByteCursorBinaryParserCliTest

import {
  evaluateCursorSeekAndReadSum,
  verifyCursorRewindWriteAndBounds,
  describeSeekAnchorOrigin
} from "../../examples/ex_097_io_byte_cursor_binary_parser_cli.aipl"

pub fn test_io_byte_cursor_binary_parser_cli(): int:
  assert(evaluateCursorSeekAndReadSum() == 110, "firstByte(10) + exact2(20+30) + lastByteAtEnd(50) == 110")
  assert(verifyCursorRewindWriteAndBounds() == 1, "cursorRewind, cursorWrite growth, and negative/past-EOF seek errors pass")
  assert(describeSeekAnchorOrigin(2) == "SEEK:FROM_END_RELATIVE", "origin 2 is SeekFrom::End")
  ret 0

pub fn main(): int:
  test_io_byte_cursor_binary_parser_cli()
  println("PASS: ex_097_io_byte_cursor_binary_parser_cli_test")
  ret 0
