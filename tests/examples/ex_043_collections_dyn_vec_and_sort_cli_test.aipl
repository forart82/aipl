// ============================================================================
// Twin Test Suite 043: DynVec Growth, Slice Views & Natural Sorting (CLI)
// Verifies examples/ex_043_collections_dyn_vec_and_sort_cli.aipl
// ============================================================================
module Ex043CollectionsDynVecAndSortCliTest

import {
  verifyDynVecMutationsAndSlice,
  verifyLexicographicAndNaturalSorting,
  describeSortStrategy
} from "../../examples/ex_043_collections_dyn_vec_and_sort_cli.aipl"

pub fn test_dyn_vec_and_sorting(): int:
  assert(verifyDynVecMutationsAndSlice() == 55, "reversed slice [30, 25] sums to 55")
  assert(verifyLexicographicAndNaturalSorting() == "f2:10", "natural sort puts f2 before f10 and min int is 10")
  assert(describeSortStrategy(true) == "SORT:ALPHANUMERIC_NATURAL", "natural sort")
  ret 0

pub fn main(): int:
  test_dyn_vec_and_sorting()
  println("PASS: ex_043_collections_dyn_vec_and_sort_cli_test")
  ret 0
