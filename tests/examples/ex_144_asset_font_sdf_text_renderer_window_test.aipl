// ============================================================================
// Twin Test Suite 144: Signed Distance Field (SDF) Font & Text Renderer (WINDOW)
// Verifies examples/ex_144_asset_font_sdf_text_renderer_window.aipl
// ============================================================================
module Ex144AssetFontSdfTextRendererWindowTest

import {
  verifyTtfSdfGenerationAndSampling,
  computeSdfEdgeThresholdByte,
  describeSdfAntiAliasingMode,
  renderFrameStep
} from "../../examples/ex_144_asset_font_sdf_text_renderer_window.aipl"

pub fn test_asset_font_sdf_text_renderer_window(): int:
  assert(verifyTtfSdfGenerationAndSampling() == 26, "16 SDF texels + 10px glyph advanceX == 26")
  assert(computeSdfEdgeThresholdByte(500) == 127, "500 permille * 255 / 1000 == 127 iso-contour byte")
  assert(describeSdfAntiAliasingMode(4) == "SDF:SPREAD_4PX_SMOOTHSTEP", "4px SDF spread label")
  let f0 = renderFrameStep(0, 0.016)
  let f1 = renderFrameStep(1, 0.016)
  let f20 = renderFrameStep(20, 0.016)
  let f100 = renderFrameStep(100, 0.016)
  assert(f0 > 26, "frame 0 evaluates SDF atlas iso-contour texels and glyph advance")
  assert(f0 != f1, "SDF iso-contour threshold and inside texel count advance between frame 0 and frame 1")
  assert(f1 != f20, "SDF iso-contour threshold and inside texel count advance between frame 1 and frame 20")
  assert(f20 != f100, "SDF iso-contour threshold and inside texel count advance between frame 20 and frame 100")
  ret 0

pub fn main(): int:
  test_asset_font_sdf_text_renderer_window()
  println("PASS: ex_144_asset_font_sdf_text_renderer_window_test")
  ret 0
