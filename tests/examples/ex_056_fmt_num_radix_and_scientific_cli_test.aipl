// ============================================================================
// Twin Test Suite 056: Number Radix Parsing, Dragonbox & Scientific Fmt (CLI)
// Verifies examples/ex_056_fmt_num_radix_and_scientific_cli.aipl
// ============================================================================
module Ex056FmtNumRadixAndScientificCliTest

import {
  evaluateRadixParseAndFormat,
  verifyFloatDragonboxAndScientific,
  describeNumericRadixFormat
} from "../../examples/ex_056_fmt_num_radix_and_scientific_cli.aipl"

pub fn test_radix_parsing_and_scientific_float(): int:
  // parseInt("12345") + parseIntRadix("ff",16) + parseIntEx("1_000") == 13600
  assert(evaluateRadixParseAndFormat() == 13600, "12345 + 255 + 1000 == 13600")
  assert(verifyFloatDragonboxAndScientific() == "3.142:123.45", "fixed 3 decimals + Dragonbox shortest representation")
  assert(describeNumericRadixFormat(16) == "RADIX:HEXADECIMAL_BASE16", "radix 16")
  ret 0

pub fn main(): int:
  test_radix_parsing_and_scientific_float()
  println("PASS: ex_056_fmt_num_radix_and_scientific_cli_test")
  ret 0
