module Ex183ParticleEmitter2dFountainAndFireWindowTest

import {
  buildParticleEmitter2dFountainAudit, stepFountainJetParticle
} from "../../examples/ex_183_particle_emitter2d_fountain_and_fire_window"
import { Vec2, Vec3 } from "../../std/math/vec_math"
import { ColorRgba8 } from "../../std/gfx/color"
import {
  EmissionShape2D, Particle2D, createParticlePool2D,
  sampleEmissionPosition2D, spawnParticle2D, stepParticlePool2D,
  emitParticleBurst2D, countActiveParticles2D
} from "../../std/particle/emitter2d"
import { createGravityAffector } from "../../std/particle/affector"

pub fn test_particle_emitter2d_fountain_and_fire(): void:
  let discShape = EmissionShape2D(shapeType = 1, radius = 12.0, innerRadius = 0.0, boxExtents = Vec2(x = 0.0, y = 0.0))
  let pt = sampleEmissionPosition2D(discShape, 0.5, 0.25)
  assert(pt.x * pt.x + pt.y * pt.y <= 144.01, "Disc emission point within radius=12")

  let gold = ColorRgba8(r = 250, g = 204, b = 21, a = 255)
  let crimson = ColorRgba8(r = 244, g = 63, b = 94, a = 0)
  mut pool = createParticlePool2D(64, 30.0)
  let p0 = Particle2D(
    pos = Vec2(x = 0.0, y = 0.0),
    vel = Vec2(x = 20.0, y = 40.0),
    startColor = gold,
    endColor = crimson,
    size = 8.0,
    rotationRad = 0.0,
    rotSpeedRad = 1.0,
    ageSec = 0.0,
    lifetimeSec = 2.0,
    isAlive = true
  )
  pool = spawnParticle2D(pool, p0)
  let grav = createGravityAffector(Vec3(x = 0.0, y = -20.0, z = 0.0))
  pool = stepParticlePool2D(pool, 0.5, [grav])
  assert(pool.liveCount == 1 and pool.particles[0].pos.x == 10.0, "Particle2D advected X=10.0 at t=0.5s")

  pool = emitParticleBurst2D(pool, Vec2(x = 0.0, y = 0.0), 8, 30.0, 1.5, gold, crimson)
  assert(countActiveParticles2D(pool) == 9, "1 initial + 8 burst == 9 active particles")
  assert(buildParticleEmitter2dFountainAudit() == 83, "buildParticleEmitter2dFountainAudit returns 64 + 10 + 9 == 83")

  // Multi-frame progression across t=0 -> t=1 -> t=20 -> t=100
  let j0 = stepFountainJetParticle(0)
  let j1 = stepFountainJetParticle(1)
  let j20 = stepFountainJetParticle(20)
  let j100 = stepFountainJetParticle(100)
  assert(j0.vel.x != j1.vel.x, "Fountain jet velocity oscillates from t=0 to t=1")
  assert(j1.vel.x != j20.vel.x, "Fountain jet velocity oscillates from t=1 to t=20")
  assert(j20.vel.x != j100.vel.x, "Fountain jet velocity oscillates from t=20 to t=100 without freezing")

pub fn main(): int:
  test_particle_emitter2d_fountain_and_fire()
  println("PASS: ex_183_particle_emitter2d_fountain_and_fire_window_test")
  ret 0
