// ============================================================================
// Twin Test Suite 117: Thread Spawning & Thread-Local Context Propagation (CLI)
// Verifies examples/ex_117_thread_local_context_propagation_cli.aipl
// ============================================================================
module Ex117ThreadLocalContextPropagationCliTest

import {
  evaluateThreadJoinAndTlsContextSum,
  verifyThreadLocalResetAndConcurrency,
  describeThreadStackProfile
} from "../../examples/ex_117_thread_local_context_propagation_cli.aipl"

pub fn test_thread_local_context_propagation_cli(): int:
  assert(evaluateThreadJoinAndTlsContextSum() == 229, "threadJoin(42 + 99) + threadLocal(88) == 229")
  assert(verifyThreadLocalResetAndConcurrency() == 1, "threadLocalClear resets to 0 and hardwareConcurrency >= 1")
  assert(describeThreadStackProfile(1048576) == "TLS:STACK_1024KB_ISOLATED", "1048576 bytes -> 1024KB stack profile")
  ret 0

pub fn main(): int:
  test_thread_local_context_propagation_cli()
  println("PASS: ex_117_thread_local_context_propagation_cli_test")
  ret 0
