// ============================================================================
// Twin Test Suite 154: Color Spaces (sRGB/OKLab) & WCAG Contrast Palette (WINDOW)
// Verifies examples/ex_154_gfx_color_spaces_and_wcag_palette_window.aipl
// ============================================================================
module Ex154GfxColorSpacesAndWcagPaletteWindowTest

import {
  verifyColorSpacesOklabAndWcagContrast,
  classifyWcagComplianceTier,
  describeColorSpacePipeline,
  renderFrameStep
} from "../../examples/ex_154_gfx_color_spaces_and_wcag_palette_window.aipl"

pub fn test_gfx_color_spaces_and_wcag_palette_window(): int:
  assert(verifyColorSpacesOklabAndWcagContrast() == 149, "recovered sRGB midGray(128) + WCAG black/white contrast(21) == 149")
  assert(classifyWcagComplianceTier(160) == 3, "16.0:1 contrast >= 7.0:1 earns tier 3 (WCAG AAA)")
  assert(describeColorSpacePipeline(3) == "COLOR:OKLAB_PERCEPTUAL_WCAG_AAA", "OKLab + WCAG AAA label")
  let f0 = renderFrameStep(0, 0.016)
  let f1 = renderFrameStep(1, 0.016)
  let f20 = renderFrameStep(20, 0.016)
  let f100 = renderFrameStep(100, 0.016)
  assert(f0 > 149, "frame 0 evaluates active OKLab swatch RGB and WCAG contrast")
  assert(f0 != f1, "active OKLab swatch RGB and WCAG contrast advance between frame 0 and frame 1")
  assert(f1 != f20, "active OKLab swatch RGB and WCAG contrast advance between frame 1 and frame 20")
  assert(f20 != f100, "active OKLab swatch RGB and WCAG contrast advance between frame 20 and frame 100")
  ret 0

pub fn main(): int:
  test_gfx_color_spaces_and_wcag_palette_window()
  println("PASS: ex_154_gfx_color_spaces_and_wcag_palette_window_test")
  ret 0
