// ============================================================================
// Twin Test Suite 036: PCG32 / Xoshiro256 PRNG & Monte Carlo Pi Estimator (CLI)
// Verifies examples/ex_036_math_prng_monte_carlo_cli.aipl
// ============================================================================
module Ex036MathPrngMonteCarloCliTest

import {
  estimateMonteCarloPiPermille,
  verifyPrngDeterminismAndShuffle,
  describePrngEngine
} from "../../examples/ex_036_math_prng_monte_carlo_cli.aipl"

pub fn test_monte_carlo_pi_and_determinism(): int:
  let piEst = estimateMonteCarloPiPermille(42, 400)
  assert(piEst >= 2800 and piEst <= 3500, "Monte Carlo Pi estimate (permille) is in [2800, 3500]")
  assert(verifyPrngDeterminismAndShuffle(1337) == 10, "shuffle of [1,2,3,4] preserves sum 10 and deterministic seed matches")
  assert(describePrngEngine(0) == "PRNG:PCG32_XSH_RR_DETERMINISTIC", "engine 0")
  ret 0

pub fn main(): int:
  test_monte_carlo_pi_and_determinism()
  println("PASS: ex_036_math_prng_monte_carlo_cli_test")
  ret 0
