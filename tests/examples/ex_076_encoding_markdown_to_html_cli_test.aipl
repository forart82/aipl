// ============================================================================
// Twin Test Suite 076: CommonMark Markdown AST & HTML Renderer (CLI)
// Verifies examples/ex_076_encoding_markdown_to_html_cli.aipl
// ============================================================================
module Ex076EncodingMarkdownToHtmlCliTest

import {
  evaluateMarkdownAstArtifactCounts,
  verifyMarkdownHtmlRendering,
  describeMarkdownDocumentStructure
} from "../../examples/ex_076_encoding_markdown_to_html_cli.aipl"

pub fn test_encoding_markdown_to_html_cli(): int:
  assert(evaluateMarkdownAstArtifactCounts() == 3, "1 heading + 1 code block + 1 link == 3")
  assert(verifyMarkdownHtmlRendering() == 1, "renderMarkdownHtml and markdownToHtml match with <h1> and <strong>")
  assert(describeMarkdownDocumentStructure(1) == "MD:TECHNICAL_SPEC_WITH_CODE", "1 code block descriptor")
  ret 0

pub fn main(): int:
  test_encoding_markdown_to_html_cli()
  println("PASS: ex_076_encoding_markdown_to_html_cli_test")
  ret 0
