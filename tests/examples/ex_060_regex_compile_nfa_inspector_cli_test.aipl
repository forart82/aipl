// ============================================================================
// Twin Test Suite 060: Regex AST Parser, NFA Bytecode & Flags Inspector (CLI)
// Verifies examples/ex_060_regex_compile_nfa_inspector_cli.aipl
// ============================================================================
module Ex060RegexCompileNfaInspectorCliTest

import {
  inspectNfaBytecodeAndEscaping,
  verifyRegexFlagsIgnoreCaseAndMultiline,
  describeNfaBytecodeEngine
} from "../../examples/ex_060_regex_compile_nfa_inspector_cli.aipl"

pub fn test_nfa_bytecode_and_flags(): int:
  let instrCount = inspectNfaBytecodeAndEscaping("a+b")
  assert(instrCount > 0, "compileAstToBytecode emits non-empty NFA instructions")
  assert(verifyRegexFlagsIgnoreCaseAndMultiline() == 1, "ignoreCase, multiline, and dotAll flags work")
  assert(describeNfaBytecodeEngine(0) == "REGEX:THOMPSON_NFA_PIKE_VM", "engine 0")
  ret 0

pub fn main(): int:
  test_nfa_bytecode_and_flags()
  println("PASS: ex_060_regex_compile_nfa_inspector_cli_test")
  ret 0
