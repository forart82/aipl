// ============================================================================
// Twin Test Suite 002: Primitives, Bitwise Registers & Population Count CLI
// Verifies examples/ex_002_primitives_and_bitwise_cli.aipl (written before example)
// ============================================================================
module Ex002PrimitivesAndBitwiseCliTest

import {
  BitRegisterReport,
  packRgbaBits,
  manipulateFlagRegister,
  buildBitRegisterReport,
  describeAlignmentPowerOfTwo
} from "../../examples/ex_002_primitives_and_bitwise_cli.aipl"

pub fn test_rgba_packing_and_flag_manipulation(): int:
  let rgba = packRgbaBits(255, 128, 64, 255)
  assert(rgba == 4286595327, "packRgbaBits(255, 128, 64, 255) packs 32-bit RGBA")
  let flags = manipulateFlagRegister(0b0001)
  assert(flags == 0b1010, "bitSet(3) + bitToggle(0) + bitSet(1) -> 0b1010 (10)")
  ret 0

pub fn test_bit_register_report_metrics(): int:
  let rep = buildBitRegisterReport(0b10110000, 4)
  assert(rep.rawWord == 176, "rawWord == 176")
  assert(rep.popCount == 3, "popcount64(0b10110000) == 3")
  assert(rep.trailingZeros == 4, "ctz(0b10110000) == 4")
  assert(rep.rotatedLeft == 2816, "rotateLeft32(176, 4) == 2816")
  assert(rep.nextPow2 == 256, "nextPowerOfTwo(176) == 256")
  ret 0

pub fn test_power_of_two_classification(): int:
  assert(describeAlignmentPowerOfTwo(64) == "BITS:POW2_ALIGNED", "64 is power of two")
  assert(describeAlignmentPowerOfTwo(100) == "BITS:ROUNDED_TO_128", "100 rounds up to 128")
  ret 0

pub fn main(): int:
  test_rgba_packing_and_flag_manipulation()
  test_bit_register_report_metrics()
  test_power_of_two_classification()
  println("PASS: ex_002_primitives_and_bitwise_cli_test")
  ret 0
