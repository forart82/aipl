// ============================================================================
// Twin Test Suite 092: TLS 1.3 Record Framing, ClientHello & X.509 Inspector (CLI)
// Verifies examples/ex_092_crypto_tls_handshake_inspector_cli.aipl
// ============================================================================
module Ex092CryptoTlsHandshakeInspectorCliTest

import {
  evaluateTlsFramedRecordConsumedBytes,
  verifyTlsClientHelloAndX509Window,
  describeTlsRecordContentType
} from "../../examples/ex_092_crypto_tls_handshake_inspector_cli.aipl"

pub fn test_crypto_tls_handshake_inspector_cli(): int:
  assert(evaluateTlsFramedRecordConsumedBytes("PING") == 9, "5-byte TLS record header + 4-byte fragment == 9")
  assert(verifyTlsClientHelloAndX509Window() == 1, "tlsBuildClientHello and X.509 validity window checks pass")
  assert(describeTlsRecordContentType(22) == "TLS:CONTENT_TYPE_22_HANDSHAKE", "0x16 (22) is TLS Handshake")
  ret 0

pub fn main(): int:
  test_crypto_tls_handshake_inspector_cli()
  println("PASS: ex_092_crypto_tls_handshake_inspector_cli_test")
  ret 0
