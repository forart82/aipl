// ============================================================================
// Twin Test Suite 005: Structs, Receiver Methods & Immutable Value Updates CLI
// Verifies examples/ex_005_structs_methods_and_immutability_cli.aipl
// ============================================================================
module Ex005StructsMethodsAndImmutabilityCliTest

import {
  TransformRecord,
  buildTransformRecord,
  translateTransform,
  scaleTransformUniform,
  describeTransformScale
} from "../../examples/ex_005_structs_methods_and_immutability_cli.aipl"

pub fn test_struct_construction_and_immutability(): int:
  let base = buildTransformRecord(10, 20, 100)
  let moved = translateTransform(base, 5, -4)
  assert(base.posX == 10 and base.posY == 20, "original struct remains unchanged")
  assert(moved.posX == 15 and moved.posY == 16, "translated copy has updated coordinates")
  assert(moved.manhattanDist() == 31, "receiver method manhattanDist() == 15 + 16 = 31")
  ret 0

pub fn test_vec2_distance_and_uniform_scaling(): int:
  let base = buildTransformRecord(3, 4, 100)
  assert(base.originDistanceInt() == 5, "Vec2(3, 4).len() == 5")
  let scaled = scaleTransformUniform(base, 250)
  assert(scaled.scalePct == 250, "scaled percentage updated to 250")
  ret 0

pub fn test_transform_scale_classification(): int:
  let unit = buildTransformRecord(0, 0, 100)
  let enlarged = scaleTransformUniform(unit, 200)
  let shrunk = scaleTransformUniform(unit, 50)
  assert(describeTransformScale(unit) == "STRUCT:UNIT_SCALE", "100% is unit scale")
  assert(describeTransformScale(enlarged) == "STRUCT:MAGNIFIED", "200% is magnified")
  assert(describeTransformScale(shrunk) == "STRUCT:REDUCED", "50% is reduced")
  ret 0

pub fn main(): int:
  test_struct_construction_and_immutability()
  test_vec2_distance_and_uniform_scaling()
  test_transform_scale_classification()
  println("PASS: ex_005_structs_methods_and_immutability_cli_test")
  ret 0
