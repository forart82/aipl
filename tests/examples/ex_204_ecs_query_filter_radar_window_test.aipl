module Ex204EcsQueryFilterRadarWindowTest

import {
  buildEcsQueryFilterAudit, stepActiveQueryFilter, stepRadarSweepAngle
} from "../../examples/ex_204_ecs_query_filter_radar_window"
import { createEcsWorld, spawnEntity } from "../../std/ecs/ecs_world"
import {
  QueryFilter, matchesQueryFilter, findMatchingArchetypes, queryEntities
} from "../../std/ecs/ecs_query"

pub fn test_ecs_query_filter_radar(): void:
  let qf = QueryFilter(withMask = 3, withoutMask = 4)
  assert(matchesQueryFilter(3, qf), "Archetype 0b011 matches withMask=0b011 and withoutMask=0b100")
  assert(not matchesQueryFilter(7, qf), "Archetype 0b111 excluded by withoutMask=0b100")
  assert(not matchesQueryFilter(1, qf), "Archetype 0b001 missing bit 2 of withMask=0b011")

  mut world = createEcsWorld()
  let (w1, _e0) = spawnEntity(world)
  let (w2, _e1) = spawnEntity(w1)
  let (w3, _e2) = spawnEntity(w2)
  world = w3

  let allQf = QueryFilter(withMask = 0, withoutMask = 4)
  let archs = findMatchingArchetypes(world, allQf)
  let ents = queryEntities(world, allQf)
  assert(archs.len() == 1 and ents.len() == 3, "Default archetype matched with 3 spawned entities")
  assert(buildEcsQueryFilterAudit() == 6, "buildEcsQueryFilterAudit returns 1 + 1 + 1 + 3 == 6")

  // Multi-frame progression across t=0, t=1, t=20, t=100
  let a0 = stepRadarSweepAngle(0)
  let a1 = stepRadarSweepAngle(1)
  let a20 = stepRadarSweepAngle(20)
  let a100 = stepRadarSweepAngle(100)
  assert(a0 != a1 and a1 != a20 and a20 != a100, "radar sweep angle advances across t=0,1,20,100")

  let f0 = stepActiveQueryFilter(0)
  let f20 = stepActiveQueryFilter(20)
  let f100 = stepActiveQueryFilter(100)
  assert(f0.withoutMask != f20.withoutMask or f0.withMask != f20.withMask, "query filter changes between t=0 and t=20")
  assert(f20.withMask != f100.withMask or f20.withoutMask != f100.withoutMask, "query filter changes between t=20 and t=100")

pub fn main(): int:
  test_ecs_query_filter_radar()
  println("PASS: ex_204_ecs_query_filter_radar_window_test")
  ret 0
