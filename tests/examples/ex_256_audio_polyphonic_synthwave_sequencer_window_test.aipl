// ============================================================================
// Twin Test Suite 256: Audio Polyphonic Synthwave Sequencer (WINDOW)
// Verifies examples/ex_256_audio_polyphonic_synthwave_sequencer_window.aipl
// ============================================================================
module Ex256AudioPolyphonicSynthwaveSequencerWindowTest

import {
  computeSequencerTrackFreqHz,
  describePolyphonicSequencerArrangement,
  renderFrameStep
} from "../../examples/ex_256_audio_polyphonic_synthwave_sequencer_window.aipl"

pub fn test_audio_polyphonic_synthwave_sequencer_window(): int:
  assert(describePolyphonicSequencerArrangement() == "SEQUENCER:4TRACK_16STEP_SYNTHWAVE_POLYPHONIC", "4-track sequencer label")
  assert(int(computeSequencerTrackFreqHz(0, 0)) == 110, "track 0 step 0 bass A2 110Hz")
  assert(int(computeSequencerTrackFreqHz(2, 0)) == 523, "track 2 step 0 bell C5 523Hz")
  let f0 = renderFrameStep(0, 0.016)
  let f8 = renderFrameStep(8, 0.016)
  let f32 = renderFrameStep(32, 0.016)
  assert(f0 > 900, "step 0 polyphonic frequency sum > 900")
  assert(f0 != f8, "sequencer advances between frame 0 and frame 8")
  assert(f8 != f32, "sequencer advances between frame 8 and frame 32")
  ret 0

pub fn main(): int:
  test_audio_polyphonic_synthwave_sequencer_window()
  println("PASS: ex_256_audio_polyphonic_synthwave_sequencer_window_test")
  ret 0
