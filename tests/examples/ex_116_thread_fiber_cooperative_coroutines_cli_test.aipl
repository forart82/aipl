// ============================================================================
// Twin Test Suite 116: Cooperative Stackful Fibers & Coroutines (CLI)
// Verifies examples/ex_116_thread_fiber_cooperative_coroutines_cli.aipl
// ============================================================================
module Ex116ThreadFiberCooperativeCoroutinesCliTest

import {
  evaluateThreeStepFiberCoroutineSum,
  runRoundRobinFiberSchedulerBatch,
  describeFiberLifecycleState
} from "../../examples/ex_116_thread_fiber_cooperative_coroutines_cli.aipl"

pub fn test_thread_fiber_cooperative_coroutines_cli(): int:
  assert(evaluateThreeStepFiberCoroutineSum() == 60, "3-step fiber yield/resume accumulates 10+20+30 == 60")
  assert(runRoundRobinFiberSchedulerBatch() == 3, "round-robin fiber scheduler completes 3 fibers")
  assert(describeFiberLifecycleState(2) == "FIBER:COMPLETED_STATE_2", "completed fiber state label")
  ret 0

pub fn main(): int:
  test_thread_fiber_cooperative_coroutines_cli()
  println("PASS: ex_116_thread_fiber_cooperative_coroutines_cli_test")
  ret 0
