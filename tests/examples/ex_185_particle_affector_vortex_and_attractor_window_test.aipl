module Ex185ParticleAffectorVortexAndAttractorWindowTest

import {
  buildParticleAffectorVortexAudit, stepVortexCenter3D
} from "../../examples/ex_185_particle_affector_vortex_and_attractor_window"
import { Vec3 } from "../../std/math/vec_math"
import {
  createGravityAffector, createDragAffector, createVortexAffector,
  createCurlNoiseAffector, createPointAttractorAffector,
  evaluateVortexForce, evaluateCurlNoiseForce,
  evaluatePointAttractorForce, combineAffectorForces3D
} from "../../std/particle/affector"

pub fn test_particle_affector_vortex_and_attractor(): void:
  let grav = createGravityAffector(Vec3(x = 0.0, y = -9.81, z = 0.0))
  let drag = createDragAffector(0.4)
  assert(grav.direction.y == -9.81 and drag.strength == 0.4, "Gravity and drag affectors")

  let vortex = createVortexAffector(Vec3(x = 0.0, y = 0.0, z = 0.0), Vec3(x = 0.0, y = 1.0, z = 0.0), 12.0)
  let vf = evaluateVortexForce(vortex, Vec3(x = 5.0, y = 0.0, z = 0.0))
  assert(vf.x == 0.0 and vf.y == 0.0 and vf.z != 0.0, "Vortex produces tangential force perpendicular to radial X and axis Y")

  let curl = createCurlNoiseAffector(0.5, 4.0)
  let cf = evaluateCurlNoiseForce(curl, Vec3(x = 1.2, y = 2.3, z = 3.4))
  assert(cf.lenSq() > 0.0, "Divergence-free curl noise vector is non-zero")

  let attr = createPointAttractorAffector(Vec3(x = 10.0, y = 0.0, z = 0.0), 25.0, 40.0)
  let af = evaluatePointAttractorForce(attr, Vec3(x = 0.0, y = 0.0, z = 0.0))
  assert(af.x > 0.0, "Point attractor pulls toward +X")

  let combined = combineAffectorForces3D([grav, attr], Vec3(x = 0.0, y = 0.0, z = 0.0), Vec3(x = 0.0, y = 0.0, z = 0.0))
  assert(combined.x > 0.0 and combined.y == -9.81, "combineAffectorForces3D sums affector forces")
  assert(buildParticleAffectorVortexAudit() > 30, "buildParticleAffectorVortexAudit returns positive tangential + attractor force sum")

  // Multi-frame progression across t=0 -> t=1 -> t=20 -> t=100
  let c0 = stepVortexCenter3D(0)
  let c1 = stepVortexCenter3D(1)
  let c20 = stepVortexCenter3D(20)
  let c100 = stepVortexCenter3D(100)
  assert(c0.x != c1.x or c0.z != c1.z, "Vortex center advances from t=0 to t=1")
  assert(c1.x != c20.x or c1.z != c20.z, "Vortex center advances from t=1 to t=20")
  assert(c20.x != c100.x or c20.z != c100.z, "Vortex center advances from t=20 to t=100 without freezing")

pub fn main(): int:
  test_particle_affector_vortex_and_attractor()
  println("PASS: ex_185_particle_affector_vortex_and_attractor_window_test")
  ret 0
