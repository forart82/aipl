// ============================================================================
// Twin Test Suite 121: Reliable UDP (RUDP) Bitfield ACK & Game Netcode (CLI)
// Verifies examples/ex_121_net_rudp_reliable_game_netcode_cli.aipl
// ============================================================================
module Ex121NetRudpReliableGameNetcodeCliTest

import {
  verifyRudpAckBitfieldAndFragmentation,
  computeRudpFragmentCount,
  describeRudpNetworkQuality
} from "../../examples/ex_121_net_rudp_reliable_game_netcode_cli.aipl"

pub fn test_net_rudp_reliable_game_netcode_cli(): int:
  assert(verifyRudpAckBitfieldAndFragmentation() == 253, "3 ACKed packets + 250 reassembled bytes == 253")
  assert(computeRudpFragmentCount(250, 100) == 3, "250 bytes at 100-byte MTU splits into 3 fragments")
  assert(describeRudpNetworkQuality(40) == "RUDP:LOW_PING_40MS_COMPETITIVE", "40ms RTT competitive rating")
  ret 0

pub fn main(): int:
  test_net_rudp_reliable_game_netcode_cli()
  println("PASS: ex_121_net_rudp_reliable_game_netcode_cli_test")
  ret 0
