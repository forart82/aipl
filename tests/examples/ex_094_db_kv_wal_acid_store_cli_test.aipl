// ============================================================================
// Twin Test Suite 094: Write-Ahead Log (WAL) ACID Key-Value Store & Replay (CLI)
// Verifies examples/ex_094_db_kv_wal_acid_store_cli.aipl
// ============================================================================
module Ex094DbKvWalAcidStoreCliTest

import {
  evaluateWalBatchAndPrefixScanCount,
  verifyWalCrashReplayAndCompaction,
  describeWalChecksumIntegrity
} from "../../examples/ex_094_db_kv_wal_acid_store_cli.aipl"

pub fn test_db_kv_wal_acid_store_cli(): int:
  assert(evaluateWalBatchAndPrefixScanCount() == 5, "3 batch ops committed + 2 metric.* prefix matches == 5")
  assert(verifyWalCrashReplayAndCompaction() == 1, "CRC32 WAL verification, crash log replay, and tombstone compaction pass")
  assert(describeWalChecksumIntegrity(true) == "WAL:CRC32_LOG_INTEGRITY_VERIFIED", "CRC32 verified label")
  ret 0

pub fn main(): int:
  test_db_kv_wal_acid_store_cli()
  println("PASS: ex_094_db_kv_wal_acid_store_cli_test")
  ret 0
