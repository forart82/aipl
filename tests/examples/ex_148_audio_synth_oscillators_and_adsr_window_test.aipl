// ============================================================================
// Twin Test Suite 148: Audio Synth Oscillators & ADSR Envelope (WINDOW)
// Verifies examples/ex_148_audio_synth_oscillators_and_adsr_window.aipl
// ============================================================================
module Ex148AudioSynthOscillatorsAndAdsrWindowTest

import {
  verifyOscillatorsFmAndAdsrEnvelope,
  computeTotalAdsrDurationMs,
  describeOscillatorWaveform,
  renderFrameStep
} from "../../examples/ex_148_audio_synth_oscillators_and_adsr_window.aipl"

pub fn test_audio_synth_oscillators_and_adsr_window(): int:
  assert(verifyOscillatorsFmAndAdsrEnvelope() == 1482, "441 sine samples + 441 FM samples + 600 permille sustain == 1482")
  assert(computeTotalAdsrDurationMs(50, 50, 100) == 200, "50ms attack + 50ms decay + 100ms release == 200ms")
  assert(describeOscillatorWaveform(1) == "SYNTH:POLYBLEP_SAWTOOTH_AND_4OP_FM", "oscillator waveform label")
  let f0 = renderFrameStep(0, 0.016)
  let f1 = renderFrameStep(1, 0.016)
  let f20 = renderFrameStep(20, 0.016)
  let f100 = renderFrameStep(100, 0.016)
  assert(f0 >= 1482, "frame 0 evaluates synth buffers and ADSR envelope gain")
  assert(f0 != f1, "ADSR envelope playhead gain and oscillator phase advance between frame 0 and frame 1")
  assert(f1 != f20, "ADSR envelope playhead gain and oscillator phase advance between frame 1 and frame 20")
  assert(f20 != f100, "ADSR envelope playhead gain and oscillator phase advance between frame 20 and frame 100")
  ret 0

pub fn main(): int:
  test_audio_synth_oscillators_and_adsr_window()
  println("PASS: ex_148_audio_synth_oscillators_and_adsr_window_test")
  ret 0
