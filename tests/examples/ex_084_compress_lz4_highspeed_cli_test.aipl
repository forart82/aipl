// ============================================================================
// Twin Test Suite 084: LZ4 High-Speed Block & Frame Codec (CLI)
// Verifies examples/ex_084_compress_lz4_highspeed_cli.aipl
// ============================================================================
module Ex084CompressLz4HighspeedCliTest

import {
  evaluateLz4BlockSavedBytes,
  verifyLz4BlockAndFrameRoundTrip,
  describeLz4CompressionTier
} from "../../examples/ex_084_compress_lz4_highspeed_cli.aipl"

pub fn test_compress_lz4_highspeed_cli(): int:
  assert(evaluateLz4BlockSavedBytes() > 0, "LZ4 block compression saves bytes on repetitive payload")
  assert(verifyLz4BlockAndFrameRoundTrip() == 1, "LZ4 block, frame, and quick APIs round-trip")
  assert(describeLz4CompressionTier(true) == "LZ4:REALTIME_64KB_DICT_SAVINGS", "positive byte savings")
  ret 0

pub fn main(): int:
  test_compress_lz4_highspeed_cli()
  println("PASS: ex_084_compress_lz4_highspeed_cli_test")
  ret 0
