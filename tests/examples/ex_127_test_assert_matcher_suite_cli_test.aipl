// ============================================================================
// Twin Test Suite 127: Rich Assertion Matchers & Diff Formatter (CLI)
// Verifies examples/ex_127_test_assert_matcher_suite_cli.aipl
// ============================================================================
module Ex127TestAssertMatcherSuiteCliTest

import {
  verifyAssertionMatcherSuiteAndDiffs,
  computeMatcherPassRatioPermille,
  describeAssertionOutcome
} from "../../examples/ex_127_test_assert_matcher_suite_cli.aipl"

pub fn test_test_assert_matcher_suite_cli(): int:
  assert(verifyAssertionMatcherSuiteAndDiffs() >= 3, "assertion matchers pass and formatDiffLines produces >= 3 diff lines")
  assert(computeMatcherPassRatioPermille(8, 8) == 1000, "8 / 8 assertions == 1000 permille")
  assert(describeAssertionOutcome(0) == "ASSERT:ALL_MATCHERS_GREEN", "0 failures label")
  ret 0

pub fn main(): int:
  test_test_assert_matcher_suite_cli()
  println("PASS: ex_127_test_assert_matcher_suite_cli_test")
  ret 0
