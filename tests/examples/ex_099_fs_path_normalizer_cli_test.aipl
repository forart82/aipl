// ============================================================================
// Twin Test Suite 099: Path Normalizer, Component Splitter & Traversal Guard (CLI)
// Verifies examples/ex_099_fs_path_normalizer_cli.aipl
// ============================================================================
module Ex099FsPathNormalizerCliTest

import {
  evaluateNormalizedPathAndComponentCount,
  verifyPathManipulationsAndTraversalGuard,
  describePathSecurityVerdict
} from "../../examples/ex_099_fs_path_normalizer_cli.aipl"

pub fn test_fs_path_normalizer_cli(): int:
  assert(evaluateNormalizedPathAndComponentCount() == "4:/var/log/app/access.log", "4 segments in /var/log/app/access.log")
  assert(verifyPathManipulationsAndTraversalGuard() == 1, "pathJoinMany, stem/ext, relativeTo, and traversal guard pass")
  assert(describePathSecurityVerdict(true) == "PATH:TRAVERSAL_ESCAPE_BLOCKED", "escape detected verdict")
  ret 0

pub fn main(): int:
  test_fs_path_normalizer_cli()
  println("PASS: ex_099_fs_path_normalizer_cli_test")
  ret 0
