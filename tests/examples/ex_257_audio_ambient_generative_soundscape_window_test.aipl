// ============================================================================
// Twin Test Suite 257: Audio Ambient Generative Soundscape (WINDOW)
// Verifies examples/ex_257_audio_ambient_generative_soundscape_window.aipl
// ============================================================================
module Ex257AudioAmbientGenerativeSoundscapeWindowTest

import {
  computeLydianHarmonicOrbFreqHz,
  describeGenerativeSoundscapeMode,
  renderFrameStep
} from "../../examples/ex_257_audio_ambient_generative_soundscape_window.aipl"

pub fn test_audio_ambient_generative_soundscape_window(): int:
  assert(describeGenerativeSoundscapeMode() == "GENERATIVE:LYDIAN_MAJ9_CHIME_SOUNDSCAPE", "generative lydian soundscape label")
  assert(int(computeLydianHarmonicOrbFreqHz(0)) == 174, "orb 0 F3 ~174Hz")
  assert(int(computeLydianHarmonicOrbFreqHz(3)) == 440, "orb 3 A4 440Hz")
  let f0 = renderFrameStep(0, 0.016)
  let f1 = renderFrameStep(1, 0.016)
  let f32 = renderFrameStep(32, 0.016)
  assert(f0 > 2000, "orb ripple metric > 2000")
  assert(f0 != f1, "orb ripples expand between frame 0 and frame 1")
  assert(f1 != f32, "orb swells advance at frame 32")
  ret 0

pub fn main(): int:
  test_audio_ambient_generative_soundscape_window()
  println("PASS: ex_257_audio_ambient_generative_soundscape_window_test")
  ret 0
