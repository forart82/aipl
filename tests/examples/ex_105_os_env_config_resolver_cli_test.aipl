// ============================================================================
// Twin Test Suite 105: OS Environment Variables, Expansion & PATH Splitter (CLI)
// Verifies examples/ex_105_os_env_config_resolver_cli.aipl
// ============================================================================
module Ex105OsEnvConfigResolverCliTest

import {
  evaluateEnvExpansionAndPathSegments,
  verifyEnvLifecycleAndDirectories,
  describeEnvResolutionSource
} from "../../examples/ex_105_os_env_config_resolver_cli.aipl"

pub fn test_os_env_config_resolver_cli(): int:
  assert(evaluateEnvExpansionAndPathSegments() == "port=8080:3", "expands AIPL_EX105_PORT to port=8080 and splits 3 PATH entries")
  assert(verifyEnvLifecycleAndDirectories() == 1, "osSetEnv, osGetEnv, osRemoveEnv, getEnvOr, and osCurrentDir pass")
  assert(describeEnvResolutionSource(true) == "ENV:PROCESS_EXPORT_OVERRIDE", "explicit env override label")
  ret 0

pub fn main(): int:
  test_os_env_config_resolver_cli()
  println("PASS: ex_105_os_env_config_resolver_cli_test")
  ret 0
