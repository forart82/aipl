// ============================================================================
// Twin Test Suite 048: DynamicBitSet Algebra & Probabilistic Bloom Filter (CLI)
// Verifies examples/ex_048_collections_bitset_bloom_filter_cli.aipl
// ============================================================================
module Ex048CollectionsBitsetBloomFilterCliTest

import {
  evaluateBitSetAlgebraCounts,
  verifyBloomFilterMembership,
  describeBloomFilterGuarantee
} from "../../examples/ex_048_collections_bitset_bloom_filter_cli.aipl"

pub fn test_bitset_and_bloom_filter(): int:
  // bsA {5, 10} OR bsB {5, 20} has 3 ones + 125 zeros -> 3 * 100 + 1 == 301 after AND leaves {5}
  assert(evaluateBitSetAlgebraCounts() == 301, "OR countOnes(3)*100 + AND countOnes(1) == 301")
  assert(verifyBloomFilterMembership("user_session_42", "unseen_ghost_99") == 1, "BloomFilter has zero false negatives and rejects unseen key")
  assert(describeBloomFilterGuarantee(0) == "BLOOM:ZERO_FALSE_NEGATIVES", "guarantee 0")
  ret 0

pub fn main(): int:
  test_bitset_and_bloom_filter()
  println("PASS: ex_048_collections_bitset_bloom_filter_cli_test")
  ret 0
