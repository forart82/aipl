// ============================================================================
// Twin Test Suite 124: HTTP Server Router, Path Params & SSE Formatter (CLI)
// Verifies examples/ex_124_net_http_server_router_middleware_cli.aipl
// ============================================================================
module Ex124NetHttpServerRouterMiddlewareCliTest

import {
  verifyHttpRouterPathMatchAndSse,
  computeMiddlewareChainOverheadUs,
  describeHttpRouteDispatch
} from "../../examples/ex_124_net_http_server_router_middleware_cli.aipl"

pub fn test_net_http_server_router_middleware_cli(): int:
  assert(verifyHttpRouterPathMatchAndSse() == 102, "routerMatch('/api/v1/users/9942') dispatches handlerId 102")
  assert(computeMiddlewareChainOverheadUs(4, 15) == 60, "4 middleware layers * 15us == 60us")
  assert(describeHttpRouteDispatch(1, 102) == "ROUTER:GET_HANDLER_102", "GET handler 102 label")
  ret 0

pub fn main(): int:
  test_net_http_server_router_middleware_cli()
  println("PASS: ex_124_net_http_server_router_middleware_cli_test")
  ret 0
