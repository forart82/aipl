// ============================================================================
// Twin Test Suite 128: Test Runner, TAP v14 & JUnit XML Reporter (CLI)
// Verifies examples/ex_128_test_runner_tap_junit_report_cli.aipl
// ============================================================================
module Ex128TestRunnerTapJunitReportCliTest

import {
  verifyTestSuiteTapAndJunitReports,
  computeFilteredTestCount,
  describeTestReporterFormat
} from "../../examples/ex_128_test_runner_tap_junit_report_cli.aipl"

pub fn test_test_runner_tap_junit_report_cli(): int:
  assert(verifyTestSuiteTapAndJunitReports() == 2, "CoreNetSuite registers, runs, and reports 2 test cases in TAP v14 and JUnit XML")
  assert(computeFilteredTestCount(15, 3) == 12, "15 total cases - 3 ignored == 12 active cases")
  assert(describeTestReporterFormat(14) == "RUNNER:TAP_V14_AND_JUNIT_XML", "TAP v14 + JUnit XML reporter label")
  ret 0

pub fn main(): int:
  test_test_runner_tap_junit_report_cli()
  println("PASS: ex_128_test_runner_tap_junit_report_cli_test")
  ret 0
