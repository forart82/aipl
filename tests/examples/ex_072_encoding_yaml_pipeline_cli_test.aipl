// ============================================================================
// Twin Test Suite 072: YAML CI/CD Pipeline Parser & JSON Bridge (CLI)
// Verifies examples/ex_072_encoding_yaml_pipeline_cli.aipl
// ============================================================================
module Ex072EncodingYamlPipelineCliTest

import {
  evaluateYamlEntriesAndStageListCount,
  verifyYamlToJsonBridge,
  describeYamlPipelineStage
} from "../../examples/ex_072_encoding_yaml_pipeline_cli.aipl"

pub fn test_encoding_yaml_pipeline_cli(): int:
  assert(evaluateYamlEntriesAndStageListCount() == 5, "2 map entries + 3 stage list items == 5")
  assert(verifyYamlToJsonBridge("host: localhost\nport: 5432\n") == 1, "yamlToJson and serializeYaml roundtrip valid")
  assert(describeYamlPipelineStage("deploy") == "YAML_STAGE:PRODUCTION_DEPLOY", "deploy stage label")
  ret 0

pub fn main(): int:
  test_encoding_yaml_pipeline_cli()
  println("PASS: ex_072_encoding_yaml_pipeline_cli_test")
  ret 0
