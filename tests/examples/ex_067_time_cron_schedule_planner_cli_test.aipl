// ============================================================================
// Twin Test Suite 067: Cron Expression Parser & Schedule Planner (CLI)
// Verifies examples/ex_067_time_cron_schedule_planner_cli.aipl
// ============================================================================
module Ex067TimeCronSchedulePlannerCliTest

import {
  computeNextCronFireMinute,
  verifyCronMatrixMatchesCount,
  describeCronSchedulePolicy
} from "../../examples/ex_067_time_cron_schedule_planner_cli.aipl"

pub fn test_time_cron_schedule_planner_cli(): int:
  assert(computeNextCronFireMinute("*/15 * * * *", "2026-11-04T12:10:00Z") == 15, "next fire minute after 12:10 for */15 is 15")
  assert(verifyCronMatrixMatchesCount("*/15 * * * *") == 2, "00 and 15 match out of [0, 10, 15]")
  assert(describeCronSchedulePolicy("*/15 * * * *").len > 0, "explainCron returns non-empty explanation")
  ret 0

pub fn main(): int:
  test_time_cron_schedule_planner_cli()
  println("PASS: ex_067_time_cron_schedule_planner_cli_test")
  ret 0
