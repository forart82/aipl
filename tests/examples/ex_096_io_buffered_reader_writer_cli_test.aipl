// ============================================================================
// Twin Test Suite 096: Buffered Reader Refill & Buffered Writer Flush (CLI)
// Verifies examples/ex_096_io_buffered_reader_writer_cli.aipl
// ============================================================================
module Ex096IoBufferedReaderWriterCliTest

import {
  evaluateBufReaderLinesAndFlushedLen,
  verifyBufReaderDelimiterAndMultiFill,
  describeBufferFlushPolicy
} from "../../examples/ex_096_io_buffered_reader_writer_cli.aipl"

pub fn test_io_buffered_reader_writer_cli(): int:
  assert(evaluateBufReaderLinesAndFlushedLen() == 8, "3 CRLF/LF lines + 5 flushed bytes == 8")
  assert(verifyBufReaderDelimiterAndMultiFill() == 1, "bufReaderRead across 2-byte window and bufReaderReadUntil pass")
  assert(describeBufferFlushPolicy(4) == "BUFIO:RING_WINDOW_4B_AUTO_FLUSH", "4-byte capacity policy")
  ret 0

pub fn main(): int:
  test_io_buffered_reader_writer_cli()
  println("PASS: ex_096_io_buffered_reader_writer_cli_test")
  ret 0
