// ============================================================================
// Twin Test Suite 086: POSIX USTAR Tar Archive Bundler & Checksum Verifier (CLI)
// Verifies examples/ex_086_compress_tar_archive_bundler_cli.aipl
// ============================================================================
module Ex086CompressTarArchiveBundlerCliTest

import {
  evaluateTarArchiveUnpackedCount,
  verifyTarBundleAndStoredDeflateRoundTrip,
  describeTarBlockAlignment
} from "../../examples/ex_086_compress_tar_archive_bundler_cli.aipl"

pub fn test_compress_tar_archive_bundler_cli(): int:
  assert(evaluateTarArchiveUnpackedCount() == 3, "1 directory + 2 files unpacked == 3 entries")
  assert(verifyTarBundleAndStoredDeflateRoundTrip() == 1, "512-byte aligned tar packed into stored DEFLATE and unpacked intact")
  assert(describeTarBlockAlignment(2560) == "TAR:POSIX_USTAR_512B_ALIGNED", "2560 is a multiple of 512")
  ret 0

pub fn main(): int:
  test_compress_tar_archive_bundler_cli()
  println("PASS: ex_086_compress_tar_archive_bundler_cli_test")
  ret 0
