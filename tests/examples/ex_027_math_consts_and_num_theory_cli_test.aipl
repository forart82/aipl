// ============================================================================
// Twin Test Suite 027: Math Constants, Interpolation & Galois Field GF(256) (CLI)
// Verifies examples/ex_027_math_consts_and_num_theory_cli.aipl
// ============================================================================
module Ex027MathConstsAndNumTheoryCliTest

import {
  verifyTranscendentalConstants,
  evaluateInterpolationPipeline,
  verifyGaloisField256AndNumTheory,
  describeGaloisIdentity
} from "../../examples/ex_027_math_consts_and_num_theory_cli.aipl"

pub fn test_math_constants_and_interpolation(): int:
  assert(verifyTranscendentalConstants() == 1, "PI, TAU, and E match transcendental identities")
  assert(evaluateInterpolationPipeline(5.0) == 150, "remap(0..10 -> 100..200, 5.0) == 150 with smoothstep == 0.5")
  ret 0

pub fn test_gf256_and_number_theory(): int:
  assert(verifyGaloisField256AndNumTheory(53, 83) == 18, "GF(256) inverse/div identity + gcd(12,18)=6 + lcm(4,6)=12 == 18")
  assert(describeGaloisIdentity(1) == "GF256:INVERSE_IDENTITY_OK", "identity == 1")
  ret 0

pub fn main(): int:
  test_math_constants_and_interpolation()
  test_gf256_and_number_theory()
  println("PASS: ex_027_math_consts_and_num_theory_cli_test")
  ret 0
