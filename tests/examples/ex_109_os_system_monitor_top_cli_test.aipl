// ============================================================================
// Twin Test Suite 109: System Telemetry Monitor (CPU, RAM, Processes & Top) (CLI)
// Verifies examples/ex_109_os_system_monitor_top_cli.aipl
// ============================================================================
module Ex109OsSystemMonitorTopCliTest

import {
  evaluateHostPlatformAndArchSummary,
  verifySystemMemoryProcessesAndTopWidgets,
  describeSystemLoadPosture
} from "../../examples/ex_109_os_system_monitor_top_cli.aipl"

pub fn test_os_system_monitor_top_cli(): int:
  assert(evaluateHostPlatformAndArchSummary() == "linux:x86_64", "detects linux x86_64 host")
  assert(verifySystemMemoryProcessesAndTopWidgets() == 1, "osCpuCount, getMemoryInfo, listProcesses, and renderBarChart/renderBox pass")
  assert(describeSystemLoadPosture(42) == "SYS_TOP:NOMINAL_LOAD_GREEN", "42% load posture")
  ret 0

pub fn main(): int:
  test_os_system_monitor_top_cli()
  println("PASS: ex_109_os_system_monitor_top_cli_test")
  ret 0
