// ============================================================================
// Twin Test Suite 143: Texture Atlas MaxRects Bin Packer & 2px Gutters (WINDOW)
// Verifies examples/ex_143_asset_atlas_packer_shelf_maxrects_window.aipl
// ============================================================================
module Ex143AssetAtlasPackerShelfMaxrectsWindowTest

import {
  verifyMaxRectsAtlasPackerAndGutters,
  computePaddedSpriteSpanPx,
  describeAtlasPackerHeuristic,
  renderFrameStep
} from "../../examples/ex_143_asset_atlas_packer_shelf_maxrects_window.aipl"

pub fn test_asset_atlas_packer_shelf_maxrects_window(): int:
  assert(verifyMaxRectsAtlasPackerAndGutters() == 6, "all 6 sprite rectangles pack into 256x256 atlas with 2px bleed gutters")
  assert(computePaddedSpriteSpanPx(64, 2) == 68, "64px sprite + 2*2px gutter == 68px")
  assert(describeAtlasPackerHeuristic(2) == "ATLAS:MAXRECTS_GUTTER_2PX", "2px gutter MaxRects label")
  let o0 = renderFrameStep(0, 0.016)
  let o1 = renderFrameStep(1, 0.016)
  let o20 = renderFrameStep(20, 0.016)
  let o100 = renderFrameStep(100, 0.016)
  assert(o0 > 150, "frame 0 packs sprites and returns occupancy permille > 150")
  assert(o0 != o1, "atlas occupancy and dynamic sprite placement advance between frame 0 and frame 1")
  assert(o1 != o20, "atlas occupancy and dynamic sprite placement advance between frame 1 and frame 20")
  assert(o20 != o100, "atlas occupancy and dynamic sprite placement advance between frame 20 and frame 100")
  ret 0

pub fn main(): int:
  test_asset_atlas_packer_shelf_maxrects_window()
  println("PASS: ex_143_asset_atlas_packer_shelf_maxrects_window_test")
  ret 0
