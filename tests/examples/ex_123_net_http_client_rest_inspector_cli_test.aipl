// ============================================================================
// Twin Test Suite 123: HTTP Client Pool, REST Inspector & Multipart Encoder (CLI)
// Verifies examples/ex_123_net_http_client_rest_inspector_cli.aipl
// ============================================================================
module Ex123NetHttpClientRestInspectorCliTest

import {
  verifyHttpClientPoolRestAndHeaders,
  computeHttpStatusClassBucket,
  describeHttpStatusCategory
} from "../../examples/ex_123_net_http_client_rest_inspector_cli.aipl"

pub fn test_net_http_client_rest_inspector_cli(): int:
  assert(verifyHttpClientPoolRestAndHeaders() == 600, "httpGet(200) + httpPost(200) + httpSend(200) == 600")
  assert(computeHttpStatusClassBucket(200) == 2, "200 belongs to 2xx status bucket")
  assert(describeHttpStatusCategory(200) == "HTTP:STATUS_2XX_SUCCESS_200", "HTTP 200 status label")
  ret 0

pub fn main(): int:
  test_net_http_client_rest_inspector_cli()
  println("PASS: ex_123_net_http_client_rest_inspector_cli_test")
  ret 0
