// ============================================================================
// Twin Test Suite 107: POSIX Signal Coordinator & Priority Shutdown Hooks (CLI)
// Verifies examples/ex_107_os_signal_graceful_shutdown_cli.aipl
// ============================================================================
module Ex107OsSignalGracefulShutdownCliTest

import {
  evaluateShutdownHookExecutionOrder,
  verifySignalQueueAndHandlerLifecycle,
  describePosixSignalAction
} from "../../examples/ex_107_os_signal_graceful_shutdown_cli.aipl"

pub fn test_os_signal_graceful_shutdown_cli(): int:
  assert(evaluateShutdownHookExecutionOrder() == "close_sockets->flush_db", "priority 20 hook runs before priority 10 hook")
  assert(verifySignalQueueAndHandlerLifecycle() == 1, "register/unregister handler, raise/poll SIGINT(2), and exitProcess pass")
  assert(describePosixSignalAction(15) == "SIGNAL:SIGTERM_GRACEFUL_DRAIN", "SIGTERM(15) descriptor")
  ret 0

pub fn main(): int:
  test_os_signal_graceful_shutdown_cli()
  println("PASS: ex_107_os_signal_graceful_shutdown_cli_test")
  ret 0
