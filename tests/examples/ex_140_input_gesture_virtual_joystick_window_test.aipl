// ============================================================================
// Twin Test Suite 140: Radial-Clamped Virtual Joystick & Gestures (WINDOW)
// Verifies examples/ex_140_input_gesture_virtual_joystick_window.aipl
// ============================================================================
module Ex140InputGestureVirtualJoystickWindowTest

import {
  verifyVirtualJoystickPinchAndDoubleTap,
  computeFittsLawHitboxPaddingDp,
  describeVirtualJoystickState,
  renderFrameStep
} from "../../examples/ex_140_input_gesture_virtual_joystick_window.aipl"

pub fn test_input_gesture_virtual_joystick_window(): int:
  assert(verifyVirtualJoystickPinchAndDoubleTap() == 250, "handle clamped at x=250 (origin 150 + radius 100) and pinch/double-tap pass")
  assert(computeFittsLawHitboxPaddingDp(36, 48) == 12, "48dp floor - 36dp icon == 12dp invisible hitbox padding")
  assert(describeVirtualJoystickState(42) == "JOYSTICK:ACTIVE_POINTER_42", "bound pointer 42 label")
  let g0 = renderFrameStep(0, 0.016)
  let g1 = renderFrameStep(1, 0.016)
  let g20 = renderFrameStep(20, 0.016)
  let g100 = renderFrameStep(100, 0.016)
  assert(g0 > 0, "frame 0 returns positive clamped joystick and pinch scale metric")
  assert(g0 != g1, "virtual joystick handle and pinch scale advance between frame 0 and frame 1")
  assert(g1 != g20, "virtual joystick handle and pinch scale advance between frame 1 and frame 20")
  assert(g20 != g100, "virtual joystick handle and pinch scale advance between frame 20 and frame 100")
  ret 0

pub fn main(): int:
  test_input_gesture_virtual_joystick_window()
  println("PASS: ex_140_input_gesture_virtual_joystick_window_test")
  ret 0
