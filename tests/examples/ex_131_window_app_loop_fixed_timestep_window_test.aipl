// ============================================================================
// Twin Test Suite 131: Fixed-Timestep App Loop & Alpha Interpolation (WINDOW)
// Verifies examples/ex_131_window_app_loop_fixed_timestep_window.aipl
// ============================================================================
module Ex131WindowAppLoopFixedTimestepWindowTest

import {
  verifyAppLoopFixedTimestepAccumulator,
  computeRenderInterpolationPermille,
  clampSubstepsPerFrame,
  renderFrameStep
} from "../../examples/ex_131_window_app_loop_fixed_timestep_window.aipl"

pub fn test_window_app_loop_fixed_timestep_window(): int:
  assert(verifyAppLoopFixedTimestepAccumulator() == 500, "stepAppLoop(0.025s at 60Hz) yields 500 permille alpha remainder")
  assert(computeRenderInterpolationPermille(8333, 16666) == 500, "8333 / 16666 == 500 permille")
  assert(clampSubstepsPerFrame(3, 8) == 3, "clamped substeps 3 <= 8")
  let f0 = renderFrameStep(0, 0.016)
  let f1 = renderFrameStep(1, 0.016)
  let f20 = renderFrameStep(20, 0.016)
  let f100 = renderFrameStep(100, 0.016)
  assert(f0 < f1 and f1 < f20 and f20 < f100, "renderFrameStep advances AppLoopState across frames 0 -> 1 -> 20 -> 100")
  ret 0

pub fn main(): int:
  test_window_app_loop_fixed_timestep_window()
  println("PASS: ex_131_window_app_loop_fixed_timestep_window_test")
  ret 0
