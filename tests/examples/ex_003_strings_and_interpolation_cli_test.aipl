// ============================================================================
// Twin Test Suite 003: Strings, Interpolation, Slicing & StringBuilder CLI
// Verifies examples/ex_003_strings_and_interpolation_cli.aipl (written before example)
// ============================================================================
module Ex003StringsAndInterpolationCliTest

import {
  StringTemplateSummary,
  formatKeyValLine,
  extractDomainView,
  classifyIdentifierToken,
  buildStringTemplateSummary
} from "../../examples/ex_003_strings_and_interpolation_cli.aipl"

pub fn test_string_builder_and_view_slicing(): int:
  let line = formatKeyValLine("engine", "aipl-v4", 42)
  assert(line == "engine=aipl-v4 (id:42)", "StringBuilder formats key=value (id:N)")
  let dom = extractDomainView("std/fmt/str_builder.aipl", 4, 3)
  assert(dom == "fmt", "stringViewFrom extracts 'fmt' slice")
  ret 0

pub fn test_template_summary_metrics(): int:
  let summary = buildStringTemplateSummary("aipl", "4.0.0", 250)
  assert(summary.rendered == "[aipl@4.0.0] examples=250", "rendered template matches")
  assert(summary.charLength == 25, "rendered length is 25")
  assert(summary.prefixSlice == "aipl", "prefixSlice is 'aipl'")
  ret 0

pub fn test_token_classification(): int:
  assert(classifyIdentifierToken("camelCase") == "STR:ALPHA_ONLY", "alpha token")
  assert(classifyIdentifierToken("2026") == "STR:DIGITS_ONLY", "digits token")
  assert(classifyIdentifierToken("v4_beta") == "STR:MIXED_TOKEN", "mixed token")
  ret 0

pub fn main(): int:
  test_string_builder_and_view_slicing()
  test_template_summary_metrics()
  test_token_classification()
  println("PASS: ex_003_strings_and_interpolation_cli_test")
  ret 0
