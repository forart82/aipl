// ============================================================================
// Twin Test Suite 041: Complex64 Algebra & Radix-2 FFT Spectrum Analyzer (CLI)
// Verifies examples/ex_041_math_complex_and_fft_spectrum_cli.aipl
// ============================================================================
module Ex041MathComplexAndFftSpectrumCliTest

import {
  computeFftBinCenterHz,
  computeComplexPowerSq,
  classifySpectralLobe,
  verifyComplex64AlgebraAndConjugate,
  evaluateRadix2FftRoundtripDcBin
} from "../../examples/ex_041_math_complex_and_fft_spectrum_cli.aipl"

pub fn test_fft_bin_and_power_metrics(): int:
  assert(computeFftBinCenterHz(16, 48000) == 750, "(16 * 48000) / 1024 == 750 Hz")
  assert(computeComplexPowerSq(300, 400) == 250, "(300^2 + 400^2) / 1000 == 250")
  assert(classifySpectralLobe(0) == "FFT:DC_COMPONENT", "bin 0 is DC component")
  assert(classifySpectralLobe(512) == "FFT:NYQUIST_FOLD", "bin 512 is Nyquist")
  assert(classifySpectralLobe(16) == "FFT:HARMONIC_BIN", "bin 16 is harmonic")
  ret 0

pub fn test_real_std_complex64_and_fft_radix2(): int:
  assert(verifyComplex64AlgebraAndConjugate() == 21, "add.re(4) + sub.im(6) + mul.re(11) == 21 with mag == 5")
  assert(evaluateRadix2FftRoundtripDcBin() == 9, "8-sample constant signal has forward DC 8 + inverse DC 1 == 9")
  ret 0

pub fn main(): int:
  test_fft_bin_and_power_metrics()
  test_real_std_complex64_and_fft_radix2()
  println("PASS: ex_041_math_complex_and_fft_spectrum_cli_test")
  ret 0
