// ============================================================================
// Twin Test Suite 100: VFS File Handles, Exclusive Locks & Atomic Write (CLI)
// Verifies examples/ex_100_fs_file_atomic_write_cli.aipl
// ============================================================================
module Ex100FsFileAtomicWriteCliTest

import {
  evaluateVfsAppendAndTruncateByteCount,
  verifyFileExclusiveLockAndAtomicWrite,
  describeAtomicPersistenceStage
} from "../../examples/ex_100_fs_file_atomic_write_cli.aipl"

pub fn test_fs_file_atomic_write_cli(): int:
  assert(evaluateVfsAppendAndTruncateByteCount() == 16, "11 bytes after append + 5 bytes after truncate == 16")
  assert(verifyFileExclusiveLockAndAtomicWrite() == 1, "flock exclusive contention, unlock, and fsAtomicWriteSim pass")
  assert(describeAtomicPersistenceStage(true) == "FS:ATOMIC_TMP_RENAME_COMMITTED", "atomic commit stage")
  ret 0

pub fn main(): int:
  test_fs_file_atomic_write_cli()
  println("PASS: ex_100_fs_file_atomic_write_cli_test")
  ret 0
