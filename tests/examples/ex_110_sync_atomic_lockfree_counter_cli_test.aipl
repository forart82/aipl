// ============================================================================
// Twin Test Suite 110: Lock-Free AtomicInt, AtomicBool CAS & Memory Fence (CLI)
// Verifies examples/ex_110_sync_atomic_lockfree_counter_cli.aipl
// ============================================================================
module Ex110SyncAtomicLockfreeCounterCliTest

import {
  evaluateAtomicCounterAndUsizeSum,
  verifyAtomicBoolCasAndMemoryFence,
  describeAtomicMemoryOrder
} from "../../examples/ex_110_sync_atomic_lockfree_counter_cli.aipl"

pub fn test_sync_atomic_lockfree_counter_cli(): int:
  assert(evaluateAtomicCounterAndUsizeSum() == 225, "atomicInt(200) + atomicUsize(25) == 225")
  assert(verifyAtomicBoolCasAndMemoryFence() == 1, "atomicBoolCompareAndSwap and SeqCst memory fence pass")
  assert(describeAtomicMemoryOrder(4) == "ATOMIC:SEQ_CST_TOTAL_ORDER", "order 4 is SeqCst")
  ret 0

pub fn main(): int:
  test_sync_atomic_lockfree_counter_cli()
  println("PASS: ex_110_sync_atomic_lockfree_counter_cli_test")
  ret 0
