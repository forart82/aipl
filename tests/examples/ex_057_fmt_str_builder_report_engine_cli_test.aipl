// ============================================================================
// Twin Test Suite 057: StringBuilder Report Engine & Casing/Similarity (CLI)
// Verifies examples/ex_057_fmt_str_builder_report_engine_cli.aipl
// ============================================================================
module Ex057FmtStrBuilderReportEngineCliTest

import {
  buildStructuredReportAndCasing,
  evaluateStringSimilarityMetrics,
  describeReportBuilderMode
} from "../../examples/ex_057_fmt_str_builder_report_engine_cli.aipl"

pub fn test_string_builder_and_similarity(): int:
  assert(buildStructuredReportAndCasing("user_profile") == "userProfile:UserProfile:user-profile", "camel, pascal, and kebab casing")
  // levenshtein("kitten","sitting")==3 + TextRange(2,7).len()==5 == 8
  assert(evaluateStringSimilarityMetrics() == 8, "Levenshtein(3) + TextRange(5) == 8")
  assert(describeReportBuilderMode(0) == "STR_BUILDER:ZERO_REALLOC_INDENTED", "mode 0")
  ret 0

pub fn main(): int:
  test_string_builder_and_similarity()
  println("PASS: ex_057_fmt_str_builder_report_engine_cli_test")
  ret 0
