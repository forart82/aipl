module Ex188ParticleRibbonTrailSwordSlashWindowTest

import {
  buildParticleRibbonTrailAudit, stepSwordSlashTrail
} from "../../examples/ex_188_particle_ribbon_trail_sword_slash_window"
import { Vec3 } from "../../std/math/vec_math"
import { ColorRgba8 } from "../../std/gfx/color"
import {
  createRibbonTrail, pushRibbonPosition, updateRibbonTrail,
  generateRibbonQuadStrip, ribbonTrailLength
} from "../../std/particle/ribbon_trail"

pub fn test_particle_ribbon_trail_sword_slash(): void:
  mut trail = createRibbonTrail(32, 1.0, 1.0)
  trail = pushRibbonPosition(trail, Vec3(x = 0.0, y = 0.0, z = 0.0), 4.0)
  trail = pushRibbonPosition(trail, Vec3(x = 0.0, y = 0.0, z = 6.0), 4.0)
  trail = pushRibbonPosition(trail, Vec3(x = 0.0, y = 0.0, z = 12.0), 4.0)
  assert(trail.nodes.len() == 3, "3 ribbon nodes pushed above minSegmentDist=1.0")
  assert(ribbonTrailLength(trail) == 12.0, "Total ribbon arc length == 12.0")

  let cyan = ColorRgba8(r = 56, g = 189, b = 248, a = 255)
  let stripVerts = generateRibbonQuadStrip(trail, Vec3(x = 0.0, y = 10.0, z = 6.0), cyan)
  assert(stripVerts.len() == 6, "3 nodes emit 6 quad-strip vertices (2 left/right pairs per node)")

  let expired = updateRibbonTrail(trail, 1.5)
  assert(expired.nodes.len() == 0, "All nodes expire when dt=1.5s > maxNodeAge=1.0s")

  mut slashTrail = createRibbonTrail(16, 0.4, 2.0)
  slashTrail = stepSwordSlashTrail(slashTrail, 0, 0.016)
  let pos0 = slashTrail.nodes[slashTrail.nodes.len() - 1].position
  slashTrail = stepSwordSlashTrail(slashTrail, 1, 0.016)
  let pos1 = slashTrail.nodes[slashTrail.nodes.len() - 1].position
  slashTrail = stepSwordSlashTrail(slashTrail, 2, 0.016)
  assert(slashTrail.nodes.len() == 3, "stepSwordSlashTrail appends new sword tip node each frame")
  assert(slashTrail.nodes[0].ageSec > 0.03, "stepSwordSlashTrail ages existing nodes via updateRibbonTrail")

  let slashStrip = generateRibbonQuadStrip(slashTrail, Vec3(x = 340.0, y = 310.0, z = 500.0), cyan)
  assert(slashStrip[0].pos.x != slashStrip[1].pos.x or slashStrip[0].pos.y != slashStrip[1].pos.y, "Camera-facing ribbon strip extrudes non-zero 2D width")

  // Multi-frame progression across t=0 -> t=1 -> t=20 -> t=100
  let tr20 = stepSwordSlashTrail(slashTrail, 20, 0.016)
  let pos20 = tr20.nodes[tr20.nodes.len() - 1].position
  let tr100 = stepSwordSlashTrail(tr20, 100, 0.016)
  let pos100 = tr100.nodes[tr100.nodes.len() - 1].position
  assert(pos0.x != pos1.x or pos0.y != pos1.y, "Sword tip advances from t=0 to t=1")
  assert(pos1.x != pos20.x or pos1.y != pos20.y, "Sword tip advances from t=1 to t=20")
  assert(pos20.x != pos100.x or pos20.y != pos100.y, "Sword tip advances from t=20 to t=100 without freezing")
  assert(buildParticleRibbonTrailAudit() == 21, "buildParticleRibbonTrailAudit returns 3 + 12 + 6 + 0 == 21")

pub fn main(): int:
  test_particle_ribbon_trail_sword_slash()
  println("PASS: ex_188_particle_ribbon_trail_sword_slash_window_test")
  ret 0
