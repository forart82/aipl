// ============================================================================
// Twin Test Suite 051: DirectedGraph Dijkstra Shortest Path & DSU MST (CLI)
// Verifies examples/ex_051_collections_graph_dijkstra_mst_cli.aipl
// ============================================================================
module Ex051CollectionsGraphDijkstraMstCliTest

import {
  computeRelaxedPathCost,
  computeMstTargetEdgeCount,
  classifyGraphTopology,
  evaluateDijkstraAndDsuMst
} from "../../examples/ex_051_collections_graph_dijkstra_mst_cli.aipl"

pub fn test_graph_relaxation_and_mst_metrics(): int:
  assert(computeRelaxedPathCost(120, 35) == 155, "120 + 35 == 155")
  assert(computeMstTargetEdgeCount(16, 1) == 15, "16 vertices - 1 component == 15 MST edges")
  assert(classifyGraphTopology(0) == "GRAPH:DAG_VALID", "0 cycles is DAG_VALID")
  assert(classifyGraphTopology(2) == "GRAPH:CYCLIC_FEEDBACK", "2 cycles is cyclic")
  ret 0

pub fn test_real_dijkstra_and_dsu_kruskal(): int:
  // Shortest path 0->1->2->3 has 4 nodes + DSU remaining sets(2) == 6
  assert(evaluateDijkstraAndDsuMst() == 6, "Dijkstra path length(4) + DSU components(2) == 6")
  ret 0

pub fn main(): int:
  test_graph_relaxation_and_mst_metrics()
  test_real_dijkstra_and_dsu_kruskal()
  println("PASS: ex_051_collections_graph_dijkstra_mst_cli_test")
  ret 0
