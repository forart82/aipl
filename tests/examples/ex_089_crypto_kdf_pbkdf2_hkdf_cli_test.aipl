// ============================================================================
// Twin Test Suite 089: HKDF-SHA256, PBKDF2-HMAC-SHA256 & Argon2id KDF (CLI)
// Verifies examples/ex_089_crypto_kdf_pbkdf2_hkdf_cli.aipl
// ============================================================================
module Ex089CryptoKdfPbkdf2HkdfCliTest

import {
  evaluateDerivedKeyBytesSum,
  verifyArgon2idAndHkdfStages,
  describeKdfSecurityProfile
} from "../../examples/ex_089_crypto_kdf_pbkdf2_hkdf_cli.aipl"

pub fn test_crypto_kdf_pbkdf2_hkdf_cli(): int:
  assert(evaluateDerivedKeyBytesSum() == 112, "PRK(32) + OKM(48) + PBKDF2(32) == 112 bytes")
  assert(verifyArgon2idAndHkdfStages() == 1, "hkdfSha256, argon2idVerify match and wrong password rejected")
  assert(describeKdfSecurityProfile(64) == "KDF:ARGON2ID_MEMORY_HARD_64KIB", "64 KiB Argon2id profile")
  ret 0

pub fn main(): int:
  test_crypto_kdf_pbkdf2_hkdf_cli()
  println("PASS: ex_089_crypto_kdf_pbkdf2_hkdf_cli_test")
  ret 0
