// ============================================================================
// Twin Test Suite 134: Custom Crosshair & Locked Cursor State Machine (WINDOW)
// Verifies examples/ex_134_window_cursor_custom_crosshair_window.aipl
// ============================================================================
module Ex134WindowCursorCustomCrosshairWindowTest

import {
  verifyCursorCrosshairAndLockState,
  computeDynamicCrosshairSpreadPx,
  describeCursorCaptureMode,
  renderFrameStep
} from "../../examples/ex_134_window_cursor_custom_crosshair_window.aipl"

pub fn test_window_cursor_custom_crosshair_window(): int:
  assert(verifyCursorCrosshairAndLockState() == 13, "CROSSHAIR shape(3) + deltaX(10) == 13")
  assert(computeDynamicCrosshairSpreadPx(8, 12) == 20, "8px base gap + 12px velocity bloom == 20px")
  assert(describeCursorCaptureMode(2) == "CURSOR:LOCKED_RAW_MOTION", "CURSOR_MODE_LOCKED (2) label")
  let f0 = renderFrameStep(0, 0.016)
  let f1 = renderFrameStep(1, 0.016)
  let f20 = renderFrameStep(20, 0.016)
  let f100 = renderFrameStep(100, 0.016)
  assert(f0 != f1, "renderFrameStep updates CursorState deltaX/deltaY at frame 1")
  assert(f1 != f20, "renderFrameStep updates CursorState deltaX/deltaY at frame 20")
  assert(f20 != f100, "renderFrameStep updates CursorState deltaX/deltaY at frame 100")
  ret 0

pub fn main(): int:
  test_window_cursor_custom_crosshair_window()
  println("PASS: ex_134_window_cursor_custom_crosshair_window_test")
  ret 0
