// ============================================================================
// Twin Test Suite 050: FlatArray2D/3D Stencil Neighbors & Flood Fill (CLI)
// Verifies examples/ex_050_collections_grid2d_flood_fill_cli.aipl
// ============================================================================
module Ex050CollectionsGrid2dFloodFillCliTest

import {
  evaluateGrid2DNeighborsAndCrossFill,
  verifyFlatArray3DVoxelWrite,
  describeGridNeighborhoodKind
} from "../../examples/ex_050_collections_grid2d_flood_fill_cli.aipl"

pub fn test_grid2d_and_grid3d(): int:
  // Center + 4 cardinal neighbors set to 7 -> 5 * 7 == 35 + neighbors8.len(8) == 43
  assert(evaluateGrid2DNeighborsAndCrossFill() == 43, "5 filled cells * 7 + 8 Moore neighbors == 43")
  assert(verifyFlatArray3DVoxelWrite(42) == 42, "FlatArray3Dcenter voxel readback == 42")
  assert(describeGridNeighborhoodKind(4) == "GRID2D:VON_NEUMANN_4_CONNECTED", "4-connected")
  assert(describeGridNeighborhoodKind(8) == "GRID2D:MOORE_8_CONNECTED", "8-connected")
  ret 0

pub fn main(): int:
  test_grid2d_and_grid3d()
  println("PASS: ex_050_collections_grid2d_flood_fill_cli_test")
  ret 0
