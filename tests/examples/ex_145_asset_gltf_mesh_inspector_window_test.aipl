// ============================================================================
// Twin Test Suite 145: glTF 2.0 / GLB Binary Mesh & Accessor Inspector (WINDOW)
// Verifies examples/ex_145_asset_gltf_mesh_inspector_window.aipl
// ============================================================================
module Ex145AssetGltfMeshInspectorWindowTest

import {
  verifyGltfJsonAndGlbBinaryExtractor,
  computeVertexBufferBytes,
  describeGlbChunkType,
  renderFrameStep
} from "../../examples/ex_145_asset_gltf_mesh_inspector_window.aipl"

pub fn test_asset_gltf_mesh_inspector_window(): int:
  assert(verifyGltfJsonAndGlbBinaryExtractor() == 12, "9 extracted vertex floats + 3 triangle indices == 12")
  assert(computeVertexBufferBytes(3, 32) == 96, "3 vertices * 32-byte stride (POS+NORM+UV) == 96 bytes")
  assert(describeGlbChunkType(1) == "GLTF:CHUNK_JSON_AND_BIN_V2", "GLB v2 chunk type label")
  let f0 = renderFrameStep(0, 0.016)
  let f1 = renderFrameStep(1, 0.016)
  let f20 = renderFrameStep(20, 0.016)
  let f100 = renderFrameStep(100, 0.016)
  assert(f0 > 12, "frame 0 parses glTF binary buffer and extracts vertex coordinates")
  assert(f0 != f1, "parsed glTF binary buffer vertex positions advance between frame 0 and frame 1")
  assert(f1 != f20, "parsed glTF binary buffer vertex positions advance between frame 1 and frame 20")
  assert(f20 != f100, "parsed glTF binary buffer vertex positions advance between frame 20 and frame 100")
  ret 0

pub fn main(): int:
  test_asset_gltf_mesh_inspector_window()
  println("PASS: ex_145_asset_gltf_mesh_inspector_window_test")
  ret 0
