// ============================================================================
// Twin Test Suite 151: 3D Spatial Audio Attenuation & Doppler Radar (WINDOW)
// Verifies examples/ex_151_audio_spatial_3d_doppler_radar_window.aipl
// ============================================================================
module Ex151AudioSpatial3dDopplerRadarWindowTest

import {
  verifySpatialAudioGainAndDoppler,
  computeDopplerShiftedFreqHz,
  describeSpatialRolloffModel,
  renderFrameStep
} from "../../examples/ex_151_audio_spatial_3d_doppler_radar_window.aipl"

pub fn test_audio_spatial_3d_doppler_radar_window(): int:
  assert(verifySpatialAudioGainAndDoppler() == 1211, "100 permille 10m attenuation + 1111 permille Mach-0.1 Doppler factor == 1211")
  assert(computeDopplerShiftedFreqHz(440, 1111) == 488, "440Hz * 1111 / 1000 == 488Hz approaching pitch")
  assert(describeSpatialRolloffModel(1) == "SPATIAL:INVERSE_DISTANCE_DOPPLER_343MS", "inverse distance + 343m/s speed of sound label")
  let f0 = renderFrameStep(0, 0.016)
  let f1 = renderFrameStep(1, 0.016)
  let f20 = renderFrameStep(20, 0.016)
  let f100 = renderFrameStep(100, 0.016)
  assert(f0 > 1211, "frame 0 evaluates spatial binaural gain and Doppler shifted pitch")
  assert(f0 != f1, "spatial binaural gain and Doppler shift advance between frame 0 and frame 1")
  assert(f1 != f20, "spatial binaural gain and Doppler shift advance between frame 1 and frame 20")
  assert(f20 != f100, "spatial binaural gain and Doppler shift advance between frame 20 and frame 100")
  ret 0

pub fn main(): int:
  test_audio_spatial_3d_doppler_radar_window()
  println("PASS: ex_151_audio_spatial_3d_doppler_radar_window_test")
  ret 0
