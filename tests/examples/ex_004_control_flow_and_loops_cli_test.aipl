// ============================================================================
// Twin Test Suite 004: Control Flow, Range Loops, Collatz & Euclidean GCD CLI
// Verifies examples/ex_004_control_flow_and_loops_cli.aipl (written before example)
// ============================================================================
module Ex004ControlFlowAndLoopsCliTest

import {
  LoopExecutionStats,
  countCollatzSteps,
  sumMultiplesInRange,
  classifyCyclePeriod,
  buildLoopExecutionStats
} from "../../examples/ex_004_control_flow_and_loops_cli.aipl"

pub fn test_collatz_while_loop_and_range_sum(): int:
  assert(countCollatzSteps(1) == 0, "Collatz(1) takes 0 steps")
  assert(countCollatzSteps(6) == 8, "Collatz(6): 6->3->10->5->16->8->4->2->1 (8 steps)")
  assert(countCollatzSteps(27) == 111, "Collatz(27) takes 111 steps")
  assert(sumMultiplesInRange(10) == 23, "multiples of 3 or 5 below 10: 3+5+6+9 = 23")
  ret 0

pub fn test_loop_execution_stats_with_gcd_lcm(): int:
  let stats = buildLoopExecutionStats(6, 12, 18)
  assert(stats.collatzSteps == 8, "collatzSteps(6) == 8")
  assert(stats.commonGcd == 6, "gcdInt(12, 18) == 6")
  assert(stats.commonLcm == 36, "lcmInt(12, 18) == 36")
  assert(stats.rangeSum == 23, "sumMultiplesInRange(10) == 23")
  ret 0

pub fn test_cycle_period_branching(): int:
  assert(classifyCyclePeriod(12, 18) == "FLOW:HARMONIC_LCM_36", "LCM 36 is in harmonic range")
  assert(classifyCyclePeriod(7, 13) == "FLOW:COPRIME_LCM_91", "coprime 7 and 13")
  ret 0

pub fn main(): int:
  test_collatz_while_loop_and_range_sum()
  test_loop_execution_stats_with_gcd_lcm()
  test_cycle_period_branching()
  println("PASS: ex_004_control_flow_and_loops_cli_test")
  ret 0
