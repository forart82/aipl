// ============================================================================
// Twin Test Suite 138: Gamepad Dual-Stick Deadzone Radar & Rumble (WINDOW)
// Verifies examples/ex_138_input_gamepad_dual_stick_radar_window.aipl
// ============================================================================
module Ex138InputGamepadDualStickRadarWindowTest

import {
  verifyGamepadRadialVsAxialDeadzone,
  computeRumbleMotorDutyPermille,
  describeStickDeadzoneMode,
  renderFrameStep
} from "../../examples/ex_138_input_gamepad_dual_stick_radar_window.aipl"

pub fn test_input_gamepad_dual_stick_radar_window(): int:
  assert(verifyGamepadRadialVsAxialDeadzone() == 1, "radial deadzone preserves diagonal movement while axial zeroes it, and triggers/rumble pass")
  assert(computeRumbleMotorDutyPermille(500, 750) == 625, "average of 500 and 750 permille motors == 625")
  assert(describeStickDeadzoneMode(1) == "GAMEPAD:RADIAL_DEADZONE_SMOOTH", "radial deadzone mode label")
  let s0 = renderFrameStep(0, 0.016)
  let s1 = renderFrameStep(1, 0.016)
  let s20 = renderFrameStep(20, 0.016)
  let s100 = renderFrameStep(100, 0.016)
  assert(s0 >= 0, "frame 0 returns valid stick & rumble telemetry")
  assert(s0 != s1, "gamepad stick magnitude and rumble telemetry advance between frame 0 and frame 1")
  assert(s1 != s20, "gamepad stick magnitude and rumble telemetry advance between frame 1 and frame 20")
  assert(s20 != s100, "gamepad stick magnitude and rumble telemetry advance between frame 20 and frame 100")
  ret 0

pub fn main(): int:
  test_input_gamepad_dual_stick_radar_window()
  println("PASS: ex_138_input_gamepad_dual_stick_radar_window_test")
  ret 0
