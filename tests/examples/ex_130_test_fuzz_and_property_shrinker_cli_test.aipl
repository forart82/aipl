// ============================================================================
// Twin Test Suite 130: Property Fuzzing & Counterexample Shrinker (CLI)
// Verifies examples/ex_130_test_fuzz_and_property_shrinker_cli.aipl
// ============================================================================
module Ex130TestFuzzAndPropertyShrinkerCliTest

import {
  verifyDeterministicFuzzerAndShrinker,
  computeBinaryShrinkStepsBound,
  describeFuzzCounterExample
} from "../../examples/ex_130_test_fuzz_and_property_shrinker_cli.aipl"

pub fn test_test_fuzz_and_property_shrinker_cli(): int:
  assert(verifyDeterministicFuzzerAndShrinker() == 42, "shrinkCounterExampleInt(850, 0, 42) reduces counterexample to 42")
  assert(computeBinaryShrinkStepsBound(1024) == 10, "log2(1024) == 10 binary search shrink steps")
  assert(describeFuzzCounterExample(42) == "FUZZ:SHRUNK_MINIMAL_42", "minimal counterexample 42 label")
  ret 0

pub fn main(): int:
  test_test_fuzz_and_property_shrinker_cli()
  println("PASS: ex_130_test_fuzz_and_property_shrinker_cli_test")
  ret 0
