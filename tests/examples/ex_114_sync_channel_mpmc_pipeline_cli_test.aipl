// ============================================================================
// Twin Test Suite 114: Bounded MPSC, SPSC & Broadcast Channel Pipeline (CLI)
// Verifies examples/ex_114_sync_channel_mpmc_pipeline_cli.aipl
// ============================================================================
module Ex114SyncChannelMpmcPipelineCliTest

import {
  evaluateMpscAndBroadcastDrainedSum,
  verifyChannelCloseDrainAndSpscOrder,
  describeChannelBackpressureMode
} from "../../examples/ex_114_sync_channel_mpmc_pipeline_cli.aipl"

pub fn test_sync_channel_mpmc_pipeline_cli(): int:
  assert(evaluateMpscAndBroadcastDrainedSum() == 1614, "MPSC(10+20+30) + Broadcast(777+777) == 1614")
  assert(verifyChannelCloseDrainAndSpscOrder() == 1, "mpscClose rejects new sends while draining buffered item, and SPSC FIFO passes")
  assert(describeChannelBackpressureMode(4) == "CHAN:BOUNDED_RING_CAPACITY_4", "bounded capacity 4 label")
  ret 0

pub fn main(): int:
  test_sync_channel_mpmc_pipeline_cli()
  println("PASS: ex_114_sync_channel_mpmc_pipeline_cli_test")
  ret 0
