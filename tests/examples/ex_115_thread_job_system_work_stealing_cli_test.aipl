// ============================================================================
// Twin Test Suite 115: Work-Stealing Job System & DAG Scheduler (CLI)
// Verifies examples/ex_115_thread_job_system_work_stealing_cli.aipl
// ============================================================================
module Ex115ThreadJobSystemWorkStealingCliTest

import {
  executeWorkStealingDagAndReduce,
  computeParallelForBatchCount,
  computeWorkStealBalancePct,
  describeWorkStealEfficiency
} from "../../examples/ex_115_thread_job_system_work_stealing_cli.aipl"

pub fn test_thread_job_system_work_stealing_cli(): int:
  assert(executeWorkStealingDagAndReduce() == 205, "DAG child(150) + parallelReduce(55) == 205")
  assert(computeParallelForBatchCount(4096, 256) == 16, "4096 / 256 == 16 parallel batches")
  assert(computeWorkStealBalancePct(24, 120) == 20, "24 / 120 == 20% stolen tasks")
  assert(describeWorkStealEfficiency(20) == "JOBS:BALANCED_STEAL_20PCT", "balanced steal efficiency tag")
  ret 0

pub fn main(): int:
  test_thread_job_system_work_stealing_cli()
  println("PASS: ex_115_thread_job_system_work_stealing_cli_test")
  ret 0
