// ============================================================================
// Twin Test Suite 065: Duration Arithmetic, Parsing & Humanizer Formatting (CLI)
// Verifies examples/ex_065_time_duration_humanizer_cli.aipl
// ============================================================================
module Ex065TimeDurationHumanizerCliTest

import {
  computeCombinedDurationMillis,
  formatStopwatchClockHhMmSsMs,
  parseAndVerifyDurationSpecMs
} from "../../examples/ex_065_time_duration_humanizer_cli.aipl"

pub fn test_time_duration_humanizer_cli(): int:
  assert(computeCombinedDurationMillis(2, 15, 500) == 135500, "2m 15s 500ms equals 135500ms")
  assert(formatStopwatchClockHhMmSsMs(3661500) == "01:01:01.500", "3661500ms formats as 01:01:01.500")
  assert(parseAndVerifyDurationSpecMs("2s") == 2000, "parseDurationMs('2s') == 2000")
  assert(parseAndVerifyDurationSpecMs("500ms") == 500, "parseDurationMs('500ms') == 500")
  ret 0

pub fn main(): int:
  test_time_duration_humanizer_cli()
  println("PASS: ex_065_time_duration_humanizer_cli_test")
  ret 0
