// ============================================================================
// Twin Test Suite 066: Proleptic Gregorian Calendar & ISO-8601 DateTime (CLI)
// Verifies examples/ex_066_time_datetime_iso8601_calendar_cli.aipl
// ============================================================================
module Ex066TimeDatetimeIso8601CalendarCliTest

import {
  verifyIso8601UnixRoundTripHour,
  computeCalendarSpanAndLeapDays,
  describeCalendarWeekdaySummary
} from "../../examples/ex_066_time_datetime_iso8601_calendar_cli.aipl"

pub fn test_time_datetime_iso8601_calendar_cli(): int:
  assert(verifyIso8601UnixRoundTripHour("2026-11-04T12:30:00Z", 120) == 14, "UTC 12:30 +02:00 local hour is 14")
  assert(computeCalendarSpanAndLeapDays(2024, 11, 4, 10) == 35, "6 days between Nov 4 and Nov 10 + 29 days in Feb 2024 == 35")
  assert(describeCalendarWeekdaySummary(2026, 11, 4) == "November:Wednesday", "2026-11-04 is Wednesday in November")
  ret 0

pub fn main(): int:
  test_time_datetime_iso8601_calendar_cli()
  println("PASS: ex_066_time_datetime_iso8601_calendar_cli_test")
  ret 0
