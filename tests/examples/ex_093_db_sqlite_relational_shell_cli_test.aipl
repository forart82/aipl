// ============================================================================
// Twin Test Suite 093: SQLite Relational Engine, Prepared Stmts & Savepoints (CLI)
// Verifies examples/ex_093_db_sqlite_relational_shell_cli.aipl
// ============================================================================
module Ex093DbSqliteRelationalShellCliTest

import {
  evaluatePreparedSelectIdAndAge,
  verifySavepointRollbackAndMigrations,
  describeSqliteJournalMode
} from "../../examples/ex_093_db_sqlite_relational_shell_cli.aipl"

pub fn test_db_sqlite_relational_shell_cli(): int:
  assert(evaluatePreparedSelectIdAndAge() == 131, "bound id 101 + age 30 == 131")
  assert(verifySavepointRollbackAndMigrations() == 700, "savepoint rollback preserves balance 700 and applies 2 schema migrations")
  assert(describeSqliteJournalMode("WAL") == "SQLITE:WAL_ACID_TRANSACTIONS", "WAL journal mode descriptor")
  ret 0

pub fn main(): int:
  test_db_sqlite_relational_shell_cli()
  println("PASS: ex_093_db_sqlite_relational_shell_cli_test")
  ret 0
