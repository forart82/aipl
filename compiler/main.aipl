pub fn checkStdImportedSymbolsInSource(filePath: str, src: str, graph: ModuleGraph, hir: HirModule, arena: AstArena): [CompilerDiagnostic]:
  mut diags: [CompilerDiagnostic] = []
  if not src.contains("std/") and not src.contains("std."):
    ret diags

  mut knownSyms: Map[str, bool] = Map.new()
  mut si = 0
  while si < hir.symbols.len:
    knownSyms.set(hir.symbols[si].name, true)
    si += 1
  mut di = 0
  while di < arena.decls.len:
    if arena.decls[di].name.len > 0:
      knownSyms.set(arena.decls[di].name, true)
    di += 1
  mut mi = 0
  while mi < graph.modules.len:
    let exps = graph.modules[mi].exportedDecls
    mut ei = 0
    while ei < exps.len:
      knownSyms.set(exps[ei], true)
      ei += 1
    mi += 1

  let toks = tokenizeAipl(src, 0)
  mut inImport = false
  mut inBraces = false
  mut afterAs = false
  mut pendingSyms: [str] = []
  mut pendingSpans: [Span] = []

  mut ti = 0
  while ti < toks.len:
    let t = toks[ti]
    if t.kind == "KW_IMPORT":
      inImport = true
      inBraces = false
      afterAs = false
      pendingSyms = []
      pendingSpans = []
      ti += 1
      continue
    if inImport:
      if t.lexeme == "{":
        inBraces = true
        afterAs = false
      elif t.lexeme == "}":
        inBraces = false
        afterAs = false
      elif inBraces:
        if t.lexeme == ",":
          afterAs = false
        elif t.kind == "KW_AS" or t.lexeme == "as":
          afterAs = true
        elif t.kind == "IDENT":
          if not afterAs:
            pendingSyms.push(t.lexeme)
            pendingSpans.push(t.span)
          afterAs = false
      elif t.kind == "STRING" or t.kind == "RAW_STRING":
        inImport = false
        if pendingSyms.len > 0 and isStdImportPath(t.lexeme) and not isBuiltinStdNamespace(t.lexeme):
          let resolvedMod = resolveImportPath(pathDirname(filePath), t.lexeme)
          if resolvedMod.len > 0:
            let normResMod = pathNormalize(resolvedMod)
            let modDir = pathDirname(normResMod)
            mut pk = 0
            while pk < pendingSyms.len:
              let origSym = pendingSyms[pk]
              let symSpan = pendingSpans[pk]
              let isIntrinsic = isKnownStdIntrinsicSymbol(origSym)
              let inHir = knownSyms.containsKey(origSym)
              mut inTargetDomain = isIntrinsic
              if not inTargetDomain:
                mut gmi = 0
                while gmi < graph.modules.len:
                  let mp = pathNormalize(graph.modules[gmi].path)
                  let mDir = pathDirname(mp)
                  let isSameDomain = mDir == modDir or mp == normResMod or mp.endsWith("prelude.aipl") or (modDir.endsWith("/os") and mp.endsWith("fmt/text_print.aipl"))
                  if isSameDomain and graph.modules[gmi].source.contains(origSym):
                    inTargetDomain = true
                    break
                  gmi += 1
              if (not inHir and not isIntrinsic) or not inTargetDomain:
                diags.push(CompilerDiagnostic(
                  code = "AIPL_E_STD_MODULE_NOT_FOUND",
                  message = "AIPL_E_STD_MODULE_NOT_FOUND: Symbol '" + origSym + "' not found in standard library module '" + stripQuotes(t.lexeme) + "'",
                  span = symSpan,
                  severity = "error",
                  hint = "Verify exported symbol name in '" + stripQuotes(t.lexeme) + "'",
                  autofixAvailable = false,
                  autofixReplacement = ""
                ))
              pk += 1
    ti += 1

pub fn canonicalizeGraphDepsOnDisk(filePath: str, moduleName: str, graphIn: ModuleGraph): ModuleGraph:
  mut graph = graphIn
  mut anyDepCanon = false
  mut gmi = 0
  while gmi < graph.modules.len:
    let mPath = graph.modules[gmi].path
    if mPath.len > 0 and mPath != filePath and mPath.endsWith(".aipl") and not mPath.startsWith("std/") and not mPath.contains("/std/") and fileExists(mPath):
      let cDep = canonicalizeAiplFileOnDisk(mPath)
      if cDep != graph.modules[gmi].source:
        anyDepCanon = true
    gmi += 1
  if anyDepCanon:
    graph = resolveImports(filePath, arenaNew(moduleName))
  ret graph

pub fn compileFile(filePath: str): CompileReport:
  let src = canonicalizeAiplFileOnDisk(filePath)
  let rootSummary = extractModuleSummary(filePath, src, 0)
  let graph = canonicalizeGraphDepsOnDisk(filePath, rootSummary.moduleName, resolveImports(filePath, arenaNew(rootSummary.moduleName)))
  let rootDiskSrc = if graph.modules.len > 0: graph.modules[0].source else: src
  let bundled = if graph.modules.len <= 1: src elif rootDiskSrc != src: formatAiplSource(graph.bundledSource) else: graph.bundledSource
  if graph.errors.len > 0:
    let rootTokens = tokenizeAipl(src, 0)
    let rootArena = parseModule(rootTokens, src)
    mut errDiags: [CompilerDiagnostic] = []
    mut gi = 0
    while gi < graph.errors.len:
      let gErr = graph.errors[gi]
      let isStdMissing = gErr.startsWith("AIPL_E_STD_MODULE_NOT_FOUND:")
      let diagCode = if isStdMissing: "AIPL_E_STD_MODULE_NOT_FOUND" else: "AIPL_E1002_RESOLVE_IMPORT"
      let diagHint = if isStdMissing: "Verify standard library module path under std/ (e.g., std/gfx2d, std/math, std/fs)" else: "Break circular import or check module path"
      let impSpan = findImportSpanInTokens(rootTokens, gErr)
      errDiags.push(CompilerDiagnostic(
        code = diagCode,
        message = gErr,
        span = impSpan,
        severity = "error",
        hint = diagHint,
        autofixAvailable = false,
        autofixReplacement = ""
      ))
      gi += 1
    mut ri = 0
    while ri < rootArena.errors.len:
      let errStr = rootArena.errors[ri]
      let lc = parseLineColFromError(errStr)
      errDiags.push(CompilerDiagnostic(
        code = "AIPL_E1001_PARSE_SYNTAX",
        message = errStr,
        span = makeSpan(0, 0, 0, lc[0], lc[1]),
        severity = "error",
        hint = "Check syntax near token",
        autofixAvailable = false,
        autofixReplacement = ""
      ))
      ri += 1
    let emptyHir = HirModule(
      moduleName = "Error",
      arena = arenaNew("Error"),
      symbols = [],
      structs = [],
      enums = [],
      functions = [],
      contracts = [],
      diagnostics = []
    )
    ret CompileReport(
      valid = false,
      tokenCount = rootTokens.len,
      declCount = rootArena.decls.len,
      functionCount = 0,
      structCount = 0,
      enumCount = 0,
      verifiedContracts = 0,
      moduleCount = graph.modules.len,
      bundledSource = bundled,
      diagnostics = errDiags,
      hir = emptyHir
    )

  if graph.modules.len <= 1:
    let rootTokens = tokenizeAipl(src, 0)
    let rootArena = parseModule(rootTokens, src)
    let hir = lowerToHir(rootArena, rootArena.moduleName)
    let tcRes = typecheckHir(hir)
    let smtRes = verifyContracts(hir)
    mut singleDiags: [CompilerDiagnostic] = []
    mut si = 0
    while si < tcRes.diagnostics.len:
      singleDiags.push(tcRes.diagnostics[si])
      si += 1
    mut sj = 0
    while sj < smtRes.diagnostics.len:
      singleDiags.push(smtRes.diagnostics[sj])
      sj += 1
    if rootArena.errors.len > 0:
      mut ei = 0
      while ei < rootArena.errors.len:
        let errStr = rootArena.errors[ei]
        let lc = parseLineColFromError(errStr)
        singleDiags.push(CompilerDiagnostic(
          code = "AIPL_E1001_PARSE_SYNTAX",
          message = errStr,
          span = makeSpan(0, 0, 0, lc[0], lc[1]),
          severity = "error",
          hint = "Check syntax near token",
          autofixAvailable = false,
          autofixReplacement = ""
        ))
        ei += 1
    ret CompileReport(
      valid = singleDiags.len == 0 and graph.errors.len == 0 and rootArena.errors.len == 0,
      tokenCount = rootTokens.len,
      declCount = rootArena.decls.len,
      functionCount = hir.functions.len,
      structCount = hir.structs.len,
      enumCount = hir.enums.len,
      verifiedContracts = smtRes.verifiedContracts,
      moduleCount = graph.modules.len,
      bundledSource = bundled,
      diagnostics = singleDiags,
      hir = hir
    )

  let fullArena = if graph.moduleChunks.len > 0:
    compileFrontendParallel(graph.moduleChunks, graph.chunkLineOffsets, rootSummary.moduleName)
  else:
    parseModule(tokenizeAipl(bundled, 0), bundled)
  let unifiedHir = lowerToHir(fullArena, rootSummary.moduleName)
  let tcRes = typecheckHir(unifiedHir)
  let smtRes = verifyContracts(unifiedHir)

  mut allDiags: [CompilerDiagnostic] = []
  let stdSymDiags = checkStdImportedSymbolsInSource(filePath, src, graph, unifiedHir, fullArena)
  mut sdi = 0
  while sdi < stdSymDiags.len:
    allDiags.push(stdSymDiags[sdi])
    sdi += 1
  mut di = 0
  while di < tcRes.diagnostics.len:
    allDiags.push(tcRes.diagnostics[di])
    di += 1
  mut dj = 0
  while dj < smtRes.diagnostics.len:
    allDiags.push(smtRes.diagnostics[dj])
    dj += 1

  let activeErrors = fullArena.errors
  if activeErrors.len > 0:
    mut ei = 0
    while ei < activeErrors.len:
      let errStr = activeErrors[ei]
      let lc = parseLineColFromError(errStr)
      allDiags.push(CompilerDiagnostic(
        code = "AIPL_E1001_PARSE_SYNTAX",
        message = errStr,
        span = makeSpan(0, 0, 0, lc[0], lc[1]),
        severity = "error",
        hint = "Check syntax near token",
        autofixAvailable = false,
        autofixReplacement = ""
      ))
      ei += 1

  ret CompileReport(
    valid = allDiags.len == 0 and graph.errors.len == 0 and activeErrors.len == 0,
    tokenCount = fullArena.exprs.len + fullArena.stmts.len + fullArena.decls.len,
    declCount = fullArena.decls.len,
    functionCount = unifiedHir.functions.len,
    structCount = unifiedHir.structs.len,
    enumCount = unifiedHir.enums.len,
    verifiedContracts = smtRes.verifiedContracts,
    moduleCount = graph.modules.len,
    bundledSource = bundled,
    diagnostics = allDiags,
    hir = unifiedHir
  )

pub fn compileFileToHir(filePath: str): HirModule:
  let report = compileFile(filePath)
  ret report.hir

pub fn bootstrapBuildNativeWithStub(inputPath: str, stubBytes: bytes, outputPath: str): Result[int, str]:
  let report = compileFile(inputPath)
  if not report.valid:
    ret Err("Compilation failed with " + str(report.diagnostics.len) + " diagnostic(s)")
  ret buildNativeExecutableWithStub(report.bundledSource, stubBytes, outputPath)

pub fn bootstrapBuildNative(inputPath: str, outputPath: str): Result[int, str]:
  let report = compileFile(inputPath)
  if not report.valid:
    ret Err("Compilation failed with " + str(report.diagnostics.len) + " diagnostic(s)")
  ret buildNativeExecutable(report.bundledSource, outputPath)

pub fn getAiplHomeDir(): str:
  if fileExists("compiler/main.aipl") and isDir("std"):
    ret "."
  ret resolveStdlibRoot()

pub fn cmdInstallGlobal(cliArgs: [str]): int:
  let root = getAiplHomeDir()
  let srcBin = if fileExists("bin/aipl"): "bin/aipl" else: pathJoin(root, "bin/aipl")
  if not fileExists(srcBin):
    println("Error: source binary not found at " + srcBin)
    ret 1
  let home = homeDir().unwrapOr("/tmp")
  let localBin = pathJoin(home, ".local/bin")
  let cargoBin = pathJoin(home, ".cargo/bin")
  let localTarget = pathJoin(localBin, "aipl")
  let cargoTarget = pathJoin(cargoBin, "aipl")
  let _m1 = execCommand("mkdir", ["-p", localBin, cargoBin])
  let _c1 = execCommand("cp", ["--remove-destination", srcBin, localTarget])
  let _x1 = execCommand("chmod", ["+x", localTarget])
  let _c2 = execCommand("cp", ["--remove-destination", srcBin, cargoTarget])
  let _x2 = execCommand("chmod", ["+x", cargoTarget])
  println("Installed global AIPL binary to " + localTarget + " and " + cargoTarget)
  ret 0

pub fn aiplVersion(): str:
  ret "0.9.0"

pub fn printHelp(): int:
  ret printUsage()

pub fn printUsage(): int:
  let ver = aiplVersion()
  println("AIPL - AI-Programming Language Toolchain (Version " + ver + ", compat: 0.9.0)")
  println("")
  println("Usage: aipl <command> [options] [arguments]")
  println("")
  println("CORE COMMANDS:")
  println("  aipl verify <file.aipl> [--json] [--check-budget=<size>]  # Static type checking & SMT refinement verification")
  println("  aipl check <file.aipl> [--json] [--check-budget=<size>]   # Alias for 'aipl verify' (static & SMT verification)")
  println("  aipl build <file.aipl> [-o <out>] [-g] [--target <native|c|html|ts|wasm|llvm|x86_64-linux|arm64-linux>] [--native|--c|--html|--ts|--wasm|--elf64|--pure-aipl] [-j <N>] # Compiles AIPL into native binary, C99, TypeScript, WASM, or HTML5")
  println("  aipl bundle <file.aipl> [-o <out.html>]             # Bundles AIPL into self-contained single-file HTML5 app")
  println("  aipl run <file.aipl|file.wasm> [-v|--verbose] [--quiet] [--timeout <sec>] [--profile] [-- <args...>] # Runs AIPL source or .wasm (returns console by default; -v/--verbose shows logs & errors)")
  println("  aipl transpile <file.aipl> [--target <ts|html|html5|c>] [-o <out>] # Transpiles AIPL to TypeScript, HTML5, or C99")
  println("  aipl test [path] [--json] [--filter <pat>] [--timeout <sec>] [--profile] [-j <N>] # Executes unit tests and test suites")
  println("  aipl repl                                           # Interactive read-eval-print loop")
  println("  aipl bench [target]                                 # Benchmarks execution performance and throughput")
  println("  aipl fuzz <file.aipl>                               # Generates coverage-guided fuzz mutations")
  println("")
  println("DOCUMENTATION & INTERACTIVE EXAMPLES EXPLORER:")
  println("  aipl docs [list|<topic>|std/<module>] [--json]      # Browse system manuals, architecture, and stdlib docs")
  println("  aipl doc <file_or_dir> [-o <outDir>] [--json]       # Extracts Markdown API documentation from source")
  println("  aipl examples [list|show <name>|run <name>]         # Interactive explorer for all 263 curated example programs")
  println("  aipl help [command]                                 # Detailed manual page and usage for any command")
  println("")
  println("AI AGENT QUICK-START & KNOWLEDGE LIBRARY:")
  println("  aipl help quickstart                                # 60-second grammar, 2-space indentation, let/mut, Option/Result & req:/ens:")
  println("  aipl help syntax                                    # Complete lexical & AST grammar reference (structs, enums, receiver methods, match)")
  println("  aipl help builtins                                  # All 32 core language built-in functions with exact signatures and examples")
  println("  aipl help std [domain|module|fn]                    # Browse 36 std/ domains, 290 modules, or search 4,292 stdlib functions")
  println("  aipl help tutorials [1..12]                         # Read 12 progressive step-by-step tutorials directly in terminal")
  println("  aipl help cookbook [query]                          # Browse or search 50 copy-pasteable production recipes")
  println("  aipl help examples [domain|cli|window|001..263]     # Explore 263 verified examples and twin tests")
  println("  aipl help errors [E1xx|E2xx|E3xx]                   # Compiler diagnostic codes with before/after self-repair patterns")
  println("  aipl help <command>                                 # Full manual page for any CLI command (verify, build, run, test, etc.)")
  println("")
  println("AI AGENT & SURGICAL SELF-HEALING TOOLING:")
  println("  aipl inspect <binary_or_file> [--tokens|--ast]      # Inspects binary trailers, tokens, or AST structures")
  println("  aipl patch <file.aipl> --diff=<diff>                # Applies verified AST-preserving atomic patches")
  println("  aipl splice <file.aipl> <symbol> <replacement>      # Replaces a symbol definition with new source")
  println("  aipl outline <file.aipl> [--json]                   # Emits structural outline (module, structs, enums, fns)")
  println("  aipl tokens <file.aipl> [--json]                    # Lexical token stream inspection")
  println("  aipl schema [target]                                # Emits JSON schemas for diagnostics and AST")
  println("  aipl fmt <file.aipl> [--check] [--stdin]            # Formats AIPL source code (strict 2-space indentation)")
  println("  aipl lint <file.aipl> [--json]                      # Runs static verification & linter rules")
  println("  aipl fix <file.aipl>                                # Autonomous self-repair / formatting / unused imports")
  println("")
  println("PROJECT SCAFFOLDING, PACKAGE MANAGEMENT & BOOTSTRAP:")
  println("  aipl new <name> [--template=<tpl>]                  # Creates a new AIPL application project")
  println("  aipl init                                           # Initializes an AIPL project in current directory")
  println("  aipl scaffold <spec>                                # Generates boilerplate models and modules from spec")
  println("  aipl pkg [install|add|update|lock]                  # Manages dependencies and lockfiles")
  println("  aipl bootstrap                                      # 3-stage self-hosting fixed-point compiler bootstrap")
  println("  aipl install-global                                 # Installs aipl CLI to ~/.local/bin and ~/.cargo/bin")
  println("")
  println("INTEGRITY SHIELD & IDE SERVERS:")
  println("  aipl shield <lock|unlock|verify|rehash|status>      # 4-Layer Filesystem Shield for SSOT protection")
  println("  aipl conductor [options]                            # Validates multi-agent scope disjointness and worktree arbitration")
  println("  aipl lsp                                            # Starts Language Server Protocol daemon")
  println("  aipl dap                                            # Starts Debug Adapter Protocol daemon")
  println("  aipl version (or --version)                         # Prints AIPL toolchain version")
  println("")
  println("WINDOW TARGETING & MULTI-INSTANCE CONTROL:")
  println("  aipl window list                                    # List all active AIPL windows and process IDs")
  println("  aipl window screenshot <target> <out_path>          # Synchronously captures window framebuffer")
  println("  aipl window record <target> <out_path> [options]    # Records targeted window video")
  println("  aipl window action <target> <bot_script>            # Injects simulated inputs/resize into window")
  println("  aipl screenshot <target> <out_path>                 # Alias for 'aipl window screenshot'")
  println("  aipl record <target> <out_path> [options]           # Alias for 'aipl window record'")
  ret 0

pub fn cmdVersion(): int:
  let ver = aiplVersion()
  println("aipl " + ver)
  println("AIPL - AI-Programming Language Toolchain (Version " + ver + ", compat: 0.9.0)")
  ret 0

pub fn cmdHelpQuickstart(): int:
  println("================================================================================")
  println("                    AIPL 60-Second AI & Developer Quickstart                    ")
  println("================================================================================")
  println("")
  println("1. CORE SYNTAX & FORMATTING:")
  println("   - Indentation: Strictly 2 spaces (tabs and curly braces '{ }' are forbidden).")
  println("   - Blocks: Header ends with a colon ':', followed by indented body.")
  println("   - Strings: Double quotes only (\"...\"). Single quotes ('...') are forbidden.")
  println("   - Semicolons: Forbidden; statements are newline-delimited.")
  println("")
  println("2. VARIABLES & IMMUTABILITY:")
  println("   let immutableVal = 42       // Immutable binding (default)")
  println("   mut mutableVal = 10         // Mutable binding")
  println("   mutableVal += 5             // Reassignment")
  println("")
  println("3. TYPES:")
  println("   - Primitives: int (64-bit), float (64-bit IEEE-754), str (UTF-8), bool (true/false)")
  println("   - Collections: [T] (dynamic array), Map[K, V] (hash map)")
  println("   - Monadic: Option[T] (Some(v) | None), Result[T, E] (Ok(v) | Err(e))")
  println("")
  println("4. FUNCTIONS & CONTRACT REFINEMENTS:")
  println("   pub fn addPositive(a: int, b: int): int:")
  println("     req: a > 0 and b > 0       // Precondition (verified by compiler / SMT)")
  println("     ens: retVal > a            // Postcondition (retVal represents returned value)")
  println("     ret a + b")
  println("")
  println("5. STRUCTS, RECEIVER METHODS & ENUMS:")
  println("   pub struct Point:")
  println("     x: float")
  println("     y: float")
  println("")
  println("   pub fn (self: Point) lengthSq(): float:")
  println("     ret self.x * self.x + self.y * self.y")
  println("")
  println("   pub enum Shape:")
  println("     Circle(radius: float)")
  println("     Rect(w: float, h: float)")
  println("")
  println("6. PATTERN MATCHING:")
  println("   match opt:")
  println("     Some(val): println(\"Value: \" + str(val))")
  println("     None:      println(\"Empty\")")
  println("")
  println("7. ESSENTIAL CLI COMMANDS:")
  println("   ./bin/aipl check <file.aipl>         # Static verification & type check")
  println("   ./bin/aipl run <file.aipl>           # Compile and run immediately")
  println("   ./bin/aipl test <file_or_dir>        # Execute test suite")
  println("   ./bin/aipl help <cmd|topic|fn>       # Instant terminal documentation")
  ret 0

pub fn cmdHelpSyntax(): int:
  println("================================================================================")
  println("                      AIPL Lexical & AST Grammar Reference                      ")
  println("================================================================================")
  println("")
  println("1. MODULES & IMPORTS:")
  println("   module MyPackage.SubModule")
  println("   import { foo, Bar } from \"std/math/vec\"")
  println("   import * from \"std/prelude\"")
  println("")
  println("2. DECLARATIONS:")
  println("   let <name>[: <type>] = <expr>")
  println("   mut <name>[: <type>] = <expr>")
  println("   pub fn <name>([<param>: <type>, ...]): <retType>:")
  println("   pub fn (self: <Type>) <name>([<param>: <type>, ...]): <retType>:")
  println("   pub struct <Name>:")
  println("     <field>: <type> [= <default>]")
  println("   pub enum <Name>:")
  println("     <Variant>[(<fields>)]")
  println("")
  println("3. CONTROL FLOW:")
  println("   if <cond>: ... else if <cond>: ... else: ...")
  println("   while <cond>: ... [break] ... [continue]")
  println("   for <item> in <collection>: ...")
  println("   match <expr>:")
  println("     <Pattern>: <expr_or_block>")
  println("     default: <expr_or_block>")
  println("")
  println("4. CLOSURES & EXPRESSIONS:")
  println("   let double = fn(x: int): int: ret x * 2")
  println("   let sum = fn(a: int, b: int): a + b")
  println("")
  println("5. SMT REFINEMENT CONTRACTS:")
  println("   req: <boolean_predicate>")
  println("   ens: <boolean_predicate_on_retVal>")
  println("   assert(<boolean_condition>, <error_message_str>)")
  ret 0

pub fn cmdHelpBuiltins(): int:
  println("================================================================================")
  println("                     AIPL Core Built-in Functions (32)                          ")
  println("================================================================================")
  println("")
  println("1. TYPE CONVERSION & CONSTRUCTORS:")
  println("   - int(x: any): int               Truncate float, parse string, or convert bool (int(3.9) -> 3)")
  println("   - float(x: any): float           Promote int or parse float string (float(42) -> 42.0)")
  println("   - str(x: any): str               Canonical string serialization (str(123) -> \"123\")")
  println("   - bool(x: any): bool             Convert non-zero integer or parse bool (bool(1) -> true)")
  println("   - Map(): Map[K, V]               Construct empty generic hash map (m = Map())")
  println("")
  println("2. STRING & ARRAY PRIMITIVES:")
  println("   - .len(): int                    Length of string or array (\"aipl\".len() -> 4)")
  println("   - .push(val: T): void            Append element to mutable array (arr.push(10))")
  println("   - .pop(): T                      Remove and return last element (arr.pop() -> 10)")
  println("   - .slice(start: int, end: int)   Half-open slice [start, end) (\"hello\".slice(0, 2) -> \"he\")")
  println("   - .contains(sub: str): bool      Check substring existence (\"abc\".contains(\"b\") -> true)")
  println("   - .split(delim: str): [str]      Split string into array (\"a,b\".split(\",\") -> [\"a\", \"b\"])")
  println("   - .trim(): str                   Strip leading and trailing whitespace (\"  hi  \".trim() -> \"hi\")")
  println("   - .replace(from: str, to: str)   Replace all occurrences (\"foo\".replace(\"o\", \"a\") -> \"faa\")")
  println("   - .startsWith(prefix: str): bool Check prefix match (\"std/math\".startsWith(\"std/\") -> true)")
  println("   - .endsWith(suffix: str): bool   Check suffix match (\"file.aipl\".endsWith(\".aipl\") -> true)")
  println("   - .toUpper(): str                Uppercase string transform (\"aipl\".toUpper() -> \"AIPL\")")
  println("   - .toLower(): str                Lowercase string transform (\"AIPL\".toLower() -> \"aipl\")")
  println("   - .charAt(index: int): str       Single character at byte index (\"cat\".charAt(1) -> \"a\")")
  println("   - .indexOf(sub: str): int        Index of first substring match or -1 (\"hello\".indexOf(\"ll\") -> 2)")
  println("")
  println("3. MAP PRIMITIVES:")
  println("   - .keys(): [K]                   Array of all keys in map (m.keys())")
  println("   - .has(key: K): bool             Check key existence in map (m.has(\"id\") -> true)")
  println("   - .get(key: K): Option[V]        Safe lookup returning Option (m.get(\"id\").unwrap())")
  println("   - .set(key: K, val: V): void     Insert or overwrite key-value binding (m.set(\"id\", 42))")
  println("   - .delete(key: K): void          Remove key from map (m.delete(\"id\"))")
  println("")
  println("4. MATH PRIMITIVES:")
  println("   - abs(x: num): num               Absolute value (abs(-5) -> 5, abs(-2.5) -> 2.5)")
  println("   - sqrt(x: float): float          Square root (sqrt(144.0) -> 12.0)")
  println("   - sin(x: float): float           Sine of radians (sin(0.0) -> 0.0)")
  println("   - cos(x: float): float           Cosine of radians (cos(0.0) -> 1.0)")
  println("   - floor(x: float): float         Round down to nearest integer (floor(2.9) -> 2.0)")
  println("   - ceil(x: float): float          Round up to nearest integer (ceil(2.1) -> 3.0)")
  println("   - pow(base: float, exp: float)   Exponentiation (pow(2.0, 8.0) -> 256.0)")
  println("")
  println("5. GRAPHICS & COLOR PRIMITIVES:")
  println("   - rgb(r: int, g: int, b: int)    Pack 24-bit RGB into 0xFFBBGGRR integer (rgb(255, 0, 0))")
  println("")
  println("6. CONTROL FLOW & ASSERTION PRIMITIVES:")
  println("   - print(msg: str): void          Write unbuffered string to standard output")
  println("   - println(msg: str): void        Write string with trailing newline to standard output")
  println("   - assert(cond: bool, msg: str)   Runtime invariant verification guard")
  println("   - panic(msg: str): void          Abort execution with fatal diagnostic stack trace")
  println("   - todo(msg: str): void           Temporary stub marker that halts if reached")
  ret 0

pub fn cmdHelpStd(subArgs: [str]): int:
  let home = getAiplHomeDir()
  let stdDir = if isDir("std"): "std" else: home + "/std"

  if subArgs.len == 0 or subArgs[0] == "":
    println("================================================================================")
    println("               AIPL Standard Library: 36 Domain Groups (290 Modules)            ")
    println("================================================================================")
    println("")
    println("LAYER 0: FOUNDATION & HOST SYSTEM")
    println("  - sys (8 mods)          System calls, environment probes, hardware & OS info")
    println("  - rt (4 mods)           Runtime string interning, UTF-8 decoders, memory hooks")
    println("  - alloc (5 mods)        Bump arena allocators, slab pools, high-water profilers")
    println("")
    println("LAYER 1: DATA STRUCTURES & COMPUTATION")
    println("  - math (16 mods)        Vectors (Vec2/3/4), Mat4, Quaternions, FFT, Bezier curves")
    println("  - collections (13 mods) Dynamic vectors, Deques, RingBuffers, PriorityQueues, Graphs")
    println("  - fmt (4 mods)          Radix formatters, scientific notation, Unicode inspectors")
    println("  - regex (4 mods)        NFA/DFA regular expressions, fuzzy matching, glob syntax")
    println("  - time (6 mods)         Monotonic timers, ISO-8601 timestamps, frame pacers")
    println("")
    println("LAYER 2: SYSTEMS, PROTOCOLS & ENCODING")
    println("  - encoding (13 mods)    JSON (RFC 8259), Base64, Hex, CSV, XML, QR-Code matrix")
    println("  - compress (6 mods)     Deflate, Gzip, Zlib, Huffman coding, Tar archives")
    println("  - crypto (7 mods)       ChaCha20-Poly1305, AES-GCM, SHA-256, BLAKE3, Ed25519")
    println("  - db (2 mods)           Embedded SQLite engine, append-only WAL ACID KV store")
    println("  - io (4 mods)           Standard I/O streams, buffered readers, streaming pipes")
    println("  - fs (7 mods)           Path normalization, directory trees, file watchers")
    println("  - os (6 mods)           Declarative CliApp argument parser, processes, signals")
    println("  - sync (5 mods)         Atomic operations, spinlocks, condition variables")
    println("  - thread (3 mods)       Chase-Lev work-stealing job deque, thread-local contexts")
    println("  - net (10 mods)         TCP/UDP sockets, IPv4/IPv6 CIDR, JSON-RPC 2.0, HTTP/1.1")
    println("  - test (4 mods)         Unit test assertions, property fuzzing, test runners")
    println("")
    println("LAYER 3: MULTIMEDIA, AUDIO & DISPLAY")
    println("  - window (5 mods)       Native window management, frame timing, clipboard")
    println("  - input (6 mods)        Keyboard piano, mouse gestures, gamepad mappings")
    println("  - asset (7 mods)        QOI/BMP/PPM image decoders, asset bundle packagers")
    println("  - audio (6 mods)        Wave synthesizers (sine/saw/square), ADSR, mixers")
    println("  - gfx (8 mods)          Color spaces (OKLab, HSL), palettes, post-processing FX")
    println("  - gfx2d (11 mods)       2D vector shapes, bezier paths, CCD-IK bone skeletal rigs")
    println("  - gfx3d (10 mods)       3D platonic solids, OBJ loader, frustum culling, decals")
    println("  - particle (7 mods)     2D/3D particle emitters, gravitational fountains, VFX")
    println("  - ui (13 mods)          Flexbox & Grid layout solver, buttons, sliders, A11y HUD")
    println("")
    println("LAYER 4: SIMULATION, WORLD & PHYSICS")
    println("  - ecs (6 mods)          Generational 64-bit entity arena, sparse sets, systems")
    println("  - spatial (8 mods)      Orthogonal & isometric tilemaps, Octrees, waypoints")
    println("  - phys2d (8 mods)       Symplectic Euler rigid bodies, gravity, restitution")
    println("  - phys3d (7 mods)       Inertia tensors, raycasts, broadphase bounding volumes")
    println("  - procgen (7 mods)      Perlin/Simplex/Worley noise, Poisson disc, cellular maps")
    println("")
    println("LAYER 5: AUTONOMOUS AI & GAME MECHANICS")
    println("  - ai (8 mods)           Hierarchical FSM, Behavior Trees, Boids flocking, HEBAR")
    println("  - mechanics (5 mods)    RPG stat modifiers, alias loot tables, pity timers")
    println("")
    println("USAGE:")
    println("  aipl help std <domain>                  # Inspect modules in domain (e.g. aipl help std math)")
    println("  aipl docs std/<module>                  # Full API & function signatures for module")
    println("  aipl docs search <query>                # Instant full-text search across all 4,292 functions")
    ret 0

  let target = subArgs[0].trim().replace("std/", "")
  let dPath = stdDir + "/" + target
  if isDir(dPath):
    let ents = listDir(dPath)
    println("================================================================================")
    println("Standard Library Domain: std/" + target)
    println("================================================================================")
    println("Modules:")
    mut ei = 0
    while ei < ents.len:
      let ent = ents[ei]
      if ent.endsWith(".aipl") and not ent.startsWith("."):
        let stem = ent.replace(".aipl", "")
        let modPath = "std/" + target + "/" + stem
        println("  - " + modPath + " (`" + dPath + "/" + ent + "`)")
      ei += 1
    println("")
    println("View signatures with: aipl docs std/" + target + "/<module>")
    ret 0

  ret cmdDocs(["docs", "std/" + target])

pub fn cmdHelpTutorials(subArgs: [str]): int:
  let home = getAiplHomeDir()
  if subArgs.len == 0 or subArgs[0] == "":
    println("================================================================================")
    println("                 AIPL Progressive 12-Step Tutorial Curriculum                   ")
    println("================================================================================")
    println("")
    println("Read any tutorial directly with `aipl help tutorials <1..12>` or `aipl docs tutorial <1..12>`:")
    println("  [01] Hello World, Standard Streams & Option A CLI Architecture")
    println("  [02] Primitives, Bitwise Arithmetic & IEEE-754 Precision")
    println("  [03] Strings, Interpolation, UTF-8 & Myers Diff")
    println("  [04] Control Flow, Pattern Matching & Offside Indentation")
    println("  [05] Structs, Immutability & Receiver Methods")
    println("  [06] Enums, Algebraic Data Types & Exhaustive Match")
    println("  [07] Generics, Collections & Dynamic Arenas")
    println("  [08] Closures, First-Class Functions & Data Pipelines")
    println("  [09] Option & Result Monadic Error Handling")
    println("  [10] Modules, Imports & Standard Library Navigation")
    println("  [11] 2D/3D Canvas Rendering, Shaders & Event Loop")
    println("  [12] Complete Systems Capstone: ECS, State Machine & Save Engine")
    ret 0

  let numStr = subArgs[0].trim()
  let padNum = if numStr.len == 1: "0" + numStr else: numStr
  let tutDir = home + "/docs/tutorials"
  if isDir(tutDir):
    let ents = listDir(tutDir)
    mut ei = 0
    while ei < ents.len:
      let ent = ents[ei]
      if ent.startsWith(padNum + "_") and ent.endsWith(".md"):
        println(readFile(tutDir + "/" + ent))
        ret 0
      ei += 1
  let tutFile = home + "/docs/TUTORIAL.md"
  if fileExists(tutFile):
    println(readFile(tutFile))
    ret 0
  println("Tutorial chapter " + numStr + " not found.")
  ret 1

pub fn cmdHelpCookbook(subArgs: [str]): int:
  let home = getAiplHomeDir()
  let cbFile = if fileExists(home + "/docs/tutorials/cookbook.md"): home + "/docs/tutorials/cookbook.md" else: home + "/docs/COOKBOOK.md"
  if subArgs.len == 0 or subArgs[0] == "":
    println("================================================================================")
    println("                     AIPL Production Cookbook (50 Recipes)                      ")
    println("================================================================================")
    println("")
    println("Browse 50 copy-pasteable production recipes (View full cookbook with `aipl docs cookbook`):")
    println("  - CLI & I/O: JSON-RPC 2.0 dispatcher, declarative CliApp argument parsing, streaming pipes")
    println("  - Math & DSP: 3D vector & matrix affine transforms, quaternions, Cooley-Tukey radix-2 FFT")
    println("  - Algorithms & Collections: Dijkstra shortest path, Kruskal MST, spatial 2D grid hashing")
    println("  - Security & Crypto: ChaCha20-Poly1305 AEAD, SHA-256 / BLAKE3 hashes, TLS handshake probe")
    println("  - Systems: Work-stealing Chase-Lev deque, lock-free ringbuffers, bump arena allocators")
    println("  - Graphics & Canvas: Fixed-timestep accumulator, 2D sprite batcher, 3D frustum culler")
    println("  - Game Architecture: Generational entity arena, state machine transitions, save engine v3")
    println("")
    println("Search recipes with: aipl help cookbook <query>")
    ret 0

  mut query = ""
  mut qi = 0
  while qi < subArgs.len:
    query = if query == "": subArgs[qi] else: query + " " + subArgs[qi]
    qi += 1
  query = query.trim().toLowerCase()

  if fileExists(cbFile):
    let content = readFile(cbFile)
    let lines = content.split("\n")
    mut found = 0
    mut li = 0
    while li < lines.len:
      let line = lines[li]
      if line.toLowerCase().contains(query):
        println(line)
        found += 1
        if found >= 25:
          println("... (matches truncated; run `aipl docs cookbook` to read full guide)")
          break
      li += 1
    if found == 0:
      println("No cookbook recipes matching '" + query + "'.")
    ret 0

  println("Cookbook file not found at " + cbFile)
  ret 1

pub fn cmdHelpExamples(subArgs: [str]): int:
  if subArgs.len == 0:
    ret cmdExamples(["examples", "list"])
  mut fwdArgs: [str] = ["examples"]
  mut i = 0
  while i < subArgs.len:
    fwdArgs.push(subArgs[i])
    i += 1
  ret cmdExamples(fwdArgs)

pub fn cmdHelpErrors(subArgs: [str]): int:
  if subArgs.len == 0 or subArgs[0] == "":
    println("================================================================================")
    println("               AIPL Compiler Diagnostics & Self-Repair Catalog                  ")
    println("================================================================================")
    println("")
    println("AIPL implements machine-readable single-root ADR-0023 JSON diagnostics with exact")
    println("byte locator spans, AST breadcrumb paths, cascade suppression, and candidate fixes.")
    println("")
    println("ERROR CATEGORIES & COMMON CODES (Inspect with `aipl help errors <code>`):")
    println("  - E1xx: Lexer & Parser Syntax Errors")
    println("      AIPL_E1002_UNRESOLVED_TYPE    Unresolved or undeclared type name in scope")
    println("      AIPL_E1015_SINGLE_QUOTES      Single-quoted strings forbidden (use double quotes)")
    println("      AIPL_W0045_BRACE_BLOCK        Curly braces '{ }' forbidden (use canonical 2-space offside)")
    println("      AIPL_W0041_SNAKE_CASE         Identifier violates camelCase tokenomics invariant")
    println("  - E2xx: Type & Semantic Verification")
    println("      AIPL_E2002_TYPE_MISMATCH      Type mismatch in expression, return, or match scrutinee")
    println("      AIPL_E2014_UNKNOWN_FIELD      Unknown struct field with Levenshtein typo suggestion")
    println("      AIPL_W1001_UNPARAMETRIZED_MAP Unparameterized Map/Set loses compile-time safety")
    println("      AIPL_W0201_COMPLEX_INTERP     Complex expression inside string interpolation")
    println("  - E3xx: Refinement & Invariant Checks")
    println("      AIPL_E3001_PRECONDITION       SMT precondition 'req:' violated at callsite")
    println("      AIPL_E3002_POSTCONDITION      Function return value violates postcondition 'ens:'")
    println("      AIPL_E_INFINITE_LOOP_RISK     Loop variable not mutated on unconditional control path")
    println("  - E4xx: Runtime & Watchdog Errors")
    println("      AIPL_E_TIMEOUT                Execution watchdog exceeded --timeout limit")
    println("      AIPL_E_PANIC                  Explicit panic() assertion failure with stack trace")
    println("  - Linter & Self-Repair Rules")
    println("      LINT010                       Unused import symbol (auto-repaired by `aipl fix`)")
    println("")
    println("RUNNING SELF-REPAIR:")
    println("  aipl fix <file.aipl>              # Automatically fixes formatting and strips unused imports")
    println("  aipl verify <file.aipl> --json    # Emits machine-readable ADR-0023 single-root JSON diagnostics")
    ret 0

  let code = subArgs[0].trim().toUpperCase()
  if code.contains("1015") or code.contains("QUOTE"):
    println("DIAGNOSTIC: AIPL_E1015 - Single-Quoted Strings Forbidden")
    println("SEVERITY: error")
    println("CAUSE:")
    println("  Single-quoted string literals ('...') are forbidden in AIPL to preserve")
    println("  tokenomic density and prevent ambiguity with lifetime annotations and apostrophes.")
    println("BEFORE (Invalid):")
    println("  let name = 'aipl'")
    println("AFTER (Compliant):")
    println("  let name = \"aipl\"")
    ret 0
  elif code.contains("2002") or code.contains("MISMATCH"):
    println("DIAGNOSTIC: AIPL_E2002 - Type Mismatch in Scrutinee or Binding")
    println("SEVERITY: error")
    println("CAUSE:")
    println("  A match pattern (e.g. Ok(v), Some(x)) does not match the scrutinee type,")
    println("  or a variable assignment/return type differs from its static declaration.")
    println("BEFORE (Invalid):")
    println("  let flag: bool = true")
    println("  match flag:")
    println("    Some(v): println(\"got some\")")
    println("AFTER (Compliant):")
    println("  let flag: Option[bool] = Some(true)")
    println("  match flag:")
    println("    Some(v): println(\"got: \" + str(v))")
    println("    None:    println(\"empty\")")
    ret 0
  elif code.contains("2014") or code.contains("FIELD"):
    println("DIAGNOSTIC: AIPL_E2014 - Unknown Struct Field")
    println("SEVERITY: error")
    println("CAUSE:")
    println("  Accessing a field not declared in the target nominal struct definition.")
    println("  The compiler computes Levenshtein distance <= 2 to suggest typos.")
    println("BEFORE (Invalid):")
    println("  let p = Point(x = 1.0, y = 2.0)")
    println("  println(str(p.capaciti))")
    println("AFTER (Compliant):")
    println("  println(str(p.x))")
    ret 0
  elif code.contains("LOOP") or code.contains("INFINITE"):
    println("DIAGNOSTIC: AIPL_E_INFINITE_LOOP_RISK - Indentation-Induced Infinite Loop Guard")
    println("SEVERITY: error")
    println("CAUSE:")
    println("  A while loop termination variable is not mutated unconditionally along the loop body")
    println("  (e.g., when the loop increment i += 1 is indented inside a conditional if branch).")
    println("BEFORE (Invalid):")
    println("  while i < 10:")
    println("    if cond:")
    println("      i += 1   // BUG: only increments when cond is true -> infinite hang!")
    println("AFTER (Compliant):")
    println("  while i < 10:")
    println("    if cond:")
    println("      doWork()")
    println("    i += 1     // Mutated unconditionally at main loop body level")
    ret 0
  elif code.contains("TIMEOUT"):
    println("DIAGNOSTIC: AIPL_E_TIMEOUT - Execution Watchdog Timeout")
    println("SEVERITY: error")
    println("CAUSE:")
    println("  The process execution exceeded the configured --timeout <seconds> limit.")
    println("  The runtime intercepted the thread and terminated with exit code 124.")
    println("REMEDY:")
    println("  - Increase watchdog budget: aipl run file.aipl --timeout 30")
    println("  - Profile execution hot paths: aipl run file.aipl --profile")
    println("  - Check for unbounded loops or blocking I/O syscalls")
    ret 0
  elif code.contains("LINT010") or code.contains("UNUSED"):
    println("DIAGNOSTIC: LINT010 - Unused Import Symbol")
    println("SEVERITY: warning / error")
    println("CAUSE:")
    println("  An imported identifier in `import { ... } from \"...\"` is never referenced in the file.")
    println("AUTONOMOUS SELF-REPAIR:")
    println("  Run `aipl fix <file.aipl>` to strip unused imports and format code in-place.")
    ret 0
  else:
    println("DIAGNOSTIC CODE: " + code)
    println("For details on diagnostic codes and ADR-0023 schemas, run `aipl docs diagnostics`.")
    ret 0

pub fn cmdHelpFallbackLookup(query: str): int:
  let home = getAiplHomeDir()
  let stdDir = if isDir("std"): "std" else: home + "/std"

  if query.startsWith("std/") or query.startsWith("std"):
    mut target = query
    if not target.startsWith("std/"):
      target = "std/" + target
    let rawPath = if target.endsWith(".aipl"): target else: target + ".aipl"
    let dPath = if isDir(target): target else: stdDir + "/" + target.replace("std/", "")
    if isDir(dPath):
      let ents = listDir(dPath)
      println("================================================================================")
      println("Standard Library Domain: " + target)
      println("================================================================================")
      println("Modules:")
      mut ei = 0
      while ei < ents.len:
        let ent = ents[ei]
        if ent.endsWith(".aipl") and not ent.startsWith("."):
          let stem = ent.replace(".aipl", "")
          println("  - " + target + "/" + stem + " (`" + target + "/" + ent + "`)")
        ei += 1
      ret 0
    elif fileExists(dPath + ".aipl") or fileExists(rawPath):
      let f = if fileExists(rawPath): rawPath else: dPath + ".aipl"
      ret cmdDocs(["docs", f])

  mut matches: [SymbolHelpMatch] = []
  if isDir(stdDir):
    let doms = listDir(stdDir)
    mut di = 0
    while di < doms.len:
      let dom = doms[di]
      let domPath = stdDir + "/" + dom
      if isDir(domPath) and not dom.startsWith("."):
        let mods = listDir(domPath)
        mut mi = 0
        while mi < mods.len:
          let m = mods[mi]
          if m.endsWith(".aipl") and not m.startsWith("."):
            let stem = m.replace(".aipl", "")
            let modImport = "std/" + dom + "/" + stem
            let fullModPath = domPath + "/" + m
            let content = readFile(fullModPath)
            let lines = content.split("\n")
            mut li = 0
            while li < lines.len:
              let line = lines[li].trim()
              if line.startsWith("pub fn ") or line.startsWith("pub struct ") or line.startsWith("pub enum "):
                let info = extractSignatureSymbol(line)
                if info.name != "":
                  mut pri = 0
                  mut impSym = info.name
                  if info.kind == "struct" and info.name == query:
                    pri = 100
                    impSym = info.name
                  elif info.kind == "enum" and info.name == query:
                    pri = 100
                    impSym = info.name
                  elif info.kind == "fn" and info.name == query:
                    pri = 100
                    impSym = info.name
                  elif info.kind == "fn" and info.name.startsWith(query + "."):
                    pri = 100
                    impSym = query
                  elif info.kind == "method" and info.name == query:
                    pri = 100
                    impSym = query
                  elif info.kind != "method" and info.name.toLowerCase() == query.toLowerCase():
                    pri = 85
                    impSym = info.name
                  elif info.kind != "method" and info.name.toLowerCase().contains(query.toLowerCase()):
                    pri = 65
                    impSym = info.name
                  elif line.contains(" " + query + ":") or line.contains("(" + query + ":") or line.contains(": " + query) or line.contains("[" + query + "]") or line.contains(" " + query + ")"):
                    pri = 45
                    impSym = info.name

                  if pri > 0:
                    matches.push(SymbolHelpMatch(modImport = modImport, fullModPath = fullModPath, signature = line, importSymbol = impSym, priority = pri))
              li += 1
          mi += 1
      di += 1

  if matches.len > 0:
    mut maxPri = 0
    mut mki = 0
    while mki < matches.len:
      if matches[mki].priority > maxPri:
        maxPri = matches[mki].priority
      mki += 1

    println("================================================================================")
    println("Standard Library Matches for: '" + query + "'")
    println("================================================================================")
    mut shown = 0
    mut mi = 0
    while mi < matches.len and shown < 10:
      let sm = matches[mi]
      if sm.priority >= maxPri - 15:
        println("Module: `" + sm.modImport + "` (" + sm.fullModPath + "):")
        println("  " + sm.signature)
        println("  Import: import { " + sm.importSymbol + " } from \"" + sm.modImport + "\"")
        println("")
        shown += 1
      mi += 1
    ret 0

  println("No detailed manual entry for '" + query + "'.")
  println("Run 'aipl help' to view the full command reference.")
  println("Run 'aipl docs search \"" + query + "\"' to search across standard library and examples.")
  ret 0

pub fn cmdHelp(cliArgs: [str]): int:
  if cliArgs.len <= 1:
    ret printUsage()
  let arg1 = cliArgs[1]
  if (arg1 == "--help" or arg1 == "-h" or arg1 == "help") and cliArgs.len <= 2:
    ret printUsage()

  mut cmd = arg1
  mut subArgs: [str] = []
  if (cmd == "help" or cmd == "--help" or cmd == "-h") and cliArgs.len >= 3:
    cmd = cliArgs[2]
    mut si = 3
    while si < cliArgs.len:
      subArgs.push(cliArgs[si])
      si += 1
  else:
    mut si = 2
    while si < cliArgs.len:
      subArgs.push(cliArgs[si])
      si += 1

  if cmd == "help" or cmd == "--help" or cmd == "-h":
    ret printUsage()

  if cmd == "quickstart":
    ret cmdHelpQuickstart()
  elif cmd == "syntax" or cmd == "grammar":
    ret cmdHelpSyntax()
  elif cmd == "builtins" or cmd == "builtin":
    ret cmdHelpBuiltins()
  elif cmd == "std" or cmd == "stdlib":
    ret cmdHelpStd(subArgs)
  elif cmd == "tutorials" or cmd == "tutorial":
    ret cmdHelpTutorials(subArgs)
  elif cmd == "cookbook" or cmd == "recipes":
    ret cmdHelpCookbook(subArgs)
  elif cmd == "examples" or cmd == "example":
    ret cmdHelpExamples(subArgs)
  elif cmd == "errors" or cmd == "error" or cmd == "diagnostics":
    ret cmdHelpErrors(subArgs)
  elif cmd == "verify" or cmd == "check":
    println("COMMAND: " + cmd + " - Static verification, type checking, and SMT refinement verification")
    println("USAGE: aipl " + cmd + " <file.aipl> [OPTIONS]")
    println("OPTIONS & FLAGS:")
    println("  --json                  Emit machine-readable single-root ADR-0023 JSON diagnostic report")
    println("  --check-budget=<size>   Assert compiled binary size fits within byte limit (e.g. 512KB, 2MB)")
    println("EXIT CODES:")
    println("  0: Verification succeeded with 0 errors")
    println("  1: Verification failed with diagnostic errors or budget overrun")
    println("EXAMPLES:")
    println("  aipl " + cmd + " src/main.aipl")
    println("  aipl " + cmd + " src/main.aipl --json")
    println("  aipl " + cmd + " src/main.aipl --check-budget=512KB")
    ret 0
  elif cmd == "build" or cmd == "compile":
    println("COMMAND: build - Compiles AIPL into native executable, C99, TypeScript, WebAssembly, or HTML5")
    println("USAGE: aipl build <file.aipl> [OPTIONS]")
    println("OPTIONS & FLAGS:")
    println("  -o <path>               Specify output artifact destination")
    println("  -g, --debug-info        Include DWARF/debug symbols in generated binary")
    println("  --target <native|c|html|ts|wasm|llvm|x86_64-linux|arm64-linux> Target backend architecture")
    println("  --elf64                 Direct ELF64 binary emission")
    println("  --pure-aipl             Pure AIPL native code generation without C compiler")
    println("  -j, --jobs <N>          Parallel compilation worker threads")
    println("  --native, --c-native    Compile to native standalone ELF/Mach-O executable (default)")
    println("  --c                     Emit clean, portable, self-contained C99 source file")
    println("  --c-modular             Emit C99 that includes runtime/aipl_runtime.h (links libaipl_rt.a)")
    println("  --wasm                  Emit WebAssembly binary (.wasm + browser host)")
    println("  --ts                    Emit TypeScript source module")
    println("  --html                  Bundle self-contained single-file HTML5 application")
    println("EXIT CODES:")
    println("  0: Compilation and build succeeded")
    println("  1: Build failed due to compile diagnostics or host toolchain failure")
    println("EXAMPLES:")
    println("  aipl build src/main.aipl -o bin/app")
    println("  aipl build src/main.aipl --target=html -o dist/app.html")
    println("  aipl build src/main.aipl --target=wasm -o dist/app.wasm")
    println("  aipl build src/main.aipl --elf64 -o bin/app.elf64")
    println("  aipl build src/main.aipl -j 4")
    ret 0
  elif cmd == "bundle":
    println("COMMAND: bundle - Packages AIPL source into zero-dependency standalone HTML5 app")
    println("USAGE: aipl bundle <file.aipl> [-o <out.html>]")
    println("OPTIONS & FLAGS:")
    println("  -o <out.html>           Destination HTML5 file (default: stdout or <stem>.html)")
    println("EXIT CODES:")
    println("  0: Bundle created successfully")
    println("  1: Bundling failed")
    println("EXAMPLES:")
    println("  aipl bundle examples/ex_176_gfx3d_cull3d_frustum_and_occlusion_window.aipl -o dist/canvas.html")
    ret 0
  elif cmd == "run":
    println("COMMAND: run - Compiles and executes AIPL program with caching (returns console by default)")
    println("USAGE: aipl run <file.aipl> [-v|--verbose] [--quiet] [--timeout <sec>] [--profile] [-- <args...>]")
    println("OPTIONS & FLAGS:")
    println("  -v, --verbose           Stay attached and stream stdout logs, stderr errors, and compiler/runtime data")
    println("  --wait, --foreground    Wait for program completion without enabling verbose diagnostic banners")
    println("                          (env AIPL_RUN_WAIT=1 does the same for test harnesses/CI)")
    println("  -d, --detach            Always launch detached, overriding --wait/AIPL_RUN_WAIT")
    println("  --quiet                 Suppress compilation status messages")
    println("  --timeout <sec>         Execution watchdog timeout in seconds (AIPL_E_TIMEOUT / code 124)")
    println("  --profile               Measure wall-clock compile/exec timings and emit profiler report")
    println("  -- <args...>            Pass trailing arguments directly to program userArgs()")
    println("EXIT CODES:")
    println("  0 when launched detached (default), or exit code of the executed AIPL program (or 124 on timeout)")
    println("EXAMPLES:")
    println("  aipl run poc/paint/paint.aipl")
    println("  aipl run -v examples/ex_001_hello_world_and_io_cli.aipl")
    println("  aipl run src/cli.aipl --verbose --timeout 5 --profile")
    println("  aipl run src/cli.aipl -- --input=data.csv --verbose")
    ret 0
  elif cmd == "test":
    println("COMMAND: test - Discovers and runs all test*() unit functions")
    println("USAGE: aipl test [file_or_dir] [OPTIONS]")
    println("OPTIONS & FLAGS:")
    println("  --json                  Output test results in JSON format")
    println("  --filter <pat>          Run only test functions matching pattern")
    println("  --step=<N>              Run tests associated with specific step ID")
    println("  -j, --jobs <N>          Parallel test worker threads (default: hardware CPU count)")
    println("  --timeout <sec>         Per-test watchdog timeout in seconds (AIPL_E_TIMEOUT / code 124)")
    println("  --profile               Measure and display compile/exec profiler metrics")
    println("EXIT CODES:")
    println("  0: All tests passed")
    println("  1: One or more tests failed (or timed out)")
    println("EXAMPLES:")
    println("  aipl test tests/selfhost/test_lvalue_assign.aipl")
    println("  aipl test tests/selfhost --timeout 10 -j 4 --profile")
    ret 0
  elif cmd == "transpile":
    println("COMMAND: transpile - High-fidelity transpilation to target language")
    println("USAGE: aipl transpile <file.aipl> --target <c|ts|html5> [-o <out>]")
    println("OPTIONS & FLAGS:")
    println("  --target c|ts|html5     Target backend language")
    println("  -o <path>               Output file path (default: stdout)")
    println("EXIT CODES:")
    println("  0: Transpilation succeeded")
    println("  1: Transpilation failed")
    println("EXAMPLES:")
