pub struct ProcessOutput(exitCode: int, stdout: str, stderr: str)

pub fn nowMicros(): int:
  ret nowMonoNs() / 1000

// ============================================================================
// Step 15.5: Self-Hosted AIPL Compiler Driver & Triple-Stage Bootstrap
// ============================================================================

pub fn makeArena(): AstArena:
  ret arenaNew("Error")

pub struct CompileReport:
  valid: bool
  tokenCount: int
  declCount: int
  functionCount: int
  structCount: int
  enumCount: int
  verifiedContracts: int
  moduleCount: int
  bundledSource: str
  diagnostics: [CompilerDiagnostic]
  hir: HirModule

// ============================================================================
// Step 12.3: Multi-Agent Concurrency Contracts & Deterministic Worktree Arbitration
// ============================================================================

pub struct AgentScopePartition:
  agentId: str
  ownedFiles: [str]
  reservedSymbols: [str]
  priorityOrder: int

pub struct ConductorArbitrationReport:
  isDisjoint: bool
  conflictCount: int
  conflictingFile: str
  conflictingSymbol: str
  mergeOrder: [str]

pub struct SignatureSymbolInfo:
  name: str
  kind: str

pub struct SymbolHelpMatch:
  modImport: str
  fullModPath: str
  signature: str
  importSymbol: str
  priority: int

pub fn textMatchesAllTerms(text: str, terms: [str]): bool:
  let lower = text.toLowerCase()
  mut i = 0
  while i < terms.len:
    if not lower.contains(terms[i]):
      ret false
    i += 1
  ret true

pub fn splitQueryTerms(query: str): [str]:
  let rawWords = query.toLowerCase().split(" ")
  mut terms: [str] = []
  mut i = 0
  while i < rawWords.len:
    let w = rawWords[i].trim()
    if w.len > 0:
      terms.push(w)
    i += 1
  ret terms

pub fn extractSignatureSymbol(line: str): SignatureSymbolInfo:
  if line.startsWith("pub struct "):
    let rest = line.slice(11, line.len).trim()
    mut sym = ""
    mut i = 0
    while i < rest.len:
      let c = rest.slice(i, i + 1)
      if c == "(" or c == ":" or c == " " or c == "<" or c == "[":
        break
      sym = sym + c
      i += 1
    ret SignatureSymbolInfo(name = sym, kind = "struct")
  if line.startsWith("pub enum "):
    let rest = line.slice(9, line.len).trim()
    mut sym = ""
    mut i = 0
    while i < rest.len:
      let c = rest.slice(i, i + 1)
      if c == "(" or c == ":" or c == " " or c == "<" or c == "[":
        break
      sym = sym + c
      i += 1
    ret SignatureSymbolInfo(name = sym, kind = "enum")
  if line.startsWith("pub fn "):
    let rest = line.slice(7, line.len).trim()
    if rest.startsWith("(self: ") or rest.startsWith("(mut self: "):
      let afterSelf = if rest.startsWith("(self: "): rest.slice(7, rest.len) else: rest.slice(11, rest.len)
      mut recvType = ""
      mut i = 0
      while i < afterSelf.len:
        let c = afterSelf.slice(i, i + 1)
        if c == ")" or c == " " or c == "<":
          break
        recvType = recvType + c
        i += 1
      ret SignatureSymbolInfo(name = recvType, kind = "method")
    mut sym = ""
    mut i = 0
    while i < rest.len:
      let c = rest.slice(i, i + 1)
      if c == "(" or c == "<" or c == " " or c == ":":
        break
      sym = sym + c
      i += 1
    ret SignatureSymbolInfo(name = sym, kind = "fn")
  ret SignatureSymbolInfo(name = "", kind = "")

pub fn findDomainDocFile(home: str, domName: str): str:
  let d1 = home + "/docs/reference/" + domName + ".md"
  if fileExists(d1):
    ret d1
  let d2 = home + "/docs/stdlib/" + domName + ".md"
  if fileExists(d2):
    ret d2
  let refDir = home + "/docs/reference"
  if isDir(refDir):
    let ents = listDir(refDir)
    mut i = 0
    while i < ents.len:
      let e = ents[i]
      if e.endsWith("_" + domName + ".md") or e == domName + ".md":
        ret refDir + "/" + e
      i += 1
  let sDir = home + "/docs/stdlib"
  if isDir(sDir):
    let ents = listDir(sDir)
    mut i = 0
    while i < ents.len:
      let e = ents[i]
      if e.endsWith("_" + domName + ".md") or e == domName + ".md":
        ret sDir + "/" + e
      i += 1
  ret ""

pub fn verifyDisjointAgentContracts(partitions: [AgentScopePartition]): ConductorArbitrationReport:
  mut isDisjoint = true
  mut conflictCount = 0
  mut conflictingFile = ""
  mut conflictingSymbol = ""
  mut mergeOrder: [str] = []

  mut i = 0
  while i < partitions.len:
    let pA = partitions[i]
    mut j = i + 1
    while j < partitions.len:
      let pB = partitions[j]

      // Check ownedFiles intersection: Scope(A).ownedFiles ∩ Scope(B).ownedFiles = ∅
      mut fi = 0
      while fi < pA.ownedFiles.len:
        let fA = pA.ownedFiles[fi]
        mut fj = 0
        while fj < pB.ownedFiles.len:
          let fB = pB.ownedFiles[fj]
          if fA == fB and fA.len > 0:
            conflictCount += 1
            if conflictingFile == "":
              conflictingFile = fA
          fj += 1
        fi += 1

      // Check reservedSymbols intersection: Scope(A).reservedSymbols ∩ Scope(B).reservedSymbols = ∅
      mut si = 0
      while si < pA.reservedSymbols.len:
        let sA = pA.reservedSymbols[si]
        mut sj = 0
        while sj < pB.reservedSymbols.len:
          let sB = pB.reservedSymbols[sj]
          if sA == sB and sA.len > 0:
            conflictCount += 1
            if conflictingSymbol == "":
              conflictingSymbol = sA
          sj += 1
        si += 1

      j += 1
    i += 1

  if conflictCount > 0:
    isDisjoint = false

  // Compute deterministic topological cherry-pick mergeOrder sorted by priorityOrder ascending
  mut indices: [int] = []
  mut pi = 0
  while pi < partitions.len:
    indices.push(pi)
    pi += 1

  mut a = 0
  while a < indices.len:
    mut b = a + 1
    while b < indices.len:
      let idxA = indices[a]
      let idxB = indices[b]
      let pA = partitions[idxA]
      let pB = partitions[idxB]
      mut shouldSwap = false
      if pB.priorityOrder < pA.priorityOrder:
        shouldSwap = true
      elif pB.priorityOrder == pA.priorityOrder and pB.agentId < pA.agentId:
        shouldSwap = true
      if shouldSwap:
        let tmp = indices[a]
        indices[a] = indices[b]
        indices[b] = tmp
      b += 1
    a += 1

  mut mi = 0
  while mi < indices.len:
    let idx = indices[mi]
    mergeOrder.push(partitions[idx].agentId)
    mi += 1

  ret ConductorArbitrationReport(
    isDisjoint = isDisjoint,
    conflictCount = conflictCount,
    conflictingFile = conflictingFile,
    conflictingSymbol = conflictingSymbol,
    mergeOrder = mergeOrder
  )

pub fn compileSourceText(source: str, moduleName: str): CompileReport:
  let tokens = tokenizeAipl(source, 0)
  let arena = parseModule(tokens, source)
  let hir = lowerToHir(arena, moduleName)
  let tcRes = typecheckHir(hir)
  let smtRes = verifyContracts(hir)

  mut allDiags: [CompilerDiagnostic] = []
  mut i = 0
  while i < tcRes.diagnostics.len:
    allDiags.push(tcRes.diagnostics[i])
    i += 1
  mut j = 0
  while j < smtRes.diagnostics.len:
    allDiags.push(smtRes.diagnostics[j])
    j += 1

  ret CompileReport(
    valid = allDiags.len == 0,
    tokenCount = tokens.len,
    declCount = arena.decls.len,
    functionCount = hir.functions.len,
    structCount = hir.structs.len,
    enumCount = hir.enums.len,
    verifiedContracts = smtRes.verifiedContracts,
    moduleCount = 1,
    bundledSource = source,
    diagnostics = allDiags,
    hir = hir
  )

pub fn parseLineColFromError(errStr: str): [int]:
  mut pLine = 1
  mut pCol = 1
  let colonIdx = errStr.indexOf(":")
  if colonIdx > 0:
    let prefix = errStr.slice(0, colonIdx).trim()
    mut isNum = true
    mut pi = 0
    while pi < prefix.len:
      let c = prefix.slice(pi, pi + 1)
      if c < "0" or c > "9":
        isNum = false
        break
      pi += 1
    if isNum and prefix.len > 0:
      pLine = parseInt(prefix)
      let rest = errStr.slice(colonIdx + 1, errStr.len).trim()
      let nextColon = rest.indexOf(":")
      if nextColon > 0:
        let colPart = rest.slice(0, nextColon).trim()
        mut colIsNum = true
        mut ci = 0
        while ci < colPart.len:
          let cc = colPart.slice(ci, ci + 1)
          if cc < "0" or cc > "9":
            colIsNum = false
            break
          ci += 1
        if colIsNum and colPart.len > 0:
          pCol = parseInt(colPart)
  if pLine == 1 and errStr.toLowerCase().contains("line "):
    let lower = errStr.toLowerCase()
    let lIdx = lower.indexOf("line ")
    let afterLine = lower.slice(lIdx + 5, lower.len).trim()
    mut numStr = ""
    mut ni = 0
    while ni < afterLine.len:
      let c = afterLine.slice(ni, ni + 1)
      if c >= "0" and c <= "9":
        numStr = numStr + c
      else:
        break
      ni += 1
    if numStr.len > 0:
      pLine = parseInt(numStr)
  ret [pLine, pCol]

pub fn parseModuleChunk(source: str, fileId: int): AstArena:
  let toks = tokenizeAipl(source, fileId)
  ret parseModule(toks, source)

pub fn compileFrontendParallel(chunks: [str], lineOffsets: [int], rootModName: str): AstArena:
  let bundled = chunks.join("\n\n")
  let toks = tokenizeAipl(bundled, 0)
  ret parseModule(toks, bundled)

pub fn findImportSpanInTokens(tokens: [Token], gErr: str): Span:
  mut targetImp = ""
  let q1 = gErr.indexOf("'")
  if q1 >= 0:
    let q2 = gErr.indexOf("'", q1 + 1)
    if q2 > q1:
      targetImp = gErr.slice(q1 + 1, q2)
  if targetImp.len > 0:
    mut ti = 0
    while ti < tokens.len:
      let t = tokens[ti]
      if (t.kind == "STRING" or t.kind == "RAW_STRING") and stripQuotes(t.lexeme) == targetImp:
        ret t.span
      ti += 1
  ret makeSpan(0, 0, 0, 1, 1)

