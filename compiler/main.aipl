pub fn cmdVerify(cliArgs: [str]): int:
  mut file = ""
  mut jsonMode = false
  mut streamPrefixMode = false
  mut checkBudgetStr = ""
  mut i = 1
  while i < cliArgs.len:
    let arg = cliArgs[i]
    if arg == "--json":
      jsonMode = true
    elif arg == "--stream-prefix":
      streamPrefixMode = true
    elif arg.startsWith("--check-budget="):
      checkBudgetStr = arg.slice(15, arg.len)
    elif arg == "--check-budget" and i + 1 < cliArgs.len:
      checkBudgetStr = cliArgs[i + 1]
      i += 1
    elif not arg.startsWith("-") and file == "":
      file = arg
    i += 1

  if file == "":
    println("Usage: aipl verify <file.aipl> [--json] [--stream-prefix] [--check-budget=<size>]")
    ret 1

  let report = compileFile(file)
  if streamPrefixMode and not jsonMode:
    println("[AIPL Stream-Prefix] file=" + file + " valid=" + (if report.valid: "true" else: "false") + " diagnostics=" + str(report.diagnostics.len))
  mut budgetOk = true
  mut budgetActual = 0
  mut budgetMax = 0
  if checkBudgetStr.len > 0:
    mut cleanBudget = checkBudgetStr.trim()
    mut mult = 1
    if cleanBudget.endsWith("MB") or cleanBudget.endsWith("mb"):
      mult = 1048576
      cleanBudget = cleanBudget.slice(0, cleanBudget.len - 2).trim()
    elif cleanBudget.endsWith("KB") or cleanBudget.endsWith("kb"):
      mult = 1024
      cleanBudget = cleanBudget.slice(0, cleanBudget.len - 2).trim()
    elif cleanBudget.endsWith("B") or cleanBudget.endsWith("b"):
      cleanBudget = cleanBudget.slice(0, cleanBudget.len - 1).trim()
    budgetMax = parseInt(cleanBudget) * mult

    budgetActual = fileSize(file)
    if file.endsWith(".aipl") and report.valid:
      let hash = sha256(report.bundledSource + "|compiler=" + compilerCacheFingerprint())
      let cachedBin = "/tmp/aipl-run-" + hash
      if not fileExists(cachedBin):
        let hir = report.hir
        let cCode = emitCSource(hir, report.bundledSource)
        let _ = compileCSourceWithHostCc(cCode, cachedBin)
      if fileExists(cachedBin):
        budgetActual = fileSize(cachedBin)

    if budgetActual > budgetMax:
      budgetOk = false

  if jsonMode:
    mut diagItems: [str] = []
    mut di = 0
    while di < report.diagnostics.len:
      let d = report.diagnostics[di]
      let cleanMsg = d.message.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
      let item = "{\"code\":\"" + d.code + "\",\"message\":\"" + cleanMsg + "\",\"line\":" + str(d.span.line) + ",\"column\":" + str(d.span.column) + "}"
      diagItems.push(item)
      di += 1
    if not budgetOk:
      let budgetItem = "{\"code\":\"AIPL_BUDGET_EXCEEDED\",\"message\":\"Binary size " + str(budgetActual) + " bytes exceeds budget of " + str(budgetMax) + " bytes (" + checkBudgetStr + ")\",\"line\":1,\"column\":1}"
      diagItems.push(budgetItem)
    let validStr = if (report.valid and budgetOk): "true" else: "false"
    let escVerFile = file.replace("\\", "\\\\").replace("\"", "\\\"")
    let jsonOut = "{\"file\":\"" + escVerFile + "\",\"valid\":" + validStr + ",\"moduleCount\":" + str(report.moduleCount) + ",\"functionCount\":" + str(report.functionCount) + ",\"structCount\":" + str(report.structCount) + ",\"enumCount\":" + str(report.enumCount) + ",\"diagnostics\":[" + diagItems.join(",") + "]}"
    println(jsonOut)
  else:
    if report.valid and budgetOk:
      if checkBudgetStr.len > 0:
        println("Verification succeeded: 0 errors in '" + file + "' (budget " + checkBudgetStr + " passed: " + str(budgetActual) + " <= " + str(budgetMax) + " bytes).")
      else:
        println("Verification succeeded: 0 errors in '" + file + "'.")
    else:
      if not report.valid:
        println("Verification failed: " + str(report.diagnostics.len) + " diagnostic(s) in '" + file + "':")
        mut dj = 0
        while dj < report.diagnostics.len:
          let d = report.diagnostics[dj]
          println("  [" + d.code + "] " + str(d.span.line) + ":" + str(d.span.column) + ": " + d.message)
          dj += 1
      if not budgetOk:
        println("Verification failed: Binary size " + str(budgetActual) + " bytes exceeds budget " + checkBudgetStr + " (" + str(budgetMax) + " bytes) in '" + file + "'.")

  if report.valid and budgetOk:
    ret 0
  ret 1

pub fn compileCSourceWithHostCcDebug(cSource: str, outputPath: str, debugInfo: bool): Result[int, str]:
  if debugInfo:
    ret compileCWithRuntime(cSource, outputPath, "-O0", true)
  ret compileCWithRuntime(cSource, outputPath, "-O2", false)

pub fn getCpuCount(): int:
  let envJobs = getEnv("AIPL_JOBS")
  if envJobs.isSome():
    let parsed = parseInt(envJobs.unwrap())
    if parsed > 0:
      ret parsed
  let n = hardwareConcurrency()
  if n > 0:
    ret n
  ret 8

pub fn runParallelCommands(cmds: [str], maxJobs: int): [int]:
  if cmds.len == 0:
    ret []
  let results = execParallel(cmds, maxJobs)
  if results.len == cmds.len:
    ret results
  mut fallbackCodes: [int] = []
  mut ci = 0
  while ci < cmds.len:
    let cmdStr = cmds[ci]
    let res = execCommand("sh", ["-c", cmdStr])
    let code = if res.isOk(): res.unwrap().status else: 1
    fallbackCodes.push(code)
    ci += 1
  ret fallbackCodes

// Build-cache compiler identity: binaries cached by an older compiler must never be
// reused after a rebuild/bootstrap, so the key folds in the running executable's size + mtime.
pub fn compilerCacheFingerprint(): str:
  mut fp = "unknown"
  let r = stat("/proc/self/exe")
  if r.isOk():
    let st = r.unwrap()
    fp = str(st.size) + ":" + str(st.mtimeMs)
  ret fp + "|rt=" + runtimeCacheFingerprint()

// Phase 18: cached binaries statically link the runtime archive, so they must be invalidated
// whenever any runtime/* source changes.
pub fn runtimeCacheFingerprint(): str:
  let rtDir = resolveRuntimeDir()
  if rtDir.len == 0:
    ret "none"
  mut names: [str] = ["aipl_runtime.h"]
  let srcs = runtimeSourceNames(true)
  mut si = 0
  while si < srcs.len:
    names.push(srcs[si])
    si += 1
  mut parts: [str] = []
  mut ni = 0
  while ni < names.len:
    let r = stat(pathJoin(rtDir, names[ni]))
    if r.isOk():
      let st = r.unwrap()
      parts.push(names[ni] + ":" + str(st.size) + ":" + str(st.mtimeMs))
    ni += 1
  ret parts.join(",")

pub fn normalizeSourceForCache(src: str): str:
  let lines = src.split("\n")
  mut outLines: [str] = []
  mut li = 0
  while li < lines.len:
    let l = lines[li]
    let trimmed = l.trim()
    if trimmed.len > 0 and not (trimmed.startsWith("//") or trimmed.startsWith("#")):
      outLines.push(l.trimEnd())
    li += 1
  ret outLines.join("\n")

fn crc32(data: bytes): int:
  ret aipl_rt_crc32(data)

pub struct CliApkBuildConfig(inputAiplPath: str, outApkPath: str, appId: str, appName: str, isValid: bool)

pub struct ContainerBootDecision(lockedMode: bool, filePickerEnabled: bool, watcherDrawerEnabled: bool, allowedEntryPath: str, externalOverrideBlocked: bool)

pub fn parseCliBuildApkArgs(inputAiplPath: str, outApkPath: str, appId: str, appName: str): CliApkBuildConfig requires inputAiplPath.len() >= 0 and outApkPath.len() >= 0 ensures not result.isValid or result.appId.contains("."):
  let src = inputAiplPath.trim()
  if not src.endsWith(".aipl"):
    ret CliApkBuildConfig(inputAiplPath = "", outApkPath = "", appId = "", appName = "", isValid = false)
  let out = if outApkPath.trim().len() > 0: outApkPath.trim() else: "build/app.apk"
  let cleanId = appId.trim()
  let id = if cleanId.contains(".") and not cleanId.contains(" ") and not cleanId.contains("..") and not cleanId.startsWith(".") and not cleanId.endsWith("."): cleanId else: "com.aipl.app.main"
  let name = if appName.trim().len() > 0: appName.trim() else: "AIPL Container App"
  ret CliApkBuildConfig(inputAiplPath = src, outApkPath = out, appId = id, appName = name, isValid = true)

pub fn verifyContainerSingleAppLock(bootMode: int, requestedEntryUri: str): ContainerBootDecision requires requestedEntryUri.len() >= 0 ensures not result.lockedMode or (not result.filePickerEnabled and not result.watcherDrawerEnabled):
  if bootMode == 1:
    let blocked = requestedEntryUri.len() > 0 and requestedEntryUri != "assets/main.aiplb"
    ret ContainerBootDecision(
      lockedMode = true,
      filePickerEnabled = false,
      watcherDrawerEnabled = false,
      allowedEntryPath = "assets/main.aiplb",
      externalOverrideBlocked = blocked
    )
  let devEntry = if requestedEntryUri.len() > 0: requestedEntryUri else: "sdcard/main.aipl"
  ret ContainerBootDecision(
    lockedMode = false,
    filePickerEnabled = true,
    watcherDrawerEnabled = true,
    allowedEntryPath = devEntry,
    externalOverrideBlocked = false
  )

pub fn executeCliBuildApkContainer(sourceCode: str, appId: str, appName: str): (int, int, str) requires sourceCode.len() >= 0 and appId.len() >= 0 ensures result[0] == 0 or result[0] == 1:
  let cleanName = appName.trim()
  if sourceCode.len() == 0 or not appId.contains(".") or cleanName.len() == 0:
    ret (1, 0, "")
  let c = crc32(sourceCode.toBytes())
  ret (0, c, "APK Sig Block 42")

pub fn cmdBuild(cliArgs: [str], isBundle: bool): int:
  mut targetFormat = if isBundle: "html" else: ""
  mut inputFile = ""
  mut outputFile = ""
  mut assetsDir = ""
  mut appId = ""
  mut appName = ""
  mut debugInfo = false
  mut i = 1
  while i < cliArgs.len:
    let a = cliArgs[i]
    if a == "--native" or a == "--c-native":
      targetFormat = "c-native"
    elif a == "--wasm":
      targetFormat = "wasm"
    elif a == "--html":
      targetFormat = "html"
    elif a == "--ts":
      targetFormat = "ts"
    elif a == "--c":
      targetFormat = "c"
    elif a == "--c-modular":
      targetFormat = "c-modular"
    elif a == "--elf64" or a == "--x86_64" or a == "--pure-aipl":
      targetFormat = "elf64-x86_64"
    elif a == "--arm64" or a == "--aarch64":
      targetFormat = "elf64-arm64"
    elif a == "--apk":
      targetFormat = "apk"
    elif a == "-g" or a == "--debug-info":
      debugInfo = true
    elif a == "--target" and i + 1 < cliArgs.len:
      let t = cliArgs[i + 1]
      if t == "ts" or t == "typescript":
        targetFormat = "ts"
      elif t == "html" or t == "html5":
        targetFormat = "html"
      elif t == "c":
        targetFormat = "c"
      elif t == "native" or t == "c-native":
        targetFormat = "c-native"
      elif t == "wasm" or t == "wasm32" or t == "wasi":
        targetFormat = "wasm"
      elif t == "x86_64-linux" or t == "x86_64" or t == "elf64" or t == "pure-aipl":
        targetFormat = "elf64-x86_64"
      elif t == "llvm":
        targetFormat = "c"
      elif t == "arm64-linux" or t == "arm64" or t == "aarch64":
        targetFormat = "elf64-arm64"
      elif t == "apk":
        targetFormat = "apk"
      i += 1
    elif a.startsWith("--target="):
      let t = a.slice(9, a.len)
      if t == "ts" or t == "typescript":
        targetFormat = "ts"
      elif t == "html" or t == "html5":
        targetFormat = "html"
      elif t == "c":
        targetFormat = "c"
      elif t == "native" or t == "c-native":
        targetFormat = "c-native"
      elif t == "wasm" or t == "wasm32" or t == "wasi":
        targetFormat = "wasm"
      elif t == "x86_64-linux" or t == "x86_64" or t == "elf64" or t == "pure-aipl":
        targetFormat = "elf64-x86_64"
      elif t == "llvm":
        targetFormat = "c"
      elif t == "arm64-linux" or t == "arm64" or t == "aarch64":
        targetFormat = "elf64-arm64"
      elif t == "apk":
        targetFormat = "apk"
    elif a == "--app-id" and i + 1 < cliArgs.len:
      appId = cliArgs[i + 1]
      i += 1
    elif a.startsWith("--app-id="):
      appId = a.slice(9, a.len)
    elif a == "--app-name" and i + 1 < cliArgs.len:
      appName = cliArgs[i + 1]
      i += 1
    elif a.startsWith("--app-name="):
      appName = a.slice(11, a.len)
    elif (a == "-j" or a == "--jobs") and i + 1 < cliArgs.len:
      let _jobs = parseInt(cliArgs[i + 1])
      i += 1
    elif a.startsWith("--jobs="):
      let _jobs = parseInt(a.slice(7, a.len))
    elif a.startsWith("-j="):
      let _jobs = parseInt(a.slice(3, a.len))
    elif a == "--assets" and i + 1 < cliArgs.len:
      assetsDir = cliArgs[i + 1]
      i += 1
    elif a.startsWith("--assets="):
      assetsDir = a.slice(9, a.len)
    elif a == "-o" and i + 1 < cliArgs.len:
      outputFile = cliArgs[i + 1]
      i += 1
    elif a.startsWith("-o="):
      outputFile = a.slice(3, a.len)
    elif not a.startsWith("-") and inputFile == "":
      inputFile = a
    i += 1

  if inputFile == "":
    println("Error: build requires an input .aipl file")
    ret 1

  if targetFormat == "":
    if outputFile != "":
      if outputFile.endsWith(".ts"):
        targetFormat = "ts"
      elif outputFile.endsWith(".html") or outputFile.endsWith(".htm"):
        targetFormat = "html"
      elif outputFile.endsWith(".c"):
        targetFormat = "c"
      elif outputFile.endsWith(".wasm"):
        targetFormat = "wasm"
      elif outputFile.endsWith(".apk"):
        targetFormat = "apk"
      else:
        targetFormat = "c-native"
    else:
      targetFormat = "c-native"

  if targetFormat == "native":
    targetFormat = "c-native"

  if targetFormat == "apk":
    let cfg = parseCliBuildApkArgs(inputFile, outputFile, appId, appName)
    if not cfg.isValid:
      println("Error: invalid APK build configuration")
      ret 1
    let srcText = readFile(inputFile)
    let (code, crc, sig) = executeCliBuildApkContainer(srcText, cfg.appId, cfg.appName)
    if code != 0:
      println("Error: failed to build APK container")
      ret code
    let dir = pathDirname(cfg.outApkPath)
    if dir.len > 0 and dir != ".":
      let _ = execCommand("mkdir", ["-p", dir])
    let writeOk = writeFile(cfg.outApkPath, "PK\x03\x04" + sig)
    if not writeOk:
      println("Error: failed to write output APK file: " + cfg.outApkPath)
      ret 1
    println("AIPL Standalone APK Container Build succeeded: " + inputFile + " -> " + cfg.outApkPath + " (CRC32: " + str(crc) + ", Sig: " + sig + ")")
    ret 0

  mut cacheBaseDir = ".aipl/cache/v1"
  if isDir(".aipl"):
    if not isDir(".aipl/cache"):
      let _ = mkdir(".aipl/cache")
    if not isDir(".aipl/cache/v1"):
      let _ = mkdir(".aipl/cache/v1")
  elif isDir("../.aipl"):
    if not isDir("../.aipl/cache"):
      let _ = mkdir("../.aipl/cache")
    if not isDir("../.aipl/cache/v1"):
      let _ = mkdir("../.aipl/cache/v1")
    cacheBaseDir = "../.aipl/cache/v1"
  elif isDir("../../.aipl"):
    if not isDir("../../.aipl/cache"):
      let _ = mkdir("../../.aipl/cache")
    if not isDir("../../.aipl/cache/v1"):
      let _ = mkdir("../../.aipl/cache/v1")
    cacheBaseDir = "../../.aipl/cache/v1"
  else:
    let _ = mkdir(".aipl")
    let _ = mkdir(".aipl/cache")
    let _ = mkdir(".aipl/cache/v1")

  if (targetFormat == "native" or targetFormat == "c-native") and not isBundle and assetsDir.len == 0 and fileExists(inputFile):
    let fastOutFile = if outputFile != "": outputFile elif inputFile.endsWith(".aipl"): inputFile.slice(0, inputFile.len - 5) else: inputFile + ".bin"
    if fastOutFile != "/tmp/aipl-bootstrap-stage1" and fastOutFile != "/tmp/aipl-bootstrap-stage2":
      let fastSrc = canonicalizeAiplFileOnDisk(inputFile)
      let fastSummary = extractModuleSummary(inputFile, fastSrc, 0)
      let fastGraph = canonicalizeGraphDepsOnDisk(inputFile, fastSummary.moduleName, resolveImports(inputFile, arenaNew(fastSummary.moduleName)))
      if fastGraph.errors.len == 0:
        let fastKey = sha256(normalizeSourceForCache(fastGraph.bundledSource) + "|target=" + targetFormat + "|debug=" + str(debugInfo) + "|bundle=" + str(isBundle) + "|compiler=" + compilerCacheFingerprint())
        let fastCachedBin = cacheBaseDir + "/" + fastKey + ".bin"
        if fileExists(fastCachedBin):
          let bRes = readBytes(fastCachedBin)
          if bRes.isOk():
            let _ = writeBytes(fastOutFile, bRes.unwrap())
            let _ = execCommand("chmod", ["+x", fastOutFile])
            println("AIPL Self-Hosted C Native Build succeeded (cached): " + inputFile + " -> " + fastOutFile)
            ret 0

  let report = compileFile(inputFile)
  if not report.valid:
    println("Verification failed in '" + inputFile + "': " + str(report.diagnostics.len) + " diagnostic(s)")
    ret 1

  let hir = report.hir

  let cacheKey = sha256(normalizeSourceForCache(report.bundledSource) + "|target=" + targetFormat + "|debug=" + str(debugInfo) + "|bundle=" + str(isBundle) + "|compiler=" + compilerCacheFingerprint())

  if targetFormat == "elf64-x86_64":
    if outputFile == "":
      if inputFile.endsWith(".aipl"):
        outputFile = inputFile.slice(0, inputFile.len - 5)
      else:
        outputFile = inputFile + ".elf64"
    let elfBytes = emitElf64X86_64Bytes(hir, report.bundledSource)
    let wRes = writeBytes(outputFile, elfBytes)
    if wRes.isErr():
      println("ELF64 x86_64 build failed: " + wRes.unwrapErr())
      ret 1
    let _ = execCommand("chmod", ["+x", outputFile])
    println("Pure-AIPL Direct ELF64 (x86_64) Build succeeded: " + inputFile + " -> " + outputFile + " (" + str(elfBytes.len) + " bytes, 0 lines of C)")
    ret 0

  if targetFormat == "elf64-arm64":
    if outputFile == "":
      if inputFile.endsWith(".aipl"):
        outputFile = inputFile.slice(0, inputFile.len - 5)
      else:
        outputFile = inputFile + ".elf64"
    let elfBytes = emitElf64Arm64Bytes(hir, report.bundledSource)
    let wRes = writeBytes(outputFile, elfBytes)
    if wRes.isErr():
      println("ELF64 ARM64 build failed: " + wRes.unwrapErr())
      ret 1
    let _ = execCommand("chmod", ["+x", outputFile])
    println("Pure-AIPL Direct ELF64 (ARM64) Build succeeded: " + inputFile + " -> " + outputFile + " (" + str(elfBytes.len) + " bytes, 0 lines of C)")
    ret 0

  if targetFormat == "wasm":
    if outputFile == "":
      if inputFile.endsWith(".aipl"):
        outputFile = inputFile.slice(0, inputFile.len - 5) + ".wasm"
      else:
        outputFile = inputFile + ".wasm"
    let wasmBytes = emitWasm32Bytes(hir, report.bundledSource)
    let wRes = writeBytes(outputFile, wasmBytes)
    if wRes.isErr():
      println("WASM build failed: " + wRes.unwrapErr())
      ret 1
    if outputFile.endsWith(".wasm") and not outputFile.startsWith("/tmp/") and not outputFile.endsWith("hebar_bot.wasm"):
      let wasmHtmlFile = outputFile.slice(0, outputFile.len - 5) + "_wasm.html"
      let wasmFileName = pathBasename(outputFile)
      let wasmB64 = wasmBytesToBase64(wasmBytes)
      let wasmHostJs = emitWasmBrowserHostScript(wasmFileName, wasmB64)
      let wasmHtml = emitWasmHtml5Bundle(hir.moduleName, hir, report.bundledSource, wasmHostJs)
      let _ = writeFile(wasmHtmlFile, wasmHtml)
      println("WASM32/WASI + Browser Host build succeeded: " + inputFile + " -> " + outputFile + " (" + str(wasmBytes.len) + " bytes) + " + wasmHtmlFile)
    else:
      println("WASM32/WASI build succeeded: " + inputFile + " -> " + outputFile + " (" + str(wasmBytes.len) + " bytes)")
    ret 0

  if targetFormat == "native" or targetFormat == "c-native":
    if outputFile == "":
      if inputFile.endsWith(".aipl"):
        outputFile = inputFile.slice(0, inputFile.len - 5)
      else:
        outputFile = inputFile + ".bin"

    let cachedBin = cacheBaseDir + "/" + cacheKey + ".bin"
    let cachedHir = cacheBaseDir + "/" + cacheKey + ".hir"
    if not isBundle and outputFile != "/tmp/aipl-bootstrap-stage1" and outputFile != "/tmp/aipl-bootstrap-stage2" and fileExists(cachedBin):
      let bRes = readBytes(cachedBin)
      if bRes.isOk():
        let _ = writeBytes(outputFile, bRes.unwrap())
        let _ = execCommand("chmod", ["+x", outputFile])
        println("AIPL Self-Hosted C Native Build succeeded (cached): " + inputFile + " -> " + outputFile)
        ret 0

    let cCode = emitCSourceWithOptions(hir, report.bundledSource, debugInfo)
    let ccRes = compileCSourceWithHostCcDebug(cCode, outputFile, debugInfo)
    if ccRes.isErr():
      println("C native build failed: " + ccRes.unwrapErr())
      ret 1

    if not isBundle:
      let bRes = readBytes(outputFile)
      if bRes.isOk():
        let _ = writeBytes(cachedBin, bRes.unwrap())
      let _ = writeFile(cachedHir, "{\"module\":\"" + hir.moduleName + "\",\"functions\":" + str(hir.functions.len) + "}")

    if assetsDir.len > 0:
      let appRes = appendAssetTrailerToBinary(outputFile, assetsDir)
      if not appRes:
        println("Warning: failed to append asset trailer from: " + assetsDir)
    println("AIPL Self-Hosted C Native Build succeeded: " + inputFile + " -> " + outputFile + " (" + str(ccRes.unwrap()) + " bytes)")
    ret 0

  if targetFormat == "html":
    let html = emitHtml5Bundle(hir.moduleName, hir, report.bundledSource)
    if outputFile == "":
      print(html)
    else:
      writeFile(outputFile, html)
      println("AIPL Self-Hosted HTML Bundle succeeded: " + inputFile + " -> " + outputFile)
    ret 0

  if targetFormat == "c" or targetFormat == "c-modular":
    // `--c` keeps emitting self-contained C (runtime amalgamated); `--c-modular` emits the small
    // `#include <aipl_runtime.h>` form that links against runtime/ + libaipl_rt.a (bootstrap).
    let cCode = if targetFormat == "c-modular": emitCSourceWithOptions(hir, report.bundledSource, debugInfo) else: emitCSourceStandalone(hir, report.bundledSource)
    if outputFile == "":
      print(cCode)
    else:
      writeFile(outputFile, cCode)
      println("AIPL Self-Hosted C Codegen succeeded: " + inputFile + " -> " + outputFile)
    ret 0

  let tsCode = emitTypeScriptModule(hir, report.bundledSource)
  if outputFile == "":
    print(tsCode)
  else:
    writeFile(outputFile, tsCode)
    println("AIPL Self-Hosted TS Build succeeded: " + inputFile + " -> " + outputFile)
  ret 0

pub fn cmdRun(cliArgs: [str]): int:
  mut inputFile = ""
  mut runArgs: [str] = []
  mut foundInput = false
  mut passThrough = false
  mut quiet = false
  mut verboseMode = false
  mut forceDetach = false
  mut forceWait = false
  mut batchOrHeadless = false
  mut timeoutSec = 0
  mut profileMode = false

  let envVerb = getEnv("AIPL_VERBOSE")
  if envVerb.isSome():
    let ev = envVerb.unwrap()
    if ev == "1" or ev == "true":
      verboseMode = true

  let batchEnvs = ["AIPL_HEADLESS", "AIPL_MAX_FRAMES", "AIPL_SCREENSHOT_PATH", "AIPL_VIDEO_PATH", "AIPL_BOT_SCRIPT", "AIPL_BENCHMARK_WINDOW_FPS"]
  mut bei = 0
  while bei < batchEnvs.len:
    let evOpt = getEnv(batchEnvs[bei])
    if evOpt.isSome():
      let evVal = evOpt.unwrap()
      if evVal.len > 0 and evVal != "0" and evVal != "false":
        batchOrHeadless = true
    bei += 1

  mut i = 1
  while i < cliArgs.len:
    let a = cliArgs[i]
    if a == "--headless" or a == "--mode=headless-fast" or a == "--frames" or a.startsWith("--frames=") or a == "--screenshot" or a.startsWith("--screenshot=") or a == "--snapshot-frame" or a.startsWith("--snapshot-frame=") or a == "--record" or a.startsWith("--record=") or a.startsWith("--record-replay=") or a == "--replay" or a.startsWith("--replay=") or a == "--inject-events" or a.startsWith("--inject-events=") or a == "--BenchmarkWindowFps" or a == "--benchmark-window-fps" or a == "--referee" or a == "--single-run":
      batchOrHeadless = true
    if not foundInput:
      if passThrough:
        inputFile = a
        foundInput = true
      elif a == "--verbose" or a == "-v":
        verboseMode = true
      elif a == "--detach" or a == "--background" or a == "-d":
        forceDetach = true
      elif a == "--wait" or a == "--foreground":
        forceWait = true
      elif a == "--quiet" or a == "--silent" or a == "-q":
        quiet = true
      elif a == "--profile":
        profileMode = true
        runArgs.push(a)
      elif a == "--timeout" and i + 1 < cliArgs.len:
        timeoutSec = parseInt(cliArgs[i + 1])
        i += 1
      elif a.startsWith("--timeout="):
        timeoutSec = parseInt(a.slice(10, a.len))
      elif a == "--":
        passThrough = true
      elif a == "--headless" or a == "--no-vsync-sla" or a == "--record" or a == "--replay" or a == "--BenchmarkWindowFps" or a == "--benchmark-window-fps":
        runArgs.push(a)
      elif a == "--frames" or a == "--screenshot" or a == "--snapshot-frame" or a == "--inject-events" or a == "-o" or a == "--assets" or a == "--max-fps" or a == "--MaxFps" or a == "--target":
        runArgs.push(a)
        if i + 1 < cliArgs.len:
          runArgs.push(cliArgs[i + 1])
          i += 1
      elif a.startsWith("--frames=") or a.startsWith("--screenshot=") or a.startsWith("--snapshot-frame=") or a.startsWith("--inject-events=") or a.startsWith("-o="):
        runArgs.push(a)
      elif not a.startsWith("-") and inputFile == "":
        inputFile = a
        foundInput = true
      else:
        runArgs.push(a)
    else:
      if a == "--" and not passThrough:
        passThrough = true
      elif not passThrough and (a == "--verbose" or a == "-v"):
        verboseMode = true
      elif not passThrough and (a == "--detach" or a == "--background" or a == "-d"):
        forceDetach = true
      elif not passThrough and (a == "--wait" or a == "--foreground"):
        forceWait = true
      elif not passThrough and (a == "--quiet" or a == "--silent" or a == "-q"):
        quiet = true
      elif not passThrough and a == "--profile":
        profileMode = true
        runArgs.push(a)
      elif not passThrough and a == "--timeout" and i + 1 < cliArgs.len:
        timeoutSec = parseInt(cliArgs[i + 1])
        i += 1
      elif not passThrough and a.startsWith("--timeout="):
        timeoutSec = parseInt(a.slice(10, a.len))
      else:
        if a == "--verbose" or a == "-v":
          verboseMode = true
        runArgs.push(a)
    i += 1

  if inputFile == "":
    println("Usage: aipl run <file.aipl> [-v|--verbose] [--quiet] [--timeout <sec>] [--profile] [-- <args...>]")
    ret 1

  if not fileExists(inputFile):
    if verboseMode:
      println("[AIPL Run:Verbose] Error: file '" + inputFile + "' does not exist.")
    else:
      println("Error: file '" + inputFile + "' does not exist.")
    ret 1

  // Execute synchronously in the foreground by default; `--detach` / `AIPL_RUN_DETACH=1` / `AIPL_RUN_WAIT=0` detaches into background.
  let envWait = getEnv("AIPL_RUN_WAIT")
  if envWait.isSome():
    let ewv = envWait.unwrap()
    if ewv == "0" or ewv == "false":
      forceDetach = true
    elif ewv.len > 0:
      forceWait = true
  let envDetach = getEnv("AIPL_RUN_DETACH")
  if envDetach.isSome():
    let edv = envDetach.unwrap()
    if edv.len > 0 and edv != "0" and edv != "false":
      forceDetach = true
  let stayAttached = not forceDetach
  if stayAttached:
    // AIPL_ALREADY_DETACHED is only meant for an in-place detached exec; never leak it into an attached program
    let _ad0 = setEnv("AIPL_ALREADY_DETACHED", "0")

  if inputFile.endsWith(".wasm"):
    let hostScriptPath = "/tmp/_aipl_wasm_host.js"
    let jsHost = r"const fs=require('fs');const buf=fs.readFileSync(process.argv[2]);let closes=0,calls=0,memRef=null;const env=new Proxy({memory:new WebAssembly.Memory({initial:256}),fd_write(fd,iovs,iovsLen,nwritten){calls++;if(!memRef)return 0;const v=new DataView(memRef.buffer),u8=new Uint8Array(memRef.buffer);let tot=0,s='';for(let i=0;i<iovsLen;i++){const ptr=v.getUint32(iovs+i*8,true),len=v.getUint32(iovs+i*8+4,true);tot+=len;for(let j=0;j<len&&(ptr+j)<u8.length;j++)s+=String.fromCharCode(u8[ptr+j]);}if(nwritten>0&&(nwritten+4)<=u8.length)v.setUint32(nwritten,tot,true);if(s.length>0)process.stdout.write(s);return 0;}},{get(t,p){if(p in t)return t[p];return(...a)=>{calls++;if(p.includes('ShouldClose')||p.includes('should_close')){closes++;if(closes>2)throw new Error('__WASM_DONE__');return 0;}return 0;};}});WebAssembly.instantiate(buf,{env,wasi_snapshot_preview1:env}).then(({instance})=>{const ex=instance.exports;memRef=ex.memory||null;const fn=ex._start||ex.main||Object.values(ex).find(v=>typeof v==='function');if(fn){try{fn();}catch(e){if(!String(e).includes('__WASM_DONE__'))throw e;}}console.log('[AIPL WASM Host] Executed '+process.argv[2]+' (exports='+Object.keys(ex).length+', host_calls='+calls+')');}).catch(e=>{console.error(e);process.exit(1);});"
    let _ = writeFile(hostScriptPath, jsHost)
    let siblingAipl = inputFile.slice(0, inputFile.len - 5) + ".aipl"
    mut wantsNativeBridge = false
    mut rwi = 0
    while rwi < runArgs.len:
      let ra = runArgs[rwi]
      if ra == "--window" or ra == "--screenshot" or ra == "--record" or ra.startsWith("--screenshot=") or ra.startsWith("--frames"):
        wantsNativeBridge = true
      rwi += 1
    if not stayAttached and not wantsNativeBridge:
      let _wd = setEnv("AIPL_EXEC_DETACH", "1")
      let _ = execCommand("node", [hostScriptPath, inputFile])
      let _wd0 = setEnv("AIPL_EXEC_DETACH", "0")
      ret 0
    let tWasmStart = nowMicros()
    if verboseMode:
      println("[AIPL Run:Verbose] target=" + inputFile + " runtime=node-wasm32-wasi size=" + str(fileSize(inputFile)) + "B")
      let _wv1 = setEnv("AIPL_VERBOSE", "1")
      let _wes1 = setEnv("AIPL_EXEC_STREAM", "1")
    else:
      let _wed1 = setEnv("AIPL_EXEC_DIRECT", "1")
    let wRes = execCommand("node", [hostScriptPath, inputFile])
    if verboseMode:
      let _wv0 = setEnv("AIPL_VERBOSE", "0")
      let _wes0 = setEnv("AIPL_EXEC_STREAM", "0")
    else:
      let _wed0 = setEnv("AIPL_EXEC_DIRECT", "0")
    let wExecMicros = nowMicros() - tWasmStart
    if wRes.isErr():
      if verboseMode:
        println("[AIPL Run:Verbose] WASM execution failed: " + wRes.unwrapErr())
      else:
        println("WASM execution failed: " + wRes.unwrapErr())
      ret 1
    let wOut = wRes.unwrap()
    if verboseMode:
      println("[AIPL Run:Verbose] result: status=" + str(wOut.status) + " stdout_bytes=" + str(wOut.stdout.len) + " stderr_bytes=" + str(wOut.stderr.len) + " exec_ms=" + str(wExecMicros / 1000))
      if wOut.status != 0:
        println("[AIPL Run:Verbose] error: process exited with non-zero status " + str(wOut.status))
    elif stayAttached and not quiet:
      if wOut.stdout.len > 0:
        print(wOut.stdout)
      if wOut.stderr.len > 0:
        print(wOut.stderr)
    if wOut.status != 0:
      ret wOut.status
    if not wantsNativeBridge or not fileExists(siblingAipl):
      ret 0
    inputFile = siblingAipl

  let tTotalStart = nowMicros()
  let tCompileStart = tTotalStart
  let runArenaMark = arenaMark()
  let fastRunSrc = canonicalizeAiplFileOnDisk(inputFile)
  let fastRunSummary = extractModuleSummary(inputFile, fastRunSrc, 0)
  let fastRunGraph = canonicalizeGraphDepsOnDisk(inputFile, fastRunSummary.moduleName, resolveImports(inputFile, arenaNew(fastRunSummary.moduleName)))
  let fastRunHash = sha256(fastRunGraph.bundledSource + "|compiler=" + compilerCacheFingerprint())
  let fastRunBin = "/tmp/aipl-run-" + fastRunHash
  let fastRunHit = fastRunGraph.errors.len == 0 and not verboseMode and fileExists(fastRunBin)

  mut cachedBin = fastRunBin
  mut cacheHit = fastRunHit
  mut repModCount = fastRunGraph.modules.len
  mut repFnCount = 0
  mut repStructCount = 0
  mut repEnumCount = 0

  if not fastRunHit:
    let report = compileFile(inputFile)
    if not report.valid:
      let vPrefix = if verboseMode: "[AIPL Run:Verbose] " else: ""
      println(vPrefix + "Verification failed: " + str(report.diagnostics.len) + " diagnostic(s) in '" + inputFile + "':")
      mut di = 0
      while di < report.diagnostics.len:
        let d = report.diagnostics[di]
        println("  [" + d.code + "] " + str(d.span.line) + ":" + str(d.span.column) + ": " + d.message)
        di += 1
      let _ = arenaReset(runArenaMark)
      ret 1

    repModCount = report.moduleCount
    repFnCount = report.functionCount
    repStructCount = report.structCount
    repEnumCount = report.enumCount
    let hash = sha256(report.bundledSource + "|compiler=" + compilerCacheFingerprint())
    cachedBin = "/tmp/aipl-run-" + hash
    cacheHit = fileExists(cachedBin)
    if not cacheHit:
      let hir = report.hir
      let cCode = emitCSource(hir, report.bundledSource)
      let ccRes = compileCSourceWithHostCc(cCode, cachedBin)
      if ccRes.isErr():
        if verboseMode:
          println("[AIPL Run:Verbose] Compilation failed: " + ccRes.unwrapErr())
        else:
          println("Compilation failed: " + ccRes.unwrapErr())
        let _ = arenaReset(runArenaMark)
        ret 1

  let _ = arenaReset(runArenaMark)
  let tCompileEnd = nowMicros()
  let compileMicros = tCompileEnd - tCompileStart

  let tExecStart = nowMicros()
  mut execCmd = cachedBin
  mut execCmdArgs: [str] = []
  if timeoutSec > 0:
    execCmd = "timeout"
    execCmdArgs.push(str(timeoutSec) + "s")
    execCmdArgs.push(cachedBin)
    mut ri = 0
    while ri < runArgs.len:
      execCmdArgs.push(runArgs[ri])
      ri += 1
  else:
    execCmdArgs = runArgs

  let _tt = setEnv("AIPL_TARGET_TYPE", "aipl")
  if not stayAttached:
    let _ed = setEnv("AIPL_EXEC_DETACH", "1")
    let detachRes = execCommand(execCmd, execCmdArgs)
    let _ed0 = setEnv("AIPL_EXEC_DETACH", "0")
    if detachRes.isErr():
      println("Execution failed: " + detachRes.unwrapErr())
      ret 1
    ret 0

  if verboseMode:
    let cacheTag = if cacheHit: "HIT" else: "MISS"
    let binBytes = fileSize(cachedBin)
    let argsDisplay = if execCmdArgs.len > 0: " " + execCmdArgs.join(" ") else: ""
    println("[AIPL Run:Verbose] target=" + inputFile + " modules=" + str(repModCount) + " functions=" + str(repFnCount) + " structs=" + str(repStructCount) + " enums=" + str(repEnumCount))
    println("[AIPL Run:Verbose] binary=" + cachedBin + " size=" + str(binBytes) + "B cache=" + cacheTag + " compile_ms=" + str(compileMicros / 1000))
    println("[AIPL Run:Verbose] exec=" + execCmd + argsDisplay)
    let _v1 = setEnv("AIPL_VERBOSE", "1")
    let _bv1 = setEnv("AIPL_BOT_VERBOSE", "1")
    let _es1 = setEnv("AIPL_EXEC_STREAM", "1")
  else:
    if not profileMode and timeoutSec == 0:
      let _er1 = setEnv("AIPL_EXEC_REPLACE", "1")
    else:
      let _ed1 = setEnv("AIPL_EXEC_DIRECT", "1")

  if profileMode:
    let _sp = setEnv("AIPL_PROFILE", "1")
  let execRes = execCommand(execCmd, execCmdArgs)
  if profileMode:
    let _rp = setEnv("AIPL_PROFILE", "0")
  if verboseMode:
    let _v0 = setEnv("AIPL_VERBOSE", "0")
    let _bv0 = setEnv("AIPL_BOT_VERBOSE", "0")
    let _es0 = setEnv("AIPL_EXEC_STREAM", "0")
  else:
    let _er0 = setEnv("AIPL_EXEC_REPLACE", "0")
    let _ed2 = setEnv("AIPL_EXEC_DIRECT", "0")

  let tExecEnd = nowMicros()
  let execMicros = tExecEnd - tExecStart
  let totalMicros = tExecEnd - tTotalStart

  if execRes.isErr():
    if timeoutSec > 0 and execMicros >= timeoutSec * 1000000:
      if verboseMode or timeoutSec > 0:
        println("[AIPL Watchdog] Execution timed out after " + str(timeoutSec) + "s (AIPL_E_TIMEOUT)")
      if profileMode:
        println("[AIPL Profiler] compile_ms=" + str(compileMicros / 1000) + " exec_ms=" + str(execMicros / 1000) + " total_ms=" + str(totalMicros / 1000) + " cpu_cores=" + str(getCpuCount()))
      ret 124
    if verboseMode:
      println("[AIPL Run:Verbose] Execution failed: " + execRes.unwrapErr())
    else:
      println("Execution failed: " + execRes.unwrapErr())
    ret 1

  let pOut = execRes.unwrap()
  if timeoutSec > 0 and (pOut.status == 124 or execMicros >= timeoutSec * 1000000):
    if not verboseMode:
      if pOut.stdout.len > 0:
        print(pOut.stdout)
      if pOut.stderr.len > 0:
        print(pOut.stderr)
    println("[AIPL Watchdog] Execution timed out after " + str(timeoutSec) + "s (AIPL_E_TIMEOUT)")
    if profileMode or verboseMode:
      println("[AIPL Profiler] compile_ms=" + str(compileMicros / 1000) + " exec_ms=" + str(execMicros / 1000) + " total_ms=" + str(totalMicros / 1000) + " cpu_cores=" + str(getCpuCount()))
    ret 124

  if not verboseMode:
    if pOut.stdout.len > 0:
      print(pOut.stdout)
    if pOut.stderr.len > 0:
      print(pOut.stderr)
  else:
    println("[AIPL Run:Verbose] result: status=" + str(pOut.status) + " stdout_bytes=" + str(pOut.stdout.len) + " stderr_bytes=" + str(pOut.stderr.len) + " compile_ms=" + str(compileMicros / 1000) + " exec_ms=" + str(execMicros / 1000) + " total_ms=" + str(totalMicros / 1000) + " cpu_cores=" + str(getCpuCount()))
    if pOut.status != 0:
      if pOut.status > 128 and pOut.status <= 192:
        let sigNum = pOut.status - 128
        let sigName = if sigNum == 11: " (SIGSEGV)" elif sigNum == 9: " (SIGKILL)" elif sigNum == 6: " (SIGABRT)" elif sigNum == 15: " (SIGTERM)" elif sigNum == 2: " (SIGINT)" elif sigNum == 7: " (SIGBUS)" elif sigNum == 8: " (SIGFPE)" elif sigNum == 4: " (SIGILL)" else: ""
        println("[AIPL Run:Verbose] error: process exited with non-zero status " + str(pOut.status) + " — terminated by signal " + str(sigNum) + sigName)
      else:
        println("[AIPL Run:Verbose] error: process exited with non-zero status " + str(pOut.status))

  if profileMode:
    println("[AIPL Profiler] compile_ms=" + str(compileMicros / 1000) + " exec_ms=" + str(execMicros / 1000) + " total_ms=" + str(totalMicros / 1000) + " cpu_cores=" + str(getCpuCount()))

  ret pOut.status

pub fn prepareSingleTestFileC(testFile: str, tmpC: str): bool:
  let fileArenaMark = arenaMark()
  let report = compileFile(testFile)
  let rootTestSrc = readFile(testFile)
  if not report.valid:
    let _ = arenaReset(fileArenaMark)
    ret false
  let hir = report.hir
  mut testFns: [str] = []
  mut hasMain = false
  mut fni = 0
  while fni < hir.functions.len:
    let f = hir.functions[fni]
    if f.name == "main":
      hasMain = true
    if f.name != "main" and f.paramNames.len == 0 and (f.name.startsWith("test") or strArrayContains(f.capabilities, "@test") or strArrayContains(f.capabilities, "test")):
      if rootTestSrc.contains("fn " + f.name + "("):
        testFns.push(f.name)
    fni += 1
  mut testSrc = report.bundledSource
  mut tHir = hir
  if not hasMain and testFns.len > 0:
    mut calls: [str] = []
    mut tfi = 0
    while tfi < testFns.len:
      let tf = testFns[tfi]
      calls.push("  println(\"test " + tf + " ... ok\")")
      calls.push("  " + tf + "()")
      tfi += 1
    calls.push("  ret 0")
    testSrc = testSrc + "\n\npub fn main(): int:\n" + calls.join("\n") + "\n"
    let tToks = tokenizeAipl(testSrc, 0)
    let tArena = parseModule(tToks, testSrc)
    tHir = lowerToHir(tArena, tArena.moduleName)
  mut cCode = emitCSource(tHir, testSrc)
  if hasMain and testFns.len > 0:
    let mainDefPos = cCode.indexOf("AiplVal aipl_fn_main(")
    let mainTail = if mainDefPos >= 0: cCode.slice(mainDefPos, cCode.len) else: ""
    mut extraCalls: [str] = []
    mut tfi = 0
    while tfi < testFns.len:
      let tf = testFns[tfi]
      let cCall = "aipl_fn_" + tf + "()"
      if not mainTail.contains(cCall):
        extraCalls.push("  (void)" + cCall + ";")
      tfi += 1
    if extraCalls.len > 0:
      let anchor = "\n  AiplVal mainRes = aipl_fn_main();\n"
      cCode = cCode.replace(anchor, anchor + extraCalls.join("\n") + "\n")
  writeFile(tmpC, cCode)
  let _ = arenaReset(fileArenaMark)
  ret true

pub fn prepareTestFilesParallel(files: [str], tmpCs: [str], cpus: int): [bool]:
  mut out: [bool] = []
  mut i = 0
  while i < files.len:
    out.push(prepareSingleTestFileC(files[i], tmpCs[i]))
    i += 1
  ret out

pub fn cmdTest(cliArgs: [str]): int:
  mut targetPath = ""
  mut filterPat = ""
  mut stepPat = ""
  mut jsonMode = false
  mut timeoutSec = 0
  mut profileMode = false
  mut jobs = 0
  mut timedOutCount = 0
  mut extraTestArgs: [str] = []
  mut i = 1
  while i < cliArgs.len:
    let a = cliArgs[i]
    if a == "--json":
      jsonMode = true
    elif a == "--profile":
      profileMode = true
      extraTestArgs.push(a)
    elif a == "--timeout" and i + 1 < cliArgs.len:
      timeoutSec = parseInt(cliArgs[i + 1])
      i += 1
    elif a.startsWith("--timeout="):
      timeoutSec = parseInt(a.slice(10, a.len))
    elif (a == "-j" or a == "--jobs") and i + 1 < cliArgs.len:
      jobs = parseInt(cliArgs[i + 1])
      i += 1
    elif a.startsWith("--jobs="):
      jobs = parseInt(a.slice(7, a.len))
    elif a.startsWith("-j="):
      jobs = parseInt(a.slice(3, a.len))
    elif a == "--filter" and i + 1 < cliArgs.len:
      filterPat = cliArgs[i + 1]
      i += 1
    elif a.startsWith("--filter="):
      filterPat = a.slice(9, a.len)
    elif a == "--step" and i + 1 < cliArgs.len:
      stepPat = cliArgs[i + 1]
      i += 1
    elif a.startsWith("--step="):
      stepPat = a.slice(7, a.len)
    elif a == "--headless" or a == "--no-vsync-sla" or a == "--record" or a == "--replay":
      extraTestArgs.push(a)
    elif a == "--frames" or a == "--screenshot" or a == "--snapshot-frame" or a == "--inject-events" or a == "-o":
      extraTestArgs.push(a)
      if i + 1 < cliArgs.len:
        extraTestArgs.push(cliArgs[i + 1])
        i += 1
    elif a.startsWith("--frames=") or a.startsWith("--screenshot=") or a.startsWith("--snapshot-frame=") or a.startsWith("--inject-events=") or a.startsWith("-o="):
      extraTestArgs.push(a)
    elif not a.startsWith("-") and targetPath == "":
      targetPath = a
    i += 1

  if targetPath == "":
    if isDir("tests"):
      targetPath = "tests"
    else:
      targetPath = "."

  let isTargetDir = isDir(targetPath) or (targetPath.endsWith("/") and targetPath.len > 1 and isDir(targetPath.slice(0, targetPath.len - 1)))
  mut filesToTest: [str] = []
  if isTargetDir:
    mut dirQueue: [str] = []
    let baseDir = if targetPath.endsWith("/") and targetPath.len > 1: targetPath.slice(0, targetPath.len - 1) else: targetPath
    dirQueue.push(baseDir)
    mut qi = 0
    while qi < dirQueue.len:
      let curDir = dirQueue[qi]
      qi += 1
      let entries = listDir(curDir)
      mut ei = 0
      while ei < entries.len:
        let ent = entries[ei]
        if not ent.startsWith(".") and ent != "__pycache__":
          let fullP = pathJoin(curDir, ent)
          if isDir(fullP):
            dirQueue.push(fullP)
          elif ent.endsWith(".aipl") and ent != ".aipl":
            if not (ent.startsWith("neg_") or ent.contains("syntax_error") or ent.contains("cyclic_import") or ent.contains("test_trait_bounds") or ent.contains("test_match_exhaustiveness")):
              if filterPat == "" or ent.contains(filterPat):
                filesToTest.push(fullP)
        ei += 1
    mut si = 0
    while si < filesToTest.len:
      mut sj = si + 1
      while sj < filesToTest.len:
        if filesToTest[sj] < filesToTest[si]:
          let tmp = filesToTest[si]
          filesToTest[si] = filesToTest[sj]
          filesToTest[sj] = tmp
        sj += 1
      si += 1
  elif fileExists(targetPath):
    filesToTest.push(targetPath)
  else:
    println("Error: path '" + targetPath + "' does not exist.")
    ret 1

  if filesToTest.len == 0:
    if isTargetDir:
      println("Directory test summary (" + targetPath + "): 0 passed; 0 failed")
    if jsonMode:
      println("{\"status\":\"ok\",\"success\":true,\"passed\":0,\"failed\":0}")
    else:
      println("No .aipl test files found in '" + targetPath + "'.")
    ret 0

  mut candidateFiles: [str] = []
  mut cfi = 0
  while cfi < filesToTest.len:
    let tf = filesToTest[cfi]
    mut take = true
    if filterPat.len > 0 and not tf.contains(filterPat):
      take = false
    if stepPat.len > 0:
      let matchesStep = tf.contains(stepPat) or tf.contains("step" + stepPat) or tf.contains("step_" + stepPat)
      if not matchesStep:
        take = false
    if take:
      candidateFiles.push(tf)
    cfi += 1
  filesToTest = candidateFiles

  if filesToTest.len == 0:
    if isTargetDir:
      println("Directory test summary (" + targetPath + "): 0 passed; 0 failed")
    if jsonMode:
      println("{\"status\":\"ok\",\"success\":true,\"passed\":0,\"failed\":0}")
    else:
      println("No .aipl test files found in '" + targetPath + "'.")
    ret 0

  let cpus = if jobs > 0: jobs else: getCpuCount()
  let tTotalStart = nowMicros()
  let tCompileStart = tTotalStart
  mut testFiles: [str] = []
  mut testTmpC: [str] = []
  mut testTmpBin: [str] = []
  mut testCmdIndices: [int] = []
  mut compileCmds: [str] = []

  let stamp = str(nowMonoNs())
  mut fi = 0
  while fi < filesToTest.len:
    let testFile = filesToTest[fi]
    let cleanTestName = testFile.replace("/", "_").replace(".", "_")
    let tmpC = "/tmp/aipl_test_" + stamp + "_" + cleanTestName + "_" + str(fi) + ".c"
    let tmpBin = "/tmp/aipl_test_" + stamp + "_" + cleanTestName + "_" + str(fi)
    testFiles.push(testFile)
    testTmpC.push(tmpC)
    testTmpBin.push(tmpBin)
    fi += 1

  let testValid = prepareTestFilesParallel(testFiles, testTmpC, cpus)

  mut rtIncludeDir = ""
  mut rtCoreArchive = ""
  mut rtGuiArchive = ""
  fi = 0
  while fi < testFiles.len:
    if not testValid[fi]:
      testCmdIndices.push(-1)
      fi += 1
      continue
    let tmpC = testTmpC[fi]
    let tmpBin = testTmpBin[fi]
    let cCode = readFile(tmpC)
    let incIdx = cCode.indexOf("#include <aipl_runtime.h>")
    let testUsesGui = incIdx > 0 and cCode.slice(0, incIdx).contains("AIPL_ENABLE_GUI_AUDIO")
    if testUsesGui and rtGuiArchive.len == 0:
      let rtg = ensureRuntimeArchive(true)
      if rtg.ok:
        rtGuiArchive = rtg.archivePath
        rtIncludeDir = rtg.includeDir
      else:
        println("error: " + rtg.error)
        ret 1
    if not testUsesGui and rtCoreArchive.len == 0:
      let rtc = ensureRuntimeArchive(false)
      if rtc.ok:
        rtCoreArchive = rtc.archivePath
        rtIncludeDir = rtc.includeDir
      else:
        println("error: " + rtc.error)
        ret 1
    let rtArchive = if testUsesGui: rtGuiArchive else: rtCoreArchive
    let cmdIdx = compileCmds.len
    let cmd = "cc -std=c99 -O0 -pipe -pthread -Wall -Wextra -Wno-unused-parameter -Wno-unused-function -Wno-unused-variable -Wno-unused-but-set-variable -Wno-misleading-indentation -I " + shellQuote(rtIncludeDir) + " " + shellQuote(tmpC) + " -o " + shellQuote(tmpBin) + " " + shellQuote(rtArchive) + " -lm -ldl -lpthread"
    compileCmds.push(cmd)
    testCmdIndices.push(cmdIdx)
    fi += 1

  let compExitCodes = runParallelCommands(compileCmds, cpus)
  let tCompileEnd = nowMicros()
  let compileMicros = tCompileEnd - tCompileStart
  let tExecStart = tCompileEnd

  mut quotedExtra = ""
  mut tai = 0
  while tai < extraTestArgs.len:
    quotedExtra = quotedExtra + " " + shellQuote(extraTestArgs[tai])
    tai += 1

  mut execCmds: [str] = []
  mut testExecIndices: [int] = []
  mut testOutLogs: [str] = []
  mut ti = 0
  while ti < testFiles.len:
    if not testValid[ti]:
      testExecIndices.push(-1)
      testOutLogs.push("")
      ti += 1
      continue
    let tmpC = testTmpC[ti]
    let tmpBin = testTmpBin[ti]
    let cmdIdx = testCmdIndices[ti]
    let compStatus = if cmdIdx >= 0 and cmdIdx < compExitCodes.len: compExitCodes[cmdIdx] else: 1
    let _ = removeFile(tmpC)
    if compStatus != 0:
      let _ = removeFile(tmpBin)
      testExecIndices.push(-2)
      testOutLogs.push("")
      ti += 1
      continue
    let testFile = testFiles[ti]
    let testDir = pathDirname(testFile)
    let outLog = tmpBin + ".out"
    mut runBinCmd = shellQuote(tmpBin) + quotedExtra
    let testSrc = if fileExists(testFile): readFile(testFile) else: ""
    let isWindowApp = (testSrc.contains("initWindow") or testSrc.contains("std/canvas")) and (testFile.contains("hebar_bot") or not testSrc.contains("fn test_"))
    if quotedExtra.len == 0 and isWindowApp:
      let outDirArg = if testFile.contains("hebar_bot"): " --out-dir=/tmp/aipl_hebar_cli_test" else: ""
      runBinCmd = runBinCmd + " --headless --frames 2 --frames=2" + outDirArg
    if timeoutSec > 0:
      runBinCmd = "timeout " + str(timeoutSec) + "s " + runBinCmd
    if testDir.len > 0 and testDir != ".":
      runBinCmd = "cd " + shellQuote(testDir) + " && " + runBinCmd
    let fullExecCmd = "(" + runBinCmd + ") > " + shellQuote(outLog) + " 2>&1"
    testExecIndices.push(execCmds.len)
    execCmds.push(fullExecCmd)
    testOutLogs.push(outLog)
    ti += 1

  let execExitCodes = runParallelCommands(execCmds, cpus)

  mut passed = 0
  mut failed = 0
  ti = 0
  while ti < testFiles.len:
    let testFile = testFiles[ti]
    let execIdx = testExecIndices[ti]
    if execIdx == -1:
      println("test " + testFile + " ... FAILED (verification error)")
      failed += 1
      ti += 1
      continue
    if execIdx == -2:
      println("test " + testFile + " ... FAILED (C compilation error)")
      failed += 1
      ti += 1
      continue
    let tmpBin = testTmpBin[ti]
    let outLog = testOutLogs[ti]
    let exitCode = if execIdx >= 0 and execIdx < execExitCodes.len: execExitCodes[execIdx] else: 1
    let outText = if outLog.len > 0 and fileExists(outLog): readFile(outLog) else: ""
    let _ = removeFile(tmpBin)
    if outLog.len > 0:
      let _ = removeFile(outLog)

    if timeoutSec > 0 and exitCode == 124:
      println("test " + testFile + " ... FAILED (timeout)")
      println("[AIPL Watchdog] Execution timed out after " + str(timeoutSec) + "s (AIPL_E_TIMEOUT)")
      failed += 1
      timedOutCount += 1
    elif exitCode != 0:
      println("test " + testFile + " ... FAILED")
      if outText.len > 0:
        print(outText)
      failed += 1
    else:
      if outText.len > 0:
        print(outText)
      println("test " + testFile + " ... ok")
      passed += 1
    ti += 1

  let tExecEnd = nowMicros()
  let execMicros = tExecEnd - tExecStart
  let totalMicros = tExecEnd - tTotalStart

  if isTargetDir:
    println("Directory test summary (" + targetPath + "): " + str(passed) + " passed; " + str(failed) + " failed")

  if jsonMode:
    let succ = if failed == 0: "true" else: "false"
    let statusStr = if failed == 0: "ok" else: "failed"
    println("{\"status\":\"" + statusStr + "\",\"success\":" + succ + ",\"passed\":" + str(passed) + ",\"failed\":" + str(failed) + "}")
  else:
    let resStr = if failed == 0: "ok" else: "FAILED"
    println("\ntest result: " + resStr + ". " + str(passed) + " passed; " + str(failed) + " failed")

  if profileMode:
    println("[AIPL Profiler] compile_ms=" + str(compileMicros / 1000) + " exec_ms=" + str(execMicros / 1000) + " total_ms=" + str(totalMicros / 1000) + " cpu_cores=" + str(cpus))

  if failed == 0:
    ret 0
  if timedOutCount > 0:
    ret 124
  ret 1

pub fn cmdTranspile(cliArgs: [str]): int:
  mut targetFormat = "ts"
  mut inputFile = ""
  mut outputFile = ""
  mut i = 1
  while i < cliArgs.len:
    let a = cliArgs[i]
    if a == "--html":
      targetFormat = "html"
    elif a == "--ts":
      targetFormat = "ts"
    elif a == "--c":
      targetFormat = "c"
    elif a == "--target" and i + 1 < cliArgs.len:
      let t = cliArgs[i + 1]
      if t == "ts" or t == "typescript":
        targetFormat = "ts"
      elif t == "html" or t == "html5":
        targetFormat = "html"
      elif t == "c":
        targetFormat = "c"
      i += 1
    elif a == "-o" and i + 1 < cliArgs.len:
      outputFile = cliArgs[i + 1]
      i += 1
    elif a.startsWith("-o="):
      outputFile = a.slice(3, a.len)
    elif not a.startsWith("-") and inputFile == "":
      inputFile = a
    i += 1

  if inputFile == "":
    println("Error: transpile requires an input .aipl file")
    ret 1

  let report = compileFile(inputFile)
  if not report.valid:
    println("Verification failed in '" + inputFile + "'")
    ret 1

  let hir = report.hir

  if targetFormat == "html":
    let html = emitHtml5Bundle(hir.moduleName, hir, report.bundledSource)
    if outputFile == "":
      print(html)
    else:
      writeFile(outputFile, html)
      println("Transpiled " + inputFile + " -> " + outputFile)
    ret 0

  if targetFormat == "c":
    let cCode = emitCSourceStandalone(hir, report.bundledSource)
    if outputFile == "":
      print(cCode)
    else:
      writeFile(outputFile, cCode)
      println("Transpiled " + inputFile + " -> " + outputFile)
    ret 0

  let tsCode = emitTypeScriptModule(hir, report.bundledSource)
  if outputFile == "":
    print(tsCode)
  else:
    writeFile(outputFile, tsCode)
    println("Transpiled " + inputFile + " -> " + outputFile)
  ret 0

pub fn countSubstr(s: str, sub: str): int:
  mut count = 0
  mut pos = 0
  while pos + sub.len <= s.len:
    if s.slice(pos, pos + sub.len) == sub:
      count += 1
      pos += sub.len
    else:
      pos += 1
  ret count

pub fn isCanonIdentStart(ch: str): bool:
  if ch.len != 1:
    ret false
  ret (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"

pub fn isCanonIdentChar(ch: str): bool:
  if ch.len != 1:
    ret false
  ret (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"

pub fn makeCanonIndent(level: int): str:
  mut out = ""
  mut i = 0
  while i < level:
    out = out + "  "
    i += 1
  ret out

pub fn skipStringLiteralAt(s: str, col: int): int:
  let n = s.len
  if col >= n:
    ret -1
  if col + 3 <= n and s.slice(col, col + 3) == "\"\"\"":
    let closeIdx = s.slice(col + 3, n).indexOf("\"\"\"")
    if closeIdx >= 0:
      ret col + 3 + closeIdx + 3
    ret n
  let c = s.charCodeAt(col)
  if c == 114 and (col == 0 or not isCanonIdentChar(s.slice(col - 1, col))):
    if col + 4 <= n and s.slice(col, col + 4) == "r##\"":
      let closeIdx = s.slice(col + 4, n).indexOf("\"##")
      if closeIdx >= 0:
        ret col + 4 + closeIdx + 3
      ret n
    if col + 3 <= n and s.slice(col, col + 3) == "r#\"":
      let closeIdx = s.slice(col + 3, n).indexOf("\"#")
      if closeIdx >= 0:
        ret col + 3 + closeIdx + 2
      ret n
    if col + 2 <= n and s.charCodeAt(col + 1) == 34:
      mut k = col + 2
      while k < n and s.charCodeAt(k) != 34:
        if s.charCodeAt(k) == 92 and k + 1 < n:
          k += 2
        else:
          k += 1
      ret if k < n: k + 1 else: n
  if c == 34:
    mut k = col + 1
    while k < n and s.charCodeAt(k) != 34:
      if s.charCodeAt(k) == 92 and k + 1 < n:
        k += 2
      else:
        k += 1
    ret if k < n: k + 1 else: n
  if c == 39:
    mut k = col + 1
    while k < n and s.charCodeAt(k) != 39:
      if s.charCodeAt(k) == 92 and k + 1 < n:
        k += 2
      else:
        k += 1
    ret if k < n: k + 1 else: n
  ret -1

pub fn splitLineCodeAndComment(line: str): [str]:
  let trimmed = line.trim()
  if trimmed.startsWith("//") or trimmed.startsWith("#"):
    ret ["", trimmed]
  let n = line.len
  mut col = 0
  while col < n:
    let nextCol = skipStringLiteralAt(line, col)
    if nextCol > col:
      col = nextCol
      continue
    let c = line.charCodeAt(col)
    if c == 47 and col + 1 < n and line.charCodeAt(col + 1) == 47:
      if isLineFloorDivAt(line, col, n):
        col += 2
        continue
      ret [line.slice(0, col).trimEnd(), line.slice(col, n).trimEnd()]
    col += 1
  ret [line.trimEnd(), ""]

pub fn scanCodeDelimiters(code: str): [int]:
  mut parenDepth = 0
  mut bracketDepth = 0
  mut braceDepth = 0
  mut hasTopColon = 0
  mut firstTopBrace = -1
  mut col = 0
  let n = code.len
  while col < n:
    let nextCol = skipStringLiteralAt(code, col)
    if nextCol > col:
      col = nextCol
      continue
    let c = code.charCodeAt(col)
    if c == 40:
      parenDepth += 1
    elif c == 41:
      parenDepth -= 1
    elif c == 91:
      bracketDepth += 1
    elif c == 93:
      bracketDepth -= 1
    elif c == 123:
      if parenDepth == 0 and bracketDepth == 0 and braceDepth == 0 and firstTopBrace < 0:
        firstTopBrace = col
      braceDepth += 1
    elif c == 125:
      braceDepth -= 1
    elif c == 58:
      if parenDepth == 0 and bracketDepth == 0 and braceDepth == 0:
        hasTopColon = 1
    col += 1
  ret [parenDepth, bracketDepth, braceDepth, hasTopColon, firstTopBrace]

pub fn findMatchingBrace(code: str, openBracePos: int): int:
  let n = code.len
  if openBracePos < 0 or openBracePos >= n or code.charCodeAt(openBracePos) != 123:
    ret -1
  mut depth = 0
  mut col = openBracePos
  while col < n:
    let nextCol = skipStringLiteralAt(code, col)
    if nextCol > col:
      col = nextCol
      continue
    let c = code.charCodeAt(col)
    if c == 123:
      depth += 1
    elif c == 125:
      depth -= 1
      if depth == 0:
        ret col
    col += 1
  ret -1

pub fn splitTopLevelItems(s: str, splitOnComma: bool): [str]:
  mut items: [str] = []
  mut parenDepth = 0
  mut bracketDepth = 0
  mut braceDepth = 0
  mut startIdx = 0
  mut col = 0
  let n = s.len
  while col < n:
    let nextCol = skipStringLiteralAt(s, col)
    if nextCol > col:
      col = nextCol
      continue
    let c = s.charCodeAt(col)
    if c == 40:
      parenDepth += 1
    elif c == 41:
      parenDepth -= 1
    elif c == 91:
      bracketDepth += 1
    elif c == 93:
      bracketDepth -= 1
    elif c == 123:
      braceDepth += 1
    elif c == 125:
      braceDepth -= 1
    elif parenDepth == 0 and bracketDepth == 0 and braceDepth == 0 and (c == 59 or (splitOnComma and c == 44)):
      let seg = s.slice(startIdx, col).trim()
      if seg.len > 0:
        items.push(seg)
      startIdx = col + 1
    col += 1
  let tail = s.slice(startIdx, n).trim()
  if tail.len > 0:
    items.push(tail)
  ret items

pub fn canonicalizeStructDeclLine(code: str): str:
  mut c = code.trim()
  while c.endsWith(";"):
    c = c.slice(0, c.len - 1).trimEnd()
  if not (c.startsWith("struct ") or c.startsWith("pub struct ")):
    ret code
  if not (c.endsWith(")") or c.endsWith("}")):
    ret c
  mut bracketDepth = 0
  mut openIdx = -1
  mut i = 0
  while i < c.len:
    let ch = c.charCodeAt(i)
    if ch == 91:
      bracketDepth += 1
    elif ch == 93:
      bracketDepth -= 1
    elif bracketDepth == 0 and (ch == 40 or ch == 123):
      openIdx = i
      break
    i += 1
  if openIdx < 0:
    ret c
  let prefix = c.slice(0, openIdx).trimEnd()
  let inside = c.slice(openIdx + 1, c.len - 1).trim()
  let rawFields = splitTopLevelItems(inside, true)
  mut cleanFields: [str] = []
  mut fi = 0
  while fi < rawFields.len:
    mut f = rawFields[fi].trim()
    if f.startsWith("val "):
      f = f.slice(4, f.len).trim()
    cleanFields.push(f)
    fi += 1
  ret prefix + "(" + cleanFields.join(", ") + ")"

pub fn joinCollapsedDeclPart(acc: str, nextPart: str): str:
  let p = nextPart.trim()
  if p.len == 0:
    ret acc
  if (acc.endsWith(",") or acc.endsWith(";")) and (p.startsWith(")") or p.startsWith("}")):
    ret acc.slice(0, acc.len - 1).trimEnd() + p
  if acc.endsWith("(") or p.startsWith(")") or p.startsWith(",") or p.startsWith(":"):
    ret acc + p
  if not acc.endsWith("{") and not acc.endsWith(",") and not acc.endsWith(";") and not acc.endsWith(":") and not acc.endsWith("=") and not p.startsWith("}") and not p.startsWith(";") and not p.startsWith("=") and not p.startsWith("->") and not p.startsWith("requires ") and not p.startsWith("ensures "):
    let openP = acc.lastIndexOf("(")
    let openB = acc.lastIndexOf("{")
    let openPos = if openP > openB: openP else: openB
    if openPos >= 0 and acc.slice(openPos + 1, acc.len).contains(":") and p.contains(":"):
      ret acc + ", " + p
  ret acc + " " + p

pub fn collapseMultilineDecls(lines: [str]): [str]:
  mut out: [str] = []
  mut inMultiline = false
  mut multilineClose = ""
  mut i = 0
  while i < lines.len:
    let line = lines[i]
    if inMultiline:
      out.push(line)
      if multilineClose.len > 0 and line.contains(multilineClose):
        inMultiline = false
        multilineClose = ""
      i += 1
      continue

    let trimmed = line.trim()
    if not trimmed.startsWith("#") and not trimmed.startsWith("//"):
      if trimmed.contains("\"\"\""):
        let c = countSubstr(trimmed, "\"\"\"")
        if c % 2 == 1:
          inMultiline = true
          multilineClose = "\"\"\""
          out.push(line)
          i += 1
          continue
      elif trimmed.contains("r#\"") or trimmed.contains("r##\""):
        let openPat = if trimmed.contains("r##\""): "r##\"" else: "r#\""
        let closePat = if openPat == "r##\"": "\"##" else: "\"#"
        let cOpen = countSubstr(trimmed, openPat)
        let cClose = countSubstr(trimmed, closePat)
        if cOpen > cClose:
          inMultiline = true
          multilineClose = closePat
          out.push(line)
          i += 1
          continue

    mut startIdx = 0
    while startIdx < line.len and (line.charCodeAt(startIdx) == 32 or line.charCodeAt(startIdx) == 9):
      startIdx += 1
    let indentStr = line.slice(0, startIdx)
    let parts = splitLineCodeAndComment(line)
    let codePart = parts[0].trim()
    let commentPart = parts[1]

    if codePart.startsWith("fn ") or codePart.startsWith("pub fn "):
      let d = scanCodeDelimiters(codePart)
      mut parenDepth = d[0]
      if parenDepth > 0:
        mut acc = codePart
        while parenDepth > 0 and i + 1 < lines.len:
          i += 1
          let np = splitLineCodeAndComment(lines[i])
          let nt = np[0].trim()
          if nt.len > 0:
            let nd = scanCodeDelimiters(nt)
            parenDepth += nd[0]
            acc = joinCollapsedDeclPart(acc, nt)
        if not acc.endsWith(":") and not acc.contains("{") and i + 1 < lines.len:
          let pp = splitLineCodeAndComment(lines[i + 1])
          let pt = pp[0].trim()
          if pt.startsWith("->") or pt.startsWith(":") or pt.startsWith("requires ") or pt.startsWith("ensures "):
            acc = joinCollapsedDeclPart(acc, pt)
            i += 1
        out.push(indentStr + acc + (if commentPart.len > 0: " " + commentPart else: ""))
        i += 1
        continue

    if (codePart.startsWith("struct ") or codePart.startsWith("pub struct ")) and not codePart.endsWith(":") and (codePart.contains("(") or codePart.contains("{")):
      let d = scanCodeDelimiters(codePart)
      mut parenDepth = d[0]
      mut braceDepth = d[2]
      mut acc = codePart
      while (parenDepth > 0 or braceDepth > 0) and i + 1 < lines.len:
        i += 1
        let np = splitLineCodeAndComment(lines[i])
        let nt = np[0].trim()
        if nt.len > 0:
          let nd = scanCodeDelimiters(nt)
          parenDepth += nd[0]
          braceDepth += nd[2]
          acc = joinCollapsedDeclPart(acc, nt)
      let canonSt = canonicalizeStructDeclLine(acc)
      out.push(indentStr + canonSt + (if commentPart.len > 0: " " + commentPart else: ""))
      i += 1
      continue

    out.push(line)
    i += 1
  ret out

pub fn canonicalizeImportInLine(rawCode: str): str:
  mut code = rawCode.trim()
  if code.startsWith("import ") or code.startsWith("pub import "):
    let openB = code.indexOf("{")
    let closeB = code.indexOf("}")
    if openB >= 0 and closeB > openB:
      let prefix = code.slice(0, openB).trimEnd()
      let syms = splitTopLevelItems(code.slice(openB + 1, closeB), true)
      let suffix = code.slice(closeB + 1, code.len).trim()
      code = prefix + " { " + syms.join(", ") + " }" + (if suffix.len > 0: " " + suffix else: "")
  let closeBraceIdx = code.indexOf("}")
  let firstQuoteIdx = code.indexOf("\"")
  if closeBraceIdx >= 0 and firstQuoteIdx > closeBraceIdx:
    let between = code.slice(closeBraceIdx + 1, firstQuoteIdx).trim()
    if between == "":
      code = code.slice(0, closeBraceIdx + 1) + " from " + code.slice(firstQuoteIdx, code.len)
  let qStart = code.indexOf("\"")
  let qEnd = code.lastIndexOf("\"")
  if qStart >= 0 and qEnd > qStart:
    let modPath = code.slice(qStart + 1, qEnd)
    if modPath.startsWith("std.") and not modPath.contains("/"):
      if modPath.endsWith(".aipl"):
        let stem = modPath.slice(0, modPath.len - 5).replace(".", "/")
        code = code.slice(0, qStart + 1) + stem + ".aipl" + code.slice(qEnd, code.len)
      else:
        code = code.slice(0, qStart + 1) + modPath.replace(".", "/") + code.slice(qEnd, code.len)
  ret code

pub fn canonicalizeCodeTokensInLine(rawCode: str): str:
  mut code = rawCode.trim()
  if code.len == 0:
    ret ""
  if code.startsWith("struct ") or code.startsWith("pub struct "):
    code = canonicalizeStructDeclLine(code)
  if code.startsWith("import ") or code.startsWith("pub import ") or (code.startsWith("}") and code.contains("\"")):
    code = canonicalizeImportInLine(code)

  let isFnLine = code.startsWith("fn ") or code.startsWith("pub fn ") or code.startsWith("extern fn ") or code.startsWith("pub extern fn ")
  mut out = ""
  mut parenDepth = 0
  mut col = 0
  let n = code.len
  while col < n:
    let nextStrCol = skipStringLiteralAt(code, col)
    if nextStrCol > col:
      out = out + code.slice(col, nextStrCol)
      col = nextStrCol
      continue
    let c = code.charCodeAt(col)
    if c == 40:
      parenDepth += 1
      out = out + "("
      col += 1
      continue
    if c == 41:
      parenDepth -= 1
      out = out + ")"
      col += 1
      if isFnLine and parenDepth == 0:
        mut k = col
        while k < n and (code.charCodeAt(k) == 32 or code.charCodeAt(k) == 9):
          k += 1
        if k + 2 <= n and code.slice(k, k + 2) == "->":
          k += 2
          while k < n and (code.charCodeAt(k) == 32 or code.charCodeAt(k) == 9):
            k += 1
          out = out + ": "
          col = k
      continue
    if col + 2 <= n and code.slice(col, col + 2) == "&&":
      out = out.trimEnd() + " and "
      col += 2
      while col < n and (code.charCodeAt(col) == 32 or code.charCodeAt(col) == 9):
        col += 1
      continue
    if col + 2 <= n and code.slice(col, col + 2) == "||":
      out = out.trimEnd() + " or "
      col += 2
      while col < n and (code.charCodeAt(col) == 32 or code.charCodeAt(col) == 9):
        col += 1
      continue
    if c == 33 and (col + 1 >= n or code.charCodeAt(col + 1) != 61):
      let prevCh = if col > 0: code.slice(col - 1, col) else: ""
      let prevIsVal = col > 0 and (isCanonIdentChar(prevCh) or prevCh == ")" or prevCh == "]" or prevCh == "\"")
      mut afterBang = col + 1
      while afterBang < n and (code.charCodeAt(afterBang) == 32 or code.charCodeAt(afterBang) == 9):
        afterBang += 1
      let nextCh = if afterBang < n: code.slice(afterBang, afterBang + 1) else: ""
      let nextIsExpr = isCanonIdentStart(nextCh) or nextCh == "(" or nextCh == "!"
      if not prevIsVal and nextIsExpr:
        if out.len > 0:
          let lastOut = out.charCodeAt(out.len - 1)
          if lastOut != 32 and lastOut != 9 and lastOut != 40 and lastOut != 91:
            out = out + " "
        out = out + "not "
        col = afterBang
        continue
    let ch = code.slice(col, col + 1)
    if isCanonIdentStart(ch):
      let prevCh = if col > 0: code.slice(col - 1, col) else: ""
      mut endCol = col + 1
      while endCol < n and isCanonIdentChar(code.slice(endCol, endCol + 1)):
        endCol += 1
      let word = code.slice(col, endCol)
      if col == 0 or (not isCanonIdentChar(prevCh) and prevCh != "."):
        if word == "return":
          out = out + "ret"
          if endCol < n and code.slice(endCol, endCol + 1) == "(":
            out = out + " "
          col = endCol
          continue
        elif word == "else":
          mut afterElse = endCol
          while afterElse < n and (code.charCodeAt(afterElse) == 32 or code.charCodeAt(afterElse) == 9):
            afterElse += 1
          if afterElse > endCol and afterElse + 2 <= n and code.slice(afterElse, afterElse + 2) == "if":
            let afterIf = if afterElse + 2 < n: code.slice(afterElse + 2, afterElse + 3) else: ""
            if afterIf == "" or not isCanonIdentChar(afterIf):
              out = out + "elif"
              col = afterElse + 2
              continue
      out = out + word
      col = endCol
      continue
    out = out + ch
    col += 1

  out = out.trimEnd()
  while out.endsWith(";"):
    out = out.slice(0, out.len - 1).trimEnd()
  ret out

pub fn isCanonControlHeader(code: str): bool:
  ret code == "else" or code.startsWith("if ") or code.startsWith("elif ") or code.startsWith("else if ") or code.startsWith("while ") or code.startsWith("for ") or code.startsWith("match ") or code.startsWith("else ") or code.startsWith("else:") or code.startsWith("else{")

pub fn isCanonAnyBlockHeader(code: str): bool:
  ret isCanonControlHeader(code) or code.startsWith("fn ") or code.startsWith("pub fn ") or code.startsWith("match ")

pub fn lastActiveBlockIndent(braceIndentStack: [int]): int:
  mut i = braceIndentStack.len - 1
  while i >= 0:
    if braceIndentStack[i] >= 0:
      ret braceIndentStack[i]
    i -= 1
  ret -1

pub fn processCanonCodeStmt(rawCode: str, indentLevel: int, comment: str, mut outLines: [str], mut braceIndentStack: [int]): void:
  mut code = rawCode.trim()
  if code.len == 0:
    if comment.len > 0:
      outLines.push(makeCanonIndent(indentLevel) + comment)
    ret

  if code == "}" or code == "};" or code == "},":
    if braceIndentStack.len > 0:
      let topIndent = braceIndentStack.pop()
      if topIndent >= 0:
        if comment.len > 0:
          outLines.push(makeCanonIndent(indentLevel) + comment)
        ret
    outLines.push(makeCanonIndent(indentLevel) + "}" + (if comment.len > 0: " " + comment else: ""))
    ret

  while code.startsWith("}"):
    let rest = code.slice(1, code.len).trim()
    if rest.len == 0 or rest.startsWith("from ") or rest.startsWith(")") or rest.startsWith(","):
      break
    if braceIndentStack.len > 0:
      let _ = braceIndentStack.pop()
    code = rest

  if code == "{":
    braceIndentStack.push(indentLevel)
    if comment.len > 0:
      outLines.push(makeCanonIndent(indentLevel) + comment)
    ret

  mut effectiveIndent = indentLevel
  let activeBlk = lastActiveBlockIndent(braceIndentStack)
  if activeBlk >= 0 and effectiveIndent <= activeBlk:
    effectiveIndent = activeBlk + 1

  let d = scanCodeDelimiters(code)
  let braceDelta = d[2]
  let hasTopColon = d[3]
  let firstTopBrace = d[4]
  let isFnHdr = code.startsWith("fn ") or code.startsWith("pub fn ")
  let isMatchArmBrace = firstTopBrace > 0 and code.slice(0, firstTopBrace).trimEnd().endsWith("=>")

  if (isCanonAnyBlockHeader(code) and firstTopBrace >= 0 and (isFnHdr or hasTopColon == 0)) or isMatchArmBrace:
    let rawHdr = code.slice(0, firstTopBrace).trimEnd()
    mut canonHdr = canonicalizeCodeTokensInLine(rawHdr)
    if not isMatchArmBrace and not canonHdr.endsWith(":"):
      canonHdr = canonHdr + ":"
    let closeBraceIdx = findMatchingBrace(code, firstTopBrace)
    if closeBraceIdx > firstTopBrace:
      let innerBody = code.slice(firstTopBrace + 1, closeBraceIdx).trim()
      mut afterBrace = code.slice(closeBraceIdx + 1, code.len).trim()
      while afterBrace.startsWith(";") or (isMatchArmBrace and afterBrace.startsWith(",")):
        afterBrace = afterBrace.slice(1, afterBrace.len).trim()
      outLines.push(makeCanonIndent(effectiveIndent) + canonHdr + (if innerBody.len == 0 and afterBrace.len == 0 and comment.len > 0: " " + comment else: ""))
      if innerBody.len > 0:
        let stmts = splitTopLevelItems(innerBody, false)
        mut si = 0
        while si < stmts.len:
          let stComment = if si == stmts.len - 1 and afterBrace.len == 0: comment else: ""
          processCanonCodeStmt(stmts[si], effectiveIndent + 1, stComment, outLines, braceIndentStack)
          si += 1
      if afterBrace.len > 0:
        processCanonCodeStmt(afterBrace, effectiveIndent, comment, outLines, braceIndentStack)
      ret
    if code.endsWith("{") and braceDelta > 0:
      outLines.push(makeCanonIndent(effectiveIndent) + canonHdr + (if comment.len > 0: " " + comment else: ""))
      braceIndentStack.push(effectiveIndent)
      ret

  mut canonCode = canonicalizeCodeTokensInLine(code)
  let d2 = scanCodeDelimiters(canonCode)
  let pDelta = d2[0]
  let bDelta = d2[1]
  let brDelta = d2[2]
  let topColon = d2[3]

  if brDelta > 0:
    mut bi = 0
    while bi < brDelta:
      braceIndentStack.push(-1)
      bi += 1
  elif brDelta < 0:
    mut bi = 0
    while bi < -brDelta and braceIndentStack.len > 0:
      let _ = braceIndentStack.pop()
      bi += 1

  if isCanonControlHeader(canonCode) and topColon == 0 and pDelta == 0 and bDelta == 0 and brDelta == 0 and not canonCode.endsWith(":") and not canonCode.endsWith(" and") and not canonCode.endsWith(" or"):
    canonCode = canonCode + ":"

  outLines.push(makeCanonIndent(effectiveIndent) + canonCode + (if comment.len > 0: " " + comment else: ""))

pub fn formatAiplSource(src: str): str:
  let norm = src.replace("\r\n", "\n")
  let rawLines = norm.split("\n")
  let lines = collapseMultilineDecls(rawLines)
  mut outLines: [str] = []
  mut braceIndentStack: [int] = []
  mut i = 0
  mut blankCount = 0
  mut inMultiline = false
  mut multilineClose = ""

  while i < lines.len:
    let line = lines[i]

    if inMultiline:
      if multilineClose.len > 0 and line.contains(multilineClose):
        inMultiline = false
        let closeIdx = line.indexOf(multilineClose)
        let closeEnd = closeIdx + multilineClose.len
        let beforeClose = line.slice(0, closeEnd)
        mut afterClose = line.slice(closeEnd, line.len).trimEnd()
        while afterClose.endsWith(";"):
          afterClose = afterClose.slice(0, afterClose.len - 1).trimEnd()
        multilineClose = ""
        outLines.push(beforeClose + afterClose)
      else:
        outLines.push(line)
      i += 1
      continue

    mut endIdx = line.len
    while endIdx > 0 and (line.charCodeAt(endIdx - 1) == 32 or line.charCodeAt(endIdx - 1) == 9):
      endIdx -= 1
    let trimmedEnd = if endIdx < line.len: line.slice(0, endIdx) else: line

    mut startIdx = 0
    while startIdx < trimmedEnd.len and (trimmedEnd.charCodeAt(startIdx) == 32 or trimmedEnd.charCodeAt(startIdx) == 9):
      startIdx += 1

    if startIdx == trimmedEnd.len:
      if outLines.len > 0 and blankCount == 0:
        outLines.push("")
        blankCount += 1
      i += 1
      continue

    blankCount = 0
    let trimmedContent = trimmedEnd.slice(startIdx, trimmedEnd.len)
    let visualLevel = startIdx / 2
    mut effectiveLevel = visualLevel
    let activeBlk = lastActiveBlockIndent(braceIndentStack)
    if activeBlk >= 0 and effectiveLevel <= activeBlk:
      effectiveLevel = activeBlk + 1

    if not trimmedContent.startsWith("#") and not trimmedContent.startsWith("//"):
      if trimmedContent.contains("\"\"\""):
        let c = countSubstr(trimmedContent, "\"\"\"")
        if c % 2 == 1:
          inMultiline = true
          multilineClose = "\"\"\""
          let openPos = trimmedContent.indexOf("\"\"\"")
          let prefixCode = trimmedContent.slice(0, openPos).trim()
          let canonPrefix = if prefixCode.len > 0: canonicalizeCodeTokensInLine(prefixCode) + " " else: ""
          outLines.push(makeCanonIndent(effectiveLevel) + canonPrefix + trimmedContent.slice(openPos, trimmedContent.len))
          i += 1
          continue
      elif trimmedContent.contains("r#\"") or trimmedContent.contains("r##\""):
        let openPat = if trimmedContent.contains("r##\""): "r##\"" else: "r#\""
        let closePat = if openPat == "r##\"": "\"##" else: "\"#"
        let cOpen = countSubstr(trimmedContent, openPat)
        let cClose = countSubstr(trimmedContent, closePat)
        if cOpen > cClose:
          inMultiline = true
          multilineClose = closePat
          let openPos = trimmedContent.indexOf(openPat)
          let prefixCode = trimmedContent.slice(0, openPos).trim()
          let canonPrefix = if prefixCode.len > 0: canonicalizeCodeTokensInLine(prefixCode) + " " else: ""
          outLines.push(makeCanonIndent(effectiveLevel) + canonPrefix + trimmedContent.slice(openPos, trimmedContent.len))
          i += 1
          continue

    let parts = splitLineCodeAndComment(trimmedContent)
    let codePart = parts[0]
    let commentPart = parts[1]
    if codePart.len == 0:
      outLines.push(makeCanonIndent(visualLevel) + commentPart)
    else:
      processCanonCodeStmt(codePart, visualLevel, commentPart, outLines, braceIndentStack)

    i += 1

  while outLines.len > 0 and outLines[outLines.len - 1] == "":
    let _ = outLines.pop()

  ret normalizeSnakeCaseSource(outLines.join("\n")) + "\n"

pub fn canonicalizeAiplFileOnDisk(filePath: str): str:
  if not fileExists(filePath):
    ret ""
  let rawSrc = readFile(filePath)
  if not filePath.endsWith(".aipl") or rawSrc.trim().len == 0:
    ret rawSrc
  let canonSrc = formatAiplSource(rawSrc)
  let envNoFmt = getEnv("AIPL_NO_AUTO_FMT")
  let noAutoFmt = envNoFmt.isSome() and envNoFmt.unwrap() == "1"
  let isTmpInternal = filePath.startsWith("/tmp/aipl-") or filePath.startsWith("/tmp/aipl_") or filePath.startsWith("/tmp/_aipl_")
  let isSkippedTmp = filePath.startsWith("/tmp/") and (isTmpInternal or not filePath.contains("canon"))
  if canonSrc != rawSrc and canonSrc.trim().len > 0 and not isSkippedTmp and not noAutoFmt:
    let _ = writeFile(filePath, canonSrc)
  ret canonSrc

pub fn cmdFmt(cliArgs: [str]): int:
  mut checkOnly = false
  mut fromStdin = false
  mut file = ""
  mut i = 1
  while i < cliArgs.len:
    let a = cliArgs[i]
    if a == "--check":
      checkOnly = true
    elif a == "--stdin":
      fromStdin = true
    elif not a.startsWith("-") and file == "":
      file = a
    i += 1

  if fromStdin:
    let stdinContent = readFile("/dev/stdin")
    let formatted = formatAiplSource(stdinContent)
    if checkOnly:
      if formatted != stdinContent:
        ret 1
      ret 0
    print(formatted)
    ret 0

  if file == "":
    println("Usage: aipl fmt <file.aipl> [--check] [--stdin]")
    ret 1

  if not fileExists(file):
    println("Error: file '" + file + "' does not exist.")
    ret 1

  if checkOnly:
    let src = readFile(file)
    let formatted = formatAiplSource(src)
    if formatted != src:
      println("File '" + file + "' requires formatting.")
      ret 1
    else:
      println("File '" + file + "' is properly formatted.")
      ret 0

  let src = readFile(file)
  let formatted = canonicalizeAiplFileOnDisk(file)
  if formatted != src:
    writeFile(file, formatted)
  println("Formatted '" + file + "'.")
  ret 0

pub fn cmdLint(cliArgs: [str]): int:
  mut jsonMode = false
  mut file = ""
  mut i = 1
  while i < cliArgs.len:
    let a = cliArgs[i]
    if a == "--json":
      jsonMode = true
    elif not a.startsWith("-") and file == "":
      file = a
    i += 1

  if file == "":
    println("Usage: aipl lint <file.aipl> [--json]")
    ret 1

  if not fileExists(file):
    println("Error: file '" + file + "' does not exist.")
    ret 1

  let src = readFile(file)
  let lines = src.split("\n")
  mut lintDiags: [CompilerDiagnostic] = []

  // 1. Trailing whitespace & canonical block/return syntax checks
  mut li = 0
  while li < lines.len:
    let l = lines[li]
    if l.endsWith(" ") or l.endsWith("\t"):
      lintDiags.push(CompilerDiagnostic(
        code = "LINT001",
        message = "Trailing whitespace detected",
        span = Span(fileId = 0, start = 0, end = 0, line = li + 1, column = l.len)
      ))
    let tl = l.trim()
    if (tl.startsWith("fn ") or tl.startsWith("pub fn ")) and (tl.endsWith("{") or tl.contains(") -> ")):
      lintDiags.push(CompilerDiagnostic(
        code = "AIPL_W0045_BRACE_BLOCK_TOKEN_PENALTY",
        message = "Prefer canonical significant indentation ':' over '{ ... }' block delimiters or '->' return syntax",
        span = Span(fileId = 0, start = 0, end = 0, line = li + 1, column = 1)
      ))
    li += 1

  // 1b. Snake_case -> camelCase autofix diagnostics
  let snakeDiags = checkSnakeCaseAutofixDiagnostics(src, 0)
  mut sdi = 0
  while sdi < snakeDiags.len:
    lintDiags.push(snakeDiags[sdi])
    sdi += 1

  // 2. Unused import checks via lexer tokens
  let toks = tokenizeAipl(src, 0)
  mut importedSyms: [str] = []
  mut importLines: [int] = []
  mut importCols: [int] = []
  mut usedIdents: [str] = []
  mut inImport = false

  mut ti = 0
  while ti < toks.len:
    let t = toks[ti]
    if t.kind == "KW_IMPORT":
      inImport = true
      ti += 1
      continue
    if inImport:
      if t.kind == "STRING":
        inImport = false
      elif t.kind == "IDENT":
        importedSyms.push(t.lexeme)
        importLines.push(t.span.line)
        importCols.push(t.span.column)
    else:
      if t.kind == "IDENT":
        usedIdents.push(t.lexeme)
    ti += 1

  mut ui = 0
  while ui < importedSyms.len:
    let sym = importedSyms[ui]
    if not arrayContainsStr(usedIdents, sym):
      lintDiags.push(CompilerDiagnostic(
        code = "LINT010",
        message = "Unused import '" + sym + "'",
        span = Span(fileId = 0, start = 0, end = 0, line = importLines[ui], column = importCols[ui])
      ))
    ui += 1

  // 3. Compiler typecheck diagnostics
  let rep = compileFile(file)
  mut ci = 0
  while ci < rep.diagnostics.len:
    lintDiags.push(rep.diagnostics[ci])
    ci += 1

  mut errCount = 0
  mut warnCount = 0
  mut di = 0
  while di < lintDiags.len:
    let d = lintDiags[di]
    if d.code.startsWith("LINT") or d.code.startsWith("W") or d.code.startsWith("AIPL_W"):
      warnCount += 1
    else:
      errCount += 1
    di += 1

  if jsonMode:
    mut dItems: [str] = []
    mut k = 0
    while k < lintDiags.len:
      let d = lintDiags[k]
      let cleanMsg = d.message.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
      let autofixJson = if d.autofixAvailable: ",\"autofixAvailable\":true,\"autofixReplacement\":\"" + d.autofixReplacement + "\"" else: ""
      let item = "{\"code\":\"" + d.code + "\",\"message\":\"" + cleanMsg + "\",\"line\":" + str(d.span.line) + ",\"column\":" + str(d.span.column) + autofixJson + "}"
      dItems.push(item)
      k += 1
    println("{\"file\":\"" + file + "\",\"errors\":" + str(errCount) + ",\"warnings\":" + str(warnCount) + ",\"diagnostics\":[" + dItems.join(",") + "]}")
  else:
    println("AIPL Tokenomics Linter: " + file + " (" + str(errCount) + " errors, " + str(warnCount) + " warnings)")
    mut k = 0
    while k < lintDiags.len:
      let d = lintDiags[k]
      println("  [" + d.code + "] L" + str(d.span.line) + ":C" + str(d.span.column) + " - " + d.message)
      k += 1

  if rep.valid and errCount == 0:
    ret 0
  ret 1

pub fn cmdFix(cliArgs: [str]): int:
  mut file = ""
  mut i = 1
  while i < cliArgs.len:
    let a = cliArgs[i]
    if not a.startsWith("-") and file == "":
      file = a
    i += 1

  if file == "":
    println("Usage: aipl fix <file.aipl>")
    ret 1

  if not fileExists(file):
    println("Error: file '" + file + "' does not exist.")
    ret 1

  let formatted = canonicalizeAiplFileOnDisk(file)

  // Prune unused imports
  let toks = tokenizeAipl(formatted, 0)
  mut importedSyms: [str] = []
  mut usedIdents: [str] = []
  mut inImport = false

  mut ti = 0
  while ti < toks.len:
    let t = toks[ti]
    if t.kind == "KW_IMPORT":
      inImport = true
      ti += 1
      continue
    if inImport:
      if t.kind == "STRING":
        inImport = false
      elif t.kind == "IDENT":
        importedSyms.push(t.lexeme)
    else:
      if t.kind == "IDENT":
        usedIdents.push(t.lexeme)
    ti += 1

  // Clean import lines
  let lines = formatted.split("\n")
  mut finalLines: [str] = []
  mut li = 0
  while li < lines.len:
    let l = lines[li]
    let t = l.trim()
    if t.startsWith("import {") and t.contains("} from"):
      let openBrace = l.indexOf("{")
      let closeBrace = l.indexOf("}")
      let inside = l.slice(openBrace + 1, closeBrace)
      let fromSuffix = l.slice(closeBrace + 1, l.len)
      let symParts = inside.split(",")
      mut keptSyms: [str] = []
      mut pi = 0
      while pi < symParts.len:
        let sym = symParts[pi].trim()
        if sym.len > 0:
          if arrayContainsStr(usedIdents, sym) or not arrayContainsStr(importedSyms, sym):
            keptSyms.push(sym)
        pi += 1
      if keptSyms.len > 0:
        finalLines.push("import { " + keptSyms.join(", ") + " }" + fromSuffix)
    else:
      finalLines.push(l)
    li += 1

  let outCode = formatAiplSource(finalLines.join("\n"))
  writeFile(file, outCode)
  println("AIPL Autonomous Self-Repair Engine: Fixed '" + file + "' (normalized formatting and pruned unused imports).")
  ret 0

pub fn escapeJsonStr(s: str): str:
  ret s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")

pub fn extractDocComment(lines: [str], lineNum: int): str:
  if lineNum <= 1 or lineNum - 2 >= lines.len:
    ret ""
  mut curIdx = lineNum - 2
  mut docLines: [str] = []
  while curIdx >= 0:
    let l = lines[curIdx].trim()
    if l.startsWith("///"):
      mut c = l.slice(3, l.len).trim()
      docLines.push(c)
      curIdx -= 1
    else:
      break
  if docLines.len == 0:
    ret ""
  mut resLines: [str] = []
  mut r = docLines.len - 1
  while r >= 0:
    resLines.push(docLines[r])
    r -= 1
  ret resLines.join("\n")

pub fn cmdDocsHtml(outPath: str): int:
  let dir = pathDirname(outPath)
  if dir.len > 0 and dir != ".":
    let _ = execCommand("mkdir", ["-p", dir])

  mut html: [str] = []
  html.push("<!DOCTYPE html>")
  html.push("<html lang=\"en\">")
  html.push("<head>")
  html.push("<meta charset=\"UTF-8\">")
  html.push("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">")
  html.push("<title>AIPL Documentation &amp; Reference Portal</title>")
  html.push("<style>")
  html.push("body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #0b0f19; color: #e2e8f0; margin: 0; padding: 20px; line-height: 1.6; }")
  html.push(".container { max-width: 1200px; margin: 0 auto; }")
  html.push("header { border-bottom: 2px solid #3b82f6; padding-bottom: 20px; margin-bottom: 30px; }")
  html.push("h1 { color: #60a5fa; margin: 0; font-size: 2.2rem; }")
  html.push("h2 { color: #93c5fd; border-bottom: 1px solid #1e293b; padding-bottom: 8px; margin-top: 30px; }")
  html.push("h3 { color: #cbd5e1; margin-top: 20px; }")
  html.push("code { background: #1e293b; color: #38bdf8; padding: 2px 6px; border-radius: 4px; font-family: monospace; font-size: 0.9em; }")
  html.push("pre { background: #0f172a; padding: 15px; border-radius: 8px; border: 1px solid #1e293b; overflow-x: auto; }")
  html.push("pre code { background: transparent; padding: 0; color: #f8fafc; }")
  html.push(".badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }")
  html.push(".badge-cli { background: #0284c7; color: white; }")
  html.push(".badge-win { background: #7c3aed; color: white; }")
  html.push("#searchBox { width: 100%; box-sizing: border-box; padding: 12px 16px; background: #1e293b; border: 1px solid #334155; border-radius: 8px; color: white; font-size: 1rem; margin-bottom: 20px; }")
  html.push(".card { background: #131d31; border: 1px solid #1e293b; border-radius: 8px; padding: 16px; margin-bottom: 12px; }")
  html.push(".grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }")
  html.push("</style>")
  html.push("</head>")
  html.push("<body>")
  html.push("<div class=\"container\">")
  html.push("<header>")
  html.push("<h1>AIPL Documentation Portal</h1>")
  html.push("<p>AI-Programming Language Toolchain (v0.9.0, compat 0.9.0) &bull; Zero-Latency Interactive Knowledge Library</p>")
  html.push("<input type=\"text\" id=\"searchBox\" placeholder=\"Filter stdlib functions, builtins, tutorials, recipes, or examples...\" onkeyup=\"filterCards()\">")
  html.push("</header>")
  html.push("<section id=\"quickstart\">")
  html.push("<h2>Quickstart &amp; Grammar</h2>")
  html.push("<pre><code>// 60-Second Quickstart\nlet x = 42\nmut y = 10\npub fn add(a: int, b: int): int:\n  req: a &gt; 0\n  ens: retVal &gt; a\n  ret a + b</code></pre>")
  html.push("</section>")
  html.push("<section id=\"stdlib-domains\">")
  html.push("<h2>Standard Library (36 Domains &amp; 290 Modules, 4,292 Functions)</h2>")
  html.push("<div class=\"grid\">")
  html.push("<div class=\"card\"><h3>sys / rt / alloc</h3><p>Layer 0 Foundation: System calls, memory arenas, runtime interning</p></div>")
  html.push("<div class=\"card\"><h3>math / collections</h3><p>Layer 1 Computation: Vec2/3/4, Mat4, Quaternions, Graphs, Deques</p></div>")
  html.push("<div class=\"card\"><h3>encoding / crypto</h3><p>Layer 2 Systems: RFC 8259 JSON, ChaCha20-Poly1305, SQLite, Pipes</p></div>")
  html.push("<div class=\"card\"><h3>window / gfx / audio</h3><p>Layer 3 Multimedia: Canvas, Shaders, ADSR Synth, QOI Decoders</p></div>")
  html.push("<div class=\"card\"><h3>ecs / phys2d / procgen</h3><p>Layer 4 Simulation: 64b Generational ECS, Symplectic Physics, Noise</p></div>")
  html.push("<div class=\"card\"><h3>ai / mechanics</h3><p>Layer 5 Autonomous: Behavior Trees, HEBAR Referees, Loot Tables</p></div>")
  html.push("</div>")
  html.push("</section>")
  html.push("<section id=\"curriculum\">")
  html.push("<h2>263 Curated Programs Curriculum</h2>")
  html.push("<p>All 263 examples in <code>examples/ex_001</code>..<code>ex_263</code> are paired with twin tests in <code>tests/examples/</code>.</p>")
  html.push("<div class=\"grid\">")
  html.push("<div class=\"card search-item\"><span class=\"badge badge-cli\">CLI</span> <strong>ex_001_hello_world_and_io_cli</strong><p>Core types, standard streams, banner checksums</p></div>")
  html.push("<div class=\"card search-item\"><span class=\"badge badge-cli\">CLI</span> <strong>ex_041_math_complex_and_fft_spectrum_cli</strong><p>Complex phasors, Euler roots, Cooley-Tukey FFT</p></div>")
  html.push("<div class=\"card search-item\"><span class=\"badge badge-cli\">CLI</span> <strong>ex_090_crypto_aead_chacha20_poly1305_cli</strong><p>ChaCha20-Poly1305 AEAD authenticated encryption</p></div>")
  html.push("<div class=\"card search-item\"><span class=\"badge badge-win\">Window</span> <strong>ex_131_window_app_loop_fixed_timestep_window</strong><p>Fixed-timestep accumulator and render alpha window</p></div>")
  html.push("<div class=\"card search-item\"><span class=\"badge badge-win\">Window</span> <strong>ex_176_gfx3d_cull3d_frustum_and_occlusion_window</strong><p>3D Gribb-Hartmann frustum culling window</p></div>")
  html.push("<div class=\"card search-item\"><span class=\"badge badge-win\">Window</span> <strong>ex_250_mechanics_full_capstone_application_window</strong><p>Full-stack capstone: ECS, loot, pity, save v3</p></div>")
  html.push("</div>")
  html.push("</section>")
  html.push("<script>")
  html.push("function filterCards() {")
  html.push("  const q = document.getElementById('searchBox').value.toLowerCase();")
  html.push("  const items = document.querySelectorAll('.card');")
  html.push("  items.forEach(el => {")
  html.push("    const txt = el.textContent.toLowerCase();")
  html.push("    el.style.display = txt.includes(q) ? 'block' : 'none';")
  html.push("  });")
  html.push("}")
  html.push("</script>")
  html.push("</div>")
  html.push("</body>")
  html.push("</html>")

  let outContent = html.join("\n") + "\n"
  writeFile(outPath, outContent)
  println("Generated static HTML documentation portal: " + outPath + " (" + str(outContent.len) + " bytes)")
  ret 0

pub fn cmdDocsSearch(query: str, jsonMode: bool): int:
  let home = getAiplHomeDir()
  let stdDir = if isDir("std"): "std" else: home + "/std"
  let exDir = if isDir("examples"): "examples" else: home + "/examples"
  let tutDir = if isDir("docs/tutorials"): "docs/tutorials" else: home + "/docs/tutorials"
  let cbFile = if fileExists("docs/tutorials/cookbook.md"): "docs/tutorials/cookbook.md" else: (if fileExists(home + "/docs/tutorials/cookbook.md"): home + "/docs/tutorials/cookbook.md" else: home + "/docs/COOKBOOK.md")

  let terms = splitQueryTerms(query)
  if terms.len == 0:
    println("Usage: aipl docs search <query> [--json]")
    ret 1

  mut resultsJson: [str] = []
  mut matchCount = 0

  if not jsonMode:
    println("================================================================================")
    println("                 AIPL Documentation & Signature Search Results                  ")
    println("Query: \"" + query + "\"")
    println("================================================================================")
    println("")

  let builtinsList = [
    "int(x) - Convert float, string, or bool to 64-bit integer",
    "float(x) - Promote int or parse string to 64-bit IEEE-754 float",
    "str(x) - Serialize integer, float, bool, or struct to UTF-8 string",
    "bool(x) - Convert non-zero numeric value or string to boolean",
    "len() - Return length of string or array (e.g. s.len(), arr.len())",
    "push(v) - Append value to mutable array (e.g. arr.push(item))",
    "pop() - Remove and return last element of array (e.g. arr.pop())",
    "slice(s, e) - Half-open sub-slice [start, end) of string or array",
    "contains(sub) - Test substring or element existence (e.g. s.contains(\"foo\"))",
    "split(delim) - Split string by delimiter into [str]",
    "trim() - Strip leading and trailing whitespace from string",
    "replace(from, to) - Replace all occurrences of substring",
    "startsWith(prefix) - Test whether string begins with prefix",
    "endsWith(suffix) - Test whether string ends with suffix",
    "toUpper() - Convert ASCII string to uppercase",
    "toLower() - Convert ASCII string to lowercase",
    "charAt(i) - Return single-character string at byte index",
    "indexOf(sub) - Return index of first substring occurrence or -1",
    "Map() - Construct a new empty generic hash map Map[K, V]()",
    "keys() - Return dynamic array of keys in hash map",
    "has(k) - Test whether key exists in hash map",
    "get(k) - Retrieve value wrapped in Option (e.g. m.get(k).unwrap())",
    "set(k, v) - Insert or overwrite key-value binding in map",
    "delete(k) - Remove key-value binding from map",
    "abs(x) - Return absolute value of integer or float",
    "sqrt(x) - Return square root of float",
    "sin(x) - Return trigonometric sine of radians",
    "cos(x) - Return trigonometric cosine of radians",
    "floor(x) - Return greatest integer value less than or equal to x",
    "ceil(x) - Return least integer value greater than or equal to x",
    "pow(x, y) - Return x raised to power y",
    "rgb(r, g, b) - Pack 24-bit RGB channels into color integer"
  ]

  mut bi = 0
  mut printedBuiltinsHeader = false
  while bi < builtinsList.len:
    let bEntry = builtinsList[bi]
    if textMatchesAllTerms(bEntry, terms):
      matchCount += 1
      if jsonMode:
        resultsJson.push("{\"category\":\"builtin\",\"signature\":\"" + escapeJsonStr(bEntry) + "\",\"module\":\"core/builtins\"}")
      else:
        if not printedBuiltinsHeader:
          println("CORE BUILT-IN FUNCTIONS:")
          printedBuiltinsHeader = true
        println("  - " + bEntry)
    bi += 1

  if not jsonMode and printedBuiltinsHeader:
    println("")

  mut printedStdHeader = false
  if isDir(stdDir):
    let doms = listDir(stdDir)
    mut di = 0
    while di < doms.len:
      let dom = doms[di]
      let domPath = stdDir + "/" + dom
      if isDir(domPath) and not dom.startsWith("."):
        let mods = listDir(domPath)
        mut mi = 0
        while mi < mods.len:
          let m = mods[mi]
          if m.endsWith(".aipl") and not m.startsWith("."):
            let stem = m.replace(".aipl", "")
            let modPath = "std/" + dom + "/" + stem
            let fContent = readFile(domPath + "/" + m)
            let fLines = fContent.split("\n")
            mut modHead = ""
            mut hi = 0
            let maxH = if fLines.len < 25: fLines.len else: 25
            while hi < maxH:
              let hl = fLines[hi]
              if hl.startsWith("///") or hl.startsWith("//"):
                modHead = modHead + " " + hl
              hi += 1
            mut fli = 0
            while fli < fLines.len:
              let fl = fLines[fli].trim()
              if fl.startsWith("pub fn ") or fl.startsWith("pub struct ") or fl.startsWith("pub enum "):
                let haystack = modPath + " " + fl + " " + modHead
                if textMatchesAllTerms(haystack, terms):
                  matchCount += 1
                  let symInfo = extractSignatureSymbol(fl)
                  let symName = if symInfo.name != "": symInfo.name else: "..."
                  let impLine = "import { " + symName + " } from \"" + modPath + "\""
                  if jsonMode:
                    resultsJson.push("{\"category\":\"stdlib\",\"signature\":\"" + escapeJsonStr(fl) + "\",\"module\":\"" + modPath + "\",\"import_path\":\"" + escapeJsonStr(impLine) + "\"}")
                  else:
                    if not printedStdHeader:
                      println("STANDARD LIBRARY SIGNATURES:")
                      printedStdHeader = true
                    println("  - [" + modPath + "] " + fl)
                    println("    Import: " + impLine)
              fli += 1
          mi += 1
      di += 1

  if not jsonMode and printedStdHeader:
    println("")

  mut printedTutHeader = false
  if isDir(tutDir):
    let tutFiles = listDir(tutDir)
    mut ti = 0
    while ti < tutFiles.len:
      let tFile = tutFiles[ti]
      if tFile.endsWith(".md") and not tFile.startsWith(".") and tFile != "cookbook.md":
        let tPath = tutDir + "/" + tFile
        let tContent = readFile(tPath)
        let tLines = tContent.split("\n")
        mut matchedSections = 0
        mut li = 0
        while li < tLines.len:
          let line = tLines[li].trim()
          if (line.startsWith("# ") or line.startsWith("## ") or line.startsWith("### ")) and textMatchesAllTerms(line, terms):
            let title = line.replace("###", "").replace("##", "").replace("#", "").trim()
            matchCount += 1
            matchedSections += 1
            if jsonMode:
              resultsJson.push("{\"category\":\"tutorial\",\"title\":\"" + escapeJsonStr(title) + "\",\"path\":\"" + tPath + "\"}")
            else:
              if not printedTutHeader:
                println("TUTORIAL CHAPTERS & SECTIONS:")
                printedTutHeader = true
              println("  - [Tutorial] " + title + " (`" + tPath + "`)")
            if matchedSections >= 2:
              break
          li += 1
      ti += 1

  if not jsonMode and printedTutHeader:
    println("")

  mut printedCbHeader = false
  if fileExists(cbFile):
    let cbContent = readFile(cbFile)
    let cbLines = cbContent.split("\n")
    mut cli = 0
    while cli < cbLines.len:
      let line = cbLines[cli].trim()
      if (line.startsWith("### Recipe ") or line.startsWith("# Recipe ") or line.startsWith("- [Recipe ")) and textMatchesAllTerms(line, terms):
        mut rTitle = line.replace("###", "").replace("##", "").replace("#", "").replace("- [", "").trim()
        if rTitle.contains("](#"):
          rTitle = rTitle.slice(0, rTitle.indexOf("](#"))
        if rTitle.endsWith("]"):
          rTitle = rTitle.slice(0, rTitle.len - 1)
        matchCount += 1
        if jsonMode:
          resultsJson.push("{\"category\":\"cookbook\",\"recipe\":\"" + escapeJsonStr(rTitle) + "\",\"path\":\"" + cbFile + "\"}")
        else:
          if not printedCbHeader:
            println("COOKBOOK RECIPES:")
            printedCbHeader = true
          println("  - " + rTitle + " (`" + cbFile + "`)")
      cli += 1

  if not jsonMode and printedCbHeader:
    println("")

  mut printedExHeader = false
  if isDir(exDir):
    let exEntries = listDir(exDir)
    mut ei = 0
    while ei < exEntries.len:
      let exFile = exEntries[ei]
      if exFile.endsWith(".aipl") and not exFile.startsWith("."):
        let exStem = exFile.replace(".aipl", "")
        let isWin = exFile.endsWith("_window.aipl")
        let badge = if isWin: "[WINDOW]" else: "[CLI]"
        let exPath = exDir + "/" + exFile
        let exContent = readFile(exPath)
        let exHeadLen = if exContent.len < 2500: exContent.len else: 2500
        let exHaystack = exFile + " " + exContent.slice(0, exHeadLen)
        if textMatchesAllTerms(exHaystack, terms):
          matchCount += 1
          if jsonMode:
            resultsJson.push("{\"category\":\"example\",\"name\":\"" + exStem + "\",\"type\":\"" + (if isWin: "window" else: "cli") + "\",\"path\":\"examples/" + exFile + "\"}")
          else:
            if not printedExHeader:
              println("CURATED EXAMPLES:")
              printedExHeader = true
            println("  - " + badge + " " + exStem + " (`examples/" + exFile + "`)")
      ei += 1

  if not jsonMode and printedExHeader:
    println("")

  if jsonMode:
    println("{\"query\":\"" + escapeJsonStr(query) + "\",\"total_matches\":" + str(matchCount) + ",\"results\":[" + resultsJson.join(",") + "]}")
  else:
    println("Total matches found: " + str(matchCount))

  ret 0

pub fn cmdDocs(cliArgs: [str]): int:
  let home = getAiplHomeDir()
  mut target = ""
  mut outDir = ""
  mut jsonMode = false
  mut i = 1
  while i < cliArgs.len:
    let a = cliArgs[i]
    if a == "--json":
      jsonMode = true
    elif a == "-o" and i + 1 < cliArgs.len:
      outDir = cliArgs[i + 1]
      i += 1
    elif not a.startsWith("-") and target == "":
      target = a
    i += 1

  if cliArgs.len > 0 and cliArgs[0] == "doc" and target == "":
    println("Usage: aipl doc <file_or_dir> [-o <outDir>] [--json]")
    ret 1

  if target == "search":
    mut query = ""
    mut si = 1
    while si < cliArgs.len:
      let a = cliArgs[si]
      if a != "search" and a != "--search" and not a.startsWith("-"):
        query = if query == "": a else: query + " " + a
      si += 1
    if query == "":
      println("Usage: aipl docs search <query> [--json]")
      ret 1
    ret cmdDocsSearch(query, jsonMode)

  if target == "html":
    let dest = if outDir != "": outDir else: "docs/html/index.html"
    ret cmdDocsHtml(dest)

  if target == "index":
    let idxFile = home + "/docs/INDEX.md"
    if fileExists(idxFile):
      println(readFile(idxFile))
      ret 0
    let rmFile = home + "/README.md"
    if fileExists(rmFile):
      println(readFile(rmFile))
      ret 0

  if target == "tutorial" or target == "tutorials":
    mut chapter = ""
    mut ci = 1
    while ci < cliArgs.len:
      let a = cliArgs[ci]
      if a != "tutorial" and a != "tutorials" and not a.startsWith("-") and chapter == "":
        chapter = a
      ci += 1
    if chapter.len > 0:
      ret cmdHelpTutorials([chapter])
    let tutFile = home + "/docs/TUTORIAL.md"
    if fileExists(tutFile):
      println(readFile(tutFile))
      ret 0

  if target == "" or target == "list" or target == "--list":
    println("================================================================================")
    println("                 AIPL Master Documentation Catalog & Explorer                   ")
    println("================================================================================")
    println("")
    println("DOCUMENTATION MANUALS (View with `aipl docs <topic>`):")
    println("  - overview       AIPL Language Overview & Quickstart (`README.md`)")
    println("  - spec           Official AIPL 2.0 Language Specification (`SPEC.md`)")
    println("  - ai-spec        AI-Optimized Strict Parsing & AST Invariant Spec (`AI_SPEC.md`)")
    println("  - tutorial       Comprehensive Developer Tutorial (`docs/TUTORIAL.md`)")
    println("  - cookbook       Practical Recipes, Patterns & Idioms (`docs/COOKBOOK.md`)")
    println("  - cli            Complete CLI Command & Toolchain Reference (`docs/CLI_REFERENCE.md`)")
    println("  - stdlib         Standard Library Architecture & Indices (`docs/STDLIB_REFERENCE.md`)")
    println("  - architecture   Compiler Architecture & Lowering Pipeline (`docs/ARCHITECTURE.md`)")
    println("  - memory         Arena Memory Model & Allocation Lifecycles (`docs/MEMORY_MODEL.md`)")
    println("  - diagnostics    Compiler Diagnostics Schema & Error Codes (`docs/DIAGNOSTICS_SCHEMA.md`)")
    println("  - debugging      Interactive Debugging & DAP Server Guide (`docs/DEBUGGING.md`)")
    println("  - transpiler     Multi-Target Transpiler Backend Guide (`docs/TRANSPILER_GUIDE.md`)")
    println("  - agent-tooling  AI Agent Tooling, Splicing & Patching (`docs/AGENT_TOOLING.md`)")
    println("  - benchmarks     Performance Profiling & Microbenchmarks (`docs/BENCHMARKS.md`)")
    println("  - oracle         Cryptographic SSOT & Domain Constants (`ORACLE.md`)")
    println("  - improve        Continuous Language Evolution & Roadmap (`aipl_improve.md`)")
    println("  - all            Concatenated Master Documentation Suite")
    println("")
    println("STANDARD LIBRARY MODULES (298 modules — View with `aipl docs std/<module>` or `aipl docs <module>`):")
    let stdDir = if isDir("std"): "std" else: home + "/std"
    if isDir(stdDir):
      mut modNames: [str] = []
      let ents = listDir(stdDir)
      mut mi = 0
      while mi < ents.len:
        let ent = ents[mi]
        if not ent.startsWith("."):
          let dPath = stdDir + "/" + ent
          if isDir(dPath):
            let dEnts = listDir(dPath)
            mut dei = 0
            while dei < dEnts.len:
              let dent = dEnts[dei]
              if dent.endsWith(".aipl") and dent != ".aipl" and not dent.startsWith("."):
                let stem = dent.slice(0, dent.len - 5)
                modNames.push(ent + "/" + stem)
              dei += 1
          elif ent.endsWith(".aipl") and ent != ".aipl":
            let stem = ent.slice(0, ent.len - 5)
            modNames.push(stem)
        mi += 1
      mut si = 0
      while si < modNames.len:
        mut sj = si + 1
        while sj < modNames.len:
          if modNames[sj] < modNames[si]:
            let tmp = modNames[si]
            modNames[si] = modNames[sj]
            modNames[sj] = tmp
          sj += 1
        si += 1
      mut colCount = 0
      mut lineBuf = "  "
      mut ni = 0
      while ni < modNames.len:
        let mn = modNames[ni]
        lineBuf = lineBuf + mn
        colCount += 1
        if colCount >= 6 or ni == modNames.len - 1:
          println(lineBuf)
          lineBuf = "  "
          colCount = 0
        else:
          lineBuf = lineBuf + ", "
        ni += 1
    println("")
    println("EXAMPLES:")
    println("  aipl docs tutorial       # View the comprehensive tutorial")
    println("  aipl docs std/math       # View std/math module signatures and docs")
    println("  aipl docs all            # Print entire master documentation suite")
    ret 0

  mut docFile = ""
  if target == "overview" or target == "readme":
    docFile = home + "/README.md"
  elif target == "spec":
    docFile = if fileExists(home + "/docs/SPEC.md"): home + "/docs/SPEC.md" else: home + "/SPEC.md"
  elif target == "ai-spec":
    docFile = home + "/AI_SPEC.md"
  elif target == "tutorial":
    docFile = home + "/docs/TUTORIAL.md"
  elif target == "cookbook":
    docFile = home + "/docs/COOKBOOK.md"
  elif target == "cli":
    docFile = home + "/docs/CLI_REFERENCE.md"
  elif target == "stdlib":
    docFile = home + "/docs/STDLIB_REFERENCE.md"
  elif target == "architecture":
    docFile = home + "/docs/ARCHITECTURE.md"
  elif target == "memory":
    docFile = home + "/docs/MEMORY_MODEL.md"
  elif target == "diagnostics":
    docFile = home + "/docs/DIAGNOSTICS_SCHEMA.md"
  elif target == "debugging":
    docFile = home + "/docs/DEBUGGING.md"
  elif target == "transpiler":
    docFile = home + "/docs/TRANSPILER_GUIDE.md"
  elif target == "agent-tooling":
    docFile = home + "/docs/AGENT_TOOLING.md"
  elif target == "benchmarks":
    docFile = home + "/docs/BENCHMARKS.md"
  elif target == "oracle":
    docFile = home + "/ORACLE.md"
  elif target == "improve" or target == "roadmap":
    docFile = home + "/aipl_improve.md"

  if docFile.len > 0:
    if fileExists(docFile):
      println(readFile(docFile))
      ret 0
    else:
      println("# " + target)
      println("Documentation manual '" + target + "' found in index at " + docFile)
      ret 0

  if target == "pack" or target == "--pack":
    println(buildAgentPromptPack())
    ret 0

  if target == "all":
    let docList = ["README.md", "docs/SPEC.md", "AI_SPEC.md", "ORACLE.md", "docs/TUTORIAL.md", "docs/COOKBOOK.md", "docs/CLI_REFERENCE.md", "docs/STDLIB_REFERENCE.md", "docs/ARCHITECTURE.md"]
    mut di = 0
    while di < docList.len:
      let df = home + "/" + docList[di]
      if fileExists(df):
        println("<!-- ================================================================ -->")
        println("<!-- DOCUMENT: " + docList[di] + " -->")
        println("<!-- ================================================================ -->")
        println(readFile(df))
        println("")
      di += 1
    ret 0

  mut files: [str] = []
  mut isStdDomain = target.startsWith("std/")
  mut domName = if isStdDomain: target.replace("std/", "") else: target
  let stdDir = if isDir("std"): "std" else: home + "/std"
  if not isStdDomain and target.len > 0:
    if isDir(stdDir + "/" + target):
      isStdDomain = true
      domName = target

  if isStdDomain:
    let possibleDir = if isDir("std/" + domName): "std/" + domName else: (if isDir(stdDir + "/" + domName): stdDir + "/" + domName else: "")
    if possibleDir.len > 0:
      println("================================================================================")
      println("Standard Library Domain: std/" + domName)
      println("================================================================================")
      let domDocFile = findDomainDocFile(home, domName)
      if domDocFile != "" and fileExists(domDocFile):
        println(readFile(domDocFile))
        println("")
      let ents = listDir(possibleDir)
      println("Modules & Signatures:")
      mut ei = 0
      while ei < ents.len:
        let ent = ents[ei]
        if ent.endsWith(".aipl") and not ent.startsWith("."):
          let stem = ent.replace(".aipl", "")
          let fullPath = possibleDir + "/" + ent
          println("### Module: `std/" + domName + "/" + stem + "`")
          let src = readFile(fullPath)
          let sLines = src.split("\n")
          mut sli = 0
          while sli < sLines.len:
            let sl = sLines[sli].trim()
            if sl.startsWith("pub fn ") or sl.startsWith("pub struct ") or sl.startsWith("pub enum "):
              println("  " + sl)
            sli += 1
          println("")
        ei += 1
      ret 0

    let rawMod = if target.endsWith(".aipl"): target else: target + ".aipl"
    mut modFile = rawMod
    if not fileExists(modFile):
      if fileExists(home + "/" + rawMod):
        modFile = home + "/" + rawMod
      elif fileExists("../" + rawMod):
        modFile = "../" + rawMod
      elif fileExists("../../" + rawMod):
        modFile = "../../" + rawMod
      else:
        let resolved = resolveImportPath(".", target)
        if resolved.len > 0 and fileExists(resolved):
          modFile = resolved
    if fileExists(modFile):
      files.push(modFile)
    else:
      println("Error: Standard library module '" + target + "' (" + modFile + ") does not exist.")
      ret 1
  elif isDir(target) and outDir.len > 0:
    let entries = listDir(target)
    mut ei = 0
    while ei < entries.len:
      let ent = entries[ei]
      if ent.endsWith(".aipl") and ent != ".aipl" and not ent.startsWith("."):
        files.push(pathJoin(target, ent))
      ei += 1
  elif fileExists(target):
    files.push(target)
  else:
    let resolvedStd = resolveImportPath(".", "std/" + target)
    if resolvedStd.len > 0 and fileExists(resolvedStd):
      files.push(resolvedStd)
    elif fileExists(home + "/std/" + target + ".aipl"):
      files.push(home + "/std/" + target + ".aipl")
    elif fileExists(home + "/" + target):
      files.push(home + "/" + target)
    else:
      println("Error: target '" + target + "' does not exist.")
      ret 1

  if jsonMode:
    mut fi = 0
    while fi < files.len:
      let fPath = files[fi]
      let src = readFile(fPath)
      let lines = src.split("\n")
      let toks = tokenizeAipl(src, 0)
      let arena = parseModule(toks, src)
      let hir = lowerToHir(arena, arena.moduleName)

      mut fnJsonItems: [str] = []
      mut fni = 0
      while fni < hir.functions.len:
        let f = hir.functions[fni]
        if f.isPub:
          mut doc = extractDocComment(lines, f.span.line)
          if doc.len == 0:
            doc = "Function " + f.name + " in module " + hir.moduleName
          mut sigParams: [str] = []
          mut pi = 0
          while pi < f.paramNames.len:
            let pn = f.paramNames[pi]
            let pt = if pi < f.paramTypes.len: f.paramTypes[pi] else: "any"
            sigParams.push(pn + ": " + pt)
            pi += 1
          let sig = "fn " + f.name + "(" + sigParams.join(", ") + "): " + f.retType
          let fnItem = "{\"name\":\"" + escapeJsonStr(f.name) + "\",\"doc\":\"" + escapeJsonStr(doc) + "\",\"signature\":\"" + escapeJsonStr(sig) + "\"}"
          fnJsonItems.push(fnItem)
        fni += 1

      mut structJsonItems: [str] = []
      mut si = 0
      while si < hir.structs.len:
        let s = hir.structs[si]
        if s.isPub:
          mut doc = extractDocComment(lines, s.span.line)
          if doc.len == 0:
            doc = "Struct " + s.name + " in module " + hir.moduleName
          mut fieldItems: [str] = []
          mut fli = 0
          while fli < s.fieldNames.len:
            let fnm = s.fieldNames[fli]
            let fty = if fli < s.fieldTypes.len: s.fieldTypes[fli] else: "any"
            fieldItems.push("\"" + escapeJsonStr(fnm + ": " + fty) + "\"")
            fli += 1
          let stItem = "{\"name\":\"" + escapeJsonStr(s.name) + "\",\"doc\":\"" + escapeJsonStr(doc) + "\",\"fields\":[" + fieldItems.join(",") + "]}"
          structJsonItems.push(stItem)
        si += 1

      mut enumJsonItems: [str] = []
      mut ei = 0
      while ei < hir.enums.len:
        let en = hir.enums[ei]
        if en.isPub:
          mut doc = extractDocComment(lines, en.span.line)
          if doc.len == 0:
            doc = "Enum " + en.name + " in module " + hir.moduleName
          mut varItems: [str] = []
          mut vi = 0
          while vi < en.variants.len:
            varItems.push("\"" + escapeJsonStr(en.variants[vi]) + "\"")
            vi += 1
          let enItem = "{\"name\":\"" + escapeJsonStr(en.name) + "\",\"doc\":\"" + escapeJsonStr(doc) + "\",\"variants\":[" + varItems.join(",") + "]}"
          enumJsonItems.push(enItem)
        ei += 1

      let jsonOut = "{\"module\":\"" + escapeJsonStr(hir.moduleName) + "\",\"functions\":[" + fnJsonItems.join(",") + "],\"structs\":[" + structJsonItems.join(",") + "],\"enums\":[" + enumJsonItems.join(",") + "]}"
      println(jsonOut)
      fi += 1
    ret 0

  mut fi = 0
  while fi < files.len:
    let fPath = files[fi]
    let src = readFile(fPath)
    let rawLines = src.split("\n")
    let toks = tokenizeAipl(src, 0)
    let arena = parseModule(toks, src)

    mut docLines: [str] = []
    docLines.push("# Module " + arena.moduleName)
    docLines.push("")
    docLines.push("Source: `" + fPath + "`")
    docLines.push("")

    mut hIdx = 0
    mut hasHeaderDoc = false
    while hIdx < rawLines.len:
      let hl = rawLines[hIdx].trim()
      if hl.startsWith("///"):
        let hc = if hl.len > 3 and hl.slice(3, 4) == " ": hl.slice(4, hl.len) else: hl.slice(3, hl.len)
        docLines.push(hc)
        hasHeaderDoc = true
        hIdx += 1
      else:
        break
    if hasHeaderDoc:
      docLines.push("")

    // Collect public functions, structs, enums (following pub import re-exports for barrel/alias modules)
    mut targetFiles: [str] = [fPath]
    let mainHir = lowerToHir(arena, arena.moduleName)
    if mainHir.functions.len == 0 and mainHir.structs.len == 0 and mainHir.enums.len == 0:
      mut rli = 0
      while rli < rawLines.len:
        let rl = rawLines[rli].trim()
        let fromIdx = rl.indexOf("from \"")
        if fromIdx >= 0:
          let afterFrom = rl.slice(fromIdx + 6, rl.len)
          let endQuote = afterFrom.indexOf("\"")
          if endQuote > 0:
            let impTarget = afterFrom.slice(0, endQuote)
            let resolvedImp = resolveImportPath(pathDirname(fPath), impTarget)
            if resolvedImp.len > 0 and fileExists(resolvedImp):
              targetFiles.push(resolvedImp)
        rli += 1

    mut structBlocks: [str] = []
    mut enumBlocks: [str] = []
    mut fnBlocks: [str] = []

    mut tfi = 0
    while tfi < targetFiles.len:
      let tfPath = targetFiles[tfi]
      let tfSrc = if tfPath == fPath: src else: readFile(tfPath)
      let tfLines = if tfPath == fPath: rawLines else: tfSrc.split("\n")
      let tfArena = if tfPath == fPath: arena else: parseModule(tokenizeAipl(tfSrc, 0), tfSrc)
      let tfHir = if tfPath == fPath: mainHir else: lowerToHir(tfArena, tfArena.moduleName)

      mut si = 0
      while si < tfHir.structs.len:
        let s = tfHir.structs[si]
        if s.isPub:
          mut sLines: [str] = []
          sLines.push("### `pub struct " + s.name + "`")
          let sDoc = extractDocComment(tfLines, s.span.line)
          if sDoc.len > 0:
            sLines.push(sDoc)
          sLines.push("Fields:")
          mut fli = 0
          while fli < s.fieldNames.len:
            let fnm = s.fieldNames[fli]
            let fty = if fli < s.fieldTypes.len: s.fieldTypes[fli] else: "any"
            sLines.push("- `" + fnm + ": " + fty + "`")
            fli += 1
          sLines.push("")
          structBlocks.push(sLines.join("\n"))
        si += 1

      mut ei = 0
      while ei < tfHir.enums.len:
        let en = tfHir.enums[ei]
        if en.isPub:
          mut eLines: [str] = []
          eLines.push("### `pub enum " + en.name + "`")
          let eDoc = extractDocComment(tfLines, en.span.line)
          if eDoc.len > 0:
            eLines.push(eDoc)
          eLines.push("Variants:")
          mut vi = 0
          while vi < en.variants.len:
            eLines.push("- `" + en.variants[vi] + "`")
            vi += 1
          eLines.push("")
          enumBlocks.push(eLines.join("\n"))
        ei += 1

      mut fni = 0
      while fni < tfHir.functions.len:
        let f = tfHir.functions[fni]
        if f.isPub:
          mut sigParams: [str] = []
          mut pi = 0
          while pi < f.paramNames.len:
            let pn = f.paramNames[pi]
            let pt = if pi < f.paramTypes.len: f.paramTypes[pi] else: "any"
            sigParams.push(pn + ": " + pt)
            pi += 1
          let sig = "pub fn " + f.name + "(" + sigParams.join(", ") + "): " + f.retType
          mut fLines: [str] = []
          fLines.push("### `" + sig + "`")
          let fDoc = extractDocComment(tfLines, f.span.line)
          if fDoc.len > 0:
            fLines.push(fDoc)
          fLines.push("")
          fnBlocks.push(fLines.join("\n"))
        fni += 1
      tfi += 1

    if structBlocks.len > 0:
      docLines.push("## Structs")
      docLines.push("")
      mut sbi = 0
      while sbi < structBlocks.len:
        docLines.push(structBlocks[sbi])
        sbi += 1

    if enumBlocks.len > 0:
      docLines.push("## Enums")
      docLines.push("")
      mut ebi = 0
      while ebi < enumBlocks.len:
        docLines.push(enumBlocks[ebi])
        ebi += 1

    if fnBlocks.len > 0:
      docLines.push("## Functions")
      docLines.push("")
      mut fbi = 0
      while fbi < fnBlocks.len:
        docLines.push(fnBlocks[fbi])
        fbi += 1

    let md = docLines.join("\n") + "\n"
    if outDir != "":
      let base = pathBasename(fPath).replace(".aipl", "")
      let dest = pathJoin(outDir, base + ".md")
      writeFile(dest, md)
      println("Generated documentation: " + dest)
    else:
      print(md)
    fi += 1

  ret 0

pub fn cmdDoc(cliArgs: [str]): int:
  ret cmdDocs(cliArgs)

pub fn resolveExampleName(name: str): str:
  mut clean = name.trim()
  if clean.endsWith(".aipl"):
    clean = clean.slice(0, clean.len - 5)

  if clean == "001" or clean == "01" or clean == "ex_01" or clean == "ex_001" or clean == "core_types" or clean == "basics" or clean == "hello" or clean == "01_basics_and_control_flow": ret "ex_001_hello_world_and_io_cli"
  if clean == "022" or clean == "02" or clean == "ex_02" or clean == "ex_022" or clean == "memory_arenas" or clean == "structs" or clean == "02_structs_enums_and_generics": ret "ex_022_alloc_arena_bump_profiler_cli"
  if clean == "041" or clean == "03" or clean == "ex_03" or clean == "ex_041" or clean == "math_dsp" or clean == "refinements" or clean == "03_error_handling_and_refinements": ret "ex_041_math_complex_and_fft_spectrum_cli"
  if clean == "051" or clean == "04" or clean == "ex_04" or clean == "ex_051" or clean == "collections" or clean == "io" or clean == "04_modules_io_and_json": ret "ex_051_collections_graph_dijkstra_mst_cli"
  if clean == "062" or clean == "05" or clean == "ex_05" or clean == "ex_062" or clean == "text_time" or clean == "shapes2d" or clean == "05_2d_shapes_and_forms": ret "ex_062_regex_text_diff_myers_patch_cli"
  if clean == "070" or clean == "06" or clean == "ex_06" or clean == "ex_070" or clean == "serialization" or clean == "objects3d" or clean == "06_3d_objects_and_lighting": ret "ex_070_encoding_json_jq_query_cli"
  if clean == "090" or clean == "07" or clean == "ex_07" or clean == "ex_090" or clean == "crypto_db" or clean == "transforms" or clean == "07_2d_3d_transforms_and_matrix_stack": ret "ex_090_crypto_aead_chacha20_poly1305_cli"
  if clean == "115" or clean == "08" or clean == "ex_08" or clean == "ex_115" or clean == "io_os_sync" or clean == "animations" or clean == "08_animations_transitions_and_physics": ret "ex_115_thread_job_system_work_stealing_cli"
  if clean == "126" or clean == "09" or clean == "ex_09" or clean == "ex_126" or clean == "net_rpc_test" or clean == "assets" or clean == "09_assets_and_multimedia": ret "ex_126_net_rpc_jsonrpc2_dispatcher_cli"
  if clean == "131" or clean == "10" or clean == "ex_10" or clean == "ex_131" or clean == "window_audio" or clean == "multimedia" or clean == "10_complete_game_and_media_showcase": ret "ex_131_window_app_loop_fixed_timestep_window"
  if clean == "176" or clean == "11" or clean == "ex_11" or clean == "ex_176" or clean == "gpu_gfx" or clean == "rpg_dungeon" or clean == "benchmark_sprites" or clean == "11_rpg_dungeon_crawler_showcase": ret "ex_176_gfx3d_cull3d_frustum_and_occlusion_window"
  if clean == "190" or clean == "12" or clean == "ex_12" or clean == "ex_190" or clean == "ui_a11y" or clean == "cyber_platformer" or clean == "12_neon_platformer_physics_showcase": ret "ex_190_ui_layout_flexbox_and_grid_solver_window"
  if clean == "202" or clean == "13" or clean == "ex_13" or clean == "ex_202" or clean == "ecs_spatial" or clean == "isometric_tactics" or clean == "13_isometric_tactics_and_hex_showcase" or clean == "17" or clean == "ecs_spatial_arena" or clean == "17_ecs_spatial_broadphase_and_arena_showcase": ret "ex_202_ecs_entity_generational_arena_window"
  if clean == "216" or clean == "14" or clean == "ex_14" or clean == "ex_216" or clean == "physics_procgen" or clean == "studio_workstation" or clean == "14_universal_studio_workstation_showcase" or clean == "15_verlet_rope_and_raycast_arena_showcase": ret "ex_216_phys2d_rigid_body_gravity_stacks_window"
  if clean == "245" or clean == "15" or clean == "ex_15" or clean == "ex_245" or clean == "ai_rag_hebar" or name == "verlet_raycast_arena" or clean == "16_autonomous_boids_and_behavior_tree_showcase": ret "ex_245_ai_hebar_referee_flow_corridor_window"
  if clean == "250" or clean == "16" or clean == "ex_16" or clean == "ex_250" or clean == "mechanics_capstone" or clean == "boids_behavior_tree": ret "ex_250_mechanics_full_capstone_application_window"

  mut isAllDigits = true
  mut cIdx = 0
  while cIdx < clean.len:
    let ch = clean.charAt(cIdx)
    if ch < "0" or ch > "9":
      isAllDigits = false
      break
    cIdx += 1

  let home = getAiplHomeDir()
  let exDir = if isDir("examples"): "examples" else: home + "/examples"

  if isAllDigits and clean.len > 0:
    let padded = if clean.len == 1: "00" + clean elif clean.len == 2: "0" + clean else: clean
    let pfx = "ex_" + padded + "_"
    if isDir(exDir):
      let ents = listDir(exDir)
      mut ei = 0
      while ei < ents.len:
        let ent = ents[ei]
        if ent.startsWith(pfx) and ent.endsWith(".aipl"):
          ret ent.replace(".aipl", "")
        ei += 1

  ret clean

pub fn findExampleTestFile(progName: str): str:
  let home = getAiplHomeDir()
  let tstDir = if isDir(home + "/tests/examples"): home + "/tests/examples" else: "tests/examples"
  let c1 = tstDir + "/" + progName + "_test.aipl"
  let c2 = tstDir + "/" + progName + ".aipl"
  if fileExists(c1):
    ret c1
  if fileExists(c2):
    ret c2

  if isDir(tstDir):
    let ents = listDir(tstDir)
    let pfx1 = progName + "_"
    let pfx2 = "ex_" + progName + "_"
    mut ei = 0
    while ei < ents.len:
      let ent = ents[ei]
      if ent.endsWith(".aipl") and (ent.startsWith(pfx1) or ent.startsWith(pfx2) or ent.contains(progName)):
        ret tstDir + "/" + ent
      ei += 1
  ret ""

pub fn cmdExamples(cliArgs: [str]): int:
  let home = getAiplHomeDir()
  let exDir = home + "/examples"

  mut subCmd = ""
  mut target = ""
  mut isRun = false
  mut isTest = false
  mut extraFlags: [str] = []
  mut i = 1
  while i < cliArgs.len:
    let a = cliArgs[i]
    if a == "--list" or a == "-l":
      subCmd = "list"
    elif a == "--run":
      isRun = true
    elif a == "--test":
      isTest = true
    elif not a.startsWith("-"):
      if subCmd == "":
        subCmd = a
      elif target == "":
        target = a
      else:
        extraFlags.push(a)
    else:
      extraFlags.push(a)
    i += 1

  if subCmd == "" or subCmd == "list" or subCmd == "--list":
    mut showAll = false
    mut showWindow = false
    mut showCli = false
    mut filterDomain = ""

    mut fi = 0
    while fi < extraFlags.len:
      let f = extraFlags[fi]
      if f == "--all" or f == "-a" or f == "all":
        showAll = true
      elif f == "--window" or f == "-w" or f == "window":
        showWindow = true
      elif f == "--cli" or f == "-c" or f == "cli":
        showCli = true
      elif not f.startsWith("-"):
        filterDomain = f
      fi += 1

    if target == "--all" or target == "-a" or target == "all":
      showAll = true
    elif target == "--window" or target == "-w" or target == "window":
      showWindow = true
    elif target == "--cli" or target == "-c" or target == "cli":
      showCli = true
    elif target != "" and not target.startsWith("-"):
      filterDomain = target

    let searchDir = if isDir(exDir): exDir else: "examples"
    if showAll or showWindow or showCli or filterDomain.len > 0:
      if not isDir(searchDir):
        println("Error: examples directory not found at " + searchDir)
        ret 1
      let rawEnts = listDir(searchDir)
      mut exFiles: [str] = []
      mut ei = 0
      while ei < rawEnts.len:
        let ent = rawEnts[ei]
        if ent.endsWith(".aipl") and not ent.startsWith("."):
          exFiles.push(ent)
        ei += 1

      mut si = 0
      while si < exFiles.len:
        mut sj = si + 1
        while sj < exFiles.len:
          if exFiles[sj] < exFiles[si]:
            let tmp = exFiles[si]
            exFiles[si] = exFiles[sj]
            exFiles[sj] = tmp
          sj += 1
        si += 1

      mut matchCount = 0
      mut mIdx = 0
      while mIdx < exFiles.len:
        let fnm = exFiles[mIdx]
        let isWin = fnm.endsWith("_window.aipl")
        let badge = if isWin: "[WINDOW]" else: "[CLI]   "
        mut include = false
        if showAll:
          include = true
        elif showWindow and isWin:
          include = true
        elif showCli and not isWin:
          include = true
        elif filterDomain.len > 0 and fnm.toLowerCase().contains(filterDomain.toLowerCase()):
          include = true

        if include:
          println("  " + badge + " " + fnm.replace(".aipl", ""))
          matchCount += 1
        mIdx += 1

      println("")
      if showWindow:
        println("Total Interactive Window Examples: " + str(matchCount))
      elif showCli:
        println("Total Standalone CLI Examples: " + str(matchCount))
      else:
        println("Total Filtered Examples: " + str(matchCount))
      ret 0

    println("================================================================================")
    println("               AIPL Curated Example Programs Explorer (263 Programs)            ")
    println("================================================================================")
    println("")
    println("AIPL provides 263 verified curriculum examples pairing every program in")
    println("`examples/ex_XXX_*.aipl` with its twin test `tests/examples/ex_XXX_*_test.aipl`.")
    println("")
    println("DOMAIN RANGES & CURRICULUM HIGHLIGHTS:")
    println("  [01] Language Basics & Primitives (ex_001..ex_010, 10 CLI)")
    println("       Highlight: ex_001_hello_world_and_io_cli (Core types, streams, Option A)")
    println("  [02] System & Host Capabilities (ex_011..ex_017, 7 CLI)")
    println("       Highlight: ex_011_sys_syscall_and_os_probe_cli (POSIX & syscall probes)")
    println("  [03] Runtime & Execution Context (ex_018..ex_021, 3 CLI, 1 Window)")
    println("       Highlight: ex_021_rt_canvas_x11_window (Direct X11/Wayland canvas surface)")
    println("  [04] Allocators & Memory Arenas (ex_022..ex_026, 5 CLI)")
    println("       Highlight: ex_022_alloc_arena_bump_profiler_cli (Linear bump arena allocator)")
    println("  [05] Mathematics & DSP (ex_027..ex_042, 14 CLI, 2 Window)")
    println("       Highlight: ex_041_math_complex_and_fft_spectrum_cli (Cooley-Tukey FFT)")
    println("  [06] Collections & Data Structures (ex_043..ex_055, 11 CLI, 2 Window)")
    println("       Highlight: ex_051_collections_graph_dijkstra_mst_cli (Dijkstra & Kruskal)")
    println("  [07] Formatting & Unicode (ex_056..ex_059, 4 CLI)")
    println("       Highlight: ex_059_fmt_unicode_utf8_inspector_cli (UTF-8 codepoint parser)")
    println("  [08] Regular Expressions (ex_060..ex_063, 4 CLI)")
    println("       Highlight: ex_062_regex_text_diff_myers_patch_cli (Myers O(ND) diff)")
    println("  [09] Time & Chronometry (ex_064..ex_069, 5 CLI, 1 Window)")
    println("       Highlight: ex_069_time_frame_pacer_hud_window (Delta-time accumulator HUD)")
    println("  [10] Encoding & Serialization (ex_070..ex_081, 10 CLI, 2 Window)")
    println("       Highlight: ex_070_encoding_json_jq_query_cli (RFC 8259 JSON & pointer)")
    println("  [11] Compression & Archival (ex_082..ex_086, 5 CLI)")
    println("       Highlight: ex_082_compress_deflate_huffman_cli (Deflate & Huffman trees)")
    println("  [12] Cryptography & Hashes (ex_087..ex_092, 6 CLI)")
    println("       Highlight: ex_090_crypto_aead_chacha20_poly1305_cli (ChaCha20-Poly1305)")
    println("  [13] Databases & Persistence (ex_093..ex_094, 2 CLI)")
    println("       Highlight: ex_094_db_kv_wal_acid_store_cli (Append-only WAL ACID store)")
    println("  [14] I/O Streams & Pipes (ex_095..ex_098, 4 CLI)")
    println("       Highlight: ex_098_io_copy_and_stream_pipe_cli (Buffered streaming pipes)")
    println("  [15] File System & Watchers (ex_099..ex_103, 5 CLI)")
    println("       Highlight: ex_103_fs_watch_hot_reload_cli (Inotify file change debouncer)")
    println("  [16] Operating System & Environment (ex_104..ex_109, 6 CLI)")
    println("       Highlight: ex_104_os_cli_args_subcommands_cli (Declarative CliApp parser)")
    println("  [17] Synchronization Primitives (ex_110..ex_114, 5 CLI)")
    println("       Highlight: ex_114_sync_channel_mpmc_pipeline_cli (Bounded MPMC ringbuffer)")
    println("  [18] Threading & Job Systems (ex_115..ex_117, 3 CLI)")
    println("       Highlight: ex_115_thread_job_system_work_stealing_cli (Chase-Lev deque)")
    println("  [19] Networking & Protocols (ex_118..ex_126, 9 CLI)")
    println("       Highlight: ex_126_net_rpc_jsonrpc2_dispatcher_cli (JSON-RPC 2.0 service)")
    println("  [20] Testing & Verification (ex_127..ex_130, 4 CLI)")
    println("       Highlight: ex_130_test_fuzz_and_property_shrinker_cli (Property shrinker)")
    println("  [21] Windowing & Events (ex_131..ex_135, 5 Window)")
    println("       Highlight: ex_131_window_app_loop_fixed_timestep_window (Fixed timestep)")
    println("  [22] Input & Shortcuts (ex_136..ex_141, 6 Window)")
    println("       Highlight: ex_141_input_action_map_rebind_menu_window (Action rebinding)")
    println("  [23] Asset Loading (ex_142..ex_147, 6 Window)")
    println("       Highlight: ex_142_asset_image_decoder_qoi_bmp_ppm_window (QOI decoder)")
    println("  [24] Audio & Synthesis (ex_148..ex_153, 6 Window)")
    println("       Highlight: ex_148_audio_synth_oscillators_and_adsr_window (ADSR synth)")
    println("  [25] Core Graphics (ex_154..ex_161, 8 Window)")
    println("       Highlight: ex_161_gfx_postfx_bloom_tonemap_crt_window (Bloom & CRT FX)")
    println("  [26] 2D Vector & Skeletal (ex_162..ex_172, 11 Window)")
    println("       Highlight: ex_172_gfx2d_skeletal2d_ik_bone_rig_window (CCD-IK bone rig)")
    println("  [27] 3D Primitives & Frustum (ex_173..ex_182, 10 Window)")
    println("       Highlight: ex_176_gfx3d_cull3d_frustum_and_occlusion_window (Frustum)")
    println("  [28] Particle Systems (ex_183..ex_189, 7 Window)")
    println("       Highlight: ex_189_particle_gpu_compute_ten_thousand_window (10,000 pts)")
    println("  [29] UI & Flexbox Layout (ex_190..ex_201, 12 Window)")
    println("       Highlight: ex_190_ui_layout_flexbox_and_grid_solver_window (Flexbox)")
    println("  [30] Entity Component System (ex_202..ex_207, 6 Window)")
    println("       Highlight: ex_202_ecs_entity_generational_arena_window (ABA-safe ECS)")
    println("  [31] Spatial Partitioning (ex_208..ex_215, 8 Window)")
    println("       Highlight: ex_208_spatial_ortho_tile_world2d_window (Orthogonal tilemap)")
    println("  [32] 2D Rigid-Body Physics (ex_216..ex_223, 8 Window)")
    println("       Highlight: ex_216_phys2d_rigid_body_gravity_stacks_window (Symplectic)")
    println("  [33] 3D Physics & Tensors (ex_224..ex_230, 7 Window)")
    println("       Highlight: ex_224_phys3d_rigid_body_inertia_tensors_window (Inertia)")
    println("  [34] Procedural Generation (ex_231..ex_237, 7 Window)")
    println("       Highlight: ex_231_procgen_noise_perlin_simplex_worley_window (Noise)")
    println("  [35] AI & HEBAR Referees (ex_238..ex_245, 8 Window)")
    println("       Highlight: ex_245_ai_hebar_referee_flow_corridor_window (Wilson 85%)")
    println("  [36] Capstone Mechanics (ex_246..ex_250, 5 Window)")
    println("       Highlight: ex_250_mechanics_full_capstone_application_window (Full-stack)")
    println("  [37] Continuous 2.5D/3D World, ARPG Lighting & 8-Dir Rigs (ex_251..ex_263, 13 Window)")
    println("       Highlight: ex_262_dark_fantasy_encampment_arpg_window & ex_263_isometric_8dir_rig_and_lighting_lab_window")
    println("")
    println("Total: 263 programs (118 CLI, 145 Window).")
    println("")
    println("COMMANDS:")
    println("  aipl examples list --all                             # List all 263 programs")
    println("  aipl examples list --window                          # Filter 145 window programs")
    println("  aipl examples list --cli                             # Filter 118 CLI programs")
    println("  aipl examples search <query>                         # Search 263 examples")
    println("  aipl examples show <id|name> [--test]                # View source or twin test")
    println("  aipl examples test <id|name>                         # Execute twin test suite")
    println("  aipl examples run <id|name> [-v|--verbose]           # Run example program")
    ret 0

  if subCmd == "search":
    if target == "":
      println("Usage: aipl examples search <query>")
      ret 1
    let searchDir = if isDir(exDir): exDir else: "examples"
    if not isDir(searchDir):
      println("Error: examples directory not found at " + searchDir)
      ret 1
    let rawEnts = listDir(searchDir)
    mut exFiles: [str] = []
    mut ei = 0
    while ei < rawEnts.len:
      let ent = rawEnts[ei]
      if ent.endsWith(".aipl") and not ent.startsWith("."):
        exFiles.push(ent)
      ei += 1

    mut si = 0
    while si < exFiles.len:
      mut sj = si + 1
      while sj < exFiles.len:
        if exFiles[sj] < exFiles[si]:
          let tmp = exFiles[si]
          exFiles[si] = exFiles[sj]
          exFiles[sj] = tmp
        sj += 1
      si += 1

    println("================================================================================")
    println("Curated Examples Search Results for: '" + target + "'")
    println("================================================================================")
    mut found = 0
    mut mIdx = 0
    while mIdx < exFiles.len:
      let fnm = exFiles[mIdx]
      let isWin = fnm.endsWith("_window.aipl")
      let badge = if isWin: "[WINDOW]" else: "[CLI]   "
      let fullEx = pathJoin(exDir, fnm)
      let exContent = readFile(fullEx)
      let exHeadLen = if exContent.len < 2500: exContent.len else: 2500
      let exHaystack = fnm + " " + exContent.slice(0, exHeadLen)
      if exHaystack.toLowerCase().contains(target.toLowerCase()):
        println("  " + badge + " " + fnm.replace(".aipl", ""))
        found += 1
      mIdx += 1

    println("")
    println("Matches found: " + str(found))
    ret 0

  if subCmd == "test":
    if target == "":
      println("Usage: aipl examples test <id|name>")
      ret 1
    let resolvedName = resolveExampleName(target)
    let tstFile = findExampleTestFile(resolvedName)
    if tstFile == "" or not fileExists(tstFile):
      println("Error: twin test for '" + target + "' not found.")
      ret 1
    println("Executing twin test: " + tstFile)
    ret cmdTest(["test", tstFile])

  mut progName = subCmd
  if subCmd == "show":
    if target == "":
      println("Usage: aipl examples show <name> [--test]")
      ret 1
    progName = target
  elif subCmd == "run":
    if target == "":
      println("Usage: aipl examples run <name> [-v|--verbose]")
      ret 1
    progName = target
    isRun = true

  progName = resolveExampleName(progName)

  if isTest:
    let tstFile = findExampleTestFile(progName)
    if tstFile == "" or not fileExists(tstFile):
      println("Error: twin test for '" + progName + "' not found.")
      ret 1
    println("// ============================================================================")
    println("// AIPL Twin Example Test: " + progName + " (" + tstFile + ")")
    println("// ============================================================================")
    println("")
    println(readFile(tstFile))
    ret 0

  let rawFile = if progName.endsWith(".aipl"): progName else: progName + ".aipl"
  mut resolved = exDir + "/" + rawFile
  if not fileExists(resolved):
    if fileExists("examples/" + rawFile):
      resolved = "examples/" + rawFile
    elif fileExists(home + "/poc/" + progName + "/" + rawFile):
      resolved = home + "/poc/" + progName + "/" + rawFile
    elif fileExists("poc/" + progName + "/" + rawFile):
      resolved = "poc/" + progName + "/" + rawFile
    elif fileExists(home + "/aipl_hebar_bot/demos/" + rawFile):
      resolved = home + "/aipl_hebar_bot/demos/" + rawFile
    elif fileExists("aipl_hebar_bot/demos/" + rawFile):
      resolved = "aipl_hebar_bot/demos/" + rawFile
    elif fileExists(rawFile):
      resolved = rawFile
    else:
      let pfx1 = "ex_" + progName + "_"
      let pfx2 = progName + "_"
      mut matched = ""
      let searchDir = if isDir(exDir): exDir else: "examples"
      if isDir(searchDir):
        let entries = listDir(searchDir)
        mut ei = 0
        while ei < entries.len:
          let ent = entries[ei]
          if ent.endsWith(".aipl") and (ent.startsWith(pfx1) or ent.startsWith(pfx2)):
            matched = searchDir + "/" + ent
            break
          ei += 1
      if matched != "":
        resolved = matched
        progName = pathBasename(matched).replace(".aipl", "")
      else:
        println("Error: example program '" + progName + "' not found in " + exDir)
        ret 1

  if isRun:
    mut fwdArgs: [str] = ["run", resolved]
    mut efi = 0
    while efi < extraFlags.len:
      fwdArgs.push(extraFlags[efi])
      efi += 1
    ret cmdRun(fwdArgs)

  println("// ============================================================================")
  println("// AIPL Example: " + progName + " (" + resolved + ")")
  println("// ============================================================================")
  println("")
  println(readFile(resolved))
  ret 0

pub fn cmdShield(cliArgs: [str]): int:
  if cliArgs.len < 2:
    println("Usage: aipl shield <lock|unlock|verify|rehash>")
    ret 1

  let subcmd = cliArgs[1]
  let manifestPath = ".aipl/manifest.sha256"
  if not fileExists(manifestPath):
    println("Error: Manifest file '" + manifestPath + "' not found.")
    ret 1

  let content = readFile(manifestPath)
  let lines = content.split("\n")

  if subcmd == "verify":
    mut mismatches = 0
    mut li = 0
    while li < lines.len:
      let line = lines[li]
      if not line.startsWith("#") and line.len >= 66:
        let expectedHash = line.slice(0, 64)
        let relPath = line.slice(66, line.len).trim()
        if not fileExists(relPath):
          println("Missing SSOT file: " + relPath)
          mismatches += 1
        else:
          let fileBytes = readFile(relPath)
          let actualHash = sha256(fileBytes)
          if actualHash != expectedHash:
            println("Hash mismatch in SSOT file: " + relPath)
            mismatches += 1
      li += 1
    if mismatches == 0:
      println("All SSOT files match cryptographic manifest and chmod 0444 locks.")
      ret 0
    else:
      println("Shield verification failed: " + str(mismatches) + " file(s) modified or missing.")
      ret 1

  if subcmd == "lock":
    mut li = 0
    while li < lines.len:
      let line = lines[li]
      if not line.startsWith("#") and line.len >= 66:
        let relPath = line.slice(66, line.len).trim()
        if fileExists(relPath):
          let _ = execCommand("chmod", ["0444", relPath])
      li += 1
    println("All SSOT files locked (chmod 0444).")
    ret 0

  if subcmd == "unlock":
    mut li = 0
    while li < lines.len:
      let line = lines[li]
      if not line.startsWith("#") and line.len >= 66:
        let relPath = line.slice(66, line.len).trim()
        if fileExists(relPath):
          let _ = execCommand("chmod", ["0644", relPath])
      li += 1
    println("All SSOT files unlocked (chmod 0644).")
    ret 0

  if subcmd == "rehash":
    mut newLines: [str] = []
    mut li = 0
    while li < lines.len:
      let line = lines[li]
      if line.startsWith("#") or line.len < 66:
        newLines.push(line)
      else:
        let relPath = line.slice(66, line.len).trim()
        if fileExists(relPath):
          let actualHash = sha256(readFile(relPath))
          newLines.push(actualHash + "  " + relPath)
        else:
          newLines.push(line)
      li += 1
    writeFile(manifestPath, newLines.join("\n") + "\n")
    println("Manifest rehashed successfully.")
    ret 0

  println("Unknown shield subcommand: '" + subcmd + "'. Expected lock, unlock, verify, or rehash.")
  ret 1

// Returns the index of the next validated function shard marker ("\n/* AIPL Function: X */"
// immediately followed by "\nAiplVal aipl_fn_"), or -1.
fn nextCFunctionMarker(src: str, from: int): int:
  mut p = from
  while p >= 0 and p < src.len:
    let m = src.indexOf("\n/* AIPL Function: ", p)
    if m < 0:
      ret -1
    let eol = src.indexOf("\n", m + 1)
    if eol > m and (src.slice(eol, eol + 17) == "\nAiplVal aipl_fn_" or src.slice(eol, eol + 38) == "\n__attribute__((hot)) AiplVal aipl_fn_"):
      ret m
    p = m + 1
  ret -1

// Phase 18.4: splits the fixed-point stage-2 C into compiler/bootstrap/shards/common.h plus
// `shardCount` contiguous, size-balanced mod_NN.c files (all small enough for fast parallel cc).
// Cold start without any aipl binary: compiler/bootstrap/build.sh.
pub fn writeBootstrapShards(cSource: str, outDir: str, shardCount: int): Result[int, str]:
  let first = nextCFunctionMarker(cSource, 0)
  if first < 0:
    ret Err("no function markers found in bootstrap C source")
  mut tailPos = -1
  mut scan = first
  while scan >= 0:
    let t = cSource.indexOf("\nstatic void aipl_rt_init_globals(void) {", scan)
    if t < 0:
      scan = -1
    else:
      tailPos = t + 1
      scan = t + 1
  if tailPos < 0:
    ret Err("no aipl_rt_init_globals tail found in bootstrap C source")
  mut starts: [int] = []
  mut cur = first + 1
  while cur >= 0 and cur < tailPos:
    starts.push(cur)
    let nxt = nextCFunctionMarker(cSource, cur + 18)
    cur = if nxt < 0 or nxt + 1 > tailPos: -1 else: nxt + 1
  starts.push(tailPos)
  // Stage every file in a sibling directory first, then swap it in, so a failure part-way never
  // leaves shards from two generations (and stale mod_*.c from older layouts are removed).
  let stageDir = outDir + ".staging"
  let _mk = execCommand("mkdir", ["-p", outDir, stageDir])
  mut written: [str] = []
  let header = "/* AIPL bootstrap shard common prefix (generated by `aipl bootstrap`; do not edit). */\n#ifndef AIPL_BOOTSTRAP_COMMON_H\n#define AIPL_BOOTSTRAP_COMMON_H\n" + cSource.slice(0, first + 1) + "\n#endif /* AIPL_BOOTSTRAP_COMMON_H */\n"
  writeFile(pathJoin(stageDir, "common.h"), header)
  written.push("common.h")
  let n = if shardCount > 0: shardCount else: 16
  mut si = 0
  mut shard = 0
  while shard < n:
    mut parts: [str] = []
    parts.push("/* AIPL bootstrap shard " + str(shard) + " (generated by `aipl bootstrap`; do not edit). */\n#include \"common.h\"\n")
    // Re-balance against what is left so oversized functions early on never starve later shards.
    let remainingBytes = tailPos - (if si < starts.len - 1: starts[si] else: tailPos)
    let target = remainingBytes / (n - shard)
    mut acc = 0
    while si < starts.len - 1 and (acc == 0 or acc + (starts[si + 1] - starts[si]) / 2 <= target or shard == n - 1):
      let segLen = starts[si + 1] - starts[si]
      parts.push(cSource.slice(starts[si], starts[si + 1]))
      acc += segLen
      si += 1
    if shard == n - 1:
      parts.push(cSource.slice(tailPos, cSource.len))
    let name = if shard < 10: "mod_0" + str(shard) + ".c" else: "mod_" + str(shard) + ".c"
    writeFile(pathJoin(stageDir, name), parts.join(""))
    written.push(name)
    shard += 1
  mut wi = 0
  while wi < written.len:
    if not fileExists(pathJoin(stageDir, written[wi])):
      ret Err("failed to write bootstrap shard " + written[wi] + " into " + stageDir)
    wi += 1
  let olds = listDir(outDir)
  mut oi = 0
  while oi < olds.len:
    let base = pathBasename(olds[oi])
    if (base.startsWith("mod_") and base.endsWith(".c")) or base == "common.h":
      let _rmo = removeFile(pathJoin(outDir, base))
    oi += 1
  wi = 0
  while wi < written.len:
    let _mv = execCommand("mv", ["-f", pathJoin(stageDir, written[wi]), pathJoin(outDir, written[wi])])
    wi += 1
  let _rd = execCommand("rmdir", [stageDir])
  ret Ok(n)

pub fn cmdBootstrap(): int:
  let cpus = getCpuCount()
  println("Executing AIPL 3-stage self-hosting bootstrap verification...")
  println("[Bootstrap] Saturating all " + toString(cpus) + " CPU cores...")

  // Stage 1: the running compiler emits modular C (#include <aipl_runtime.h>) in-process.
  let rep1 = compileFile("compiler/main.aipl")
  if not rep1.valid:
    println("Bootstrap Stage 1 compilation failed with diagnostics.")
    ret 1
  let cCode1 = emitCSource(rep1.hir, rep1.bundledSource)
  writeFile("/tmp/aipl-bootstrap-stage1.c", cCode1)

  // Stage 1 compilation: multi-core sharded cc (-O1) linked against libaipl_rt.a
  let ccRes1 = compileCWithRuntime(cCode1, "/tmp/aipl-bootstrap-stage1", "-O1", false)
  if ccRes1.isErr():
    println("Bootstrap Stage 1 host cc compilation failed: " + ccRes1.unwrapErr())
    ret 1
  println("Stage 1 binary compiled.")

  // Stage 2 transpilation via Stage 1 binary
  let s1Res = execCommand("/tmp/aipl-bootstrap-stage1", ["build", "compiler/main.aipl", "--c-modular", "-o", "/tmp/aipl-bootstrap-stage2.c"])
  if s1Res.isErr() or s1Res.unwrap().status != 0:
    println("Bootstrap Stage 2 transpilation via Stage 1 binary failed.")
    if s1Res.isErr():
      println("  Error: " + s1Res.unwrapErr())
    else:
      let po = s1Res.unwrap()
      println("  Status: " + str(po.status))
      println("  Stdout: " + po.stdout)
      println("  Stderr: " + po.stderr)
    ret 1
  let s2c = readFile("/tmp/aipl-bootstrap-stage2.c")

  // Stage 2 compilation with -O2
  let ccRes2 = compileCWithRuntime(s2c, "/tmp/aipl-bootstrap-stage2", "-O2", false)
  if ccRes2.isErr():
    println("Bootstrap Stage 2 host cc compilation failed: " + ccRes2.unwrapErr())
    ret 1
  println("Stage 2 binary compiled.")

  // Stage 3 transpilation via Stage 2 binary
  let s2Res = execCommand("/tmp/aipl-bootstrap-stage2", ["build", "compiler/main.aipl", "--c-modular", "-o", "/tmp/aipl-bootstrap-stage3.c"])
  if s2Res.isErr() or s2Res.unwrap().status != 0:
    println("Bootstrap Stage 3 transpilation via Stage 2 binary failed.")
    if s2Res.isErr():
      println("  Error: " + s2Res.unwrapErr())
    else:
      let po = s2Res.unwrap()
      println("  Status: " + str(po.status))
      println("  Stdout: " + po.stdout)
      println("  Stderr: " + po.stderr)
    ret 1
  let s3c = readFile("/tmp/aipl-bootstrap-stage3.c")

  let hash2 = sha256(s2c)
  let hash3 = sha256(s3c)
  if hash2 == hash3:
    println("Bootstrap fixed-point verified: sha256(stage2) == sha256(stage3)")
    println("[PASS] 3-Stage Bootstrap Fixed-Point Verified! (SHA256: " + hash2 + ")")
    let shardRes = writeBootstrapShards(s2c, "compiler/bootstrap/shards", 16)
    if shardRes.isErr():
      println("Bootstrap shard emission failed: " + shardRes.unwrapErr())
      ret 1
    println("Bootstrap shards written: compiler/bootstrap/shards/ (common.h + mod_00..mod_15.c)")
    // Phase 18.4: the monolithic seed C file and seed binary are retired.
    if fileExists("compiler/bootstrap/aipl_bootstrap.c"):
      let _rmc = removeFile("compiler/bootstrap/aipl_bootstrap.c")
    if fileExists("compiler/bootstrap/aipl_bootstrap"):
      let _rmb = removeFile("compiler/bootstrap/aipl_bootstrap")

    let _ = execCommand("cp", ["--remove-destination", "/tmp/aipl-bootstrap-stage2", "bin/aipl"])
    let _ = execCommand("chmod", ["+x", "bin/aipl"])
    let envSkipGlobal = getEnv("AIPL_SKIP_GLOBAL_INSTALL")
    if not (envSkipGlobal.isSome() and envSkipGlobal.unwrap() == "1"):
      let _ = cmdInstallGlobal([])
    let _rm1 = removeFile("/tmp/aipl-bootstrap-stage1")
    let _rm2 = removeFile("/tmp/aipl-bootstrap-stage1.c")
    let _rm3 = removeFile("/tmp/aipl-bootstrap-stage2")
    let _rm4 = removeFile("/tmp/aipl-bootstrap-stage2.c")
    let _rm5 = removeFile("/tmp/aipl-bootstrap-stage3.c")
    ret 0
  else:
    println("Bootstrap verification failed: hash mismatch!")
    println("  Stage 2 SHA-256: " + hash2)
    println("  Stage 3 SHA-256: " + hash3)
    ret 1

pub fn cmdInspect(cliArgs: [str]): int:
  if cliArgs.len < 2:
    println("Usage: aipl inspect <binary>")
    ret 1
  let bRes = readBytes(cliArgs[1])
  if bRes.isErr():
    println("Failed to read binary: " + bRes.unwrapErr())
    ret 1
  let meta = inspectAiplStndBinary(bRes.unwrap())
  if not meta.hasTrailer:
    println("No AIPLSTND trailer found.")
    ret 1
  println("AIPLSTND Binary Verified: payload=" + str(meta.payloadLen) + " bytes, format=" + str(meta.formatVersion))
  ret 0

pub fn cmdOutline(cliArgs: [str]): int:
  mut file = ""
  mut jsonMode = false
  mut i = 1
  while i < cliArgs.len:
    let a = cliArgs[i]
    if a == "--json":
      jsonMode = true
    elif not a.startsWith("-") and file == "":
      file = a
    i += 1

  if file == "":
    println("Usage: aipl outline <file.aipl> [--json]")
    ret 1

  if not fileExists(file):
    println("Error: file '" + file + "' does not exist.")
    ret 1

  let src = readFile(file)
  let toks = tokenizeAipl(src, 0)
  let arena = parseModule(toks, src)

  if jsonMode:
    mut symItems: [str] = []
    mut di = 0
    while di < arena.decls.len:
      let d = arena.decls[di]
      let isPubStr = if d.isPub: "true" else: "false"
      let item = "{\"name\":\"" + d.name + "\",\"kind\":\"" + d.kind + "\",\"line\":" + str(d.span.line) + ",\"isPub\":" + isPubStr + "}"
      symItems.push(item)
      di += 1
    let escOutFile = file.replace("\\", "\\\\").replace("\"", "\\\"")
    println("{\"file\":\"" + escOutFile + "\",\"module\":\"" + arena.moduleName + "\",\"symbols\":[" + symItems.join(",") + "]}")
  else:
    println("Module " + arena.moduleName + " (" + file + "):")
    mut di = 0
    while di < arena.decls.len:
      let d = arena.decls[di]
      let pubStr = if d.isPub: "pub " else: ""
      println("  " + pubStr + d.kind + " " + d.name + " (line " + str(d.span.line) + ")")
      di += 1
  ret 0

pub fn cmdSplice(cliArgs: [str]): int:
  if cliArgs.len < 4:
    println("Usage: aipl splice <file.aipl> <symbol> <replacement.aipl>")
    ret 1

  let targetFile = cliArgs[1]
  let symbol = cliArgs[2]
  let replacementFile = cliArgs[3]

  if not fileExists(targetFile):
    println("Error: target file '" + targetFile + "' does not exist.")
    ret 1
  if not fileExists(replacementFile):
    println("Error: replacement file '" + replacementFile + "' does not exist.")
    ret 1

  let origSrc = readFile(targetFile)
  let replSrc = readFile(replacementFile)

  let lines = origSrc.split("\n")
  mut startLine = -1
  mut endLine = -1

  mut li = 0
  while li < lines.len:
    let l = lines[li]
    let t = l.trim()
    let isMatch = (t.startsWith("fn " + symbol) or t.startsWith("pub fn " + symbol) or
                  t.startsWith("struct " + symbol) or t.startsWith("pub struct " + symbol) or
                  t.startsWith("enum " + symbol) or t.startsWith("pub enum " + symbol) or
                  t.startsWith("type " + symbol) or t.startsWith("pub type " + symbol) or
                  t.startsWith("const " + symbol) or t.startsWith("pub const " + symbol))
    if isMatch and (l.startsWith("fn ") or l.startsWith("pub fn ") or l.startsWith("struct ") or l.startsWith("pub struct ") or l.startsWith("enum ") or l.startsWith("pub enum ") or l.startsWith("type ") or l.startsWith("pub type ") or l.startsWith("const ") or l.startsWith("pub const ")):
      startLine = li
      mut scan = li + 1
      while scan < lines.len:
        let sl = lines[scan]
        if sl.len > 0 and (sl.charCodeAt(0) != 32 and sl.charCodeAt(0) != 9):
          let st = sl.trim()
          if st.startsWith("pub fn ") or st.startsWith("fn ") or st.startsWith("pub struct ") or st.startsWith("struct ") or st.startsWith("pub enum ") or st.startsWith("enum ") or st.startsWith("module ") or st.startsWith("type ") or st.startsWith("pub type ") or st.startsWith("const ") or st.startsWith("pub const "):
            break
        scan += 1
      endLine = scan
      break
    li += 1

  if startLine == -1:
    println("Error: symbol '" + symbol + "' not found in '" + targetFile + "'.")
    ret 1

  mut newLines: [str] = []
  mut i = 0
  while i < startLine:
    newLines.push(lines[i])
    i += 1
  newLines.push(replSrc.trim())
  mut j = endLine
  while j < lines.len:
    newLines.push(lines[j])
    j += 1

  let merged = newLines.join("\n")
  let formatted = formatAiplSource(merged)
  writeFile(targetFile, formatted)
  println("Spliced symbol '" + symbol + "' in '" + targetFile + "'.")
  ret 0

pub fn buildAgentPromptPack(): str:
  mut lines: [str] = []
  lines.push("# AIPL Compact Agent Prompt Pack (<4K Tokens)")
  lines.push("- Syntax: 2-space indentation blocks (`:`), `let` (immutable), `mut` (mutable), `fn name(a: int): int:`, `ret expr`.")
  lines.push("- Types: `int`, `float`, `str`, `bool`, `bytes`, `[T]`, `Map[K, V]`, `Set[T]`, `Option[T]` (`?T`), `Result[T, E]` (`T!E`).")
  lines.push("- Contracts: `requires <pred> ensures <pred>:` on functions; `invariant <pred>` and `decreases <expr>` in loops.")
  lines.push("- UFCS Collections: `arr.map(x => x * 2)`, `arr.filter(...)`, `arr.fold(0, (a, b) => a + b)`, `map.set(k, v)`, `map.get(k)`, `map.has(k)`, `map.delete(k)`.")
  lines.push("- CLI: `aipl run <file.aipl>`, `aipl test <file_or_dir>`, `aipl verify <file.aipl> [--json] [--stream-prefix]`, `aipl wire <file.aipl> <symbol> <replacement.aipl>`.")
  ret lines.join("\n")

pub fn cmdWire(cliArgs: [str]): int:
  if cliArgs.len < 4:
    println("Usage: aipl wire <file.aipl> <symbol> <replacement.aipl>")
    ret 1
  let targetFile = cliArgs[1]
  if not fileExists(targetFile):
    println("Error: target file '" + targetFile + "' does not exist.")
    ret 1
  let backupSrc = canonicalizeAiplFileOnDisk(targetFile)
  let rc = cmdSplice(cliArgs)
  if rc != 0:
    ret rc
  let report = compileFile(targetFile)
  if not report.valid:
    writeFile(targetFile, backupSrc)
    println("Wire rolled back: verification failed after splicing '" + cliArgs[2] + "' in '" + targetFile + "'.")
    ret 1
  println("Wired and verified symbol '" + cliArgs[2] + "' in '" + targetFile + "'.")
  ret 0

pub fn cmdTokens(cliArgs: [str]): int:
  mut file = ""
  mut jsonMode = false
  mut i = 1
  while i < cliArgs.len:
    let a = cliArgs[i]
    if a == "--json":
      jsonMode = true
    elif not a.startsWith("-") and file == "":
      file = a
    i += 1

  if file == "":
    println("Usage: aipl tokens <file.aipl> [--json]")
    ret 1

  if not fileExists(file):
    println("Error: file '" + file + "' does not exist.")
    ret 1

  let src = readFile(file)
  let toks = tokenizeAipl(src, 0)

  if jsonMode:
    mut tItems: [str] = []
    mut ti = 0
    while ti < toks.len:
      let t = toks[ti]
      let escapedLex = t.lexeme.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
      let item = "{\"kind\":\"" + t.kind + "\",\"lexeme\":\"" + escapedLex + "\",\"line\":" + str(t.span.line) + ",\"column\":" + str(t.span.column) + "}"
      tItems.push(item)
      ti += 1
    println("[" + tItems.join(",") + "]")
  else:
    mut ti = 0
    while ti < toks.len:
      let t = toks[ti]
      println("[" + t.kind + "] \"" + t.lexeme + "\" (" + str(t.span.line) + ":" + str(t.span.column) + ")")
      ti += 1
  ret 0

// ============================================================================
// Step 6.2: JSON-RPC 2.0 LSP Daemon & Step 6.3: DAP Interactive Debugger
// ============================================================================

pub fn sendLspMessage(jsonBody: str): void:
  let b = jsonBody.toBytes()
  printInline("Content-Length: " + str(b.len) + "\r\n\r\n" + jsonBody)
  flushStdout()

pub fn sendDapMessage(jsonBody: str): void:
  let b = jsonBody.toBytes()
  printInline("Content-Length: " + str(b.len) + "\r\n\r\n" + jsonBody)
  flushStdout()

pub fn sendDapResponse(seq: int, reqSeq: int, cmd: str, bodyJson: str): int:
  let bodyPart = if bodyJson.len > 0: ",\"body\":" + bodyJson else: ""
  let jsonBody = "{\"seq\":" + str(seq) + ",\"type\":\"response\",\"request_seq\":" + str(reqSeq) + ",\"command\":\"" + cmd + "\",\"success\":true" + bodyPart + "}"
  sendDapMessage(jsonBody)
  ret seq + 1

pub fn sendDapEvent(seq: int, eventName: str, bodyJson: str): int:
  let bodyPart = if bodyJson.len > 0: ",\"body\":" + bodyJson else: ""
  let jsonBody = "{\"seq\":" + str(seq) + ",\"type\":\"event\",\"event\":\"" + eventName + "\"" + bodyPart + "}"
  sendDapMessage(jsonBody)
  ret seq + 1

pub fn extractJsonRpcId(msg: str): str:
  let key = "\"id\""
  let idx = msg.indexOf(key)
  if idx < 0:
    ret "1"
  let colonIdx = msg.indexOf(":", idx + key.len)
  if colonIdx < 0:
    ret "1"
  mut i = colonIdx + 1
  while i < msg.len and (msg.slice(i, i + 1) == " " or msg.slice(i, i + 1) == "\t"):
    i += 1
  if i >= msg.len:
    ret "1"
  if msg.slice(i, i + 1) == "\"":
    let start = i
    let endQuote = msg.indexOf("\"", start + 1)
    if endQuote < 0:
      ret "\"1\""
    ret msg.slice(start, endQuote + 1)
  mut end = i
  while end < msg.len:
    let ch = msg.slice(end, end + 1)
    if ch == "," or ch == "}" or ch == " " or ch == "\r" or ch == "\n":
      break
    end += 1
  let res = msg.slice(i, end).trim()
  if res.len == 0:
    ret "1"
  ret res

pub fn extractJsonStringField(msg: str, key: str): str:
  let needle = "\"" + key + "\""
  let idx = msg.indexOf(needle)
  if idx < 0:
    ret ""
  let colonIdx = msg.indexOf(":", idx + needle.len)
  if colonIdx < 0:
    ret ""
  let quoteStart = msg.indexOf("\"", colonIdx + 1)
  if quoteStart < 0:
    ret ""
  mut i = quoteStart + 1
  mut parts: [str] = []
  while i < msg.len:
    let ch = msg.slice(i, i + 1)
    if ch == "\\":
      if i + 1 < msg.len:
        let nxt = msg.slice(i + 1, i + 2)
        if nxt == "\"":
          parts.push("\"")
        elif nxt == "\\":
          parts.push("\\")
        elif nxt == "n":
          parts.push("\n")
        elif nxt == "r":
          parts.push("\r")
        elif nxt == "t":
          parts.push("\t")
        else:
          parts.push(nxt)
        i += 2
        continue
      else:
        parts.push(ch)
        i += 1
        continue
    if ch == "\"":
      break
    parts.push(ch)
    i += 1
  ret parts.join("")

pub fn extractJsonIntField(msg: str, key: str): int:
  let needle = "\"" + key + "\""
  let idx = msg.indexOf(needle)
  if idx < 0:
    ret 0
  let colonIdx = msg.indexOf(":", idx + needle.len)
  if colonIdx < 0:
    ret 0
  mut i = colonIdx + 1
  while i < msg.len and (msg.slice(i, i + 1) == " " or msg.slice(i, i + 1) == "\t"):
    i += 1
  mut end = i
  while end < msg.len:
    let ch = msg.slice(end, end + 1)
    if (ch >= "0" and ch <= "9") or (ch == "-" and end == i):
      end += 1
    else:
      break
  let numStr = msg.slice(i, end).trim()
  if numStr.len == 0:
    ret 0
  ret parseInt(numStr)

pub fn escapeJsonString(s: str): str:
  ret s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")

pub fn parseBreakpointLines(msg: str): [int]:
  mut res: [int] = []
  mut searchIdx = 0
  let needle = "\"line\""
  while searchIdx < msg.len:
    let idx = msg.indexOf(needle, searchIdx)
    if idx < 0:
      break
    let colonIdx = msg.indexOf(":", idx + needle.len)
    if colonIdx < 0:
      break
    mut i = colonIdx + 1
    while i < msg.len and (msg.slice(i, i + 1) == " " or msg.slice(i, i + 1) == "\t"):
      i += 1
    mut end = i
    while end < msg.len:
      let ch = msg.slice(end, end + 1)
      if ch >= "0" and ch <= "9":
        end += 1
      else:
        break
    let s = msg.slice(i, end).trim()
    if s.len > 0:
      let lineNum = parseInt(s)
      res.push(lineNum)
    searchIdx = idx + needle.len
  ret res

pub fn evaluateLineForLocals(lineStr: str, mut localNames: [str], mut localVals: [str]): void:
  let line = lineStr.trim()
  if line.startsWith("let ") or line.startsWith("mut "):
    let rest = line.slice(4, line.len).trim()
    let eqIdx = rest.indexOf("=")
    if eqIdx > 0:
      mut varPart = rest.slice(0, eqIdx).trim()
      let colonIdx = varPart.indexOf(":")
      if colonIdx > 0:
        varPart = varPart.slice(0, colonIdx).trim()
      let valPart = rest.slice(eqIdx + 1, rest.len).trim()
      mut found = false
      mut k = 0
      while k < localNames.len:
        if localNames[k] == varPart:
          localVals[k] = valPart
          found = true
          break
        k += 1
      if not found:
        localNames.push(varPart)
        localVals.push(valPart)
  elif line.contains(" = ") and not line.startsWith("//") and not line.startsWith("if ") and not line.startsWith("while "):
    let eqIdx = line.indexOf(" = ")
    let varPart = line.slice(0, eqIdx).trim()
    let valPart = line.slice(eqIdx + 3, line.len).trim()
    mut k = 0
    while k < localNames.len:
      if localNames[k] == varPart:
        localVals[k] = valPart
        break
      k += 1

pub fn evaluateLocalsUpTo(srcLines: [str], lineCount: int, mut localNames: [str], mut localVals: [str]): void:
  mut idx = 0
  while idx < srcLines.len and idx < lineCount:
    evaluateLineForLocals(srcLines[idx], localNames, localVals)
    idx += 1

pub struct LspSymbolLocation:
  found: bool
  uri: str
  line: int
  col: int

pub fn getLspDocumentText(uri: str, openUris: [str], openTexts: [str]): str:
  mut idx = openUris.len - 1
  while idx >= 0:
    if openUris[idx] == uri:
      ret openTexts[idx]
    idx -= 1
  mut localPath = uri
  if localPath.startsWith("file://"):
    localPath = localPath.slice(7, localPath.len)
  if fileExists(localPath):
    ret readFile(localPath)
  ret ""

pub fn extractIdentifierAtPosition(text: str, line: int, col: int): str:
  if text.len == 0 or line < 0 or col < 0:
    ret ""
  let lines = text.split("\n")
  if line >= lines.len:
    ret ""
  let l = lines[line]
  if l.len == 0:
    ret ""
  mut targetCol = col
  if targetCol >= l.len:
    targetCol = l.len - 1
  let ch = l.slice(targetCol, targetCol + 1)
  let isTargetIdent = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"
  if not isTargetIdent:
    if targetCol > 0:
      let prevCh = l.slice(targetCol - 1, targetCol)
      if (prevCh >= "a" and prevCh <= "z") or (prevCh >= "A" and prevCh <= "Z") or (prevCh >= "0" and prevCh <= "9") or prevCh == "_":
        targetCol = targetCol - 1
      else:
        ret ""
    else:
      ret ""
  mut start = targetCol
  while start > 0:
    let prev = l.slice(start - 1, start)
    if (prev >= "a" and prev <= "z") or (prev >= "A" and prev <= "Z") or (prev >= "0" and prev <= "9") or prev == "_":
      start -= 1
    else:
      break
  mut end = targetCol
  while end < l.len:
    let nextCh = l.slice(end, end + 1)
    if (nextCh >= "a" and nextCh <= "z") or (nextCh >= "A" and nextCh <= "Z") or (nextCh >= "0" and nextCh <= "9") or nextCh == "_":
      end += 1
    else:
      break
  ret l.slice(start, end).trim()

pub fn findSymbolLocation(uri: str, ident: str, docText: str): LspSymbolLocation:
  if ident.len == 0:
    ret LspSymbolLocation(found = false, uri = "", line = 0, col = 0)

  if docText.len > 0:
    let toks = tokenizeAipl(docText, 0)
    let arena = parseModule(toks, docText)
    let hir = lowerToHir(arena, arena.moduleName)

    mut fi = 0
    while fi < hir.functions.len:
      let f = hir.functions[fi]
      if f.name == ident:
        let sl = if f.span.line > 0: f.span.line - 1 else: 0
        let sc = if f.span.column > 0: f.span.column - 1 else: 0
        ret LspSymbolLocation(found = true, uri = uri, line = sl, col = sc)
      fi += 1

    mut si = 0
    while si < hir.structs.len:
      let st = hir.structs[si]
      if st.name == ident:
        let sl = if st.span.line > 0: st.span.line - 1 else: 0
        let sc = if st.span.column > 0: st.span.column - 1 else: 0
        ret LspSymbolLocation(found = true, uri = uri, line = sl, col = sc)
      si += 1

    mut ei = 0
    while ei < hir.enums.len:
      let en = hir.enums[ei]
      if en.name == ident:
        let sl = if en.span.line > 0: en.span.line - 1 else: 0
        let sc = if en.span.column > 0: en.span.column - 1 else: 0
        ret LspSymbolLocation(found = true, uri = uri, line = sl, col = sc)
      mut vi = 0
      while vi < en.variants.len:
        if en.variants[vi] == ident:
          let sl = if en.span.line > 0: en.span.line - 1 else: 0
          let sc = if en.span.column > 0: en.span.column - 1 else: 0
          ret LspSymbolLocation(found = true, uri = uri, line = sl, col = sc)
        vi += 1
      ei += 1

  let srcLines = docText.split("\n")
  mut li = 0
  while li < srcLines.len:
    let l = srcLines[li].trim()
    if l.startsWith("let " + ident) or l.startsWith("mut " + ident) or l.startsWith("const " + ident) or l.startsWith("fn " + ident) or l.startsWith("pub fn " + ident) or l.startsWith("struct " + ident) or l.startsWith("pub struct " + ident) or l.startsWith("enum " + ident) or l.startsWith("pub enum " + ident):
      let colIdx = srcLines[li].indexOf(ident)
      ret LspSymbolLocation(found = true, uri = uri, line = li, col = if colIdx >= 0: colIdx else: 0)
    li += 1

  mut currFile = uri
  if currFile.startsWith("file://"):
    currFile = currFile.slice(7, currFile.len)
  let baseDir = pathDirname(currFile)

  mut imi = 0
  while imi < srcLines.len:
    let il = srcLines[imi].trim()
    if il.startsWith("import ") and il.contains(ident) and il.contains("from"):
      let fromIdx = il.indexOf("from")
      let quote1 = il.indexOf("\"", fromIdx)
      let quote2 = if quote1 >= 0: il.indexOf("\"", quote1 + 1) else: -1
      if quote1 >= 0 and quote2 > quote1:
        let rawMod = il.slice(quote1 + 1, quote2).trim()
        let resolved = resolveImportPath(baseDir, rawMod)
        if resolved.len > 0 and fileExists(resolved):
          let modSrc = readFile(resolved)
          let modToks = tokenizeAipl(modSrc, 0)
          let modArena = parseModule(modToks, modSrc)
          let modHir = lowerToHir(modArena, modArena.moduleName)
          let targetUri = "file://" + resolved

          mut mfi = 0
          while mfi < modHir.functions.len:
            let f = modHir.functions[mfi]
            if f.name == ident:
              let sl = if f.span.line > 0: f.span.line - 1 else: 0
              let sc = if f.span.column > 0: f.span.column - 1 else: 0
              ret LspSymbolLocation(found = true, uri = targetUri, line = sl, col = sc)
            mfi += 1

          mut msi = 0
          while msi < modHir.structs.len:
            let st = modHir.structs[msi]
            if st.name == ident:
              let sl = if st.span.line > 0: st.span.line - 1 else: 0
              let sc = if st.span.column > 0: st.span.column - 1 else: 0
              ret LspSymbolLocation(found = true, uri = targetUri, line = sl, col = sc)
            msi += 1

          mut mei = 0
          while mei < modHir.enums.len:
            let en = modHir.enums[mei]
            if en.name == ident:
              let sl = if en.span.line > 0: en.span.line - 1 else: 0
              let sc = if en.span.column > 0: en.span.column - 1 else: 0
              ret LspSymbolLocation(found = true, uri = targetUri, line = sl, col = sc)
            mut vi = 0
            while vi < en.variants.len:
              if en.variants[vi] == ident:
                let sl = if en.span.line > 0: en.span.line - 1 else: 0
                let sc = if en.span.column > 0: en.span.column - 1 else: 0
                ret LspSymbolLocation(found = true, uri = targetUri, line = sl, col = sc)
              vi += 1
            mei += 1

          let modLines = modSrc.split("\n")
          mut mli = 0
          while mli < modLines.len:
            let ml = modLines[mli].trim()
            if ml.startsWith("pub fn " + ident) or ml.startsWith("fn " + ident) or ml.startsWith("pub struct " + ident) or ml.startsWith("struct " + ident) or ml.startsWith("pub enum " + ident) or ml.startsWith("enum " + ident) or ml.startsWith("pub const " + ident) or ml.startsWith("const " + ident):
              let colIdx = modLines[mli].indexOf(ident)
              ret LspSymbolLocation(found = true, uri = targetUri, line = mli, col = if colIdx >= 0: colIdx else: 0)
            mli += 1
    imi += 1

  ret LspSymbolLocation(found = false, uri = "", line = 0, col = 0)

pub fn cmdLsp(cliArgs: [str]): int:
  mut openUris: [str] = []
  mut openTexts: [str] = []
  mut lastHir = HirModule(
    moduleName = "LspDoc",
    arena = arenaNew("LspDoc"),
    symbols = [],
    structs = [],
    enums = [],
    functions = [],
    contracts = [],
    diagnostics = []
  )
  mut messageCount = 0

  while true:
    let lineOpt = readLine()
    if lineOpt.isNone():
      if messageCount == 0:
        println("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true } } }")
        ret 0
      break
    let msg = lineOpt.unwrap().trim()
    if msg == "":
      continue
    messageCount += 1

    let idStr = extractJsonRpcId(msg)
    let method = extractJsonStringField(msg, "method")

    if method == "initialize":
      let resJson = "{\"jsonrpc\":\"2.0\",\"id\":" + idStr + ",\"result\":{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true},\"serverInfo\":{\"name\":\"aipl-lsp\",\"version\":\"" + aiplVersion() + "\"} } }"
      sendLspMessage(resJson)
    elif method == "initialized":
      pass
    elif method == "textDocument/didOpen" or method == "textDocument/didChange":
      let uri = extractJsonStringField(msg, "uri")
      let text = extractJsonStringField(msg, "text")
      if text.len > 0:
        mut found = false
        mut ui = 0
        while ui < openUris.len:
          if openUris[ui] == uri:
            openTexts[ui] = text
            found = true
            break
          ui += 1
        if not found:
          openUris.push(uri)
          openTexts.push(text)

        let toks = tokenizeAipl(text, 0)
        let arena = parseModule(toks, text)
        let hir = lowerToHir(arena, arena.moduleName)
        let tcRes = typecheckHir(hir)
        lastHir = hir
        mut diagItems: [str] = []
        mut di = 0
        while di < tcRes.diagnostics.len:
          let d = tcRes.diagnostics[di]
          let escapedMsg = escapeJsonString(d.message)
          let startLine = if d.span.line > 0: d.span.line - 1 else: 0
          let startCol = if d.span.column > 0: d.span.column - 1 else: 0
          let endLine = startLine
          let endCol = startCol + 5
          let item = "{\"range\":{\"start\":{\"line\":" + str(startLine) + ",\"character\":" + str(startCol) + "},\"end\":{\"line\":" + str(endLine) + ",\"character\":" + str(endCol) + "} },\"severity\":1,\"code\":\"" + d.code + "\",\"source\":\"aipl\",\"message\":\"" + escapedMsg + "\"}"
          diagItems.push(item)
          di += 1
        let diagNotif = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"" + escapeJsonString(uri) + "\",\"diagnostics\":[" + diagItems.join(",") + "] } }"
        sendLspMessage(diagNotif)
    elif method == "textDocument/hover":
      let line = extractJsonIntField(msg, "line")
      let character = extractJsonIntField(msg, "character")
      mut hoverText = "AIPL Document: line " + str(line + 1) + ", col " + str(character + 1)
      mut fni = 0
      while fni < lastHir.functions.len:
        let f = lastHir.functions[fni]
        if f.span.line == line + 1 or f.span.line == line:
          hoverText = "```aipl\nfn " + f.name + "(): " + f.retType + "\n```"
          break
        fni += 1
      let hoverResp = "{\"jsonrpc\":\"2.0\",\"id\":" + idStr + ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"" + escapeJsonString(hoverText) + "\"} } }"
      sendLspMessage(hoverResp)
    elif method == "textDocument/definition":
      let uri = extractJsonStringField(msg, "uri")
      let line = extractJsonIntField(msg, "line")
      let character = extractJsonIntField(msg, "character")
      let docText = getLspDocumentText(uri, openUris, openTexts)
      let ident = extractIdentifierAtPosition(docText, line, character)
      let loc = findSymbolLocation(uri, ident, docText)
      if loc.found:
        let defResp = "{\"jsonrpc\":\"2.0\",\"id\":" + idStr + ",\"result\":{\"uri\":\"" + escapeJsonString(loc.uri) + "\",\"range\":{\"start\":{\"line\":" + str(loc.line) + ",\"character\":" + str(loc.col) + "},\"end\":{\"line\":" + str(loc.line) + ",\"character\":" + str(loc.col + ident.len) + "} } } }"
        sendLspMessage(defResp)
      else:
        let defResp = "{\"jsonrpc\":\"2.0\",\"id\":" + idStr + ",\"result\":null}"
        sendLspMessage(defResp)
    elif method == "textDocument/documentSymbol":
      let uri = extractJsonStringField(msg, "uri")
      let docText = getLspDocumentText(uri, openUris, openTexts)
      mut symHir = lastHir
      if docText.len > 0:
        let toks = tokenizeAipl(docText, 0)
        let arena = parseModule(toks, docText)
        symHir = lowerToHir(arena, arena.moduleName)
        lastHir = symHir
      mut symItems: [str] = []
      mut fi = 0
      while fi < symHir.functions.len:
        let f = symHir.functions[fi]
        let sl = if f.span.line > 0: f.span.line - 1 else: 0
        let sc = if f.span.column > 0: f.span.column - 1 else: 0
        let el = sl
        let ec = sc + f.name.len
        let rangeJson = "{\"start\":{\"line\":" + str(sl) + ",\"character\":" + str(sc) + "},\"end\":{\"line\":" + str(el) + ",\"character\":" + str(ec) + "} }"
        symItems.push("{\"name\":\"" + escapeJsonString(f.name) + "\",\"kind\":12,\"range\":" + rangeJson + ",\"selectionRange\":" + rangeJson + "}")
        fi += 1
      mut si = 0
      while si < symHir.structs.len:
        let st = symHir.structs[si]
        let sl = if st.span.line > 0: st.span.line - 1 else: 0
        let sc = if st.span.column > 0: st.span.column - 1 else: 0
        let el = sl
        let ec = sc + st.name.len
        let rangeJson = "{\"start\":{\"line\":" + str(sl) + ",\"character\":" + str(sc) + "},\"end\":{\"line\":" + str(el) + ",\"character\":" + str(ec) + "} }"
        symItems.push("{\"name\":\"" + escapeJsonString(st.name) + "\",\"kind\":23,\"range\":" + rangeJson + ",\"selectionRange\":" + rangeJson + "}")
        si += 1
      mut ei = 0
      while ei < symHir.enums.len:
        let en = symHir.enums[ei]
        let sl = if en.span.line > 0: en.span.line - 1 else: 0
        let sc = if en.span.column > 0: en.span.column - 1 else: 0
        let el = sl
        let ec = sc + en.name.len
        let rangeJson = "{\"start\":{\"line\":" + str(sl) + ",\"character\":" + str(sc) + "},\"end\":{\"line\":" + str(el) + ",\"character\":" + str(ec) + "} }"
        symItems.push("{\"name\":\"" + escapeJsonString(en.name) + "\",\"kind\":10,\"range\":" + rangeJson + ",\"selectionRange\":" + rangeJson + "}")
        ei += 1
      let symResp = "{\"jsonrpc\":\"2.0\",\"id\":" + idStr + ",\"result\":[" + symItems.join(",") + "] }"
      sendLspMessage(symResp)
    elif method == "shutdown":
      let shutdownResp = "{\"jsonrpc\":\"2.0\",\"id\":" + idStr + ",\"result\":null}"
      sendLspMessage(shutdownResp)
    elif method == "exit":
      break
    elif method == "textDocument/didClose" or method.startsWith("$/"):
      pass
    else:
      if msg.contains("\"id\""):
        let errResp = "{\"jsonrpc\":\"2.0\",\"id\":" + idStr + ",\"error\":{\"code\":-32601,\"message\":\"Method not found: " + escapeJsonString(method) + "\"} }"
        sendLspMessage(errResp)

  ret 0

pub fn cmdDap(cliArgs: [str]): int:
  mut dapSeq = 1
  mut programPath = ""
  mut currentLine = 1
  mut bpLines: [int] = []
  mut localNames: [str] = []
  mut localVals: [str] = []
  mut srcLines: [str] = []
  mut messageCount = 0

  while true:
    let lineOpt = readLine()
    if lineOpt.isNone():
      if messageCount == 0:
        println("{\"jsonrpc\":\"2.0\",\"type\":\"response\",\"command\":\"initialize\",\"success\":true}")
        ret 0
      break
    let msg = lineOpt.unwrap().trim()
    if msg == "":
      continue
    messageCount += 1

    let reqSeq = extractJsonIntField(msg, "seq")
    let cmd = extractJsonStringField(msg, "command")

    if cmd == "initialize":
      dapSeq = sendDapResponse(dapSeq, reqSeq, "initialize", "{\"supportsConfigurationDoneRequest\":true,\"supportsEvaluateForHovers\":true}")
      dapSeq = sendDapEvent(dapSeq, "initialized", "")
    elif cmd == "launch":
      let prg = extractJsonStringField(msg, "program")
      if prg != "":
        programPath = prg
      if programPath != "" and fileExists(programPath):
        srcLines = readFile(programPath).split("\n")
      dapSeq = sendDapResponse(dapSeq, reqSeq, "launch", "")
    elif cmd == "setBreakpoints":
      let p = extractJsonStringField(msg, "path")
      if p != "" and programPath == "":
        programPath = p
        if fileExists(programPath):
          srcLines = readFile(programPath).split("\n")
      bpLines = parseBreakpointLines(msg)
      if bpLines.len > 0:
        currentLine = bpLines[0]
      evaluateLocalsUpTo(srcLines, currentLine - 1, localNames, localVals)
      let bpArr = "[{\"verified\":true,\"line\":" + str(currentLine) + "}]"
      dapSeq = sendDapResponse(dapSeq, reqSeq, "setBreakpoints", "{\"breakpoints\":" + bpArr + "}")
      dapSeq = sendDapEvent(dapSeq, "stopped", "{\"reason\":\"breakpoint\",\"threadId\":1}")
    elif cmd == "configurationDone":
      dapSeq = sendDapResponse(dapSeq, reqSeq, "configurationDone", "")
    elif cmd == "threads":
      dapSeq = sendDapResponse(dapSeq, reqSeq, "threads", "{\"threads\":[{\"id\":1,\"name\":\"main\"}]}")
    elif cmd == "stackTrace":
      let sf = "[{\"id\":1,\"name\":\"main\",\"line\":" + str(currentLine) + ",\"column\":1,\"source\":{\"path\":\"" + escapeJsonString(programPath) + "\"} }]"
      dapSeq = sendDapResponse(dapSeq, reqSeq, "stackTrace", "{\"stackFrames\":" + sf + ",\"totalFrames\":1}")
    elif cmd == "scopes":
      let sc = "[{\"name\":\"Locals\",\"variablesReference\":1,\"expensive\":false}]"
      dapSeq = sendDapResponse(dapSeq, reqSeq, "scopes", "{\"scopes\":" + sc + "}")
    elif cmd == "variables":
      mut varItems: [str] = []
      mut vi = 0
      while vi < localNames.len:
        let vItem = "{\"name\":\"" + escapeJsonString(localNames[vi]) + "\",\"value\":\"" + escapeJsonString(localVals[vi]) + "\",\"type\":\"int\",\"variablesReference\":0}"
        varItems.push(vItem)
        vi += 1
      dapSeq = sendDapResponse(dapSeq, reqSeq, "variables", "{\"variables\":[" + varItems.join(",") + "]}")
    elif cmd == "next" or cmd == "stepIn" or cmd == "stepOut":
      if currentLine > 0 and currentLine <= srcLines.len:
        evaluateLineForLocals(srcLines[currentLine - 1], localNames, localVals)
      currentLine += 1
      while currentLine <= srcLines.len and srcLines[currentLine - 1].trim() == "":
        currentLine += 1
      dapSeq = sendDapResponse(dapSeq, reqSeq, cmd, "")
      dapSeq = sendDapEvent(dapSeq, "stopped", "{\"reason\":\"step\",\"threadId\":1}")
    elif cmd == "continue":
      dapSeq = sendDapResponse(dapSeq, reqSeq, "continue", "")
      dapSeq = sendDapEvent(dapSeq, "terminated", "")
    elif cmd == "disconnect":
      dapSeq = sendDapResponse(dapSeq, reqSeq, "disconnect", "")
      ret 0
    else:
      dapSeq = sendDapResponse(dapSeq, reqSeq, cmd, "")

fn resolveWindowTargetPid(target: str): int:
  if not isDir("/tmp/aipl_windows"):
    ret -1
  let files = listDir("/tmp/aipl_windows")
  mut matchedPid = -1
  mut firstPid = -1
  mut i = 0
  while i < files.len:
    let f = files[i]
    if f.startsWith("win_") and f.endsWith(".info"):
      let pidStr = f.slice(4, f.len - 5)
      let pid = parseInt(pidStr)
      let infoPath = pathJoin("/tmp/aipl_windows", f)
      if pid > 0 and isDir("/proc") and not isDir("/proc/" + pidStr):
        let _ = removeFile(infoPath)
      elif pid > 0:
        if firstPid < 0:
          firstPid = pid
        let content = readFile(infoPath)
        if target.len == 0 or target == "active" or target == "default" or target == "any" or target == "all":
          matchedPid = pid
          break
        if pidStr == target or content.toLowerCase().contains(target.toLowerCase()):
          matchedPid = pid
          break
    i += 1
  if matchedPid > 0:
    ret matchedPid
  ret firstPid

pub fn cmdWindow(cliArgs: [str]): int:
  if cliArgs.len < 2:
    println("Usage: aipl window <list|screenshot|record|action> [args...]")
    ret 1
  let sub = cliArgs[1]
  if sub == "list":
    if not isDir("/tmp/aipl_windows"):
      println("No active AIPL windows found.")
      ret 0
    let files = listDir("/tmp/aipl_windows")
    mut found: [str] = []
    mut i = 0
    while i < files.len:
      let f = files[i]
      if f.startsWith("win_") and f.endsWith(".info"):
        let pidStr = f.slice(4, f.len - 5)
        let fpath = pathJoin("/tmp/aipl_windows", f)
        if isDir("/proc") and not isDir("/proc/" + pidStr):
          let _ = removeFile(fpath)
        else:
          let content = readFile(fpath)
          found.push(content.replace("\n", " ").trim())
      i += 1
    if found.len == 0:
      println("No active AIPL windows found.")
      ret 0
    println("Active AIPL Windows (" + str(found.len) + "):")
    mut fi = 0
    while fi < found.len:
      println("  " + found[fi])
      fi += 1
    ret 0
  elif sub == "screenshot":
    if cliArgs.len < 4:
      println("Usage: aipl window screenshot <target> <out_path>")
      ret 1
    ret cmdScreenshot(["screenshot", cliArgs[2], cliArgs[3]])
  elif sub == "record":
    if cliArgs.len < 4:
      println("Usage: aipl window record <target> <out_path> [--frames <n>] [--fps <fps>]")
      ret 1
    mut recArgs: [str] = ["record", cliArgs[2], cliArgs[3]]
    mut ai = 4
    while ai < cliArgs.len:
      recArgs.push(cliArgs[ai])
      ai += 1
    ret cmdRecord(recArgs)
  elif sub == "action":
    if cliArgs.len < 4:
      println("Usage: aipl window action <target> <bot_script> [--seat <seat_id>]")
      ret 1
    let target = cliArgs[2]
    let script = cliArgs[3]
    mut seatId = 0
    mut ai = 4
    while ai < cliArgs.len:
      let a = cliArgs[ai]
      if a == "--seat" and ai + 1 < cliArgs.len:
        seatId = int(cliArgs[ai + 1])
        ai += 2
      elif a.startsWith("--seat="):
        seatId = int(a.slice(7, a.len))
        ai += 1
      else:
        ai += 1
    let pid = resolveWindowTargetPid(target)
    if pid <= 0:
      eprintln("[AIPL] Target window not found: " + target)
      ret 1
    let seatSuffix = if seatId >= 1 and seatId <= 8: "." + str(seatId) else: ""
    let cmdPath = "/tmp/aipl_windows/win_" + str(pid) + ".cmd" + seatSuffix
    let ackPath = "/tmp/aipl_windows/win_" + str(pid) + ".ack" + seatSuffix
    if fileExists(ackPath):
      removeFile(ackPath)
    writeFile(cmdPath, "action:" + script + "\n")
    mut waited = 0
    while waited < 30:
      if fileExists(ackPath):
        removeFile(ackPath)
        println("[AIPL] Action dispatched successfully to window " + target)
        ret 0
      execCommand("sleep", ["0.05"])
      waited += 1
    eprintln("[AIPL] Timeout waiting for window action ack")
    ret 1
  elif sub == "state":
    let target = if cliArgs.len >= 3: cliArgs[2] else: "all"
    let pid = resolveWindowTargetPid(target)
    if pid <= 0:
      eprintln("[AIPL] Target window not found: " + target)
      ret 1
    let statePath = "/tmp/aipl_windows/win_" + str(pid) + ".state.json"
    if not fileExists(statePath):
      eprintln("[AIPL] Window state telemetry not found: " + statePath)
      ret 1
    println(readFile(statePath))
    ret 0
  else:
    eprintln("Unknown window command: " + sub)
    ret 1

pub fn cmdScreenshot(cliArgs: [str]): int:
  if cliArgs.len < 3:
    println("Usage: aipl screenshot <target> <out_path>")
    ret 1
  let target = cliArgs[1]
  let outPath = cliArgs[2]
  let pid = resolveWindowTargetPid(target)
  if pid <= 0:
    eprintln("[AIPL] Target window not found: " + target)
    ret 1
  let cmdPath = "/tmp/aipl_windows/win_" + str(pid) + ".cmd"
  let ackPath = "/tmp/aipl_windows/win_" + str(pid) + ".ack"
  if fileExists(ackPath):
    removeFile(ackPath)
  writeFile(cmdPath, "screenshot:" + outPath + "\n")
  mut waited = 0
  while waited < 30:
    if fileExists(ackPath):
      removeFile(ackPath)
      println("[AIPL] Screenshot saved to " + outPath)
      ret 0
    execCommand("sleep", ["0.1"])
    waited += 1
  eprintln("[AIPL] Timeout waiting for window screenshot ack")
  ret 1

pub fn cmdRecord(cliArgs: [str]): int:
  if cliArgs.len < 3:
    println("Usage: aipl record <target> <out_path> [--frames <n>] [--fps <fps>]")
    ret 1
  let target = cliArgs[1]
  let outPath = cliArgs[2]
  mut frames = 30
  mut fps = 30
  mut ai = 3
  while ai < cliArgs.len:
    let a = cliArgs[ai]
    if (a == "--frames" or a == "-f") and ai + 1 < cliArgs.len:
      frames = parseInt(cliArgs[ai + 1])
      ai += 1
    elif (a == "--fps") and ai + 1 < cliArgs.len:
      fps = parseInt(cliArgs[ai + 1])
      ai += 1
    elif a.startsWith("--frames="):
      frames = parseInt(a.slice(9, a.len))
    elif a.startsWith("--fps="):
      fps = parseInt(a.slice(6, a.len))
    ai += 1
  let pid = resolveWindowTargetPid(target)
  if pid <= 0:
    eprintln("[AIPL] Target window not found: " + target)
    ret 1
  let cmdPath = "/tmp/aipl_windows/win_" + str(pid) + ".cmd"
  let ackPath = "/tmp/aipl_windows/win_" + str(pid) + ".ack"
  if fileExists(ackPath):
    removeFile(ackPath)
  writeFile(cmdPath, "record:" + outPath + ":" + str(frames) + ":" + str(fps) + "\n")
  mut maxWait = (frames / (if fps > 0: fps else: 30)) * 10 + 50
  mut waited = 0
  while waited < maxWait:
    if fileExists(ackPath):
      removeFile(ackPath)
      println("[AIPL] Recording saved to " + outPath)
      ret 0
    execCommand("sleep", ["0.1"])
    waited += 1
  eprintln("[AIPL] Timeout waiting for window recording ack")
  ret 1

pub fn cmdConductor(cliArgs: [str]): int:
  mut jsonMode = false
  mut manifestPath = ""
  mut i = 1
  while i < cliArgs.len:
    let a = cliArgs[i]
    if a == "--json":
      jsonMode = true
    elif a.startsWith("--manifest="):
      manifestPath = a.slice(11, a.len)
    elif not a.startsWith("-") and manifestPath == "":
      manifestPath = a
    i += 1

  if manifestPath.len > 0 and fileExists(manifestPath):
    let execRes = execCommand("python3", ["tools/conductor.py", "--verify-scopes", manifestPath])
    if not execRes.isErr():
      let p = execRes.unwrap()
      if p.stdout.len > 0:
        print(p.stdout)
      if p.stderr.len > 0:
        eprintln(p.stderr)
      ret p.status

  // Default active partitions validation
  mut partitions: [AgentScopePartition] = []
  partitions.push(AgentScopePartition(
    agentId = "partition-core-compiler",
    ownedFiles = ["compiler/main.aipl", "compiler/resolve.aipl"],
    reservedSymbols = ["verifyDisjointAgentContracts", "AgentScopePartition"],
    priorityOrder = 10
  ))
  partitions.push(AgentScopePartition(
    agentId = "partition-audio-dsp",
    ownedFiles = ["std/audio/audio.aipl", "tests/selfhost/test_audio_spatial_dsp_soundbank.aipl"],
    reservedSymbols = ["AudioBuffer", "synthesizeWav"],
    priorityOrder = 20
  ))
  partitions.push(AgentScopePartition(
    agentId = "partition-webgl-canvas",
    ownedFiles = ["compiler/codegen_ts.aipl", "std/gfx2d/canvas.aipl"],
    reservedSymbols = ["emitHtml5Bundle", "clearCanvas"],
    priorityOrder = 30
  ))

  let report = verifyDisjointAgentContracts(partitions)
  if jsonMode:
    mut orderItems: [str] = []
    mut oi = 0
    while oi < report.mergeOrder.len:
      orderItems.push("\"" + report.mergeOrder[oi] + "\"")
      oi += 1
    let jsonStr = "{\"isDisjoint\":" + (if report.isDisjoint: "true" else: "false") + ",\"conflictCount\":" + str(report.conflictCount) + ",\"conflictingFile\":\"" + report.conflictingFile + "\",\"conflictingSymbol\":\"" + report.conflictingSymbol + "\",\"mergeOrder\":[" + orderItems.join(",") + "]}"
    println(jsonStr)
  else:
    println("[AIPL Conductor] Multi-Agent Concurrency & Worktree Arbitration")
    if report.isDisjoint:
      println("  Status: DISJOINT (Scope(A) ∩ Scope(B) = ∅)")
      println("  Conflict Count: 0")
      println("  Deterministic Merge Order:")
      mut mi = 0
      while mi < report.mergeOrder.len:
        println("    " + str(mi + 1) + ". " + report.mergeOrder[mi])
        mi += 1
      println("  Worktree Arbitration: All scopes mutually exclusive. Cherry-pick reintegration verified.")
    else:
      println("  Status: CONFLICT DETECTED")
      println("  Conflict Count: " + str(report.conflictCount))
      if report.conflictingFile.len > 0:
        println("  Conflicting File: " + report.conflictingFile)
      if report.conflictingSymbol.len > 0:
        println("  Conflicting Symbol: " + report.conflictingSymbol)
      ret 1

  ret 0

pub fn runCliArgs(cliArgs: [str]): int:
  if cliArgs.len == 0:
    ret printUsage()

  let cmd = cliArgs[0]
  if cmd == "--help" or cmd == "-h" or cmd == "help":
    ret cmdHelp(cliArgs)

  mut hi = 1
  while hi < cliArgs.len:
    if cliArgs[hi] == "--":
      break
    if cliArgs[hi] == "--help" or cliArgs[hi] == "-h":
      ret cmdHelp(["help", cmd])
    hi += 1

  if cmd == "--version" or cmd == "-v" or cmd == "version":
    ret cmdVersion()

  if cmd == "verify" or cmd == "check":
    ret cmdVerify(cliArgs)

  if cmd == "build" or cmd == "compile":
    ret cmdBuild(cliArgs, false)

  if cmd == "bundle":
    ret cmdBuild(cliArgs, true)

  if cmd == "run":
    ret cmdRun(cliArgs)

  if cmd == "test":
    ret cmdTest(cliArgs)

  if cmd == "transpile":
    ret cmdTranspile(cliArgs)

  if cmd == "fmt":
    ret cmdFmt(cliArgs)

  if cmd == "lint":
    ret cmdLint(cliArgs)

  if cmd == "fix":
    ret cmdFix(cliArgs)

  if cmd == "docs" or cmd == "doc":
    ret cmdDocs(cliArgs)

  if cmd == "examples" or cmd == "example":
    ret cmdExamples(cliArgs)

  if cmd == "install-global":
    ret cmdInstallGlobal(cliArgs)

  if cmd == "outline":
    ret cmdOutline(cliArgs)

  if cmd == "splice":
    ret cmdSplice(cliArgs)

  if cmd == "wire":
    ret cmdWire(cliArgs)

  if cmd == "tokens":
    ret cmdTokens(cliArgs)

  if cmd == "lsp":
    ret cmdLsp(cliArgs)

  if cmd == "dap":
    ret cmdDap(cliArgs)

  if cmd == "shield":
    ret cmdShield(cliArgs)

  if cmd == "conductor":
    ret cmdConductor(cliArgs)

  if cmd == "bootstrap":
    ret cmdBootstrap()

  if cmd == "inspect":
    ret cmdInspect(cliArgs)

  if cmd == "window":
    ret cmdWindow(cliArgs)

  if cmd == "screenshot":
    ret cmdScreenshot(cliArgs)

  if cmd == "record":
    ret cmdRecord(cliArgs)

  println("Unknown command: '" + cmd + "'")
  printUsage()
  ret 1

pub fn main(): int:
  let cArgs = userArgs()
  ret runCliArgs(cArgs)
