module CompilerCodegenNative

import { HirModule } from "./hir.aipl"
import { emitElf64X86_64Bytes } from "./codegen_x86_64.aipl"
import { emitElf64Arm64Bytes } from "./codegen_arm64.aipl"

// ============================================================================
// Phase 14 (Step 14.3b): Native ELF64 Direct Machine Code Emitter Entrypoints
// Provides unified dispatch across x86_64 and ARM64 native targets
// ============================================================================

pub fn emitNativeElf64Bytes(hir: HirModule, bundledSource: str, arch: str): bytes:
  if arch == "arm64" or arch == "aarch64":
    ret emitElf64Arm64Bytes(hir, bundledSource)
  ret emitElf64X86_64Bytes(hir, bundledSource)

pub fn emitNativeDefaultBytes(hir: HirModule, bundledSource: str): bytes:
  ret emitElf64X86_64Bytes(hir, bundledSource)
