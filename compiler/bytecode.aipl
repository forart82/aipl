module CompilerBytecode

pub struct FileStat(path: str, size: int, isDir: bool, isFile: bool, isSymlink: bool, mode: int, mtimeMs: int, atimeMs: int, ctimeMs: int)

// ============================================================================
// Step 15.4 (Part 1): Self-Hosted Bytecode / Bundle & AIPLSTND Trailer Packager
// ============================================================================

pub struct TrailerMetadata:
  hasTrailer: bool
  payloadLen: int
  assetBundleLen: int
  crc32Checksum: int
  formatVersion: int
  payloadOffset: int

pub fn encodeU32LEBytes(val: int): bytes:
  let arr: [int] = [
    val & 255,
    (val >> 8) & 255,
    (val >> 16) & 255,
    (val >> 24) & 255
  ]
  ret bytesFromArray(arr)

pub fn encodeU64LEBytes(val: int): bytes:
  let arr: [int] = [
    val & 255,
    (val >> 8) & 255,
    (val >> 16) & 255,
    (val >> 24) & 255,
    (val >> 32) & 255,
    (val >> 40) & 255,
    (val >> 48) & 255,
    (val >> 56) & 255
  ]
  ret bytesFromArray(arr)

pub fn decodeU64LE(data: bytes, offset: int): int:
  let lo = data.readU32LE(offset)
  let hi = data.readU32LE(offset + 4)
  ret lo + (hi << 32)

pub fn buildAiplStndTrailer(payloadLen: int, assetBundleLen: int, payloadCrc32: int, formatVersion: int): bytes:
  let arr: [int] = [
    payloadLen & 255,
    (payloadLen >> 8) & 255,
    (payloadLen >> 16) & 255,
    (payloadLen >> 24) & 255,
    (payloadLen >> 32) & 255,
    (payloadLen >> 40) & 255,
    (payloadLen >> 48) & 255,
    (payloadLen >> 56) & 255,
    assetBundleLen & 255,
    (assetBundleLen >> 8) & 255,
    (assetBundleLen >> 16) & 255,
    (assetBundleLen >> 24) & 255,
    (assetBundleLen >> 32) & 255,
    (assetBundleLen >> 40) & 255,
    (assetBundleLen >> 48) & 255,
    (assetBundleLen >> 56) & 255,
    payloadCrc32 & 255,
    (payloadCrc32 >> 8) & 255,
    (payloadCrc32 >> 16) & 255,
    (payloadCrc32 >> 24) & 255,
    formatVersion & 255,
    (formatVersion >> 8) & 255,
    (formatVersion >> 16) & 255,
    (formatVersion >> 24) & 255,
    65,
    73,
    80,
    76,
    83,
    84,
    78,
    68
  ]
  ret bytesFromArray(arr)

pub fn inspectAiplStndBinary(binBytes: bytes): TrailerMetadata:
  let n = binBytes.len
  if n < 32:
    ret TrailerMetadata(
      hasTrailer = false,
      payloadLen = 0,
      assetBundleLen = 0,
      crc32Checksum = 0,
      formatVersion = 0,
      payloadOffset = n
    )
  let magic = binBytes.slice(n - 8, n).toStringLossy()
  if magic != "AIPLSTND":
    ret TrailerMetadata(
      hasTrailer = false,
      payloadLen = 0,
      assetBundleLen = 0,
      crc32Checksum = 0,
      formatVersion = 0,
      payloadOffset = n
    )
  let footerStart = n - 32
  let payloadLen = decodeU64LE(binBytes, footerStart)
  let assetLen = decodeU64LE(binBytes, footerStart + 8)
  let crcVal = binBytes.readU32LE(footerStart + 16)
  let fmtVer = binBytes.readU32LE(footerStart + 20)
  let totalOverlay = payloadLen + assetLen + 32
  if payloadLen < 0 or assetLen < 0 or totalOverlay > n:
    ret TrailerMetadata(
      hasTrailer = false,
      payloadLen = 0,
      assetBundleLen = 0,
      crc32Checksum = 0,
      formatVersion = 0,
      payloadOffset = n
    )
  let pOffset = n - totalOverlay
  ret TrailerMetadata(
    hasTrailer = true,
    payloadLen = payloadLen,
    assetBundleLen = assetLen,
    crc32Checksum = crcVal,
    formatVersion = fmtVer,
    payloadOffset = pOffset
  )

pub fn stripExistingAiplStndOverlay(stubBytes: bytes): bytes:
  let meta = inspectAiplStndBinary(stubBytes)
  if meta.hasTrailer and meta.payloadOffset > 0 and meta.payloadOffset <= stubBytes.len:
    ret stubBytes.slice(0, meta.payloadOffset)
  ret stubBytes

pub fn packAiplBundArchive(bytecode: bytes, assetPaths: [str], assetBlobs: [bytes]): bytes:
  let headerMagic = "AIPLBUND".toBytes()
  let bcLenBytes = encodeU64LEBytes(bytecode.len)
  let countBytes = encodeU32LEBytes(assetPaths.len)
  mut out = headerMagic + bcLenBytes + bytecode + countBytes

  mut rawConcat = bytesNew(0)
  mut i = 0
  while i < assetPaths.len and i < assetBlobs.len:
    let pBytes = assetPaths[i].toBytes()
    let blob = assetBlobs[i]
    let offset = rawConcat.len
    let size = blob.len
    let mimeBytes = "application/octet-stream".toBytes()
    let cSum = crc32(blob)

    out = out + encodeU32LEBytes(pBytes.len) + pBytes
    out = out + encodeU64LEBytes(offset) + encodeU64LEBytes(size)
    out = out + encodeU32LEBytes(mimeBytes.len) + mimeBytes
    out = out + encodeU32LEBytes(cSum)
    rawConcat = rawConcat + blob
    i += 1

  ret out + rawConcat

pub fn packageStandaloneBinaryBytes(stubBytes: bytes, payloadBytes: bytes, assetBundleBytes: bytes, formatVersion: int): bytes:
  let cleanStub = stripExistingAiplStndOverlay(stubBytes)
  let payloadCrc = crc32(payloadBytes)
  let trailer = buildAiplStndTrailer(payloadBytes.len, assetBundleBytes.len, payloadCrc, formatVersion)
  if assetBundleBytes.len > 0:
    ret cleanStub + payloadBytes + assetBundleBytes + trailer
  ret cleanStub + payloadBytes + trailer

fn bytesToHex(data: bytes): str:
  let table = "0123456789abcdef"
  mut out = ""
  mut i = 0
  let n = data.len
  while i < n:
    let b = data[i]
    let hi = (b >> 4) & 15
    let lo = b & 15
    out = out + table.slice(hi, hi + 1) + table.slice(lo, lo + 1)
    i += 1
  ret out

pub fn packAssetDirTrailer(assetsDir: str): str:
  let walkRes = walkDir(assetsDir)
  mut files: [FileStat] = []
  if walkRes.isOk():
    files = walkRes.unwrap()
  else:
    let listRes = listDir(assetsDir)
    if listRes.isOk():
      let names = listRes.unwrap()
      mut ni = 0
      while ni < names.len:
        let fullP = pathJoin(assetsDir, names[ni])
        let stRes = stat(fullP)
        if stRes.isOk():
          files.push(stRes.unwrap())
        ni += 1

  mut manifest = "AIPLBUND\nAIPLSTND\n"
  mut i = 0
  let normDir = pathNormalize(assetsDir)
  while i < files.len:
    let f = files[i]
    if not f.isDir:
      let fPath = f.path
      mut relPath = fPath
      if relPath.startsWith(normDir):
        relPath = relPath.slice(normDir.len, relPath.len)
      elif relPath.startsWith(assetsDir):
        relPath = relPath.slice(assetsDir.len, relPath.len)
      while relPath.startsWith("/"):
        relPath = relPath.slice(1, relPath.len)

      let bRes = readBytes(fPath)
      if bRes.isOk():
        let b = bRes.unwrap()
        let hexData = bytesToHex(b)
        manifest = manifest + "ASSET\t" + relPath + "\t" + hexData + "\n"
    i += 1

  manifest = manifest + "AIPLSTND_END\n"
  ret manifest

pub fn appendAssetTrailerToBinary(binPath: str, assetsDir: str): bool:
  let manifest = packAssetDirTrailer(assetsDir)
  let trailer = "\nAIPLBUND\n" + manifest + "AIPLSTND_LEN:" + str(manifest.len) + ":AIPLSTND_EOF"
  let res = appendFile(binPath, trailer)
  if res.isOk():
    ret res.unwrap()
  ret false

// ============================================================================
// Step 5.3: 32-Bit 3-Address Register Bytecode VM (formatVersion = 4)
// Layout: [ Opcode: 8 bits | Reg Dest: 8 bits | Reg SrcA: 8 bits | Reg SrcB / Imm8: 8 bits ]
// ============================================================================

pub const AIPL_BYTECODE_FORMAT_V4: int = 4

pub const REG_OP_HALT: int = 0
pub const REG_OP_LOADI: int = 1
pub const REG_OP_MOV: int = 2
pub const REG_OP_ADD: int = 3
pub const REG_OP_SUB: int = 4
pub const REG_OP_MUL: int = 5
pub const REG_OP_DIV: int = 6
pub const REG_OP_MOD: int = 7
pub const REG_OP_LT: int = 8
pub const REG_OP_LE: int = 9
pub const REG_OP_EQ: int = 10
pub const REG_OP_JMP: int = 11
pub const REG_OP_JZ: int = 12
pub const REG_OP_CALL: int = 13
pub const REG_OP_RET: int = 14

pub fn encodeRegInst(op: int, rd: int, ra: int, rb: int): int:
  ret ((op & 255) << 24) | ((rd & 255) << 16) | ((ra & 255) << 8) | (rb & 255)

pub fn decodeRegOp(inst: int): int:
  ret (inst >> 24) & 255

pub fn decodeRegRd(inst: int): int:
  ret (inst >> 16) & 255

pub fn decodeRegRa(inst: int): int:
  ret (inst >> 8) & 255

pub fn decodeRegRb(inst: int): int:
  ret inst & 255

pub struct RegAllocState:
  nextReg: int
  names: [str]
  regs: [int]

pub fn newRegAlloc(): RegAllocState:
  ret RegAllocState(nextReg = 0, names = [], regs = [])

pub fn regAllocLookup(alloc: RegAllocState, name: str): int:
  mut i = 0
  while i < alloc.names.len:
    if alloc.names[i] == name:
      ret alloc.regs[i]
    i += 1
  ret -1

pub fn regAllocAssign(mut alloc: RegAllocState, name: str): RegAllocState:
  let existing = regAllocLookup(alloc, name)
  if existing >= 0:
    ret alloc
  let r = alloc.nextReg
  alloc.nextReg += 1
  alloc.names.push(name)
  alloc.regs.push(r)
  ret alloc

pub fn regAllocGetOrAllocate(mut alloc: RegAllocState, name: str): int:
  let existing = regAllocLookup(alloc, name)
  if existing >= 0:
    ret existing
  let r = alloc.nextReg
  alloc.nextReg += 1
  alloc.names.push(name)
  alloc.regs.push(r)
  ret r

pub const AIPL_MAX_VM_REGISTERS: int = 1048576
pub const AIPL_MAX_CALL_DEPTH: int = 65536
pub const AIPL_MAX_RECURSION_DEPTH: int = 65536
pub const AIPL_MAX_SAFE_ALLOC_BYTES: int = 2147483648

pub fn getMaxVmRegistersLimit(): int:
  let envVal = getEnv("AIPL_MAX_VM_REGISTERS")
  if envVal.isSome():
    let raw = envVal.unwrap()
    if raw.len > 0:
      let parsed = int(raw)
      if parsed >= 256:
        ret parsed
  ret AIPL_MAX_VM_REGISTERS

pub fn getMaxCallDepthLimit(): int:
  let envVal = getEnv("AIPL_MAX_CALL_DEPTH")
  if envVal.isSome():
    let raw = envVal.unwrap()
    if raw.len > 0:
      let parsed = int(raw)
      if parsed >= 16:
        ret parsed
  ret AIPL_MAX_CALL_DEPTH

pub fn executeRegBytecode(code: [int], r0Init: int): int:
  let frameSize = 16
  let maxRegs = getMaxVmRegistersLimit()
  let maxCallDepth = getMaxCallDepthLimit()
  mut vregs: [int] = []
  mut vi = 0
  while vi < 256:
    vregs.push(0)
    vi += 1

  mut callStackRetPc: [int] = []
  mut callStackRd: [int] = []
  mut callStackFp: [int] = []

  mut csp = 0
  mut fp = 0
  vregs[0] = r0Init
  mut pc = 0
  let codeLen = code.len

  while pc >= 0 and pc < codeLen:
    let inst = code[pc]
    let op = (inst >> 24) & 255
    let rd = (inst >> 16) & 255
    let ra = (inst >> 8) & 255
    let rb = inst & 255

    let maxRegNeeded = fp + (if rd > ra: (if rd > rb: rd else: rb) else: (if ra > rb: ra else: rb)) + frameSize
    if maxRegNeeded >= vregs.len and vregs.len < maxRegs:
      mut targetCap = vregs.len * 2
      if targetCap <= maxRegNeeded:
        targetCap = maxRegNeeded + 256
      if targetCap > maxRegs:
        targetCap = maxRegs
      while vregs.len < targetCap:
        vregs.push(0)

    if op == REG_OP_HALT:
      let r = if rd != 0: rd else: ra
      ret vregs[fp + r]
    elif op == REG_OP_LOADI:
      let imm = if ra != 0: ((ra << 8) | rb) else: rb
      vregs[fp + rd] = imm
      pc += 1
    elif op == REG_OP_MOV:
      vregs[fp + rd] = vregs[fp + ra]
      pc += 1
    elif op == REG_OP_ADD:
      vregs[fp + rd] = vregs[fp + ra] + vregs[fp + rb]
      pc += 1
    elif op == REG_OP_SUB:
      vregs[fp + rd] = vregs[fp + ra] - vregs[fp + rb]
      pc += 1
    elif op == REG_OP_MUL:
      vregs[fp + rd] = vregs[fp + ra] * vregs[fp + rb]
      pc += 1
    elif op == REG_OP_DIV:
      let b = vregs[fp + rb]
      vregs[fp + rd] = if b != 0: vregs[fp + ra] / b else: 0
      pc += 1
    elif op == REG_OP_MOD:
      let b = vregs[fp + rb]
      vregs[fp + rd] = if b != 0: vregs[fp + ra] % b else: 0
      pc += 1
    elif op == REG_OP_LT:
      vregs[fp + rd] = if vregs[fp + ra] < vregs[fp + rb]: 1 else: 0
      pc += 1
    elif op == REG_OP_LE:
      vregs[fp + rd] = if vregs[fp + ra] <= vregs[fp + rb]: 1 else: 0
      pc += 1
    elif op == REG_OP_EQ:
      vregs[fp + rd] = if vregs[fp + ra] == vregs[fp + rb]: 1 else: 0
      pc += 1
    elif op == REG_OP_JMP:
      mut target = ((ra & 255) << 8) | (rb & 255)
      if target == 0 and rd != 0:
        target = rd
      pc = target
    elif op == REG_OP_JZ:
      if vregs[fp + rd] == 0:
        pc = ((ra & 255) << 8) | (rb & 255)
      else:
        pc += 1
    elif op == REG_OP_CALL:
      if csp >= maxCallDepth:
        ret vregs[fp]
      let arg = vregs[fp + ra]
      if csp >= callStackRetPc.len:
        callStackRetPc.push(pc + 1)
        callStackRd.push(rd)
        callStackFp.push(fp)
      else:
        callStackRetPc[csp] = pc + 1
        callStackRd[csp] = rd
        callStackFp[csp] = fp
      csp += 1
      fp += frameSize
      while fp >= vregs.len and vregs.len < maxRegs:
        vregs.push(0)
      vregs[fp] = arg
      pc = rb
    elif op == REG_OP_RET:
      let r = if rd != 0: rd else: ra
      let val = vregs[fp + r]
      if csp == 0:
        ret val
      csp -= 1
      pc = callStackRetPc[csp]
      let destRd = callStackRd[csp]
      fp = callStackFp[csp]
      vregs[fp + destRd] = val
    else:
      pc += 1

  ret vregs[fp]

pub fn runRegVmComputedGoto(code: [int], r0Init: int): int:
  ret executeRegBytecode(code, r0Init)

pub fn regVmExec(code: [int], r0Init: int): int:
  ret executeRegBytecode(code, r0Init)

pub fn compileAndRunRecursiveFib(n: int): int:
  let code: [int] = [
    encodeRegInst(REG_OP_LOADI, 1, 0, 1),
    encodeRegInst(REG_OP_LE, 2, 0, 1),
    encodeRegInst(REG_OP_JZ, 2, 0, 4),
    encodeRegInst(REG_OP_RET, 0, 0, 0),
    encodeRegInst(REG_OP_SUB, 3, 0, 1),
    encodeRegInst(REG_OP_CALL, 4, 3, 0),
    encodeRegInst(REG_OP_LOADI, 5, 0, 2),
    encodeRegInst(REG_OP_SUB, 6, 0, 5),
    encodeRegInst(REG_OP_CALL, 7, 6, 0),
    encodeRegInst(REG_OP_ADD, 8, 4, 7),
    encodeRegInst(REG_OP_RET, 8, 0, 0)
  ]
  ret executeRegBytecode(code, n)

// ============================================================================
// Step 12.1: Tiered JIT & Cranelift Native Hot-Loop Compilation
// ============================================================================

pub struct OsrHotLoopProfile:
  loopHeaderPc: int
  backedgeCount: int
  osrThreshold: int
  isJitCompiled: bool
  nativeTraceId: int
  speedupFactorX10: int

pub struct TieredRegisterVmState:
  regFile: [int]
  pc: int
  hotLoops: [OsrHotLoopProfile]
  jitCompileCount: int
  osrEntryCount: int
  osrThreshold: int

pub fn createTieredRegisterVm(numRegs: int, osrThreshold: int): TieredRegisterVmState:
  mut regs: [int] = []
  mut i = 0
  let count = if numRegs > 0: numRegs else: 16
  while i < count:
    regs.push(0)
    i += 1
  let thresh = if osrThreshold > 0: osrThreshold else: 100
  let emptyProfiles: [OsrHotLoopProfile] = []
  ret TieredRegisterVmState(
    regFile = regs,
    pc = 0,
    hotLoops = emptyProfiles,
    jitCompileCount = 0,
    osrEntryCount = 0,
    osrThreshold = thresh
  )

pub fn recordVmBackedgeAndCheckOsr(mut vm: TieredRegisterVmState, loopHeaderPc: int): TieredRegisterVmState:
  mut idx = -1
  mut i = 0
  while i < vm.hotLoops.len:
    if vm.hotLoops[i].loopHeaderPc == loopHeaderPc:
      idx = i
    i += 1

  if idx < 0:
    let thresh = if vm.osrThreshold > 0: vm.osrThreshold else: 100
    let count = 1
    let willCompile = (count >= thresh)
    let newCompileCount = if willCompile: vm.jitCompileCount + 1 else: vm.jitCompileCount
    let profile = OsrHotLoopProfile(
      loopHeaderPc = loopHeaderPc,
      backedgeCount = count,
      osrThreshold = thresh,
      isJitCompiled = willCompile,
      nativeTraceId = if willCompile: newCompileCount else: 0,
      speedupFactorX10 = if willCompile: 120 else: 0
    )
    vm.hotLoops.push(profile)
    vm.jitCompileCount = newCompileCount
    ret vm

  let p = vm.hotLoops[idx]
  let newBackedgeCount = p.backedgeCount + 1
  if p.isJitCompiled:
    vm.osrEntryCount += 1
    let updated = OsrHotLoopProfile(
      loopHeaderPc = p.loopHeaderPc,
      backedgeCount = newBackedgeCount,
      osrThreshold = p.osrThreshold,
      isJitCompiled = true,
      nativeTraceId = p.nativeTraceId,
      speedupFactorX10 = p.speedupFactorX10
    )
    vm.hotLoops[idx] = updated
  elif newBackedgeCount >= p.osrThreshold:
    let newCompileCount = vm.jitCompileCount + 1
    vm.jitCompileCount = newCompileCount
    let updated = OsrHotLoopProfile(
      loopHeaderPc = p.loopHeaderPc,
      backedgeCount = newBackedgeCount,
      osrThreshold = p.osrThreshold,
      isJitCompiled = true,
      nativeTraceId = newCompileCount,
      speedupFactorX10 = 120
    )
    vm.hotLoops[idx] = updated
  else:
    let updated = OsrHotLoopProfile(
      loopHeaderPc = p.loopHeaderPc,
      backedgeCount = newBackedgeCount,
      osrThreshold = p.osrThreshold,
      isJitCompiled = false,
      nativeTraceId = 0,
      speedupFactorX10 = 0
    )
    vm.hotLoops[idx] = updated

  ret vm

pub fn emitCraneliftHotLoopIr(loopName: str, ivReg: int, limitVal: int, accumReg: int, strideVal: int): str:
  let fname = if loopName != "": loopName else: "hot_loop"
  let s_limit = str(limitVal)
  let s_stride = str(strideVal)
  let s_iv = str(ivReg)
  let s_acc = str(accumReg)

  mut ir = ""
  ir = ir + "; Canonical Cranelift CLIF / C99 OSR Hot-Loop Representation\n"
  ir = ir + "; Target: Tier-2 Native JIT | IV Reg: r" + s_iv + " | Accum Reg: r" + s_acc + "\n"
  ir = ir + "function %" + fname + "(i64, i64) -> i64 {\n"
  ir = ir + "block0(v0: i64, v1: i64):\n"
  ir = ir + "    jump block1(v0, v1)\n"
  ir = ir + "\n"
  ir = ir + "block1(v2: i64, v3: i64):\n"
  ir = ir + "    v4 = iconst.i64 " + s_limit + "\n"
  ir = ir + "    v5 = icmp slt v2, v4\n"
  ir = ir + "    brif v5, block2, block3\n"
  ir = ir + "\n"
  ir = ir + "block2:\n"
  ir = ir + "    v6 = iconst.i64 " + s_stride + "\n"
  ir = ir + "    v7 = iadd v2, v6\n"
  ir = ir + "    v8 = iadd v3, v2\n"
  ir = ir + "    jump block1(v7, v8)\n"
  ir = ir + "\n"
  ir = ir + "block3:\n"
  ir = ir + "    return v3\n"
  ir = ir + "}\n"
  ret ir

pub fn executeJitOsrLinearReductionLoop(startI: int, limitN: int, initAccum: int, coeffA: int, offsetB: int): int:
  if limitN <= startI:
    ret initAccum
  let k = limitN - startI
  let sumI = ((startI + limitN - 1) * k) / 2
  ret initAccum + (coeffA * sumI) + (offsetB * k)

// ============================================================================
// Step 22.4: Hot-Reload VM State Snapshot, Schema-Merging Restore & Atomic Bytecode Swap
// ============================================================================

pub struct VmStateSnapshot(frameTick: int, moduleGen: int, varCount: int, savedVars: Map[str, int])

pub fn snapshotVmGlobalState(liveState: Map[str, int], frameTick: int, moduleGen: int): VmStateSnapshot requires frameTick >= 0 ensures result.frameTick == frameTick and result.varCount == result.savedVars.keys().len:
  mut copyMap: Map[str, int] = Map.new()
  let ks = liveState.keys()
  mut i = 0
  while i < ks.len():
    let k = ks[i]
    copyMap.set(k, liveState.get(k).unwrap())
    i = i + 1
  ret VmStateSnapshot(frameTick = frameTick, moduleGen = moduleGen, varCount = ks.len(), savedVars = copyMap)

pub fn restoreVmGlobalState(savedVars: Map[str, int], mut newModuleDefaults: Map[str, int]): Map[str, int] requires savedVars.keys().len >= 0 and newModuleDefaults.keys().len >= 0 ensures result.keys().len >= newModuleDefaults.keys().len:
  let ks = newModuleDefaults.keys()
  mut i = 0
  while i < ks.len():
    let k = ks[i]
    if savedVars.containsKey(k):
      newModuleDefaults.set(k, savedVars.get(k).unwrap())
    i = i + 1
  ret newModuleDefaults

pub fn hotSwapBytecodeModule(activeGeneration: int, activeFnCount: int, candidateFnCount: int, compileErrorCount: int): (int, int, bool) requires activeGeneration >= 0 ensures result[0] >= activeGeneration:
  if compileErrorCount != 0 or candidateFnCount <= 0:
    ret (activeGeneration, activeFnCount, false)
  ret (activeGeneration + 1, candidateFnCount, true)
