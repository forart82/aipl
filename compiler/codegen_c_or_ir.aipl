  if name == "isKeyPressed" or name == "isKeyDown" or name == "isKeyReleased" or name == "isKeyHeld" or name == "getKeyPressed" or name == "isMouseButtonPressed" or name == "isMouseButtonDown" or name == "isMouseButtonReleased" or name == "isMouseRightClicked" or name == "isMouseDoubleClicked" or name == "getMouseX" or name == "getMouseY" or name == "getMouseWheelMove" or name == "mouseWheelX" or name == "isMouseInRect" or name == "loadImage" or name == "decodeImage" or name == "imageWidth" or name == "imageHeight" or name == "drawSubImage" or name == "drawImage" or name == "drawImageEx" or name == "drawImageScaled" or name == "drawImageSub" or name == "saveImage" or name == "getImageWidth" or name == "getImageHeight" or name == "loadSound" or name == "decodeSound" or name == "getSoundDuration" or name == "loadFont" or name == "decodeFont" or name == "decodePngHeader" or name == "decodeWavHeader" or name == "decodeFontMetrics" or name == "decodeImageHandle" or name == "decodeSoundHandle" or name == "decodeFontHandle" or name == "cacheFont" or name == "cacheImage" or name == "cacheSound" or name == "getCachedFont" or name == "getCachedImage" or name == "getCachedSound" or name == "createAssetManager" or name == "createSpriteSheet" or name == "createAnimationClip" or name == "sampleAnimationFrame" or name == "drawSpriteFrame" or name == "drawAnimatedSprite" or name == "audioTime" or name == "playPcmBuffer" or name == "playSound" or name == "playSoundEx" or name == "playTone" or name == "playToneSweep" or name == "getAudioEnergy" or name == "getAudioBand" or name == "stopAllSounds" or name == "setMasterVolume" or name == "getVoicePosition":
    ret true
  if name == "FontHandle" or name == "ImageHandle" or name == "SoundHandle" or name == "Vec2" or name == "Vec3" or name == "Color" or name == "Rect" or name == "colorHex" or name == "hypot" or name == "dist" or name == "modFloat" or name == "randomRange" or name == "randomBytes" or name == "dayOfWeek" or name == "unixToCivil" or name == "padLeft" or name == "padRight" or name == "drawTextBox" or name == "drawTextRight" or name == "getTextInput" or name == "getCompositionText" or name == "getCompositionCursor" or name == "getClipboardText" or name == "setClipboardText" or name == "isGpuAccelerated" or name == "getGraphicsBackendName" or name == "setSoftwareRasterizer" or name == "isRectClicked" or name == "measureTextHeight" or name == "measureTextWidth" or name == "truncateText" or name == "mouseWheelY" or name == "gridInBounds" or name == "gridGet" or name == "gridNeighbors4" or name == "gridNeighbors8" or name == "gridFloodFill" or name == "drawPolyline" or name == "drawLineLoop" or name == "drawLineStrip" or name == "drawRectGradientH" or name == "drawRectGradientV" or name == "drawLinearGradient" or name == "drawGridTiles" or name == "drawCellGrid" or name == "drawRectBatch" or name == "drawCharGrid" or name == "withViewport" or name == "drawTextMiddle" or name == "drawTextAligned" or name == "measureTextSubstr" or name == "readPixels" or name == "saveCanvasSnapshot" or name == "pollKeyEvents" or name == "isKeyJustPressed" or name == "getPressedKey" or name == "isAnyKeyPressed" or name == "pollFileDropEvents" or name == "playToneEx" or name == "mapNew" or name == "setNew" or name == "setFromArray":
    ret true
  if name == "intBufferNew" or name == "intBufferGet" or name == "intBufferSet" or name == "intBufferLen" or name == "floatBufferNew" or name == "floatBufferGet" or name == "floatBufferSet" or name == "floatBufferLen" or name == "sumIntsFast" or name == "sumFloatsFast" or name == "dotProductFloats" or name == "axpyFloats" or name == "tensorDot" or name == "tensorMatmul" or name == "parallelMatmulInt":
    ret true
  if name == "arenaMark" or name == "arenaReset" or name == "arenaAllocatedBytes" or name == "arenaAlloc" or name == "arenaActiveDepth" or name == "arenaPopEvacuate" or name == "arenaStats" or name == "withScratchArena" or name == "gameLoop":
    ret true
  if name == "ffiOpen" or name == "ffiHasSymbol" or name == "ffiCallInt" or name == "ffiCallFloat" or name == "ffiCallStr" or name == "ffiClose" or name == "canvasBackendName" or name == "isHeadlessMode" or name == "endFrame" or name == "beginFrame" or name == "clearCanvas" or name == "getPixel" or name == "setWindowMode" or name == "getWindowMode":
    ret true
  if name == "regVmExec" or name == "executeRegBytecode" or name == "runRegVmComputedGoto" or name == "reg_vm_exec" or name == "reg_vm_fib":
    ret true
  if name == "ptrAlloc" or name == "ptrFree" or name == "ptrReadU8" or name == "ptrWriteU8" or name == "ptrReadI64" or name == "ptrWriteI64" or name == "sizeofType" or name == "bitcastF64ToI64" or name == "bitcastI64ToF64" or name == "rawSyscall" or name.startsWith("rawSyscall"):
    ret true
  ret false

pub fn isGuiOrAudioName(name: str): bool:
  if name == "drawPixelBuffer" or name == "drawCirclesSoA" or name == "drawRectsSoA" or name == "blendModeAlpha" or name == "blendModeAdditive":
    ret true
  if name == "initWindow" or name == "initCanvas" or name == "closeWindow" or name == "setTargetFps" or name == "setMaxFps" or name == "getMaxFps" or name == "getCurrentFps" or name == "getFrameTimeMs" or name == "setWindowTitle" or name == "setWindowSize" or name == "windowShouldClose" or name == "getScreenWidth" or name == "getScreenHeight" or name == "getFrameTime" or name == "getScaleFactor" or name == "beginDrawing" or name == "endDrawing" or name == "clearScreen" or name == "clearBackground" or name == "rgb" or name == "rgba" or name == "isWindowResized" or name == "setWindowMinSize" or name == "getContentScale" or name == "saveScreenshot" or name == "startVideoRecording" or name == "recordVideoFrame" or name == "stopVideoRecording" or name == "isRecordingVideo" or name == "setSingleInstance" or name == "isSingleInstance" or name == "targetWindowScreenshot" or name == "targetWindowRecord" or name == "targetWindowAction" or name == "targetWindowSeatAction" or name == "publishBotState" or name == "publishTurnState" or name == "listRunningWindows" or name == "setWindowPosition" or name == "setWindowMode" or name == "getWindowMode":
    ret true
  if name.startsWith("draw") or name.startsWith("setWindow") or name.startsWith("targetWindow") or name.startsWith("getScreen"):
    ret true
  // Step 17.2 (Bug #2): measureText/measureLabel/measureTextFont/measureTextWidth/measureTextHeight/measureTextSubstr
  if name.startsWith("measure"):
    ret true
  if name == "renderCube" or name == "begin3D" or name == "end3D" or name == "setDepthTest" or name == "clearDepth" or name == "beginWorldPass" or name == "endWorldPass" or name == "setUiTracking" or name == "pushMatrix" or name == "popMatrix" or name == "pushScissor" or name == "popScissor" or name == "translate2D" or name == "rotate2D" or name == "scale2D" or name == "shear2D" or name == "withViewport" or name == "isGpuAccelerated" or name == "getGraphicsBackendName" or name == "setSoftwareRasterizer":
    ret true
  if name.startsWith("isKey") or name.startsWith("getKey") or name.startsWith("isMouse") or name.startsWith("getMouse") or name.startsWith("mouseWheel") or name == "pollKeyEvents" or name == "pollFileDropEvents" or name == "getTextInput" or name == "getCompositionText" or name == "getCompositionCursor" or name == "getClipboardText" or name == "setClipboardText" or name == "isRectClicked":
    ret true
  if name == "loadImage" or name == "decodeImage" or name == "imageWidth" or name == "imageHeight" or name == "saveImage" or name == "getImageWidth" or name == "getImageHeight":
    ret true
  if name == "loadSound" or name == "decodeSound" or name == "getSoundDuration" or name == "loadFont" or name == "decodeFont" or name == "decodePngHeader" or name == "decodeWavHeader" or name == "decodeFontMetrics" or name == "decodeImageHandle" or name == "decodeSoundHandle" or name == "decodeFontHandle" or name.startsWith("cacheFont") or name.startsWith("cacheImage") or name.startsWith("cacheSound") or name.startsWith("getCached"):
    ret true
  if name == "createAssetManager" or name == "createSpriteSheet" or name == "createAnimationClip" or name == "sampleAnimationFrame":
    ret true
  if name == "audioTime" or name == "playPcmBuffer" or name.startsWith("playSound") or name.startsWith("playTone") or name.startsWith("getAudio") or name == "stopAllSounds" or name == "setMasterVolume" or name == "getVoicePosition":
    ret true
  if name == "canvasBackendName" or name == "isHeadlessMode" or name == "endFrame" or name == "beginFrame" or name == "clearCanvas" or name == "getPixel" or name == "gameLoop":
    ret true
  if name == "readPixels" or name == "readCanvasPixel" or name == "saveCanvasSnapshot" or name == "createImageFromPixels" or name == "createTextureFromRgba" or name == "createProceduralTexture" or name == "saveTextureToPpm" or name == "createIsometricSpriteSheet" or name == "setBlendMode" or name == "getBlendMode" or name == "blendModeAlpha" or name == "blendModeAdditive" or name == "blendModeMultiplied" or name == "blendModeScreen":
    ret true
  if name == "FontHandle" or name == "ImageHandle" or name == "SoundHandle" or name == "Color" or name == "color3" or name == "color4" or name == "colorHex":
    ret true
  ret false

// Step 18.3: GUI/audio runtime gating only looks at real Import declarations and real Call
// targets. Plain identifiers, member names, string contents and user-defined helpers that merely
// look like GUI names (e.g. a local `drawBoard` printing ASCII, or the compiler's own `Color`
// typechecking rules) no longer pull in the GUI/audio runtime.
fn isGuiCallTarget(hir: HirModule, name: str): bool:
  if name.len == 0:
    ret false
  if name.startsWith("canvas.") or name.startsWith("Canvas.") or name.startsWith("gui.") or name.startsWith("audio."):
    ret true
  if not isGuiOrAudioName(name):
    ret false
  // A user-defined function shadows the name unless it is still emitted as the runtime intrinsic.
  if hasHirFunction(hir, name) and not isIntrinsicName(name):
    ret false
  ret true

pub fn moduleUsesGuiOrAudio(hir: HirModule): bool:
  mut di = 0
  while di < hir.arena.decls.len:
    let d = hir.arena.decls[di]
    if d.kind == "Import":
      if d.importPath == "canvas" or d.importPath == "gui" or d.importPath == "audio" or d.importPath == "gpu" or d.importPath == "std/canvas" or d.importPath == "std/audio" or d.importPath == "std/gpu" or d.importPath == "std/gfx2d/canvas" or d.importPath == "std/audio/audio" or d.importPath == "std/gfx3d/gpu" or d.importPath.endsWith("/canvas.aipl") or d.importPath.endsWith("/audio.aipl") or d.importPath.endsWith("/gpu.aipl"):
        ret true
      mut si = 0
      while si < d.importSpecs.len:
        if isGuiOrAudioName(d.importSpecs[si]):
          ret true
        si += 1
    di += 1

  mut ei = 0
  while ei < hir.arena.exprs.len:
    let e = hir.arena.exprs[ei]
    if e.kind == "Call":
      if e.left >= 0 and e.left < hir.arena.exprs.len:
        let callee = hir.arena.exprs[e.left]
        if callee.kind == "Member":
          if isGuiCallTarget(hir, callee.strVal):
            ret true
          if callee.left >= 0 and callee.left < hir.arena.exprs.len:
            let recv = hir.arena.exprs[callee.left]
            if recv.kind == "Ident" and (recv.strVal == "canvas" or recv.strVal == "Canvas" or recv.strVal == "gui" or recv.strVal == "audio"):
              ret true
        elif isGuiCallTarget(hir, getCalleeBaseName(hir.arena, e.left)):
          ret true
      if e.op.len > 0 and isGuiCallTarget(hir, e.op):
        ret true
    elif e.kind == "Ident" and isIntrinsicName(e.strVal) and isGuiCallTarget(hir, e.strVal):
      // GUI intrinsics passed as values (`cbs.push(drawRect)`, `let f = drawCircle`).
      ret true
    ei += 1
  ret false

fn isEnumName(arena: AstArena, name: str): bool:
  if name.len == 0 or name.charCodeAt(0) < 65 or name.charCodeAt(0) > 90:
    ret false
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if d.kind == "Enum" and d.name == name:
      ret true
    i += 1
  ret false

fn isEnumVariant(arena: AstArena, enumName: str, variantName: str): bool:
  if variantName.len == 0 or variantName.charCodeAt(0) < 65 or variantName.charCodeAt(0) > 90:
    ret false
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if d.kind == "Enum" and (enumName.len == 0 or d.name == enumName):
      mut vi = 0
      while vi < d.variants.len:
        if d.variants[vi] == variantName:
          ret true
        vi += 1
    i += 1
  ret false

fn lookupEnumVariantIndex(arena: AstArena, enumName: str, variantName: str): int:
  if variantName.len == 0 or variantName.charCodeAt(0) < 65 or variantName.charCodeAt(0) > 90:
    ret -1
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if d.kind == "Enum" and (enumName.len == 0 or d.name == enumName):
      mut vi = 0
      while vi < d.variants.len:
        if d.variants[vi] == variantName:
          ret vi
        vi += 1
    i += 1
  ret -1

fn isCatchAllArm(arena: AstArena, name: str): bool:
  if name.startsWith("\"") or name.startsWith("'") or name.contains(":") or name.contains("|") or name.startsWith("(") or name.startsWith("["):
    ret false
  mut clean = name
  if clean.contains("."):
    let p = clean.split(".")
    if p.len > 1:
      clean = p[1]
  if clean == "_" or clean == "else":
    ret true
  if clean == "true" or clean == "false" or clean == "nil" or clean == "None" or clean == "Some" or clean == "Ok" or clean == "Err":
    ret false
  if clean.startsWith("\"") or clean.startsWith("'"):
    ret false
  let firstCh = clean.slice(0, 1)
  if firstCh == "-" or (firstCh >= "0" and firstCh <= "9"):
    ret false
  if isEnumVariant(arena, "", clean) or isEnumName(arena, clean):
    ret false
  ret true

fn wrapNegated(code: str, isNeg: bool): str:
  if isNeg:
    ret "aipl_not(" + code + ")"
  ret code

fn emitInterpolatedString(arena: AstArena, raw: str): str:
  mut parts: [str] = []
  mut curTextParts: [str] = []
  mut i = 0
  mut spanStart = 0
  while i < raw.len:
    if i + 1 < raw.len and raw.charCodeAt(i) == 92 and raw.charCodeAt(i + 1) == 123:
      if i > spanStart:
        curTextParts.push(raw.slice(spanStart, i))
      curTextParts.push("{")
      i += 2
      spanStart = i
      continue
    if i + 1 < raw.len and raw.charCodeAt(i) == 92 and raw.charCodeAt(i + 1) == 125:
      if i > spanStart:
        curTextParts.push(raw.slice(spanStart, i))
      curTextParts.push("}")
      i += 2
      spanStart = i
      continue
    if raw.charCodeAt(i) == 123:
      mut isValidInterp = false
      mut matchedCloseIdx = -1
      if i + 1 < raw.len:
        let fc = raw.charCodeAt(i + 1)
        if (fc >= 65 and fc <= 90) or (fc >= 97 and fc <= 122) or fc == 95 or fc == 40 or (fc >= 48 and fc <= 57) or fc == 34 or fc == 39 or fc == 45:
          mut scanIdx = i + 1
          mut scanDepth = 1
          mut inDQuote = false
          mut inSQuote = false
          mut onlyQuantifierChars = (fc >= 48 and fc <= 57)
          while scanIdx < raw.len and raw.charCodeAt(scanIdx) != 10:
            let sc = raw.charCodeAt(scanIdx)
            if inDQuote:
              onlyQuantifierChars = false
              if sc == 92 and scanIdx + 1 < raw.len:
                scanIdx += 2
                continue
              if sc == 34:
                inDQuote = false
              scanIdx += 1
              continue
            if inSQuote:
              onlyQuantifierChars = false
              if sc == 92 and scanIdx + 1 < raw.len:
                scanIdx += 2
                continue
              if sc == 39:
                inSQuote = false
              scanIdx += 1
              continue
            if sc == 34:
              inDQuote = true
              onlyQuantifierChars = false
              scanIdx += 1
              continue
            if sc == 39:
              inSQuote = true
              onlyQuantifierChars = false
              scanIdx += 1
              continue
            if sc == 123:
              scanDepth += 1
              onlyQuantifierChars = false
              scanIdx += 1
              continue
            if sc == 125:
              scanDepth -= 1
              if scanDepth == 0:
                matchedCloseIdx = scanIdx
                break
              scanIdx += 1
              continue
            if onlyQuantifierChars:
              if not ((sc >= 48 and sc <= 57) or sc == 44 or sc == 32 or sc == 9):
                onlyQuantifierChars = false
            scanIdx += 1
          if matchedCloseIdx >= 0 and not onlyQuantifierChars:
            let sliceInside = raw.slice(i + 1, matchedCloseIdx)
            mut isJson = false
            if fc == 34:
              mut qi = 1
              while qi < sliceInside.len and sliceInside.charCodeAt(qi) != 34:
                if sliceInside.charCodeAt(qi) == 92:
                  qi += 2
                else:
                  qi += 1
              if qi < sliceInside.len:
                mut afterQ = qi + 1
                while afterQ < sliceInside.len and sliceInside.charCodeAt(afterQ) == 32:
                  afterQ += 1
                if afterQ < sliceInside.len and sliceInside.charCodeAt(afterQ) == 58:
                  isJson = true
            if not isJson:
              isValidInterp = true
      if not isValidInterp:
        i += 1
        continue

      if i > spanStart:
        curTextParts.push(raw.slice(spanStart, i))
      if curTextParts.len > 0:
        let curText = curTextParts.join("")
        if curText.len > 0:
          parts.push(emitCStringVal(curText))
        curTextParts = []
      let inner = raw.slice(i + 1, matchedCloseIdx)
      i = matchedCloseIdx + 1
      spanStart = i
      if inner.len > 0:
        mut hasSpec = false
        mut exprPart = inner
        mut fmtSpec = ""
        mut ci = inner.len - 1
        mut inQuotes = false
        mut parenDepth = 0
        while ci >= 0:
          let cch = inner.slice(ci, ci + 1)
          if cch == "\"" or cch == "'":
            inQuotes = not inQuotes
          elif not inQuotes and cch == ")":
            parenDepth += 1
          elif not inQuotes and cch == "(":
            parenDepth -= 1
          elif not inQuotes and parenDepth == 0 and cch == ":":
            exprPart = inner.slice(0, ci)
            fmtSpec = inner.slice(ci + 1, inner.len)
            hasSpec = true
            ci = -1
          ci -= 1

        if hasSpec:
          let cToks = tokenizeAipl(exprPart, 0)
          mut cArena = parseModule(cToks, exprPart)
          mut subExprId = if cArena.topStmts.len > 0: cArena.stmts[cArena.topStmts[0]].exprId else: -1
          if subExprId < 0:
            let pRes = parseExprPrec(cToks, cArena, 0, 1)
            subExprId = pRes.nodeId
          if subExprId >= 0:
            cArena.decls = arena.decls
            cArena.stmts = arena.stmts
            cArena.types = arena.types
            let subCode = emitCExpr(cArena, subExprId)
            parts.push("aipl_format_val(" + subCode + ", \"" + fmtSpec + "\")")
          else:
            parts.push("aipl_str(\"\")")
        else:
          let subToks = tokenizeAipl(inner, 0)
          mut subArena = parseModule(subToks, inner)
          mut subExprId = if subArena.topStmts.len > 0: subArena.stmts[subArena.topStmts[0]].exprId else: -1
          if subExprId < 0:
            let pRes = parseExprPrec(subToks, subArena, 0, 1)
            subExprId = pRes.nodeId
          if subExprId >= 0:
            subArena.decls = arena.decls
            subArena.stmts = arena.stmts
            subArena.types = arena.types
            let subCode = emitCExpr(subArena, subExprId)
            parts.push("aipl_to_str(" + subCode + ")")
          else:
            parts.push("aipl_str(\"\")")
    else:
      i += 1
  if i > spanStart:
    curTextParts.push(raw.slice(spanStart, i))
  if curTextParts.len > 0:
    let curText = curTextParts.join("")
    if curText.len > 0:
      parts.push(emitCStringVal(curText))
  if parts.len == 0:
    ret "aipl_str(\"\")"
  if parts.len == 1:
    ret parts[0]
  mut res = parts[0]
  mut pi = 1
  while pi < parts.len:
    res = "aipl_add(" + res + ", " + parts[pi] + ")"
    pi += 1
  ret res

fn arenaHasVarDecl(arena: AstArena, name: str): bool:
  mut i = 0
  while i < arena.stmts.len:
    let st = arena.stmts[i]
    if (st.kind == "VarDecl" or st.kind == "TupleVarDecl" or st.kind == "For" or st.kind == "Let") and (st.name == name or (st.kind == "TupleVarDecl" and st.name.contains(name))):
      ret true
    i += 1
  mut j = 0
  while j < arena.decls.len:
    let d = arena.decls[j]
    if d.kind == "Fn" or d.kind == "FnDecl" or d.kind == "Function":
      mut k = 0
      while k < d.params.len:
        if d.params[k] == name:
          ret true
        k += 1
    j += 1
  mut li = 0
  while li < arena.exprs.len:
    let le = arena.exprs[li]
    if le.kind == "Lambda":
      mut lk = 0
      while lk < le.names.len:
        if le.names[lk] == name:
          ret true
        lk += 1
    li += 1
  ret false

fn getCalleeBaseName(arena: AstArena, exprId: int): str:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret ""
  let e = arena.exprs[exprId]
  if e.kind == "Ident":
    mut s = e.strVal
    if s.contains("["):
      let bIdx = s.indexOf("[")
      if bIdx > 0:
        s = s.slice(0, bIdx)
    ret s
  if e.kind == "Index" or e.kind == "Index2D":
    ret getCalleeBaseName(arena, e.left)
  if e.kind == "Member":
    ret getCalleeBaseName(arena, e.left)
  ret ""

fn declFnArity(arena: AstArena, name: str): int:
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if (d.kind == "Fn" or d.kind == "FnDecl" or d.kind == "Function") and d.name == name:
      ret d.params.len
    i += 1
  ret -1

fn isImportAliasName(arena: AstArena, name: str): bool:
  if name.len == 0:
    ret false
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if d.kind == "Import" and d.importAlias == name:
      ret true
    i += 1
  ret false

fn isKnownModuleName(arena: AstArena, name: str): bool:
  if name == "json" or name == "ffi" or name == "FFI" or name == "canvas" or name == "Canvas" or name == "thread" or name == "Thread" or name == "arena" or name == "Box" or name == "ByteBuffer" or name == "int" or name == "float" or name == "Math" or name == "Audio":
    ret true
  if isKnownModule(name):
    ret true
  if isEnumName(arena, name):
    ret true
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if d.kind == "Import":
      if d.importAlias == name:
        ret true
      if d.importPath == name or d.importPath == "std/" + name or d.importPath == "std." + name or d.importPath.endsWith("/" + name) or d.importPath.endsWith("/" + name + ".aipl"):
        ret true
    i += 1
  ret false

fn exprTreeContains(arena: AstArena, rootId: int, targetId: int): bool:
  if rootId == targetId:
    ret true
  if rootId < 0 or rootId >= arena.exprs.len:
    ret false
  let e = arena.exprs[rootId]
  if e.left >= 0 and exprTreeContains(arena, e.left, targetId):
    ret true
  if e.right >= 0 and exprTreeContains(arena, e.right, targetId):
    ret true
  if e.cond >= 0 and exprTreeContains(arena, e.cond, targetId):
    ret true
  mut i = 0
  while i < e.children.len:
    if exprTreeContains(arena, e.children[i], targetId):
      ret true
    i += 1
  ret false

fn stmtTreeContainsExpr(arena: AstArena, stmtId: int, targetExprId: int): bool:
  if stmtId < 0 or stmtId >= arena.stmts.len:
    ret false
  let st = arena.stmts[stmtId]
  if st.exprId >= 0 and exprTreeContains(arena, st.exprId, targetExprId):
    ret true
  if st.condExpr >= 0 and exprTreeContains(arena, st.condExpr, targetExprId):
    ret true
  mut i = 0
  while i < st.bodyStmts.len:
    if stmtTreeContainsExpr(arena, st.bodyStmts[i], targetExprId):
      ret true
    i += 1
  mut j = 0
  while j < st.elseStmts.len:
    if stmtTreeContainsExpr(arena, st.elseStmts[j], targetExprId):
      ret true
    j += 1
  ret false

fn findEnclosingFnDeclIdx(arena: AstArena, exprId: int): int:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret -1
  let targetLine = arena.exprs[exprId].span.line
  let targetFile = arena.exprs[exprId].span.fileId
  if targetLine > 0:
    mut bestIdx = -1
    mut bestLine = -1
    mut i = 0
    while i < arena.decls.len:
      let d = arena.decls[i]
      if (d.kind == "Fn" or d.kind == "Function") and d.span.fileId == targetFile and d.span.line > 0:
        if d.span.line <= targetLine and d.span.line > bestLine:
          bestIdx = i
          bestLine = d.span.line
      i += 1
    if bestIdx >= 0:
      mut nextDeclLine = 99999999
      mut j = bestIdx + 1
      while j < arena.decls.len:
        let nd = arena.decls[j]
        if nd.span.fileId == targetFile and nd.span.line > bestLine and nd.span.line < nextDeclLine:
          nextDeclLine = nd.span.line
        j += 1
      if targetLine < nextDeclLine:
        ret bestIdx
  ret -1

fn extractArrayElemTypeName(fullType: str): str:
  mut s = fullType.replace("&", "").replace("mut", "").trim()
  if s.startsWith("Array[") and s.endsWith("]"):
    ret s.slice(6, s.len - 1).trim()
  if s.startsWith("[") and s.endsWith("]"):
    mut inner = s.slice(1, s.len - 1).trim()
    if inner.contains(";"):
      let semi = inner.indexOf(";")
      if semi > 0:
        inner = inner.slice(0, semi).trim()
    ret inner
  if s.startsWith("Map[") and s.endsWith("]"):
    let inner = s.slice(4, s.len - 1).trim()
    let comma = inner.indexOf(",")
    if comma >= 0:
      ret inner.slice(comma + 1, inner.len).trim()
  ret ""

fn lookupVarTypeNameInStmts(arena: AstArena, stmtIds: [int], varName: str, exprId: int = -1, depth: int = 0): str:
  if depth > 8:
    ret ""
  mut i = stmtIds.len - 1
  while i >= 0:
    let sid = stmtIds[i]
    if sid >= 0 and sid < arena.stmts.len:
      let st = arena.stmts[sid]
      if (st.kind == "VarDecl" or st.kind == "TupleVarDecl" or st.kind == "Let") and st.name == varName:
        if st.typeId >= 0 and st.typeId < arena.types.len:
          ret resolveTypeName(arena, st.typeId)
        if st.exprId >= 0 and st.exprId < arena.exprs.len:
          let effId = if exprId >= 0: exprId else: st.exprId
          let rhs = arena.exprs[st.exprId]
          if rhs.kind == "Array" and rhs.children.len > 0:
            let elemSt = resolveExprStructType(arena, rhs.children[0], effId, depth + 1)
            if elemSt.len > 0:
              ret "Array[" + elemSt + "]"
          if rhs.kind == "Call":
            if rhs.left >= 0 and rhs.left < arena.exprs.len and arena.exprs[rhs.left].kind == "Member":
              let mem = arena.exprs[rhs.left]
              let recType = resolveExprStructType(arena, mem.left, effId, depth + 1)
              if recType.len > 0:
                let fnRet = lookupDeclFunctionRetType(arena, recType + "_" + mem.strVal)
                if fnRet.len > 0:
                  ret fnRet
            let cBase = getCalleeBaseName(arena, rhs.left)
            if cBase == "cloneStruct" and rhs.children.len > 0:
              let cloneTn = resolveExprStructType(arena, rhs.children[0], effId, depth + 1)
              if cloneTn.len > 0:
                ret cloneTn
            if cBase.len > 0:
              let fnRet = lookupDeclFunctionRetType(arena, cBase)
              if fnRet.len > 0:
                ret fnRet
          if rhs.kind == "Member":
            let parentType = resolveExprStructType(arena, rhs.left, effId, depth + 1)
            if parentType.len > 0:
              let fType = lookupStructFieldType(arena, parentType, rhs.strVal)
              if fType.len > 0:
                ret fType
          if rhs.kind == "Ident" and rhs.strVal != varName and rhs.strVal.len > 0:
            ret lookupVarTypeName(arena, rhs.strVal, effId, depth + 1)
      if st.bodyStmts.len > 0:
        let nest = lookupVarTypeNameInStmts(arena, st.bodyStmts, varName, exprId, depth + 1)
        if nest.len > 0:
          ret nest
      if st.elseStmts.len > 0:
        let nest = lookupVarTypeNameInStmts(arena, st.elseStmts, varName, exprId, depth + 1)
        if nest.len > 0:
          ret nest
    i -= 1
  ret ""

fn lookupVarTypeName(arena: AstArena, varName: str, exprId: int = -1, depth: int = 0): str:
  if depth > 8:
    ret ""
  if exprId >= 0:
    let fnIdx = findEnclosingFnDeclIdx(arena, exprId)
    if fnIdx >= 0:
      let d = arena.decls[fnIdx]
      mut k = 0
      while k < d.params.len:
        if d.params[k] == varName:
          if k < d.paramTypes.len and d.paramTypes[k] >= 0 and d.paramTypes[k] < arena.types.len:
            ret resolveTypeName(arena, d.paramTypes[k])
        k += 1
      if d.bodyStmts.len > 0:
        let localTn = lookupVarTypeNameInStmts(arena, d.bodyStmts, varName, exprId, depth + 1)
        if localTn.len > 0:
          ret localTn
      ret ""
  if arena.topStmts.len > 0:
    ret lookupVarTypeNameInStmts(arena, arena.topStmts, varName, exprId, depth + 1)
  ret ""

fn resolveIndexElemStructType(arena: AstArena, arrExprId: int, exprId: int, depth: int = 0): str:
  if depth > 8 or arrExprId < 0 or arrExprId >= arena.exprs.len:
    ret ""
  let arrNode = arena.exprs[arrExprId]
  if arrNode.kind == "Ident":
    let varTy = lookupVarTypeName(arena, arrNode.strVal, exprId, depth + 1)
    let elemTy = cleanStructTypeName(extractArrayElemTypeName(varTy))
    if elemTy.len > 0 and isStructName(arena, elemTy):
      ret elemTy
  if arrNode.kind == "Member":
    let parentType = resolveExprStructType(arena, arrNode.left, exprId, depth + 1)
    if parentType.len > 0:
      let fieldType = lookupStructFieldType(arena, parentType, arrNode.strVal)
      let elemTy = cleanStructTypeName(extractArrayElemTypeName(fieldType))
      if elemTy.len > 0 and isStructName(arena, elemTy):
        ret elemTy
  if arrNode.kind == "Call":
    if arrNode.left >= 0 and arrNode.left < arena.exprs.len and arena.exprs[arrNode.left].kind == "Member":
      let mem = arena.exprs[arrNode.left]
      let recType = resolveExprStructType(arena, mem.left, exprId, depth + 1)
      if recType.len > 0:
        let fnRet = lookupDeclFunctionRetType(arena, recType + "_" + mem.strVal)
        let elemTy = cleanStructTypeName(extractArrayElemTypeName(fnRet))
        if elemTy.len > 0 and isStructName(arena, elemTy):
          ret elemTy
    let cBase = getCalleeBaseName(arena, arrNode.left)
    if cBase.len > 0:
      let fnRet = lookupDeclFunctionRetType(arena, cBase)
      let elemTy = cleanStructTypeName(extractArrayElemTypeName(fnRet))
      if elemTy.len > 0 and isStructName(arena, elemTy):
        ret elemTy
  if arrNode.kind == "Array" and arrNode.children.len > 0:
    let elemTy = resolveExprStructType(arena, arrNode.children[0], exprId, depth + 1)
    if elemTy.len > 0 and isStructName(arena, elemTy):
      ret elemTy
  ret ""

fn lookupVarStructTypeInStmts(arena: AstArena, stmtIds: [int], varName: str, contextExprId: int = -1, depth: int = 0): str:
  if depth > 8:
    ret ""
  mut i = stmtIds.len - 1
  while i >= 0:
    let sid = stmtIds[i]
    if sid >= 0 and sid < arena.stmts.len:
      let st = arena.stmts[sid]
      if (st.kind == "VarDecl" or st.kind == "TupleVarDecl" or st.kind == "Let") and st.name == varName:
        if st.typeId >= 0 and st.typeId < arena.types.len:
          let tn = cleanStructTypeName(resolveTypeName(arena, st.typeId))
          if isStructName(arena, tn):
            ret tn
        if st.exprId >= 0 and st.exprId < arena.exprs.len:
          let effId = if contextExprId >= 0: contextExprId else: st.exprId
          let rhs = arena.exprs[st.exprId]
          if rhs.kind == "Ident":
            if rhs.strVal != varName and rhs.strVal.len > 0:
              let aliasTy = if isStructName(arena, rhs.strVal): rhs.strVal else: lookupVarStructType(arena, rhs.strVal, effId, depth + 1)
              if aliasTy.len > 0:
                ret aliasTy
          elif rhs.kind == "Call":
            if rhs.left >= 0 and rhs.left < arena.exprs.len and arena.exprs[rhs.left].kind == "Member":
              let mem = arena.exprs[rhs.left]
              if mem.left >= 0 and mem.left < arena.exprs.len:
                let isSelfRecv = (arena.exprs[mem.left].kind == "Ident" and arena.exprs[mem.left].strVal == varName)
                if not isSelfRecv:
                  mut recType = resolveExprStructType(arena, mem.left, effId, depth + 1)
                  if recType.len == 0 and arena.exprs[mem.left].kind == "Ident":
                    recType = lookupVarStructTypeInStmts(arena, stmtIds, arena.exprs[mem.left].strVal, effId, depth + 1)
                  if recType.len > 0 and isStructName(arena, recType):
                    let methFn = recType + "_" + mem.strVal
                    let retTn = cleanStructTypeName(lookupDeclFunctionRetType(arena, methFn))
                    if retTn.len > 0 and isStructName(arena, retTn):
                      ret retTn
                    if mem.strVal == "new" or mem.strVal == "default" or mem.strVal == "unwrap" or mem.strVal == "expect" or mem.strVal == "unwrapOr":
                      ret recType
            let cBase = getCalleeBaseName(arena, rhs.left)
            if cBase == "cloneStruct" and rhs.children.len > 0:
              let cloneTn = resolveExprStructType(arena, rhs.children[0], effId, depth + 1)
              if cloneTn.len > 0 and isStructName(arena, cloneTn):
                ret cloneTn
            if isStructName(arena, cBase):
              ret cBase
            if cBase.endsWith("_new"):
              let prefix = cBase.slice(0, cBase.len - 4)
              if isStructName(arena, prefix):
                ret prefix
            if cBase.len > 0:
              let fnRet = cleanStructTypeName(lookupDeclFunctionRetType(arena, cBase))
              if fnRet.len > 0 and isStructName(arena, fnRet):
                ret fnRet
            if rhs.strVal.len > 0:
              if isStructName(arena, rhs.strVal):
                ret rhs.strVal
              let fnRet2 = cleanStructTypeName(lookupDeclFunctionRetType(arena, rhs.strVal))
              if fnRet2.len > 0 and isStructName(arena, fnRet2):
                ret fnRet2
          elif rhs.kind == "StructLit":
            if rhs.strVal.len > 0:
              let sn = cleanStructTypeName(rhs.strVal)
              if isStructName(arena, sn):
                ret sn
            elif rhs.left >= 0 and rhs.left < arena.exprs.len:
              if arena.exprs[rhs.left].kind == "Ident":
                let baseVar = arena.exprs[rhs.left].strVal
                if baseVar != varName:
                  let recType = lookupVarStructType(arena, baseVar, effId, depth + 1)
                  if recType.len > 0:
                    ret recType
              else:
                let recType = resolveExprStructType(arena, rhs.left, effId, depth + 1)
                if recType.len > 0:
                  ret recType
          elif rhs.kind == "Index" or rhs.kind == "Member" or rhs.kind == "IfExpr" or rhs.kind == "Ternary":
            let infTy = resolveExprStructType(arena, st.exprId, effId, depth + 1)
            if infTy.len > 0:
              ret infTy
      elif st.kind == "For" and st.name == varName and st.exprId >= 0:
        let effId = if contextExprId >= 0: contextExprId else: st.exprId
        let elemTy = resolveIndexElemStructType(arena, st.exprId, effId, depth + 1)
        if elemTy.len > 0 and isStructName(arena, elemTy):
          ret elemTy

      if st.bodyStmts.len > 0:
        let nest = lookupVarStructTypeInStmts(arena, st.bodyStmts, varName, contextExprId, depth + 1)
        if nest.len > 0:
          ret nest
      if st.elseStmts.len > 0:
        let nest = lookupVarStructTypeInStmts(arena, st.elseStmts, varName, contextExprId, depth + 1)
        if nest.len > 0:
          ret nest
    i -= 1
  ret ""

fn lookupVarStructType(arena: AstArena, varName: str, exprId: int = -1, depth: int = 0): str:
  if depth > 8:
    ret ""
  // Priority 1: If exprId is provided, check enclosing function declaration's params and locals
  if exprId >= 0:
    let fnIdx = findEnclosingFnDeclIdx(arena, exprId)
    if fnIdx >= 0:
      let d = arena.decls[fnIdx]
      // Check parameters of enclosing function
      mut k = 0
      while k < d.params.len:
        if d.params[k] == varName:
          if k < d.paramTypes.len and d.paramTypes[k] >= 0 and d.paramTypes[k] < arena.types.len:
            let tn = cleanStructTypeName(resolveTypeName(arena, d.paramTypes[k]))
            if isStructName(arena, tn):
              ret tn
        k += 1
      // If receiver 'self', also check if enclosing function is Type_method
      if varName == "self" and d.name.contains("_"):
        let us = d.name.indexOf("_")
        if us > 0:
          let prefix = d.name.slice(0, us)
          if isStructName(arena, prefix):
            ret prefix
      // Check local variable statements in enclosing function body
      if d.bodyStmts.len > 0:
        let localTn = lookupVarStructTypeInStmts(arena, d.bodyStmts, varName, exprId, depth + 1)
        if localTn.len > 0:
          ret localTn
      // For 'self', do NOT escape enclosing function scope to another function
      if varName == "self":
        ret ""

  // Priority 2: Fallback to global statements search
  if arena.topStmts.len > 0:
    let topTn = lookupVarStructTypeInStmts(arena, arena.topStmts, varName, exprId, depth + 1)
    if topTn.len > 0:
      ret topTn

  // Priority 3: Only check decl parameters for non-self variables if no enclosing function was found
  if varName != "self" and exprId < 0:
    mut j = 0
    while j < arena.decls.len:
      let d = arena.decls[j]
      if d.kind == "Fn" or d.kind == "Function":
        mut k = 0
        while k < d.params.len:
          if d.params[k] == varName:
            if k < d.paramTypes.len and d.paramTypes[k] >= 0 and d.paramTypes[k] < arena.types.len:
              let tn = cleanStructTypeName(resolveTypeName(arena, d.paramTypes[k]))
              if isStructName(arena, tn):
                ret tn
          k += 1
      j += 1
  ret ""

fn resolveExprStructType(arena: AstArena, exprId: int, callExprId: int = -1, depth: int = 0): str:
  if depth > 8 or exprId < 0 or exprId >= arena.exprs.len:
    ret ""
  let effExprId = if callExprId >= 0: callExprId else: exprId
  let e = arena.exprs[exprId]
  if e.kind == "Ident":
    let varName = e.strVal
    if isStructName(arena, varName):
      ret varName
    ret lookupVarStructType(arena, varName, effExprId, depth + 1)
  if e.kind == "StructLit":
    if e.strVal.len > 0:
      let sn = cleanStructTypeName(e.strVal)
      if isStructName(arena, sn):
        ret sn
    if e.left >= 0 and e.left < arena.exprs.len:
      ret resolveExprStructType(arena, e.left, effExprId, depth + 1)
  if e.kind == "Call":
    if e.left >= 0 and e.left < arena.exprs.len and arena.exprs[e.left].kind == "Member":
      let mem = arena.exprs[e.left]
      let recType = resolveExprStructType(arena, mem.left, effExprId, depth + 1)
      if recType.len > 0 and isStructName(arena, recType):
        let methFn = recType + "_" + mem.strVal
        let retTn = cleanStructTypeName(lookupDeclFunctionRetType(arena, methFn))
        if retTn.len > 0 and isStructName(arena, retTn):
          ret retTn
        if mem.strVal == "new" or mem.strVal == "default" or mem.strVal == "unwrap" or mem.strVal == "expect" or mem.strVal == "unwrapOr":
          ret recType
    let cBase = getCalleeBaseName(arena, e.left)
    if cBase == "cloneStruct" and e.children.len > 0:
      let cloneTn = resolveExprStructType(arena, e.children[0], effExprId, depth + 1)
      if cloneTn.len > 0 and isStructName(arena, cloneTn):
        ret cloneTn
    if isStructName(arena, cBase):
      ret cBase
    if cBase.endsWith("_new"):
      let prefix = cBase.slice(0, cBase.len - 4)
      if isStructName(arena, prefix):
        ret prefix
    if cBase.len > 0:
      let fnRet = cleanStructTypeName(lookupDeclFunctionRetType(arena, cBase))
      if fnRet.len > 0 and isStructName(arena, fnRet):
        ret fnRet
    if e.strVal.len > 0:
      if isStructName(arena, e.strVal):
        ret e.strVal
      let fnRet2 = cleanStructTypeName(lookupDeclFunctionRetType(arena, e.strVal))
      if fnRet2.len > 0 and isStructName(arena, fnRet2):
        ret fnRet2
  if e.kind == "Member":
    let parentType = resolveExprStructType(arena, e.left, effExprId, depth + 1)
    if parentType.len > 0:
      let fType = cleanStructTypeName(lookupStructFieldType(arena, parentType, e.strVal))
      if isStructName(arena, fType):
        ret fType
  if e.kind == "Index":
    let elemType = resolveIndexElemStructType(arena, e.left, effExprId, depth + 1)
    if elemType.len > 0 and isStructName(arena, elemType):
      ret elemType
  if e.kind == "IfExpr" or e.kind == "Ternary":
    let thenId = if e.cond >= 0: e.left else: e.right
    let elseId = if e.cond >= 0: e.right else: (if e.children.len > 0: e.children[0] else: -1)
    let thenTy = resolveExprStructType(arena, thenId, effExprId, depth + 1)
    if thenTy.len > 0:
      ret thenTy
    ret resolveExprStructType(arena, elseId, effExprId, depth + 1)
  ret ""

fn emitCStructMethodCall(arena: AstArena, e: ExprNode, mem: ExprNode, recvCode: str, isNegatedMethod: bool, structType: str, method: str): str:
  let uMethod = structType + "_" + method
  let varName = if mem.left >= 0 and arena.exprs[mem.left].kind == "Ident": arena.exprs[mem.left].strVal else: ""

  mut prependRecv = true
  if varName.len > 0 and isStructName(arena, varName):
    prependRecv = false
  elif hasDeclFunction(arena, uMethod):
    let expParamCount = lookupDeclFunctionParamCount(arena, uMethod)
    if e.children.len >= expParamCount and expParamCount > 0:
      prependRecv = false

  mut uArgs: [str] = []
  if prependRecv:
    let recvIsRef = lookupDeclFunctionParamTypeIsRef(arena, uMethod, 0)
    if recvIsRef and mem.left >= 0 and arena.exprs[mem.left].kind == "Ident":
      uArgs.push("&v_" + arena.exprs[mem.left].strVal)
    else:
      uArgs.push(recvCode)

  mut uai = 0
  while uai < e.children.len:
    let paramIdx = if prependRecv: uai + 1 else: uai
    let isRef = lookupDeclFunctionParamTypeIsRef(arena, uMethod, paramIdx)
    let childId = e.children[uai]
    if isRef and childId >= 0 and arena.exprs[childId].kind == "Ident":
      uArgs.push("&v_" + arena.exprs[childId].strVal)
    else:
      uArgs.push(emitCExpr(arena, childId))
    uai += 1

  if hasDeclFunction(arena, uMethod):
    let expParamCount = lookupDeclFunctionParamCount(arena, uMethod)
    while uArgs.len < expParamCount:
      let defExprId = lookupDeclFunctionDefaultExpr(arena, uMethod, uArgs.len)
      if defExprId >= 0:
        uArgs.push(emitCExpr(arena, defExprId))
      else:
        uArgs.push("aipl_int(0)")
  elif (uMethod == "padLeft" or uMethod == "padRight") and uArgs.len == 2:
    uArgs.push("aipl_str(\" \")")
  ret wrapNegated("aipl_fn_" + uMethod + "(" + uArgs.join(", ") + ")", isNegatedMethod)

fn findStructMethodName(arena: AstArena, method: str): str:
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if (d.kind == "Function" or d.kind == "Fn") and d.name.endsWith("_" + method):
      ret d.name
    i += 1
  ret ""

fn resolveLambdaNode(arena: AstArena, exprId: int): ExprNode:
  if exprId >= 0 and exprId < arena.exprs.len:
    let e = arena.exprs[exprId]
    if e.kind == "Lambda":
      ret e
    if e.kind == "Ident":
      mut si = arena.stmts.len - 1
      while si >= 0:
        let st = arena.stmts[si]
        if st.kind == "VarDecl" or st.kind == "Let":
          mut vName = st.name
          if vName.contains(":"):
            let p = vName.split(":")
            vName = p[0].trim()
          if vName == e.strVal and st.exprId >= 0 and st.exprId < arena.exprs.len:
            let targetE = arena.exprs[st.exprId]
            if targetE.kind == "Lambda":
              ret targetE
        elif st.kind == "Assign":
          if st.condExpr >= 0 and arena.exprs[st.condExpr].kind == "Ident" and arena.exprs[st.condExpr].strVal == e.strVal and st.exprId >= 0 and st.exprId < arena.exprs.len:
            let targetE = arena.exprs[st.exprId]
            if targetE.kind == "Lambda":
              ret targetE
        si -= 1
    ret e
  ret arena.exprs[0]

pub fn canUnboxIntExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "IntLit" or e.kind == "Int":
    ret true
  if e.kind == "Unary":
    if e.op == "-" or e.op == "~":
      ret canUnboxIntExpr(arena, e.left)
    ret false
  if e.kind == "Binary":
    let op = e.op
    if op == "+" or op == "-" or op == "*" or op == "/" or op == "%" or op == "&" or op == "|" or op == "^" or op == "<<" or op == ">>" or op == "<" or op == "<=" or op == ">" or op == ">=" or op == "==" or op == "!=":
      ret canUnboxIntExpr(arena, e.left) and canUnboxIntExpr(arena, e.right)
    ret false
  ret false

pub fn isSideEffectFreeScalarIdentOrLit(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "IntLit" or e.kind == "Int":
    ret true
  if e.kind == "Ident":
    let nm = e.strVal
    if nm == "v1" or nm == "v2" or nm == "v3" or nm == "u1" or nm == "u2" or nm == "u3":
      ret false
    ret true
  ret false

pub fn isSameScalarIdent(arena: AstArena, leftId: int, rightId: int): bool:
  if leftId < 0 or leftId >= arena.exprs.len or rightId < 0 or rightId >= arena.exprs.len:
    ret false
  let l = arena.exprs[leftId]
  let r = arena.exprs[rightId]
  if l.kind == "Ident" and r.kind == "Ident" and l.strVal == r.strVal and l.strVal.len > 0:
    let nm = l.strVal
    if nm == "v1" or nm == "v2" or nm == "v3" or nm == "u1" or nm == "u2" or nm == "u3":
      ret false
    ret true
  ret false

pub fn emitUnboxedIntExpr(arena: AstArena, exprId: int): str:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret "((int64_t)0)"
  let e = arena.exprs[exprId]
  if e.kind == "IntLit" or e.kind == "Int":
    let s = if e.strVal.len > 0: e.strVal else: str(e.intVal)
    ret "(int64_t)" + s
  if e.kind == "Unary":
    if e.op == "-" or e.op == "~":
      ret "(" + e.op + emitUnboxedIntExpr(arena, e.left) + ")"
  if e.kind == "Binary":
    let op = e.op
    if op == "-":
      if isFoldableIntExpr(arena, e.right) and evalFoldableIntExpr(arena, e.right) == 0:
        ret emitUnboxedIntExpr(arena, e.left)
      if isSameScalarIdent(arena, e.left, e.right):
        ret "((int64_t)0)"
    if op == "*":
      if isFoldableIntExpr(arena, e.right) and evalFoldableIntExpr(arena, e.right) == 0 and isSideEffectFreeScalarIdentOrLit(arena, e.left):
        ret "((int64_t)0)"
      if isFoldableIntExpr(arena, e.left) and evalFoldableIntExpr(arena, e.left) == 0 and isSideEffectFreeScalarIdentOrLit(arena, e.right):
        ret "((int64_t)0)"
      if isFoldableIntExpr(arena, e.right) and evalFoldableIntExpr(arena, e.right) == 1:
        ret emitUnboxedIntExpr(arena, e.left)
      if isFoldableIntExpr(arena, e.left) and evalFoldableIntExpr(arena, e.left) == 1:
        ret emitUnboxedIntExpr(arena, e.right)
    let l = emitUnboxedIntExpr(arena, e.left)
    let r = emitUnboxedIntExpr(arena, e.right)
    if op == "/":
      ret "(" + r + " != 0 ? " + l + " / " + r + " : 0)"
    if op == "%":
      ret "(" + r + " != 0 ? " + l + " % " + r + " : 0)"
    ret "(" + l + " " + op + " " + r + ")"
  ret "((int64_t)0)"

pub fn exprEscapesFunction(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "IntLit" or e.kind == "Int" or e.kind == "FloatLit" or e.kind == "Float" or e.kind == "BoolLit" or e.kind == "Bool":
    ret false
  if e.kind == "Unary":
    ret exprEscapesFunction(arena, e.left)
  if e.kind == "Binary":
    ret exprEscapesFunction(arena, e.left) or exprEscapesFunction(arena, e.right)
  if e.kind == "Call" or e.kind == "MethodCall":
    ret true
  if e.kind == "Lambda":
    ret true
  if e.kind == "ArrayLit" or e.kind == "MapLit" or e.kind == "StructLit":
    ret true
  if e.kind == "Ident":
    ret false
  ret true

pub fn isFoldableIntExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "IntLit" or e.kind == "Int":
    if e.strVal.len > 15 or e.strVal == "-9223372036854775808" or e.strVal.startsWith("0x") or e.strVal.startsWith("0X"):
      ret false
    ret true
  if e.kind == "Unary":
    if e.op == "-" or e.op == "~":
      ret isFoldableIntExpr(arena, e.left)
    ret false
  if e.kind == "Binary":
    let op = e.op
    if op == "+" or op == "-" or op == "*" or op == "/" or op == "%" or op == "&" or op == "|" or op == "^" or op == "<<" or op == ">>":
      if not isFoldableIntExpr(arena, e.left) or not isFoldableIntExpr(arena, e.right):
        ret false
      let lv = evalFoldableIntExpr(arena, e.left)
      let rv = evalFoldableIntExpr(arena, e.right)
      if op == "/" or op == "%":
        if rv == 0:
          ret false
      if op == "<<" or op == ">>":
        if rv < 0 or rv > 30:
          ret false
      if op == "*":
        if lv < -100000000 or lv > 100000000 or rv < -100000000 or rv > 100000000:
          ret false
      ret true
  ret false

pub fn evalFoldableIntExpr(arena: AstArena, exprId: int): int:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret 0
  let e = arena.exprs[exprId]
  if e.kind == "IntLit" or e.kind == "Int":
    ret e.intVal
  if e.kind == "Unary":
    let lv = evalFoldableIntExpr(arena, e.left)
    if e.op == "-":
      ret -lv
    if e.op == "~":
      ret ~lv
    ret lv
  if e.kind == "Binary":
    let lv = evalFoldableIntExpr(arena, e.left)
    let rv = evalFoldableIntExpr(arena, e.right)
    let op = e.op
    if op == "+": ret lv + rv
    if op == "-": ret lv - rv
    if op == "*": ret lv * rv
    if op == "/": ret if rv != 0: lv / rv else: 0
    if op == "%": ret if rv != 0: lv % rv else: 0
    if op == "&": ret lv & rv
    if op == "|": ret lv | rv
    if op == "^": ret lv ^ rv
    if op == "<<": ret lv << rv
    if op == ">>": ret lv >> rv
  ret 0

pub fn isFloatZeroLitExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  ret e.kind == "FloatLit" and (e.strVal == "0.0" or e.strVal == "0" or e.strVal == "0.00")

pub fn isFloatOneLitExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  ret e.kind == "FloatLit" and (e.strVal == "1.0" or e.strVal == "1" or e.strVal == "1.00")

pub fn isNonIntLitExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let k = arena.exprs[exprId].kind
  ret k != "IntLit" and k != "Int"

pub fn isFloatCastOrLitExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "FloatLit":
    ret true
  if e.kind == "Cast":
    let t = e.strVal
    ret t == "float" or t == "f64" or t == "f32"
  if e.kind == "Call" and e.children.len == 1 and e.left >= 0 and e.left < arena.exprs.len:
    let ce = arena.exprs[e.left]
    if ce.kind == "Ident" and ce.strVal == "float":
      ret true
  ret false

pub fn isIntCastOrLitExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "IntLit" or e.kind == "Int":
    ret true
  if e.kind == "Cast":
    let t = e.strVal
    ret t == "int" or t == "i64" or t == "i32"
  if e.kind == "Call" and e.children.len == 1 and e.left >= 0 and e.left < arena.exprs.len:
    let ce = arena.exprs[e.left]
    if ce.kind == "Ident" and ce.strVal == "int":
      ret true
  ret false

pub fn isBoolTrueLitExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "BoolLit":
    ret e.boolVal
  if e.kind == "Ident" and e.strVal == "true":
    ret true
  ret false

pub fn isBoolFalseLitExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "BoolLit":
    ret not e.boolVal
  if e.kind == "Ident" and e.strVal == "false":
    ret true
  ret false

pub fn emitCExpr(arena: AstArena, exprId: int): str:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret "aipl_nil()"
  let e = arena.exprs[exprId]
  if e.kind == "WideningCast":
    if e.left >= 0 and e.left < arena.exprs.len and (arena.exprs[e.left].kind == "IntLit" or arena.exprs[e.left].kind == "Int"):
      let iv = if arena.exprs[e.left].strVal.len > 0: arena.exprs[e.left].strVal else: str(arena.exprs[e.left].intVal)
      ret "aipl_float((double)(" + iv + "LL))"
    ret "aipl_float((double)(" + emitCExpr(arena, e.left) + ").i)"
  if e.kind == "Unwrap":
    ret "aipl_unwrap_at(" + emitCExpr(arena, e.left) + ", " + str(e.intVal) + ")"
  if e.kind == "IntLit" or e.kind == "Int":
    if e.strVal.len > 0:
      if e.strVal == "-9223372036854775808":
        ret "aipl_int(-9223372036854775807LL - 1LL)"
      ret "aipl_int(" + e.strVal + "LL)"
    let ivStr = str(e.intVal)
    if ivStr == "-9223372036854775808":
      ret "aipl_int(-9223372036854775807LL - 1LL)"
    ret "aipl_int(" + ivStr + "LL)"
  if e.kind == "FloatLit":
    ret "aipl_float(" + e.strVal + ")"
  if e.kind == "BoolLit":
    if e.boolVal:
      ret "aipl_bool(true)"
    ret "aipl_bool(false)"
  if e.kind == "NilLit":
    ret "aipl_nil()"
  if e.kind == "Ident":
    if e.strVal == "true":
      ret "aipl_bool(true)"
    if e.strVal == "false":
      ret "aipl_bool(false)"
    if e.strVal == "nil":
      ret "aipl_nil()"
    if e.strVal == "None":
      ret "aipl_none()"
    ret "v_" + e.strVal
  if e.kind == "STRING" or e.kind == "RAW_STRING":
    ret emitCStringVal(e.strVal)
  if e.kind == "INTERP_STRING":
    ret emitInterpolatedString(arena, e.strVal)
  if e.kind == "Unary":
    let uOp = e.op
    if (uOp == "-" or uOp == "~") and isFoldableIntExpr(arena, exprId):
      let folded = evalFoldableIntExpr(arena, exprId)
      ret "aipl_int(" + str(folded) + "LL)"
    if uOp == "-" and e.left >= 0 and e.left < arena.exprs.len and arena.exprs[e.left].kind == "FloatLit":
      ret "aipl_float(-" + arena.exprs[e.left].strVal + ")"
    if (uOp == "not" or uOp == "!") and e.left >= 0 and e.left < arena.exprs.len:
      let innerU = arena.exprs[e.left]
      if innerU.kind == "Unary" and (innerU.op == "not" or innerU.op == "!"):
        ret emitCExpr(arena, innerU.left)
      if isBoolTrueLitExpr(arena, e.left):
        ret "aipl_bool(false)"
      if isBoolFalseLitExpr(arena, e.left):
        ret "aipl_bool(true)"
    let sub = emitCExpr(arena, e.left)
    if uOp == "not" or uOp == "!":
      ret "aipl_not(" + sub + ")"
    if uOp == "-":
      ret "aipl_neg(" + sub + ")"
    if uOp == "~":
      ret "aipl_bitnot(" + sub + ")"
    ret sub
  if e.kind == "Binary":
    let op = e.op
    if isFoldableIntExpr(arena, exprId):
      let folded = evalFoldableIntExpr(arena, exprId)
      ret "aipl_int(" + str(folded) + "LL)"
    if (op == "+" or op == "-" or op == "*" or op == "/") and e.left >= 0 and e.right >= 0 and e.left < arena.exprs.len and e.right < arena.exprs.len:
      let le = arena.exprs[e.left]
      let re = arena.exprs[e.right]
      if (le.kind == "IntLit" or le.kind == "Int") and re.kind == "FloatLit":
        let liv = if le.strVal.len > 0: le.strVal else: str(le.intVal)
        ret "aipl_float(((double)(" + liv + "LL)) " + op + " (" + re.strVal + "))"
      if le.kind == "FloatLit" and (re.kind == "IntLit" or re.kind == "Int"):
        let riv = if re.strVal.len > 0: re.strVal else: str(re.intVal)
        ret "aipl_float((" + le.strVal + ") " + op + " ((double)(" + riv + "LL)))"
    if op == "and" or op == "&&":
      if isBoolTrueLitExpr(arena, e.right):
        ret emitCExpr(arena, e.left)
      if isBoolTrueLitExpr(arena, e.left):
        ret emitCExpr(arena, e.right)
    if op == "or" or op == "||":
      if isBoolFalseLitExpr(arena, e.right):
        ret emitCExpr(arena, e.left)
      if isBoolFalseLitExpr(arena, e.left):
        ret emitCExpr(arena, e.right)
    if op == "+":
      if isFloatZeroLitExpr(arena, e.right) and isNonIntLitExpr(arena, e.left):
        ret emitCExpr(arena, e.left)
      if isFloatZeroLitExpr(arena, e.left) and isNonIntLitExpr(arena, e.right):
        ret emitCExpr(arena, e.right)
    if op == "-":
      if isFoldableIntExpr(arena, e.right) and evalFoldableIntExpr(arena, e.right) == 0:
        ret emitCExpr(arena, e.left)
      if isFloatZeroLitExpr(arena, e.right) and isNonIntLitExpr(arena, e.left):
        ret emitCExpr(arena, e.left)
      if isSameScalarIdent(arena, e.left, e.right):
        ret "aipl_int(0LL)"
    if op == "*":
      if isFoldableIntExpr(arena, e.right) and evalFoldableIntExpr(arena, e.right) == 0 and isSideEffectFreeScalarIdentOrLit(arena, e.left):
        ret "aipl_int(0LL)"
      if isFoldableIntExpr(arena, e.left) and evalFoldableIntExpr(arena, e.left) == 0 and isSideEffectFreeScalarIdentOrLit(arena, e.right):
        ret "aipl_int(0LL)"
      if isFoldableIntExpr(arena, e.right) and evalFoldableIntExpr(arena, e.right) == 1:
        ret emitCExpr(arena, e.left)
      if isFoldableIntExpr(arena, e.left) and evalFoldableIntExpr(arena, e.left) == 1:
        ret emitCExpr(arena, e.right)
      if isFloatOneLitExpr(arena, e.right) and isNonIntLitExpr(arena, e.left):
        ret emitCExpr(arena, e.left)
      if isFloatOneLitExpr(arena, e.left) and isNonIntLitExpr(arena, e.right):
        ret emitCExpr(arena, e.right)
    if op == "/":
      if isFoldableIntExpr(arena, e.right) and evalFoldableIntExpr(arena, e.right) == 1:
        ret emitCExpr(arena, e.left)
      if e.right >= 0 and e.right < arena.exprs.len and arena.exprs[e.right].kind == "FloatLit" and (arena.exprs[e.right].strVal == "1.0" or arena.exprs[e.right].strVal == "1"):
        ret emitCExpr(arena, e.left)
    if op == "|>":
      let leftCode = emitCExpr(arena, e.left)
      if e.right >= 0 and arena.exprs[e.right].kind == "Ident":
        let fnName = arena.exprs[e.right].strVal
        if fnName == "print":
          ret "aipl_print(" + leftCode + ")"
        if fnName == "println":
          ret "aipl_println(" + leftCode + ")"
        if fnName == "str":
          ret "aipl_to_str(" + leftCode + ")"
        if fnName == "int":
          ret "aipl_to_int(" + leftCode + ")"
        if fnName == "float":
          ret "aipl_to_float(" + leftCode + ")"
        if fnName == "bool":
          ret "aipl_bool(aipl_truthy(" + leftCode + "))"
        ret "aipl_fn_" + fnName + "(" + leftCode + ")"
      if e.right >= 0 and arena.exprs[e.right].kind == "Call":
        let cNode = arena.exprs[e.right]
        mut cArgs: [str] = [leftCode]
        mut cidx = 0
        while cidx < cNode.children.len:
          cArgs.push(emitCExpr(arena, cNode.children[cidx]))
          cidx += 1
        if cNode.left >= 0 and arena.exprs[cNode.left].kind == "Ident":
          let fnName = arena.exprs[cNode.left].strVal
          if fnName == "print":
            ret "aipl_print(" + cArgs[0] + ")"
          if fnName == "println":
            ret "aipl_println(" + cArgs[0] + ")"
          if fnName == "str":
            ret "aipl_to_str(" + cArgs[0] + ")"
          if fnName == "int":
            ret "aipl_to_int(" + cArgs[0] + ")"
          if fnName == "float":
            ret "aipl_to_float(" + cArgs[0] + ")"
          if fnName == "bool":
            ret "aipl_bool(aipl_truthy(" + cArgs[0] + "))"
          ret "aipl_fn_" + fnName + "(" + cArgs.join(", ") + ")"
        let calleeStr = emitCExpr(arena, cNode.left)
        ret "aipl_fn_" + calleeStr.replace(".", "_") + "(" + cArgs.join(", ") + ")"
      let rightCode = emitCExpr(arena, e.right)
      ret "aipl_fn_" + rightCode.replace(".", "_") + "(" + leftCode + ")"
    let l = emitCExpr(arena, e.left)
    let r = emitCExpr(arena, e.right)
    if op == "and" or op == "&&":
      ret "(aipl_truthy(" + l + ") ? aipl_bool(aipl_truthy(" + r + ")) : aipl_bool(false))"
    if op == "or" or op == "||":
      ret "(aipl_truthy(" + l + ") ? aipl_bool(true) : aipl_bool(aipl_truthy(" + r + ")))"
    if op == "==":
      ret "aipl_eq(" + l + ", " + r + ")"
    if op == "!=":
      ret "aipl_neq(" + l + ", " + r + ")"
    if op == "<":
      ret "aipl_lt(" + l + ", " + r + ")"
    if op == "<=":
      ret "aipl_le(" + l + ", " + r + ")"
    if op == ">":
      ret "aipl_gt(" + l + ", " + r + ")"
    if op == ">=":
      ret "aipl_ge(" + l + ", " + r + ")"
    if op == "+":
      ret "aipl_add(" + l + ", " + r + ")"
    if op == "-":
      ret "aipl_sub(" + l + ", " + r + ")"
    if op == "*":
      ret "aipl_mul(" + l + ", " + r + ")"
    if op == "/":
      ret "aipl_div(" + l + ", " + r + ")"
    if op == "//":
      ret "aipl_floor_div(" + l + ", " + r + ")"
    if op == "%":
      ret "aipl_mod(" + l + ", " + r + ")"
    if op == "%%":
      ret "aipl_euclid_mod(" + l + ", " + r + ")"
    if op == "**":
      ret "aipl_pow(" + l + ", " + r + ")"
    if op == "<<":
      ret "aipl_shl(" + l + ", " + r + ")"
    if op == ">>":
      ret "aipl_shr(" + l + ", " + r + ")"
    if op == "&":
      ret "aipl_bitand(" + l + ", " + r + ")"
    if op == "|":
      ret "aipl_bitor(" + l + ", " + r + ")"
    if op == "^":
      ret "aipl_bitxor(" + l + ", " + r + ")"
    if op == "??":
      ret "aipl_opt_unwrap_or(" + l + ", " + r + ")"
    if op == "in":
      ret "aipl_contains(" + r + ", " + l + ")"
    ret "aipl_add(" + l + ", " + r + ")"
  if e.kind == "IfExpr" or e.kind == "Ternary":
    let condId = if e.cond >= 0: e.cond else: e.left
    let thenId = if e.cond >= 0: e.left else: e.right
    let elseId = if e.cond >= 0: e.right else: (if e.children.len > 0: e.children[0] else: -1)
    if condId >= 0 and condId < arena.exprs.len:
      let ce = arena.exprs[condId]
      if ce.kind == "BoolLit" or (ce.kind == "Ident" and (ce.strVal == "true" or ce.strVal == "false")):
        let isTrue = if ce.kind == "BoolLit": ce.boolVal else: (ce.strVal == "true")
        if isTrue:
          ret emitCExpr(arena, thenId)
        ret if elseId >= 0: emitCExpr(arena, elseId) else: "aipl_nil()"
    let cond = if e.cond >= 0: emitCExpr(arena, e.cond) else: emitCExpr(arena, e.left)
    let thenE = if e.cond >= 0: emitCExpr(arena, e.left) else: emitCExpr(arena, e.right)
    let elseE = if e.cond >= 0: emitCExpr(arena, e.right) else: (if e.children.len > 0: emitCExpr(arena, e.children[0]) else: "aipl_nil()")
    ret "(aipl_truthy(" + cond + ") ? " + thenE + " : " + elseE + ")"
  if e.kind == "Member":
    if e.left >= 0 and arena.exprs[e.left].kind == "Ident":
      let leftIdent = arena.exprs[e.left].strVal
      if (leftIdent == "canvas" or leftIdent == "Canvas") and (e.strVal == "backendName" or e.strVal == "canvasBackendName"):
        ret "aipl_rt_canvasBackendName()"
      if (leftIdent == "canvas" or leftIdent == "Canvas") and (e.strVal == "isHeadless" or e.strVal == "isHeadlessMode"):
        ret "aipl_rt_isHeadlessMode()"
      if isEnumName(arena, leftIdent) or isEnumVariant(arena, leftIdent, e.strVal):
        let vi = lookupEnumVariantIndex(arena, leftIdent, e.strVal)
        let ord = if vi >= 0: vi else: 0
        if e.strVal == "None":
          ret "aipl_enum_tag(\"" + leftIdent + "::None\", " + str(ord) + ")"
        ret "aipl_enum_tag(\"" + e.strVal + "\", " + str(ord) + ")"
    if e.strVal == "value" or e.strVal == "deref":
      ret "aipl_unwrap(" + emitCExpr(arena, e.left) + ")"
    if e.strVal == "f" or e.strVal == "i" or e.strVal == "round" or e.strVal == "floor" or e.strVal == "ceil":
      if e.left >= 0 and e.left < arena.exprs.len:
        let le = arena.exprs[e.left]
        if (le.kind == "IntLit" or le.kind == "Int") and e.strVal == "f":
          let liv = if le.strVal.len > 0: le.strVal else: str(le.intVal)
          ret "aipl_float((double)(" + liv + "LL))"
        if le.kind == "FloatLit":
          if e.strVal == "i":
            ret "aipl_int((int64_t)(" + le.strVal + "))"
          if e.strVal == "round":
            ret "aipl_int((int64_t)llround((double)(" + le.strVal + ")))"
          if e.strVal == "floor":
            ret "aipl_int((int64_t)floor((double)(" + le.strVal + ")))"
          if e.strVal == "ceil":
            ret "aipl_int((int64_t)ceil((double)(" + le.strVal + ")))"
      mut memRecv = emitCExpr(arena, e.left)
      mut isNegatedMem = false
      if e.left >= 0 and arena.exprs[e.left].kind == "Unary":
        let u = arena.exprs[e.left]
        if u.op == "not" or u.op == "!":
          isNegatedMem = true
          memRecv = emitCExpr(arena, u.left)
      ret wrapNegated("aipl_member_get(" + memRecv + ", \"" + e.strVal + "\")", isNegatedMem)
    mut memRecv = emitCExpr(arena, e.left)
    mut isNegatedMem = false
    if e.left >= 0 and arena.exprs[e.left].kind == "Unary":
      let u = arena.exprs[e.left]
      if u.op == "not" or u.op == "!":
        isNegatedMem = true
        memRecv = emitCExpr(arena, u.left)
    let fIdx = lookupStructFieldIndexForRecv(arena, e.left, e.strVal)
    if fIdx >= 0:
      ret wrapNegated("aipl_member_get_idx(" + memRecv + ", " + str(fIdx) + ", \"" + e.strVal + "\")", isNegatedMem)
    ret wrapNegated("aipl_member_get(" + memRecv + ", \"" + e.strVal + "\")", isNegatedMem)
  if e.kind == "Index":
    if e.right >= 0 and arena.exprs[e.right].kind == "Binary":
      let b = arena.exprs[e.right]
      if b.op == "..":
        let sLeft = if b.left >= 0: emitCExpr(arena, b.left) else: "aipl_int(0)"
