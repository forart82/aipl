// ============================================================================
// Step 1.2.1 & Step 1.2.2: Universal C99 Runtime Header & Code Generator
// ============================================================================

pub fn mapAiplTypeToC(ty: str): str:
  ret "AiplVal"

fn calcDecodedByteLen(s: str): int:
  mut count = 0
  mut i = 0
  while i < s.len:
    let code = s.charCodeAt(i)
    if code == 92 and i + 1 < s.len:
      let nextCode = s.charCodeAt(i + 1)
      if nextCode == 123 or nextCode == 125 or nextCode == 48:
        count += 1
        i += 2
        continue
    count += 1
    i += 1
  ret count

pub fn cEscape(s: str): str:
  mut spanStart = 0
  mut parts: [str] = []
  mut i = 0
  let n = s.len
  while i < n:
    let code = s.charCodeAt(i)
    if code == 92 and i + 1 < n:
      let nextCode = s.charCodeAt(i + 1)
      if nextCode == 123 or nextCode == 125:
        if i > spanStart:
          parts.push(s.slice(spanStart, i))
        parts.push(chr(nextCode))
        i += 2
        spanStart = i
        continue
      elif nextCode == 48:
        if i > spanStart:
          parts.push(s.slice(spanStart, i))
        parts.push(chr(92) + "0")
        i += 2
        spanStart = i
        continue
    if code == 0:
      if i > spanStart:
        parts.push(s.slice(spanStart, i))
      parts.push(chr(92) + "0")
      spanStart = i + 1
    elif code == 27:
      if i > spanStart:
        parts.push(s.slice(spanStart, i))
      parts.push("\\x1b")
      spanStart = i + 1
    elif code == 10:
      if i > spanStart:
        parts.push(s.slice(spanStart, i))
      parts.push("\\n")
      spanStart = i + 1
    elif code == 13:
      if i > spanStart:
        parts.push(s.slice(spanStart, i))
      parts.push("\\r")
      spanStart = i + 1
    elif code == 9:
      if i > spanStart:
        parts.push(s.slice(spanStart, i))
      parts.push("\\t")
      spanStart = i + 1
    elif code == 34:
      if i > spanStart:
        parts.push(s.slice(spanStart, i))
      parts.push("\\\"")
      spanStart = i + 1
    elif code == 92:
      if i > spanStart:
        parts.push(s.slice(spanStart, i))
      parts.push("\\\\")
      spanStart = i + 1
    i += 1

  if spanStart == 0:
    ret s
  if spanStart < n:
    parts.push(s.slice(spanStart, n))
  ret parts.join("")

pub fn escapeCStringLiteral(s: str): str:
  ret "\"" + cEscape(s) + "\""

fn emitCStringVal(raw: str): str:
  let escaped = escapeCStringLiteral(raw)
  let byteLen = calcDecodedByteLen(raw)
  if byteLen == 0:
    ret "aipl_str(\"\")"
  ret "aipl_str_n(" + escaped + ", " + str(byteLen) + ")"

fn isStructName(arena: AstArena, name: str): bool:
  if name.len == 0 or name.charCodeAt(0) < 65 or name.charCodeAt(0) > 90:
    ret false
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if d.kind == "Struct" and d.name == name:
      ret true
    i += 1
  ret false

fn lookupStructFieldNames(arena: AstArena, structName: str): [str]:
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if d.kind == "Struct" and d.name == structName:
      ret d.fieldNames
    i += 1
  let empty: [str] = []
  ret empty

fn lookupStructFields(arena: AstArena, structName: str): [str]:
  ret lookupStructFieldNames(arena, structName)

fn lookupStructFieldType(arena: AstArena, structName: str, fieldName: str): str:
  mut i = arena.decls.len - 1
  while i >= 0:
    let d = arena.decls[i]
    if d.kind == "Struct" and d.name == structName:
      mut fi = 0
      while fi < d.fieldNames.len:
        if d.fieldNames[fi] == fieldName:
          if fi < d.fieldTypes.len and d.fieldTypes[fi] >= 0 and d.fieldTypes[fi] < arena.types.len:
            let resolved = resolveTypeName(arena, d.fieldTypes[fi]).replace("&", "").replace("mut", "").trim()
            if resolved.len > 0:
              ret resolved
            ret arena.types[d.fieldTypes[fi]].name.replace("&", "").replace("mut", "").trim()
        fi += 1
      ret ""
    i -= 1
  ret ""

fn lookupStructFieldIndexByStructName(arena: AstArena, structName: str, fieldName: str): int:
  if structName.len == 0 or fieldName.len == 0:
    ret -1
  mut i = arena.decls.len - 1
  while i >= 0:
    let d = arena.decls[i]
    if d.kind == "Struct" and d.name == structName:
      mut fi = 0
      while fi < d.fieldNames.len:
        if d.fieldNames[fi] == fieldName:
          ret fi
        fi += 1
      ret -1
    i -= 1
  ret -1

fn lookupStructFieldIndexFromDecls(arena: AstArena, fieldName: str): int:
  if fieldName.len == 0 or fieldName == "len" or fieldName == "length":
    ret -1
  mut foundIdx = -1
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if d.kind == "Struct":
      mut fi = 0
      while fi < d.fieldNames.len:
        if d.fieldNames[fi] == fieldName:
          if foundIdx == -1:
            foundIdx = fi
          elif foundIdx != fi:
            ret -1
        fi += 1
    i += 1
  ret foundIdx

fn lookupStructFieldIndexForRecv(arena: AstArena, recvExprId: int, fieldName: str): int:
  if fieldName.len == 0 or fieldName == "len" or fieldName == "length":
    ret -1
  if recvExprId >= 0 and recvExprId < arena.exprs.len:
    let re = arena.exprs[recvExprId]
    if re.kind == "Index" and re.left >= 0 and re.left < arena.exprs.len:
      let ae = arena.exprs[re.left]
      mut knownStruct = ""
      if ae.kind == "Member":
        if ae.strVal == "exprs": knownStruct = "ExprNode"
        elif ae.strVal == "stmts": knownStruct = "StmtNode"
        elif ae.strVal == "decls": knownStruct = "DeclNode"
        elif ae.strVal == "types": knownStruct = "TypeNode"
        elif ae.strVal == "functions": knownStruct = "HirFunction"
        elif ae.strVal == "structs": knownStruct = "HirStruct"
        elif ae.strVal == "enums": knownStruct = "HirEnum"
      elif ae.kind == "Ident" and ae.strVal == "tokens":
        knownStruct = "Token"
      if knownStruct.len > 0:
        let idx = lookupStructFieldIndexByStructName(arena, knownStruct, fieldName)
        if idx >= 0:
          ret idx
  ret lookupStructFieldIndexFromDecls(arena, fieldName)

fn lookupStructFieldDefaultExpr(arena: AstArena, structName: str, fieldIdx: int): int:
  mut i = arena.decls.len - 1
  while i >= 0:
    let d = arena.decls[i]
    if d.kind == "Struct" and d.name == structName:
      if fieldIdx >= 0 and fieldIdx < d.variantPayloadTypes.len:
        let exprId = d.variantPayloadTypes[fieldIdx]
        if exprId >= 0:
          ret exprId
      ret -1
    i -= 1
  ret -1

fn isBuiltinIntrinsic(name: str): bool:
  if name == "print" or name == "println" or name == "assert":
    ret true
  ret false

fn isOverridableHelper(name: str): bool:
  if name == "dayOfWeek" or name == "unixToCivil" or name == "randFloat" or name == "randomFloat" or name == "randomInt" or name == "randInt" or name == "randomIntRange" or name == "parseInt" or name == "parseFloat" or name == "formatFloat" or name == "padLeft" or name == "padRight" or name == "stripAnsi" or name == "hexEncode" or name == "hexDecode":
    ret true
  if name == "jsonParse" or name == "jsonStringify" or name == "sha256" or name == "sha256Bytes" or name == "crc32" or name == "md5" or name == "sha1" or name == "hmacSha256" or name == "hmacSha256Hex" or name == "constantTimeEq" or name == "pbkdf2HmacSha256" or name == "zlibCompress" or name == "zlibDecompress" or name == "deflateRaw" or name == "inflateRaw" or name == "randomBytes":
    ret true
  if name == "fileExists" or name == "readFile" or name == "writeFile" or name == "appendFile" or name == "readBytes" or name == "writeBytes" or name == "listDir" or name == "readDir" or name == "walkDir" or name == "fileSize" or name == "isFile" or name == "isDir" or name == "stat" or name == "realpath" or name == "setFileTimes" or name == "copyFile" or name == "removeFile" or name == "deleteFile" or name == "renameFile" or name == "mkdir" or name == "mkdirAll" or name == "removeDirAll":
    ret true
  if name == "userArgs" or name == "args" or name == "getEnv" or name == "setEnv" or name == "env" or name == "cwd" or name == "homeDir" or name == "tempDir" or name == "execCommand" or name == "exit" or name == "panic" or name == "nowMs" or name == "nowUnixMs" or name == "nowMonoNs" or name == "sleepMs" or name == "eprint" or name == "eprintln" or name == "printInline" or name == "flushStdout" or name == "readStdin" or name == "readLine":
    ret true
  if name == "pathJoin" or name == "pathDirname" or name == "pathNormalize" or name == "pathBasename" or name == "pathExtname" or name == "pathExtension" or name == "pathExt" or name == "pathStem" or name == "pathIsAbsolute":
    ret true
  if name == "readU16LE" or name == "readU16BE" or name == "readU32LE" or name == "readU32BE" or name == "tcpListen" or name == "tcpLocalPort" or name == "tcpConnect" or name == "tcpAccept" or name == "tcpRead" or name == "tcpWrite" or name == "tcpClose" or name == "udpBind" or name == "udpSendTo" or name == "udpRecvFrom" or name == "udpClose":
    ret true
  if name == "drawPixelBuffer" or name == "drawCirclesSoA" or name == "drawRectsSoA" or name == "blendModeAlpha" or name == "blendModeAdditive":
    ret true
  if name == "ptrAlloc" or name == "ptrFree" or name == "ptrReadU8" or name == "ptrWriteU8" or name == "ptrReadI64" or name == "ptrWriteI64" or name == "sizeofType" or name == "bitcastF64ToI64" or name == "bitcastI64ToF64" or name == "rawSyscall" or name.startsWith("rawSyscall"):
    ret true
  ret false

fn isIntrinsicName(name: str): bool:
  if isOverridableHelper(name):
    ret false
  if isBuiltinIntrinsic(name) or isRuntimeIntrinsic(name):
    ret true
  if name == "Ok" or name == "Some" or name == "Err" or name == "None":
    ret true
  ret false

fn hasHirFunction(hir: HirModule, name: str): bool:
  mut i = 0
  while i < hir.functions.len:
    if hir.functions[i].name == name:
      ret true
    i += 1
  ret false

fn hasUserDefinedFunction(arena: AstArena, name: str): bool:
  mut i = arena.decls.len - 1
  while i >= 0:
    let d = arena.decls[i]
    if (d.kind == "Function" or d.kind == "Fn") and d.name == name and d.bodyStmts.len > 0:
      ret true
    i -= 1
  ret false

fn hasDeclFunction(arena: AstArena, name: str): bool:
  if isIntrinsicName(name) or isRuntimeIntrinsic(name) or isBuiltinIntrinsic(name):
    ret true
  if name == "drawPixelBuffer" or name == "drawCirclesSoA" or name == "drawRectsSoA" or name == "blendModeAlpha" or name == "blendModeAdditive":
    ret true
  if name == "readFile" or name == "writeFile" or name == "fileExists" or name == "readBytes" or name == "writeBytes" or name == "removeFile" or name == "isDir" or name == "listDir" or name == "pathJoin" or name == "pathBasename" or name == "pathDirname" or name == "pathNormalize" or name == "realpath" or name == "arenaActiveDepth" or name == "arenaPopEvacuate" or name == "userArgs" or name == "nowMs" or name == "sha256" or name == "crc32" or name == "execCommand" or name == "print" or name == "println" or name == "chr" or name == "charFromCode" or name == "ord" or name == "loadAsset" or name == "assetExists" or name == "listAssets" or name == "byteBufferAlloc" or name == "bytesZeroed" or name == "bytesConcat" or name == "bytesFromHex" or name == "hexEncode" or name == "hexDecode" or name == "roundTo" or name == "remEuclid" or name == "popcnt" or name == "ctz" or name == "clz" or name == "mapNew" or name == "setNew" or name == "setFromArray" or name == "tensorDot" or name == "tensorMatmul" or name == "parallelMatmulInt" or name == "hardwareConcurrency" or name == "execParallel" or name == "aipl_rt_hardware_concurrency" or name == "aipl_rt_exec_parallel" or name == "ptrAlloc" or name == "ptrFree" or name == "ptrReadU8" or name == "ptrWriteU8" or name == "ptrReadI64" or name == "ptrWriteI64" or name == "sizeofType" or name == "bitcastF64ToI64" or name == "bitcastI64ToF64" or name == "rawSyscall" or name.startsWith("rawSyscall"):
    ret true
  mut i = arena.decls.len - 1
  while i >= 0:
    let d = arena.decls[i]
    if (d.kind == "Function" or d.kind == "Fn") and d.name == name:
      ret true
    if d.kind == "Import":
      mut si = 0
      while si < d.importSpecs.len:
        if d.importSpecs[si] == name:
          ret true
        si += 1
    i -= 1
  ret false

fn lookupDeclFunctionParamCount(arena: AstArena, name: str): int:
  mut i = arena.decls.len - 1
  while i >= 0:
    let d = arena.decls[i]
    if (d.kind == "Function" or d.kind == "Fn") and d.name == name:
      if d.params.len > 0:
        ret d.params.len
      ret 0
    i -= 1
  ret -1

fn lookupDeclFunctionDefaultExpr(arena: AstArena, name: str, paramIdx: int): int:
  mut i = arena.decls.len - 1
  while i >= 0:
    let d = arena.decls[i]
    if (d.kind == "Function" or d.kind == "Fn") and d.name == name:
      if paramIdx >= 0 and paramIdx < d.variantPayloadTypes.len:
        let exprId = d.variantPayloadTypes[paramIdx]
        if exprId >= 0:
          ret exprId
      ret -1
    i -= 1
  ret -1

fn lookupDeclFunctionParamTypeIsRef(arena: AstArena, name: str, paramIdx: int): bool:
  mut i = arena.decls.len - 1
  while i >= 0:
    let d = arena.decls[i]
    if (d.kind == "Function" or d.kind == "Fn") and d.name == name:
      if paramIdx >= 0 and paramIdx < d.paramTypes.len:
        let tyName = resolveTypeName(arena, d.paramTypes[paramIdx])
        if tyName.startsWith("&"):
          ret true
      ret false
    i -= 1
  ret false

fn cleanStructTypeName(raw: str): str:
  mut s = raw.replace("&", "").replace("mut", "").trim()
  while (s.startsWith("Result[") or s.startsWith("Option[")) and s.endsWith("]"):
    let inner = s.slice(7, s.len - 1).trim()
    let comma = inner.indexOf(",")
    let brk = inner.indexOf("[")
    if comma >= 0 and (brk < 0 or comma < brk):
      s = inner.slice(0, comma).trim()
    else:
      s = inner
  if s.contains("["):
    let bIdx = s.indexOf("[")
    if bIdx > 0:
      s = s.slice(0, bIdx).trim()
  ret s

fn lookupDeclFunctionRetType(arena: AstArena, name: str): str:
  if name.len == 0:
    ret ""
  mut i = arena.decls.len - 1
  while i >= 0:
    let d = arena.decls[i]
    if (d.kind == "Function" or d.kind == "Fn") and d.name == name:
      if d.retType >= 0 and d.retType < arena.types.len:
        ret resolveTypeName(arena, d.retType).replace("&", "").replace("mut", "").trim()
      ret ""
    i -= 1
  ret ""

fn isKnownModule(name: str): bool:
  if name == "fs" or name == "path" or name == "env" or name == "time" or name == "crypto" or name == "process" or name == "io" or name == "math" or name == "json" or name == "app" or name == "net" or name == "ffi" or name == "canvas" or name == "thread" or name == "Thread":
    ret true
  ret false

