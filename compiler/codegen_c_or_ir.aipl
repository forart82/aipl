            ret wrapNegated("aipl_rt_hardware_concurrency()", isNegatedMethod)
          if method == "execParallel":
            let p0 = if e.children.len > 0: emitCExpr(arena, e.children[0]) else: "aipl_array_new(NULL, 0)"
            let p1 = if e.children.len > 1: emitCExpr(arena, e.children[1]) else: "aipl_int(0)"
            ret wrapNegated("aipl_rt_exec_parallel(" + p0 + ", " + p1 + ")", isNegatedMethod)
        if not isLocal and (isEnumName(arena, modName) or isEnumVariant(arena, modName, method)):
