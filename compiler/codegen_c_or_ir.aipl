          fnName = "field" + str(fi)
        fNamesList.push("\"" + fnName + "\"")
        fValsList.push(emitCExpr(arena, e.children[fi]))
        fi += 1
      if e.left < 0:
        mut si = 0
        while si < sFields.len:
          let sfName = sFields[si]
          mut found = false
          mut ni = 0
          while ni < e.names.len:
            if e.names[ni] == sfName:
              found = true
              break
            ni += 1
          if not found:
            let defId = lookupStructFieldDefaultExpr(arena, structName, si)
            if defId >= 0:
              fNamesList.push("\"" + sfName + "\"")
              fValsList.push(emitCExpr(arena, defId))
          si += 1
    if e.left >= 0:
      let baseCode = emitCExpr(arena, e.left)
      if fValsList.len == 0:
        ret "aipl_struct_spread(" + baseCode + ", \"" + structName + "\", 0, NULL, NULL)"
      ret "aipl_struct_spread(" + baseCode + ", \"" + structName + "\", " + str(fValsList.len) + ", (const char*[]){ " + fNamesList.join(", ") + " }, (AiplVal[]){ " + fValsList.join(", ") + " })"
    if fValsList.len == 0:
      ret "aipl_struct_new_static(\"" + structName + "\", 0, NULL, NULL)"
    ret "({ static const char* _sn[] = { " + fNamesList.join(", ") + " }; aipl_struct_new_static(\"" + structName + "\", " + str(fValsList.len) + ", _sn, (AiplVal[]){ " + fValsList.join(", ") + " }); })"

  if e.kind == "Array" or e.kind == "Tuple":
    mut aItems: [str] = []
    mut ai = 0
    while ai < e.children.len:
      aItems.push(emitCExpr(arena, e.children[ai]))
      ai += 1
    if aItems.len == 0:
      ret "aipl_array_new(NULL, 0)"
    ret "aipl_array_new((AiplVal[]){ " + aItems.join(", ") + " }, " + str(aItems.len) + ")"

  if e.kind == "MapLit":
    if e.children.len == 0:
      ret "aipl_map_new()"
    let uid = str(e.id)
    mut mLines: [str] = []
    mLines.push("({ AiplVal _ml_" + uid + " = aipl_map_new(); ")
    mut mi = 0
    while mi + 1 < e.children.len:
      let kCode = emitCExpr(arena, e.children[mi])
      let vCode = emitCExpr(arena, e.children[mi + 1])
      mLines.push("aipl_map_set(_ml_" + uid + ", " + kCode + ", " + vCode + "); ")
      mi += 2
    mLines.push("_ml_" + uid + "; })")
    ret mLines.join("")

  ret "aipl_nil()"

pub fn collectExprVarNames(arena: AstArena, exprId: int, mut vars: [str]): [str]:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret vars
  let e = arena.exprs[exprId]
  if e.kind == "IsPattern":
    if e.op.len > 0 and not arrayContainsStr(vars, e.op):
      vars.push(e.op)
  elif e.kind == "Lambda":
    mut pi = 0
    while pi < e.names.len:
      let p = e.names[pi]
      if p.len > 0 and not arrayContainsStr(vars, p):
        vars.push(p)
      pi += 1
  elif e.kind == "DoBlock":
    mut bi = 0
    while bi < e.children.len:
      let cid = e.children[bi]
      if cid >= 0 and cid < arena.stmts.len:
        vars = collectStmtVarNames(arena, cid, vars)
      bi += 1
  elif e.kind == "MatchExpr":
    mut mi = 0
    while mi < e.children.len:
      let cid = e.children[mi]
      if cid >= 0 and cid < arena.stmts.len:
        vars = collectStmtVarNames(arena, cid, vars)
      mi += 1
  elif e.kind == "BlockIfExpr":
    mut bi = 0
    while bi < e.children.len:
      let cid = e.children[bi]
      if cid >= 0 and cid < arena.stmts.len:
        vars = collectStmtVarNames(arena, cid, vars)
      bi += 1

  if e.left >= 0:
    vars = collectExprVarNames(arena, e.left, vars)
  if e.right >= 0:
    vars = collectExprVarNames(arena, e.right, vars)
  if e.cond >= 0:
    vars = collectExprVarNames(arena, e.cond, vars)
  if e.kind != "DoBlock" and e.kind != "MatchExpr" and e.kind != "BlockIfExpr":
    mut ci = 0
    while ci < e.children.len:
      let childId = e.children[ci]
      if childId >= 0:
        vars = collectExprVarNames(arena, childId, vars)
      ci += 1
  ret vars

pub fn collectStmtVarNames(arena: AstArena, stmtId: int, mut vars: [str]): [str]:
  if stmtId < 0 or stmtId >= arena.stmts.len:
    ret vars
  let st = arena.stmts[stmtId]
  if st.exprId >= 0:
    vars = collectExprVarNames(arena, st.exprId, vars)
  if st.condExpr >= 0:
    vars = collectExprVarNames(arena, st.condExpr, vars)
  if st.kind == "VarDecl":
    if not arrayContainsStr(vars, st.name):
      vars.push(st.name)
  elif st.kind == "TupleVarDecl":
    let rawNames = st.name.split(",")
    mut ti = 0
    while ti < rawNames.len:
      mut vName = rawNames[ti].trim()
      if vName.startsWith("("):
        vName = vName.slice(1, vName.len).trim()
      if vName.endsWith(")"):
        vName = vName.slice(0, vName.len - 1).trim()
      if vName.contains(":"):
        let p = vName.split(":")
        vName = p[0].trim()
      if vName.len > 0 and vName != "(" and not vName.contains(":") and not vName.contains("/") and not vName.contains("."):
        if not arrayContainsStr(vars, vName):
          vars.push(vName)
      ti += 1
  elif st.kind == "For":
    if st.name.contains(","):
      let parts = st.name.split(",")
      mut pi = 0
      while pi < parts.len:
        mut vn = parts[pi].trim()
        if vn.contains(":"):
          let p = vn.split(":")
          vn = p[0].trim()
        if vn.startsWith("("):
          vn = vn.slice(1, vn.len).trim()
        if vn.endsWith(")"):
          vn = vn.slice(0, vn.len - 1).trim()
        if vn.len > 0 and not arrayContainsStr(vars, vn):
          vars.push(vn)
        pi += 1
    else:
      mut vn = st.name.trim()
      if vn.contains(":"):
        let p = vn.split(":")
        vn = p[0].trim()
      if vn.len > 0 and not arrayContainsStr(vars, vn):
        vars.push(vn)
    vars = collectStmtListVarNames(arena, st.bodyStmts, vars)
  elif st.kind == "If":
    vars = collectStmtListVarNames(arena, st.bodyStmts, vars)
    mut ei = 0
    while ei < st.elseStmts.len:
      let elId = st.elseStmts[ei]
      let elNode = arena.stmts[elId]
      if elNode.kind == "Elif":
        vars = collectStmtListVarNames(arena, elNode.bodyStmts, vars)
      else:
        vars = collectStmtVarNames(arena, elId, vars)
      ei += 1
  elif st.kind == "While":
    vars = collectStmtListVarNames(arena, st.bodyStmts, vars)
  elif st.kind == "Match":
    mut mi = 0
    while mi < st.matchArms.len:
      let armId = st.matchArms[mi]
      if armId >= 0 and armId < arena.stmts.len:
        let armNode = arena.stmts[armId]
        if armNode.exprId >= 0:
          vars = collectExprVarNames(arena, armNode.exprId, vars)
        mut cleanArm = armNode.name
        if cleanArm.contains("."):
          let p = cleanArm.split(".")
          if p.len > 1:
            cleanArm = p[1]
        let isLitOrPunct = armNode.name.startsWith("\"") or armNode.name.startsWith("'") or armNode.name.contains(":") or armNode.name.contains("/") or armNode.name.contains(".")
        if not isLitOrPunct and isCatchAllArm(arena, cleanArm):
          if cleanArm != "_" and cleanArm != "else":
            if not arrayContainsStr(vars, cleanArm):
              vars.push(cleanArm)
        vars = collectStmtListVarNames(arena, armNode.bodyStmts, vars)
      mi += 1
  elif st.kind == "Block" or st.kind == "ArenaScope":
    vars = collectStmtListVarNames(arena, st.bodyStmts, vars)
  elif st.kind == "Assign":
    if st.condExpr >= 0 and st.condExpr < arena.exprs.len:
      let lhs = arena.exprs[st.condExpr]
      if lhs.kind == "Ident" and lhs.strVal.len > 0:
        if not arrayContainsStr(vars, lhs.strVal):
          vars.push(lhs.strVal)
  ret vars

pub fn collectStmtListVarNames(arena: AstArena, stmtIds: [int], mut vars: [str]): [str]:
  mut i = 0
  while i < stmtIds.len:
    vars = collectStmtVarNames(arena, stmtIds[i], vars)
    i += 1
  ret vars

pub fn hasConstDecl(arena: AstArena, name: str): bool:
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if d.kind == "Const" and d.name == name:
      ret true
    i += 1
  ret false

pub fn collectLambdaExprVars(arena: AstArena, exprId: int, mut vars: [str]): [str]:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret vars
  vars = collectExprVarNames(arena, exprId, vars)
  let e = arena.exprs[exprId]
  if e.kind == "Ident":
    let nm = e.strVal
    if nm.len > 0 and nm != "true" and nm != "false" and nm != "nil" and nm != "None" and not nm.contains(".") and not nm.contains(":") and not nm.contains("/"):
      if not arrayContainsStr(vars, nm) and not hasConstDecl(arena, nm):
        vars.push(nm)
  if e.kind == "DoBlock" or e.kind == "MatchExpr" or e.kind == "BlockIfExpr":
    mut bi = 0
    while bi < e.children.len:
      let sid = e.children[bi]
      if sid >= 0 and sid < arena.stmts.len:
        let st = arena.stmts[sid]
        if st.exprId >= 0:
          vars = collectLambdaExprVars(arena, st.exprId, vars)
        if st.condExpr >= 0:
          vars = collectLambdaExprVars(arena, st.condExpr, vars)
      bi += 1
  if e.left >= 0:
    vars = collectLambdaExprVars(arena, e.left, vars)
  if e.right >= 0:
    vars = collectLambdaExprVars(arena, e.right, vars)
  if e.cond >= 0:
    vars = collectLambdaExprVars(arena, e.cond, vars)
  if e.kind != "DoBlock" and e.kind != "MatchExpr" and e.kind != "BlockIfExpr":
    mut ci = 0
    while ci < e.children.len:
      if e.children[ci] >= 0:
        vars = collectLambdaExprVars(arena, e.children[ci], vars)
      ci += 1
  ret vars

pub fn collectArenaAssignedVars(arena: AstArena, stmtIds: [int], mut localDecls: [str], mut assigned: [str]): [str]:
  mut i = 0
  while i < stmtIds.len:
    let sid = stmtIds[i]
    if sid >= 0 and sid < arena.stmts.len:
      let bst = arena.stmts[sid]
      if bst.kind == "VarDecl" and bst.name.len > 0:
        localDecls.push(bst.name)
      elif bst.kind == "Assign" and bst.condExpr >= 0 and bst.condExpr < arena.exprs.len:
        let lhsE = arena.exprs[bst.condExpr]
        if lhsE.kind == "Ident" and lhsE.strVal.len > 0 and not arrayContainsStr(localDecls, lhsE.strVal) and not arrayContainsStr(assigned, lhsE.strVal):
          assigned.push(lhsE.strVal)
      if bst.bodyStmts.len > 0:
        assigned = collectArenaAssignedVars(arena, bst.bodyStmts, localDecls, assigned)
      if bst.elseStmts.len > 0:
        assigned = collectArenaAssignedVars(arena, bst.elseStmts, localDecls, assigned)
      if bst.matchArms.len > 0:
        assigned = collectArenaAssignedVars(arena, bst.matchArms, localDecls, assigned)
    i += 1
  ret assigned

pub fn emitCStmtWithScope(arena: AstArena, stmtId: int, indent: str, mut declaredVars: [str]): [str]:
  mut lines: [str] = []
  if stmtId < 0 or stmtId >= arena.stmts.len:
    ret lines
  let st = arena.stmts[stmtId]
  if st.kind == "VarDecl":
    let rhs = if st.exprId >= 0: emitCExpr(arena, st.exprId) else: "aipl_nil()"
    let name = st.name
    lines.push(indent + "v_" + name + " = " + rhs + ";")
    ret lines
  if st.kind == "TupleVarDecl":
    let rhs = if st.exprId >= 0: emitCExpr(arena, st.exprId) else: "aipl_nil()"
    let uid = str(st.id)
    lines.push(indent + "AiplVal _tup_" + uid + " = " + rhs + ";")
    let rawNames = st.name.split(",")
    mut ti = 0
    while ti < rawNames.len:
      mut vName = rawNames[ti].trim()
      mut accessPath = str(ti)
      if vName.contains(":"):
        let p = vName.split(":")
        vName = p[0].trim()
        if p.len > 1:
          accessPath = p[1].trim()
      if vName.startsWith("("):
        vName = vName.slice(1, vName.len).trim()
      if vName.endsWith(")"):
        vName = vName.slice(0, vName.len - 1).trim()
      if vName.len > 0 and vName != "_" and not arrayContainsStr(declaredVars, vName):
        let pSteps = accessPath.split(".")
        mut acc = "_tup_" + uid
        mut si = 0
        while si < pSteps.len:
          acc = "aipl_index_get(" + acc + ", aipl_int(" + pSteps[si] + "))"
          si += 1
        lines.push(indent + "v_" + vName + " = " + acc + ";")
      ti += 1
    ret lines
  if st.kind == "Return":
    let inArenaScope = arrayContainsStr(declaredVars, "__arena_saved")
    mut refSyncs: [str] = []
    mut ensExprIds: [int] = []
    mut rsi = 0
    while rsi < declaredVars.len:
      let dv = declaredVars[rsi]
      if dv.startsWith("&"):
        let rp = dv.slice(1, dv.len)
        refSyncs.push("*p_ref_" + rp + " = v_" + rp + ";")
      elif dv.startsWith("__ensures__:"):
        let eid = int(dv.slice(12, dv.len))
        if eid >= 0:
          ensExprIds.push(eid)
      rsi += 1
    if st.exprId >= 0:
      let retExpr = emitCExpr(arena, st.exprId)
      let finalRet = if inArenaScope: "aipl_arena_pop_evacuate(_arena_saved, " + retExpr + ")" else: retExpr
      if refSyncs.len > 0 or ensExprIds.len > 0:
        lines.push(indent + "AiplVal _ret_val = " + finalRet + ";")
        if ensExprIds.len > 0:
          lines.push(indent + "{ AiplVal v_ret = _ret_val; AiplVal v_result = _ret_val; (void)v_ret; (void)v_result;")
          mut ei = 0
          while ei < ensExprIds.len:
            lines.push(indent + "  aipl_rt_assert(" + emitCExpr(arena, ensExprIds[ei]) + ", \"ensures contract failed\");")
            ei += 1
          lines.push(indent + "}")
        mut rk = 0
        while rk < refSyncs.len:
          lines.push(indent + refSyncs[rk])
          rk += 1
        lines.push(indent + "return _ret_val;")
      else:
        lines.push(indent + "return " + finalRet + ";")
    else:
      if ensExprIds.len > 0:
        lines.push(indent + "{ AiplVal v_ret = aipl_nil(); AiplVal v_result = aipl_nil(); (void)v_ret; (void)v_result;")
        mut ei = 0
        while ei < ensExprIds.len:
          lines.push(indent + "  aipl_rt_assert(" + emitCExpr(arena, ensExprIds[ei]) + ", \"ensures contract failed\");")
          ei += 1
        lines.push(indent + "}")
      if inArenaScope:
        lines.push(indent + "aipl_arena_pop(_arena_saved);")
      mut rk = 0
      while rk < refSyncs.len:
        lines.push(indent + refSyncs[rk])
        rk += 1
      lines.push(indent + "return aipl_nil();")
    ret lines
  if st.kind == "continue":
    mut csi = 0
    while csi < declaredVars.len:
      let dv = declaredVars[csi]
      if dv.startsWith("__for_mut__:"):
        lines.push(indent + dv.slice(12, dv.len))
      csi += 1
    lines.push(indent + "continue;")
    ret lines
  if st.kind == "break":
    lines.push(indent + "break;")
    ret lines
  if st.kind == "Pass":
    lines.push(indent + "/* pass */;")
    ret lines
  if st.kind == "Require" or st.kind == "Requires":
    if st.exprId >= 0:
      if isContractProvenStatic(arena, st.exprId):
        lines.push(indent + "/* [SMT: PROVEN_STATIC] elided requires contract */")
      else:
        lines.push(indent + "aipl_rt_assert(" + emitCExpr(arena, st.exprId) + ", \"requires contract failed\");")
    ret lines
  if st.kind == "Ensure" or st.kind == "Ensures":
    if st.exprId >= 0:
      let ensCode = emitCExpr(arena, st.exprId)
      if not ensCode.contains("v_ret") and not ensCode.contains("v_result"):
        if isContractProvenStatic(arena, st.exprId):
          lines.push(indent + "/* [SMT: PROVEN_STATIC] elided ensures contract */")
        else:
          lines.push(indent + "aipl_rt_assert(" + ensCode + ", \"ensures contract failed\");")
    ret lines
  if st.kind == "Invariant":
    if st.exprId >= 0:
      lines.push(indent + "aipl_rt_assert(" + emitCExpr(arena, st.exprId) + ", \"loop invariant contract failed\");")
    ret lines
  if st.kind == "Decreases" or st.kind == "Decrease":
    if st.exprId >= 0:
      lines.push(indent + "aipl_rt_assert(aipl_ge(" + emitCExpr(arena, st.exprId) + ", aipl_int(0)), \"loop decreases contract failed: ranking expression < 0\");")
    ret lines
  if st.kind == "ArenaScope":
    lines.push(indent + "{")
    lines.push(indent + "  AiplArenaPage* _arena_saved = aipl_arena_push();")
    mut arenaVars: [str] = []
    mut dvi = 0
    while dvi < declaredVars.len:
      arenaVars.push(declaredVars[dvi])
      dvi += 1
    if not arrayContainsStr(arenaVars, "__arena_saved"):
      arenaVars.push("__arena_saved")
    let localDecls: [str] = []
    let emptyAssigned: [str] = []
    let assignedOuter = collectArenaAssignedVars(arena, st.bodyStmts, localDecls, emptyAssigned)
    mut bi = 0
    while bi < st.bodyStmts.len:
      let bsid = st.bodyStmts[bi]
      let sub = emitCStmtWithScope(arena, bsid, indent + "  ", arenaVars)
      mut si = 0
      while si < sub.len:
        lines.push(sub[si])
        si += 1
      bi += 1
    mut aoi = 0
    while aoi < assignedOuter.len:
      let av = assignedOuter[aoi]
      lines.push(indent + "  v_" + av + " = aipl_evacuate_val(_arena_saved, v_" + av + ");")
      aoi += 1
    lines.push(indent + "  aipl_arena_pop(_arena_saved);")
    lines.push(indent + "}")
    ret lines
  if st.kind == "Block":
    mut bi = 0
    while bi < st.bodyStmts.len:
      let sub = emitCStmtWithScope(arena, st.bodyStmts[bi], indent, declaredVars)
      mut si = 0
      while si < sub.len:
        lines.push(sub[si])
        si += 1
      bi += 1
    ret lines
  if st.kind == "Assign":
    let op = st.name
    let rhs = emitCExpr(arena, st.exprId)
    if st.condExpr >= 0 and st.condExpr < arena.exprs.len:
      let lhsExpr = arena.exprs[st.condExpr]
      if lhsExpr.kind == "Ident":
        let vname = "v_" + lhsExpr.strVal
        if op == "=":
          lines.push(indent + vname + " = " + rhs + ";")
        elif op == "+=":
          if isFoldableIntExpr(arena, st.exprId):
            let delta = evalFoldableIntExpr(arena, st.exprId)
            lines.push(indent + "aipl_inc_int(&" + vname + ", " + str(delta) + "LL);")
          else:
            lines.push(indent + vname + " = aipl_add(" + vname + ", " + rhs + ");")
        elif op == "-=":
          if isFoldableIntExpr(arena, st.exprId):
            let delta = evalFoldableIntExpr(arena, st.exprId)
            lines.push(indent + "aipl_inc_int(&" + vname + ", " + str(-delta) + "LL);")
          else:
            lines.push(indent + vname + " = aipl_sub(" + vname + ", " + rhs + ");")
        elif op == "*=":
          lines.push(indent + vname + " = aipl_mul(" + vname + ", " + rhs + ");")
        elif op == "/=":
          lines.push(indent + vname + " = aipl_div(" + vname + ", " + rhs + ");")
        elif op == "%=":
          lines.push(indent + vname + " = aipl_mod(" + vname + ", " + rhs + ");")
        else:
          lines.push(indent + vname + " = " + rhs + ";")
        ret lines
      if lhsExpr.kind == "Index":
        let target = emitCExpr(arena, lhsExpr.left)
        let idx = emitCExpr(arena, lhsExpr.right)
        let isBareIdent = (lhsExpr.left >= 0 and arena.exprs[lhsExpr.left].kind == "Ident")
        if isBareIdent:
          if op == "=":
            lines.push(indent + "aipl_index_set(&" + target + ", " + idx + ", " + rhs + ");")
          elif op == "+=":
            lines.push(indent + "aipl_index_set(&" + target + ", " + idx + ", aipl_add(aipl_index_get(" + target + ", " + idx + "), " + rhs + "));")
          elif op == "-=":
            lines.push(indent + "aipl_index_set(&" + target + ", " + idx + ", aipl_sub(aipl_index_get(" + target + ", " + idx + "), " + rhs + "));")
          elif op == "*=":
            lines.push(indent + "aipl_index_set(&" + target + ", " + idx + ", aipl_mul(aipl_index_get(" + target + ", " + idx + "), " + rhs + "));")
          elif op == "/=":
            lines.push(indent + "aipl_index_set(&" + target + ", " + idx + ", aipl_div(aipl_index_get(" + target + ", " + idx + "), " + rhs + "));")
          elif op == "%=":
            lines.push(indent + "aipl_index_set(&" + target + ", " + idx + ", aipl_mod(aipl_index_get(" + target + ", " + idx + "), " + rhs + "));")
          else:
            lines.push(indent + "aipl_index_set(&" + target + ", " + idx + ", " + rhs + ");")
        else:
          if op == "=":
            lines.push(indent + "aipl_index_set_val(" + target + ", " + idx + ", " + rhs + ");")
          elif op == "+=":
            lines.push(indent + "aipl_index_set_val(" + target + ", " + idx + ", aipl_add(aipl_index_get(" + target + ", " + idx + "), " + rhs + "));")
          elif op == "-=":
            lines.push(indent + "aipl_index_set_val(" + target + ", " + idx + ", aipl_sub(aipl_index_get(" + target + ", " + idx + "), " + rhs + "));")
          elif op == "*=":
            lines.push(indent + "aipl_index_set_val(" + target + ", " + idx + ", aipl_mul(aipl_index_get(" + target + ", " + idx + "), " + rhs + "));")
          elif op == "/=":
            lines.push(indent + "aipl_index_set_val(" + target + ", " + idx + ", aipl_div(aipl_index_get(" + target + ", " + idx + "), " + rhs + "));")
          elif op == "%=":
            lines.push(indent + "aipl_index_set_val(" + target + ", " + idx + ", aipl_mod(aipl_index_get(" + target + ", " + idx + "), " + rhs + "));")
          else:
            lines.push(indent + "aipl_index_set_val(" + target + ", " + idx + ", " + rhs + ");")
        ret lines
      if lhsExpr.kind == "Member":
        let field = lhsExpr.strVal
        if lhsExpr.left >= 0 and arena.exprs[lhsExpr.left].kind == "Index":
          let idxExpr = arena.exprs[lhsExpr.left]
          let arrCode = emitCExpr(arena, idxExpr.left)
          let idxCode = emitCExpr(arena, idxExpr.right)
          let opCode = if op == "+=": "1" elif op == "-=": "2" elif op == "*=": "3" elif op == "/=": "4" elif op == "%=": "5" else: "0"
          lines.push(indent + "aipl_array_member_op_set(" + arrCode + ", " + idxCode + ", \"" + field + "\", " + rhs + ", " + opCode + ");")
          ret lines
        let target = emitCExpr(arena, lhsExpr.left)
        let isColorChan = (field == "r" or field == "g" or field == "b" or field == "a")
        let fIdx = if isColorChan: -1 else: lookupStructFieldIndexForRecv(arena, lhsExpr.left, field)
        if fIdx >= 0:
          let getExpr = "aipl_member_get_idx(" + target + ", " + str(fIdx) + ", \"" + field + "\")"
          if op == "=":
            lines.push(indent + "aipl_member_set_idx(" + target + ", " + str(fIdx) + ", \"" + field + "\", " + rhs + ");")
          elif op == "+=":
            lines.push(indent + "aipl_member_set_idx(" + target + ", " + str(fIdx) + ", \"" + field + "\", aipl_add(" + getExpr + ", " + rhs + "));")
          elif op == "-=":
            lines.push(indent + "aipl_member_set_idx(" + target + ", " + str(fIdx) + ", \"" + field + "\", aipl_sub(" + getExpr + ", " + rhs + "));")
          elif op == "*=":
            lines.push(indent + "aipl_member_set_idx(" + target + ", " + str(fIdx) + ", \"" + field + "\", aipl_mul(" + getExpr + ", " + rhs + "));")
          elif op == "/=":
            lines.push(indent + "aipl_member_set_idx(" + target + ", " + str(fIdx) + ", \"" + field + "\", aipl_div(" + getExpr + ", " + rhs + "));")
          elif op == "%=":
            lines.push(indent + "aipl_member_set_idx(" + target + ", " + str(fIdx) + ", \"" + field + "\", aipl_mod(" + getExpr + ", " + rhs + "));")
          else:
            lines.push(indent + "aipl_member_set_idx(" + target + ", " + str(fIdx) + ", \"" + field + "\", " + rhs + ");")
          ret lines
        let isBareIdent = (lhsExpr.left >= 0 and arena.exprs[lhsExpr.left].kind == "Ident")
        if isBareIdent:
          if op == "=":
            lines.push(indent + "aipl_member_set(&" + target + ", \"" + field + "\", " + rhs + ");")
          elif op == "+=":
            lines.push(indent + "aipl_member_set(&" + target + ", \"" + field + "\", aipl_add(aipl_member_get(" + target + ", \"" + field + "\"), " + rhs + "));")
          elif op == "-=":
            lines.push(indent + "aipl_member_set(&" + target + ", \"" + field + "\", aipl_sub(aipl_member_get(" + target + ", \"" + field + "\"), " + rhs + "));")
          elif op == "*=":
            lines.push(indent + "aipl_member_set(&" + target + ", \"" + field + "\", aipl_mul(aipl_member_get(" + target + ", \"" + field + "\"), " + rhs + "));")
          elif op == "/=":
            lines.push(indent + "aipl_member_set(&" + target + ", \"" + field + "\", aipl_div(aipl_member_get(" + target + ", \"" + field + "\"), " + rhs + "));")
          elif op == "%=":
            lines.push(indent + "aipl_member_set(&" + target + ", \"" + field + "\", aipl_mod(aipl_member_get(" + target + ", \"" + field + "\"), " + rhs + "));")
          else:
            lines.push(indent + "aipl_member_set(&" + target + ", \"" + field + "\", " + rhs + ");")
        else:
          if op == "=":
            lines.push(indent + "aipl_member_set_val(" + target + ", \"" + field + "\", " + rhs + ");")
          elif op == "+=":
            lines.push(indent + "aipl_member_set_val(" + target + ", \"" + field + "\", aipl_add(aipl_member_get(" + target + ", \"" + field + "\"), " + rhs + "));")
          elif op == "-=":
            lines.push(indent + "aipl_member_set_val(" + target + ", \"" + field + "\", aipl_sub(aipl_member_get(" + target + ", \"" + field + "\"), " + rhs + "));")
          elif op == "*=":
            lines.push(indent + "aipl_member_set_val(" + target + ", \"" + field + "\", aipl_mul(aipl_member_get(" + target + ", \"" + field + "\"), " + rhs + "));")
          elif op == "/=":
            lines.push(indent + "aipl_member_set_val(" + target + ", \"" + field + "\", aipl_div(aipl_member_get(" + target + ", \"" + field + "\"), " + rhs + "));")
          elif op == "%=":
            lines.push(indent + "aipl_member_set_val(" + target + ", \"" + field + "\", aipl_mod(aipl_member_get(" + target + ", \"" + field + "\"), " + rhs + "));")
          else:
            lines.push(indent + "aipl_member_set_val(" + target + ", \"" + field + "\", " + rhs + ");")
        ret lines
      if lhsExpr.kind == "Index2D":
        let target = emitCExpr(arena, lhsExpr.left)
        let rCode = if lhsExpr.children.len >= 2: emitCExpr(arena, lhsExpr.children[0]) else: emitCExpr(arena, lhsExpr.right)
        let cCode = if lhsExpr.cond >= 0: emitCExpr(arena, lhsExpr.cond) else: (if lhsExpr.children.len >= 2: emitCExpr(arena, lhsExpr.children[1]) else: (if lhsExpr.children.len > 0: emitCExpr(arena, lhsExpr.children[0]) else: "aipl_int(0)"))
        let curVal = "aipl_index_2d_get(" + target + ", " + rCode + ", " + cCode + ")"
        if op == "=":
          lines.push(indent + "aipl_index_2d_set(" + target + ", " + rCode + ", " + cCode + ", " + rhs + ");")
        elif op == "+=":
          lines.push(indent + "aipl_index_2d_set(" + target + ", " + rCode + ", " + cCode + ", aipl_add(" + curVal + ", " + rhs + "));")
        elif op == "-=":
          lines.push(indent + "aipl_index_2d_set(" + target + ", " + rCode + ", " + cCode + ", aipl_sub(" + curVal + ", " + rhs + "));")
        elif op == "*=":
          lines.push(indent + "aipl_index_2d_set(" + target + ", " + rCode + ", " + cCode + ", aipl_mul(" + curVal + ", " + rhs + "));")
        elif op == "/=":
          lines.push(indent + "aipl_index_2d_set(" + target + ", " + rCode + ", " + cCode + ", aipl_div(" + curVal + ", " + rhs + "));")
        elif op == "%=":
          lines.push(indent + "aipl_index_2d_set(" + target + ", " + rCode + ", " + cCode + ", aipl_mod(" + curVal + ", " + rhs + "));")
        else:
          lines.push(indent + "aipl_index_2d_set(" + target + ", " + rCode + ", " + cCode + ", " + rhs + ");")
        ret lines
    lines.push(indent + emitCExpr(arena, st.exprId) + ";")
    ret lines
  if st.kind == "Discard":
    // Step 17.4 (Bug #5): `discard <expr>` evaluates for side effects and never tail-returns its value.
    if st.exprId >= 0:
      lines.push(indent + "(void)(" + emitCExpr(arena, st.exprId) + ");")
    ret lines
  if st.kind == "ExprStmt":
    let code = emitCExpr(arena, st.exprId)
    let isVoid = code.contains("aipl_array_push(") or code.contains("aipl_container_set(") or code.contains("aipl_map_set(") or code.contains("aipl_println(") or code.contains("aipl_print(")
    if arrayContainsStr(declaredVars, "__is_tail_ret__") and not isVoid:
      lines.push(indent + "return " + code + ";")
    else:
      lines.push(indent + code + ";")
    ret lines
  if st.kind == "If":
    lines.push(indent + "if (aipl_truthy(" + emitCExpr(arena, st.condExpr) + ")) {")
    mut bi = 0
    while bi < st.bodyStmts.len:
      mut ifScopeVars: [str] = []
      mut dvi = 0
      while dvi < declaredVars.len:
        let dv = declaredVars[dvi]
        if dv != "__is_tail_ret__":
          ifScopeVars.push(dv)
        dvi += 1
      if arrayContainsStr(declaredVars, "__is_tail_ret__") and (bi == st.bodyStmts.len - 1):
        ifScopeVars.push("__is_tail_ret__")
      let sub = emitCStmtWithScope(arena, st.bodyStmts[bi], indent + "  ", ifScopeVars)
      mut si = 0
      while si < sub.len:
        lines.push(sub[si])
        si += 1
      bi += 1
    lines.push(indent + "}")
    if st.elseStmts.len > 0:
      mut inElseBlock = false
      mut ei = 0
      while ei < st.elseStmts.len:
        let elId = st.elseStmts[ei]
        let elNode = arena.stmts[elId]
        if elNode.kind == "Elif":
          if inElseBlock:
            lines.push(indent + "}")
            inElseBlock = false
          lines.push(indent + "else if (aipl_truthy(" + emitCExpr(arena, elNode.condExpr) + ")) {")
          mut ebi = 0
          while ebi < elNode.bodyStmts.len:
            mut elifScopeVars: [str] = []
            mut dvi = 0
            while dvi < declaredVars.len:
              let dv = declaredVars[dvi]
              if dv != "__is_tail_ret__":
                elifScopeVars.push(dv)
              dvi += 1
            if arrayContainsStr(declaredVars, "__is_tail_ret__") and (ebi == elNode.bodyStmts.len - 1):
              elifScopeVars.push("__is_tail_ret__")
            let esub = emitCStmtWithScope(arena, elNode.bodyStmts[ebi], indent + "  ", elifScopeVars)
            mut esi = 0
            while esi < esub.len:
              lines.push(esub[esi])
              esi += 1
            ebi += 1
          lines.push(indent + "}")
        else:
          if not inElseBlock:
            lines.push(indent + "else {")
            inElseBlock = true
          mut elseScopeVars: [str] = []
          mut dvi = 0
          while dvi < declaredVars.len:
            let dv = declaredVars[dvi]
            if dv != "__is_tail_ret__":
              elseScopeVars.push(dv)
            dvi += 1
          if arrayContainsStr(declaredVars, "__is_tail_ret__") and (ei == st.elseStmts.len - 1):
            elseScopeVars.push("__is_tail_ret__")
          let esub = emitCStmtWithScope(arena, elId, indent + "  ", elseScopeVars)
          mut esi = 0
          while esi < esub.len:
            lines.push(esub[esi])
            esi += 1
        ei += 1
      if inElseBlock:
        lines.push(indent + "}")
    ret lines
  if st.kind == "While":
    lines.push(indent + "while (aipl_truthy(" + emitCExpr(arena, st.condExpr) + ")) {")
    mut loopScopeVars: [str] = []
    mut dvi = 0
    while dvi < declaredVars.len:
      let dv = declaredVars[dvi]
      if dv != "__is_tail_ret__":
        loopScopeVars.push(dv)
      dvi += 1
    mut bi = 0
    while bi < st.bodyStmts.len:
      let sub = emitCStmtWithScope(arena, st.bodyStmts[bi], indent + "  ", loopScopeVars)
      mut si = 0
      while si < sub.len:
        lines.push(sub[si])
        si += 1
      bi += 1
    lines.push(indent + "}")
    ret lines
  if st.kind == "For":
    let iterVar = st.name
    let uid = str(st.id)
    if st.exprId >= 0 and arena.exprs[st.exprId].kind == "RangeStep":
      let stepExpr = arena.exprs[st.exprId]
      let rngExpr = arena.exprs[stepExpr.left]
      let isInclusive = rngExpr.op == "..="
      let startCode = if canUnboxIntExpr(arena, rngExpr.left): emitUnboxedIntExpr(arena, rngExpr.left) else: "(" + emitCExpr(arena, rngExpr.left) + ").i"
      let endCode = if canUnboxIntExpr(arena, rngExpr.right): emitUnboxedIntExpr(arena, rngExpr.right) else: "(" + emitCExpr(arena, rngExpr.right) + ").i"
      let stepCode = if canUnboxIntExpr(arena, stepExpr.right): emitUnboxedIntExpr(arena, stepExpr.right) else: "(" + emitCExpr(arena, stepExpr.right) + ").i"
      let cmpOpPos = if isInclusive: "<=" else: "<"
      let cmpOpNeg = if isInclusive: ">=" else: ">"
      lines.push(indent + "for (int64_t _i_" + uid + " = " + startCode + ", _step_" + uid + " = " + stepCode + ", _end_" + uid + " = " + endCode + "; (_step_" + uid + " > 0 ? (_i_" + uid + " " + cmpOpPos + " _end_" + uid + ") : (_i_" + uid + " " + cmpOpNeg + " _end_" + uid + ")); _i_" + uid + " += _step_" + uid + ") {")
      lines.push(indent + "  v_" + iterVar + " = aipl_int(_i_" + uid + ");")
      mut loopScopeVars: [str] = []
      mut dvi = 0
      while dvi < declaredVars.len:
        let dv = declaredVars[dvi]
        if dv != "__is_tail_ret__":
          loopScopeVars.push(dv)
        dvi += 1
      mut bi = 0
      while bi < st.bodyStmts.len:
        let sub = emitCStmtWithScope(arena, st.bodyStmts[bi], indent + "  ", loopScopeVars)
        mut si = 0
        while si < sub.len:
          lines.push(sub[si])
          si += 1
        bi += 1
      lines.push(indent + "}")
      ret lines
    elif st.exprId >= 0 and arena.exprs[st.exprId].kind == "Binary" and (arena.exprs[st.exprId].op == ".." or arena.exprs[st.exprId].op == "..="):
      let iterExpr = arena.exprs[st.exprId]
      let isInclusive = iterExpr.op == "..="
      let cmpOp = if isInclusive: "<=" else: "<"
      if canUnboxIntExpr(arena, iterExpr.left) and canUnboxIntExpr(arena, iterExpr.right):
        let startRaw = emitUnboxedIntExpr(arena, iterExpr.left)
        let endRaw = emitUnboxedIntExpr(arena, iterExpr.right)
        lines.push(indent + "for (int64_t _i_" + uid + " = " + startRaw + ", _end_" + uid + " = " + endRaw + "; _i_" + uid + " " + cmpOp + " _end_" + uid + "; _i_" + uid + "++) {")
        lines.push(indent + "  v_" + iterVar + " = aipl_int(_i_" + uid + ");")
      else:
        let startCode = emitCExpr(arena, iterExpr.left)
        let endCode = emitCExpr(arena, iterExpr.right)
        let cmpFn = if isInclusive: "aipl_le" else: "aipl_lt"
        lines.push(indent + "for (v_" + iterVar + " = " + startCode + "; aipl_truthy(" + cmpFn + "(v_" + iterVar + ", " + endCode + ")); v_" + iterVar + " = aipl_add(v_" + iterVar + ", aipl_int(1))) {")
      mut loopScopeVars: [str] = []
      mut dvi = 0
      while dvi < declaredVars.len:
        let dv = declaredVars[dvi]
        if dv != "__is_tail_ret__":
          loopScopeVars.push(dv)
        dvi += 1
      mut bi = 0
      while bi < st.bodyStmts.len:
        let sub = emitCStmtWithScope(arena, st.bodyStmts[bi], indent + "  ", loopScopeVars)
        mut si = 0
        while si < sub.len:
          lines.push(sub[si])
          si += 1
        bi += 1
      lines.push(indent + "}")
      ret lines
    else:
      let collCode = emitCExpr(arena, st.exprId)
      lines.push(indent + "AiplVal v__c_" + uid + " = " + collCode + ";")
      lines.push(indent + "int64_t v__len_" + uid + " = aipl_member_len(v__c_" + uid + ").i;")
      lines.push(indent + "for (int64_t v__idx_" + uid + " = 0; v__idx_" + uid + " < v__len_" + uid + "; v__idx_" + uid + "++) {")
      lines.push(indent + "  AiplVal _elem_" + uid + " = aipl_index_get(v__c_" + uid + ", aipl_int(v__idx_" + uid + "));")
      if st.name.contains(","):
        let parts = st.name.split(",")
        mut pi = 0
        while pi < parts.len:
          mut vn = parts[pi].trim()
          mut accessPath = str(pi)
          if vn.contains(":"):
            let p = vn.split(":")
            vn = p[0].trim()
            if p.len > 1:
              accessPath = p[1].trim()
          if vn.startsWith("("):
            vn = vn.slice(1, vn.len).trim()
          if vn.endsWith(")"):
            vn = vn.slice(0, vn.len - 1).trim()
          if vn.len > 0 and vn != "_":
            let pSteps = accessPath.split(".")
            mut acc = "_elem_" + uid
            mut si = 0
            while si < pSteps.len:
              acc = "aipl_index_get(" + acc + ", aipl_int(" + pSteps[si] + "))"
              si += 1
            lines.push(indent + "  v_" + vn + " = " + acc + ";")
          pi += 1
      else:
        lines.push(indent + "  v_" + iterVar + " = _elem_" + uid + ";")
      mut loopVars: [str] = []
      mut lvi = 0
      while lvi < declaredVars.len:
        let dv = declaredVars[lvi]
        if dv != "__is_tail_ret__":
          loopVars.push(dv)
        lvi += 1
      let isMutFor = st.isMut
      if isMutFor:
        loopVars.push("__for_mut__:aipl_index_set_val(v__c_" + uid + ", aipl_int(v__idx_" + uid + "), v_" + iterVar + ");")
      mut bi = 0
      while bi < st.bodyStmts.len:
        let sub = emitCStmtWithScope(arena, st.bodyStmts[bi], indent + "  ", loopVars)
        mut si = 0
        while si < sub.len:
          lines.push(sub[si])
          si += 1
        bi += 1
      if isMutFor:
        lines.push(indent + "  aipl_index_set_val(v__c_" + uid + ", aipl_int(v__idx_" + uid + "), v_" + iterVar + ");")
      lines.push(indent + "}")
      ret lines
  if st.kind == "Match":
    let targetCode = emitCExpr(arena, st.exprId)
    let uid = str(st.id)
    lines.push(indent + "AiplVal v__m_" + uid + " = " + targetCode + ";")
    mut ai = 0
    while ai < st.matchArms.len:
      let arm = arena.stmts[st.matchArms[ai]]
      let prefix = if ai == 0: "if" else: "else if"
      mut cleanArmName = arm.name
      mut isStrPat = false
      if not cleanArmName.contains("|") and cleanArmName.startsWith("\"") and cleanArmName.endsWith("\"") and cleanArmName.len >= 2:
        cleanArmName = cleanArmName.slice(1, cleanArmName.len - 1)
        isStrPat = true
      elif not cleanArmName.contains("|") and cleanArmName.startsWith("'") and cleanArmName.endsWith("'") and cleanArmName.len >= 2:
        cleanArmName = cleanArmName.slice(1, cleanArmName.len - 1)
        isStrPat = true
      elif cleanArmName.contains("."):
        let p = cleanArmName.split(".")
        if p.len > 1:
          cleanArmName = p[1]
      mut guardSuffix = ""
      if arm.exprId >= 0:
        guardSuffix = " && (" + emitCExpr(arena, arm.exprId) + ").b"
      let isCatchAll = if isStrPat: false else: isCatchAllArm(arena, cleanArmName)
      if isCatchAll:
        let bindPrefix = if cleanArmName != "_" and cleanArmName != "else": "(v_" + cleanArmName + " = v__m_" + uid + ", 1)" else: "1"
        if guardSuffix.len > 0:
          lines.push(indent + prefix + " (" + bindPrefix + guardSuffix + ") {")
        else:
          if ai == 0:
            lines.push(indent + "if (1) {")
          else:
            lines.push(indent + "else {")
        if cleanArmName != "_" and cleanArmName != "else":
          lines.push(indent + "  v_" + cleanArmName + " = v__m_" + uid + ";")
      else:
        mut effArmName = cleanArmName
        if effArmName.startsWith("(") and effArmName.endsWith(")") and effArmName.contains(","):
          effArmName = "__tuple__:" + effArmName.slice(1, effArmName.len - 1)
        lines.push(indent + prefix + " (aipl_truthy(aipl_match_arm(v__m_" + uid + ", " + escapeCStringLiteral(effArmName) + "))" + guardSuffix + ") {")
      mut bi = 0
      while bi < arm.bodyStmts.len:
        mut armScopeVars: [str] = []
        mut dvi = 0
        while dvi < declaredVars.len:
          let dv = declaredVars[dvi]
          if dv != "__is_tail_ret__":
            armScopeVars.push(dv)
          dvi += 1
        let isTailArm = arrayContainsStr(declaredVars, "__is_tail_ret__") and (bi == arm.bodyStmts.len - 1)
        if isTailArm:
          armScopeVars.push("__is_tail_ret__")
        let sub = emitCStmtWithScope(arena, arm.bodyStmts[bi], indent + "  ", armScopeVars)
        mut si = 0
        while si < sub.len:
          lines.push(sub[si])
          si += 1
        bi += 1
      lines.push(indent + "}")
      ai += 1
    ret lines
  ret lines

pub fn emitCStmt(arena: AstArena, stmtId: int, indent: str): [str]:
  mut emptyScope: [str] = []
  mut lines: [str] = []
  if stmtId >= 0 and stmtId < arena.stmts.len:
    let st = arena.stmts[stmtId]
    if st.span.line > 0:
      lines.push("#line " + str(st.span.line))
  let sub = emitCStmtWithScope(arena, stmtId, indent, emptyScope)
  mut si = 0
  while si < sub.len:
    lines.push(sub[si])
    si += 1
  ret lines

// ============================================================================
// Phase 18: Split Modular C Runtime (runtime/aipl_runtime.h + runtime/rt_*.c)
// ============================================================================
// The C99 runtime lives in runtime/ as ordinary C sources. Generated programs only
// `#include <aipl_runtime.h>` (angle form: never resolved from the /tmp directory of the generated file) and link a precompiled static archive that is rebuilt
// (in parallel, once) whenever any runtime/* file changes:
//   <root>/.aipl/cache/v1/libaipl_rt.a      - rt_core.c + rt_crypto_data.c + rt_sys.c
//   <root>/.aipl/cache/v1/libaipl_rt_gui.a  - the same modules + rt_gui_audio.c, built with
//                                             -DAIPL_ENABLE_GUI_AUDIO=1 (GUI/audio programs only)

pub struct RuntimeArchive:
  ok: bool
  includeDir: str
  archivePath: str
  error: str

pub fn runtimeArchiveCFlags(): str:
  ret "-std=c99 -O2 -pipe -pthread -ffunction-sections -fdata-sections -Wall -Wextra -Wno-unused-parameter -Wno-unused-function -Wno-unused-variable -Wno-unused-but-set-variable -Wno-misleading-indentation -Wno-format-truncation"

pub fn runtimeSourceNames(gui: bool): [str]:
  mut names: [str] = ["rt_core.c", "rt_crypto_data.c", "rt_sys.c"]
  if gui:
    names.push("rt_gui_audio.c")
  ret names

fn absolutizePath(p: str): str:
  if p.len == 0 or pathIsAbsolute(p):
    ret p
  let base = cwd()
  if base.len == 0:
    ret p
  ret pathNormalize(pathJoin(base, p))

// Locates the runtime/ directory: $AIPL_RUNTIME_DIR, then <stdlib root>/runtime, then ./runtime.
pub fn resolveRuntimeDir(): str:
  let envRt = getEnv("AIPL_RUNTIME_DIR")
  if envRt.isSome():
    let d = envRt.unwrap()
    if d.len > 0 and fileExists(pathJoin(d, "aipl_runtime.h")):
      ret absolutizePath(d)
  let cand = pathJoin(resolveStdlibRoot(), "runtime")
  if fileExists(pathJoin(cand, "aipl_runtime.h")):
    ret absolutizePath(cand)
  if fileExists("runtime/aipl_runtime.h"):
    ret absolutizePath("runtime")
  ret ""

pub fn readRuntimeHeaderText(): str:
  let d = resolveRuntimeDir()
  if d.len == 0:
    ret ""
  ret readFile(pathJoin(d, "aipl_runtime.h"))

pub const AIPL_RUNTIME_INCLUDE: str = "#include <aipl_runtime.h>"

pub fn emitCRuntimeHeaderForModule(hir: HirModule): str:
  if moduleUsesGuiOrAudio(hir):
    ret "#ifndef AIPL_ENABLE_GUI_AUDIO\n#define AIPL_ENABLE_GUI_AUDIO 1\n#endif\n#include <aipl_runtime.h>"
  ret "#include <aipl_runtime.h>"

// Self-contained runtime amalgamation (header + module sources) used for standalone C output
// (`aipl build --c`, `aipl transpile --target c`) that must compile with a bare `cc file.c`.
pub fn emitCRuntimeAmalgamation(gui: bool): str:
  let d = resolveRuntimeDir()
  if d.len == 0:
    ret "#error \"AIPL runtime sources not found: set AIPL_RUNTIME_DIR to the aipl runtime/ directory\""
  let includeLine = "#include \"aipl_runtime.h\""
  mut parts: [str] = []
  parts.push(readFile(pathJoin(d, "aipl_runtime.h")))
  let names = runtimeSourceNames(gui)
  mut ni = 0
  while ni < names.len:
    parts.push(readFile(pathJoin(d, names[ni])).replace(includeLine, "/* (aipl_runtime.h amalgamated above) */"))
    ni += 1
  ret parts.join("\n")

pub fn emitCRuntimeHeader(): str:
  ret "#ifndef AIPL_ENABLE_GUI_AUDIO\n#define AIPL_ENABLE_GUI_AUDIO 1\n#endif\n" + emitCRuntimeAmalgamation(true)

pub fn shellQuote(s: str): str:
  ret "'" + s.replace("'", "'\\''") + "'"

// Archive cache location: <aipl root>/.aipl/cache/v1 (owned by the toolchain checkout), else the
// per-user $XDG_CACHE_HOME/aipl/v1 or ~/.cache/aipl/v1. Never a shared world-writable directory.
fn runtimeCacheDir(rtDir: str): str:
  let primary = pathJoin(pathDirname(rtDir), ".aipl/cache/v1")
  if not isDir(primary):
    let _ = mkdirAll(primary)
  if isDir(primary) and dirIsWritable(primary):
    ret primary
  mut userCache = ""
  let xdg = getEnv("XDG_CACHE_HOME")
  if xdg.isSome() and xdg.unwrap().len > 0:
    userCache = pathJoin(xdg.unwrap(), "aipl/v1")
  else:
    let home = getEnv("HOME")
    if home.isSome() and home.unwrap().len > 0:
      userCache = pathJoin(home.unwrap(), ".cache/aipl/v1")
  if userCache.len == 0:
    ret ""
  if not isDir(userCache):
    let _ = mkdirAll(userCache)
  let _ = execCommand("chmod", ["700", userCache])
  ret userCache

fn dirIsWritable(dir: str): bool:
  let probe = pathJoin(dir, ".aipl-write-probe-" + uniqueTag())
  writeFile(probe, "")
  if not fileExists(probe):
    ret false
  let _ = removeFile(probe)
  ret true

fn uniqueTag(): str:
  ret str(nowMonoNs()) + "-" + hexEncode(randomBytes(8))

fn runtimeArchiveFail(msg: str): RuntimeArchive:
  ret RuntimeArchive(ok = false, includeDir = "", archivePath = "", error = msg)

fn runtimeSourceHash(rtDir: str, names: [str], flags: str): str:
  mut fingerprint: [str] = [flags, readFile(pathJoin(rtDir, "aipl_runtime.h"))]
  mut ni = 0
  while ni < names.len:
    fingerprint.push(names[ni])
    fingerprint.push(readFile(pathJoin(rtDir, names[ni])))
    ni += 1
  ret sha256(fingerprint.join("\n/*--aipl-rt--*/\n"))

// Builds (or reuses) the precompiled runtime archive. Archives are content-addressed
// (libaipl_rt[-gui]-<sha256 prefix>.a over the compiler flags and every runtime source), so a
// cache hit can never pair a header with objects from another runtime revision; concurrent
// builders compile into private temp dirs and publish atomically via rename().
pub fn ensureRuntimeArchive(gui: bool): RuntimeArchive:
  let rtDir = resolveRuntimeDir()
  if rtDir.len == 0:
    ret runtimeArchiveFail("AIPL runtime sources (runtime/aipl_runtime.h) not found; set AIPL_RUNTIME_DIR")
  let names = runtimeSourceNames(gui)
  let cflags = runtimeArchiveCFlags()
  let guiFlag = if gui: " -DAIPL_ENABLE_GUI_AUDIO=1" else: ""
  let hash = runtimeSourceHash(rtDir, names, cflags + guiFlag)
  let cacheDir = runtimeCacheDir(rtDir)
  if cacheDir.len == 0:
    ret runtimeArchiveFail("No writable cache directory for the AIPL runtime archive")
  let base = if gui: "libaipl_rt_gui" else: "libaipl_rt"
  let archive = pathJoin(cacheDir, base + "-" + hash.slice(0, 16) + ".a")
  let canonicalArchive = pathJoin(cacheDir, base + ".a")
  if fileExists(archive):
    if not fileExists(canonicalArchive):
      let _ln = execCommand("ln", ["-sf", base + "-" + hash.slice(0, 16) + ".a", canonicalArchive])
    ret RuntimeArchive(ok = true, includeDir = rtDir, archivePath = archive, error = "")

  let tag = uniqueTag()
  let objDir = pathJoin(cacheDir, "obj-" + base + "-" + tag)
  let _ = mkdirAll(objDir)
  mut cmds: [str] = []
  mut objs: [str] = []
  mut errs: [str] = []
  mut ni = 0
  while ni < names.len:
    let src = pathJoin(rtDir, names[ni])
    let obj = pathJoin(objDir, names[ni].replace(".c", ".o"))
    let errPath = obj + ".err"
    cmds.push("cc " + cflags + guiFlag + " -I " + shellQuote(rtDir) + " -c " + shellQuote(src) + " -o " + shellQuote(obj) + " 2> " + shellQuote(errPath))
    objs.push(obj)
    errs.push(errPath)
    ni += 1
  let codes = execParallel(cmds, hardwareConcurrency())
  mut failMsg = ""
  ni = 0
  while ni < names.len:
    let code = if ni < codes.len: codes[ni] else: 1
    if code != 0 and failMsg.len == 0:
      failMsg = "Failed to compile AIPL runtime module " + names[ni] + ":\n" + readFile(errs[ni])
    ni += 1
  // The sources must not have changed while they were being compiled.
  if failMsg.len == 0 and runtimeSourceHash(rtDir, names, cflags + guiFlag) != hash:
    failMsg = "AIPL runtime sources changed during the archive build; please retry"
  let tmpArchive = pathJoin(objDir, base + ".a")
  if failMsg.len == 0:
    mut arArgs: [str] = ["rcs", tmpArchive]
    ni = 0
    while ni < objs.len:
      arArgs.push(objs[ni])
      ni += 1
    let arRes = execCommand("ar", arArgs)
    if arRes.isErr():
      failMsg = "Failed to run ar for the AIPL runtime archive: " + arRes.unwrapErr()
    elif arRes.unwrap().status != 0:
      failMsg = "ar failed for the AIPL runtime archive: " + arRes.unwrap().stderr
  if failMsg.len == 0:
    let mv = renameFile(tmpArchive, archive)
    if mv.isErr():
      failMsg = "Failed to publish AIPL runtime archive " + archive + ": " + mv.unwrapErr()
    else:
      let _ln2 = execCommand("ln", ["-sf", base + "-" + hash.slice(0, 16) + ".a", canonicalArchive])
  ni = 0
  while ni < objs.len:
    let _ro = removeFile(objs[ni])
    let _re = removeFile(errs[ni])
    ni += 1
  let _rt = removeFile(tmpArchive)
  let _rd = execCommand("rmdir", [objDir])
  if failMsg.len > 0:
    ret runtimeArchiveFail(failMsg)
  ret RuntimeArchive(ok = true, includeDir = rtDir, archivePath = archive, error = "")

fn cSourceUsesGuiRuntime(cSource: str): bool:
  let idx = cSource.indexOf("#include <aipl_runtime.h>")
  if idx <= 0:
    ret false
  ret cSource.slice(0, idx).contains("AIPL_ENABLE_GUI_AUDIO")

// Compiles modular generated C (which includes aipl_runtime.h) against the cached runtime archive.
pub fn compileCWithRuntime(cSource: str, outputPath: str, optFlag: str, debugInfo: bool): Result[int, str]:
  let rt = ensureRuntimeArchive(cSourceUsesGuiRuntime(cSource))
  if not rt.ok:
    ret Err(rt.error)
  ret compileCSourceSharded(cSource, outputPath, optFlag, debugInfo, rt.includeDir, rt.archivePath)

// ============================================================================
// Emitted Full C99 Source Assembly
// ============================================================================

pub fn getIntrinsicSymbolFromComment(comment: str): str:
  if comment.contains("@intrinsic"):
    let sIdx = comment.indexOf("@intrinsic")
    let pOpen = comment.indexOf("(", sIdx)
    if pOpen >= 0:
      let q1 = comment.indexOf("\"", pOpen)
      if q1 >= 0:
        let q2 = comment.indexOf("\"", q1 + 1)
        if q2 > q1:
          ret comment.slice(q1 + 1, q2)
  ret ""

pub fn emitCFunctionsStride(hir: HirModule, safeFile: str, startOffset: int, stride: int): str:
  mut lines: [str] = []
  mut fni = startOffset
  let step = if stride > 0: stride else: 1
  while fni < hir.functions.len:
    let f = hir.functions[fni]
    if not isEmittedAsIntrinsic(hir, f.name):
      if hir.emitLineDirectives and f.span.line > 0:
        lines.push("#line " + str(f.span.line) + " \"" + safeFile + "\"")
      mut pNames: [str] = []
      mut declaredVars: [str] = []
      mut refParamNames: [str] = []
      mut pi = 0
      while pi < f.paramNames.len:
        let pname = f.paramNames[pi]
        let isRef = pi < f.paramTypes.len and f.paramTypes[pi].startsWith("&")
        if isRef:
          pNames.push("AiplVal* p_ref_" + pname)
          declaredVars.push("&" + pname)
          refParamNames.push(pname)
        else:
          pNames.push("AiplVal v_" + pname)
          declaredVars.push(pname)
        pi += 1
      let pSig = if pNames.len > 0: pNames.join(", ") else: "void"
      let hotAttr = if f.isHotLoop: "__attribute__((hot)) " else: ""
      lines.push("/* AIPL Function: " + f.name + " */")
      lines.push(hotAttr + "AiplVal aipl_fn_" + f.name + "(" + pSig + ") {")
      let intrinSym = getIntrinsicSymbolFromComment(f.docComment)
      if intrinSym.len > 0:
        mut cArgs: [str] = []
        mut pi2 = 0
        while pi2 < f.paramNames.len:
          cArgs.push("v_" + f.paramNames[pi2])
          pi2 += 1
        lines.push("  return " + intrinSym + "(" + cArgs.join(", ") + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "emitCFunctionsParallel":
        lines.push("  return aipl_rt_parallel_emit_c(v_hir, v_safeFile);")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "compileCSourceSharded" and f.paramNames.len == 6:
        lines.push("  return aipl_rt_compile_c_parallel(v_cSource, v_outputPath, v_optFlag, v_debugInfo, v_includeDir, v_archivePath);")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "compileFrontendParallel" and f.paramNames.len == 3:
        lines.push("  return aipl_rt_parallel_frontend(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ", aipl_fn_parseModuleChunk);")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "optimizeHirFunctionsParallel" and f.paramNames.len == 1:
        lines.push("  return aipl_rt_parallel_optimize_hir(v_" + f.paramNames[0] + ", aipl_fn_optimizeHirFunctionsStride);")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "typecheckHirBatch" and f.paramNames.len == 4:
        lines.push("  return aipl_rt_parallel_typecheck(v_" + f.paramNames[0] + ", v_" + f.paramNames[2] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[3] + ", aipl_fn_typecheckHirStride);")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "verifyHirSmtParallel" and f.paramNames.len == 5:
        lines.push("  return aipl_rt_parallel_smt(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ", v_" + f.paramNames[3] + ", v_" + f.paramNames[4] + ", aipl_fn_verifyHirSmtStride);")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "prepareTestFilesParallel" and f.paramNames.len == 3:
        lines.push("  return aipl_rt_parallel_test_prepare(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ", aipl_fn_prepareSingleTestFileC);")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "tensorMatmul" and f.paramNames.len == 5:
        lines.push("  return aipl_rt_tensor_matmul(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ", v_" + f.paramNames[3] + ", v_" + f.paramNames[4] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "tensorDot" and f.paramNames.len == 2:
        lines.push("  return aipl_rt_tensor_dot(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "parallelMatmulInt" and f.paramNames.len == 6:
        lines.push("  return aipl_rt_parallel_matmul_int(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ", v_" + f.paramNames[3] + ", v_" + f.paramNames[4] + ", v_" + f.paramNames[5] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "hardwareConcurrency":
        lines.push("  return aipl_rt_hardware_concurrency();")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "execParallel":
        lines.push("  return aipl_rt_exec_parallel(" + (if f.paramNames.len > 0: "v_" + f.paramNames[0] else: "aipl_array_new(NULL, 0)") + ", " + (if f.paramNames.len > 1: "v_" + f.paramNames[1] else: "aipl_int(0)") + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "ptrAlloc" and f.paramNames.len == 1:
        lines.push("  return aipl_rt_ptrAlloc(v_" + f.paramNames[0] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "ptrFree" and f.paramNames.len == 1:
        lines.push("  return aipl_rt_ptrFree(v_" + f.paramNames[0] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "ptrReadU8" and f.paramNames.len == 2:
        lines.push("  return aipl_rt_ptrReadU8(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "ptrWriteU8" and f.paramNames.len == 3:
        lines.push("  return aipl_rt_ptrWriteU8(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "ptrReadI64" and f.paramNames.len == 2:
        lines.push("  return aipl_rt_ptrReadI64(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "ptrWriteI64" and f.paramNames.len == 3:
        lines.push("  return aipl_rt_ptrWriteI64(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "sizeofType" and f.paramNames.len == 1:
        lines.push("  return aipl_rt_sizeofType(v_" + f.paramNames[0] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "bitcastF64ToI64" and f.paramNames.len == 1:
        lines.push("  return aipl_rt_bitcastF64ToI64(v_" + f.paramNames[0] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "bitcastI64ToF64" and f.paramNames.len == 1:
        lines.push("  return aipl_rt_bitcastI64ToF64(v_" + f.paramNames[0] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "rawSyscall" and f.paramNames.len == 7:
        lines.push("  return aipl_rt_rawSyscall(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ", v_" + f.paramNames[3] + ", v_" + f.paramNames[4] + ", v_" + f.paramNames[5] + ", v_" + f.paramNames[6] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "rawSyscall0" and f.paramNames.len == 1:
        lines.push("  return aipl_rt_rawSyscall0(v_" + f.paramNames[0] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "rawSyscall1" and f.paramNames.len == 2:
        lines.push("  return aipl_rt_rawSyscall1(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "rawSyscall2" and f.paramNames.len == 3:
        lines.push("  return aipl_rt_rawSyscall2(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "rawSyscall3" and f.paramNames.len == 4:
        lines.push("  return aipl_rt_rawSyscall3(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ", v_" + f.paramNames[3] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "rawSyscall4" and f.paramNames.len == 5:
        lines.push("  return aipl_rt_rawSyscall4(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ", v_" + f.paramNames[3] + ", v_" + f.paramNames[4] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "rawSyscall5" and f.paramNames.len == 6:
        lines.push("  return aipl_rt_rawSyscall5(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ", v_" + f.paramNames[3] + ", v_" + f.paramNames[4] + ", v_" + f.paramNames[5] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "rawSyscall6" and f.paramNames.len == 7:
        lines.push("  return aipl_rt_rawSyscall6(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ", v_" + f.paramNames[3] + ", v_" + f.paramNames[4] + ", v_" + f.paramNames[5] + ", v_" + f.paramNames[6] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "drawPixelBuffer" and f.paramNames.len == 7:
        lines.push("  return aipl_rt_drawPixelBuffer(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ", v_" + f.paramNames[3] + ", v_" + f.paramNames[4] + ", v_" + f.paramNames[5] + ", v_" + f.paramNames[6] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "drawCirclesSoA" and f.paramNames.len == 5:
        lines.push("  return aipl_rt_drawCirclesSoA(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ", v_" + f.paramNames[3] + ", v_" + f.paramNames[4] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "drawRectsSoA" and f.paramNames.len == 6:
        lines.push("  return aipl_rt_drawRectsSoA(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ", v_" + f.paramNames[2] + ", v_" + f.paramNames[3] + ", v_" + f.paramNames[4] + ", v_" + f.paramNames[5] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "realpath" and f.paramNames.len == 1:
        lines.push("  return aipl_rt_realpath(v_" + f.paramNames[0] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "arenaActiveDepth":
        lines.push("  return aipl_rt_arenaActiveDepth();")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      if f.name == "arenaPopEvacuate" and f.paramNames.len == 2:
        lines.push("  return aipl_rt_arenaPopEvacuate(v_" + f.paramNames[0] + ", v_" + f.paramNames[1] + ");")
        lines.push("}")
        lines.push("")
        fni += step
        continue
      mut rpi = 0
      while rpi < refParamNames.len:
        let rp = refParamNames[rpi]
        lines.push("  AiplVal v_" + rp + " = *p_ref_" + rp + ";")
        rpi += 1
      mut emptyVars: [str] = []
      let allLocalVars = collectStmtListVarNames(hir.arena, f.bodyStmts, emptyVars)
      mut vi = 0
      while vi < allLocalVars.len:
        let vname = allLocalVars[vi]
        if not arrayContainsStr(f.paramNames, vname):
          lines.push("  AiplVal v_" + vname + " = aipl_nil();")
        vi += 1
      // Emit requires contracts
      mut ri = 0
      while ri < f.requiresExprs.len:
        let reqExpr = f.requiresExprs[ri]
        mut reqInBody = false
        mut rbi = 0
        while rbi < f.bodyStmts.len:
          let rbs = f.bodyStmts[rbi]
          if rbs >= 0 and rbs < hir.arena.stmts.len and hir.arena.stmts[rbs].kind == "Require" and hir.arena.stmts[rbs].exprId == reqExpr:
            reqInBody = true
            break
          rbi += 1
        if reqExpr >= 0 and not reqInBody:
          if isContractProvenStatic(hir.arena, reqExpr):
            lines.push("  /* [SMT: PROVEN_STATIC] elided requires contract in " + cEscape(f.name) + " */")
          else:
            lines.push("  aipl_rt_assert(" + emitCExpr(hir.arena, reqExpr) + ", \"requires contract failed in " + cEscape(f.name) + "\");")
        ri += 1
      // Register ensures contracts for Return emission
      mut eni = 0
      while eni < f.ensuresExprs.len:
        let ensExpr = f.ensuresExprs[eni]
        if ensExpr >= 0:
          let ensTag = "__ensures__:" + str(ensExpr)
          if not arrayContainsStr(declaredVars, ensTag):
            declaredVars.push(ensTag)
        eni += 1
      mut bsi0 = 0
      while bsi0 < f.bodyStmts.len:
        let bsid0 = f.bodyStmts[bsi0]
        if bsid0 >= 0 and bsid0 < hir.arena.stmts.len:
          let bst0 = hir.arena.stmts[bsid0]
          if (bst0.kind == "Ensure" or bst0.kind == "Ensures") and bst0.exprId >= 0:
            let ensTag = "__ensures__:" + str(bst0.exprId)
            if not arrayContainsStr(declaredVars, ensTag):
              declaredVars.push(ensTag)
        bsi0 += 1
      mut bsi = 0
      while bsi < f.bodyStmts.len:
        let bodyStmtId = f.bodyStmts[bsi]
        if hir.emitLineDirectives and bodyStmtId >= 0 and bodyStmtId < hir.arena.stmts.len:
          let bodySt = hir.arena.stmts[bodyStmtId]
          if bodySt.span.line > 0:
            lines.push("#line " + str(bodySt.span.line) + " \"" + safeFile + "\"")
        mut stmtVars: [str] = []
        mut dvi = 0
        while dvi < declaredVars.len:
          stmtVars.push(declaredVars[dvi])
          dvi += 1
        let isTailStmt = (bsi == f.bodyStmts.len - 1) and (f.retType != "void" and f.retType != "")
        if isTailStmt:
          stmtVars.push("__is_tail_ret__")
        let stLines = emitCStmtWithScope(hir.arena, bodyStmtId, "  ", stmtVars)
        mut sli = 0
        while sli < stLines.len:
          lines.push(stLines[sli])
          sli += 1
        bsi += 1
      let lastLine = if lines.len > 0: lines[lines.len - 1] else: ""
      let hasExplicitOrTailReturn = lastLine.startsWith("  return ") or stmtListTerminatesWithRet(hir.arena, f.bodyStmts)
      if not hasExplicitOrTailReturn:
        mut rpi2 = 0
        while rpi2 < refParamNames.len:
          let rp = refParamNames[rpi2]
          lines.push("  *p_ref_" + rp + " = v_" + rp + ";")
          rpi2 += 1
        mut eni2 = 0
        while eni2 < f.ensuresExprs.len:
          let ensExpr2 = f.ensuresExprs[eni2]
          if ensExpr2 >= 0:
            let ensCode2 = emitCExpr(hir.arena, ensExpr2)
            if not ensCode2.contains("v_ret") and not ensCode2.contains("v_result"):
              if isContractProvenStatic(hir.arena, ensExpr2):
                lines.push("  /* [SMT: PROVEN_STATIC] elided ensures contract in " + cEscape(f.name) + " */")
              else:
                lines.push("  aipl_rt_assert(" + ensCode2 + ", \"ensures contract failed in " + cEscape(f.name) + "\");")
          eni2 += 1
        lines.push("  return aipl_nil();")
      lines.push("}")
      lines.push("")
    fni += step
  ret lines.join("\n")

pub fn isContractProvenStatic(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "LitBool":
    ret e.boolVal
  if e.kind == "Binary" and e.left >= 0 and e.left < arena.exprs.len and e.right >= 0 and e.right < arena.exprs.len:
    let l = arena.exprs[e.left]
    let r = arena.exprs[e.right]
    if l.kind == "Ident" and r.kind == "Ident" and l.strVal == r.strVal:
      if e.op == "==" or e.op == ">=" or e.op == "<=":
        ret true
    if l.kind == "LitInt" and r.kind == "LitInt":
      if e.op == "==":
        ret l.intVal == r.intVal
      if e.op == "!=":
        ret l.intVal != r.intVal
      if e.op == ">":
        ret l.intVal > r.intVal
      if e.op == ">=":
        ret l.intVal >= r.intVal
      if e.op == "<":
        ret l.intVal < r.intVal
      if e.op == "<=":
        ret l.intVal <= r.intVal
  ret false

pub fn stmtListTerminatesWithRet(arena: AstArena, stmts: [int]): bool:
  if stmts.len == 0:
    ret false
  let lastId = stmts[stmts.len - 1]
  if lastId < 0 or lastId >= arena.stmts.len:
    ret false
  let st = arena.stmts[lastId]
  if st.kind == "Return":
    ret true
  if st.kind == "If" and st.elseStmts.len > 0:
    if not stmtListTerminatesWithRet(arena, st.bodyStmts):
      ret false
    let lastElseId = st.elseStmts[st.elseStmts.len - 1]
    if lastElseId >= 0 and lastElseId < arena.stmts.len and arena.stmts[lastElseId].kind == "Elif":
      ret false
    ret stmtListTerminatesWithRet(arena, st.elseStmts)
  ret false

pub fn emitCFunctionsParallel(hir: HirModule, safeFile: str): str:
  ret emitCFunctionsStride(hir, safeFile, 0, 1)

fn countCSignatureParams(sig: str): int:
  let t = sig.trim()
  if t.len == 0 or t == "void":
    ret 0
  mut n = 1
  mut i = 0
  while i < t.len:
    if t.charCodeAt(i) == 44:
      n += 1
    i += 1
  ret n

// True when the program calls `name` at least once and every call passes exactly the AIPL
// definition's arity (never the runtime intrinsic's), i.e. the user definition is the target.
fn allCallsMatchArity(arena: AstArena, name: str, userArity: int, rtArity: int): bool:
  mut seen = 0
  mut i = 0
  while i < arena.exprs.len:
    let e = arena.exprs[i]
    if e.kind == "Call" and e.left >= 0 and e.left < arena.exprs.len:
      let c = arena.exprs[e.left]
      if c.kind == "Ident" and c.strVal == name:
        if e.children.len == rtArity or e.children.len > userArity:
          ret false
        seen += 1
    i += 1
  ret seen > 0

pub fn computeIntrinsicOverrides(hir: HirModule, rtHeader: str): [str]:
  mut out: [str] = []
  mut fi = 0
  while fi < hir.functions.len:
    let f = hir.functions[fi]
    // Variadic intrinsics (drawRectOutline/drawRectLines + arity-suffixed variants such as
    // aipl_rt_drawRectOutline6) and specially-mapped helpers keep their dedicated dispatch.
    let specialDispatch = f.name == "drawRectOutline" or f.name == "drawRectLines" or f.name == "hardwareConcurrency" or f.name == "execParallel" or f.name.startsWith("aipl_rt_")
    let hasArityVariant = rtHeader.contains("AiplVal aipl_rt_" + f.name + str(f.paramNames.len) + "(")
    if isIntrinsicName(f.name) and not specialDispatch and not hasArityVariant and not arrayContainsStr(out, f.name):
      let key = "AiplVal aipl_rt_" + f.name + "("
      let idx = rtHeader.indexOf(key)
      if idx >= 0:
        let start = idx + key.len
        let close = rtHeader.indexOf(")", start)
        if close > start - 1:
          let arity = countCSignatureParams(rtHeader.slice(start, close))
          if arity != f.paramNames.len and allCallsMatchArity(hir.arena, f.name, f.paramNames.len, arity):
            out.push(f.name)
    fi += 1
  ret out

fn isEmittedAsIntrinsic(hir: HirModule, name: str): bool:
  ret isIntrinsicName(name) and not arrayContainsStr(hir.intrinsicOverrides, name)

pub const AIPL_DEFERRED_FROMJSON_SLOT: str = "/*@@AIPL_DEFERRED_FROMJSON_SLOT@@*/"
pub const AIPL_DEFERRED_MACRO_SLOT: str = "/*@@AIPL_DEFERRED_MACRO_SLOT@@*/"

fn isCIdentChar(c: int): bool:
  ret (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95

// Collects every identifier suffix that follows `prefix` in `text` (one linear scan).
fn collectPrefixedRefs(text: str, prefix: str, mut refs: Map[str, bool]):
  mut p = text.indexOf(prefix, 0)
  while p >= 0:
    let start = p + prefix.len
    mut q = start
    while q < text.len and isCIdentChar(text.charCodeAt(q)):
      q += 1
    if q > start:
      refs.set(text.slice(start, q), true)
    p = text.indexOf(prefix, q)

fn macroKeyReferenced(key: str, refs: Map[str, bool]): bool:
  if key == "hardware_concurrency":
    ret refs.containsKey("hardwareConcurrency") or refs.containsKey("thread_hardwareConcurrency") or refs.containsKey("aipl_rt_hardware_concurrency")
  if key == "exec_parallel":
    ret refs.containsKey("execParallel") or refs.containsKey("thread_execParallel") or refs.containsKey("aipl_rt_exec_parallel")
  ret refs.containsKey(key)

// Splices the deferred typed-JSON decoders and intrinsic alias macros back into their slots,
// keeping only the blocks the final program text references.
pub fn assembleDeferredC(text: str, keys: [str], blocks: [str], isMacro: [bool]): str:
  mut fjRefs: Map[str, bool] = Map.new()
  collectPrefixedRefs(text, "aipl_from_json_", fjRefs)
  mut keptFj: [str] = []
  mut di = 0
  while di < keys.len:
    if not isMacro[di] and fjRefs.containsKey(keys[di]):
      keptFj.push(blocks[di])
    di += 1
  let fjText = keptFj.join("\n")
  mut refs: Map[str, bool] = Map.new()
  collectPrefixedRefs(text, "aipl_fn_", refs)
  collectPrefixedRefs(fjText, "aipl_fn_", refs)
  mut keptMacros: [str] = []
  di = 0
  while di < keys.len:
    if isMacro[di] and macroKeyReferenced(keys[di], refs):
      keptMacros.push(blocks[di])
    di += 1
  // Slots are matched as whole lines: the marker text can also occur inside C string literals
  // (e.g. when compiling this very module), which are never alone on a line.
  let nl = "\n"
  ret text.replace(nl + AIPL_DEFERRED_FROMJSON_SLOT + nl, nl + fjText + nl).replace(nl + AIPL_DEFERRED_MACRO_SLOT + nl, nl + keptMacros.join(nl) + nl)

// Standalone variant: the runtime header and sources are amalgamated in place of the
// `#include <aipl_runtime.h>` line so the result compiles with a bare `cc file.c -lm -ldl -lpthread`.
pub fn emitCSourceStandalone(hirIn: HirModule, bundledSource: str): str:
  let modular = emitCSource(hirIn, bundledSource)
  let includeLine = "#include <aipl_runtime.h>"
  let idx = modular.indexOf(includeLine)
  if idx < 0:
    ret modular
  ret modular.slice(0, idx) + emitCRuntimeAmalgamation(moduleUsesGuiOrAudio(hirIn)) + modular.slice(idx + includeLine.len, modular.len)

// `debugLines` re-enables `#line` directives (aipl build -g / --debug) for source-level debugging.
pub fn emitCSourceWithOptions(hirIn: HirModule, bundledSource: str, debugLines: bool): str:
  mut hir = hirIn
  hir.emitLineDirectives = debugLines
  ret emitCSource(hir, bundledSource)

pub fn emitCSource(hirIn: HirModule, bundledSource: str): str:
  mut lines: [str] = []
  lines.push("/* Generated by AIPL Self-Hosted Compiler (Pure C99 Runtime) */")
  mut hir = hirIn
  hir.intrinsicOverrides = computeIntrinsicOverrides(hirIn, readRuntimeHeaderText())
  lines.push(emitCRuntimeHeaderForModule(hirIn))
  lines.push("")
  lines.push("/* Module: " + hir.moduleName + " */")
  lines.push("")

  // Unboxed C struct mirrors (AiplUnboxed_<S>, aipl_box_<S>, aipl_unbox_<S>) are only emitted
  // when the program opts in with `@unboxed`; otherwise they are pure bloat.
  let wantUnboxed = bundledSource.contains("@unboxed")

  // Typedef every struct in hir.structs
  mut si = 0
  while si < hir.structs.len:
    let st = hir.structs[si]
    lines.push("typedef AiplVal " + st.name + ";")
    if not wantUnboxed:
      si += 1
      continue
    lines.push("/* Unboxed C representation for struct " + st.name + " */")
    lines.push("typedef struct AiplUnboxed_" + st.name + " {")
    if st.fieldNames.len == 0:
      lines.push("  char _empty_placeholder;")
    else:
      mut fi = 0
      while fi < st.fieldNames.len:
        let fnm = st.fieldNames[fi]
        let ftp = if fi < st.fieldTypes.len: st.fieldTypes[fi] else: "str"
        mut cType = "AiplVal"
        if ftp == "int" or ftp == "i64" or ftp == "i32" or ftp == "u32" or ftp == "u64" or ftp == "usize" or ftp == "isize":
          cType = "int64_t"
        elif ftp == "float" or ftp == "f64" or ftp == "f32":
          cType = "double"
        elif ftp == "bool" or ftp == "boolean":
          cType = "bool"
        elif ftp == "str" or ftp == "string":
          cType = "const char*"
        lines.push("  " + cType + " " + fnm + ";")
        fi += 1
    lines.push("} AiplUnboxed_" + st.name + ";")
    lines.push("static inline AiplUnboxed_" + st.name + " aipl_unbox_" + st.name + "(AiplVal v) {")
    lines.push("  AiplUnboxed_" + st.name + " u;")
    lines.push("  memset(&u, 0, sizeof(u));")
    if st.fieldNames.len == 0:
      lines.push("  (void)v;")
    else:
      mut ufi = 0
      while ufi < st.fieldNames.len:
        let fnm = st.fieldNames[ufi]
        let ftp = if ufi < st.fieldTypes.len: st.fieldTypes[ufi] else: "str"
        lines.push("  AiplVal _fv_" + fnm + " = aipl_member_get(v, \"" + fnm + "\");")
        if ftp == "int" or ftp == "i64" or ftp == "i32" or ftp == "u32" or ftp == "u64" or ftp == "usize" or ftp == "isize":
          lines.push("  u." + fnm + " = (_fv_" + fnm + ".kind == AIPL_INT ? _fv_" + fnm + ".i : (_fv_" + fnm + ".kind == AIPL_FLOAT ? (int64_t)_fv_" + fnm + ".f : 0));")
        elif ftp == "float" or ftp == "f64" or ftp == "f32":
          lines.push("  u." + fnm + " = (_fv_" + fnm + ".kind == AIPL_FLOAT ? _fv_" + fnm + ".f : (double)_fv_" + fnm + ".i);")
        elif ftp == "bool" or ftp == "boolean":
          lines.push("  u." + fnm + " = _fv_" + fnm + ".b;")
        elif ftp == "str" or ftp == "string":
          lines.push("  u." + fnm + " = (_fv_" + fnm + ".kind == AIPL_STR && _fv_" + fnm + ".s) ? _fv_" + fnm + ".s : \"\";")
        else:
          lines.push("  u." + fnm + " = _fv_" + fnm + ";")
        ufi += 1
    lines.push("  return u;")
    lines.push("}")
    lines.push("")
    lines.push("static inline AiplVal aipl_box_" + st.name + "(AiplUnboxed_" + st.name + " u) {")
    if st.fieldNames.len == 0:
      lines.push("  (void)u;")
      lines.push("  return aipl_struct_new(\"" + st.name + "\", 0, NULL, NULL);")
    else:
      mut bfi = 0
      mut fNamesArr: [str] = []
      mut fValsArr: [str] = []
      while bfi < st.fieldNames.len:
        let fnm = st.fieldNames[bfi]
        let ftp = if bfi < st.fieldTypes.len: st.fieldTypes[bfi] else: "str"
        fNamesArr.push("\"" + fnm + "\"")
        if ftp == "int" or ftp == "i64" or ftp == "i32" or ftp == "u32" or ftp == "u64" or ftp == "usize" or ftp == "isize":
          fValsArr.push("aipl_int(u." + fnm + ")")
        elif ftp == "float" or ftp == "f64" or ftp == "f32":
          fValsArr.push("aipl_float(u." + fnm + ")")
        elif ftp == "bool" or ftp == "boolean":
          fValsArr.push("aipl_bool(u." + fnm + ")")
        elif ftp == "str" or ftp == "string":
          fValsArr.push("aipl_str(u." + fnm + " ? u." + fnm + " : \"\")")
        else:
          fValsArr.push("u." + fnm)
        bfi += 1
      lines.push("  const char* _fnames[] = { " + fNamesArr.join(", ") + " };")
      lines.push("  AiplVal _fvals[] = { " + fValsArr.join(", ") + " };")
      lines.push("  return aipl_struct_new(\"" + st.name + "\", " + str(fNamesArr.len) + ", _fnames, _fvals);")
    lines.push("}")
    lines.push("")
    si += 1

  // Typedef every enum in hir.enums and define variant values/constructors
  mut ei = 0
  while ei < hir.enums.len:
    let en = hir.enums[ei]
    lines.push("#ifndef _AIPL_ENUM_TD_" + en.name)
    lines.push("#define _AIPL_ENUM_TD_" + en.name)
    lines.push("typedef AiplVal " + en.name + ";")
    lines.push("#endif")
    mut vi = 0
    while vi < en.variants.len:
      let vname = en.variants[vi]
      if vname != "None" and vname != "Some" and vname != "Ok" and vname != "Err":
        lines.push("#ifndef v_" + vname)
        lines.push("#define v_" + vname + " aipl_enum_tag(\"" + vname + "\", " + str(vi) + ")")
        lines.push("#endif")
        if not hasHirFunction(hir, vname):
          lines.push("#ifndef aipl_fn_" + vname)
          lines.push("#define aipl_fn_" + vname + " aipl_fn_" + vname)
          lines.push("static inline AiplVal aipl_fn_" + vname + "() { return aipl_enum_tag(\"" + vname + "\", " + str(vi) + "); }")
          lines.push("#endif")
      vi += 1
    ei += 1

  lines.push("")

  // Forward declarations for hir.functions
  mut fni = 0
  while fni < hir.functions.len:
    let f = hir.functions[fni]
    if not isEmittedAsIntrinsic(hir, f.name):
      mut pNames: [str] = []
      mut pi = 0
      while pi < f.paramNames.len:
        let isRef = pi < f.paramTypes.len and f.paramTypes[pi].startsWith("&")
        if isRef:
          pNames.push("AiplVal* p_ref_" + f.paramNames[pi])
        else:
          pNames.push("AiplVal v_" + f.paramNames[pi])
        pi += 1
      let pSig = if pNames.len > 0: pNames.join(", ") else: "void"
      let hotAttr = if f.isHotLoop: "__attribute__((hot)) " else: ""
      lines.push(hotAttr + "AiplVal aipl_fn_" + f.name + "(" + pSig + ");")
    fni += 1

  if hasHirFunction(hir, "emitCFunctionsStride"):
    lines.push("static AiplVal aipl_rt_parallel_emit_c(AiplVal v_hir, AiplVal v_safeFile) {")
    lines.push("  AiplVal funcs = aipl_member_get(v_hir, \"functions\");")
    lines.push("  int64_t total = aipl_member_get(funcs, \"len\").i;")
    lines.push("  int ncpus = (int)aipl_rt_hardware_concurrency().i;")
    lines.push("  if (total < 16 || ncpus <= 1) {")
    lines.push("    return aipl_fn_emitCFunctionsStride(v_hir, v_safeFile, aipl_int(0), aipl_int(1));")
    lines.push("  }")
    lines.push("  int workers = (ncpus < (int)total) ? ncpus : (int)total;")
    lines.push("  if (workers > 4) workers = 4;")
    lines.push("  fflush(stdout); fflush(stderr);")
    lines.push("  static int g_emit_seq = 0;")
    lines.push("  int seq = __sync_fetch_and_add(&g_emit_seq, 1);")
    lines.push("  pid_t parent_pid = getpid();")
    lines.push("  pid_t* pids = (pid_t*)malloc(sizeof(pid_t) * (size_t)workers);")
    lines.push("  char part_files[64][256];")
    lines.push("  for (int w = 0; w < workers; w++) {")
    lines.push("    snprintf(part_files[w], sizeof(part_files[w]), \"/tmp/aipl_emit_%d_%d_%d.part\", (int)parent_pid, seq, w);")
    lines.push("    pid_t pid = fork();")
    lines.push("    if (pid == 0) {")
    lines.push("      AiplVal part = aipl_fn_emitCFunctionsStride(v_hir, v_safeFile, aipl_int(w), aipl_int(workers));")
    lines.push("      FILE* fp = fopen(part_files[w], \"wb\");")
    lines.push("      if (fp) {")
    lines.push("        if (part.kind == AIPL_STR && part.s) {")
    lines.push("          fwrite(part.s, 1, strlen(part.s), fp);")
    lines.push("        }")
    lines.push("        fclose(fp);")
    lines.push("      }")
    lines.push("      _exit(0);")
    lines.push("    }")
    lines.push("    pids[w] = pid;")
    lines.push("  }")
    lines.push("  int any_failed = 0;")
    lines.push("  for (int w = 0; w < workers; w++) {")
    lines.push("    int status = 0;")
    lines.push("    if (pids[w] > 0) {")
    lines.push("      waitpid(pids[w], &status, 0);")
    lines.push("      if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) {")
    lines.push("        any_failed = 1;")
    lines.push("      }")
    lines.push("    }")
    lines.push("  }")
    lines.push("  if (any_failed) {")
    lines.push("    free(pids);")
    lines.push("    for (int w = 0; w < workers; w++) {")
    lines.push("      unlink(part_files[w]);")
    lines.push("    }")
    lines.push("    return aipl_fn_emitCFunctionsStride(v_hir, v_safeFile, aipl_int(0), aipl_int(1));")
    lines.push("  }")
    lines.push("  free(pids);")
    lines.push("  size_t total_bytes = 0;")
    lines.push("  size_t part_sizes[64];")
    lines.push("  for (int w = 0; w < workers; w++) {")
    lines.push("    struct stat st;")
    lines.push("    if (stat(part_files[w], &st) == 0) {")
    lines.push("      part_sizes[w] = (size_t)st.st_size;")
    lines.push("      total_bytes += (size_t)st.st_size + 1;")
    lines.push("    } else {")
    lines.push("      part_sizes[w] = 0;")
    lines.push("    }")
    lines.push("  }")
    lines.push("  char* out_buf = (char*)malloc(total_bytes + 1);")
    lines.push("  size_t offset = 0;")
    lines.push("  for (int w = 0; w < workers; w++) {")
    lines.push("    if (part_sizes[w] > 0) {")
    lines.push("      FILE* fp = fopen(part_files[w], \"rb\");")
    lines.push("      if (fp) {")
    lines.push("        size_t nread = fread(out_buf + offset, 1, part_sizes[w], fp);")
    lines.push("        offset += nread;")
    lines.push("        fclose(fp);")
    lines.push("      }")
    lines.push("    }")
    lines.push("    unlink(part_files[w]);")
    lines.push("    if (offset < total_bytes && (offset == 0 || out_buf[offset - 1] != '\\n')) {")
    lines.push("      out_buf[offset++] = '\\n';")
    lines.push("    }")
    lines.push("  }")
    lines.push("  out_buf[offset] = 0;")
    lines.push("  AiplVal res = aipl_str_n(out_buf, (int64_t)offset);")
    lines.push("  free(out_buf);")
    lines.push("  return res;")
    lines.push("}")
  else:
    lines.push("static inline AiplVal aipl_rt_parallel_emit_c(AiplVal v_hir, AiplVal v_safeFile) {")
    lines.push("  (void)v_hir; (void)v_safeFile;")
    lines.push("  return aipl_str(\"\");")
    lines.push("}")

  // Forward declare top-level consts and imported symbols
  mut di = 0
  while di < hir.arena.decls.len:
    let d = hir.arena.decls[di]
    if d.kind == "Const":
      lines.push("AIPL_GLOBAL AiplVal v_" + d.name + ";")
    elif d.kind == "Import":
      mut si = 0
      while si < d.importSpecs.len:
        let spec = d.importSpecs[si]
        if not hasHirFunction(hir, spec) and not isEnumName(hir.arena, spec) and not isStructName(hir.arena, spec):
          lines.push("AIPL_GLOBAL AiplVal v_" + spec + ";")
          lines.push("AiplVal aipl_fn_" + spec + "();")
        elif (spec == "pi" or spec == "tau") and not hasConstDecl(hir.arena, spec):
          lines.push("AIPL_GLOBAL AiplVal v_" + spec + ";")
        si += 1
    di += 1

  lines.push("")

  // Deferred blocks (typed JSON decoders + intrinsic alias macros) are filtered against the final
  // program text so the shared shard prefix only carries what the program really references.
  mut deferredKeys: [str] = []
  mut deferredBlocks: [str] = []
  mut deferredIsMacro: [bool] = []

  // Emit JSON Schema and fromJson for each struct
  si = 0
  while si < hir.structs.len:
    let st = hir.structs[si]
    let schemaStr = generateStructJsonSchema(st)
    let escapedSchema = schemaStr.replace("\\", "\\\\").replace("\"", "\\\"")
    lines.push("static inline AiplVal aipl_schema_" + st.name + "(void) {")
    lines.push("  return aipl_str_lit(\"" + escapedSchema + "\");")
    lines.push("}")
    lines.push("")
    // Step 18.3: typed JSON decoders are collected aside and only kept (see assembleDeferredC)
    // when the emitted program text actually calls aipl_from_json_<Struct>.
    mut fjLines: [str] = []
    fjLines.push("static inline AiplVal aipl_from_json_" + st.name + "(AiplVal jsonStr) {")
    fjLines.push("  if (jsonStr.kind != AIPL_STR || !jsonStr.s) {")
    fjLines.push("    return aipl_err(aipl_str_lit(\"Invalid JSON object for " + st.name + "\"));")
    fjLines.push("  }")
    fjLines.push("  const char* p = jsonStr.s;")
    fjLines.push("  while (*p && (*p == ' ' || *p == '\\t' || *p == '\\r' || *p == '\\n')) p++;")
    fjLines.push("  if (*p != '{') {")
    fjLines.push("    return aipl_err(aipl_str_lit(\"Invalid JSON object for " + st.name + "\"));")
    fjLines.push("  }")
    mut fi = 0
    mut fNamesArr: [str] = []
    mut fValsArr: [str] = []
    while fi < st.fieldNames.len:
      let fName = st.fieldNames[fi]
      let fType = if fi < st.fieldTypes.len: st.fieldTypes[fi] else: "str"
      let defId = lookupStructFieldDefaultExpr(hir.arena, st.name, fi)
      fjLines.push("  AiplVal _val_" + fName + ";")
      fjLines.push("  if (strstr(jsonStr.s, \"\\\"" + fName + "\\\"\") == NULL) {")
      if defId >= 0:
        fjLines.push("    _val_" + fName + " = " + emitCExpr(hir.arena, defId) + ";")
      else:
        fjLines.push("    return aipl_err(aipl_str_lit(\"Missing required field: " + fName + "\"));")
      fjLines.push("  } else {")
      fjLines.push("    AiplVal _raw_" + fName + " = aipl_rt_jsonGet(jsonStr, aipl_str_lit(\"" + fName + "\"));")
      fjLines.push("    const char* _s_" + fName + " = (_raw_" + fName + ".kind == AIPL_STR && _raw_" + fName + ".s) ? _raw_" + fName + ".s : \"\";")
      if fType == "int" or fType == "i64" or fType == "i32" or fType == "u32" or fType == "u64" or fType == "usize" or fType == "isize":
        fjLines.push("    _val_" + fName + " = aipl_int((int64_t)atoll(_s_" + fName + "));")
      elif fType == "float" or fType == "f64" or fType == "f32":
        fjLines.push("    _val_" + fName + " = aipl_float(atof(_s_" + fName + "));")
      elif fType == "bool" or fType == "boolean":
        fjLines.push("    _val_" + fName + " = aipl_bool(strcmp(_s_" + fName + ", \"true\") == 0);")
      elif fType == "str" or fType == "string":
        fjLines.push("    _val_" + fName + " = aipl_str(_s_" + fName + ");")
      else:
        fjLines.push("    _val_" + fName + " = aipl_rt_jsonParse(_raw_" + fName + ");")
      fjLines.push("  }")
      fNamesArr.push("\"" + fName + "\"")
      fValsArr.push("_val_" + fName)
      fi += 1
    if fNamesArr.len > 0:
      fjLines.push("  const char* _fnames[] = { " + fNamesArr.join(", ") + " };")
      fjLines.push("  AiplVal _fvals[] = { " + fValsArr.join(", ") + " };")
      fjLines.push("  AiplVal st = aipl_struct_new(\"" + st.name + "\", " + str(fNamesArr.len) + ", _fnames, _fvals);")
    else:
      fjLines.push("  AiplVal st = aipl_struct_new(\"" + st.name + "\", 0, NULL, NULL);")
    fjLines.push("  return aipl_ok(st);")
    fjLines.push("}")
    fjLines.push("")
    deferredKeys.push(st.name)
    deferredBlocks.push(fjLines.join("\n"))
    deferredIsMacro.push(false)
    si += 1
  lines.push(AIPL_DEFERRED_FROMJSON_SLOT)

  // Emit JSON Schema for each enum
  ei = 0
  while ei < hir.enums.len:
    let en = hir.enums[ei]
    let schemaStr = generateEnumJsonSchema(en)
    let escapedSchema = schemaStr.replace("\\", "\\\\").replace("\"", "\\\"")
    lines.push("static inline AiplVal aipl_schema_" + en.name + "(void) {")
    lines.push("  return aipl_str_lit(\"" + escapedSchema + "\");")
    lines.push("}")
    lines.push("")
    ei += 1

  // Intrinsic macros
  let intrinsics: [str] = [
    "fileExists", "readFile", "writeFile", "readBytes", "writeBytes", "realpath",
    "listDir", "readDir", "walkDir", "stat", "isDir", "mkdir", "mkdirAll", "removeFile", "deleteFile", "removeDirAll",
    "fileSize", "isFile", "copyFile", "renameFile", "setFileTimes", "appendFile",
    "pathJoin", "pathNormalize", "pathDirname", "pathBasename", "pathExtname",
    "pathExtension", "pathExt", "pathStem", "pathIsAbsolute",
    "userArgs", "args", "getEnv", "setEnv", "env", "cwd", "homeDir", "tempDir",
    "execCommand", "exit", "panic",
    "hardwareConcurrency", "execParallel", "aipl_rt_hardware_concurrency", "aipl_rt_exec_parallel",
    "nowMs", "nowUnixMs", "nowMonoNs", "sleepMs",
    "sha256", "sha256Bytes", "crc32", "md5", "sha1",
    "hmacSha256", "hmacSha256Hex", "constantTimeEq", "pbkdf2HmacSha256",
    "deflateRaw", "inflateRaw", "zlibCompress", "zlibDecompress",
    "bytesNew", "bytesFromArray",
    "tcpListen", "tcpLocalPort", "tcpConnect", "tcpAccept", "tcpRead", "tcpWrite", "tcpClose",
    "udpBind", "udpSendTo", "udpRecvFrom", "udpClose",
    "Ok", "Err", "Some", "None",
    "assert", "eprint", "eprintln", "printInline", "flushStdout", "readStdin", "readLine",
    "chr", "fromCharCode", "ord", "charCode", "parseInt", "parseFloat", "toString", "formatFloat", "toHex",
    "pi", "sin", "cos", "tan", "asin", "acos", "atan", "atan2", "sqrt", "pow",
    "floor", "ceil", "round", "abs", "absInt", "absFloat",
    "min", "max", "minInt", "maxInt", "minFloat", "maxFloat",
    "clamp", "clampInt", "clampFloat", "lerp", "limitVal", "mixVal",
    "log", "log2", "log10", "exp", "randomFloat", "randFloat", "randomIntRange", "randomInt", "randInt",
    "jsonStringify", "jsonParse",
    "initWindow", "initCanvas", "closeWindow", "setTargetFps", "setMaxFps", "getMaxFps", "getCurrentFps", "getFrameTimeMs", "setWindowTitle", "setWindowSize", "windowShouldClose",
    "isWindowResized", "setWindowMinSize", "getContentScale", "saveScreenshot", "startVideoRecording", "recordVideoFrame", "stopVideoRecording", "isRecordingVideo",
    "setSingleInstance", "isSingleInstance", "targetWindowScreenshot", "targetWindowRecord", "targetWindowAction", "targetWindowSeatAction", "publishBotState", "publishTurnState", "listRunningWindows", "setWindowPosition",
    "getScreenWidth", "getScreenHeight", "getFrameTime", "getScaleFactor",
    "beginDrawing", "endDrawing", "clearScreen", "clearBackground",
    "rgb", "rgba", "drawRect", "drawRectOutline", "drawRectLines",
    "drawRoundedRect", "drawRoundedRectOutline", "drawCircle", "drawCircleOutline", "drawCircleLines",
    "drawLine", "drawTriangle", "drawTriangleOutline", "drawTriangleLines", "drawText", "drawTextCentered", "drawTextFont",
    "drawLabel", "measureLabel", "measureText", "measureTextFont",
    "drawArc", "drawEllipse", "drawPolygon", "drawRegularPolygon", "drawPixel",
    "readCanvasPixel", "createImageFromPixels", "createTextureFromRgba", "createProceduralTexture", "saveTextureToPpm", "createIsometricSpriteSheet", "setBlendMode", "getBlendMode", "blendModeAlpha", "blendModeAdditive", "blendModeMultiplied", "blendModeScreen",
    "pushMatrix", "popMatrix", "pushScissor", "popScissor",
    "translate2D", "rotate2D", "scale2D", "shear2D",
    "begin3D", "end3D", "drawTriangleDepth", "setDepthTest", "clearDepth", "beginWorldPass", "endWorldPass", "setUiTracking", "drawTriangleGouraud", "drawTriangle3DGouraud", "drawQuad3DGouraud", "drawTriangle3DTextured", "drawQuad3DTextured", "cloneStruct", "drawCubeMesh", "renderCube",
    "isKeyPressed", "isKeyDown", "isKeyReleased", "isKeyHeld", "getKeyPressed",
    "isMouseButtonPressed", "isMouseButtonDown", "isMouseButtonReleased", "isMouseRightClicked", "isMouseDoubleClicked",
    "getMouseX", "getMouseY", "getMouseWheelMove", "mouseWheelX", "isMouseInRect",
    "loadImage", "decodeImage", "imageWidth", "imageHeight", "drawSubImage", "drawImage", "drawImageEx",
    "drawImageScaled", "drawImageSub", "saveImage", "getImageWidth", "getImageHeight",
    "loadSound", "decodeSound", "getSoundDuration", "loadFont", "decodeFont",
    "decodePngHeader", "decodeWavHeader", "decodeFontMetrics",
    "decodeImageHandle", "decodeSoundHandle", "decodeFontHandle",
    "cacheFont", "cacheImage", "cacheSound", "getCachedFont", "getCachedImage", "getCachedSound",
    "createAssetManager", "createSpriteSheet", "createAnimationClip",
    "sampleAnimationFrame", "drawSpriteFrame", "drawAnimatedSprite",
    "audioTime", "playPcmBuffer", "playSound", "playSoundEx", "playTone", "playToneSweep", "getAudioEnergy", "getAudioBand", "stopAllSounds", "setMasterVolume", "getVoicePosition",
    "FontHandle", "ImageHandle", "SoundHandle",
    "Vec2", "colorHex", "hypot", "dist", "modFloat", "randomRange", "randomBytes",
    "dayOfWeek", "unixToCivil", "padLeft", "padRight",
    "drawTextBox", "drawTextRight", "getTextInput", "getCompositionText", "getCompositionCursor", "getClipboardText", "setClipboardText", "isGpuAccelerated", "getGraphicsBackendName", "setSoftwareRasterizer", "isRectClicked",
    "measureTextHeight", "measureTextWidth", "truncateText", "mouseWheelY",
    "gridInBounds", "gridGet", "gridNeighbors4", "gridNeighbors8", "gridFloodFill",
    "byteBufferAlloc", "bytesZeroed", "bytesConcat", "bytesFromHex", "hexEncode", "hexDecode",
    "loadAsset", "assetExists", "listAssets",
    "Vec3", "Color", "Rect",
    "drawPolyline", "drawLineLoop", "drawLineStrip",
    "drawRectGradientH", "drawRectGradientV", "drawLinearGradient",
    "drawGridTiles", "drawCellGrid", "drawRectBatch", "drawCharGrid",
    "drawPixelBuffer", "drawCirclesSoA", "drawRectsSoA",
    "withViewport",
    "drawTextMiddle", "drawTextAligned", "measureTextSubstr",
    "readPixels", "saveCanvasSnapshot",
    "pollKeyEvents", "isKeyJustPressed", "getPressedKey", "isAnyKeyPressed", "pollFileDropEvents", "playToneEx",
    "intBufferNew", "intBufferGet", "intBufferSet", "intBufferLen",
    "floatBufferNew", "floatBufferGet", "floatBufferSet", "floatBufferLen",
    "sumIntsFast", "sumFloatsFast", "dotProductFloats", "axpyFloats",
    "tensorDot", "tensorMatmul", "parallelMatmulInt",
    "arenaMark", "arenaReset", "arenaAllocatedBytes", "arenaAlloc", "arenaActiveDepth", "arenaPopEvacuate", "arenaStats", "withScratchArena", "gameLoop",
    "ffiOpen", "ffiHasSymbol", "ffiCallInt", "ffiCallFloat", "ffiCallStr", "ffiClose",
    "canvasBackendName", "isHeadlessMode", "endFrame", "beginFrame", "clearCanvas", "getPixel", "setWindowMode", "getWindowMode",
    "regVmExec", "executeRegBytecode", "runRegVmComputedGoto", "reg_vm_exec", "reg_vm_fib",
    "ptrAlloc", "ptrFree", "ptrReadU8", "ptrWriteU8", "ptrReadI64", "ptrWriteI64", "sizeofType", "bitcastF64ToI64", "bitcastI64ToF64",
    "rawSyscall", "rawSyscall0", "rawSyscall1", "rawSyscall2", "rawSyscall3", "rawSyscall4", "rawSyscall5", "rawSyscall6"
  ]
  let usesGui = moduleUsesGuiOrAudio(hir)
  mut ini = 0
  while ini < intrinsics.len:
    let iname = intrinsics[ini]
    if not usesGui and isGuiOrAudioName(iname):
      ini += 1
      continue
    // Step 18.2: alias macros are deferred and kept only if the emitted C references aipl_fn_<name>
    // (including names synthesized by codegen itself, e.g. json.parse -> aipl_fn_jsonParse).
    mut mLines: [str] = []
    if iname == "drawRectOutline" or iname == "drawRectLines":
      mLines.push("#ifndef aipl_fn_" + iname)
      mLines.push("#define aipl_fn_" + iname + "(...) _aipl_draw_rect_outline_var(__VA_ARGS__)")
      mLines.push("#endif")
    elif iname == "hardwareConcurrency" or iname == "aipl_rt_hardware_concurrency":
      mLines.push("#ifndef aipl_fn_hardwareConcurrency")
      mLines.push("#define aipl_fn_hardwareConcurrency aipl_rt_hardware_concurrency")
      mLines.push("#endif")
      mLines.push("#ifndef aipl_fn_thread_hardwareConcurrency")
      mLines.push("#define aipl_fn_thread_hardwareConcurrency aipl_rt_hardware_concurrency")
      mLines.push("#endif")
      mLines.push("#ifndef aipl_fn_aipl_rt_hardware_concurrency")
      mLines.push("#define aipl_fn_aipl_rt_hardware_concurrency aipl_rt_hardware_concurrency")
      mLines.push("#endif")
    elif iname == "execParallel" or iname == "aipl_rt_exec_parallel":
      mLines.push("#ifndef aipl_fn_execParallel")
      mLines.push("#define aipl_fn_execParallel aipl_rt_exec_parallel")
      mLines.push("#endif")
      mLines.push("#ifndef aipl_fn_thread_execParallel")
      mLines.push("#define aipl_fn_thread_execParallel aipl_rt_exec_parallel")
      mLines.push("#endif")
      mLines.push("#ifndef aipl_fn_aipl_rt_exec_parallel")
      mLines.push("#define aipl_fn_aipl_rt_exec_parallel aipl_rt_exec_parallel")
      mLines.push("#endif")
    elif not hasHirFunction(hir, iname) or isEmittedAsIntrinsic(hir, iname):
      mLines.push("#ifndef aipl_fn_" + iname)
      mLines.push("#define aipl_fn_" + iname + " aipl_rt_" + iname)
      mLines.push("#endif")
    if mLines.len > 0:
      let mKey = if iname == "hardwareConcurrency" or iname == "aipl_rt_hardware_concurrency": "hardware_concurrency" else: (if iname == "execParallel" or iname == "aipl_rt_exec_parallel": "exec_parallel" else: iname)
      deferredKeys.push(mKey)
      deferredBlocks.push(mLines.join("\n"))
      deferredIsMacro.push(true)
    ini += 1
  lines.push(AIPL_DEFERRED_MACRO_SLOT)

  lines.push("")

  // Static helper functions for Lambdas
  mut lbi = 0
  while lbi < hir.arena.exprs.len:
    let lx = hir.arena.exprs[lbi]
    if lx.kind == "Lambda":
      lines.push("static AiplVal __aipl_lambda_" + str(lx.id) + "(int argc, AiplVal* args) {")
      mut pIdx = 0
      while pIdx < lx.names.len:
        let pName = lx.names[pIdx]
        lines.push("  AiplVal v_" + pName + " = (argc > " + str(pIdx) + ") ? args[" + str(pIdx) + "] : aipl_nil();")
        pIdx += 1
      let lFreeVars = collectLambdaExprVars(hir.arena, lx.left, [])
      mut fvi = 0
      while fvi < lFreeVars.len:
        let fvName = lFreeVars[fvi]
        if not arrayContainsStr(lx.names, fvName) and not hasConstDecl(hir.arena, fvName):
          lines.push("  AiplVal v_" + fvName + " = aipl_nil(); (void)v_" + fvName + ";")
        fvi += 1
      lines.push("  return " + emitCExpr(hir.arena, lx.left) + ";")
      lines.push("}")
      lines.push("")
    lbi += 1

  // Full C99 function body emission
  let safeFile = (if hir.moduleName.endsWith(".aipl"): hir.moduleName else: hir.moduleName + ".aipl").replace("\\", "/").replace("\"", "")
  mut hasMainFn = false
  mut fni = 0
  while fni < hir.functions.len:
    if hir.functions[fni].name == "main":
      hasMainFn = true
    fni += 1

  let funcsCode = emitCFunctionsParallel(hir, safeFile)
  lines.push(funcsCode)

  // Global initializer
  lines.push("static void aipl_rt_init_globals(void) {")
  lines.push("  static bool inited = false;")
  lines.push("  if (inited) { return; }")
  lines.push("  inited = true;")
  mut initLocalVars: [str] = []
  di = 0
  while di < hir.arena.decls.len:
    let d = hir.arena.decls[di]
    if d.kind == "Const" and d.bodyStmts.len > 0 and d.bodyStmts[0] >= 0:
      initLocalVars = collectExprVarNames(hir.arena, d.bodyStmts[0], initLocalVars)
    di += 1
  if not hasMainFn and hir.arena.topStmts.len > 0:
    initLocalVars = collectStmtListVarNames(hir.arena, hir.arena.topStmts, initLocalVars)
  mut tvi = 0
  while tvi < initLocalVars.len:
    let lvName = initLocalVars[tvi]
    if not hasConstDecl(hir.arena, lvName):
      lines.push("  AiplVal v_" + lvName + " = aipl_nil(); (void)v_" + lvName + ";")
    tvi += 1
  di = 0
  while di < hir.arena.decls.len:
    let d = hir.arena.decls[di]
    if d.kind == "Const" and d.bodyStmts.len > 0 and d.bodyStmts[0] >= 0:
      lines.push("  v_" + d.name + " = " + emitCExpr(hir.arena, d.bodyStmts[0]) + ";")
    elif d.kind == "Import":
      mut si = 0
      while si < d.importSpecs.len:
        let spec = d.importSpecs[si]
        if spec == "pi":
          lines.push("  v_pi = aipl_float(3.14159265358979323846);")
        elif spec == "tau":
          lines.push("  v_tau = aipl_float(6.28318530717958647692);")
        si += 1
    di += 1
  if not hasMainFn and hir.arena.topStmts.len > 0:
    mut topVars: [str] = []
    mut ti = 0
    while ti < hir.arena.topStmts.len:
      let topStmtId = hir.arena.topStmts[ti]
      if hir.emitLineDirectives and topStmtId >= 0 and topStmtId < hir.arena.stmts.len:
        let topSt = hir.arena.stmts[topStmtId]
        if topSt.span.line > 0:
          lines.push("#line " + str(topSt.span.line) + " \"" + safeFile + "\"")
      let topLines = emitCStmtWithScope(hir.arena, topStmtId, "  ", topVars)
      mut tli = 0
      while tli < topLines.len:
        lines.push(topLines[tli])
        tli += 1
      ti += 1
  lines.push("}")
  lines.push("")

  lines.push("static const size_t AIPL_EMBEDDED_SOURCE_LEN = " + str(bundledSource.len) + ";")
  lines.push("")
  lines.push("int main(int argc, char** argv) {")
  lines.push("  (void)AIPL_EMBEDDED_SOURCE_LEN;")
  lines.push("  struct rlimit rl;")
  lines.push("  if (getrlimit(RLIMIT_STACK, &rl) == 0 && rl.rlim_cur < 67108864ULL) {")
  lines.push("    rl.rlim_cur = 67108864ULL;")
  lines.push("    setrlimit(RLIMIT_STACK, &rl);")
  lines.push("  }")
  lines.push("  g_aipl_argc = argc;")
  lines.push("  g_aipl_argv = argv;")
  lines.push("  aipl_rt_init_globals();")
  if hasMainFn:
    lines.push("  AiplVal mainRes = aipl_fn_main();")
    lines.push("  if (mainRes.kind == AIPL_INT) {")
    lines.push("    return (int)mainRes.i;")
    lines.push("  }")
    lines.push("  if (mainRes.kind == AIPL_RES_ERR) {")
    lines.push("    AiplVal errVal = aipl_unwrap_err(mainRes);")
    lines.push("    fprintf(stderr, \"%s\\n\", aipl_to_str(errVal).s ? aipl_to_str(errVal).s : \"\");")
    lines.push("    return 1;")
    lines.push("  }")
    lines.push("  if (mainRes.kind == AIPL_OPT_NONE) {")
    lines.push("    return 1;")
    lines.push("  }")
    lines.push("  if (mainRes.kind == AIPL_RES_OK || mainRes.kind == AIPL_OPT_SOME) {")
    lines.push("    AiplVal inner = aipl_unwrap(mainRes);")
    lines.push("    if (inner.kind == AIPL_INT) {")
    lines.push("      return (int)inner.i;")
    lines.push("    }")
    lines.push("  }")
    lines.push("  return 0;")
  else:
    lines.push("  return 0;")
  lines.push("}")
  ret assembleDeferredC(lines.join("\n"), deferredKeys, deferredBlocks, deferredIsMacro)

// Portable single-`cc` fallback. The C backend replaces this body with the multi-core sharded
// driver `aipl_rt_compile_c_parallel` (runtime/rt_sys.c), which splits the generated C at
// function markers into per-core shards that only include the small common prefix.
pub fn compileCSourceSharded(cSource: str, outputPath: str, optFlag: str, debugInfo: bool, includeDir: str, archivePath: str): Result[int, str]:
  let tmpCPath = outputPath + ".tmp.c"
  writeFile(tmpCPath, cSource)
  let opt = if optFlag.len > 0: optFlag else: "-O2"
  mut args: [str] = ["-std=c99", opt]
  if debugInfo:
    args.push("-g")
  args.push("-pthread")
  args.push("-Wall")
  args.push("-Wextra")
  args.push("-Wno-unused-parameter")
  args.push("-Wno-unused-function")
  args.push("-Wno-unused-variable")
  args.push("-Wno-unused-but-set-variable")
  args.push("-Wno-misleading-indentation")
  if includeDir.len > 0:
    args.push("-I")
    args.push(includeDir)
  args.push(tmpCPath)
  args.push("-o")
  args.push(outputPath)
  if archivePath.len > 0:
    args.push(archivePath)
  args.push("-lm")
  args.push("-ldl")
  args.push("-lpthread")
  let ccRes = execCommand("cc", args)
  let _ = removeFile(tmpCPath)
  if ccRes.isErr():
    ret Err(ccRes.unwrapErr())
  let out = ccRes.unwrap()
  if out.status != 0:
    ret Err("Host C compiler failed: " + out.stderr)
  let binBytes = readBytes(outputPath)
  if binBytes.isErr():
    ret Err(binBytes.unwrapErr())
  ret Ok(binBytes.unwrap().len)

// Legacy entry point kept for API compatibility; new code calls compileCWithRuntime directly.
pub fn compileCSourceParallel(cSource: str, outputPath: str, optFlag: str, debugInfo: bool): Result[int, str]:
  ret compileCWithRuntime(cSource, outputPath, optFlag, debugInfo)

pub fn compileCSourceWithHostCc(cSource: str, outputPath: str): Result[int, str]:
  ret compileCWithRuntime(cSource, outputPath, "-O2", false)

pub fn locateRunnerStub(): Result[bytes, str]:
  let envStub = getEnv("AIPL_RUNNER_STUB")
  if envStub.isSome():
    let stubPath = envStub.unwrap()
    if fileExists(stubPath):
      let r = readBytes(stubPath)
      if r.isOk():
        ret Ok(stripExistingAiplStndOverlay(r.unwrap()))

  let selfRes = readBytes("@self_exe")
  if selfRes.isOk():
    let selfBytes = selfRes.unwrap()
    let meta = inspectAiplStndBinary(selfBytes)
    if meta.hasTrailer:
      ret Ok(stripExistingAiplStndOverlay(selfBytes))

  if fileExists("target/debug/aipl"):
    let dbgRes = readBytes("target/debug/aipl")
    if dbgRes.isOk():
      ret Ok(stripExistingAiplStndOverlay(dbgRes.unwrap()))

  if selfRes.isOk():
    ret Ok(stripExistingAiplStndOverlay(selfRes.unwrap()))

  ret Err("Unable to locate AIPL native runner stub executable")

pub fn buildNativeExecutableWithStub(bundledSource: str, stubBytes: bytes, outputPath: str): Result[int, str]:
  let payloadBytes = bundledSource.toBytes()
  let emptyAssets = bytesNew(0)
  // Format version 3 = PayloadFormat::AiplSource
  let finalBin = packageStandaloneBinaryBytes(stubBytes, payloadBytes, emptyAssets, 3)
  let wRes = writeBytes(outputPath, finalBin)
  if wRes.isErr():
    ret Err(wRes.unwrapErr())
  ret Ok(finalBin.len)

pub fn buildNativeExecutable(bundledSource: str, outputPath: str): Result[int, str]:
  let tokens = tokenizeAipl(bundledSource, 0)
  let arena = parseModule(tokens, bundledSource)
  let hir = lowerToHir(arena, arena.moduleName)
  let cSource = emitCSource(hir, bundledSource)
  ret compileCSourceWithHostCc(cSource, outputPath)

// ============================================================================
// Step 21.5: --target android-arm64 NDK Cross-Compile Driver & Fallback
// ============================================================================

pub struct AndroidNdkBuildResult(exitCode: int, mode: str, emittedCBytes: int, commandLine: str, artifactPath: str)

pub fn buildAndroidNdkClangCommand(cSourcePath: str, outputSoPath: str, apiLevel: int): str requires apiLevel >= 0 ensures result.contains("-shared -fPIC") and result.contains("-landroid -llog -laaudio -lm"):
  let safeApi = if apiLevel >= 29: apiLevel else: 29
  let safeSrc = if cSourcePath.len() > 0: cSourcePath else: "build/app_android.c"
  let safeOut = if outputSoPath.len() > 0: outputSoPath else: "libaipl_app.so"
  ret "aarch64-linux-android" + str(safeApi) + "-clang " + safeSrc + " -shared -fPIC -landroid -llog -laaudio -lm -o " + safeOut

pub fn emitAndroidNativeActivityGlueC(entryFnName: str): str requires entryFnName.len() >= 0 ensures result.contains("ANativeActivity_onCreate") and result.contains("#ifdef __ANDROID__"):
  let fnSym = if entryFnName.len() > 0: entryFnName else: "aipl_main"
  ret "#ifdef __ANDROID__\n#include <android/native_activity.h>\nvoid ANativeActivity_onCreate(ANativeActivity* activity, void* savedState, size_t savedStateSize) { " + fnSym + "(); }\n#endif"

pub fn compileTargetAndroidArm64WithFallback(cCodeLen: int, ndkToolchainPresent: bool, outputSoPath: str): AndroidNdkBuildResult requires cCodeLen >= 0 ensures result.exitCode == 0 or result.exitCode == 1:
  let outSo = if outputSoPath.len() > 0: outputSoPath else: "libaipl_app.so"
  let cmd = "aarch64-linux-android29-clang -shared -fPIC -landroid -llog -laaudio -lm -o " + outSo
  if cCodeLen <= 0:
    ret AndroidNdkBuildResult(exitCode = 1, mode = "ERR_EMPTY_C_SOURCE", emittedCBytes = 0, commandLine = cmd, artifactPath = "")
  if ndkToolchainPresent:
    ret AndroidNdkBuildResult(exitCode = 0, mode = "NDK_ARM64_SHARED_SO", emittedCBytes = cCodeLen, commandLine = cmd, artifactPath = outSo)
  ret AndroidNdkBuildResult(exitCode = 0, mode = "FALLBACK_C99_VERIFIED", emittedCBytes = cCodeLen, commandLine = cmd, artifactPath = outSo + ".c")
