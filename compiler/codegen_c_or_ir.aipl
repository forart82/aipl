        let declCall = if paramCount > 0: "aipl_fn_" + lamNode.strVal + "(_m_" + str(e.id) + ")" else: "aipl_fn_" + lamNode.strVal + "()"
        let body = if lamNode.kind == "Lambda": emitCExpr(arena, lamNode.left) else: (if isDeclFn: declCall else: "aipl_call_val(" + emitCExpr(arena, lamArg) + ", 1, (AiplVal[]){ _m_" + str(e.id) + " })")
