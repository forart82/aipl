module CompilerResolve

import { AstArena } from "./ast.aipl"
import { tokenizeAipl } from "./lexer.aipl"
import { parseModule } from "./parser.aipl"

// ============================================================================
// Step 15.2: Self-Hosted Multi-File Module Graph Resolver & Bundler
// ============================================================================

pub struct ModuleNode:
  path: str
  moduleName: str
  imports: [str]
  aliases: [str]
  exportedDecls: [str]
  source: str

pub struct ModuleGraph:
  rootPath: str
  modules: [ModuleNode]
  topoOrder: [str]
  bundledSource: str
  errors: [str]
  moduleChunks: [str] = []
  chunkLineOffsets: [int] = []

pub fn joinPath(a: str, b: str): str:
  ret pathJoin(a, b)

pub fn env(key: str): str:
  let v = getEnv(key)
  if v.isSome():
    ret v.unwrap()
  ret ""

pub fn resolveStdlibRoot(): str:
  // 1. $AIPL_STD_DIR if explicitly set
  let envStd = env("AIPL_STD_DIR")
  if envStd.len > 0:
    let norm = pathNormalize(envStd)
    if fileExists(norm):
      ret norm

  // 2. $AIPL_HOME
  let aiplHome = env("AIPL_HOME")
  if aiplHome.len > 0:
    let homeStd = pathJoin(aiplHome, "std")
    if fileExists(homeStd) or fileExists(pathJoin(homeStd, "io/fs.aipl")) or fileExists(pathJoin(homeStd, "fs.aipl")) or isDir(pathJoin(homeStd, "core")):
      ret pathNormalize(aiplHome)
    if fileExists(pathJoin(aiplHome, "io/fs.aipl")) or fileExists(pathJoin(aiplHome, "fs.aipl")):
      ret pathNormalize(pathDirname(aiplHome))
    if fileExists(aiplHome):
      ret pathNormalize(aiplHome)

  // 3. Workspace-relative candidates
  if fileExists("std/io/fs.aipl") or fileExists("std/fs.aipl") or isDir("std/core") or fileExists("std"):
    ret pathNormalize(".")
  if fileExists("./std/io/fs.aipl") or fileExists("./std/fs.aipl") or isDir("./std/core") or fileExists("./std"):
    ret pathNormalize(".")
  if fileExists("../std/io/fs.aipl") or fileExists("../std/fs.aipl") or isDir("../std/core") or fileExists("../std"):
    ret pathNormalize("..")
  if fileExists("../../std/io/fs.aipl") or fileExists("../../std/fs.aipl") or isDir("../../std/core") or fileExists("../../std"):
    ret pathNormalize("../..")

  // 4. User local installation candidate (~/.local/share/aipl or ~/dev/aipl)
  let userHome = env("HOME")
  if userHome.len > 0:
    let userAipl = pathJoin(userHome, ".local/share/aipl")
    if fileExists(pathJoin(userAipl, "std/io/fs.aipl")) or fileExists(pathJoin(userAipl, "std/fs.aipl")) or isDir(pathJoin(userAipl, "std/core")) or fileExists(pathJoin(userAipl, "std")):
      ret pathNormalize(userAipl)
    let devAipl = pathJoin(userHome, "dev/aipl")
    if fileExists(pathJoin(devAipl, "std/fs/fs_mod.aipl")) or fileExists(pathJoin(devAipl, "std")):
      ret pathNormalize(devAipl)

  // 5. Executable-relative discovery via realpath("/proc/self/exe")
  let exePath = realpath("/proc/self/exe")
  if exePath.len > 0:
    let exeDir = pathDirname(exePath)
    let exeParent = pathDirname(exeDir)
    if fileExists(pathJoin(exeParent, "std/io/fs.aipl")) or fileExists(pathJoin(exeParent, "std/fs.aipl")) or isDir(pathJoin(exeParent, "std/core")) or fileExists(pathJoin(exeParent, "std")):
      ret pathNormalize(exeParent)
    if fileExists(pathJoin(exeDir, "std/io/fs.aipl")) or fileExists(pathJoin(exeDir, "std/fs.aipl")) or isDir(pathJoin(exeDir, "std/core")) or fileExists(pathJoin(exeDir, "std")):
      ret pathNormalize(exeDir)

  ret "."

pub fn stripQuotes(s: str): str:
  mut t = s.trim()
  while (t.startsWith("\"") and t.endsWith("\"") and t.len >= 2) or (t.startsWith("'") and t.endsWith("'") and t.len >= 2):
    t = t.slice(1, t.len - 1).trim()
  ret t

pub fn isStdImportPath(rawPath: str): bool:
  let clean = stripQuotes(rawPath)
  ret clean.startsWith("std/") or clean.startsWith("std.")

pub fn isBuiltinStdNamespace(rawPath: str): bool:
  let clean = stripQuotes(rawPath)
  mut modName = clean
  if modName.startsWith("std/"):
    modName = modName.slice(4, modName.len)
  elif modName.startsWith("std."):
    modName = modName.slice(4, modName.len)
  if modName.endsWith(".aipl"):
    modName = modName.slice(0, modName.len - 5)
  ret modName == "gui" or modName == "app"

pub fn canonicalModuleKey(p: str): str:
  mut norm = pathNormalize(p)
  if norm.contains("std/"):
    let sIdx = norm.indexOf("std/")
    norm = norm.slice(sIdx, norm.len)
  ret norm

