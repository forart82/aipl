module CompilerTypes

import { Span, ExprNode, StmtNode, AstArena, emptySpan, stmtLhsExpr } from "./ast.aipl"
import { HirModule, HirFunction, HirStruct, HirEnum, resolveTypeName } from "./hir.aipl"

// ============================================================================
// Step 15.3 (Part 2): Self-Hosted Bidirectional Type Checker & Exhaustiveness
// ============================================================================

pub const AIPL_E_TYPE_MISMATCH: str = "AIPL_E2002_TYPE_MISMATCH"
pub const AIPL_E_INFINITE_LOOP_RISK: str = "AIPL_E_INFINITE_LOOP_RISK"
pub const AIPL_W_SNAKE_CASE_AUTOFIX: str = "AIPL_W1003_SNAKE_CASE_AUTOFIX"

pub struct CompilerDiagnostic:
  code: str
  message: str
  span: Span
  severity: str = "error"
  hint: str = ""
  autofixAvailable: bool = false
  autofixReplacement: str = ""

pub struct TypecheckResult:
  valid: bool
  diagnostics: [CompilerDiagnostic]
  inferredFnTypes: Map[str, str]

pub fn unwrapRefinementBase(ty: str): str:
  if ty.startsWith("{") and ty.contains(":") and ty.contains("|"):
    let colonIdx = ty.indexOf(":")
    let pipeIdx = ty.indexOf("|")
    if colonIdx >= 0 and pipeIdx > colonIdx:
      ret ty.slice(colonIdx + 1, pipeIdx).trim()
  ret ty

pub fn topLevelCommaIndex(ty: str): int:
  mut depth = 0
  mut i = 0
  while i < ty.len:
    let c = ty.charCodeAt(i)
    if c == 91 or c == 40:
      depth += 1
    elif c == 93 or c == 41:
      if depth > 0:
        depth -= 1
    elif c == 44 and depth == 0:
      ret i
    i += 1
  ret -1

pub struct TypeTerm:
  id: int
  kind: int
  name: str
  typeParams: [int] = []
  returnType: int = -1
  boundTo: int = -1

pub struct TypeTermArena:
  terms: [TypeTerm] = []

pub struct TypeEnv:
  bindings: Map[str, str] = Map.new()
  diagnostics: [str] = []

pub fn findTypeTermRoot(arena: TypeTermArena, id: int): int:
  if id < 0 or id >= arena.terms.len:
    ret id
  mut curr = id
  mut depth = 0
  while depth < 100:
    let term = arena.terms[curr]
    if term.boundTo < 0 or term.boundTo == curr:
      ret curr
    curr = term.boundTo
    depth += 1
  ret curr

pub fn typeTermAlloc(mut arena: TypeTermArena, kind: int, name: str, typeParams: [int] = [], returnType: int = -1): int:
  let id = arena.terms.len
  let term = TypeTerm(
    id = id,
    kind = kind,
    name = name,
    typeParams = typeParams,
    returnType = returnType,
    boundTo = -1
  )
  arena.terms.push(term)
  ret id

pub fn typeTermToString(arena: TypeTermArena, id: int): str:
  let root = findTypeTermRoot(arena, id)
  if root < 0 or root >= arena.terms.len:
    ret "unknown"
  let t = arena.terms[root]
  if t.kind == 0:
    ret if t.name != "": t.name else: ("T" + str(t.id))
  if t.kind == 1:
    ret t.name
  if t.kind == 2:
    mut innerStrs: [str] = []
    mut i = 0
    while i < t.typeParams.len:
      innerStrs.push(typeTermToString(arena, t.typeParams[i]))
      i += 1
    ret t.name + "[" + innerStrs.join(", ") + "]"
  if t.kind == 3:
    mut pStrs: [str] = []
    mut i = 0
    while i < t.typeParams.len:
      pStrs.push(typeTermToString(arena, t.typeParams[i]))
      i += 1
    let rStr = if t.returnType >= 0: typeTermToString(arena, t.returnType) else: "void"
    ret "fn(" + pStrs.join(", ") + ")->" + rStr
  ret t.name

pub fn newTypeTermArena(): TypeTermArena:
  let emptyTerms: [TypeTerm] = []
  ret TypeTermArena(terms = emptyTerms)

pub fn resolveTypeTermStr(arena: TypeTermArena, id: int): str:
  ret typeTermToString(arena, id)

pub fn unifyTerms(mut arena: TypeTermArena, t1: int, t2: int): bool:
  let r1 = findTypeTermRoot(arena, t1)
  let r2 = findTypeTermRoot(arena, t2)
  if r1 == r2:
    ret true
  if r1 < 0 or r2 < 0 or r1 >= arena.terms.len or r2 >= arena.terms.len:
    ret false

  let term1 = arena.terms[r1]
  let term2 = arena.terms[r2]

  if term1.kind == 0:
    arena.terms[r1] = TypeTerm(
      id = term1.id,
      kind = term1.kind,
      name = term1.name,
      typeParams = term1.typeParams,
      returnType = term1.returnType,
      boundTo = r2
    )
    ret true

  if term2.kind == 0:
    arena.terms[r2] = TypeTerm(
      id = term2.id,
      kind = term2.kind,
      name = term2.name,
      typeParams = term2.typeParams,
      returnType = term2.returnType,
      boundTo = r1
    )
    ret true

  if term1.kind == 1 and term2.kind == 1:
    if term1.name == "any" or term2.name == "any" or term1.name == "unknown" or term2.name == "unknown":
      ret true
    ret term1.name == term2.name

  if term1.kind == 2 and term2.kind == 2:
    if term1.name != term2.name:
      ret false
    if term1.typeParams.len != term2.typeParams.len:
      ret false
    mut pi = 0
    while pi < term1.typeParams.len:
      if not unifyTerms(arena, term1.typeParams[pi], term2.typeParams[pi]):
        ret false
      pi += 1
    ret true

  if term1.kind == 3 and term2.kind == 3:
    if term1.typeParams.len != term2.typeParams.len:
      ret false
    if not unifyTerms(arena, term1.returnType, term2.returnType):
      ret false
    mut pi = 0
    while pi < term1.typeParams.len:
      if not unifyTerms(arena, term1.typeParams[pi], term2.typeParams[pi]):
        ret false
      pi += 1
    ret true

  ret false

pub fn splitTopLevelComma(s: str): [str]:
  mut parts: [str] = []
  mut depth = 0
  mut startIdx = 0
  mut i = 0
  while i < s.len:
    let c = s.charCodeAt(i)
    if c == 91 or c == 40 or c == 123:
      depth += 1
    elif c == 93 or c == 41 or c == 125:
      if depth > 0:
        depth -= 1
    elif c == 44 and depth == 0:
      parts.push(s.slice(startIdx, i).trim())
      startIdx = i + 1
    i += 1
  if startIdx < s.len:
    let last = s.slice(startIdx, s.len).trim()
    if last != "":
      parts.push(last)
  ret parts

pub fn stringToTypeTermWithParams(mut arena: TypeTermArena, typeName: str, typeParams: [str]): int:
  mut t = typeName.trim()
  if t.startsWith("mut "):
    t = t.slice(4, t.len).trim()
  if t.startsWith("&"):
    t = t.slice(1, t.len).trim()
  if t == "" or t == "unknown":
    ret typeTermAlloc(arena, 1, "unknown")
  if t == "any":
    ret typeTermAlloc(arena, 1, "any")
  mut pi = 0
  while pi < typeParams.len:
    if t == typeParams[pi]:
      ret typeTermAlloc(arena, 0, t)
    pi += 1
  if t.startsWith("fn(") and t.contains("->"):
    let arrowIdx = t.indexOf("->")
    let rStr = t.slice(arrowIdx + 2, t.len).trim()
    let rId = stringToTypeTermWithParams(arena, rStr, typeParams)
    let pInside = t.slice(3, arrowIdx).trim()
    let pClosed = if pInside.endsWith(")"): pInside.slice(0, pInside.len - 1).trim() else: pInside
    mut pIds: [int] = []
    if pClosed != "":
      let rawParams = splitTopLevelComma(pClosed)
      mut pii = 0
      while pii < rawParams.len:
        pIds.push(stringToTypeTermWithParams(arena, rawParams[pii], typeParams))
        pii += 1
    ret typeTermAlloc(arena, 3, "fn", pIds, rId)
  if t.contains("[") and t.endsWith("]"):
    let bracketIdx = t.indexOf("[")
    let baseName = t.slice(0, bracketIdx).trim()
    let inner = t.slice(bracketIdx + 1, t.len - 1).trim()
    let rawArgs = splitTopLevelComma(inner)
    mut argIds: [int] = []
    mut ai = 0
    while ai < rawArgs.len:
      argIds.push(stringToTypeTermWithParams(arena, rawArgs[ai], typeParams))
      ai += 1
    ret typeTermAlloc(arena, 2, baseName, argIds)
  if t.len == 1 and t.charCodeAt(0) >= 65 and t.charCodeAt(0) <= 90:
    ret typeTermAlloc(arena, 0, t)
  ret typeTermAlloc(arena, 1, t)

pub fn stringToTypeTerm(mut arena: TypeTermArena, typeName: str): int:
  let emptyParams: [str] = []
  ret stringToTypeTermWithParams(arena, typeName, emptyParams)

pub fn unifyAndSubstituteGenericType(t: str, typeParams: [str], typeArgs: [str]): str:
  if t == "" or typeParams.len == 0 or typeArgs.len == 0:
    ret t
  mut arena = newTypeTermArena()
  let tId = stringToTypeTermWithParams(arena, t, typeParams)
  mut i = 0
  while i < typeParams.len and i < typeArgs.len:
    let pName = typeParams[i]
    let aName = typeArgs[i]
    let argId = internTypeStr(arena, aName)
    mut ti = 0
    while ti < arena.terms.len:
      if arena.terms[ti].kind == 0 and arena.terms[ti].name == pName:
        unifyTerms(arena, ti, argId)
      ti += 1
    i += 1
  let res = resolveTypeTermStr(arena, tId)
  if res != "" and res != "unknown":
    ret res
  ret t

fn isTypeIdentChar(c: int): bool:
  ret (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95

pub fn replaceTypeParam(text: str, sym: str, rep: str): str:
  if text == "" or sym == "":
    ret text
  mut parts: [str] = []
  mut pos = 0
  let sLen = sym.len
  while pos < text.len:
    let idx = text.indexOf(sym, pos)
    if idx < 0:
      parts.push(text.slice(pos, text.len))
      break
    let beforeOk = if idx == 0: true else: not isTypeIdentChar(text.charCodeAt(idx - 1))
    let afterIdx = idx + sLen
    let afterOk = if afterIdx >= text.len: true else: not isTypeIdentChar(text.charCodeAt(afterIdx))
    if idx > pos:
      parts.push(text.slice(pos, idx))
    if beforeOk and afterOk:
      parts.push(rep)
    else:
      parts.push(text.slice(idx, afterIdx))
    pos = afterIdx
  ret parts.join("")

pub fn substituteTypeStr(t: str, typeParams: [str], typeArgs: [str]): str:
  if t == "" or typeParams.len == 0 or typeArgs.len == 0:
    ret t
  let unified = unifyAndSubstituteGenericType(t, typeParams, typeArgs)
  if unified != t and unified != "" and unified != "unknown":
    ret unified

  mut parts: [str] = []
  mut spanStart = 0
  mut i = 0
  while i < t.len:
    let c = t.charCodeAt(i)
    if isTypeIdentChar(c):
      if i > spanStart:
        parts.push(t.slice(spanStart, i))
      let identStart = i
      while i < t.len and isTypeIdentChar(t.charCodeAt(i)):
        i += 1
      let ident = t.slice(identStart, i)
      mut replaced = false
      mut k = 0
      while k < typeParams.len and k < typeArgs.len:
        if ident == typeParams[k]:
          parts.push(typeArgs[k])
          replaced = true
          break
        k += 1
      if not replaced:
        parts.push(ident)
      spanStart = i
    else:
      i += 1
  if spanStart < t.len:
    parts.push(t.slice(spanStart, t.len))
  ret parts.join("")

pub fn substituteTypeParams(rawType: str, paramNames: [str], concreteArgs: [str]): str:
  ret substituteTypeStr(rawType, paramNames, concreteArgs)

pub fn mangleMonomorphizedFuncName(baseName: str, typeArgs: [str]): str:
  if typeArgs.len == 0:
    ret baseName
  mut cleanArgs: [str] = []
  mut i = 0
  while i < typeArgs.len:
    let a = typeArgs[i]
    mut parts: [str] = []
    mut spanStart = -1
    mut j = 0
    while j < a.len:
      let c = a.charCodeAt(j)
      let isAlnum = (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57)
      if isAlnum:
        if spanStart == -1:
          spanStart = j
      else:
        if spanStart != -1:
          parts.push(a.slice(spanStart, j))
          spanStart = -1
        if parts.len > 0 and parts[parts.len - 1] != "_":
          parts.push("_")
      j += 1
    if spanStart != -1 and spanStart < a.len:
      parts.push(a.slice(spanStart, a.len))
    let joined = parts.join("")
    let clean = if joined.endsWith("_"): joined.slice(0, joined.len - 1) else: joined
    if clean != "":
      cleanArgs.push(clean)
    else:
      cleanArgs.push("type")
    i += 1
  ret baseName + "__mono_" + cleanArgs.join("_")

pub fn canMonomorphizeGenericCall(typeParams: [str], typeArgs: [str]): bool:
  if typeParams.len == 0 or typeArgs.len != typeParams.len:
    ret false
  mut arena = newTypeTermArena()
  mut i = 0
  while i < typeParams.len:
    let pName = typeParams[i]
    let aName = typeArgs[i].trim()
    if aName == "" or aName == "any" or aName == "unknown":
      ret false
    if aName.len == 1 and aName.charCodeAt(0) >= 65 and aName.charCodeAt(0) <= 90:
      ret false
    let paramId = typeTermAlloc(arena, 0, pName)
    let argId = internTypeStr(arena, aName)
    if not unifyTerms(arena, paramId, argId):
      ret false
    let root = findTypeTermRoot(arena, paramId)
    if root < 0 or root >= arena.terms.len:
      ret false
    if arena.terms[root].kind == 0:
      ret false
    i += 1
  ret true

pub fn extractTypeArgs(ty: str): [str]:
  let bracketIdx = ty.indexOf("[")
  if bracketIdx < 0 or not ty.endsWith("]"):
    ret []
  let inner = ty.slice(bracketIdx + 1, ty.len - 1).trim()
  ret splitTopLevelComma(inner)

pub fn findStruct(hir: HirModule, name: str): Option[HirStruct]:
  mut baseName = name.trim()
  let bracketIdx = baseName.indexOf("[")
  if bracketIdx >= 0:
    baseName = baseName.slice(0, bracketIdx).trim()
  mut i = 0
  while i < hir.structs.len:
    if hir.structs[i].name == baseName:
      ret Some(hir.structs[i])
    i += 1
  ret None

pub fn findEnum(hir: HirModule, name: str): Option[HirEnum]:
  mut baseName = name.trim()
  let bracketIdx = baseName.indexOf("[")
  if bracketIdx >= 0:
    baseName = baseName.slice(0, bracketIdx).trim()
  mut i = 0
  while i < hir.enums.len:
    if hir.enums[i].name == baseName:
      ret Some(hir.enums[i])
    i += 1
  ret None

pub fn findFunction(hir: HirModule, name: str): Option[HirFunction]:
  mut baseName = name.trim()
  let bracketIdx = baseName.indexOf("[")
  if bracketIdx >= 0:
    baseName = baseName.slice(0, bracketIdx).trim()
  mut i = hir.functions.len - 1
  while i >= 0:
    if hir.functions[i].name == baseName or hir.functions[i].name == name:
      ret Some(hir.functions[i])
    i -= 1
  ret None

pub fn cloneEnv(env: Map[str, str]): Map[str, str]:
  mut res: Map[str, str] = Map.new()
  let ks = env.keys()
  mut i = 0
  while i < ks.len:
    let k = ks[i]
    let v = env.get(k)
    if v.isSome():
      res.set(k, v.unwrap())
    i += 1
  ret res

pub fn strArrayContains(arr: [str], item: str): bool:
  mut i = 0
  while i < arr.len:
    if arr[i] == item:
      ret true
    i += 1
  ret false

pub fn doesTypeImplementTrait(hir: HirModule, ty: str, traitName: str): bool:
  mut t = ty.trim()
  if t.startsWith("mut "):
    t = t.slice(4, t.len).trim()
  if t.startsWith("&"):
    t = t.slice(1, t.len).trim()
  let bracketIdx = t.indexOf("[")
  let baseName = if bracketIdx >= 0: t.slice(0, bracketIdx).trim() else: t

  let isInt = t == "int" or t == "i8" or t == "i16" or t == "i32" or t == "i64" or t == "u8" or t == "u16" or t == "u32" or t == "u64" or t == "usize" or t == "isize" or t == "byte"
  let isFloat = t == "float" or t == "f32" or t == "f64"
  let isPrim = isInt or isFloat or t == "str" or t == "bool"

  if traitName == "Ord":
    if isInt or isFloat or t == "str" or t == "bool":
      ret true
    mut fi = 0
    while fi < hir.functions.len:
      let f = hir.functions[fi]
      if f.name == baseName + "_cmp" or f.name == baseName + ".cmp":
        ret true
      if f.name == "cmp" and f.paramTypes.len > 0:
        let p0 = normalizeTypeName(f.paramTypes[0])
        if p0 == baseName or p0 == t:
          ret true
      fi += 1
    ret false

  if traitName == "Numeric":
    ret isInt or isFloat

  if traitName == "Display":
    if isPrim:
      ret true
    mut fi = 0
    while fi < hir.functions.len:
      let f = hir.functions[fi]
      if f.name == baseName + "_toStr" or f.name == baseName + ".toStr" or f.name == baseName + "_toString":
        ret true
      if (f.name == "toStr" or f.name == "toString") and f.paramTypes.len > 0:
        let p0 = normalizeTypeName(f.paramTypes[0])
        if p0 == baseName or p0 == t:
          ret true
      fi += 1
    ret false

  if traitName == "Eq":
    ret true

  if traitName.startsWith("Iterable"):
    if t.startsWith("Array[") or t.startsWith("[") or t == "str" or t.startsWith("Map["):
      ret true
    ret false

  ret true

pub fn extractConcreteTypeFromArg(paramTy: str, tParam: str, argTy: str): str:
  let pt = paramTy.trim()
  let tp = tParam.trim()
  let at = argTy.trim()
  if pt == tp:
    ret at
  if pt == "Array[" + tp + "]" or pt == "[" + tp + "]":
    if at.startsWith("Array[") and at.endsWith("]"):
      ret at.slice(6, at.len - 1).trim()
    if at.startsWith("[") and at.endsWith("]"):
      ret at.slice(1, at.len - 1).trim()
    ret at
  if pt.startsWith("mut ") and (pt == "mut " + tp or pt == "mut [" + tp + "]"):
    let innerPt = pt.slice(4, pt.len).trim()
    ret extractConcreteTypeFromArg(innerPt, tp, at)
  if pt.contains("[" + tp + "]"):
    if at.contains("[") and at.endsWith("]"):
      let bracketIdx = at.indexOf("[")
      ret at.slice(bracketIdx + 1, at.len - 1).trim()
  ret ""

pub fn extractVariantName(pat: str): str:
  mut s = pat.trim()
  if s.contains(" if "):
    let ifIdx = s.indexOf(" if ")
    s = s.slice(0, ifIdx).trim()
  if s.contains("?"):
    let qIdx = s.indexOf("?")
    s = s.slice(0, qIdx).trim()
  if s.contains("@"):
    let atIdx = s.indexOf("@")
    s = s.slice(0, atIdx).trim()
  if s.contains("("):
    let parenIdx = s.indexOf("(")
    s = s.slice(0, parenIdx).trim()
  while s.contains("::"):
    let idx = s.indexOf("::")
    s = s.slice(idx + 2, s.len).trim()
  while s.contains("."):
    let idx = s.indexOf(".")
    s = s.slice(idx + 1, s.len).trim()
  ret s.trim()

pub fn isWildcardPattern(pat: str, knownVariants: [str]): bool:
  mut s = pat.trim()
  if s.contains(" if ") or s.contains("?"):
    ret false
  if s.contains("@"):
    let atIdx = s.indexOf("@")
    s = s.slice(0, atIdx).trim()
  if s == "_" or s == "else" or s == "default":
    ret true
  if s.contains("(") or s.contains("::") or s.contains(".") or s.startsWith("\"") or s.startsWith("'"):
    ret false
  if s.len > 0:
    let c0 = s.charCodeAt(0)
    if c0 >= 97 and c0 <= 122:
      mut vi = 0
      while vi < knownVariants.len:
        if knownVariants[vi] == s:
          ret false
        vi += 1
      ret true
  ret false

pub fn checkMatchExhaustivenessAndUnreachable(hir: HirModule, env: Map[str, str], scrutExprId: int, armPatterns: [str], armHasGuards: [bool], span: Span, mut diags: [CompilerDiagnostic]): [CompilerDiagnostic]:
  let scrutTy = unwrapRefinementBase(inferExprType(hir, env, scrutExprId))
  mut baseEnumName = scrutTy
  let bracketIdx = baseEnumName.indexOf("[")
  if bracketIdx >= 0:
    baseEnumName = baseEnumName.slice(0, bracketIdx).trim()

  mut knownVariants: [str] = []
  let enumOpt = findEnum(hir, baseEnumName)
  if enumOpt.isSome():
    knownVariants = enumOpt.unwrap().variants
  elif baseEnumName == "Option":
    knownVariants = ["Some", "None"]
  elif baseEnumName == "Result":
    knownVariants = ["Ok", "Err"]

  mut coveredVariants: [str] = []
  mut hasWildcard = false
  mut ai = 0
  while ai < armPatterns.len:
    let pat = armPatterns[ai].trim()
    let hasGuard = if ai < armHasGuards.len: armHasGuards[ai] else: pat.contains(" if ")
    if hasWildcard:
      diags.push(CompilerDiagnostic(
        code = "AIPL_E2010_UNREACHABLE_PATTERN",
        message = "Unreachable pattern arm in match: subsumed by preceding wildcard",
        span = span
      ))
    else:
      let subPats = if pat.contains("|"): pat.split("|") else: [pat]
      mut spi = 0
      while spi < subPats.len:
        let sp = subPats[spi].trim()
        if not hasGuard and isWildcardPattern(sp, knownVariants):
          hasWildcard = true
        else:
          let vName = extractVariantName(sp)
          if vName != "" and vName != "_" and not hasGuard:
            if strArrayContains(coveredVariants, vName):
              diags.push(CompilerDiagnostic(
                code = "AIPL_E2010_UNREACHABLE_PATTERN",
                message = "Unreachable pattern arm in match: duplicate variant '" + baseEnumName + "." + vName + "'",
                span = span
              ))
            else:
              coveredVariants.push(vName)
        spi += 1
    ai += 1

  if knownVariants.len > 0 and not hasWildcard:
    mut vi = 0
    while vi < knownVariants.len:
      let v = knownVariants[vi]
      if not strArrayContains(coveredVariants, v):
        diags.push(CompilerDiagnostic(
          code = "AIPL_E2008_NON_EXHAUSTIVE_MATCH",
          message = "Non-exhaustive pattern match: missing variant '" + baseEnumName + "." + v + "'",
          span = span
        ))
      vi += 1

  ret diags

pub fn topLevelBangIndex(ty: str): int:
  mut depth = 0
  mut i = 0
  while i < ty.len:
    let c = ty.charCodeAt(i)
    if c == 91 or c == 40 or c == 123:
      depth += 1
    elif c == 93 or c == 41 or c == 125:
      if depth > 0:
        depth -= 1
    elif c == 33 and depth == 0:
      let nextC = if i + 1 < ty.len: ty.charCodeAt(i + 1) else: 0
      if nextC != 61 and i > 0 and i + 1 < ty.len:
        ret i
    i += 1
  ret -1

pub fn normalizeTypeShorthand(raw: str): str:
  let s = raw.trim()
  if s.startsWith("?") and s.len > 1:
    ret "Option[" + normalizeTypeName(s.slice(1, s.len)) + "]"
  let bangIdx = topLevelBangIndex(s)
  if bangIdx > 0:
    let okPart = normalizeTypeName(s.slice(0, bangIdx))
    let errPart = normalizeTypeName(s.slice(bangIdx + 1, s.len))
    ret "Result[" + okPart + ", " + errPart + "]"
  ret s

pub fn internTypeStr(mut arena: TypeTermArena, raw: str): int:
  let s = normalizeTypeName(unwrapRefinementBase(raw)).trim()
  if s.startsWith("[") and s.endsWith("]"):
    let elemId = internTypeStr(arena, s.slice(1, s.len - 1))
    ret typeTermAlloc(arena, 2, "Array", [elemId], -1)
  if s.contains("[") and s.endsWith("]"):
    let openIdx = s.indexOf("[")
    let base = s.slice(0, openIdx).trim()
    let inner = s.slice(openIdx + 1, s.len - 1).trim()
    mut paramIds: [int] = []
    mut rest = inner
    while rest.len > 0:
      let commaIdx = topLevelCommaIndex(rest)
      if commaIdx >= 0:
        paramIds.push(internTypeStr(arena, rest.slice(0, commaIdx)))
        rest = rest.slice(commaIdx + 1, rest.len).trim()
      else:
        paramIds.push(internTypeStr(arena, rest))
        rest = ""
    ret typeTermAlloc(arena, 2, base, paramIds, -1)
  let isTypeVar = s.len == 1 and s.charCodeAt(0) >= 65 and s.charCodeAt(0) <= 90
  let targetKind = if isTypeVar: 0 else: 1
  mut existing = 0
  while existing < arena.terms.len:
    let t = arena.terms[existing]
    if t.kind == targetKind and t.name == s and t.typeParams.len == 0:
      ret existing
    existing += 1
  ret typeTermAlloc(arena, targetKind, s, [], -1)

pub fn unifyTypeTerms(mut arena: TypeTermArena, idA: int, idB: int): bool:
  let rA = findTypeTermRoot(arena, idA)
  let rB = findTypeTermRoot(arena, idB)
  if rA == rB:
    ret true
  if rA < 0 or rA >= arena.terms.len or rB < 0 or rB >= arena.terms.len:
    ret false
  let tA = arena.terms[rA]
  let tB = arena.terms[rB]
  if tA.name == "any" or tB.name == "any":
    ret true
  if tA.kind == 0:
    mut upd = tA
    upd.boundTo = rB
    arena.terms[rA] = upd
    ret true
  if tB.kind == 0:
    mut upd = tB
    upd.boundTo = rA
    arena.terms[rB] = upd
    ret true
  if tA.kind != tB.kind or tA.name != tB.name or tA.typeParams.len != tB.typeParams.len:
    ret false
  mut i = 0
  while i < tA.typeParams.len:
    if not unifyTypeTerms(arena, tA.typeParams[i], tB.typeParams[i]):
      ret false
    i += 1
  ret true

pub fn normalizeTypeName(raw: str): str:
  mut s = raw.trim()
  if s.startsWith("&"):
    s = s.slice(1, s.len).trim()
  if s.startsWith("?") and s.len > 1:
    ret "Option[" + normalizeTypeName(s.slice(1, s.len)) + "]"
  let bangIdx = topLevelBangIndex(s)
  if bangIdx > 0:
    let okPart = normalizeTypeName(s.slice(0, bangIdx))
    let errPart = normalizeTypeName(s.slice(bangIdx + 1, s.len))
    ret "Result[" + okPart + ", " + errPart + "]"
  if s == "u8" or s == "u16" or s == "u32" or s == "u64" or s == "i8" or s == "i16" or s == "i32" or s == "i64" or s == "byte" or s == "char" or s == "usize" or s == "isize":
    ret "int"
  if s == "f32" or s == "f64":
    ret "float"
  if s == "string":
    ret "str"
  if s == "canvas.Color" or s == "color.Color" or s == "Color":
    ret "Color"
  if s == "canvas.Vec2" or s == "geom2d.Vec2" or s == "Vec2":
    ret "Vec2"
  if s == "canvas.Vec3" or s == "geom3d.Vec3" or s == "Vec3":
    ret "Vec3"
  if s == "canvas.Rect" or s == "geom2d.Rect" or s == "Rect":
    ret "Rect"
  if s == "canvas.KeyEvent" or s == "KeyEvent":
    ret "KeyEvent"
  if s == "buffer.ByteBuffer" or s == "ByteBuffer":
    ret "ByteBuffer"
  if s == "SmtDbm":
    ret "DbmState"
  if s == "Interval":
    ret "SmtInterval"
  ret s

pub fn numericRank(raw: str): int:
  let s = unwrapRefinementBase(raw).trim()
  if s == "byte" or s == "u8" or s == "i8":
    ret 1
  if s == "int" or s == "i16" or s == "u16" or s == "i32" or s == "u32" or s == "i64" or s == "u64" or s == "isize" or s == "usize":
    ret 2
  if s == "float" or s == "f32" or s == "f64":
    ret 3
  ret 0

pub fn isNumericSubtype(subTy: str, superTy: str): bool:
  let rSub = numericRank(subTy)
  let rSup = numericRank(superTy)
  if rSub > 0 and rSup > 0:
    ret rSub <= rSup
  ret false

pub fn isSubtype(subTy: str, superTy: str): bool:
  let rSub = numericRank(subTy)
  let rSup = numericRank(superTy)
  if rSub > 0 and rSup > 0:
    ret rSub <= rSup
  let normSub = normalizeTypeName(unwrapRefinementBase(subTy)).trim()
  let normSup = normalizeTypeName(unwrapRefinementBase(superTy)).trim()
  if normSub == normSup or normSup == "any" or normSub == "any" or normSup == "unknown":
    ret true
  ret typesCompatible(superTy, subTy)

pub fn isScalarType(raw: str): bool:
  let s = unwrapRefinementBase(raw).trim()
  if s == "int" or s == "float" or s == "str" or s == "bool" or s == "char":
    ret true
  if s == "byte" or s == "u8" or s == "i8" or s == "i16" or s == "u16" or s == "i32" or s == "u32" or s == "i64" or s == "u64" or s == "f32" or s == "f64":
    ret true
  if numericRank(s) > 0:
    ret true
  ret false

pub fn typesCompatible(expected: str, actual: str): bool:
  mut e = normalizeTypeName(unwrapRefinementBase(expected)).trim()
  mut a = normalizeTypeName(unwrapRefinementBase(actual)).trim()
  if e.startsWith("mut "):
    e = e.slice(4, e.len).trim()
  if a.startsWith("mut "):
    a = a.slice(4, a.len).trim()
  if e.startsWith("&"):
    e = e.slice(1, e.len).trim()
  if a.startsWith("&"):
    a = a.slice(1, a.len).trim()

  if (e == "Color" and a == "str") or (e == "str" and a == "Color"):
    ret false
  if (e == "Color" and a == "int") or (e == "int" and a == "Color"):
    ret true

  if e == a or e == "any" or a == "any" or e == "unknown" or a == "unknown" or e == "void":
    ret true

  let isEOpt = e == "Option" or e == "Option[any]" or e.startsWith("Option[")
  let isAOpt = a == "Option" or a == "Option[any]" or a.startsWith("Option[")
  let isEOptVal = isEOpt or e == "None" or e == "Some" or e.startsWith("Some[")
  let isAOptVal = isAOpt or a == "None" or a == "Some" or a.startsWith("Some[")
  let isERes = e == "Result" or e == "Result[any, any]" or e.startsWith("Result[")
  let isARes = a == "Result" or a == "Result[any, any]" or a.startsWith("Result[")
  let isEResVal = isERes or e == "Ok" or e.startsWith("Ok[") or e == "Err" or e.startsWith("Err[")
  let isAResVal = isARes or a == "Ok" or a.startsWith("Ok[") or a == "Err" or a.startsWith("Err[")

  // Scalar types must never accept Option or Result values without explicit unwrapping
  if isScalarType(e) and (isAOptVal or isAResVal):
    ret false

  if (e == "SmtDbm" and a == "DbmState") or (e == "DbmState" and a == "SmtDbm"):
    ret true
  if (e == "Interval" and a == "SmtInterval") or (e == "SmtInterval" and a == "Interval"):
    ret true
  if (e == "Vec2" and a == "Vector2") or (e == "Vector2" and a == "Vec2"):
    ret true
  if (e == "Vec3" and a == "Vector3") or (e == "Vector3" and a == "Vec3"):
    ret true
  if (e == "Vec4" and a == "Vector4") or (e == "Vector4" and a == "Vec4"):
    ret true
  if (e == "Rect" and a == "Rect2D") or (e == "Rect2D" and a == "Rect"):
    ret true

  if (e.startsWith("fn") or e == "Function") and (a.startsWith("fn") or a == "Function"):
    ret true

  if (e.len == 1 and e.charCodeAt(0) >= 65 and e.charCodeAt(0) <= 90) or (a.len == 1 and a.charCodeAt(0) >= 65 and a.charCodeAt(0) <= 90):
    ret true
  if e == "T" or e == "U" or e == "K" or e == "V" or e == "A" or e == "B" or e == "E":
    ret true
  if a == "T" or a == "U" or a == "K" or a == "V" or a == "A" or a == "B" or a == "E":
    ret true

  if (e == "int" and a == "float") or (e == "float" and a == "int"):
    ret true
  if (e == "Color" and a == "Color") or (e == "Vec2" and a == "Vec2") or (e == "Vec3" and a == "Vec3") or (e == "Rect" and a == "Rect") or (e == "KeyEvent" and a == "KeyEvent") or (e == "ByteBuffer" and a == "ByteBuffer"):
    ret true
  if (e == "bytes" and a == "ByteBuffer") or (e == "ByteBuffer" and a == "bytes"):
    ret true

  if (e.startsWith("Array[") or e.startsWith("[")) and (a.startsWith("Array[") or a.startsWith("[")):
    let innerE = if e.startsWith("["): e.slice(1, e.len - 1).trim() else: e.slice(6, e.len - 1).trim()
    let innerA = if a.startsWith("["): a.slice(1, a.len - 1).trim() else: a.slice(6, a.len - 1).trim()
    if innerE == "any" or innerA == "any" or innerE == "" or innerA == "" or typesCompatible(innerE, innerA):
      ret true
    ret false

  if e.contains("[") and a.contains("["):
    let baseE = e.slice(0, e.indexOf("[")).trim()
    let baseA = a.slice(0, a.indexOf("[")).trim()
    if baseE == baseA:
      let argsE = extractTypeArgs(e)
      let argsA = extractTypeArgs(a)
      if argsE.len == argsA.len:
        mut allOk = true
        mut ai = 0
        while ai < argsE.len:
          if not typesCompatible(argsE[ai], argsA[ai]):
            allOk = false
            break
          ai += 1
        ret allOk
    if (baseE == "Option" and baseA == "Some") or (baseE == "Some" and baseA == "Option"):
      let argsE = extractTypeArgs(e)
      let argsA = extractTypeArgs(a)
      if argsE.len == 1 and argsA.len == 1:
        ret typesCompatible(argsE[0], argsA[0])
    if baseE == "Result" and baseA == "Ok":
      let argsE = extractTypeArgs(e)
      let argsA = extractTypeArgs(a)
      if argsE.len >= 1 and argsA.len == 1:
        ret typesCompatible(argsE[0], argsA[0])
    if baseE == "Result" and baseA == "Err":
      let argsE = extractTypeArgs(e)
      let argsA = extractTypeArgs(a)
      if argsE.len >= 2 and argsA.len == 1:
        ret typesCompatible(argsE[1], argsA[0])

  if e.contains("["):
    let baseE = e.slice(0, e.indexOf("[")).trim()
    if baseE == a:
      ret true
  if a.contains("["):
    let baseA = a.slice(0, a.indexOf("[")).trim()
    if baseA == e:
      ret true

  if (isEOpt and isAOptVal) or (isAOpt and isEOptVal):
    ret true
  if e.startsWith("Option[") and e.endsWith("]") and not isARes:
    let innerE = e.slice(7, e.len - 1).trim()
    if typesCompatible(innerE, a):
      ret true
  if (isERes and isAResVal) or (isARes and isEResVal):
    ret true
  if e.startsWith("Result[") and e.endsWith("]") and not isAOpt:
    let endIdx = e.len - 1
    let inner = e.slice(7, endIdx).trim()
    let commaIdx = topLevelCommaIndex(inner)
    if commaIdx >= 0:
      let okInner = inner.slice(0, commaIdx).trim()
      if typesCompatible(okInner, a):
        ret true
  if (e == "Box" or e == "Box[any]" or e.startsWith("Box[")) and (a == "Box" or a == "Box[any]" or a.startsWith("Box[")):
    ret true
  if e.startsWith("(") and (a.startsWith("(") or a.startsWith("Array[")):
    ret true
  ret false

pub fn inferExprType(hir: HirModule, env: Map[str, str], exprId: int): str:
  if exprId < 0 or exprId >= hir.arena.exprs.len:
    ret "unknown"
  let e = hir.arena.exprs[exprId]

  if e.kind == "IntLit":
    ret "int"
  if e.kind == "FloatLit":
    ret "float"
  if e.kind == "STRING" or e.kind == "RAW_STRING" or e.kind == "INTERP_STRING":
    ret "str"
  if e.kind == "BoolLit":
    ret "bool"
  if e.kind == "NilLit":
    ret "void"
  if e.kind == "Array":
    if e.children.len > 0:
      mut elemTy = inferExprType(hir, env, e.children[0])
      mut ci = 1
      while ci < e.children.len:
        let nextTy = inferExprType(hir, env, e.children[ci])
        if nextTy != elemTy and not typesCompatible(elemTy, nextTy):
          elemTy = "any"
          break
        ci += 1
      ret "Array[" + elemTy + "]"
    ret "Array[any]"
  if e.kind == "ArrayRepeat":
    if e.left >= 0 and e.left < hir.arena.exprs.len:
      ret "Array[" + inferExprType(hir, env, e.left) + "]"
    ret "Array[any]"
  if e.kind == "MapLit":
    if e.children.len >= 2:
      mut kType = inferExprType(hir, env, e.children[0])
      mut vType = inferExprType(hir, env, e.children[1])
      mut ci = 2
      while ci + 1 < e.children.len:
        let nk = inferExprType(hir, env, e.children[ci])
        let nv = inferExprType(hir, env, e.children[ci + 1])
        if nk != kType and not typesCompatible(kType, nk):
          kType = "any"
        if nv != vType and not typesCompatible(vType, nv):
          vType = "any"
        ci += 2
      ret "Map[" + kType + ", " + vType + "]"
    ret "Map[any, any]"
  if e.kind == "StructLit":
    if e.strVal == "" and e.left >= 0 and e.left < hir.arena.exprs.len:
      let lnode = hir.arena.exprs[e.left]
      if lnode.kind == "Ident" and findStruct(hir, lnode.strVal).isSome():
        ret lnode.strVal
      ret inferExprType(hir, env, e.left)
    if e.strVal.contains("["):
      ret e.strVal
    let stOpt = findStruct(hir, e.strVal)
    if stOpt.isSome():
      let st = stOpt.unwrap()
      mut tParams: [str] = []
      if st.typeParams.len > 0:
        tParams = st.typeParams
      if tParams.len > 0:
        mut concreteArgs: [str] = []
        mut ti = 0
        while ti < tParams.len:
          let tp = tParams[ti]
          mut foundArg = ""
          mut fi = 0
          while fi < st.fieldNames.len:
            let fName = st.fieldNames[fi]
            let fType = st.fieldTypes[fi]
            if fType == tp or fType.contains(tp):
              mut ei = 0
              while ei < e.names.len:
                if e.names[ei] == fName and ei < e.children.len:
                  let actualFldTy = inferExprType(hir, env, e.children[ei])
                  foundArg = extractConcreteTypeFromArg(fType, tp, actualFldTy)
                  break
                ei += 1
              if foundArg != "":
                break
            fi += 1
          if foundArg == "":
            foundArg = "any"
          concreteArgs.push(foundArg)
          ti += 1
        if concreteArgs.len > 0 and concreteArgs[0] != "any":
          ret e.strVal + "[" + concreteArgs.join(", ") + "]"
    ret e.strVal
  if e.kind == "StructUpdate":
    if e.left >= 0:
      ret inferExprType(hir, env, e.left)
    ret "any"
  if e.kind == "Ident":
    if e.strVal == "None":
      ret "Option[any]"
    let fromEnv = env.get(e.strVal)
    if fromEnv.isSome():
      ret fromEnv.unwrap()
    if e.strVal == "pass":
      ret "nil"
    mut si = 0
    while si < hir.symbols.len:
      if hir.symbols[si].name == e.strVal:
        ret hir.symbols[si].tyName
      si += 1
    mut si2 = 0
    while si2 < hir.structs.len:
      if hir.structs[si2].name == e.strVal:
        ret hir.structs[si2].name
      si2 += 1
    mut ei = 0
    while ei < hir.enums.len:
      if hir.enums[ei].name == e.strVal:
        ret hir.enums[ei].name
      ei += 1
    if e.strVal == "Color" or e.strVal == "Vec2" or e.strVal == "Vec3" or e.strVal == "Rect" or e.strVal == "KeyEvent" or e.strVal == "ByteBuffer":
      ret e.strVal
    ret "unknown"
  if e.kind == "WideningCast":
    if e.strVal == "IntToFloat" or e.strVal == "ByteToFloat" or e.strVal == "float":
      ret "float"
    if e.strVal == "ByteToInt" or e.strVal == "int":
      ret "int"
    ret if e.strVal != "": e.strVal else: "float"
  if e.kind == "Unary":
    if e.op == "not" or e.op == "!":
      ret "bool"
    if e.op == "await":
      let innerTy = inferExprType(hir, env, e.left)
      if innerTy.startsWith("Promise[") and innerTy.endsWith("]"):
        ret innerTy.slice(8, innerTy.len - 1).trim()
      ret innerTy
    ret inferExprType(hir, env, e.left)
  if e.kind == "Binary":
    let op = e.op
    if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" or op == "and" or op == "or" or op == "&&" or op == "||" or op == "in":
      ret "bool"
    if op == "??":
      let rTy = unwrapRefinementBase(inferExprType(hir, env, e.right))
      if rTy != "unknown" and rTy != "":
        ret rTy
      ret "any"
    if op == "%%" or op == "%" or op == "//":
      ret "int"
    let lt = unwrapRefinementBase(inferExprType(hir, env, e.left))
    let rt = unwrapRefinementBase(inferExprType(hir, env, e.right))
    let normLt = normalizeTypeName(lt)
    let normRt = normalizeTypeName(rt)
    if op == "+" or op == "-" or op == "*" or op == "/" or op == "**":
      if normLt == "Vec2" or normRt == "Vec2":
        ret "Vec2"
      if normLt == "Vec3" or normRt == "Vec3":
        ret "Vec3"
      if (normLt == "float" and (normRt == "int" or normRt == "float")) or (normRt == "float" and (normLt == "int" or normLt == "float")):
        ret "float"
      if normLt == "int" and normRt == "int":
        ret "int"
    if lt == rt and lt != "unknown":
      ret lt
    if lt != "unknown":
      ret lt
    ret rt
  if e.kind == "Call":
    if e.left >= 0 and e.left < hir.arena.exprs.len:
      let origCallee = hir.arena.exprs[e.left]
      mut callee = origCallee
      mut explicitTypeArgs: [str] = []
      if (callee.kind == "Index" or callee.kind == "Index2D") and callee.left >= 0 and callee.left < hir.arena.exprs.len:
        if hir.arena.exprs[callee.left].kind == "Ident":
          if callee.right >= 0 and callee.right < hir.arena.exprs.len and hir.arena.exprs[callee.right].kind == "Ident":
            explicitTypeArgs.push(hir.arena.exprs[callee.right].strVal)
          if callee.kind == "Index2D" and callee.cond >= 0 and callee.cond < hir.arena.exprs.len and hir.arena.exprs[callee.cond].kind == "Ident":
            explicitTypeArgs.push(hir.arena.exprs[callee.cond].strVal)
          callee = hir.arena.exprs[callee.left]
      if callee.kind == "Ident":
        let cname = callee.strVal
        if cname == "sha256" and e.children.len == 1:
          let arg0Ty = unwrapRefinementBase(inferExprType(hir, env, e.children[0]))
          if arg0Ty == "str":
            ret "str"
        if cname != "Some" and cname != "None" and cname != "Ok" and cname != "Err" and cname != "Box":
          let fDecl = findFunction(hir, cname)
          if fDecl.isSome():
            let hf = fDecl.unwrap()
            if hf.typeParams.len == 0 and hf.retType.len > 0 and hf.retType != "unknown":
              ret hf.retType
        if cname == "int" or cname == "len" or cname == "crc32" or cname == "nowMs" or cname == "nowUnixMs" or cname == "nowMonoNs" or cname == "sleepMs" or cname == "ord" or cname == "charCode" or cname == "parseInt" or cname == "remEuclid" or cname == "popcnt" or cname == "ctz" or cname == "clz" or cname == "getScreenWidth" or cname == "getScreenHeight" or cname == "getKeyPressed" or cname == "getPixel" or cname == "playSound" or cname == "playSoundEx" or cname == "playPcmBuffer" or cname == "getImageWidth" or cname == "getImageHeight" or cname == "imageWidth" or cname == "imageHeight" or cname == "createImageFromPixels" or cname == "createTextureFromRgba" or cname == "createProceduralTexture" or cname == "createIsometricSpriteSheet" or cname == "getBlendMode" or cname == "blendModeAlpha" or cname == "blendModeAdditive" or cname == "blendModeMultiplied" or cname == "blendModeScreen" or cname == "getCompositionCursor" or cname == "arenaMark" or cname == "hardwareConcurrency" or cname == "fileSize" or cname == "aipl_rt_fileSize":
          ret "int"
        if cname == "float" or cname == "sqrt" or cname == "sin" or cname == "cos" or cname == "tan" or cname == "asin" or cname == "acos" or cname == "atan" or cname == "atan2" or cname == "absFloat" or cname == "randomFloat" or cname == "randFloat" or cname == "round" or cname == "roundTo" or cname == "getMouseX" or cname == "getMouseY" or cname == "getFrameTime" or cname == "getScaleFactor" or cname == "getMouseWheelMove" or cname == "mouseWheelX" or cname == "mouseWheelY" or cname == "measureTextWidth" or cname == "measureTextHeight" or cname == "getAudioEnergy" or cname == "getAudioBand" or cname == "audioTime" or cname == "getContentScale" or cname == "measureTextSubstr":
          ret "float"
        if cname == "str" or cname == "sha256" or cname == "readFile" or cname == "hexEncode" or cname == "toHex" or cname == "chr" or cname == "charFromCode" or cname == "fromCharCode" or cname == "toString" or cname == "formatFloat" or cname == "canvasBackendName" or cname == "getWindowMode" or cname == "getTextInput" or cname == "getCompositionText" or cname == "getClipboardText" or cname == "getGraphicsBackendName" or cname == "cwd" or cname == "tempDir" or cname == "homeDir" or cname == "readLine" or cname == "readStdin" or cname == "realpath" or cname == "pathJoin" or cname == "pathDirname" or cname == "pathBasename" or cname == "pathNormalize" or cname == "pathExtname" or cname == "pathExtension" or cname == "pathExt" or cname == "pathStem" or cname == "aipl_rt_realpath" or cname == "aipl_rt_pathJoin" or cname == "aipl_rt_pathDirname" or cname == "aipl_rt_pathBasename" or cname == "aipl_rt_pathNormalize" or cname == "aipl_rt_readFile":
          ret "str"
