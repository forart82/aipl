        if cname == "drawPolyline" or cname == "drawLineLoop" or cname == "drawLineStrip" or cname == "drawRectGradientH" or cname == "drawRectGradientV" or cname == "drawLinearGradient" or cname == "drawGridTiles" or cname == "drawCellGrid" or cname == "drawRectBatch" or cname == "drawCharGrid" or cname == "withViewport" or cname == "drawTextMiddle" or cname == "drawTextAligned" or cname == "drawImage" or cname == "drawImageScaled" or cname == "drawImageSub" or cname == "playToneEx" or cname == "playTone" or cname == "playToneSweep" or cname == "clearScreen" or cname == "clearBackground" or cname == "drawRect" or cname == "drawCircle" or cname == "drawLine" or cname == "drawText" or cname == "drawTextCentered" or cname == "beginDrawing" or cname == "endDrawing" or cname == "setWindowSize" or cname == "setWindowMinSize" or cname == "setMasterVolume" or cname == "stopAllSounds" or cname == "recordVideoFrame" or cname == "setClipboardText" or cname == "setSoftwareRasterizer" or cname == "setWindowMode" or cname == "begin3D" or cname == "end3D" or cname == "drawTriangleDepth" or cname == "setDepthTest" or cname == "clearDepth" or cname == "beginWorldPass" or cname == "endWorldPass" or cname == "setUiTracking" or cname == "setBlendMode" or cname == "drawTriangleGouraud" or cname == "drawTriangle3DGouraud" or cname == "drawQuad3DGouraud" or cname == "drawTriangle3DTextured" or cname == "drawQuad3DTextured" or cname == "drawCubeMesh" or cname == "renderCube" or cname == "printInline" or cname == "flushStdout" or cname == "eprint" or cname == "eprintln" or cname == "arenaReset" or cname == "setEnv" or cname == "exit" or cname == "panic":
          ret "void"
