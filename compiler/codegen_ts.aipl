      ret "({ tag: \"" + calleeStr + "\", ordinal: " + str(ord) + ", value: " + argVal + " })"
    mut structDeclIdx = -1
    if calleeStr.len > 0 and calleeStr.charCodeAt(0) >= 65 and calleeStr.charCodeAt(0) <= 90:
      mut sdi = 0
      while sdi < arena.decls.len:
        let sd = arena.decls[sdi]
        if sd.kind == "Struct" and sd.name == calleeStr:
          structDeclIdx = sdi
        sdi += 1
    if structDeclIdx >= 0:
      let sd = arena.decls[structDeclIdx]
      mut fInits: [str] = []
      mut usedFields: [str] = []
      mut ai = 0
      while ai < args.len:
        if ai < e.names.len and e.names[ai].len > 0:
          fInits.push(e.names[ai] + ": " + args[ai])
          usedFields.push(e.names[ai])
        elif ai < sd.fieldNames.len:
          fInits.push(sd.fieldNames[ai] + ": " + args[ai])
          usedFields.push(sd.fieldNames[ai])
        ai += 1
      mut dfi = 0
      while dfi < sd.fieldNames.len:
        let fnm = sd.fieldNames[dfi]
        mut seenField = false
        mut ufi = 0
        while ufi < usedFields.len:
          if usedFields[ufi] == fnm:
            seenField = true
            break
          ufi += 1
        if not seenField and dfi < sd.variantPayloadTypes.len and sd.variantPayloadTypes[dfi] >= 0:
          fInits.push(fnm + ": " + emitTsExpr(arena, sd.variantPayloadTypes[dfi]))
        dfi += 1
      ret "_aiplStructNew(\"" + sd.name + "\", { " + fInits.join(", ") + " })"
    ret safeTsFnName(calleeStr) + "(" + args.join(", ") + ")"
  if e.kind == "StructLit":
    let stTypeName = if e.strVal.contains("["): e.strVal.slice(0, e.strVal.indexOf("[")) else: e.strVal
    mut fInits: [str] = []
    mut usedFields: [str] = []
    if e.left >= 0:
      fInits.push("..." + emitTsExpr(arena, e.left))
    mut fi = 0
    while fi < e.children.len:
      if fi < e.names.len and e.names[fi].len > 0:
        fInits.push(e.names[fi] + ": " + emitTsExpr(arena, e.children[fi]))
        usedFields.push(e.names[fi])
      else:
        fInits.push("f" + str(fi) + ": " + emitTsExpr(arena, e.children[fi]))
      fi += 1
    if stTypeName.len > 0 and e.left < 0:
      mut sdi = 0
      while sdi < arena.decls.len:
        let sd = arena.decls[sdi]
        if sd.kind == "Struct" and sd.name == stTypeName:
          mut dfi = 0
          while dfi < sd.fieldNames.len:
            let fnm = sd.fieldNames[dfi]
            mut seenField = false
            mut ufi = 0
            while ufi < usedFields.len:
              if usedFields[ufi] == fnm:
                seenField = true
                break
              ufi += 1
            if not seenField and dfi < sd.variantPayloadTypes.len and sd.variantPayloadTypes[dfi] >= 0:
              fInits.push(fnm + ": " + emitTsExpr(arena, sd.variantPayloadTypes[dfi]))
            dfi += 1
        sdi += 1
    if stTypeName.len > 0:
      ret "_aiplStructNew(\"" + stTypeName + "\", { " + fInits.join(", ") + " })"
    ret "{ " + fInits.join(", ") + " }"
  if e.kind == "StructUpdate":
    mut fInits: [str] = ["..." + emitTsExpr(arena, e.left)]
    mut fi = 0
    while fi < e.children.len:
      if fi < e.names.len and e.names[fi].len > 0:
        fInits.push(e.names[fi] + ": " + emitTsExpr(arena, e.children[fi]))
      fi += 1
    ret "{ " + fInits.join(", ") + " }"
  if e.kind == "Array" or e.kind == "Tuple":
    mut elems: [str] = []
    mut ai = 0
    while ai < e.children.len:
      elems.push(emitTsExpr(arena, e.children[ai]))
      ai += 1
    ret "[" + elems.join(", ") + "]"
  if e.kind == "MapLit":
    mut pairs: [str] = []
    mut mi = 0
    while mi + 1 < e.children.len:
      pairs.push("[" + emitTsExpr(arena, e.children[mi]) + ", " + emitTsExpr(arena, e.children[mi + 1]) + "]")
      mi += 2
    ret "new Map([" + pairs.join(", ") + "])"
  ret "undefined"

pub fn emitTsStmt(arena: AstArena, stmtId: int, indent: str, includeTypes: bool): [str]:
  mut lines: [str] = []
  if stmtId < 0 or stmtId >= arena.stmts.len:
    ret lines
  let st = arena.stmts[stmtId]
  if st.kind == "VarDecl":
    if st.name == "_":
      if st.exprId >= 0:
        lines.push(indent + emitTsExpr(arena, st.exprId) + ";")
      ret lines
    let kw = "var"
    mut tyAnnot = ""
    if includeTypes and st.typeId >= 0:
      tyAnnot = ": " + mapAiplTypeToTs(resolveTypeName(arena, st.typeId))
    let rhs = if st.exprId >= 0: emitTsExpr(arena, st.exprId) else: "undefined"
    lines.push(indent + kw + " " + st.name + tyAnnot + " = " + rhs + ";")
    ret lines
  if st.kind == "TupleVarDecl":
    let rhs = if st.exprId >= 0: emitTsExpr(arena, st.exprId) else: "[]"
    let uid = str(st.id)
    lines.push(indent + "var _tup_" + uid + " = " + rhs + ";")
    let rawNames = st.name.split(",")
    mut ti = 0
    while ti < rawNames.len:
      mut vName = rawNames[ti].trim()
      mut accessPath = str(ti)
      if vName.contains(":"):
        let p = vName.split(":")
        vName = p[0].trim()
        if p.len > 1:
          accessPath = p[1].trim()
      if vName.startsWith("("):
        vName = vName.slice(1, vName.len).trim()
      if vName.endsWith(")"):
        vName = vName.slice(0, vName.len - 1).trim()
      if vName.len > 0 and vName != "_":
        let pSteps = accessPath.split(".")
        mut acc = "_tup_" + uid
        mut si = 0
        while si < pSteps.len:
          acc = acc + "[" + pSteps[si] + "]"
          si += 1
        lines.push(indent + "var " + vName + " = " + acc + ";")
      ti += 1
    ret lines
  if st.kind == "Block" or st.kind == "ArenaScope":
    mut bi = 0
    while bi < st.bodyStmts.len:
      let sub = emitTsStmt(arena, st.bodyStmts[bi], indent, includeTypes)
      mut si = 0
      while si < sub.len:
        lines.push(sub[si])
        si += 1
      bi += 1
    ret lines
  if st.kind == "Return":
    if st.exprId >= 0:
      lines.push(indent + "return " + emitTsExpr(arena, st.exprId) + ";")
    else:
      lines.push(indent + "return;")
    ret lines
  if st.kind == "break" or st.kind == "continue" or st.kind == "Break" or st.kind == "Continue":
    lines.push(indent + st.kind.toLowerCase() + ";")
    ret lines
  if st.kind == "Pass":
    lines.push(indent + "/* pass */;")
    ret lines
  if st.kind == "Require" or st.kind == "Requires":
    if st.exprId >= 0:
      lines.push(indent + "if (!(" + emitTsExpr(arena, st.exprId) + ")) { throw new Error(\"require contract failed\"); }")
    ret lines
  if st.kind == "Ensure" or st.kind == "Ensures":
    if st.exprId >= 0:
      let ensCode = emitTsExpr(arena, st.exprId)
      if not ensCode.contains("ret") and not ensCode.contains("result"):
        lines.push(indent + "if (!(" + ensCode + ")) { throw new Error(\"ensure contract failed\"); }")
    ret lines
  if st.kind == "Invariant":
    if st.exprId >= 0:
      lines.push(indent + "if (!(" + emitTsExpr(arena, st.exprId) + ")) { throw new Error(\"loop invariant contract failed\"); }")
    ret lines
  if st.kind == "Decreases" or st.kind == "Decrease":
    if st.exprId >= 0:
      lines.push(indent + "if (!((" + emitTsExpr(arena, st.exprId) + ") >= 0)) { throw new Error(\"loop decreases contract failed\"); }")
    ret lines
  if st.kind == "Assign":
    if st.condExpr >= 0 and arena.exprs[st.condExpr].kind == "Index" and st.name == "=":
      let idxNode = arena.exprs[st.condExpr]
      let objCode = emitTsExpr(arena, idxNode.left)
      let keyCode = emitTsExpr(arena, idxNode.right)
      let rhs = emitTsExpr(arena, st.exprId)
      if idxNode.left >= 0 and arena.exprs[idxNode.left].kind == "Member":
        lines.push(indent + objCode + "[" + keyCode + "] = " + rhs + ";")
      else:
        lines.push(indent + "_aipl_set_idx(" + objCode + ", " + keyCode + ", " + rhs + ");")
      ret lines
    let lhs = if st.condExpr >= 0 and arena.exprs[st.condExpr].kind == "Member": emitTsExpr(arena, arena.exprs[st.condExpr].left) + "." + arena.exprs[st.condExpr].strVal else: emitTsExpr(arena, st.condExpr)
    let rhs = emitTsExpr(arena, st.exprId)
    lines.push(indent + lhs + " " + st.name + " " + rhs + ";")
    ret lines
  if st.kind == "ExprStmt" or st.kind == "Expr" or st.kind == "Discard":
    lines.push(indent + emitTsExpr(arena, st.exprId) + ";")
    ret lines
  if st.kind == "If":
    lines.push(indent + "if (" + emitTsExpr(arena, st.condExpr) + ") {")
    mut bi = 0
    while bi < st.bodyStmts.len:
      let sub = emitTsStmt(arena, st.bodyStmts[bi], indent + "  ", includeTypes)
      mut si = 0
      while si < sub.len:
        lines.push(sub[si])
        si += 1
      bi += 1
    lines.push(indent + "}")
    if st.elseStmts.len > 0:
      mut inElseBlock = false
      mut ei = 0
      while ei < st.elseStmts.len:
        let elId = st.elseStmts[ei]
        let elNode = arena.stmts[elId]
        if elNode.kind == "Elif":
          if inElseBlock:
            lines.push(indent + "}")
            inElseBlock = false
          lines.push(indent + "else if (" + emitTsExpr(arena, elNode.condExpr) + ") {")
          mut ebi = 0
          while ebi < elNode.bodyStmts.len:
            let esub = emitTsStmt(arena, elNode.bodyStmts[ebi], indent + "  ", includeTypes)
            mut esi = 0
            while esi < esub.len:
              lines.push(esub[esi])
              esi += 1
            ebi += 1
          lines.push(indent + "}")
        else:
          if not inElseBlock:
            lines.push(indent + "else {")
            inElseBlock = true
          let esub = emitTsStmt(arena, elId, indent + "  ", includeTypes)
          mut esi = 0
          while esi < esub.len:
            lines.push(esub[esi])
            esi += 1
        ei += 1
      if inElseBlock:
        lines.push(indent + "}")
    ret lines
  if st.kind == "While":
    let wCond = emitTsExpr(arena, st.condExpr)
    if not includeTypes and (wCond.contains("windowShouldClose") or wCond.contains("isWindowOpen")):
      lines.push(indent + "function _aipl_main_loop_step() {")
      lines.push(indent + "  if (_aipl_window_closed) return;")
      lines.push(indent + "  let _aipl_step_iter = 0;")
      lines.push(indent + "  while (" + wCond + " && !_aipl_window_closed) {")
      lines.push(indent + "    if (_aipl_step_iter++ > 0) {")
      lines.push(indent + "      _aiplFlushBatch();")
      lines.push(indent + "      for (const k in __aipl_keys_just_pressed) delete __aipl_keys_just_pressed[k];")
      lines.push(indent + "      for (const b in __aipl_mouse_just_pressed) delete __aipl_mouse_just_pressed[b];")
      lines.push(indent + "      __aipl_mouse_wheel_y = 0;")
      lines.push(indent + "      if (!_aipl_window_closed && typeof requestAnimationFrame !== 'undefined') {")
      lines.push(indent + "        if (typeof window !== 'undefined' && typeof setTimeout === 'function' && typeof process === 'undefined') {")
      lines.push(indent + "          let _stepped = false;")
      lines.push(indent + "          const _runStep = () => { if (_stepped || _aipl_window_closed) return; _stepped = true; _aipl_main_loop_step(); };")
      lines.push(indent + "          requestAnimationFrame(_runStep);")
      lines.push(indent + "          setTimeout(_runStep, 30);")
      lines.push(indent + "        } else {")
      lines.push(indent + "          requestAnimationFrame(_aipl_main_loop_step);")
      lines.push(indent + "        }")
      lines.push(indent + "      }")
      lines.push(indent + "      return;")
      lines.push(indent + "    }")
      mut wbi = 0
      while wbi < st.bodyStmts.len:
        let wsub = emitTsStmt(arena, st.bodyStmts[wbi], indent + "    ", includeTypes)
        mut wsi = 0
        while wsi < wsub.len:
          lines.push(wsub[wsi])
          wsi += 1
        wbi += 1
      lines.push(indent + "  }")
      lines.push(indent + "  _aipl_window_closed = true;")
      lines.push(indent + "}")
      lines.push(indent + "_aipl_main_loop_step();")
      lines.push(indent + "if (typeof requestAnimationFrame !== 'undefined') return 0;")
      ret lines
    lines.push(indent + "while (" + wCond + ") {")
    mut bi = 0
    while bi < st.bodyStmts.len:
      let sub = emitTsStmt(arena, st.bodyStmts[bi], indent + "  ", includeTypes)
      mut si = 0
      while si < sub.len:
        lines.push(sub[si])
        si += 1
      bi += 1
    lines.push(indent + "}")
    ret lines
  if st.kind == "For":
    let iterVar = st.name
    let isTuple = iterVar.contains(",")
    let varDecl = if isTuple: "[" + iterVar + "]" else: iterVar
    if st.exprId >= 0 and arena.exprs[st.exprId].kind == "RangeStep":
      let stepExpr = arena.exprs[st.exprId]
      let rng = arena.exprs[stepExpr.left]
      let stepCode = emitTsExpr(arena, stepExpr.right)
      let startCode = emitTsExpr(arena, rng.left)
      let endCode = emitTsExpr(arena, rng.right)
      let cmp = if rng.op == "..=": "<=" else: "<"
      lines.push(indent + "for (let " + iterVar + " = " + startCode + "; " + iterVar + " " + cmp + " " + endCode + "; " + iterVar + " += " + stepCode + ") {")
    elif st.exprId >= 0 and arena.exprs[st.exprId].kind == "Binary" and (arena.exprs[st.exprId].op == ".." or arena.exprs[st.exprId].op == "..="):
      let rng = arena.exprs[st.exprId]
      let startCode = emitTsExpr(arena, rng.left)
      let endCode = emitTsExpr(arena, rng.right)
      let cmp = if rng.op == "..=": "<=" else: "<"
      lines.push(indent + "for (let " + iterVar + " = " + startCode + "; " + iterVar + " " + cmp + " " + endCode + "; " + iterVar + "++) {")
    elif st.isMut:
      let uid = str(st.id)
      let cVar = "_c_" + uid
      let iVar = "_i_" + uid
      lines.push(indent + "const " + cVar + " = " + emitTsExpr(arena, st.exprId) + ";")
      lines.push(indent + "for (let " + iVar + " = 0; " + iVar + " < " + cVar + ".length; " + iVar + "++) {")
      lines.push(indent + "  let " + varDecl + " = " + cVar + "[" + iVar + "];")
      mut bi = 0
      while bi < st.bodyStmts.len:
        let sub = emitTsStmt(arena, st.bodyStmts[bi], indent + "  ", includeTypes)
        mut si = 0
        while si < sub.len:
          lines.push(sub[si])
          si += 1
        bi += 1
      lines.push(indent + "  " + cVar + "[" + iVar + "] = " + varDecl + ";")
      lines.push(indent + "}")
      ret lines
    else:
      lines.push(indent + "for (const " + varDecl + " of " + emitTsExpr(arena, st.exprId) + ") {")
    mut bi = 0
    while bi < st.bodyStmts.len:
      let sub = emitTsStmt(arena, st.bodyStmts[bi], indent + "  ", includeTypes)
      mut si = 0
      while si < sub.len:
        lines.push(sub[si])
        si += 1
      bi += 1
    lines.push(indent + "}")
    ret lines
  if st.kind == "Match":
    let targetStr = emitTsExpr(arena, st.exprId)
    mut ai = 0
    while ai < st.matchArms.len:
      let arm = arena.stmts[st.matchArms[ai]]
      let prefix = if ai == 0: "if" else: "else if"
      mut guardSuffix = ""
      if arm.exprId >= 0:
        guardSuffix = " && (" + emitTsExpr(arena, arm.exprId) + ")"
      if arm.name == "_" or arm.name == "else":
        if guardSuffix.len > 0:
          lines.push(indent + prefix + " (true" + guardSuffix + ") {")
        else:
          lines.push(indent + "else {")
      elif arm.name.startsWith("prefix(\"") and arm.name.endsWith("\")"):
        let pfxVal = arm.name.slice(8, arm.name.len - 2)
        lines.push(indent + prefix + " (typeof " + targetStr + " === 'string' && " + targetStr + ".startsWith(" + escapeTsStringLiteral(pfxVal) + ")" + guardSuffix + ") {")
      elif arm.name.contains("|"):
        let pparts = arm.name.split("|")
        mut pconds: [str] = []
        mut ppi = 0
        while ppi < pparts.len:
          let pp = pparts[ppi].trim()
          pconds.push(emitTsMatchArmCondition(targetStr, pp))
          ppi += 1
        lines.push(indent + prefix + " ((" + pconds.join(" || ") + ")" + guardSuffix + ") {")
      else:
        let armCond = emitTsMatchArmCondition(targetStr, arm.name)
        lines.push(indent + prefix + " (" + armCond + guardSuffix + ") {")
      mut bi = 0
      while bi < arm.bodyStmts.len:
        let sub = emitTsStmt(arena, arm.bodyStmts[bi], indent + "  ", includeTypes)
        mut si = 0
        while si < sub.len:
          lines.push(sub[si])
          si += 1
        bi += 1
      lines.push(indent + "}")
      ai += 1
    ret lines
  ret lines

pub fn emitTsRuntimeHeader(): str:
  ret emitTsRuntimeHeaderInternal(true)

pub fn emitJsRuntimeHeader(): str:
  ret emitTsRuntimeHeaderInternal(false)

pub fn emitTsRuntimeHeaderInternal(includeTypes: bool): str:
  mut lines: [str] = []
  let pfx = if includeTypes: "export " else: ""
  lines.push("// --- AIPL Runtime Header (TypeScript/HTML5) ---")
  lines.push("")
  if includeTypes:
    lines.push("export const __AIPL_ASSETS: Record<string, Uint8Array> = {};")
  else:
    lines.push("const __AIPL_ASSETS = (typeof window !== 'undefined' && window.__AIPL_ASSETS) ? window.__AIPL_ASSETS : {};")
  lines.push("")
  lines.push(pfx + "function assetExists(path" + (if includeTypes: ": string" else: "") + ")" + (if includeTypes: ": boolean" else: "") + " {")
  lines.push("  const p = String(path).replace(/^\\.\\//, '');")
  lines.push("  return Boolean(__AIPL_ASSETS[p] || __AIPL_ASSETS[path]);")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function loadAsset(path" + (if includeTypes: ": string" else: "") + ")" + (if includeTypes: ": { ok: boolean; value?: Uint8Array; error?: string }" else: "") + " {")
  lines.push("  const p = String(path).replace(/^\\.\\//, '');")
  lines.push("  const found = __AIPL_ASSETS[p] || __AIPL_ASSETS[path];")
  lines.push("  if (found) {")
  lines.push("    return { ok: true, value: found };")
  lines.push("  }")
  lines.push("  return { ok: false, error: 'Asset not found: ' + path };")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function listAssets()" + (if includeTypes: ": string[]" else: "") + " {")
  lines.push("  return Object.keys(__AIPL_ASSETS);")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function int(x" + (if includeTypes: ": any" else: "") + ")" + (if includeTypes: ": number" else: "") + " { return Math.trunc(Number(x) || 0); }")
  lines.push(pfx + "function float(x" + (if includeTypes: ": any" else: "") + ")" + (if includeTypes: ": number" else: "") + " { return Number(x) || 0.0; }")
  lines.push(pfx + "function bool(x" + (if includeTypes: ": any" else: "") + ")" + (if includeTypes: ": boolean" else: "") + " { return Boolean(x); }")
  lines.push("")
  lines.push(pfx + "class ByteBuffer {")
  if includeTypes:
    lines.push("  buf: Uint8Array;")
    lines.push("  len: number;")
    lines.push("  constructor(cap: number = 64) {")
  else:
    lines.push("  constructor(cap = 64) {")
  lines.push("    this.buf = new Uint8Array(Math.max(16, cap || 64));")
  lines.push("    this.len = 0;")
  lines.push("  }")
  lines.push("  get length()" + (if includeTypes: ": number" else: "") + " { return this.len; }")
  lines.push("  get buffer()" + (if includeTypes: ": Uint8Array" else: "") + " { return this.buf; }")
  lines.push("  _ensure(extra" + (if includeTypes: ": number" else: "") + ") {")
  lines.push("    if (this.len + extra > this.buf.length) {")
  lines.push("      const nextCap = Math.max(this.buf.length * 2, this.len + extra + 16);")
  lines.push("      const nextBuf = new Uint8Array(nextCap);")
  lines.push("      nextBuf.set(this.buf.subarray(0, this.len));")
  lines.push("      this.buf = nextBuf;")
  lines.push("    }")
  lines.push("  }")
  lines.push("  writeU8(v" + (if includeTypes: ": number" else: "") + ") {")
  lines.push("    this._ensure(1);")
  lines.push("    this.buf[this.len++] = v & 0xff;")
  lines.push("    return this;")
  lines.push("  }")
  lines.push("  writeU16BE(v" + (if includeTypes: ": number" else: "") + ") {")
  lines.push("    this._ensure(2);")
  lines.push("    this.buf[this.len++] = (v >> 8) & 0xff;")
  lines.push("    this.buf[this.len++] = v & 0xff;")
  lines.push("    return this;")
  lines.push("  }")
  lines.push("  writeU16LE(v" + (if includeTypes: ": number" else: "") + ") {")
  lines.push("    this._ensure(2);")
  lines.push("    this.buf[this.len++] = v & 0xff;")
  lines.push("    this.buf[this.len++] = (v >> 8) & 0xff;")
  lines.push("    return this;")
  lines.push("  }")
  lines.push("  writeU32BE(v" + (if includeTypes: ": number" else: "") + ") {")
  lines.push("    this._ensure(4);")
  lines.push("    this.buf[this.len++] = (v >>> 24) & 0xff;")
  lines.push("    this.buf[this.len++] = (v >>> 16) & 0xff;")
  lines.push("    this.buf[this.len++] = (v >>> 8) & 0xff;")
  lines.push("    this.buf[this.len++] = v & 0xff;")
  lines.push("    return this;")
  lines.push("  }")
  lines.push("  writeU32LE(v" + (if includeTypes: ": number" else: "") + ") {")
  lines.push("    this._ensure(4);")
  lines.push("    this.buf[this.len++] = v & 0xff;")
  lines.push("    this.buf[this.len++] = (v >>> 8) & 0xff;")
  lines.push("    this.buf[this.len++] = (v >>> 16) & 0xff;")
  lines.push("    this.buf[this.len++] = (v >>> 24) & 0xff;")
  lines.push("    return this;")
  lines.push("  }")
  lines.push("  writeBytes(b" + (if includeTypes: ": any" else: "") + ") {")
  lines.push("    const arr = b instanceof Uint8Array ? b : new Uint8Array(b);")
  lines.push("    this._ensure(arr.length);")
  lines.push("    this.buf.set(arr, this.len);")
  lines.push("    this.len += arr.length;")
  lines.push("    return this;")
  lines.push("  }")
  lines.push("  writeString(s" + (if includeTypes: ": any" else: "") + ") {")
  lines.push("    const encoded = new TextEncoder().encode(String(s));")
  lines.push("    return this.writeBytes(encoded);")
  lines.push("  }")
  lines.push("  freeze()" + (if includeTypes: ": Uint8Array" else: "") + " {")
  lines.push("    return this.buf.slice(0, this.len);")
  lines.push("  }")
  lines.push("  toBytes()" + (if includeTypes: ": Uint8Array" else: "") + " {")
  lines.push("    return this.buf.slice(0, this.len);")
  lines.push("  }")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function byteBufferAlloc(cap" + (if includeTypes: ": number = 64" else: " = 64") + ") {")
  lines.push("  return new ByteBuffer(cap);")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function bytesZeroed(size" + (if includeTypes: ": number" else: "") + ")" + (if includeTypes: ": Uint8Array" else: "") + " {")
  lines.push("  return new Uint8Array(Math.max(0, size));")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function bytesFromArray(arr" + (if includeTypes: ": number[]" else: "") + ")" + (if includeTypes: ": Uint8Array" else: "") + " {")
  lines.push("  return new Uint8Array(arr);")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function bytesConcat(parts" + (if includeTypes: ": any[]" else: "") + ")" + (if includeTypes: ": Uint8Array" else: "") + " {")
  lines.push("  let total = 0;")
  lines.push("  for (let i = 0; i < parts.length; i++) total += parts[i].length;")
  lines.push("  const out = new Uint8Array(total);")
  lines.push("  let off = 0;")
  lines.push("  for (let i = 0; i < parts.length; i++) {")
  lines.push("    const p = parts[i];")
  lines.push("    out.set(p instanceof Uint8Array ? p : new Uint8Array(p), off);")
  lines.push("    off += p.length;")
  lines.push("  }")
  lines.push("  return out;")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function bytesFromHex(hex" + (if includeTypes: ": string" else: "") + ")" + (if includeTypes: ": Uint8Array" else: "") + " {")
  lines.push("  let s = String(hex).replace(/[^0-9a-fA-F]/g, '');")
  lines.push("  if (s.length % 2 !== 0) s = '0' + s;")
  lines.push("  const out = new Uint8Array(s.length / 2);")
  lines.push("  for (let i = 0; i < out.length; i++) {")
  lines.push("    out[i] = parseInt(s.substr(i * 2, 2), 16) || 0;")
  lines.push("  }")
  lines.push("  return out;")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function hexEncode(b" + (if includeTypes: ": any" else: "") + ")" + (if includeTypes: ": string" else: "") + " {")
  lines.push("  const arr = b instanceof Uint8Array ? b : new Uint8Array(b);")
  lines.push("  let hex = '';")
  lines.push("  for (let i = 0; i < arr.length; i++) {")
  lines.push("    hex += arr[i].toString(16).padStart(2, '0');")
  lines.push("  }")
  lines.push("  return hex;")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function hexDecode(hex" + (if includeTypes: ": string" else: "") + ")" + (if includeTypes: ": Uint8Array" else: "") + " {")
  lines.push("  return bytesFromHex(hex);")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function readU16BE(b" + (if includeTypes: ": Uint8Array, off: number" else: ", off") + ")" + (if includeTypes: ": number" else: "") + " {")
  lines.push("  if (off < 0 || off + 2 > b.length) return 0;")
  lines.push("  return ((b[off] << 8) | b[off + 1]) >>> 0;")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function readU16LE(b" + (if includeTypes: ": Uint8Array, off: number" else: ", off") + ")" + (if includeTypes: ": number" else: "") + " {")
  lines.push("  if (off < 0 || off + 2 > b.length) return 0;")
  lines.push("  return (b[off] | (b[off + 1] << 8)) >>> 0;")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function readU32BE(b" + (if includeTypes: ": Uint8Array, off: number" else: ", off") + ")" + (if includeTypes: ": number" else: "") + " {")
  lines.push("  if (off < 0 || off + 4 > b.length) return 0;")
  lines.push("  return (((b[off] << 24) | (b[off + 1] << 16) | (b[off + 2] << 8) | b[off + 3]) >>> 0);")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "function readU32LE(b" + (if includeTypes: ": Uint8Array, off: number" else: ", off") + ")" + (if includeTypes: ": number" else: "") + " {")
  lines.push("  if (off < 0 || off + 4 > b.length) return 0;")
  lines.push("  return ((b[off] | (b[off + 1] << 8) | (b[off + 2] << 16) | (b[off + 3] << 24)) >>> 0);")
  lines.push("}")
  lines.push("")
  lines.push("if (typeof Uint8Array !== 'undefined') {")
  lines.push("  const p = Uint8Array.prototype;")
  lines.push("  if (!p.toArray) p.toArray = function() { return Array.from(this); };")
  lines.push("  if (!p.toInts) p.toInts = function() { return Array.from(this); };")
  lines.push("  if (!p.setByte) p.setByte = function(i, v) { this[i] = v & 0xff; return this; };")
  lines.push("  if (!p.copyFrom) p.copyFrom = function(dstOff, src, srcOff, len) {")
  lines.push("    const s = src instanceof Uint8Array ? src : new Uint8Array(src);")
  lines.push("    this.set(s.subarray(srcOff, srcOff + len), dstOff);")
  lines.push("    return this;")
  lines.push("  };")
  lines.push("  if (!p.indexOfByte) p.indexOfByte = function(v, from = 0) { return this.indexOf(v, from); };")
  lines.push("  if (!p.indexOfBytes) p.indexOfBytes = function(needle, from = 0) {")
  lines.push("    const n = needle instanceof Uint8Array ? needle : new Uint8Array(needle);")
  lines.push("    if (n.length === 0) return from <= this.length ? from : -1;")
  lines.push("    for (let i = from; i <= this.length - n.length; i++) {")
  lines.push("      let match = true;")
  lines.push("      for (let j = 0; j < n.length; j++) {")
  lines.push("        if (this[i + j] !== n[j]) { match = false; break; }")
  lines.push("      }")
  lines.push("      if (match) return i;")
  lines.push("    }")
  lines.push("    return -1;")
  lines.push("  };")
  lines.push("  if (!p.readU16BE) p.readU16BE = function(off) { return readU16BE(this, off); };")
  lines.push("  if (!p.readU16LE) p.readU16LE = function(off) { return readU16LE(this, off); };")
  lines.push("  if (!p.readU32BE) p.readU32BE = function(off) { return readU32BE(this, off); };")
  lines.push("  if (!p.readU32LE) p.readU32LE = function(off) { return readU32LE(this, off); };")
  lines.push("  if (!p.toHex) p.toHex = function() { return hexEncode(this); };")
  lines.push("  if (!p.hexToBytes) p.hexToBytes = function() { return { ok: true, value: this }; };")
  lines.push("  if (!p.toStringUtf8) p.toStringUtf8 = function() {")
  lines.push("    try {")
  lines.push("      const dec = new TextDecoder('utf-8', { fatal: true });")
  lines.push("      return { ok: true, value: dec.decode(this) };")
  lines.push("    } catch (e) {")
  lines.push("      return { ok: false, error: String(e && e.message ? e.message : e) };")
  lines.push("    }")
  lines.push("  };")
  lines.push("  if (!p.toStringLossy) p.toStringLossy = function() {")
  lines.push("    return new TextDecoder('utf-8', { fatal: false }).decode(this);")
  lines.push("  };")
  lines.push("  if (!p.splitByte) p.splitByte = function(delim) {")
  lines.push("    const res = [];")
  lines.push("    let start = 0;")
  lines.push("    for (let i = 0; i < this.length; i++) {")
  lines.push("      if (this[i] === delim) {")
  lines.push("        res.push(this.slice(start, i));")
  lines.push("        start = i + 1;")
  lines.push("      }")
  lines.push("    }")
  lines.push("    res.push(this.slice(start));")
  lines.push("    return res;")
  lines.push("  };")
  lines.push("}")
  lines.push("")
  lines.push("if (typeof String !== 'undefined') {")
  lines.push("  const sp = String.prototype;")
  lines.push("  if (!sp.hexToBytes) sp.hexToBytes = function() {")
  lines.push("    try {")
  lines.push("      const clean = this.replace(/[^0-9a-fA-F]/g, '');")
  lines.push("      if (clean.length % 2 !== 0) return { ok: false, error: 'Invalid hex string' };")
  lines.push("      return { ok: true, value: bytesFromHex(clean) };")
  lines.push("    } catch (e) {")
  lines.push("      return { ok: false, error: String(e && e.message ? e.message : e) };")
