te.syncFails = (__aipl_hebar_state.syncFails || 0) + 1; __aipl_hebar_state.syncRetryFrame = __aipl_hebar_state.frame + Math.min(180, 2 << Math.min(8, __aipl_hebar_state.syncFails)); }); } catch (_e) { __aipl_hebar_state.syncInFlight = false; } } if (__aipl_hebar_state.ws && __aipl_hebar_state.ws.readyState === 1) { try { __aipl_hebar_state.ws.send(JSON.stringify(__aipl_get_state_snapshot())); } catch (_e) {} } if (typeof globalThis !== 'undefined' && typeof globalThis.__aiplHebarFrameHook === 'function') { try { globalThis.__aiplHebarFrameHook(__aiplHebarBridge, __aipl_hebar_state.frame); } catch (_e) {} } if (typeof globalThis !== 'undefined' && globalThis.__aiplMaxFrames > 0 && __aipl_hebar_state.frame >= globalThis.__aiplMaxFrames) { _aipl_window_closed = true; } };")
  lines.push("const __aiplHebarBridge = { getStateSnapshot: __aipl_get_state_snapshot, acquireSeatLease: (seatId) => { const f = __aipl_hebar_state.frame; if (__aipl_hebar_state.activeLeaseSeat === 0 || __aipl_hebar_state.activeLeaseSeat === seatId || (f - __aipl_hebar_state.leaseFrame) > 8) { __aipl_hebar_state.activeLeaseSeat = seatId; __aipl_hebar_state.leaseFrame = f; return true; } return false; }, releaseSeatLease: (seatId) => { if (__aipl_hebar_state.activeLeaseSeat === seatId) __aipl_hebar_state.activeLeaseSeat = 0; return true; }, dispatchSeatAction: (seatId, script) => { __aipl_exec_bot_script(script, seatId); return { status: 'ok', seat: seatId, frame: __aipl_hebar_state.frame, outOfTurnRejected: __aipl_hebar_state.turnState.outOfTurnRejected || 0 }; }, connectWebSocket: (port) => { if (typeof WebSocket === 'undefined' || !port) return false; try { const ws = new WebSocket('ws:' + '/' + '/127.0.0.1:' + port); ws.onmessage = (ev) => { try { const msg = JSON.parse(String(ev.data || '{}')); if (msg.action === 'getStateSnapshot') ws.send(JSON.stringify(__aipl_get_state_snapshot())); else if (msg.script) __aiplHebarBridge.dispatchSeatAction(msg.seatId || 0, msg.script); } catch (_e) {} }; __aipl_hebar_state.ws = ws; return true; } catch (_e) { return false; } } };")
  lines.push("if (typeof window !== 'undefined') { window.__aiplHebarBridge = __aiplHebarBridge; try { const m = (window.location && window.location.search || '').match(/hebar_port=(\\d+)/); const hp = window.__AIPL_HEBAR_PORT || (m ? Number(m[1]) : 0); if (hp > 0) __aiplHebarBridge.connectWebSocket(hp); } catch (_e) {} }")
  lines.push("if (typeof globalThis !== 'undefined') globalThis.__aiplHebarBridge = __aiplHebarBridge;")
  lines.push(pfx + "function setSingleInstance(enabled) { _aipl_single_instance = Boolean(enabled); return _aipl_single_instance; }")
  lines.push(pfx + "function isSingleInstance() { return Boolean(_aipl_single_instance); }")
  lines.push(pfx + "function publishBotState(key, jsonVal) { if (key) __aipl_hebar_state.custom[String(key)] = jsonVal; return true; }")
  lines.push(pfx + "function publishTurnState(activeSeat, phase, winnerSeat) { const prev = __aipl_hebar_state.turnState.activeSeat; __aipl_hebar_state.turnState.explicitTurn = true; __aipl_hebar_state.turnState.activeSeat = Math.trunc(activeSeat || 1); if (prev !== __aipl_hebar_state.turnState.activeSeat) __aipl_hebar_state.turnState.turnNumber++; __aipl_hebar_state.turnState.phase = String(phase || 'play'); __aipl_hebar_state.turnState.winnerSeat = Math.trunc(winnerSeat || 0); __aipl_hebar_state.turnState.gameOver = __aipl_hebar_state.turnState.winnerSeat > 0 || __aipl_hebar_state.turnState.phase === 'gameover'; return true; }")
  lines.push(pfx + "function targetWindowAction(target, botScript) { return targetWindowSeatAction(target, 0, botScript); }")
  lines.push(pfx + "function targetWindowSeatAction(target, seatId, botScript) { if (typeof require !== 'undefined') { try { const fs = require('fs'); const dir = '/tmp/aipl_windows'; if (!fs.existsSync(dir)) return false; const files = fs.readdirSync(dir); let pid = Number(target); if (isNaN(pid) || pid <= 0) { for (const f of files) { if (f.endsWith('.info')) { const info = fs.readFileSync(dir + '/' + f, 'utf8'); if (target === 'all' || info.toLowerCase().includes(String(target).toLowerCase())) { const m = f.match(/win_(\\d+)\\.info/); if (m) { pid = Number(m[1]); break; } } } } } if (pid > 0) { const suf = seatId > 0 ? '.' + seatId : ''; const s = String(botScript); const payload = s.startsWith('action:') ? s : ('action:' + s); fs.writeFileSync(dir + '/win_' + pid + '.cmd' + suf, payload + '\\n'); return true; } } catch (_e) {} } __aipl_exec_bot_script(botScript, seatId); return true; }")
  lines.push(pfx + "function targetWindowScreenshot(target, outPath) { return saveScreenshot(outPath); }")
  lines.push(pfx + "function targetWindowRecord(target, outPath, frames, fps) { return true; }")
  lines.push(pfx + "function listRunningWindows() { if (typeof require !== 'undefined') { try { const fs = require('fs'); const dir = '/tmp/aipl_windows'; if (!fs.existsSync(dir)) return []; return fs.readdirSync(dir).filter(f => f.endsWith('.info')).map(f => fs.readFileSync(dir + '/' + f, 'utf8').trim()); } catch (_e) {} } return ['pid=1\\ntitle=' + __aipl_hebar_state.title]; }")
  lines.push("// --- Lifecycle Support ---")
  lines.push(pfx + "function startAiplLifecycle() {")
  lines.push("  if (typeof main === 'function') {")
  lines.push("    main();")
  lines.push("    return;")
  lines.push("  }")
  lines.push("  if (typeof init === 'function') init();")
  lines.push("  let lastTime = 0;")
  lines.push("  const loop = (now) => {")
  lines.push("    const dt = lastTime > 0 ? (now - lastTime) / 1000 : 0.0166;")
  lines.push("    lastTime = now;")
  lines.push("    const _fmark = arenaMark();")
  lines.push("    if (typeof __aipl_hebar_begin_frame === 'function') __aipl_hebar_begin_frame();")
  lines.push("    if (typeof update === 'function') update(dt);")
  lines.push("    if (typeof render === 'function') render();")
  lines.push("    _aiplFlushBatch();")
  lines.push("    if (typeof __aipl_hebar_end_frame === 'function') __aipl_hebar_end_frame();")
  lines.push("    arenaReset(_fmark);")
  lines.push("    if (!_aipl_window_closed && typeof requestAnimationFrame !== 'undefined') requestAnimationFrame(loop);")
  lines.push("  };")
  lines.push("  if (typeof update === 'function' || typeof render === 'function') {")
  lines.push("    if (typeof requestAnimationFrame !== 'undefined') requestAnimationFrame(loop);")
  lines.push("  }")
  lines.push("}")
  lines.push("")
  lines.push(pfx + "const Canvas = {")
  lines.push("  initWindow, initCanvas, clearScreen, drawRect, drawRoundedRect, drawCircle, drawLine,")
  lines.push("  drawPolyline, drawLineLoop, drawLineStrip, drawRectGradientH, drawRectGradientV,")
  lines.push("  drawLinearGradient, drawGridTiles, drawCellGrid, drawRectBatch, drawCharGrid,")
  lines.push("  withViewport, drawText, drawTextCentered, drawTextMiddle, drawTextAligned,")
  lines.push("  measureText, measureTextSubstr, loadImage, drawImage, drawSprite, readPixels, readCanvasPixel,")
  lines.push("  saveCanvasSnapshot, saveCanvasPPM, rgba, rgb, colorHex,")
  lines.push("  canvasBackendName, isHeadlessMode, endFrame, beginFrame, presentCanvas, clearCanvas, getPixel, setWindowMode, getWindowMode, backendName: canvasBackendName, isHeadless: isHeadlessMode,")
  lines.push("  pollKeyEvents, isKeyPressed, isKeyDown, isKeyJustPressed, getPressedKey, isAnyKeyPressed, pollFileDropEvents,")
  lines.push("  setSingleInstance, isSingleInstance, publishBotState, publishTurnState, targetWindowAction, targetWindowSeatAction, targetWindowScreenshot, targetWindowRecord, listRunningWindows,")
  lines.push("  _aiplWebGL2Batcher, _aiplBatchQuad, _aiplFlushBatch")
  lines.push("};")
  lines.push(pfx + "const canvas = Canvas;")
  lines.push(pfx + "const Hebar = { publishBotState, publishTurnState, targetWindowSeatAction };")
  lines.push("")
  lines.push(pfx + "const Audio = { playTone, playToneEx };")
  lines.push("")
  lines.push(pfx + "const Arena = { arenaMark, arenaReset, arenaAllocatedBytes, arenaAlloc, arenaStats, withScratchArena, mark: arenaMark, reset: arenaReset, allocatedBytes: arenaAllocatedBytes, alloc: arenaAlloc, stats: arenaStats };")
  lines.push(pfx + "const arena = Arena;")
  lines.push("")
  if includeTypes:
    lines.push("declare global {")
    lines.push("  interface Uint8Array {")
    lines.push("    toArray(): number[];")
    lines.push("    toInts(): number[];")
    lines.push("    setByte(idx: number, val: number): this;")
    lines.push("    copyFrom(dstOff: number, src: Uint8Array | number[], srcOff: number, len: number): this;")
    lines.push("    indexOfByte(val: number, fromIndex?: number): number;")
    lines.push("    indexOfBytes(needle: Uint8Array | number[], fromIndex?: number): number;")
    lines.push("    readU16BE(off: number): number;")
    lines.push("    readU16LE(off: number): number;")
    lines.push("    readU32BE(off: number): number;")
    lines.push("    readU32LE(off: number): number;")
    lines.push("    toHex(): string;")
    lines.push("    hexToBytes(): { ok: boolean; value: Uint8Array };")
    lines.push("    toStringUtf8(): { ok: boolean; value?: string; error?: string };")
    lines.push("    toStringLossy(): string;")
    lines.push("    splitByte(delim: number): Uint8Array[];")
    lines.push("  }")
    lines.push("  interface String {")
    lines.push("    hexToBytes(): { ok: boolean; value?: Uint8Array; error?: string };")
    lines.push("    toBytes(): Uint8Array;")
    lines.push("  }")
    lines.push("}")
    lines.push("")
  ret lines.join("\n")

pub fn emitTypeScriptModule(hir: HirModule, source: str): str:
  mut out: [str] = []
  out.push("// Generated by AIPL Self-Hosted Compiler (Phase 15)")
  out.push("export const AIPL_MODULE_NAME = \"" + hir.moduleName + "\";")
  out.push("")
  let rtHeader = emitTsRuntimeHeader()
  out.push(rtHeader)
  out.push("")

  mut declaredConsts: Map[str, bool] = Map.new()
  declaredConsts.set("AIPL_MODULE_NAME", true)
  declaredConsts.set("AIPL_SOURCE_LINES", true)
  let rtLines = rtHeader.lines()
  mut rli = 0
  while rli < rtLines.len:
    let rl = rtLines[rli].trim()
    let cleanRl = if rl.startsWith("export "): rl.slice(7, rl.len).trim() else: rl
    if cleanRl.startsWith("const ") or cleanRl.startsWith("let "):
      let kwLen = if cleanRl.startsWith("const "): 6 else: 4
      let rest = cleanRl.slice(kwLen, cleanRl.len)
      let eqIdx = rest.indexOf("=")
      if eqIdx > 0:
        let rawName = rest.slice(0, eqIdx).trim()
        let colonIdx = rawName.indexOf(":")
        let cName = if colonIdx > 0: rawName.slice(0, colonIdx).trim() else: rawName
        declaredConsts.set(cName, true)
    rli += 1

  mut constNames: [str] = []
  mut constExprs: [int] = []
  mut constIdxMap: Map[str, int] = Map.new()
  mut fnDeclMap: Map[str, int] = Map.new()
  mut cdi = 0
  while cdi < hir.arena.decls.len:
    let d = hir.arena.decls[cdi]
    if d.kind == "Const" and d.name.len > 0:
      let initExprId = if d.bodyStmts.len > 0: d.bodyStmts[0] else: -1
      if constIdxMap.containsKey(d.name):
        let existingIdx = constIdxMap.get(d.name).unwrap()
        constExprs[existingIdx] = initExprId
      else:
        constIdxMap.set(d.name, constNames.len)
        constNames.push(d.name)
        constExprs.push(initExprId)
    elif (d.kind == "Function" or d.kind == "Fn") and d.name.len > 0:
      fnDeclMap.set(d.name, cdi)
    cdi += 1

  mut cni = 0
  while cni < constNames.len:
    let cname = constNames[cni]
    if not declaredConsts.containsKey(cname):
      declaredConsts.set(cname, true)
      let cExprId = constExprs[cni]
      let cVal = if cExprId >= 0: emitTsExpr(hir.arena, cExprId) else: "0"
      out.push("export const " + cname + " = " + cVal + ";")
    cni += 1
  if constNames.len > 0:
    out.push("")

  mut si = 0
  while si < hir.structs.len:
    let st = hir.structs[si]
    out.push("export interface " + st.name + " {")
    mut fi = 0
    while fi < st.fieldNames.len:
      out.push("  " + st.fieldNames[fi] + ": " + mapAiplTypeToTs(st.fieldTypes[fi]) + ";")
      fi += 1
    out.push("}")
    let schemaStr = generateStructJsonSchema(st)
    out.push("export const " + st.name + " = {")
    out.push("  jsonSchema(): string { return " + escapeTsStringLiteral(schemaStr) + "; },")
    out.push("  fromJson(s: string): { ok: boolean; value?: " + st.name + "; error?: string } {")
    out.push("    try {")
    out.push("      const obj = typeof s === 'string' ? JSON.parse(s) : s;")
    out.push("      return { ok: true, value: obj as " + st.name + " };")
    out.push("    } catch (e: any) {")
    out.push("      return { ok: false, error: String(e?.message ?? e) };")
    out.push("    }")
    out.push("  }")
    out.push("};")
    out.push("")
    si += 1

  mut ei = 0
  while ei < hir.enums.len:
    let en = hir.enums[ei]
    mut vTags: [str] = []
    mut vObjProps: [str] = []
    mut vi = 0
    while vi < en.variants.len:
      let vname = en.variants[vi]
      vTags.push("{ readonly tag: \"" + vname + "\"; readonly ordinal: number; readonly value?: any }")
      vObjProps.push(vname + ": { tag: \"" + vname + "\", ordinal: " + str(vi) + " }")
      vi += 1
    let enSchemaStr = generateEnumJsonSchema(en)
    vObjProps.push("jsonSchema(): string { return " + escapeTsStringLiteral(enSchemaStr) + "; }")
    vObjProps.push("fromJson(s: string): { ok: boolean; value?: " + en.name + "; error?: string } { try { const obj = typeof s === 'string' ? JSON.parse(s) : s; return { ok: true, value: obj as " + en.name + " }; } catch (e: any) { return { ok: false, error: String(e?.message ?? e) }; } }")
    if vTags.len > 0:
      out.push("export type " + en.name + " = " + vTags.join(" | ") + ";")
      out.push("export const " + en.name + " = { " + vObjProps.join(", ") + " } as const;")
      out.push("")
    ei += 1

  mut fni = 0
  while fni < hir.functions.len:
    let f = hir.functions[fni]
    let fnDeclIdx = if fnDeclMap.containsKey(f.name): fnDeclMap.get(f.name).unwrap() else: -1
    mut params: [str] = []
    mut pi = 0
    while pi < f.paramNames.len:
      mut pTy = "any"
      if pi < f.paramTypes.len:
        pTy = f.paramTypes[pi]
      let pSpec = f.paramNames[pi] + ": " + mapAiplTypeToTs(pTy)
      if fnDeclIdx >= 0 and pi < hir.arena.decls[fnDeclIdx].variantPayloadTypes.len and hir.arena.decls[fnDeclIdx].variantPayloadTypes[pi] >= 0:
        let defCode = emitTsExpr(hir.arena, hir.arena.decls[fnDeclIdx].variantPayloadTypes[pi])
        params.push(pSpec + " = " + defCode)
      else:
        params.push(pSpec)
      pi += 1
    let tsRetTy = mapAiplTypeToTs(f.retType)
    out.push("export function " + safeTsFnName(f.name) + "(" + params.join(", ") + "): " + tsRetTy + " {")
    if f.bodyStmts.len == 0:
      if tsRetTy != "void":
        out.push("  return undefined as any;")
    else:
      mut bsi = 0
      while bsi < f.bodyStmts.len:
        let stLines = emitTsStmt(hir.arena, f.bodyStmts[bsi], "  ", true)
        mut sli = 0
        while sli < stLines.len:
          out.push(stLines[sli])
          sli += 1
        bsi += 1
    out.push("}")
    mut matchedStruct = ""
    mut matchedMethod = ""
    mut sti = 0
    while sti < hir.structs.len:
      let stName = hir.structs[sti].name
      let pfx = stName + "_"
      if f.name.startsWith(pfx) and f.name.len > pfx.len:
        if stName.len > matchedStruct.len:
          matchedStruct = stName
          matchedMethod = f.name.slice(pfx.len, f.name.len)
      sti += 1
    if matchedStruct.len > 0 and matchedMethod.len > 0:
      out.push("(_aiplStructMethods[\"" + matchedStruct + "\"] || (_aiplStructMethods[\"" + matchedStruct + "\"] = {}))[\"" + matchedMethod + "\"] = function(..._a: any[]) { return (" + safeTsFnName(f.name) + " as any)(this, ..._a); };")
      out.push("(" + matchedStruct + " as any)[\"" + matchedMethod + "\"] = " + safeTsFnName(f.name) + ";")
    out.push("")
    fni += 1

  out.push("export const AIPL_SOURCE_LINES = " + str(source.lines().len) + ";")
  ret out.join("\n")

fn markReachableTsExpr(arena: AstArena, exprId: int, fnNameToIdx: Map[str, int], mut reachable: [bool], mut worklist: [int]): [int]:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret worklist
  let e = arena.exprs[exprId]
  if e.strVal.len > 0 and fnNameToIdx.containsKey(e.strVal):
    let fIdx = fnNameToIdx.get(e.strVal).unwrap()
    if not reachable[fIdx]:
      reachable[fIdx] = true
      worklist.push(fIdx)
  if e.kind == "Member" and e.strVal.len > 0:
    mut sdi = 0
    while sdi < arena.decls.len:
      let sd = arena.decls[sdi]
      if sd.kind == "Struct":
        let cand = sd.name + "_" + e.strVal
        if fnNameToIdx.containsKey(cand):
          let cfIdx = fnNameToIdx.get(cand).unwrap()
          if not reachable[cfIdx]:
            reachable[cfIdx] = true
            worklist.push(cfIdx)
      sdi += 1
  if e.left >= 0:
    worklist = markReachableTsExpr(arena, e.left, fnNameToIdx, reachable, worklist)
  if e.right >= 0:
    worklist = markReachableTsExpr(arena, e.right, fnNameToIdx, reachable, worklist)
  if e.cond >= 0:
    worklist = markReachableTsExpr(arena, e.cond, fnNameToIdx, reachable, worklist)
  if e.kind == "BlockIfExpr" or e.kind == "DoBlock" or (e.kind == "MatchExpr" and e.names.len == 0):
    mut ci = 0
    while ci < e.children.len:
      worklist = markReachableTsStmt(arena, e.children[ci], fnNameToIdx, reachable, worklist)
      ci += 1
  else:
    mut ci = 0
    while ci < e.children.len:
      worklist = markReachableTsExpr(arena, e.children[ci], fnNameToIdx, reachable, worklist)
      ci += 1
    if e.kind == "MatchExpr" and e.names.len > 0:
      mut ni = 0
      while ni < e.names.len:
        let pn = e.names[ni]
        if pn.contains("?"):
          let qparts = pn.split("?")
          if qparts.len > 1:
            let gId = int(qparts[1])
            if gId >= 0 and gId < arena.exprs.len:
              worklist = markReachableTsExpr(arena, gId, fnNameToIdx, reachable, worklist)
        ni += 1
  ret worklist

fn markReachableTsStmt(arena: AstArena, stmtId: int, fnNameToIdx: Map[str, int], mut reachable: [bool], mut worklist: [int]): [int]:
  if stmtId < 0 or stmtId >= arena.stmts.len:
    ret worklist
  let st = arena.stmts[stmtId]
  if st.exprId >= 0:
    worklist = markReachableTsExpr(arena, st.exprId, fnNameToIdx, reachable, worklist)
  if st.condExpr >= 0:
    worklist = markReachableTsExpr(arena, st.condExpr, fnNameToIdx, reachable, worklist)
  mut bi = 0
  while bi < st.bodyStmts.len:
    worklist = markReachableTsStmt(arena, st.bodyStmts[bi], fnNameToIdx, reachable, worklist)
    bi += 1
  mut ei = 0
  while ei < st.elseStmts.len:
    worklist = markReachableTsStmt(arena, st.elseStmts[ei], fnNameToIdx, reachable, worklist)
    ei += 1
  mut mi = 0
  while mi < st.matchArms.len:
    worklist = markReachableTsStmt(arena, st.matchArms[mi], fnNameToIdx, reachable, worklist)
    mi += 1
  ret worklist

pub fn emitJavaScriptRuntimeModule(hir: HirModule): str:
  mut out: [str] = []
  mut declaredSet: Map[str, bool] = Map.new()
  let rtHeaderText = emitTsRuntimeHeaderInternal(false)
  let rtLines = rtHeaderText.lines()
  mut rli = 0
  while rli < rtLines.len:
    let rl = rtLines[rli].trim()
    if rl.startsWith("function "):
      let rest = rl.slice(9, rl.len)
      let pIdx = rest.indexOf("(")
      if pIdx > 0:
        declaredSet.set(rest.slice(0, pIdx).trim(), true)
    elif rl.startsWith("const ") or rl.startsWith("let "):
      let kwLen = if rl.startsWith("const "): 6 else: 4
      let rest = rl.slice(kwLen, rl.len)
      let eqIdx = rest.indexOf("=")
      if eqIdx > 0:
        declaredSet.set(rest.slice(0, eqIdx).trim(), true)
    elif rl.startsWith("class "):
      let rest = rl.slice(6, rl.len)
      let spIdx = rest.indexOf(" ")
      if spIdx > 0:
        declaredSet.set(rest.slice(0, spIdx).trim(), true)
    rli += 1

  // 1. Emit top-level Const declarations & build O(1) Function Decl lookup map
  mut constNames: [str] = []
  mut constExprs: [int] = []
  mut constIdxMap: Map[str, int] = Map.new()
  mut fnDeclMap: Map[str, int] = Map.new()
  mut cdi = 0
  while cdi < hir.arena.decls.len:
    let d = hir.arena.decls[cdi]
    if d.kind == "Const" and d.name.len > 0:
      let initExprId = if d.bodyStmts.len > 0: d.bodyStmts[0] else: -1
      if constIdxMap.containsKey(d.name):
        let existingIdx = constIdxMap.get(d.name).unwrap()
        constExprs[existingIdx] = initExprId
      else:
        constIdxMap.set(d.name, constNames.len)
        constNames.push(d.name)
        constExprs.push(initExprId)
    elif (d.kind == "Function" or d.kind == "Fn") and d.name.len > 0:
      fnDeclMap.set(d.name, cdi)
    cdi += 1

  mut cni = 0
  while cni < constNames.len:
    let cname = constNames[cni]
    if not declaredSet.containsKey(cname):
      declaredSet.set(cname, true)
      let cExprId = constExprs[cni]
      let cVal = if cExprId >= 0: emitTsExpr(hir.arena, cExprId) else: "0"
      out.push("const " + cname + " = " + cVal + ";")
    cni += 1
  if constNames.len > 0:
    out.push("")

  // 2. Emit Struct constructor functions
  mut si = 0
  while si < hir.structs.len:
    let st = hir.structs[si]
    if not declaredSet.containsKey(st.name):
      declaredSet.set(st.name, true)
      mut fAssigns: [str] = []
      mut fi = 0
      while fi < st.fieldNames.len:
        let fnm = st.fieldNames[fi]
        fAssigns.push(fnm + ": " + fnm)
        fi += 1
      out.push("function " + st.name + "(" + st.fieldNames.join(", ") + ") { return _aiplStructNew(\"" + st.name + "\", { " + fAssigns.join(", ") + " }); }")
    si += 1
  if hir.structs.len > 0:
    out.push("")

  // 3. Emit Enum objects
  mut ei = 0
  while ei < hir.enums.len:
    let en = hir.enums[ei]
    if not declaredSet.containsKey(en.name):
      declaredSet.set(en.name, true)
      mut vObjProps: [str] = []
      mut vi = 0
      while vi < en.variants.len:
        let vname = en.variants[vi]
        vObjProps.push(vname + ": { tag: \"" + vname + "\", ordinal: " + str(vi) + " }")
        vi += 1
      if vObjProps.len > 0:
        out.push("const " + en.name + " = { " + vObjProps.join(", ") + " };")
    ei += 1
  if hir.enums.len > 0:
    out.push("")

  // 3b. Phase 12 (v0.4.0): Call-Graph Dead-Function Tree-Shaking
  mut fnNameToIdx: Map[str, int] = Map.new()
  mut reachable: [bool] = []
  mut rfi = 0
  while rfi < hir.functions.len:
    let fnm = hir.functions[rfi].name
    if not fnNameToIdx.containsKey(fnm):
      fnNameToIdx.set(fnm, rfi)
    reachable.push(false)
    rfi += 1

  let hasMainRoot = fnNameToIdx.containsKey("main") or fnNameToIdx.containsKey("init") or fnNameToIdx.containsKey("update") or fnNameToIdx.containsKey("render")
  if not hasMainRoot or hir.functions.len <= 16:
    mut k = 0
    while k < reachable.len:
      reachable[k] = true
      k += 1
  else:
    mut worklist: [int] = []
    let rootNames = ["main", "init", "update", "render", "update_frame", "render_frame"]
    mut rni = 0
    while rni < rootNames.len:
      let rn = rootNames[rni]
      if fnNameToIdx.containsKey(rn):
        let rIdx = fnNameToIdx.get(rn).unwrap()
        if not reachable[rIdx]:
          reachable[rIdx] = true
          worklist.push(rIdx)
      rni += 1
    mut cxi = 0
    while cxi < constExprs.len:
      if constExprs[cxi] >= 0:
        worklist = markReachableTsExpr(hir.arena, constExprs[cxi], fnNameToIdx, reachable, worklist)
      cxi += 1
    mut head = 0
    while head < worklist.len:
      let curIdx = worklist[head]
      head += 1
      let cf = hir.functions[curIdx]
      mut bsi = 0
      while bsi < cf.bodyStmts.len:
        worklist = markReachableTsStmt(hir.arena, cf.bodyStmts[bsi], fnNameToIdx, reachable, worklist)
        bsi += 1
      if fnDeclMap.containsKey(cf.name):
        let dIdx = fnDeclMap.get(cf.name).unwrap()
        let fd = hir.arena.decls[dIdx]
        mut dpi = 0
        while dpi < fd.variantPayloadTypes.len:
          if fd.variantPayloadTypes[dpi] >= 0:
            worklist = markReachableTsExpr(hir.arena, fd.variantPayloadTypes[dpi], fnNameToIdx, reachable, worklist)
          dpi += 1
        mut dbi = 0
        while dbi < fd.bodyStmts.len:
          worklist = markReachableTsStmt(hir.arena, fd.bodyStmts[dbi], fnNameToIdx, reachable, worklist)
          dbi += 1

  // 4. Emit Reachable Functions (with default parameter values and strict O(1) deduplication)
  mut fni = 0
  while fni < hir.functions.len:
    let f = hir.functions[fni]
    if reachable[fni] and not declaredSet.containsKey(f.name):
      declaredSet.set(f.name, true)
      let fnDeclIdx = if fnDeclMap.containsKey(f.name): fnDeclMap.get(f.name).unwrap() else: -1
      mut paramSpecs: [str] = []
      mut pi = 0
      while pi < f.paramNames.len:
        let pnm = f.paramNames[pi]
        if fnDeclIdx >= 0 and pi < hir.arena.decls[fnDeclIdx].variantPayloadTypes.len and hir.arena.decls[fnDeclIdx].variantPayloadTypes[pi] >= 0:
          let defCode = emitTsExpr(hir.arena, hir.arena.decls[fnDeclIdx].variantPayloadTypes[pi])
          paramSpecs.push(pnm + " = " + defCode)
        else:
          paramSpecs.push(pnm)
        pi += 1
      out.push("function " + safeTsFnName(f.name) + "(" + paramSpecs.join(", ") + ") {")
      mut bsi = 0
      while bsi < f.bodyStmts.len:
        let stLines = emitTsStmt(hir.arena, f.bodyStmts[bsi], "", false)
        mut sli = 0
        while sli < stLines.len:
          let sl = stLines[sli].trim()
          if sl.len > 0:
            out.push(sl)
          sli += 1
        bsi += 1
      out.push("}")
      mut matchedStruct = ""
      mut matchedMethod = ""
      mut sti = 0
      while sti < hir.structs.len:
        let stName = hir.structs[sti].name
        let pfx = stName + "_"
        if f.name.startsWith(pfx) and f.name.len > pfx.len:
          if stName.len > matchedStruct.len:
            matchedStruct = stName
            matchedMethod = f.name.slice(pfx.len, f.name.len)
        sti += 1
      if matchedStruct.len > 0 and matchedMethod.len > 0:
        out.push("(_aiplStructMethods[\"" + matchedStruct + "\"] || (_aiplStructMethods[\"" + matchedStruct + "\"] = {}))[\"" + matchedMethod + "\"] = function(..._a) { return " + safeTsFnName(f.name) + "(this, ..._a); };")
        out.push("if (typeof " + matchedStruct + " !== \"undefined\") " + matchedStruct + "[\"" + matchedMethod + "\"] = " + safeTsFnName(f.name) + ";")
    fni += 1
  ret out.join("\n")

pub fn emitHtml5Bundle(title: str, hir: HirModule, source: str): str:
  let jsCode = emitJavaScriptRuntimeModule(hir)
  let runtimeHeader = emitTsRuntimeHeaderInternal(false)
  mut html: [str] = []
  html.push("<!DOCTYPE html>")
  html.push("<html lang=\"en\">")
  html.push("<head>")
  html.push("  <meta charset=\"UTF-8\" />")
  html.push("  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />")
  html.push("  <meta name=\"aipl-target\" content=\"html\" />")
  html.push("  <title>" + title + "</title>")
  html.push(r"  <style>body{margin:0;background:#0f172a;color:#f8fafc;display:flex;justify-content:center;align-items:center;height:100vh;overflow:hidden;}canvas{box-shadow:0 10px 30px rgba(0,0,0,0.5);display:block;}</style>")
  html.push("</head>")
  html.push("<body>")
  html.push("  <canvas id=\"aipl-canvas\" width=\"800\" height=\"600\"></canvas>")
  html.push("  <script>")
  html.push("  if (typeof globalThis !== 'undefined') globalThis.__AIPL_TARGET_TYPE = 'html';")
  html.push("  // AIPL Module: " + hir.moduleName + " (" + str(hir.functions.len) + " functions, " + str(source.lines().len) + " lines)")
  html.push(runtimeHeader)
  html.push("")
  html.push("  // Bind active Canvas & Listeners")
  html.push("  const _domCanvas = typeof document !== 'undefined' ? document.getElementById('aipl-canvas') : null;")
  html.push("  const ctx = _domCanvas && _domCanvas.getContext ? _domCanvas.getContext('2d') : null;")
  html.push("  __aipl_canvas = _domCanvas;")
  html.push("  __aipl_ctx = ctx;")
  html.push("  if (typeof _aiplWebGL2Batcher !== 'undefined') {")
  html.push("    _aiplWebGL2Batcher.init(null, null);")
  html.push("  }")
  html.push("  __aipl_gl = _aiplWebGL2Batcher.gl;")
  html.push("  if (_domCanvas && _domCanvas.addEventListener) {")
  html.push("    _domCanvas.addEventListener('mousemove', (e) => {")
  html.push("      const r = _domCanvas.getBoundingClientRect ? _domCanvas.getBoundingClientRect() : { left: 0, top: 0, width: _domCanvas.width, height: _domCanvas.height };")
  html.push("      const sx = r.width > 0 ? (_domCanvas.width / r.width) : 1.0;")
  html.push("      const sy = r.height > 0 ? (_domCanvas.height / r.height) : 1.0;")
  html.push("      __aipl_mouse_x = ((e.clientX || 0) - r.left) * sx;")
  html.push("      __aipl_mouse_y = ((e.clientY || 0) - r.top) * sy;")
  html.push("    });")
  html.push("    _domCanvas.addEventListener('mousedown', (e) => {")
  html.push("      const b = e.button || 0;")
  html.push("      if (!__aipl_mouse_down[b]) __aipl_mouse_just_pressed[b] = true;")
  html.push("      __aipl_mouse_down[b] = true;")
  html.push("    });")
  html.push("    _domCanvas.addEventListener('mouseup', (e) => {")
  html.push("      const b = e.button || 0;")
  html.push("      __aipl_mouse_down[b] = false;")
  html.push("      __aipl_mouse_just_released[b] = true;")
  html.push("    });")
  html.push("    _domCanvas.addEventListener('wheel', (e) => {")
  html.push("      __aipl_mouse_wheel_y = e.deltaY ? (e.deltaY < 0 ? 1 : -1) : 0;")
  html.push("    });")
  html.push("  }")
  html.push("")
  html.push("  window.addEventListener('resize', _aiplFitCanvasToWindow);")
  html.push("  _aiplFitCanvasToWindow();")
  html.push("  window.addEventListener('keydown', (e) => {")
  html.push("    const k = e.key.toLowerCase();")
  html.push("    if (!__aipl_keys_down[k]) {")
  html.push("      __aipl_keys_just_pressed[k] = true;")
  html.push("      __aipl_keys_just_pressed[e.key] = true;")
  html.push("    }")
  html.push("    __aipl_keys_down[k] = true;")
  html.push("    __aipl_keys_down[e.key] = true;")
  html.push("    __aipl_key_events.push({ key: e.key, kind: 'down', code: e.code });")
  html.push("  });")
  html.push("  window.addEventListener('keyup', (e) => {")
  html.push("    const k = e.key.toLowerCase();")
  html.push("    __aipl_keys_down[k] = false;")
  html.push("    __aipl_keys_down[e.key] = false;")
  html.push("    __aipl_key_events.push({ key: e.key, kind: 'up', code: e.code });")
  html.push("  });")
  html.push("  window.addEventListener('dragover', (e) => e.preventDefault());")
  html.push("  window.addEventListener('drop', (e) => {")
  html.push("    e.preventDefault();")
  html.push("    if (e.dataTransfer && e.dataTransfer.files) {")
  html.push("      for (let i = 0; i < e.dataTransfer.files.length; i++) {")
  html.push("        const file = e.dataTransfer.files[i];")
  html.push("        const reader = new FileReader();")
  html.push("        reader.onload = () => {")
  html.push("          __aipl_file_drops.push({ name: file.name, size: file.size, data: new Uint8Array(reader.result) });")
  html.push("        };")
  html.push("        reader.readAsArrayBuffer(file);")
  html.push("      }")
  html.push("    }")
  html.push("  });")
  html.push("")
  html.push(jsCode)
  html.push("")
  html.push("  // Start Lifecycle Loop")
  html.push("  startAiplLifecycle();")
  html.push("  </script>")
  html.push("</body>")
  html.push("</html>")
  ret html.join("\n")

pub fn emitWasmHtml5Bundle(title: str, hir: HirModule, source: str, wasmHostScript: str): str:
  let jsCode = emitJavaScriptRuntimeModule(hir)
  let runtimeHeader = emitTsRuntimeHeaderInternal(false)
  mut html: [str] = []
  html.push("<!DOCTYPE html>")
  html.push("<html lang=\"en\">")
  html.push("<head>")
  html.push("  <meta charset=\"UTF-8\" />")
  html.push("  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />")
  html.push("  <meta name=\"aipl-target\" content=\"wasm\" />")
  html.push("  <title>" + (if title.contains("[WASM]") or title.contains("[HTML]"): title else: title + " [WASM]") + "</title>")
  html.push(r"  <style>body{margin:0;background:#0f172a;color:#f8fafc;display:flex;justify-content:center;align-items:center;height:100vh;overflow:hidden;}canvas{box-shadow:0 10px 30px rgba(0,0,0,0.5);display:block;}</style>")
  html.push("</head>")
  html.push("<body>")
  html.push("  <canvas id=\"aipl-canvas\" width=\"800\" height=\"600\"></canvas>")
  html.push("  <script>")
  html.push("  if (typeof globalThis !== 'undefined') globalThis.__AIPL_TARGET_TYPE = 'wasm';")
  html.push("  // AIPL WebAssembly + HTML5 Host Bundle: " + hir.moduleName + " (" + str(hir.functions.len) + " functions, " + str(source.lines().len) + " lines)")
  html.push(runtimeHeader)
  html.push("")
  html.push(wasmHostScript)
  html.push("")
  html.push("  // Bind active Canvas & Listeners")
  html.push("  const _domCanvas = typeof document !== 'undefined' ? document.getElementById('aipl-canvas') : null;")
  html.push("  const ctx = _domCanvas && _domCanvas.getContext ? _domCanvas.getContext('2d') : null;")
  html.push("  __aipl_canvas = _domCanvas;")
  html.push("  __aipl_ctx = ctx;")
  html.push("  if (typeof _aiplWebGL2Batcher !== 'undefined') {")
  html.push("    _aiplWebGL2Batcher.init(null, null);")
  html.push("  }")
  html.push("  __aipl_gl = _aiplWebGL2Batcher.gl;")
  html.push("  if (_domCanvas && _domCanvas.addEventListener) {")
  html.push("    _domCanvas.addEventListener('mousemove', (e) => {")
  html.push("      const r = _domCanvas.getBoundingClientRect ? _domCanvas.getBoundingClientRect() : { left: 0, top: 0, width: _domCanvas.width, height: _domCanvas.height };")
  html.push("      const sx = r.width > 0 ? (_domCanvas.width / r.width) : 1.0;")
  html.push("      const sy = r.height > 0 ? (_domCanvas.height / r.height) : 1.0;")
  html.push("      __aipl_mouse_x = ((e.clientX || 0) - r.left) * sx;")
  html.push("      __aipl_mouse_y = ((e.clientY || 0) - r.top) * sy;")
  html.push("    });")
  html.push("    _domCanvas.addEventListener('mousedown', (e) => {")
  html.push("      const b = e.button || 0;")
  html.push("      if (!__aipl_mouse_down[b]) __aipl_mouse_just_pressed[b] = true;")
  html.push("      __aipl_mouse_down[b] = true;")
  html.push("    });")
  html.push("    _domCanvas.addEventListener('mouseup', (e) => {")
  html.push("      const b = e.button || 0;")
  html.push("      __aipl_mouse_down[b] = false;")
  html.push("      __aipl_mouse_just_released[b] = true;")
  html.push("    });")
  html.push("    _domCanvas.addEventListener('wheel', (e) => {")
  html.push("      __aipl_mouse_wheel_y = e.deltaY ? (e.deltaY < 0 ? 1 : -1) : 0;")
  html.push("    });")
  html.push("  }")
  html.push("")
  html.push("  window.addEventListener('resize', _aiplFitCanvasToWindow);")
  html.push("  _aiplFitCanvasToWindow();")
  html.push("  window.addEventListener('keydown', (e) => {")
  html.push("    const k = e.key.toLowerCase();")
  html.push("    if (!__aipl_keys_down[k]) {")
  html.push("      __aipl_keys_just_pressed[k] = true;")
  html.push("      __aipl_keys_just_pressed[e.key] = true;")
  html.push("    }")
  html.push("    __aipl_keys_down[k] = true;")
  html.push("    __aipl_keys_down[e.key] = true;")
  html.push("    __aipl_key_events.push({ key: e.key, kind: 'down', code: e.code });")
  html.push("  });")
  html.push("  window.addEventListener('keyup', (e) => {")
  html.push("    const k = e.key.toLowerCase();")
  html.push("    __aipl_keys_down[k] = false;")
  html.push("    __aipl_keys_down[e.key] = false;")
  html.push("    __aipl_key_events.push({ key: e.key, kind: 'up', code: e.code });")
  html.push("  });")
  html.push("  window.addEventListener('dragover', (e) => e.preventDefault());")
  html.push("  window.addEventListener('drop', (e) => {")
  html.push("    e.preventDefault();")
  html.push("    if (e.dataTransfer && e.dataTransfer.files) {")
  html.push("      for (let i = 0; i < e.dataTransfer.files.length; i++) {")
  html.push("        const file = e.dataTransfer.files[i];")
  html.push("        const reader = new FileReader();")
  html.push("        reader.onload = () => {")
  html.push("          __aipl_file_drops.push({ name: file.name, size: file.size, data: new Uint8Array(reader.result) });")
  html.push("        };")
  html.push("        reader.readAsArrayBuffer(file);")
  html.push("      }")
  html.push("    }")
  html.push("  });")
  html.push("")
  html.push(jsCode)
  html.push("")
  html.push("  // Start Lifecycle Loop")
  html.push("  startAiplLifecycle();")
  html.push("  </script>")
  html.push("</body>")
  html.push("</html>")
  ret html.join("\n")

pub fn emitTsWebGpuComputeDispatcher(pipeName: str, wgX: int, wgY: int, wgZ: int, sharedMemFloats: int, wgslCode: str): str:
  let x = if wgX > 0: wgX else: 16
  let y = if wgY > 0: wgY else: 16
  let z = if wgZ > 0: wgZ else: 1
  let smBytes = sharedMemFloats * 4

  mut lines: [str] = []
  lines.push("// --- WebGPU Compute Pass Dispatcher: " + pipeName + " ---")
  lines.push("export async function dispatch_" + pipeName + "(device: any, inBuffer: any, outBuffer: any, gridW: number, gridH: number) {")
  lines.push("  const wgsl = " + escapeTsStringLiteral(wgslCode) + ";")
  lines.push("  const module = device.createShaderModule({ code: wgsl });")
  lines.push("  const pipeline = await device.createComputePipelineAsync({")
  lines.push("    layout: 'auto',")
  lines.push("    compute: { module, entryPoint: 'main' }")
  lines.push("  });")
  lines.push("  const bindGroup = device.createBindGroup({")
  lines.push("    layout: pipeline.getBindGroupLayout(0),")
  lines.push("    entries: [")
  lines.push("      { binding: 0, resource: { buffer: inBuffer } },")
  lines.push("      { binding: 1, resource: { buffer: outBuffer } }")
  lines.push("    ]")
  lines.push("  });")
  lines.push("  const encoder = device.createCommandEncoder();")
  lines.push("  const pass = encoder.beginComputePass();")
  lines.push("  pass.setPipeline(pipeline);")
  lines.push("  pass.setBindGroup(0, bindGroup);")
  lines.push("  const countX = Math.ceil(gridW / " + str(x) + ");")
  lines.push("  const countY = Math.ceil(gridH / " + str(y) + ");")
  lines.push("  pass.dispatchWorkgroups(countX, countY, " + str(z) + ");")
  lines.push("  pass.end();")
  lines.push("  device.queue.submit([encoder.finish()]);")
  lines.push("  return {")
  lines.push("    pipeline: '" + pipeName + "',")
  lines.push("    workgroupSize: [" + str(x) + ", " + str(y) + ", " + str(z) + "],")
  lines.push("    sharedMemBytes: " + str(smBytes) + ",")
  lines.push("    dispatchedGroupsX: countX,")
  lines.push("    dispatchedGroupsY: countY,")
  lines.push("    totalGroups: countX * countY")
  lines.push("  };")
  lines.push("}")
  ret lines.join("\n")

// ============================================================================
// Step 21.4: Mobile Viewport, Touch Bridge & Single-File HTML5 Android Bundle
// ============================================================================

pub fn emitMobileViewportMetaTag(lockZoom: bool, viewportFitCover: bool, initialScalePercent: int = 100): str requires initialScalePercent >= 50 and initialScalePercent <= 200 ensures result.startsWith("<meta name=\"viewport\"") and result.endsWith("\">"):
  let scaleStr = if initialScalePercent == 100: "1.0" else: str(initialScalePercent / 100) + "." + str((initialScalePercent % 100) / 10)
  mut parts: [str] = ["width=device-width", "initial-scale=" + scaleStr]
  if lockZoom:
    let maxStr = if initialScalePercent == 100: "1.0" else: scaleStr
    parts.push("maximum-scale=" + maxStr)
    parts.push("user-scalable=no")
  if viewportFitCover:
    parts.push("viewport-fit=cover")
  ret "<meta name=\"viewport\" content=\"" + parts.join(", ") + "\">"

pub fn emitDomTouchAndPointerBridgeJs(canvasId: str): str requires canvasId.len() >= 0 ensures result.contains("touchstart") and result.contains("touchcancel") and result.contains("PointerEvent"):
  let cid = if canvasId.len() > 0: canvasId else: "aipl-canvas"
  ret r"const cv=document.getElementById('" + cid + r"');['touchstart','touchmove','touchend','touchcancel'].forEach(ev=>cv.addEventListener(ev,e=>{e.preventDefault();},{passive:false}));if(window.PointerEvent){cv.addEventListener('pointerdown',e=>__aiplPointer(0,e.pointerId,e.clientX,e.clientY));}"

pub fn upgradeHtml5BundleForAndroidWebView(appTitle: str, compiledJsBody: str): str requires appTitle.len() >= 0 and compiledJsBody.len() >= 0 ensures result.startsWith("<!DOCTYPE html>") and result.endsWith("</html>"):
  let safeTitle = if appTitle.len() > 0: appTitle else: "AIPL Mobile App"
  let meta = emitMobileViewportMetaTag(true, true, 100)
  let css = r"<style>html,body,canvas{margin:0;padding:0;touch-action:none;user-select:none;background:#020306;}</style>"
  let touchJs = r"['touchstart','touchmove','touchend','touchcancel'].forEach(k=>window.addEventListener(k,e=>e.preventDefault(),{passive:false}));"
  ret "<!DOCTYPE html><html><head><title>" + safeTitle + "</title>" + meta + css + "</head><body><canvas id=\"aipl-canvas\"></canvas><script>" + touchJs + compiledJsBody + "</script></body></html>"
