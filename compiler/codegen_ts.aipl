module CompilerCodegenTs

import { AstArena } from "./ast.aipl"
import { HirModule, HirStruct, HirEnum, HirFunction, resolveTypeName } from "./hir.aipl"
import { generateStructJsonSchema, generateEnumJsonSchema } from "./types.aipl"

// ============================================================================
// Step 15.4 (Part 3) & Step C3.2: Self-Hosted TypeScript & HTML5 Bundler
// ============================================================================

pub fn mapAiplTypeToTs(ty: str): str:
  if ty == "int" or ty == "float":
    ret "number"
  if ty == "bool":
    ret "boolean"
  if ty == "str":
    ret "string"
  if ty == "bytes":
    ret "Uint8Array"
  if ty == "void":
    ret "void"
  if ty.startsWith("Array[") and ty.endsWith("]"):
    let inner = ty.slice(6, ty.len - 1)
    ret "Array<" + mapAiplTypeToTs(inner) + ">"
  if ty.startsWith("Map[") and ty.endsWith("]"):
    ret "Map<any, any>"
  if ty.startsWith("Set[") and ty.endsWith("]"):
    ret "Set<any>"
  if ty.startsWith("Option[") and ty.endsWith("]"):
    let inner = ty.slice(7, ty.len - 1)
    ret "(" + mapAiplTypeToTs(inner) + " | null)"
  ret "any"

fn escapeTsStringLiteral(s: str): str:
  mut out = s.replace("\\", "\\\\")
  out = out.replace("\"", "\\\"")
  out = out.replace("\n", "\\n")
  out = out.replace("\r", "\\r")
  out = out.replace("\t", "\\t")
  ret "\"" + out + "\""

fn safeTsFnName(name: str): str:
  if name == "new" or name == "delete" or name == "default" or name == "class" or name == "import" or name == "export" or name == "switch" or name == "case" or name == "in":
    ret "_aipl_fn_" + name
  ret name

fn isEnumName(arena: AstArena, name: str): bool:
  if name.len == 0 or name.charCodeAt(0) < 65 or name.charCodeAt(0) > 90:
    ret false
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if d.kind == "Enum" and d.name == name:
      ret true
    i += 1
  ret false

fn isEnumVariant(arena: AstArena, enumName: str, variantName: str): bool:
  if variantName.len == 0 or variantName.charCodeAt(0) < 65 or variantName.charCodeAt(0) > 90:
    ret false
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if d.kind == "Enum" and (enumName.len == 0 or d.name == enumName):
      mut vi = 0
      while vi < d.variants.len:
        if d.variants[vi] == variantName:
          ret true
        vi += 1
    i += 1
  ret false

fn lookupEnumVariantIndex(arena: AstArena, enumName: str, variantName: str): int:
  if variantName.len == 0 or variantName.charCodeAt(0) < 65 or variantName.charCodeAt(0) > 90:
    ret -1
  mut i = 0
  while i < arena.decls.len:
    let d = arena.decls[i]
    if d.kind == "Enum" and (enumName.len == 0 or d.name == enumName):
      mut vi = 0
      while vi < d.variants.len:
        if d.variants[vi] == variantName:
          ret vi
        vi += 1
    i += 1
  ret -1

fn emitTsMatchArmCondition(targetStr: str, armName: str): str:
  if armName == "None":
    ret "((" + targetStr + ") === null || (" + targetStr + ") === undefined || (" + targetStr + ") === 'None' || (" + targetStr + ")?.tag === 'None' || (" + targetStr + ")?.tag === 'Option::None')"
  if armName == "Ok":
    ret "((" + targetStr + ") != null && ((" + targetStr + ")?.ok === true || (" + targetStr + ")?.tag === 'Ok'))"
  if armName == "Err":
    ret "((" + targetStr + ") != null && ((" + targetStr + ")?.ok === false || (" + targetStr + ")?.tag === 'Err'))"
  if armName == "Some":
    ret "((" + targetStr + ") != null && (" + targetStr + ") !== 'None' && (" + targetStr + ")?.tag !== 'None' && (" + targetStr + ")?.tag !== 'Option::None' && ((" + targetStr + ")?.ok === true || (" + targetStr + ")?.tag === 'Some' || typeof (" + targetStr + ") !== 'object' || 'value' in (" + targetStr + ")))"
  if armName == "true" or armName == "false":
    ret "((" + targetStr + ") === " + armName + ")"
  if armName.len > 0 and ((armName[0] >= "0" and armName[0] <= "9") or (armName.len > 1 and armName[0] == "-" and armName[1] >= "0" and armName[1] <= "9")):
    ret "((" + targetStr + ") === " + armName + ")"
  if armName.contains("::"):
    let parts = armName.split("::")
    let varName = if parts.len > 1: parts[1] else: armName
    ret "((" + targetStr + ") === " + escapeTsStringLiteral(armName) + " || (" + targetStr + ") === " + escapeTsStringLiteral(varName) + " || (" + targetStr + ")?.tag === " + escapeTsStringLiteral(armName) + " || (" + targetStr + ")?.tag === " + escapeTsStringLiteral(varName) + ")"
  ret "((" + targetStr + ") === " + escapeTsStringLiteral(armName) + " || (" + targetStr + ")?.tag === " + escapeTsStringLiteral(armName) + ")"

fn mapBinaryOpToTs(op: str): str:
  if op == "and":
    ret "&&"
  if op == "or":
    ret "||"
  if op == "==":
    ret "==="
  if op == "!=":
    ret "!=="
  ret op

fn isTsFloatExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "FloatLit":
    ret true
  if e.kind == "Unary":
    ret isTsFloatExpr(arena, e.left)
  if e.kind == "Binary":
    if e.op == "+" or e.op == "-" or e.op == "*" or e.op == "/":
      ret isTsFloatExpr(arena, e.left) or isTsFloatExpr(arena, e.right)
  if e.kind == "Cast":
    let tgt = e.strVal
    if tgt == "float" or tgt == "f64" or tgt == "f32":
      ret true
  if e.kind == "Member":
    let mf = e.strVal
    if mf == "f" or mf == "x" or mf == "y" or mf == "w" or mf == "h" or mf == "r" or mf == "g" or mf == "b" or mf == "a" or mf == "radiusSm" or mf == "radiusMd" or mf == "radiusLg" or mf == "mouseX" or mf == "mouseY" or mf == "wheelY" or mf == "cursorX" or mf == "cursorY":
      ret true
  if e.kind == "Call":
    if e.left >= 0 and arena.exprs[e.left].kind == "Ident":
      let cname = arena.exprs[e.left].strVal
      if cname == "float" or cname == "sqrt" or cname == "sin" or cname == "cos" or cname == "tan" or cname == "atan2" or cname == "absFloat" or cname == "minFloat" or cname == "maxFloat" or cname == "clampFloat" or cname == "lerp" or cname == "measureTextWidth" or cname == "measureTextHeight" or cname == "getFrameTime" or cname == "getDeltaTime":
        ret true
  ret false

fn isPossibleVecExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "Call":
    if e.left >= 0 and arena.exprs[e.left].kind == "Ident":
      let cn = arena.exprs[e.left].strVal
      ret cn == "Vec2" or cn == "Vec3"
    ret false
  if e.kind == "Ident":
    let nm = e.strVal
    ret nm == "v1" or nm == "v2" or nm == "v3" or nm == "u1" or nm == "u2" or nm == "u3"
  if e.kind == "Binary":
    ret isPossibleVecExpr(arena, e.left) or isPossibleVecExpr(arena, e.right)
  ret false

fn isPossibleBigIntExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "Call":
    if e.left >= 0 and arena.exprs[e.left].kind == "Ident":
      let cn = arena.exprs[e.left].strVal
      ret cn == "bitcastF64ToI64" or cn == "sysBitcastF64ToI64"
    ret false
  if e.kind == "Binary":
    let op = e.op
    if op == "<<" or op == ">>" or op == "&" or op == "|" or op == "^":
      ret true
    ret isPossibleBigIntExpr(arena, e.left) or isPossibleBigIntExpr(arena, e.right)
  ret false

fn isTsScalarExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let k = arena.exprs[exprId].kind
  if k == "IntLit" or k == "FloatLit" or k == "BoolLit":
    ret true
  if k == "Unary":
    ret isTsScalarExpr(arena, arena.exprs[exprId].left)
  if k == "Binary":
    let b = arena.exprs[exprId]
    if b.op == "==" or b.op == "!=" or b.op == "<" or b.op == "<=" or b.op == ">" or b.op == ">=" or b.op == "%" or b.op == "%%" or b.op == "&" or b.op == "|" or b.op == "^" or b.op == "<<" or b.op == ">>":
      ret true
    if not isPossibleVecExpr(arena, b.left) and not isPossibleVecExpr(arena, b.right):
      if b.op == "-" or b.op == "*" or b.op == "/":
        ret true
    if isTsScalarExpr(arena, b.left) and isTsScalarExpr(arena, b.right):
      ret true
  if k == "Cast":
    let tgt = arena.exprs[exprId].strVal
    if tgt == "int" or tgt == "float" or tgt == "f64" or tgt == "f32" or tgt == "i64" or tgt == "i32" or tgt == "u8" or tgt == "u16" or tgt == "u32" or tgt == "u64" or tgt == "byte":
      ret true
  if k == "Member":
    let m = arena.exprs[exprId].strVal
    if m == "f" or m == "i" or m == "len" or m == "length" or m == "width" or m == "height" or m == "x" or m == "y" or m == "w" or m == "h" or m == "r" or m == "g" or m == "b" or m == "a" or m == "size" or m == "activeCount" or m == "tickCount" or m == "frameCount" or m == "currentParity" or m == "radiusSm" or m == "radiusMd" or m == "radiusLg" or m == "mouseX" or m == "mouseY" or m == "wheelY" or m == "cursorX" or m == "cursorY" or m == "activeNav" or m == "activeSubTab" or m == "themeIdx" or m == "pageIdx" or m == "pageSize" or m == "score" or m == "hp" or m == "mp" or m == "gold" or m == "lumber" or m == "mana" or m == "ammo" or m == "armor" or m == "money" or m == "arr" or m == "probability" or m == "daysInStage" or m == "healthScore":
      ret true
  if k == "Index":
    let idxLeft = arena.exprs[exprId].left
    if idxLeft >= 0 and arena.exprs[idxLeft].kind == "Member":
      ret true
  if k == "Call":
    if arena.exprs[exprId].left >= 0 and arena.exprs[arena.exprs[exprId].left].kind == "Ident":
      let cname = arena.exprs[arena.exprs[exprId].left].strVal
      if cname == "int" or cname == "float" or cname == "len" or cname == "popcnt" or cname == "bitboardPopcnt64" or cname == "minInt" or cname == "maxInt" or cname == "clampInt" or cname == "minFloat" or cname == "maxFloat" or cname == "clampFloat" or cname == "clamp" or cname == "abs" or cname == "absInt" or cname == "absFloat" or cname == "floor" or cname == "ceil" or cname == "round" or cname == "sin" or cname == "cos" or cname == "tan" or cname == "sqrt" or cname == "pow" or cname == "atan2" or cname == "packRgb" or cname == "unpackR" or cname == "unpackG" or cname == "unpackB" or cname == "lerpColor" or cname == "hashRng" or cname == "measureTextWidth" or cname == "measureTextHeight" or cname == "getScreenWidth" or cname == "getScreenHeight" or cname == "getWindowWidth" or cname == "getWindowHeight" or cname == "getMouseX" or cname == "getMouseY" or cname == "mouseWheelY" or cname == "getFrameTime" or cname == "getDeltaTime" or cname == "getFps":
        ret true
  ret false

pub fn isTsFoldableIntExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "IntLit" or e.kind == "Int":
    if e.strVal.len > 15 or e.strVal == "-9223372036854775808" or e.strVal.startsWith("0x") or e.strVal.startsWith("0X"):
      ret false
    ret true
  if e.kind == "Unary":
    if e.op == "-" or e.op == "~":
      ret isTsFoldableIntExpr(arena, e.left)
    ret false
  if e.kind == "Binary":
    let op = e.op
    if op == "+" or op == "-" or op == "*" or op == "%" or op == "&" or op == "|" or op == "^" or op == "<<" or op == ">>":
      if not isTsFoldableIntExpr(arena, e.left) or not isTsFoldableIntExpr(arena, e.right):
        ret false
      let lv = evalTsFoldableIntExpr(arena, e.left)
      let rv = evalTsFoldableIntExpr(arena, e.right)
      if op == "%":
        if rv == 0:
          ret false
      if op == "<<" or op == ">>":
        if rv < 0 or rv > 30:
          ret false
      if op == "*":
        if lv < -10000000 or lv > 10000000 or rv < -10000000 or rv > 10000000:
          ret false
      ret true
  ret false

pub fn evalTsFoldableIntExpr(arena: AstArena, exprId: int): int:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret 0
  let e = arena.exprs[exprId]
  if e.kind == "IntLit" or e.kind == "Int":
    ret e.intVal
  if e.kind == "Unary":
    let lv = evalTsFoldableIntExpr(arena, e.left)
    if e.op == "-":
      ret -lv
    if e.op == "~":
      ret ~lv
    ret lv
  if e.kind == "Binary":
    let lv = evalTsFoldableIntExpr(arena, e.left)
    let rv = evalTsFoldableIntExpr(arena, e.right)
    let op = e.op
    if op == "+": ret lv + rv
    if op == "-": ret lv - rv
    if op == "*": ret lv * rv
    if op == "%": ret if rv != 0: lv % rv else: 0
    if op == "&": ret lv & rv
    if op == "|": ret lv | rv
    if op == "^": ret lv ^ rv
    if op == "<<": ret lv << rv
    if op == ">>": ret lv >> rv
  ret 0

pub fn isTsSideEffectFreeScalarIdentOrLit(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "IntLit" or e.kind == "Int" or e.kind == "FloatLit":
    ret true
  if e.kind == "Ident":
    if isPossibleVecExpr(arena, exprId):
      ret false
    ret true
  ret false

pub fn isTsSameScalarIdent(arena: AstArena, leftId: int, rightId: int): bool:
  if leftId < 0 or leftId >= arena.exprs.len or rightId < 0 or rightId >= arena.exprs.len:
    ret false
  let l = arena.exprs[leftId]
  let r = arena.exprs[rightId]
  if l.kind == "Ident" and r.kind == "Ident" and l.strVal == r.strVal and l.strVal.len > 0:
    if isPossibleVecExpr(arena, leftId):
      ret false
    ret true
  ret false

pub fn isTsFloatZeroLitExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  ret e.kind == "FloatLit" and (e.strVal == "0.0" or e.strVal == "0" or e.strVal == "0.00")

pub fn isTsFloatOneLitExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  ret e.kind == "FloatLit" and (e.strVal == "1.0" or e.strVal == "1" or e.strVal == "1.00")

pub fn isTsFloatCastOrLitExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "FloatLit":
    ret true
  if e.kind == "Cast":
    let t = e.strVal
    ret t == "float" or t == "f64" or t == "f32"
  if e.kind == "Call" and e.children.len == 1 and e.left >= 0 and e.left < arena.exprs.len:
    let ce = arena.exprs[e.left]
    if ce.kind == "Ident" and ce.strVal == "float":
      ret true
  ret false

pub fn isTsIntCastOrLitExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "IntLit" or e.kind == "Int":
    ret true
  if e.kind == "Cast":
    let t = e.strVal
    ret t == "int" or t == "i64" or t == "i32"
  if e.kind == "Call" and e.children.len == 1 and e.left >= 0 and e.left < arena.exprs.len:
    let ce = arena.exprs[e.left]
    if ce.kind == "Ident" and ce.strVal == "int":
      ret true
  ret false

pub fn isTsBoolTrueLitExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "BoolLit":
    ret e.boolVal
  if e.kind == "Ident" and e.strVal == "true":
    ret true
  ret false

pub fn isTsBoolFalseLitExpr(arena: AstArena, exprId: int): bool:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret false
  let e = arena.exprs[exprId]
  if e.kind == "BoolLit":
    ret not e.boolVal
  if e.kind == "Ident" and e.strVal == "false":
    ret true
  ret false

pub fn emitTsExpr(arena: AstArena, exprId: int): str:
  if exprId < 0 or exprId >= arena.exprs.len:
    ret "undefined"
  let e = arena.exprs[exprId]
  if e.kind == "Unwrap":
    let uInner = emitTsExpr(arena, e.left)
    if e.intVal >= 0:
      ret "((_u) => { const _v = (_u && typeof _u === 'object') ? ('value' in _u ? _u.value : ('error' in _u ? _u.error : _u)) : _u; return Array.isArray(_v) ? _v[" + str(e.intVal) + "] : _v; })(" + uInner + ")"
    ret "((_u) => (_u && typeof _u === 'object') ? ('value' in _u ? _u.value : ('error' in _u ? _u.error : _u)) : _u)(" + uInner + ")"
  if e.kind == "IntLit":
    ret str(e.intVal)
  if e.kind == "FloatLit":
    ret e.strVal
  if e.kind == "Ident":
    if e.strVal == "None" or e.strVal == "nil":
      ret "null"
    if e.strVal == "true":
      ret "true"
    if e.strVal == "false":
      ret "false"
    ret e.strVal
  if e.kind == "BoolLit":
    if e.boolVal:
      ret "true"
    ret "false"
  if e.kind == "WideningCast":
    ret "Number(" + emitTsExpr(arena, e.left) + ")"
  if e.kind == "NilLit":
    ret "null"
  if e.kind == "STRING" or e.kind == "RAW_STRING":
    ret escapeTsStringLiteral(e.strVal)
  if e.kind == "INTERP_STRING":
    let raw = e.strVal
    if not raw.contains("{") or not raw.contains("}"):
      ret escapeTsStringLiteral(raw)
    mut parts: [str] = []
    mut curStart = 0
    mut si = 0
    while si < raw.len:
      if si + 1 < raw.len and raw.charCodeAt(si) == 92 and (raw.charCodeAt(si + 1) == 123 or raw.charCodeAt(si + 1) == 125):
        si += 2
        continue
      if raw.charCodeAt(si) == 123 and si + 1 < raw.len:
        let fc = raw.charCodeAt(si + 1)
        if (fc >= 65 and fc <= 90) or (fc >= 97 and fc <= 122) or fc == 95:
          let closeIdx = raw.indexOf("}", si + 1)
          if closeIdx > si + 1:
            let inner = raw.slice(si + 1, closeIdx)
            if not inner.contains("\n") and not inner.contains(":") and not inner.contains("\"") and not inner.contains("{"):
              if si > curStart:
                parts.push(escapeTsStringLiteral(raw.slice(curStart, si)))
              parts.push("String(" + inner + ")")
              si = closeIdx + 1
              curStart = si
              continue
      si += 1
    if parts.len == 0:
      ret escapeTsStringLiteral(raw)
    if curStart < raw.len:
      parts.push(escapeTsStringLiteral(raw.slice(curStart, raw.len)))
    ret "(" + parts.join(" + ") + ")"
  if e.kind == "Unary":
    if (e.op == "-" or e.op == "~") and isTsFoldableIntExpr(arena, exprId):
      ret str(evalTsFoldableIntExpr(arena, exprId))
    if e.op == "-" and e.left >= 0 and e.left < arena.exprs.len and arena.exprs[e.left].kind == "FloatLit":
      ret "-" + arena.exprs[e.left].strVal
    if (e.op == "not" or e.op == "!") and e.left >= 0 and e.left < arena.exprs.len:
      let innerU = arena.exprs[e.left]
      if innerU.kind == "Unary" and (innerU.op == "not" or innerU.op == "!"):
        ret emitTsExpr(arena, innerU.left)
      if isTsBoolTrueLitExpr(arena, e.left):
        ret "false"
      if isTsBoolFalseLitExpr(arena, e.left):
        ret "true"
    let uOp = if e.op == "not": "!" else: e.op
    ret "(" + uOp + emitTsExpr(arena, e.left) + ")"
  if e.kind == "Binary":
    if isTsFoldableIntExpr(arena, exprId):
      ret str(evalTsFoldableIntExpr(arena, exprId))
    if e.op == "and" or e.op == "&&":
      if isTsBoolTrueLitExpr(arena, e.right):
        ret emitTsExpr(arena, e.left)
      if isTsBoolTrueLitExpr(arena, e.left):
        ret emitTsExpr(arena, e.right)
    if e.op == "or" or e.op == "||":
      if isTsBoolFalseLitExpr(arena, e.right):
        ret emitTsExpr(arena, e.left)
      if isTsBoolFalseLitExpr(arena, e.left):
        ret emitTsExpr(arena, e.right)
    if e.op == "+":
      if isTsFloatZeroLitExpr(arena, e.right):
        ret emitTsExpr(arena, e.left)
      if isTsFloatZeroLitExpr(arena, e.left):
        ret emitTsExpr(arena, e.right)
    if e.op == "-":
      if isTsFoldableIntExpr(arena, e.right) and evalTsFoldableIntExpr(arena, e.right) == 0:
        ret emitTsExpr(arena, e.left)
      if isTsFloatZeroLitExpr(arena, e.right):
        ret emitTsExpr(arena, e.left)
      if isTsSameScalarIdent(arena, e.left, e.right):
        ret "0"
    if e.op == "*":
      if isTsFoldableIntExpr(arena, e.right) and evalTsFoldableIntExpr(arena, e.right) == 0 and isTsSideEffectFreeScalarIdentOrLit(arena, e.left):
        ret "0"
      if isTsFoldableIntExpr(arena, e.left) and evalTsFoldableIntExpr(arena, e.left) == 0 and isTsSideEffectFreeScalarIdentOrLit(arena, e.right):
        ret "0"
      if isTsFoldableIntExpr(arena, e.right) and evalTsFoldableIntExpr(arena, e.right) == 1:
        ret emitTsExpr(arena, e.left)
      if isTsFoldableIntExpr(arena, e.left) and evalTsFoldableIntExpr(arena, e.left) == 1:
        ret emitTsExpr(arena, e.right)
      if isTsFloatOneLitExpr(arena, e.right):
        ret emitTsExpr(arena, e.left)
      if isTsFloatOneLitExpr(arena, e.left):
        ret emitTsExpr(arena, e.right)
    if e.op == "/":
      if isTsFoldableIntExpr(arena, e.right) and evalTsFoldableIntExpr(arena, e.right) == 1:
        ret emitTsExpr(arena, e.left)
      if e.right >= 0 and e.right < arena.exprs.len and arena.exprs[e.right].kind == "FloatLit" and (arena.exprs[e.right].strVal == "1.0" or arena.exprs[e.right].strVal == "1"):
        ret emitTsExpr(arena, e.left)
    if e.op == "|>":
      let l = emitTsExpr(arena, e.left)
      if e.right >= 0 and arena.exprs[e.right].kind == "Call":
        let rc = arena.exprs[e.right]
        let calleeStr = emitTsExpr(arena, rc.left)
        if calleeStr == "int":
          ret "Math.trunc(Number(" + l + "))"
        if calleeStr == "float":
          ret "Number(" + l + ")"
        if calleeStr == "str":
          ret "String(" + l + ")"
        if calleeStr == "bool":
          ret "Boolean(" + l + ")"
        mut callArgs: [str] = [l]
        mut ci = 0
        while ci < rc.children.len:
          callArgs.push(emitTsExpr(arena, rc.children[ci]))
          ci += 1
        ret calleeStr + "(" + callArgs.join(", ") + ")"
      let r = emitTsExpr(arena, e.right)
      ret "(" + r + ")(" + l + ")"
    if e.op == "//":
      ret "Math.floor((" + emitTsExpr(arena, e.left) + ") / (" + emitTsExpr(arena, e.right) + "))"
    if e.op == "**":
      ret "Math.pow(" + emitTsExpr(arena, e.left) + ", " + emitTsExpr(arena, e.right) + ")"
    if e.op == "%%":
      let l = emitTsExpr(arena, e.left)
      let r = emitTsExpr(arena, e.right)
      ret "(((" + l + " % " + r + ") + " + r + ") % " + r + ")"
    if e.op == "<" or e.op == "<=" or e.op == ">" or e.op == ">=":
      let l = emitTsExpr(arena, e.left)
      let r = emitTsExpr(arena, e.right)
      let op = e.op
      if isTsScalarExpr(arena, e.left) or isTsScalarExpr(arena, e.right):
        ret "(" + l + " " + op + " " + r + ")"
      let fnName = if op == "<": "_aipl_lt" else: (if op == "<=": "_aipl_le" else: (if op == ">": "_aipl_gt" else: "_aipl_ge"))
      ret fnName + "(" + l + ", " + r + ")"
    if e.op == "==" or e.op == "!=":
      let l = emitTsExpr(arena, e.left)
      let r = emitTsExpr(arena, e.right)
      let isEq = e.op == "=="
      if (isTsScalarExpr(arena, e.left) or isTsScalarExpr(arena, e.right)) and not isPossibleBigIntExpr(arena, e.left) and not isPossibleBigIntExpr(arena, e.right):
        ret "(" + l + " " + (if isEq: "===" else: "!==") + " " + r + ")"
      ret (if isEq: "_aipl_eq(" else: "_aipl_neq(") + l + ", " + r + ")"
    if e.op == "%":
      let l = emitTsExpr(arena, e.left)
      let r = emitTsExpr(arena, e.right)
      if isPossibleBigIntExpr(arena, e.left) or isPossibleBigIntExpr(arena, e.right):
        ret "_aipl_op(" + l + ", " + r + ", '%')"
      ret "(" + l + " % " + r + ")"
    if e.op == "+" or e.op == "-" or e.op == "*" or e.op == "/":
      let l = emitTsExpr(arena, e.left)
      let r = emitTsExpr(arena, e.right)
      let op = mapBinaryOpToTs(e.op)
      if isPossibleBigIntExpr(arena, e.left) or isPossibleBigIntExpr(arena, e.right):
        ret "_aipl_op(" + l + ", " + r + ", '" + op + "')"
      if e.op == "/" and (isTsFloatExpr(arena, e.left) or isTsFloatExpr(arena, e.right)):
        ret "(" + l + " / " + r + ")"
      if not isPossibleVecExpr(arena, e.left) and not isPossibleVecExpr(arena, e.right):
        if e.op == "-" or e.op == "*":
          ret "(" + l + " " + op + " " + r + ")"
        if e.op == "+":
          ret "(" + l + " + " + r + ")"
        if e.op == "/":
          ret "_aipl_div(" + l + ", " + r + ")"
      if isTsScalarExpr(arena, e.left) and isTsScalarExpr(arena, e.right):
        if e.op == "/":
          ret "_aipl_div(" + l + ", " + r + ")"
        ret "(" + l + " " + op + " " + r + ")"
      ret "_aipl_op(" + l + ", " + r + ", '" + op + "')"
    if e.op == "<<":
      ret "_aipl_shl(" + emitTsExpr(arena, e.left) + ", " + emitTsExpr(arena, e.right) + ")"
    if e.op == ">>":
      ret "_aipl_shr(" + emitTsExpr(arena, e.left) + ", " + emitTsExpr(arena, e.right) + ")"
    if e.op == "&":
      ret "_aipl_bitand(" + emitTsExpr(arena, e.left) + ", " + emitTsExpr(arena, e.right) + ")"
    if e.op == "|":
      ret "_aipl_bitor(" + emitTsExpr(arena, e.left) + ", " + emitTsExpr(arena, e.right) + ")"
    if e.op == "^":
      ret "_aipl_bitxor(" + emitTsExpr(arena, e.left) + ", " + emitTsExpr(arena, e.right) + ")"
    ret "(" + emitTsExpr(arena, e.left) + " " + mapBinaryOpToTs(e.op) + " " + emitTsExpr(arena, e.right) + ")"
  if e.kind == "Member":
    if e.left >= 0 and arena.exprs[e.left].kind == "Ident":
      let leftIdent = arena.exprs[e.left].strVal
      if (leftIdent == "canvas" or leftIdent == "Canvas") and (e.strVal == "backendName" or e.strVal == "canvasBackendName"):
        ret "canvasBackendName()"
      if (leftIdent == "canvas" or leftIdent == "Canvas") and (e.strVal == "isHeadless" or e.strVal == "isHeadlessMode"):
        ret "isHeadlessMode()"
      if isEnumName(arena, leftIdent) or isEnumVariant(arena, leftIdent, e.strVal):
        let vi = lookupEnumVariantIndex(arena, leftIdent, e.strVal)
        let ord = if vi >= 0: vi else: 0
        if e.strVal == "None":
          ret "({ tag: \"" + leftIdent + "::None\", ordinal: " + str(ord) + " })"
        ret "({ tag: \"" + e.strVal + "\", ordinal: " + str(ord) + " })"
    if e.strVal == "len":
      ret emitTsExpr(arena, e.left) + ".length"
    if e.strVal == "value" or e.strVal == "deref":
      ret "(" + emitTsExpr(arena, e.left) + "?.value ?? " + emitTsExpr(arena, e.left) + ")"
    if e.strVal == "f":
      let lCode = emitTsExpr(arena, e.left)
      if arena.exprs[e.left].kind == "FloatLit" or arena.exprs[e.left].kind == "IntLit":
        ret lCode
      ret "((_t => (typeof _t === 'number') ? _t : ((typeof _t === 'bigint') ? Number(_t) : _t.f))(" + lCode + "))"
    if e.strVal == "i":
      let lCode = emitTsExpr(arena, e.left)
      if arena.exprs[e.left].kind == "IntLit":
        ret lCode
      if arena.exprs[e.left].kind == "FloatLit":
        ret "Math.trunc(" + lCode + ")"
      ret "((_t => (typeof _t === 'number') ? Math.trunc(_t) : ((typeof _t === 'bigint') ? Number(_t) : _t.i))(" + lCode + "))"
    if e.strVal == "round":
      let lCode = emitTsExpr(arena, e.left)
      ret "((_t => (typeof _t === 'number') ? Math.round(_t) : ((typeof _t === 'bigint') ? Number(_t) : _t.round))(" + lCode + "))"
    if e.strVal == "floor":
      let lCode = emitTsExpr(arena, e.left)
      ret "((_t => (typeof _t === 'number') ? Math.floor(_t) : ((typeof _t === 'bigint') ? Number(_t) : _t.floor))(" + lCode + "))"
    if e.strVal == "ceil":
      let lCode = emitTsExpr(arena, e.left)
      ret "((_t => (typeof _t === 'number') ? Math.ceil(_t) : ((typeof _t === 'bigint') ? Number(_t) : _t.ceil))(" + lCode + "))"
    ret emitTsExpr(arena, e.left) + "." + e.strVal
  if e.kind == "Index":
    if e.right >= 0 and arena.exprs[e.right].kind == "Binary":
      let b = arena.exprs[e.right]
      if b.op == "..":
        let sLeft = if b.left >= 0: emitTsExpr(arena, b.left) else: "0"
        let sRight = if b.right >= 0: emitTsExpr(arena, b.right) else: ""
        ret emitTsExpr(arena, e.left) + ".slice(" + sLeft + (if sRight.len > 0: ", " + sRight else: "") + ")"
      if b.op == "..=":
        let sLeft = if b.left >= 0: emitTsExpr(arena, b.left) else: "0"
        let sRight = if b.right >= 0: "(" + emitTsExpr(arena, b.right) + " + 1)" else: ""
        ret emitTsExpr(arena, e.left) + ".slice(" + sLeft + (if sRight.len > 0: ", " + sRight else: "") + ")"
    let lCode = emitTsExpr(arena, e.left)
    let rCode = emitTsExpr(arena, e.right)
    if e.left >= 0 and arena.exprs[e.left].kind == "Member":
      ret lCode + "[" + rCode + "]"
    ret "_aipl_idx(" + lCode + ", " + rCode + ")"
  if e.kind == "Index2D":
    let rCode = if e.children.len >= 2: emitTsExpr(arena, e.children[0]) else: emitTsExpr(arena, e.right)
    let cCode = if e.cond >= 0: emitTsExpr(arena, e.cond) else: (if e.children.len >= 2: emitTsExpr(arena, e.children[1]) else: (if e.children.len > 0: emitTsExpr(arena, e.children[0]) else: "0"))
    ret emitTsExpr(arena, e.left) + "[" + rCode + "][" + cCode + "]"
  if e.kind == "ArrayRepeat":
    ret "new Array(" + emitTsExpr(arena, e.right) + ").fill(" + emitTsExpr(arena, e.left) + ")"
  if e.kind == "MapLit":
    if e.children.len == 0:
      ret "new Map()"
    mut entries: [str] = []
    mut mi = 0
    while mi + 1 < e.children.len:
      entries.push("[" + emitTsExpr(arena, e.children[mi]) + ", " + emitTsExpr(arena, e.children[mi + 1]) + "]")
      mi += 2
    ret "new Map([" + entries.join(", ") + "])"
  if e.kind == "Lambda":
    ret "((" + e.names.join(", ") + ") => " + emitTsExpr(arena, e.left) + ")"
  if e.kind == "IsPattern":
    let lCode = emitTsExpr(arena, e.left)
    ret "(" + emitTsMatchArmCondition(lCode, e.strVal) + ")"
  if e.kind == "ReturnExpr":
    let retVal = if e.left >= 0: emitTsExpr(arena, e.left) else: "undefined"
    ret "(() => { return " + retVal + "; })()"
  if e.kind == "BlockIfExpr":
    let condCode = if e.cond >= 0: emitTsExpr(arena, e.cond) else: (if e.left >= 0: emitTsExpr(arena, e.left) else: "false")
    mut bLines: [str] = []
    bLines.push("if (" + condCode + ") {")
    mut bi = 0
    while bi < e.children.len:
      let sid = e.children[bi]
      if sid >= 0 and sid < arena.stmts.len:
        let st = arena.stmts[sid]
        if bi == e.children.len - 1 and (st.kind == "ExprStmt" or st.kind == "Return"):
          bLines.push("  return " + (if st.exprId >= 0: emitTsExpr(arena, st.exprId) else: "undefined") + ";")
        else:
          let sLines = emitTsStmt(arena, sid, "  ", false)
          mut sli = 0
          while sli < sLines.len:
            bLines.push(sLines[sli])
            sli += 1
      bi += 1
    if e.children.len == 0 and e.left >= 0:
      bLines.push("  return " + emitTsExpr(arena, e.left) + ";")
    bLines.push("} else {")
    if e.right >= 0:
      bLines.push("  return " + emitTsExpr(arena, e.right) + ";")
    else:
      bLines.push("  return undefined;")
    bLines.push("}")
    ret "(() => {\n" + bLines.join("\n") + "\n})()"
  if e.kind == "Cast":
    let cTarget = e.strVal
    let inner = emitTsExpr(arena, e.left)
    if cTarget == "float" or cTarget == "f64" or cTarget == "f32":
      if isTsFloatCastOrLitExpr(arena, e.left):
        ret inner
      ret "Number(" + inner + ")"
    if cTarget == "int" or cTarget == "i64" or cTarget == "i32" or cTarget == "u8" or cTarget == "u16" or cTarget == "u32" or cTarget == "u64" or cTarget == "byte":
      if isTsIntCastOrLitExpr(arena, e.left):
        ret inner
      ret "Math.trunc(Number(" + inner + "))"
    if cTarget == "str" or cTarget == "string":
      ret "String(" + inner + ")"
    ret "(" + inner + " as " + mapAiplTypeToTs(cTarget) + ")"
  if e.kind == "DoBlock":
    mut dStmts: [str] = []
    mut bi = 0
    while bi < e.children.len:
      let sid = e.children[bi]
      if sid >= 0 and sid < arena.stmts.len:
        let st = arena.stmts[sid]
        if bi == e.children.len - 1 and (st.kind == "ExprStmt" or st.kind == "Return"):
          dStmts.push("return " + (if st.exprId >= 0: emitTsExpr(arena, st.exprId) else: "undefined") + ";")
        else:
          let sub = emitTsStmt(arena, sid, "  ", false)
          dStmts.push(sub.join("\n"))
      bi += 1
    if e.left >= 0:
      dStmts.push("return " + emitTsExpr(arena, e.left) + ";")
    ret "(() => {\n" + dStmts.join("\n") + "\n})()"
  if e.kind == "MatchExpr":
    let target = if e.left >= 0: emitTsExpr(arena, e.left) else: (if e.cond >= 0: emitTsExpr(arena, e.cond) else: "undefined")
    mut mLines: [str] = []
    mLines.push("const _t = " + target + ";")
    if e.names.len > 0:
      mut mi = 0
      while mi < e.children.len:
        let pfx = if mi == 0: "if" else: "else if"
        mut patName = if mi < e.names.len: e.names[mi] else: "_"
        let valExprId = e.children[mi]
        mut guard = ""
        if patName.contains("?"):
          let qparts = patName.split("?")
          if qparts.len > 1:
            patName = qparts[0]
            let gId = int(qparts[1])
            if gId >= 0 and gId < arena.exprs.len:
              guard = " && (" + emitTsExpr(arena, gId) + ")"
        mut bindVarsStr = ""
        if patName.contains("@"):
          let bparts = patName.split("@")
          if bparts.len > 1:
            patName = bparts[0]
            bindVarsStr = bparts[1]
        if patName == "_" or patName == "else":
          if guard.len > 0:
            mLines.push(pfx + " (true" + guard + ") {")
          elif mi == 0:
            mLines.push("if (true) {")
          else:
            mLines.push("else {")
        else:
          mLines.push(pfx + " (" + emitTsMatchArmCondition("_t", patName) + guard + ") {")
        if bindVarsStr.len > 0:
          let bvars = bindVarsStr.split(",")
          mut bvi = 0
          while bvi < bvars.len:
            let bv = bvars[bvi].trim()
            if bv.len > 0 and bv != "_":
              if bvars.len == 1:
                mLines.push("  const " + bv + " = (_t && typeof _t === 'object') ? ('value' in _t ? _t.value : ('error' in _t ? _t.error : _t)) : _t;")
              else:
                mLines.push("  const _uv = (_t && typeof _t === 'object' && 'value' in _t) ? _t.value : _t; const " + bv + " = Array.isArray(_uv) ? _uv[" + str(bvi) + "] : _uv;")
            bvi += 1
        if valExprId >= 0:
          mLines.push("  return " + emitTsExpr(arena, valExprId) + ";")
        mLines.push("}")
        mi += 1
      ret "(() => {\n" + mLines.join("\n") + "\n})()"
    mut mi = 0
    while mi < e.children.len:
      let armId = e.children[mi]
      let pfx = if mi == 0: "if" else: "else if"
      if armId >= 0 and armId < arena.stmts.len:
        let arm = arena.stmts[armId]
        mut guard = ""
        if arm.exprId >= 0 and arm.bodyStmts.len > 0:
          guard = " && (" + emitTsExpr(arena, arm.exprId) + ")"
        if arm.name == "_" or arm.name == "else":
          if guard.len > 0:
            mLines.push(pfx + " (true" + guard + ") {")
          else:
            mLines.push("else {")
        else:
          mLines.push(pfx + " (" + emitTsMatchArmCondition("_t", arm.name) + guard + ") {")
        if arm.bodyStmts.len == 0 and arm.exprId >= 0:
          mLines.push("  return " + emitTsExpr(arena, arm.exprId) + ";")
        else:
          mut bsi = 0
          while bsi < arm.bodyStmts.len:
            let bsId = arm.bodyStmts[bsi]
            if bsi == arm.bodyStmts.len - 1 and bsId >= 0 and bsId < arena.stmts.len:
              let bst = arena.stmts[bsId]
              if bst.kind == "ExprStmt" or bst.kind == "Return":
                mLines.push("  return " + (if bst.exprId >= 0: emitTsExpr(arena, bst.exprId) else: "undefined") + ";")
              else:
                let sLines = emitTsStmt(arena, bsId, "  ", false)
                mLines.push(sLines.join("\n"))
            else:
              let sLines = emitTsStmt(arena, bsId, "  ", false)
              mLines.push(sLines.join("\n"))
            bsi += 1
        mLines.push("}")
      mi += 1
    ret "(() => {\n" + mLines.join("\n") + "\n})()"
  if e.kind == "Try":
    ret "((_r) => (_r && typeof _r === 'object' && 'value' in _r ? _r.value : _r))(" + emitTsExpr(arena, e.left) + ")"
  if e.kind == "IfExpr" or e.kind == "Ternary":
    let condId = if e.cond >= 0: e.cond else: e.left
    let thenId = if e.cond >= 0: e.left else: e.right
    let elseId = if e.cond >= 0: e.right else: (if e.children.len > 0: e.children[0] else: -1)
    if condId >= 0 and condId < arena.exprs.len:
      let ce = arena.exprs[condId]
      if ce.kind == "BoolLit" or (ce.kind == "Ident" and (ce.strVal == "true" or ce.strVal == "false")):
        let isTrue = if ce.kind == "BoolLit": ce.boolVal else: (ce.strVal == "true")
        if isTrue:
          ret emitTsExpr(arena, thenId)
        ret if elseId >= 0: emitTsExpr(arena, elseId) else: "undefined"
    let cond = if e.cond >= 0: emitTsExpr(arena, e.cond) else: emitTsExpr(arena, e.left)
    let thenE = if e.cond >= 0: emitTsExpr(arena, e.left) else: emitTsExpr(arena, e.right)
    let elseE = if e.cond >= 0: emitTsExpr(arena, e.right) else: (if e.children.len > 0: emitTsExpr(arena, e.children[0]) else: "undefined")
    ret "(" + cond + " ? " + thenE + " : " + elseE + ")"
  if e.kind == "Call":
    if e.left >= 0 and arena.exprs[e.left].kind == "Member":
      let mem = arena.exprs[e.left]
      let method = mem.strVal
      let recv = emitTsExpr(arena, mem.left)
      if method == "toJson" and e.children.len == 0:
        ret "JSON.stringify(" + recv + ")"
      if method == "jsonSchema" and e.children.len == 0:
        ret recv + ".jsonSchema()"
      if method == "fromJson" and e.children.len > 0:
        ret recv + ".fromJson(" + emitTsExpr(arena, e.children[0]) + ")"
      if mem.left >= 0 and arena.exprs[mem.left].kind == "Ident":
        let modName = arena.exprs[mem.left].strVal
        if modName == "int" and method == "parse" and e.children.len > 0:
          let arg = emitTsExpr(arena, e.children[0])
          ret "((_s) => { const _n = parseInt(String(_s), 10); return isNaN(_n) ? { ok: false, error: 'invalid int' } : { ok: true, value: _n }; })(" + arg + ")"
        if modName == "float" and method == "parse" and e.children.len > 0:
          let arg = emitTsExpr(arena, e.children[0])
          ret "((_s) => { const _n = parseFloat(String(_s)); return isNaN(_n) ? { ok: false, error: 'invalid float' } : { ok: true, value: _n }; })(" + arg + ")"
        if modName == "Box" and method == "new":
          let bArg = if e.children.len > 0: emitTsExpr(arena, e.children[0]) else: "null"
          ret "{ value: " + bArg + " }"
        if (modName == "ByteBuffer" or modName == "bytes") and (method == "alloc" or method == "new"):
          let bArg = if e.children.len > 0: emitTsExpr(arena, e.children[0]) else: "64"
          ret "byteBufferAlloc(" + bArg + ")"
        if modName == "arena" or modName == "Arena":
          if method == "mark":
            ret "arenaMark()"
          if method == "reset":
            let mArg = if e.children.len > 0: emitTsExpr(arena, e.children[0]) else: "0"
            ret "arenaReset(" + mArg + ")"
          if method == "allocatedBytes":
            ret "arenaAllocatedBytes()"
          if method == "alloc":
            let sArg = if e.children.len > 0: emitTsExpr(arena, e.children[0]) else: "8"
            ret "arenaAlloc(" + sArg + ")"
          if method == "stats":
            ret "arenaStats()"
          if method == "withScratchArena":
            let fnArg = if e.children.len > 0: emitTsExpr(arena, e.children[0]) else: "(() => {})"
            ret "withScratchArena(" + fnArg + ")"
        if isEnumName(arena, modName) or isEnumVariant(arena, modName, method):
          let vi = lookupEnumVariantIndex(arena, modName, method)
