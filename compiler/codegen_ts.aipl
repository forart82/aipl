        ret "((_v) => (_v == null || (typeof _v === 'object' && _v.ok === false)) ? _v : (" + fnArg + ")((_v && typeof _v === 'object' && 'value' in _v) ? _v.value : _v))(" + recv + ")"
      if method == "toString" or method == "name":
        ret "((_v) => { if (_v && typeof _v === 'object' && !Array.isArray(_v) && typeof _v." + method + " === 'function' && _v." + method + " !== Object.prototype.toString) return _v." + method + "(); const _s = String(_v?.tag ?? _v); const _i = _s.indexOf('::'); return _i >= 0 ? _s.slice(_i + 2) : _s; })(" + recv + ")"
      if method == "deref" or method == "value":
