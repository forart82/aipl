          ret "({ tag: \"" + method + "\", ordinal: " + str(ord) + ", value: " + argVal + " })"
      if method == "expect":
        let msg = if e.children.len > 0: emitTsExpr(arena, e.children[0]) else: "\"unwrap failed\""
        ret "((_v) => { if (_v == null || (typeof _v === 'object' && _v.ok === false)) { throw new Error(" + msg + "); } return (_v && typeof _v === 'object' && 'value' in _v) ? _v.value : _v; })(" + recv + ")"
      if method == "unwrapErr":
        ret "((_v) => (_v && typeof _v === 'object' && 'error' in _v ? _v.error : (_v && typeof _v === 'object' && 'err' in _v ? _v.err : _v)))(" + recv + ")"
      if method == "andThen" and e.children.len > 0:
