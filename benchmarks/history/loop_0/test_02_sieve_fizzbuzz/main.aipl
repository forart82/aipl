module Bench02SieveFizzBuzz

fn sievePrimes(limit: int): [int]:
  mut isPrime: [bool] = []
  mut i = 0
  while i <= limit:
    isPrime.push(i >= 2)
    i += 1
  mut p = 2
  while p * p <= limit:
    if isPrime[p]:
      mut mult = p * p
      while mult <= limit:
        isPrime[mult] = false
        mult += p
    p += 1
  mut primes: [int] = []
  mut k = 2
  while k <= limit:
    if isPrime[k]:
      primes.push(k)
    k += 1
  ret primes

fn classifyCell(n: int, isPrime: bool): str:
  if isPrime: ret "PRIME({n})"
  if n % 15 == 0: ret "FizzBuzz"
  if n % 3 == 0: ret "Fizz"
  if n % 5 == 0: ret "Buzz"
  ret str(n)

fn main(): void:
  let primes = sievePrimes(30)
  assert(primes.len == 10)
  assert(primes[0] == 2 and primes[9] == 29)
  mut primeSet: Map[int, bool] = Map.new()
  for pr in primes:
    primeSet.set(pr, true)
  mut rows: [str] = []
  mut r = 0
  while r < 3:
    mut cols: [str] = []
    mut c = 1
    while c <= 5:
      let val = r * 5 + c
      cols.push(classifyCell(val, primeSet.containsKey(val)))
      c += 1
    rows.push(cols.join(" | "))
    r += 1
  assert(rows[0].contains("PRIME(2)") and rows[2].contains("FizzBuzz"))
  println(rows.join("\n"))
  println("BENCH_02_OK")
