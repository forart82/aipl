module Bench01HelloCli

import std.cli

fn formatGreeting(name: str, role: str, count: int): str:
  ret "Hello, {name} [{role}]! Welcome #{count} to AIPL."

fn main(): void:
  let parsed = parseCliArgs(["--name=Developer", "--role=Engineer"])
  let user = cliGetOption(parsed, "name", "Developer")
  let role = cliGetOption(parsed, "role", "Engineer")
  let msg1 = formatGreeting(user, role, 1)
  let msg2 = formatGreeting("Ada", "Architect", 42)
  assert(msg1 == "Hello, Developer [Engineer]! Welcome #1 to AIPL.")
  assert(msg2 == "Hello, Ada [Architect]! Welcome #42 to AIPL.")
  println(msg1)
  println(msg2)
  println("BENCH_01_OK")
