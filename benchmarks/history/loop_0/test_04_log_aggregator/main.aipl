module Bench04LogAggregator

import std.fs

struct LogSummary(totalLines: int, errorCount: int, warnCount: int, infoCount: int, topEndpoint: str, errorRatePct: float)

fn analyzeLogs(content: str): LogSummary:
  mut total = 0
  mut errs = 0
  mut warns = 0
  mut infos = 0
  mut endpointCounts: Map[str, int] = Map.new()
  mut bestEndpoint = ""
  mut bestCount = 0

  for line in content.lines():
    let t = line.trim()
    if t.len > 0:
      total += 1
      let cols = t.split(" ")
      if cols.len >= 3:
        let lvl = cols[1]
        let ep = cols[2]
        if lvl == "ERROR": errs += 1
        else if lvl == "WARN": warns += 1
        else if lvl == "INFO": infos += 1
        let c = endpointCounts.getOr(ep, 0) + 1
        endpointCounts.set(ep, c)
        if c > bestCount:
          bestCount = c
          bestEndpoint = ep

  let rate = if total > 0: (float(errs) * 100.0) / float(total) else: 0.0
  ret LogSummary(total, errs, warns, infos, bestEndpoint, rate)

fn main(): void:
  let logPath = "/tmp/aipl_bench04_sample.log"
  let sample = "2026-11-02T10:00:01Z INFO /api/login 200\n2026-11-02T10:00:02Z ERROR /api/pay 500\n2026-11-02T10:00:03Z INFO /api/pay 200\n2026-11-02T10:00:04Z WARN /api/login 429\n2026-11-02T10:00:05Z ERROR /api/pay 503\n"
  let _ = writeFile(logPath, sample)
  let loaded = readFile(logPath)
  let sum = analyzeLogs(loaded)
  assert(sum.totalLines == 5)
  assert(sum.errorCount == 2 and sum.warnCount == 1 and sum.infoCount == 2)
  assert(sum.topEndpoint == "/api/pay")
  assert(sum.errorRatePct > 39.9 and sum.errorRatePct < 40.1)
  println("Total={sum.totalLines} Errors={sum.errorCount} Top={sum.topEndpoint}")
  println("BENCH_04_OK")
