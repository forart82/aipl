{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"\"\"",
      "close": "\"\"\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(pub\\s+fn|pub\\s+struct|pub\\s+enum|pub\\s+trait|fn|if|elif|else|while|for|match|with|test|struct|enum|trait|impl|@agent|@capabilities)\\b.*:\\s*(#.*|//.*)?$",
    "decreaseIndentPattern": "^\\s*(elif|else|ret|break|continue)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:pub\\s+fn|pub\\s+struct|pub\\s+enum|pub\\s+trait|fn|if|elif|else|while|for|match|with|test|struct|enum|trait|impl|@agent|@capabilities).*:\\s*(?:#.*|//.*)?$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}
