{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AIPL",
  "scopeName": "source.aipl",
  "fileTypes": [
    "aipl"
  ],
  "patterns": [
    { "include": "#invalid" },
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#identifiers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.aipl",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.aipl",
          "match": "//.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "storage.modifier.directive.aipl",
          "match": "@(agent|capabilities|pure|inline|test|compute|ffi|bot|packed|repr|deprecated)\\b"
        },
        {
          "name": "keyword.other.contract.aipl",
          "match": "\\b(require|ensure|requires|ensures|req|ens|invariant|decrease|decreases)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.triple.aipl",
          "begin": "\\br\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.triple.aipl",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-escaped-char" },
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.raw.hash2.aipl",
          "begin": "\\br##\"",
          "end": "\"##"
        },
        {
          "name": "string.quoted.raw.hash.aipl",
          "begin": "\\br#\"",
          "end": "\"#"
        },
        {
          "name": "string.quoted.raw.aipl",
          "begin": "\\br\"",
          "end": "\""
        },
        {
          "name": "string.quoted.double.aipl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escaped-char" },
            { "include": "#string-interpolation" }
          ]
        }
      ]
    },
    "string-escaped-char": {
      "patterns": [
        {
          "name": "constant.character.escape.aipl",
          "match": "\\\\([nrt\\\\\"'{0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.line.interpolation.aipl",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.aipl" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.aipl" }
          },
          "patterns": [
            {
              "match": "(:)([^\\}]+)(?=\\})",
              "captures": {
                "1": { "name": "punctuation.separator.format-spec.aipl" },
                "2": { "name": "constant.other.format-spec.aipl" }
              }
            },
            { "include": "$self" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.aipl",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.aipl",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.aipl",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.aipl",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aipl",
          "match": "\\b(if|elif|else|match|while|for|in|step|by|ret|return|break|continue|pass|do|discard|with|async|await|spawn|where)\\b"
        },
        {
          "name": "storage.type.declaration.aipl",
          "match": "\\b(fn|pub|struct|enum|type|let|mut|const|val|test|module|import|from|as|extern|trait|impl|where|component|system|shader|ui)\\b"
        },
        {
          "name": "keyword.operator.logical.aipl",
          "match": "\\b(and|or|not|is)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.aipl",
          "match": "\\b(int|float|bool|str|byte|bytes|void|any|u8|u16|u32|u64|usize|i8|i16|i32|i64|isize|f32|f64)\\b"
        },
        {
          "name": "support.type.builtin.aipl",
          "match": "\\b(Option|Result|Map|Set|Box|ByteBuffer|Int64Buffer|Float64Buffer|Deque|RingBuffer|Grid2D|KeyEvent|Vec2|Vec3|Color|Rect|Transform2D|Camera2D|ParticleEmitter|Tween|Spring|PhysicsWorld2D|SynthEnvelope|AuraTheme|AuraContext|AuraRect|AuraTextResult|PointerEvent|Array|Float32Tensor|Float64Tensor|MpscChannel|WorkStealingPool|AsyncTask|Database|DbStmt|ShrinkResultInt|ShrinkResultStr|HttpRequest|HttpResponse)\\b"
        },
        {
          "name": "support.constant.variant.aipl",
          "match": "\\b(Ok|Err|Some|None)\\b"
        },
        {
          "name": "entity.name.type.nominal.aipl",
          "match": "\\b[A-Z][a-zA-Z0-9]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.aipl",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "name": "constant.other.caps.aipl",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.definition.aipl",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.aipl" },
            "2": { "name": "entity.name.function.aipl" }
          }
        },
        {
          "name": "support.function.aura.aipl",
          "match": "\\b(aura[A-Z][a-zA-Z0-9_]*)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.aipl",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\b(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.namespace.aipl",
          "match": "(::)"
        },
        {
          "name": "keyword.operator.arrow.aipl",
          "match": "(->|=>|\\|>)"
        },
        {
          "name": "keyword.operator.range.aipl",
          "match": "(\\.\\.=|\\.\\.)"
        },
        {
          "name": "keyword.operator.comparison.aipl",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.bitwise.aipl",
          "match": "(<<|>>|&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.assignment.aipl",
          "match": "(\\+=|-=|\\*\\*=|\\*=|/=|%%=|%=|<<=|>>=|&=|\\|=|\\^=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.aipl",
          "match": "(\\*{2}|\\*\\*|%%|\\+|-|\\*|/|%|\\?)"
        }
      ]
    },
    "invalid": {
      "patterns": [
        {
          "name": "invalid.illegal.tab-indentation.aipl",
          "match": "^\\t+"
        },
        {
          "name": "invalid.illegal.bad-keyword.aipl",
          "match": "\\b(function|def|var|null|undefined|elsif|elseif)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.property.aipl",
          "match": "(?<=\\.)[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.parameter.aipl",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b(?=\\s*:\\s*(?:int|float|bool|str|byte|bytes|void|any|u8|u16|u32|u64|usize|i8|i16|i32|i64|isize|f32|f64|[A-Z]|\\[|\\())"
        },
        {
          "name": "variable.other.aipl",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.aipl",
          "match": "[:,;()\\[\\]{}.]"
        }
      ]
    }
  }
}
