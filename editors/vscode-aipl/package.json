{
  "name": "aipl-lang",
  "displayName": "AIPL Language Support (Syntax, Prettier & LSP)",
  "description": "Official AIPL syntax highlighting, 6 low-eye-strain color themes (Aura Dark, Nordic Frost, Evergreen Forest, Rose Pine Dusk, Espresso Warm, Solarized Daylight), code beautifier, live alignment/syntax diagnostics, and cross-file LSP for VS Code.",
  "version": "0.9.0",
  "icon": "icon.png",
  "publisher": "aipl-toolchain",
  "license": "Apache-2.0",
  "keywords": [
    "aipl",
    "formatter",
    "prettier",
    "lsp",
    "syntax",
    "theme"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Snippets",
    "Themes"
  ],
  "activationEvents": [
    "onLanguage:aipl",
    "onCommand:aipl.beautifyDocument",
    "onCommand:aipl.checkAlignmentAndSyntax",
    "onCommand:aipl.applyDarkStyle",
    "onCommand:aipl.selectTheme"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "aipl",
        "aliases": [
          "AIPL",
          "aipl"
        ],
        "extensions": [
          ".aipl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/aipl-file-light.svg",
          "dark": "./icons/aipl-file-dark.svg"
        }
      }
    ],
    "themes": [
      {
        "label": "AIPL Aura Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/aipl-aura-dark-color-theme.json"
      },
      {
        "label": "AIPL Nordic Frost",
        "uiTheme": "vs-dark",
        "path": "./themes/aipl-nordic-frost-color-theme.json"
      },
      {
        "label": "AIPL Evergreen Forest",
        "uiTheme": "vs-dark",
        "path": "./themes/aipl-evergreen-forest-color-theme.json"
      },
      {
        "label": "AIPL Rose Pine Dusk",
        "uiTheme": "vs-dark",
        "path": "./themes/aipl-rose-pine-dusk-color-theme.json"
      },
      {
        "label": "AIPL Espresso Warm",
        "uiTheme": "vs-dark",
        "path": "./themes/aipl-espresso-warm-color-theme.json"
      },
      {
        "label": "AIPL Solarized Daylight",
        "uiTheme": "vs",
        "path": "./themes/aipl-solarized-daylight-color-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "aipl",
        "scopeName": "source.aipl",
        "path": "./syntaxes/aipl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aipl",
        "path": "./snippets/aipl.json"
      }
    ],
    "commands": [
      {
        "command": "aipl.beautifyDocument",
        "title": "AIPL: Beautify / Format Document"
      },
      {
        "command": "aipl.checkAlignmentAndSyntax",
        "title": "AIPL: Check Syntax & Indentation Alignment"
      },
      {
        "command": "aipl.selectTheme",
        "title": "AIPL: Select Color Theme"
      },
      {
        "command": "aipl.applyDarkStyle",
        "title": "AIPL: Activate AIPL Color Theme"
      }
    ],
    "configuration": {
      "title": "AIPL",
      "properties": {
        "aipl.executablePath": {
          "type": "string",
          "default": "aipl",
          "description": "Path to the AIPL CLI executable (`aipl`) used for formatting (`aipl fmt`) and LSP (`aipl lsp`)."
        },
        "aipl.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Format `.aipl` files using `aipl fmt --stdin` and the built-in AIPL beautifier on save."
        },
        "aipl.highlightMisalignedCode": {
          "type": "boolean",
          "default": true,
          "description": "Visually highlight misaligned indentation (non-2-space, tabs, or inconsistent block levels) in `.aipl` files."
        },
        "aipl.highlightSyntaxErrors": {
          "type": "boolean",
          "default": true,
          "description": "Visually highlight wrongly written syntax, invalid keywords, and type errors in `.aipl` files."
        }
      }
    },
    "configurationDefaults": {
      "[aipl]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "aipl-toolchain.aipl-lang",
        "editor.renderWhitespace": "boundary",
        "editor.guides.indentation": true,
        "editor.guides.highlightActiveIndentation": true
      },
      "editor.tokenColorCustomizations": {
        "[Default Dark Modern][Default Dark+][Visual Studio Dark][Dark+ (default dark)][Dark (Visual Studio)]": {
          "textMateRules": [
            {
              "scope": ["source.aipl", "text.aipl", "variable.other.aipl"],
              "settings": { "foreground": "#B8C4D9" }
            },
            {
              "scope": ["comment.line.number-sign.aipl", "comment.line.double-slash.aipl"],
              "settings": { "foreground": "#636D83", "fontStyle": "italic" }
            },
            {
              "scope": ["keyword.control.aipl", "keyword.operator.logical.aipl"],
              "settings": { "foreground": "#BB9AF7" }
            },
            {
              "scope": ["storage.type.declaration.aipl", "storage.type.function.aipl"],
              "settings": { "foreground": "#9D7CD8" }
            },
            {
              "scope": ["storage.modifier.directive.aipl", "keyword.other.contract.aipl"],
              "settings": { "foreground": "#E0AF68", "fontStyle": "italic" }
            },
            {
              "scope": ["entity.name.function.aipl", "entity.name.function.call.aipl", "meta.function.definition.aipl"],
              "settings": { "foreground": "#7AA2F7" }
            },
            {
              "scope": ["support.function.aura.aipl"],
              "settings": { "foreground": "#7DCFFF" }
            },
            {
              "scope": ["storage.type.primitive.aipl", "support.type.builtin.aipl", "entity.name.type.nominal.aipl"],
              "settings": { "foreground": "#56B6C2" }
            },
            {
              "scope": ["support.constant.variant.aipl", "constant.language.boolean.aipl", "constant.other.caps.aipl"],
              "settings": { "foreground": "#FF9E64" }
            },
            {
              "scope": ["constant.numeric.integer.aipl", "constant.numeric.float.aipl", "constant.numeric.hex.aipl", "constant.numeric.binary.aipl"],
              "settings": { "foreground": "#E59966" }
            },
            {
              "scope": [
                "string.quoted.double.aipl",
                "string.quoted.raw.aipl",
                "string.quoted.raw.hash.aipl",
                "string.quoted.raw.hash2.aipl",
                "string.quoted.triple.aipl",
                "string.quoted.raw.triple.aipl"
              ],
              "settings": { "foreground": "#9ECE6A" }
            },
            {
              "scope": ["variable.parameter.aipl"],
              "settings": { "foreground": "#E5C07B" }
            },
            {
              "scope": ["variable.other.property.aipl"],
              "settings": { "foreground": "#7DC4E4" }
            },
            {
              "scope": [
                "constant.character.escape.aipl",
                "meta.embedded.line.interpolation.aipl",
                "punctuation.section.embedded.begin.aipl",
                "punctuation.section.embedded.end.aipl",
                "punctuation.separator.format-spec.aipl",
                "constant.other.format-spec.aipl"
              ],
              "settings": { "foreground": "#73DACA" }
            },
            {
              "scope": [
                "keyword.operator.namespace.aipl",
                "keyword.operator.arrow.aipl",
                "keyword.operator.range.aipl",
                "keyword.operator.comparison.aipl",
                "keyword.operator.bitwise.aipl",
                "keyword.operator.assignment.aipl",
                "keyword.operator.arithmetic.aipl",
                "punctuation.aipl"
              ],
              "settings": { "foreground": "#89B4FA" }
            },
            {
              "scope": [
                "invalid.illegal.aipl",
                "invalid.illegal.tab-indentation.aipl",
                "invalid.illegal.bad-keyword.aipl",
                "invalid.alignment.aipl"
              ],
              "settings": { "foreground": "#F07178", "fontStyle": "underline" }
            }
          ]
        },
        "[Default Light Modern][Default Light+][Visual Studio Light][Light+ (default light)][Light (Visual Studio)]": {
          "textMateRules": [
            {
              "scope": ["source.aipl", "text.aipl", "variable.other.aipl"],
              "settings": { "foreground": "#3B4252" }
            },
            {
              "scope": ["comment.line.number-sign.aipl", "comment.line.double-slash.aipl"],
              "settings": { "foreground": "#687076", "fontStyle": "italic" }
            },
            {
              "scope": ["keyword.control.aipl", "keyword.operator.logical.aipl"],
              "settings": { "foreground": "#5E3DA8" }
            },
            {
              "scope": ["storage.type.declaration.aipl", "storage.type.function.aipl"],
              "settings": { "foreground": "#7D3873" }
            },
            {
              "scope": ["storage.modifier.directive.aipl", "keyword.other.contract.aipl"],
              "settings": { "foreground": "#8C4F12", "fontStyle": "italic" }
            },
            {
              "scope": ["entity.name.function.aipl", "entity.name.function.call.aipl", "meta.function.definition.aipl"],
              "settings": { "foreground": "#235E82" }
            },
            {
              "scope": ["support.function.aura.aipl"],
              "settings": { "foreground": "#17638A" }
            },
            {
              "scope": ["storage.type.primitive.aipl", "support.type.builtin.aipl", "entity.name.type.nominal.aipl"],
              "settings": { "foreground": "#196767" }
            },
            {
              "scope": ["support.constant.variant.aipl", "constant.language.boolean.aipl", "constant.other.caps.aipl"],
              "settings": { "foreground": "#9C4811" }
            },
            {
              "scope": ["constant.numeric.integer.aipl", "constant.numeric.float.aipl", "constant.numeric.hex.aipl", "constant.numeric.binary.aipl"],
              "settings": { "foreground": "#8F3D5E" }
            },
            {
              "scope": [
                "string.quoted.double.aipl",
                "string.quoted.raw.aipl",
                "string.quoted.raw.hash.aipl",
                "string.quoted.raw.hash2.aipl",
                "string.quoted.triple.aipl",
                "string.quoted.raw.triple.aipl"
              ],
              "settings": { "foreground": "#2B6847" }
            },
            {
              "scope": ["variable.parameter.aipl"],
              "settings": { "foreground": "#825217" }
            },
            {
              "scope": ["variable.other.property.aipl"],
              "settings": { "foreground": "#1D6470" }
            },
            {
              "scope": [
                "constant.character.escape.aipl",
                "meta.embedded.line.interpolation.aipl",
                "punctuation.section.embedded.begin.aipl",
                "punctuation.section.embedded.end.aipl",
                "punctuation.separator.format-spec.aipl",
                "constant.other.format-spec.aipl"
              ],
              "settings": { "foreground": "#1E6B5C" }
            },
            {
              "scope": [
                "keyword.operator.namespace.aipl",
                "keyword.operator.arrow.aipl",
                "keyword.operator.range.aipl",
                "keyword.operator.comparison.aipl",
                "keyword.operator.bitwise.aipl",
                "keyword.operator.assignment.aipl",
                "keyword.operator.arithmetic.aipl",
                "punctuation.aipl"
              ],
              "settings": { "foreground": "#43576B" }
            },
            {
              "scope": [
                "invalid.illegal.aipl",
                "invalid.illegal.tab-indentation.aipl",
                "invalid.illegal.bad-keyword.aipl",
                "invalid.alignment.aipl"
              ],
              "settings": { "foreground": "#B32E22", "fontStyle": "underline" }
            }
          ]
        }
      }
    }
  }
}
