{
  "$schema": "vscode://schemas/color-theme",
  "name": "AIPL Nordic Frost",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#242933",
    "editor.foreground": "#D8DEE9",
    "editorLineNumber.foreground": "#4C566A",
    "editorLineNumber.activeForeground": "#A5B4CB",
    "editorCursor.foreground": "#88C0D0",
    "editor.selectionBackground": "#3B4252",
    "editor.inactiveSelectionBackground": "#2E3440",
    "editor.selectionHighlightBackground": "#3B425288",
    "editor.wordHighlightBackground": "#434C5E88",
    "editor.wordHighlightStrongBackground": "#4C566A88",
    "editor.lineHighlightBackground": "#2B303C",
    "editor.lineHighlightBorder": "#2B303C00",
    "editorIndentGuide.background1": "#333A47",
    "editorIndentGuide.activeBackground1": "#4C566A",
    "editorWhitespace.foreground": "#3B4252",
    "editorBracketMatch.background": "#3B4252",
    "editorBracketMatch.border": "#88C0D0",
    "editorError.foreground": "#BF616A",
    "editorWarning.foreground": "#EBCB8B",
    "editorInfo.foreground": "#88C0D0",
    "editorHint.foreground": "#8FBCBB",
    "editorGutter.background": "#242933",
    "editorGutter.modifiedBackground": "#81A1C1",
    "editorGutter.addedBackground": "#A3BE8C",
    "editorGutter.deletedBackground": "#BF616A",
    "editorWidget.background": "#1E222A",
    "editorWidget.border": "#3B4252",
    "editorHoverWidget.background": "#1E222A",
    "editorHoverWidget.border": "#3B4252",
    "editorSuggestWidget.background": "#1E222A",
    "editorSuggestWidget.border": "#3B4252",
    "editorSuggestWidget.selectedBackground": "#333A47",
    "sideBar.background": "#1E222A",
    "sideBar.foreground": "#C0C8D8",
    "sideBarTitle.foreground": "#D8DEE9",
    "activityBar.background": "#191D24",
    "activityBar.foreground": "#C0C8D8",
    "statusBar.background": "#191D24",
    "statusBar.foreground": "#C0C8D8",
    "titleBar.activeBackground": "#191D24",
    "titleBar.activeForeground": "#C0C8D8",
    "tab.activeBackground": "#242933",
    "tab.activeForeground": "#E5E9F0",
    "tab.inactiveBackground": "#1E222A",
    "tab.inactiveForeground": "#7B88A1",
    "panel.background": "#1E222A",
    "panel.border": "#333A47",
    "terminal.background": "#1E222A",
    "terminal.foreground": "#D8DEE9"
  },
  "semanticTokenColors": {
    "function": "#88C0D0",
    "method": "#88C0D0",
    "variable": "#D8DEE9",
    "variable.readonly": "#C8D0E0",
    "parameter": "#EBCB8B",
    "property": "#8FBCBB",
    "type": "#8FBCBB",
    "struct": "#8FBCBB",
    "enum": "#8FBCBB",
    "interface": "#8FBCBB",
    "enumMember": "#E29A7E",
    "keyword": "#81A1C1",
    "string": "#A3BE8C",
    "number": "#D4A5C9",
    "comment": {
      "foreground": "#7B88A1",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "name": "AIPL Base Source Foreground (Soft Snow Mist)",
      "scope": [
        "source.aipl",
        "text.aipl"
      ],
      "settings": {
        "foreground": "#D8DEE9"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line.number-sign.aipl",
        "comment.line.double-slash.aipl"
      ],
      "settings": {
        "foreground": "#7B88A1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword.control.aipl",
        "keyword.operator.logical.aipl"
      ],
      "settings": {
        "foreground": "#81A1C1"
      }
    },
    {
      "name": "Declarations & Storage Modifiers",
      "scope": [
        "storage.type.declaration.aipl",
        "storage.type.function.aipl"
      ],
      "settings": {
        "foreground": "#B48EAD"
      }
    },
    {
      "name": "Directives & SMT Contracts",
      "scope": [
        "storage.modifier.directive.aipl",
        "keyword.other.contract.aipl"
      ],
      "settings": {
        "foreground": "#EBCB8B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions & Calls",
      "scope": [
        "entity.name.function.aipl",
        "entity.name.function.call.aipl",
        "meta.function.definition.aipl"
      ],
      "settings": {
        "foreground": "#88C0D0"
      }
    },
    {
      "name": "Aura UI Builtin Functions",
      "scope": [
        "support.function.aura.aipl"
      ],
      "settings": {
        "foreground": "#7ACFE6"
      }
    },
    {
      "name": "Primitive & Builtin Types",
      "scope": [
        "storage.type.primitive.aipl",
        "support.type.builtin.aipl",
        "entity.name.type.nominal.aipl"
      ],
      "settings": {
        "foreground": "#8FBCBB"
      }
    },
    {
      "name": "Enum Variants & Boolean/Nil Constants",
      "scope": [
        "support.constant.variant.aipl",
        "constant.language.boolean.aipl",
        "constant.other.caps.aipl"
      ],
      "settings": {
        "foreground": "#E29A7E"
      }
    },
    {
      "name": "Numeric Literals",
      "scope": [
        "constant.numeric.integer.aipl",
        "constant.numeric.float.aipl",
        "constant.numeric.hex.aipl",
        "constant.numeric.binary.aipl"
      ],
      "settings": {
        "foreground": "#D4A5C9"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string.quoted.double.aipl",
        "string.quoted.raw.aipl",
        "string.quoted.raw.hash.aipl",
        "string.quoted.raw.hash2.aipl",
        "string.quoted.triple.aipl",
        "string.quoted.raw.triple.aipl"
      ],
      "settings": {
        "foreground": "#A3BE8C"
      }
    },
    {
      "name": "String Escapes & Format Specifiers",
      "scope": [
        "constant.character.escape.aipl",
        "meta.embedded.line.interpolation.aipl",
        "punctuation.section.embedded.begin.aipl",
        "punctuation.section.embedded.end.aipl",
        "punctuation.separator.format-spec.aipl",
        "constant.other.format-spec.aipl"
      ],
      "settings": {
        "foreground": "#9AD4C6"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable.other.aipl"
      ],
      "settings": {
        "foreground": "#D8DEE9"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter.aipl"
      ],
      "settings": {
        "foreground": "#E5C07B"
      }
    },
    {
      "name": "Properties & Struct Fields",
      "scope": [
        "variable.other.property.aipl"
      ],
      "settings": {
        "foreground": "#94C9D8"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator.namespace.aipl",
        "keyword.operator.arrow.aipl",
        "keyword.operator.range.aipl",
        "keyword.operator.comparison.aipl",
        "keyword.operator.bitwise.aipl",
        "keyword.operator.assignment.aipl",
        "keyword.operator.arithmetic.aipl",
        "punctuation.aipl"
      ],
      "settings": {
        "foreground": "#9EB6D4"
      }
    },
    {
      "name": "Invalid Syntax or Misaligned Indentation",
      "scope": [
        "invalid.illegal.aipl",
        "invalid.illegal.bad-keyword.aipl",
        "invalid.illegal.tab-indentation.aipl",
        "invalid.alignment.aipl"
      ],
      "settings": {
        "foreground": "#E07A84",
        "fontStyle": "underline"
      }
    }
  ]
}
