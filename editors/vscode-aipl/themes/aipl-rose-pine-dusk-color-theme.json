{
  "$schema": "vscode://schemas/color-theme",
  "name": "AIPL Rose Pine Dusk",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#232136",
    "editor.foreground": "#E0DEF4",
    "editorLineNumber.foreground": "#59546D",
    "editorLineNumber.activeForeground": "#908CAA",
    "editorCursor.foreground": "#EA9A97",
    "editor.selectionBackground": "#393552",
    "editor.inactiveSelectionBackground": "#2A273F",
    "editor.selectionHighlightBackground": "#39355288",
    "editor.wordHighlightBackground": "#44415A88",
    "editor.wordHighlightStrongBackground": "#56526E88",
    "editor.lineHighlightBackground": "#2A273F",
    "editor.lineHighlightBorder": "#2A273F00",
    "editorIndentGuide.background1": "#312E48",
    "editorIndentGuide.activeBackground1": "#56526E",
    "editorWhitespace.foreground": "#393552",
    "editorBracketMatch.background": "#393552",
    "editorBracketMatch.border": "#9CCFD8",
    "editorError.foreground": "#EB6F92",
    "editorWarning.foreground": "#F6C177",
    "editorInfo.foreground": "#9CCFD8",
    "editorHint.foreground": "#C4A7E7",
    "editorGutter.background": "#232136",
    "editorGutter.modifiedBackground": "#9CCFD8",
    "editorGutter.addedBackground": "#7DB9B6",
    "editorGutter.deletedBackground": "#EB6F92",
    "editorWidget.background": "#1D1B2D",
    "editorWidget.border": "#393552",
    "editorHoverWidget.background": "#1D1B2D",
    "editorHoverWidget.border": "#44415A",
    "editorSuggestWidget.background": "#1D1B2D",
    "editorSuggestWidget.border": "#393552",
    "editorSuggestWidget.selectedBackground": "#312E48",
    "sideBar.background": "#1D1B2D",
    "sideBar.foreground": "#C4C1DC",
    "sideBarTitle.foreground": "#E0DEF4",
    "activityBar.background": "#181625",
    "activityBar.foreground": "#C4C1DC",
    "statusBar.background": "#181625",
    "statusBar.foreground": "#C4C1DC",
    "titleBar.activeBackground": "#181625",
    "titleBar.activeForeground": "#C4C1DC",
    "tab.activeBackground": "#232136",
    "tab.activeForeground": "#ECEAF8",
    "tab.inactiveBackground": "#1D1B2D",
    "tab.inactiveForeground": "#6E6A86",
    "panel.background": "#1D1B2D",
    "panel.border": "#312E48",
    "terminal.background": "#1D1B2D",
    "terminal.foreground": "#E0DEF4"
  },
  "semanticTokenColors": {
    "function": "#EA9A97",
    "method": "#EA9A97",
    "variable": "#E0DEF4",
    "variable.readonly": "#CFCBE8",
    "parameter": "#E8C496",
    "property": "#A8D8E0",
    "type": "#9CCFD8",
    "struct": "#9CCFD8",
    "enum": "#9CCFD8",
    "interface": "#9CCFD8",
    "enumMember": "#F2A68A",
    "keyword": "#7BA8C7",
    "string": "#A6D1A8",
    "number": "#E5A9C8",
    "comment": {
      "foreground": "#827D9C",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "name": "AIPL Base Source Foreground (Soft Lavender Foam)",
      "scope": [
        "source.aipl",
        "text.aipl"
      ],
      "settings": {
        "foreground": "#E0DEF4"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line.number-sign.aipl",
        "comment.line.double-slash.aipl"
      ],
      "settings": {
        "foreground": "#827D9C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword.control.aipl",
        "keyword.operator.logical.aipl"
      ],
      "settings": {
        "foreground": "#7BA8C7"
      }
    },
    {
      "name": "Declarations & Storage Modifiers",
      "scope": [
        "storage.type.declaration.aipl",
        "storage.type.function.aipl"
      ],
      "settings": {
        "foreground": "#C4A7E7"
      }
    },
    {
      "name": "Directives & SMT Contracts",
      "scope": [
        "storage.modifier.directive.aipl",
        "keyword.other.contract.aipl"
      ],
      "settings": {
        "foreground": "#F6C177",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions & Calls",
      "scope": [
        "entity.name.function.aipl",
        "entity.name.function.call.aipl",
        "meta.function.definition.aipl"
      ],
      "settings": {
        "foreground": "#EA9A97"
      }
    },
    {
      "name": "Aura UI Builtin Functions",
      "scope": [
        "support.function.aura.aipl"
      ],
      "settings": {
        "foreground": "#EBBCBA"
      }
    },
    {
      "name": "Primitive & Builtin Types",
      "scope": [
        "storage.type.primitive.aipl",
        "support.type.builtin.aipl",
        "entity.name.type.nominal.aipl"
      ],
      "settings": {
        "foreground": "#9CCFD8"
      }
    },
    {
      "name": "Enum Variants & Boolean/Nil Constants",
      "scope": [
        "support.constant.variant.aipl",
        "constant.language.boolean.aipl",
        "constant.other.caps.aipl"
      ],
      "settings": {
        "foreground": "#F2A68A"
      }
    },
    {
      "name": "Numeric Literals",
      "scope": [
        "constant.numeric.integer.aipl",
        "constant.numeric.float.aipl",
        "constant.numeric.hex.aipl",
        "constant.numeric.binary.aipl"
      ],
      "settings": {
        "foreground": "#E5A9C8"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string.quoted.double.aipl",
        "string.quoted.raw.aipl",
        "string.quoted.raw.hash.aipl",
        "string.quoted.raw.hash2.aipl",
        "string.quoted.triple.aipl",
        "string.quoted.raw.triple.aipl"
      ],
      "settings": {
        "foreground": "#A6D1A8"
      }
    },
    {
      "name": "String Escapes & Format Specifiers",
      "scope": [
        "constant.character.escape.aipl",
        "meta.embedded.line.interpolation.aipl",
        "punctuation.section.embedded.begin.aipl",
        "punctuation.section.embedded.end.aipl",
        "punctuation.separator.format-spec.aipl",
        "constant.other.format-spec.aipl"
      ],
      "settings": {
        "foreground": "#8AD4C6"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable.other.aipl"
      ],
      "settings": {
        "foreground": "#E0DEF4"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter.aipl"
      ],
      "settings": {
        "foreground": "#E8C496"
      }
    },
    {
      "name": "Properties & Struct Fields",
      "scope": [
        "variable.other.property.aipl"
      ],
      "settings": {
        "foreground": "#A8D8E0"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator.namespace.aipl",
        "keyword.operator.arrow.aipl",
        "keyword.operator.range.aipl",
        "keyword.operator.comparison.aipl",
        "keyword.operator.bitwise.aipl",
        "keyword.operator.assignment.aipl",
        "keyword.operator.arithmetic.aipl",
        "punctuation.aipl"
      ],
      "settings": {
        "foreground": "#B2ADD1"
      }
    },
    {
      "name": "Invalid Syntax or Misaligned Indentation",
      "scope": [
        "invalid.illegal.aipl",
        "invalid.illegal.bad-keyword.aipl",
        "invalid.illegal.tab-indentation.aipl",
        "invalid.alignment.aipl"
      ],
      "settings": {
        "foreground": "#EB6F92",
        "fontStyle": "underline"
      }
    }
  ]
}
