{
  "$schema": "vscode://schemas/color-theme",
  "name": "AIPL Espresso Warm",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#24201E",
    "editor.foreground": "#DDC7A1",
    "editorLineNumber.foreground": "#5C514B",
    "editorLineNumber.activeForeground": "#A89984",
    "editorCursor.foreground": "#E78A4E",
    "editor.selectionBackground": "#3C3532",
    "editor.inactiveSelectionBackground": "#302A27",
    "editor.selectionHighlightBackground": "#3C353288",
    "editor.wordHighlightBackground": "#453D3988",
    "editor.wordHighlightStrongBackground": "#544A4588",
    "editor.lineHighlightBackground": "#2C2624",
    "editor.lineHighlightBorder": "#2C262400",
    "editorIndentGuide.background1": "#352F2C",
    "editorIndentGuide.activeBackground1": "#5A504A",
    "editorWhitespace.foreground": "#3F3834",
    "editorBracketMatch.background": "#3C3532",
    "editorBracketMatch.border": "#7DAEA3",
    "editorError.foreground": "#EA6962",
    "editorWarning.foreground": "#D8A657",
    "editorInfo.foreground": "#7DAEA3",
    "editorHint.foreground": "#89B482",
    "editorGutter.background": "#24201E",
    "editorGutter.modifiedBackground": "#7DAEA3",
    "editorGutter.addedBackground": "#A9B665",
    "editorGutter.deletedBackground": "#EA6962",
    "editorWidget.background": "#1D1A18",
    "editorWidget.border": "#38312E",
    "editorHoverWidget.background": "#1D1A18",
    "editorHoverWidget.border": "#423A36",
    "editorSuggestWidget.background": "#1D1A18",
    "editorSuggestWidget.border": "#38312E",
    "editorSuggestWidget.selectedBackground": "#332D2A",
    "sideBar.background": "#1D1A18",
    "sideBar.foreground": "#C2B193",
    "sideBarTitle.foreground": "#DDC7A1",
    "activityBar.background": "#181514",
    "activityBar.foreground": "#C2B193",
    "statusBar.background": "#181514",
    "statusBar.foreground": "#C2B193",
    "titleBar.activeBackground": "#181514",
    "titleBar.activeForeground": "#C2B193",
    "tab.activeBackground": "#24201E",
    "tab.activeForeground": "#E6D5B8",
    "tab.inactiveBackground": "#1D1A18",
    "tab.inactiveForeground": "#7C6F64",
    "panel.background": "#1D1A18",
    "panel.border": "#352F2C",
    "terminal.background": "#1D1A18",
    "terminal.foreground": "#DDC7A1"
  },
  "semanticTokenColors": {
    "function": "#A9B665",
    "method": "#A9B665",
    "variable": "#DDC7A1",
    "variable.readonly": "#C9B592",
    "parameter": "#E5B872",
    "property": "#8FC1B5",
    "type": "#7DAEA3",
    "struct": "#7DAEA3",
    "enum": "#7DAEA3",
    "interface": "#7DAEA3",
    "enumMember": "#D3869B",
    "keyword": "#EA786C",
    "string": "#98C379",
    "number": "#E09F7D",
    "comment": {
      "foreground": "#87796E",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "name": "AIPL Base Source Foreground (Warm Oatmilk)",
      "scope": [
        "source.aipl",
        "text.aipl"
      ],
      "settings": {
        "foreground": "#DDC7A1"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line.number-sign.aipl",
        "comment.line.double-slash.aipl"
      ],
      "settings": {
        "foreground": "#87796E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword.control.aipl",
        "keyword.operator.logical.aipl"
      ],
      "settings": {
        "foreground": "#EA786C"
      }
    },
    {
      "name": "Declarations & Storage Modifiers",
      "scope": [
        "storage.type.declaration.aipl",
        "storage.type.function.aipl"
      ],
      "settings": {
        "foreground": "#E78A4E"
      }
    },
    {
      "name": "Directives & SMT Contracts",
      "scope": [
        "storage.modifier.directive.aipl",
        "keyword.other.contract.aipl"
      ],
      "settings": {
        "foreground": "#D8A657",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions & Calls",
      "scope": [
        "entity.name.function.aipl",
        "entity.name.function.call.aipl",
        "meta.function.definition.aipl"
      ],
      "settings": {
        "foreground": "#A9B665"
      }
    },
    {
      "name": "Aura UI Builtin Functions",
      "scope": [
        "support.function.aura.aipl"
      ],
      "settings": {
        "foreground": "#8EC07C"
      }
    },
    {
      "name": "Primitive & Builtin Types",
      "scope": [
        "storage.type.primitive.aipl",
        "support.type.builtin.aipl",
        "entity.name.type.nominal.aipl"
      ],
      "settings": {
        "foreground": "#7DAEA3"
      }
    },
    {
      "name": "Enum Variants & Boolean/Nil Constants",
      "scope": [
        "support.constant.variant.aipl",
        "constant.language.boolean.aipl",
        "constant.other.caps.aipl"
      ],
      "settings": {
        "foreground": "#D3869B"
      }
    },
    {
      "name": "Numeric Literals",
      "scope": [
        "constant.numeric.integer.aipl",
        "constant.numeric.float.aipl",
        "constant.numeric.hex.aipl",
        "constant.numeric.binary.aipl"
      ],
      "settings": {
        "foreground": "#E09F7D"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string.quoted.double.aipl",
        "string.quoted.raw.aipl",
        "string.quoted.raw.hash.aipl",
        "string.quoted.raw.hash2.aipl",
        "string.quoted.triple.aipl",
        "string.quoted.raw.triple.aipl"
      ],
      "settings": {
        "foreground": "#98C379"
      }
    },
    {
      "name": "String Escapes & Format Specifiers",
      "scope": [
        "constant.character.escape.aipl",
        "meta.embedded.line.interpolation.aipl",
        "punctuation.section.embedded.begin.aipl",
        "punctuation.section.embedded.end.aipl",
        "punctuation.separator.format-spec.aipl",
        "constant.other.format-spec.aipl"
      ],
      "settings": {
        "foreground": "#88C0B0"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable.other.aipl"
      ],
      "settings": {
        "foreground": "#DDC7A1"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter.aipl"
      ],
      "settings": {
        "foreground": "#E5B872"
      }
    },
    {
      "name": "Properties & Struct Fields",
      "scope": [
        "variable.other.property.aipl"
      ],
      "settings": {
        "foreground": "#8FC1B5"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator.namespace.aipl",
        "keyword.operator.arrow.aipl",
        "keyword.operator.range.aipl",
        "keyword.operator.comparison.aipl",
        "keyword.operator.bitwise.aipl",
        "keyword.operator.assignment.aipl",
        "keyword.operator.arithmetic.aipl",
        "punctuation.aipl"
      ],
      "settings": {
        "foreground": "#C8A88B"
      }
    },
    {
      "name": "Invalid Syntax or Misaligned Indentation",
      "scope": [
        "invalid.illegal.aipl",
        "invalid.illegal.bad-keyword.aipl",
        "invalid.illegal.tab-indentation.aipl",
        "invalid.alignment.aipl"
      ],
      "settings": {
        "foreground": "#F26D64",
        "fontStyle": "underline"
      }
    }
  ]
}
