{
  "$schema": "vscode://schemas/color-theme",
  "name": "AIPL Solarized Daylight",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#F4EFE6",
    "editor.foreground": "#3B4252",
    "editorLineNumber.foreground": "#939B9F",
    "editorLineNumber.activeForeground": "#4C566A",
    "editorCursor.foreground": "#2A6F97",
    "editor.selectionBackground": "#DFD6C5",
    "editor.inactiveSelectionBackground": "#E8E1D3",
    "editor.selectionHighlightBackground": "#DFD6C588",
    "editor.wordHighlightBackground": "#D8CEBC88",
    "editor.wordHighlightStrongBackground": "#CFC3AE88",
    "editor.lineHighlightBackground": "#EDE6DA",
    "editor.lineHighlightBorder": "#EDE6DA00",
    "editorIndentGuide.background1": "#E2DBD0",
    "editorIndentGuide.activeBackground1": "#B8B0A2",
    "editorWhitespace.foreground": "#D8D0C2",
    "editorBracketMatch.background": "#DFD6C5",
    "editorBracketMatch.border": "#2A6F97",
    "editorError.foreground": "#C0392B",
    "editorWarning.foreground": "#B86B14",
    "editorInfo.foreground": "#2A6F97",
    "editorHint.foreground": "#1F7A7A",
    "editorGutter.background": "#F4EFE6",
    "editorGutter.modifiedBackground": "#2A6F97",
    "editorGutter.addedBackground": "#3B7A57",
    "editorGutter.deletedBackground": "#C0392B",
    "editorWidget.background": "#EBE4D8",
    "editorWidget.border": "#D5CCB9",
    "editorHoverWidget.background": "#EBE4D8",
    "editorHoverWidget.border": "#CBC1AE",
    "editorSuggestWidget.background": "#EBE4D8",
    "editorSuggestWidget.border": "#D5CCB9",
    "editorSuggestWidget.selectedBackground": "#DFD6C5",
    "sideBar.background": "#EBE4D8",
    "sideBar.foreground": "#4C566A",
    "sideBarTitle.foreground": "#3B4252",
    "activityBar.background": "#E2DBD0",
    "activityBar.foreground": "#4C566A",
    "statusBar.background": "#E2DBD0",
    "statusBar.foreground": "#4C566A",
    "titleBar.activeBackground": "#E2DBD0",
    "titleBar.activeForeground": "#4C566A",
    "tab.activeBackground": "#F4EFE6",
    "tab.activeForeground": "#2E3440",
    "tab.inactiveBackground": "#EBE4D8",
    "tab.inactiveForeground": "#737C8C",
    "panel.background": "#EBE4D8",
    "panel.border": "#D5CCB9",
    "terminal.background": "#EFE9DE",
    "terminal.foreground": "#3B4252"
  },
  "semanticTokenColors": {
    "function": "#235E82",
    "method": "#235E82",
    "variable": "#3B4252",
    "variable.readonly": "#4C566A",
    "parameter": "#825217",
    "property": "#1D6470",
    "type": "#196767",
    "struct": "#196767",
    "enum": "#196767",
    "interface": "#196767",
    "enumMember": "#9C4811",
    "keyword": "#5E3DA8",
    "string": "#2B6847",
    "number": "#8F3D5E",
    "comment": {
      "foreground": "#687076",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "name": "AIPL Base Source Foreground (Soft Charcoal Ink)",
      "scope": [
        "source.aipl",
        "text.aipl"
      ],
      "settings": {
        "foreground": "#3B4252"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line.number-sign.aipl",
        "comment.line.double-slash.aipl"
      ],
      "settings": {
        "foreground": "#687076",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword.control.aipl",
        "keyword.operator.logical.aipl"
      ],
      "settings": {
        "foreground": "#5E3DA8"
      }
    },
    {
      "name": "Declarations & Storage Modifiers",
      "scope": [
        "storage.type.declaration.aipl",
        "storage.type.function.aipl"
      ],
      "settings": {
        "foreground": "#7D3873"
      }
    },
    {
      "name": "Directives & SMT Contracts",
      "scope": [
        "storage.modifier.directive.aipl",
        "keyword.other.contract.aipl"
      ],
      "settings": {
        "foreground": "#8C4F12",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions & Calls",
      "scope": [
        "entity.name.function.aipl",
        "entity.name.function.call.aipl",
        "meta.function.definition.aipl"
      ],
      "settings": {
        "foreground": "#235E82"
      }
    },
    {
      "name": "Aura UI Builtin Functions",
      "scope": [
        "support.function.aura.aipl"
      ],
      "settings": {
        "foreground": "#17638A"
      }
    },
    {
      "name": "Primitive & Builtin Types",
      "scope": [
        "storage.type.primitive.aipl",
        "support.type.builtin.aipl",
        "entity.name.type.nominal.aipl"
      ],
      "settings": {
        "foreground": "#196767"
      }
    },
    {
      "name": "Enum Variants & Boolean/Nil Constants",
      "scope": [
        "support.constant.variant.aipl",
        "constant.language.boolean.aipl",
        "constant.other.caps.aipl"
      ],
      "settings": {
        "foreground": "#9C4811"
      }
    },
    {
      "name": "Numeric Literals",
      "scope": [
        "constant.numeric.integer.aipl",
        "constant.numeric.float.aipl",
        "constant.numeric.hex.aipl",
        "constant.numeric.binary.aipl"
      ],
      "settings": {
        "foreground": "#8F3D5E"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string.quoted.double.aipl",
        "string.quoted.raw.aipl",
        "string.quoted.raw.hash.aipl",
        "string.quoted.raw.hash2.aipl",
        "string.quoted.triple.aipl",
        "string.quoted.raw.triple.aipl"
      ],
      "settings": {
        "foreground": "#2B6847"
      }
    },
    {
      "name": "String Escapes & Format Specifiers",
      "scope": [
        "constant.character.escape.aipl",
        "meta.embedded.line.interpolation.aipl",
        "punctuation.section.embedded.begin.aipl",
        "punctuation.section.embedded.end.aipl",
        "punctuation.separator.format-spec.aipl",
        "constant.other.format-spec.aipl"
      ],
      "settings": {
        "foreground": "#1E6B5C"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable.other.aipl"
      ],
      "settings": {
        "foreground": "#3B4252"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter.aipl"
      ],
      "settings": {
        "foreground": "#825217"
      }
    },
    {
      "name": "Properties & Struct Fields",
      "scope": [
        "variable.other.property.aipl"
      ],
      "settings": {
        "foreground": "#1D6470"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator.namespace.aipl",
        "keyword.operator.arrow.aipl",
        "keyword.operator.range.aipl",
        "keyword.operator.comparison.aipl",
        "keyword.operator.bitwise.aipl",
        "keyword.operator.assignment.aipl",
        "keyword.operator.arithmetic.aipl",
        "punctuation.aipl"
      ],
      "settings": {
        "foreground": "#43576B"
      }
    },
    {
      "name": "Invalid Syntax or Misaligned Indentation",
      "scope": [
        "invalid.illegal.aipl",
        "invalid.illegal.bad-keyword.aipl",
        "invalid.illegal.tab-indentation.aipl",
        "invalid.alignment.aipl"
      ],
      "settings": {
        "foreground": "#B32E22",
        "fontStyle": "underline"
      }
    }
  ]
}
