{
  "$schema": "vscode://schemas/color-theme",
  "name": "AIPL Evergreen Forest",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1E2522",
    "editor.foreground": "#D3C6AA",
    "editorLineNumber.foreground": "#56635F",
    "editorLineNumber.activeForeground": "#9DA9A0",
    "editorCursor.foreground": "#A7C080",
    "editor.selectionBackground": "#333F3A",
    "editor.inactiveSelectionBackground": "#29332E",
    "editor.selectionHighlightBackground": "#333F3A88",
    "editor.wordHighlightBackground": "#38474088",
    "editor.wordHighlightStrongBackground": "#42544B88",
    "editor.lineHighlightBackground": "#252E2A",
    "editor.lineHighlightBorder": "#252E2A00",
    "editorIndentGuide.background1": "#2D3833",
    "editorIndentGuide.activeBackground1": "#4F5E57",
    "editorWhitespace.foreground": "#36423D",
    "editorBracketMatch.background": "#333F3A",
    "editorBracketMatch.border": "#83C092",
    "editorError.foreground": "#E67E80",
    "editorWarning.foreground": "#DBBC7F",
    "editorInfo.foreground": "#7FBBB3",
    "editorHint.foreground": "#83C092",
    "editorGutter.background": "#1E2522",
    "editorGutter.modifiedBackground": "#7FBBB3",
    "editorGutter.addedBackground": "#A7C080",
    "editorGutter.deletedBackground": "#E67E80",
    "editorWidget.background": "#191F1C",
    "editorWidget.border": "#2F3A35",
    "editorHoverWidget.background": "#191F1C",
    "editorHoverWidget.border": "#35413B",
    "editorSuggestWidget.background": "#191F1C",
    "editorSuggestWidget.border": "#2F3A35",
    "editorSuggestWidget.selectedBackground": "#2D3833",
    "sideBar.background": "#191F1C",
    "sideBar.foreground": "#B8AE97",
    "sideBarTitle.foreground": "#D3C6AA",
    "activityBar.background": "#151A17",
    "activityBar.foreground": "#B8AE97",
    "statusBar.background": "#151A17",
    "statusBar.foreground": "#B8AE97",
    "titleBar.activeBackground": "#151A17",
    "titleBar.activeForeground": "#B8AE97",
    "tab.activeBackground": "#1E2522",
    "tab.activeForeground": "#DFD4BC",
    "tab.inactiveBackground": "#191F1C",
    "tab.inactiveForeground": "#7A8478",
    "panel.background": "#191F1C",
    "panel.border": "#2D3833",
    "terminal.background": "#191F1C",
    "terminal.foreground": "#D3C6AA"
  },
  "semanticTokenColors": {
    "function": "#A7C080",
    "method": "#A7C080",
    "variable": "#D3C6AA",
    "variable.readonly": "#C5B89D",
    "parameter": "#E3C78A",
    "property": "#93C9C0",
    "type": "#7FBBB3",
    "struct": "#7FBBB3",
    "enum": "#7FBBB3",
    "interface": "#7FBBB3",
    "enumMember": "#D699B6",
    "keyword": "#E68183",
    "string": "#99C794",
    "number": "#DFA985",
    "comment": {
      "foreground": "#7A8478",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "name": "AIPL Base Source Foreground (Warm Parchment Sage)",
      "scope": [
        "source.aipl",
        "text.aipl"
      ],
      "settings": {
        "foreground": "#D3C6AA"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line.number-sign.aipl",
        "comment.line.double-slash.aipl"
      ],
      "settings": {
        "foreground": "#7A8478",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword.control.aipl",
        "keyword.operator.logical.aipl"
      ],
      "settings": {
        "foreground": "#E68183"
      }
    },
    {
      "name": "Declarations & Storage Modifiers",
      "scope": [
        "storage.type.declaration.aipl",
        "storage.type.function.aipl"
      ],
      "settings": {
        "foreground": "#E69875"
      }
    },
    {
      "name": "Directives & SMT Contracts",
      "scope": [
        "storage.modifier.directive.aipl",
        "keyword.other.contract.aipl"
      ],
      "settings": {
        "foreground": "#DBBC7F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions & Calls",
      "scope": [
        "entity.name.function.aipl",
        "entity.name.function.call.aipl",
        "meta.function.definition.aipl"
      ],
      "settings": {
        "foreground": "#A7C080"
      }
    },
    {
      "name": "Aura UI Builtin Functions",
      "scope": [
        "support.function.aura.aipl"
      ],
      "settings": {
        "foreground": "#83C092"
      }
    },
    {
      "name": "Primitive & Builtin Types",
      "scope": [
        "storage.type.primitive.aipl",
        "support.type.builtin.aipl",
        "entity.name.type.nominal.aipl"
      ],
      "settings": {
        "foreground": "#7FBBB3"
      }
    },
    {
      "name": "Enum Variants & Boolean/Nil Constants",
      "scope": [
        "support.constant.variant.aipl",
        "constant.language.boolean.aipl",
        "constant.other.caps.aipl"
      ],
      "settings": {
        "foreground": "#D699B6"
      }
    },
    {
      "name": "Numeric Literals",
      "scope": [
        "constant.numeric.integer.aipl",
        "constant.numeric.float.aipl",
        "constant.numeric.hex.aipl",
        "constant.numeric.binary.aipl"
      ],
      "settings": {
        "foreground": "#DFA985"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string.quoted.double.aipl",
        "string.quoted.raw.aipl",
        "string.quoted.raw.hash.aipl",
        "string.quoted.raw.hash2.aipl",
        "string.quoted.triple.aipl",
        "string.quoted.raw.triple.aipl"
      ],
      "settings": {
        "foreground": "#99C794"
      }
    },
    {
      "name": "String Escapes & Format Specifiers",
      "scope": [
        "constant.character.escape.aipl",
        "meta.embedded.line.interpolation.aipl",
        "punctuation.section.embedded.begin.aipl",
        "punctuation.section.embedded.end.aipl",
        "punctuation.separator.format-spec.aipl",
        "constant.other.format-spec.aipl"
      ],
      "settings": {
        "foreground": "#89C7B6"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable.other.aipl"
      ],
      "settings": {
        "foreground": "#D3C6AA"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter.aipl"
      ],
      "settings": {
        "foreground": "#E3C78A"
      }
    },
    {
      "name": "Properties & Struct Fields",
      "scope": [
        "variable.other.property.aipl"
      ],
      "settings": {
        "foreground": "#93C9C0"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator.namespace.aipl",
        "keyword.operator.arrow.aipl",
        "keyword.operator.range.aipl",
        "keyword.operator.comparison.aipl",
        "keyword.operator.bitwise.aipl",
        "keyword.operator.assignment.aipl",
        "keyword.operator.arithmetic.aipl",
        "punctuation.aipl"
      ],
      "settings": {
        "foreground": "#B5C4A1"
      }
    },
    {
      "name": "Invalid Syntax or Misaligned Indentation",
      "scope": [
        "invalid.illegal.aipl",
        "invalid.illegal.bad-keyword.aipl",
        "invalid.illegal.tab-indentation.aipl",
        "invalid.alignment.aipl"
      ],
      "settings": {
        "foreground": "#F07E80",
        "fontStyle": "underline"
      }
    }
  ]
}
