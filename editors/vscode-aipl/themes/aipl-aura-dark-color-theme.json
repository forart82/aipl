{
  "$schema": "vscode://schemas/color-theme",
  "name": "AIPL Aura Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#161922",
    "editor.foreground": "#B8C4D9",
    "editorLineNumber.foreground": "#4B5368",
    "editorLineNumber.activeForeground": "#8B98B4",
    "editorCursor.foreground": "#7AA2F7",
    "editor.selectionBackground": "#28324A",
    "editor.inactiveSelectionBackground": "#20283A",
    "editor.selectionHighlightBackground": "#242D4288",
    "editor.wordHighlightBackground": "#2A344D88",
    "editor.wordHighlightStrongBackground": "#33415E88",
    "editor.lineHighlightBackground": "#1C202C",
    "editor.lineHighlightBorder": "#1C202C00",
    "editorIndentGuide.background1": "#232836",
    "editorIndentGuide.activeBackground1": "#3E4760",
    "editorWhitespace.foreground": "#2B3142",
    "editorBracketMatch.background": "#2A344B",
    "editorBracketMatch.border": "#5A72A0",
    "editorError.foreground": "#F07178",
    "editorWarning.foreground": "#E0AF68",
    "editorInfo.foreground": "#7DCFFF",
    "editorHint.foreground": "#73DACA",
    "editorGutter.background": "#161922",
    "editorGutter.modifiedBackground": "#7AA2F7",
    "editorGutter.addedBackground": "#9ECE6A",
    "editorGutter.deletedBackground": "#F07178",
    "editorWidget.background": "#13161E",
    "editorWidget.border": "#262C3D",
    "editorHoverWidget.background": "#13161E",
    "editorHoverWidget.border": "#2A3145",
    "editorSuggestWidget.background": "#13161E",
    "editorSuggestWidget.border": "#262C3D",
    "editorSuggestWidget.selectedBackground": "#232B3E",
    "sideBar.background": "#12151D",
    "sideBar.foreground": "#9AA7BE",
    "sideBarTitle.foreground": "#B8C4D9",
    "activityBar.background": "#101219",
    "activityBar.foreground": "#9AA7BE",
    "statusBar.background": "#101219",
    "statusBar.foreground": "#9AA7BE",
    "titleBar.activeBackground": "#101219",
    "titleBar.activeForeground": "#9AA7BE",
    "tab.activeBackground": "#161922",
    "tab.activeForeground": "#C5D1E6",
    "tab.inactiveBackground": "#12151D",
    "tab.inactiveForeground": "#6E7A94",
    "panel.background": "#12151D",
    "panel.border": "#222736",
    "terminal.background": "#141720",
    "terminal.foreground": "#B8C4D9"
  },
  "semanticTokenColors": {
    "function": "#7AA2F7",
    "method": "#7AA2F7",
    "variable": "#B8C4D9",
    "variable.readonly": "#A9B8D0",
    "parameter": "#E0AF68",
    "property": "#73DACA",
    "type": "#2AC3DE",
    "struct": "#2AC3DE",
    "enum": "#2AC3DE",
    "interface": "#2AC3DE",
    "enumMember": "#FF9E64",
    "keyword": "#BB9AF7",
    "string": "#9ECE6A",
    "number": "#FF9E64",
    "comment": {
      "foreground": "#636D83",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "name": "AIPL Base Source Foreground (Soft Mist - Never Harsh White)",
      "scope": [
        "source.aipl",
        "text.aipl"
      ],
      "settings": {
        "foreground": "#B8C4D9"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line.number-sign.aipl",
        "comment.line.double-slash.aipl"
      ],
      "settings": {
        "foreground": "#636D83",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword.control.aipl",
        "keyword.operator.logical.aipl"
      ],
      "settings": {
        "foreground": "#BB9AF7"
      }
    },
    {
      "name": "Declarations & Storage Modifiers",
      "scope": [
        "storage.type.declaration.aipl",
        "storage.type.function.aipl"
      ],
      "settings": {
        "foreground": "#9D7CD8"
      }
    },
    {
      "name": "Directives & SMT Contracts",
      "scope": [
        "storage.modifier.directive.aipl",
        "keyword.other.contract.aipl"
      ],
      "settings": {
        "foreground": "#E0AF68",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions & Calls",
      "scope": [
        "entity.name.function.aipl",
        "entity.name.function.call.aipl",
        "meta.function.definition.aipl"
      ],
      "settings": {
        "foreground": "#7AA2F7"
      }
    },
    {
      "name": "Aura UI Builtin Functions",
      "scope": [
        "support.function.aura.aipl"
      ],
      "settings": {
        "foreground": "#7DCFFF"
      }
    },
    {
      "name": "Primitive & Builtin Types",
      "scope": [
        "storage.type.primitive.aipl",
        "support.type.builtin.aipl",
        "entity.name.type.nominal.aipl"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "name": "Enum Variants & Boolean/Nil Constants",
      "scope": [
        "support.constant.variant.aipl",
        "constant.language.boolean.aipl",
        "constant.other.caps.aipl"
      ],
      "settings": {
        "foreground": "#FF9E64"
      }
    },
    {
      "name": "Numeric Literals",
      "scope": [
        "constant.numeric.integer.aipl",
        "constant.numeric.float.aipl",
        "constant.numeric.hex.aipl",
        "constant.numeric.binary.aipl"
      ],
      "settings": {
        "foreground": "#E59966"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string.quoted.double.aipl",
        "string.quoted.raw.aipl",
        "string.quoted.raw.hash.aipl",
        "string.quoted.raw.hash2.aipl",
        "string.quoted.triple.aipl",
        "string.quoted.raw.triple.aipl"
      ],
      "settings": {
        "foreground": "#9ECE6A"
      }
    },
    {
      "name": "String Escapes & Format Specifiers",
      "scope": [
        "constant.character.escape.aipl",
        "meta.embedded.line.interpolation.aipl",
        "punctuation.section.embedded.begin.aipl",
        "punctuation.section.embedded.end.aipl",
        "punctuation.separator.format-spec.aipl",
        "constant.other.format-spec.aipl"
      ],
      "settings": {
        "foreground": "#73DACA"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable.other.aipl"
      ],
      "settings": {
        "foreground": "#B8C4D9"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter.aipl"
      ],
      "settings": {
        "foreground": "#E5C07B"
      }
    },
    {
      "name": "Properties & Struct Fields",
      "scope": [
        "variable.other.property.aipl"
      ],
      "settings": {
        "foreground": "#7DC4E4"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator.namespace.aipl",
        "keyword.operator.arrow.aipl",
        "keyword.operator.range.aipl",
        "keyword.operator.comparison.aipl",
        "keyword.operator.bitwise.aipl",
        "keyword.operator.assignment.aipl",
        "keyword.operator.arithmetic.aipl",
        "punctuation.aipl"
      ],
      "settings": {
        "foreground": "#89B4FA"
      }
    },
    {
      "name": "Invalid Syntax or Misaligned Indentation",
      "scope": [
        "invalid.illegal.aipl",
        "invalid.illegal.bad-keyword.aipl",
        "invalid.illegal.tab-indentation.aipl",
        "invalid.alignment.aipl"
      ],
      "settings": {
        "foreground": "#F07178",
        "fontStyle": "underline"
      }
    }
  ]
}
