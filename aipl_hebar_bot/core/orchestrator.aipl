  // HEBAR Bio-Reflex Telemetry
  cursorX: float
  cursorY: float
  targetX: float
  targetY: float
  reactionDelayMs: float
  currentHz: float
  fatigueFactor: float
  complianceScore: float

  // Scene Perception & Action Log
