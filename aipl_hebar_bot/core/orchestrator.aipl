      autoStart = true,
      aggression = 95,
      exploration = 20
    ),
    SavedBotProfile(
      name = "ClubBeginner",
      description = "Standard casual player with natural 150ms reaction wait",
      strategyPath = "aipl_hebar_bot/specs/chess_beginner.hebar",
      seatId = 2,
      waitMs = 150.0,
      autoStart = true,
      aggression = 45,
      exploration = 80
    ),
    SavedBotProfile(
      name = "UniversalScout",
