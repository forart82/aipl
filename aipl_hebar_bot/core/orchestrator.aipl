      waitMs = 250.0,
      autoStart = true,
      aggression = 60,
      exploration = 60
    )
  ]

fn sanitizeTsvField(s: str): str:
  ret s.replace("\t", " ").replace("\n", " ").replace("\r", "").trim()

pub fn persistSavedBotProfiles(profiles: [SavedBotProfile], filePath: str): bool:
  let targetFile = if filePath.len > 0: filePath else: "aipl_hebar_bot/saved_bots.tsv"
  mut lines: [str] = []
  mut i = 0
  while i < profiles.len:
    let p = profiles[i]
    let autoStr = if p.autoStart: "1" else: "0"
    let row = sanitizeTsvField(p.name) + "\t" + sanitizeTsvField(p.description) + "\t" + sanitizeTsvField(p.strategyPath) + "\t" + str(p.seatId) + "\t" + str(int(p.waitMs)) + "\t" + autoStr + "\t" + str(p.aggression) + "\t" + str(p.exploration)
    lines.push(row)
    i += 1
  ret writeFile(targetFile, lines.join("\n") + "\n")

pub fn loadSavedBotProfiles(filePath: str): [SavedBotProfile]:
  let targetFile = if filePath.len > 0: filePath else: "aipl_hebar_bot/saved_bots.tsv"
  if not fileExists(targetFile):
    let defs = defaultSavedBotProfiles()
    let _ = persistSavedBotProfiles(defs, targetFile)
    ret defs
  let raw = readFile(targetFile)
  let lines = raw.split("\n")
  mut loaded: [SavedBotProfile] = []
  mut i = 0
  while i < lines.len:
    let ln = lines[i].trim()
    if ln.len > 0 and not ln.startsWith("#"):
      let cols = ln.split("\t")
      if cols.len >= 8:
        let bName = cols[0].trim()
        let bDesc = cols[1].trim()
        let bStrat = cols[2].trim().replace("chess_beginer.hebar", "chess_beginner.hebar")
        let sRes = int.parse(cols[3].trim())
        let bSeat = if sRes.isOk(): sRes.unwrap() else: 0
        let wRes = int.parse(cols[4].trim())
        let bWait = if wRes.isOk(): float(wRes.unwrap()) else: 250.0
        let bAuto = cols[5].trim() == "1" or cols[5].trim() == "true"
        let aRes = int.parse(cols[6].trim())
        let bAgg = if aRes.isOk(): aRes.unwrap() else: 50
        let eRes = int.parse(cols[7].trim())
        let bExp = if eRes.isOk(): eRes.unwrap() else: 50
        loaded.push(SavedBotProfile(
          name = if bName.len > 0: bName else: "SavedBot",
          description = bDesc,
          strategyPath = if bStrat.len > 0: bStrat else: "auto",
          seatId = bSeat,
          waitMs = bWait,
          autoStart = bAuto,
          aggression = bAgg,
          exploration = bExp
        ))
    i += 1
  if loaded.len == 0:
    ret defaultSavedBotProfiles()
  ret loaded

