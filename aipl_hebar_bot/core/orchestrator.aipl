    builderName = "GrandMaster",
    builderDescription = "Custom universal tactical HEBAR bot",
    builderSeat = 0,
    builderWaitMs = 250.0,
    builderAutoStart = true,
    builderAggression = 50,
    builderExploration = 50,
    builderStrategy = "auto",
    openDropdownId = "",
    selectedLaunchAppIdx = 0,
    selectedInstanceType = "aipl",
    savedBots = saved,
    selectedSavedBotIdx = 0,
    focusedFieldId = "",
