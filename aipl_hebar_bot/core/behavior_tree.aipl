pub struct HebarBotParams:
  hasDirective: bool
  name: str
  waitMs: int
  aggression: int
  exploration: int
  autoStart: bool
  seatId: int

pub struct BtBranchNode:
  name: str
  kind: str
  conditionExpr: str
  actionExpr: str
  cooldownMs: int
  lastFiredFrame: int
  executions: int
  progressHits: int
  weight: float

pub struct HebarStrategySpec:
  strategyName: str
  sourcePath: str
  reactionMs: int
  maxRateHz: float
  maxTurnRadS: float
  maxCursorPxS: float
  maxIdleFrames: int
  branches: [BtBranchNode]

pub struct BtDecision:
  matched: bool
  branchIndex: int
  branchName: str
  script: str
  targetX: float
  targetY: float

