    name = "HandleModalOrAlert",
    kind = "sequence",
    conditionExpr = "ui.modalVisible == true",
    actionExpr = "click_smooth(ui.modalDismissBtn)",
    cooldownMs = 180,
    lastFiredFrame = -100,
    executions = 0,
    progressHits = 0,
    weight = 1.25
  ))
  branches.push(BtBranchNode(
    name = "MultiplayerTurnGuard",
    kind = "sequence",
    conditionExpr = "env.activeSeat > 0 and env.activeSeat != bot.seatId",
    actionExpr = "wait_turn(env.activeSeat)",
    cooldownMs = 60,
    lastFiredFrame = -100,
    executions = 0,
    progressHits = 0,
    weight = 1.0
  ))
  branches.push(BtBranchNode(
    name = "ExploreUnvisitedTabs",
    kind = "sequence",
    conditionExpr = "ui.unvisitedTabsCount > 0",
    actionExpr = "click_smooth(ui.nextUnvisitedTab)",
    cooldownMs = 80,
    lastFiredFrame = -100,
    executions = 0,
    progressHits = 0,
    weight = 1.35
  ))
  branches.push(BtBranchNode(
    name = "AdvanceBoardPiece",
    kind = "sequence",
    conditionExpr = "env.legalActionsCount > 0",
    actionExpr = "select_best_board_move()",
    cooldownMs = 80,
    lastFiredFrame = -100,
    executions = 0,
    progressHits = 0,
    weight = 1.40
  ))
  branches.push(BtBranchNode(
    name = "TacticalDodgeAndEngage",
    kind = "sequence",
    conditionExpr = "env.nearestHazardDist < 48.0",
    actionExpr = "pursue_and_attack(env.nearestEnemy)",
    cooldownMs = 80,
    lastFiredFrame = -100,
    executions = 0,
    progressHits = 0,
    weight = 1.30
  ))
  branches.push(BtBranchNode(
    name = "FallbackHeartbeatExploration",
    kind = "sequence",
