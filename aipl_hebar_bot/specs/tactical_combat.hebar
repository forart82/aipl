strategy "TacticalCombatAgent"
  seat: 1
  reaction_ms: 165
  max_rate_hz: 15.0
  max_turn_rad_s: 6.2831853
  max_cursor_px_s: 780.0
  max_idle_frames: 90

  selector "Root"
    sequence "EmergencyHealOrRetreat"
      condition: player.hp < 35 and inventory.hasPotion == true
      action: key("1")

    sequence "EvadeIncomingProjectile"
      condition: env.nearestProjectileDist < 56.0
      action: strafe_perpendicular(env.nearestProjectileAngle)

    sequence "EngageNearestHostile"
      condition: env.nearestEnemyDist < 320.0
      parallel "StrafeAndFire"
        action: key("D")
        action: pursue_and_attack(env.nearestEnemy)

    sequence "AdvanceToObjectiveWaypoint"
      condition: env.objectiveDist > 24.0
      action: move_toward(env.objectivePos)
