strategy "RedAlertIsometricRTSAgent"
  seat: 1
  reaction_ms: 240
  max_rate_hz: 12.0
  max_turn_rad_s: 6.2831853
  max_cursor_px_s: 780.0
  max_idle_frames: 100

  selector "Root"
    sequence "HandleModalOrAlert"
      condition: ui.modalVisible == true
      cooldown_ms: 80
      action: click_smooth(ui.modalDismissBtn)

    sequence "AntCampaignGiantAntCombat"
      condition: env.isAntCampaign == true and (army.hasWarriorAnt == true or env.nearestAntDist < 200.0)
      cooldown_ms: 80
      action: click_smooth(env.nearestAntPos)

    sequence "AntQueenBossAndChemicalNestGassing"
      condition: env.mission == "SCA04EA" and (env.queenAntAlive == true or env.nestsRemaining > 0)
      cooldown_ms: 90
      action: click_smooth(env.queenOrNestPos)

    sequence "BattlefieldBonusCratePickup"
      condition: env.nearestCrateDist < 180.0 and army.idleUnitAvailable == true
      cooldown_ms: 100
      action: click_smooth(env.nearestCratePos)

    sequence "CampaignKremlinOrBuckinghamSiegeFinale"
      condition: (env.mission == "SCG14EA" or env.mission == "SCU14EA") and env.palaceTargetReachable == true
      cooldown_ms: 120
      action: click_smooth(env.palaceTargetPos)

    sequence "PostMissionScoreSummaryDismiss"
      condition: ui.postMissionScoreVisible == true or env.scene == "score_screen"
      cooldown_ms: 100
      action: click_smooth(ui.scoreContinueBtn)

    sequence "AlliedGpsSatelliteOrbitalReveal"
      condition: base.hasTechCenter == true and superweapons.gpsReady == true
      cooldown_ms: 150
      action: click_smooth(ui.sidebarGpsLaunchBtn)

    sequence "SovietAirfieldSuperweapons"
      condition: base.hasAirfield == true and (superweapons.spyPlaneReady == true or superweapons.parabombReady == true or superweapons.paradropReady == true)
      cooldown_ms: 150
      action: click_smooth(ui.sidebarAirstrikeBtn)

    sequence "AftermathDemoTruckKamikaze"
      condition: army.hasDemoTruck == true and env.enemyBaseTargetReachable == true
      cooldown_ms: 150
      action: click_smooth(env.enemyBasePos)

    sequence "AftermathTeslaTankAndShockTrooperCombat"
      condition: (army.hasTeslaTank == true or army.hasShockTrooper == true) and env.nearestHostileDist < 250.0
      cooldown_ms: 100
      action: click_smooth(env.nearestHostilePos)

    sequence "AftermathFieldMechanicVehicleRepair"
      condition: army.hasFieldMechanic == true and army.vehicleDamaged == true
      cooldown_ms: 120
      action: click_smooth(army.damagedVehiclePos)

    sequence "DeployMcvCommand"
      condition: env.hasUnpackMcv == true
      cooldown_ms: 120
      action: click_smooth(env.mcvPos)

    sequence "OreRefineryEconomyGuard"
      condition: economy.credits < 1000 and base.hasRefinery == false
      cooldown_ms: 150
      action: click_smooth(ui.sidebarRefineryBtn)

    sequence "BaseDefenseAndUnitProduction"
      condition: base.hasBarracks == true and army.unitCount < 12
      cooldown_ms: 90
      action: click_smooth(ui.sidebarInfantryBtn)

    sequence "MinelayerDeployMinefield"
      condition: base.hasMinelayer == true and env.chokePointUnmined == true
      cooldown_ms: 150
      action: click_smooth(env.chokePointPos)

    sequence "EngineerCaptureOrRepairStructure"
      condition: base.hasEngineer == true and (env.damagedFriendlyBuilding == true or env.captureEnemyBuilding == true)
      cooldown_ms: 120
      action: click_smooth(env.targetStructurePos)

    sequence "ThiefCreditHeistRefinery"
      condition: base.hasThief == true and env.enemyRefineryReachable == true
      cooldown_ms: 150
      action: click_smooth(env.enemyRefineryPos)

    sequence "MedicHealInfantrySquad"
      condition: base.hasMedic == true and army.infantryDamaged == true
      cooldown_ms: 100
      action: click_smooth(army.damagedInfantryPos)

    sequence "ServiceDepotRepairArmor"
      condition: base.hasServiceDepot == true and army.vehicleDamaged == true
      cooldown_ms: 150
      action: click_smooth(base.serviceDepotPos)

    sequence "CampaignMissionBriefingAdvance"
      condition: campaign.briefingActive == true
      cooldown_ms: 200
      action: key("SPACE")

    sequence "SquadTacticalAttackMove"
      condition: army.squadReady == true
      cooldown_ms: 120
      action: click_smooth(env.enemyBasePos)

    sequence "ChronosphereSuperweaponWarp"
      condition: superweapon.chronoReady == true
      cooldown_ms: 200
      action: click_smooth(env.chronoStrikePos)

    sequence "IronCurtainInvulnerabilityShield"
      condition: superweapon.ironReady == true and army.leadTankUnderFire == true
      cooldown_ms: 180
      action: click_smooth(env.leadTankPos)

    sequence "AirStrikeBadgerBomberParadrop"
      condition: airstrike.paradropReady == true
      cooldown_ms: 220
      action: click_smooth(env.airDropZonePos)

    sequence "SkirmishDiplomacyTruceProposal"
      condition: diplomacy.peaceAdvisable == true and diplomacy.p1StanceToP2 == 0
      cooldown_ms: 300
      action: click_smooth(ui.diplomacyOfferBtn)

    sequence "NuclearMissileStrike"
      condition: superweapon.nukeReady == true
      cooldown_ms: 250
      action: click_smooth(env.nukeStrikePos)

    sequence "NavalSupremacyOrder"
      condition: naval.hasShipyard == true and naval.fleetSize < 4
      cooldown_ms: 120
      action: click_smooth(ui.sidebarNavalBtn)

    sequence "NavalSonarSubmarineHunt"
      condition: naval.hasDestroyer == true and naval.submergedEnemySuspected == true
      cooldown_ms: 180
      action: click_smooth(env.navalPatrolPos)

    sequence "GapGeneratorShroudDefense"
      condition: base.hasGapGenerator == true and base.lowPower == false
      cooldown_ms: 250
      action: click_smooth(ui.sidebarGapBtn)

    sequence "AlliedSpyInfiltrationMission"
      condition: army.spyDisguised == true and env.enemyRefineryReachable == true
      cooldown_ms: 200
      action: click_smooth(env.enemyRefineryPos)

    sequence "StateCheckpointSaveResume"
      condition: env.tick > 30 and bot.hasSavedThisTick == false
      cooldown_ms: 1000
      action: key("F5")

    sequence "StateCheckpointQuickLoadResume"
      condition: env.missionFailed == true and bot.hasSavedCheckpoint == true
      cooldown_ms: 1000
      action: key("F8")

    sequence "ColumnarWorldMapResourceScan"
      condition: economy.credits < 500
      cooldown_ms: 120
      action: click_smooth(ui.sidebarHarvesterBtn)

    sequence "AlliedChronosphereTeleportAndSnapback"
      condition: superweapon.chronoShiftReady == true and army.hasStrikeTarget == true
      cooldown_ms: 200
      action: click_smooth(env.chronoTeleportTargetPos)

    sequence "ChronoVortexAvoidanceDirective"
      condition: env.hasChronoVortex == true and army.nearVortex == true
      cooldown_ms: 120
      action: click_smooth(env.vortexRetreatPos)

    sequence "TanyaAdamsC4DemolitionRaid"
      condition: army.hasTanyaAdams == true and env.targetBuildingVulnerable == true
      cooldown_ms: 150
      action: click_smooth(env.targetBuildingPos)

    sequence "SovietMadTankSeismicShockwaveDeploy"
      condition: army.hasMadTank == true and env.enemyBaseDensityHigh == true
      cooldown_ms: 250
      action: click_smooth(env.madTankDeployPos)

    sequence "FallbackHeartbeatExploration"
      condition: bot.idleFrames > 60
      cooldown_ms: 80
      action: click_smooth(ui.primaryInteractiveNode)

