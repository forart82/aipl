# AIPL Global Standard .hebar Bot Instruction File — Externalized Chess Tactical & Piece-Square Spec
@bot "ChessTacticalSpec" wait=25 agg=90 exp=25 start=auto seat=auto

# Externalized piece values (centipawns): K=2000 Q=900 R=500 B=330 N=320 P=100
if turn.winner > 0 => click("New Match")
if turn.active != self.seat => wait()
while ui.has("target_capture") => click_best("target_capture +minimax +mate +check +mvv_lva +see_safe +fork +center K=2000 Q=900 R=500 B=330 N=320 P=100")
while ui.has("target_move") => click_best("target_move +minimax +mate +check +see_safe +fork +center +develop -hang K=2000 Q=900 R=500 B=330 N=320 P=100")
for t in my_tokens where !t.dead => try_token("+minimax +mate +check +mvv_lva +see_safe +fork +center +develop +N +B +Q +R +P -hang -blocked -K K=2000 Q=900 R=500 B=330 N=320 P=100")
