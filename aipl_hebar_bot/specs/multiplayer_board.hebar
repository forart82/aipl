strategy "MultiplayerBoardGrandmaster"
  seat: auto
  reaction_ms: 185
  max_rate_hz: 15.0
  max_turn_rad_s: 6.2831853
  max_cursor_px_s: 780.0
  max_idle_frames: 110

  selector "Root"
    sequence "RespectOtherSeatTurn"
      condition: turn.activeSeat != bot.seatId
      action: wait_turn(turn.activeSeat)

    sequence "RollDicePhase"
      condition: turn.phase == "roll"
      action: click_smooth(ui.rollDiceBtn)

    sequence "CaptureOpponentTokenMove"
      condition: board.canCaptureOpponent == true
      action: click_smooth(board.bestCaptureToken)

    sequence "SpawnTokenFromYardOnSix"
      condition: board.diceValue == 6 and board.tokensInYard > 0
      action: click_smooth(board.yardSpawnToken)

    sequence "AdvanceLeadTokenToHome"
      condition: board.legalMovesCount > 0
      action: click_smooth(board.bestAdvanceToken)

    sequence "ChessTacticalMove"
      condition: board.mode == "chess" and board.legalMovesCount > 0
      action: drag_smooth(board.chessFromSq, board.chessToSq)
