strategy "SonicHighSpeedPlatformerAgent"
  seat: 1
  reaction_ms: 160
  max_rate_hz: 15.0
  max_turn_rad_s: 6.2831853
  max_cursor_px_s: 780.0
  max_idle_frames: 80

  selector "Root"
    sequence "SpecialStage360ChaosEmeraldMaze"
      condition: env.zoneId == 5 or env.isSpecialStage == true
      cooldown_ms: 50
      action: key("UP")

    sequence "FinalZonePistonCrusherBossAttack"
      condition: env.zoneId == 6 and env.fzBossActive == true and env.nearestFzPistonDist < 90.0
      cooldown_ms: 50
      action: key("SPACE")

    sequence "FinalZonePlasmaSphereEvasion"
      condition: env.zoneId == 6 and env.nearestPlasmaSphereDist < 70.0
      cooldown_ms: 40
      action: key("LEFT")

    sequence "ScrapBrainSpeedingSawJumpEvasion"
      condition: env.zoneId == 5 and env.nearestGroundSawDist < 80.0 and env.isGrounded == true
      cooldown_ms: 50
      action: key("SPACE")

    sequence "ScrapBrainFlamethrowerTimingWait"
      condition: env.zoneId == 5 and env.nearestFlameDist < 60.0 and env.flameActive == true
      cooldown_ms: 60
      action: key("DOWN")

    sequence "ScrapBrainTeslaCoilShockEvasion"
      condition: env.zoneId == 5 and env.nearestTeslaDist < 50.0 and env.teslaShockActive == true
      cooldown_ms: 50
      action: key("LEFT")

    sequence "ScrapBrainConveyorBeltDriftCompensation"
      condition: env.zoneId == 5 and env.onConveyor == true and env.isGrounded == true
      cooldown_ms: 30
      action: key("RIGHT")

    sequence "ScrapBrainPhaseBlockTraverse"
      condition: env.zoneId == 5 and env.onPhaseBlock == true and env.phaseSolidTimeRemaining < 20
      cooldown_ms: 50
      action: key("SPACE")

    sequence "CaterkillerBadnikHeadBounceAttack"
      condition: env.nearestCaterkillerDist < 64.0 and env.isGrounded == true
      cooldown_ms: 50
      action: key("SPACE")

    sequence "GoodEndingChaosEmeraldsFinale"
      condition: env.emeraldsCount >= 6 and (env.scene == "ending_good" or env.endingActive == true)
      cooldown_ms: 100
      action: key("SPACE")

    sequence "StarLightEggmanSeeSawBombDropperBoss"
      condition: env.zoneId == 4 and env.actId == 2 and env.bossDefeated == false and env.nearestSlzBossDist < 120.0
      cooldown_ms: 60
      action: key("SPACE")

    sequence "StarLightSeeSawCatapultLaunch"
      condition: env.zoneId == 4 and env.onSeeSaw == true and env.spikeballFalling == true
      cooldown_ms: 50
      action: key("SPACE")

    sequence "StarLightWindFanAirflowCompensation"
      condition: env.zoneId == 4 and env.inWindFanCurrent == true
      cooldown_ms: 40
      action: key("RIGHT")

    sequence "StarLightOrbinautAndWalkingBombCombat"
      condition: env.zoneId == 4 and (env.nearestOrbinautDist < 96.0 or env.nearestBombDist < 96.0)
      cooldown_ms: 60
      action: key("SPACE")

    sequence "UnderwaterAirBubbleBreathing"
      condition: env.isUnderwater == true and env.airTime < 1080 and env.nearestBubbleDist < 90.0
      cooldown_ms: 50
      action: move_toward(env.nearestBubblePos)

    sequence "LabyrinthWaterSlideCurrent"
      condition: env.isUnderwater == true and env.onWaterSlide == true
      cooldown_ms: 40
      action: key("RIGHT")

    sequence "LabyrinthDrowningCountdownSurfacing"
      condition: env.isUnderwater == true and env.airTime < 720 and env.nearestBubbleDist >= 90.0
      cooldown_ms: 60
      action: key("SPACE")

    sequence "LabyrinthEggmanEscapeShaftClimbBoss"
      condition: env.zoneId == 1 and env.actId == 2 and env.bossDefeated == false and env.nearestLzBossDist < 80.0
      cooldown_ms: 60
      action: key("SPACE")

    sequence "LabyrinthOrbinautAndJawsEvasion"
      condition: (env.nearestOrbinautDist < 70.0 or env.nearestJawsDist < 60.0) and env.isUnderwater == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "StomperCrusherJumpEvasion"
      condition: env.nearestStomperDist < 54.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "MagmaGeyserJumpEvasion"
      condition: env.nearestGeyserDist < 58.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "EggmanLavaBossJumpAttack"
      condition: env.zoneId == 2 and env.actId == 2 and env.bossDefeated == false and env.nearestLavaBossDist < 70.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "EggmanPickaxeBossAttack"
      condition: env.zoneId == 3 and env.actId == 2 and env.bossDefeated == false and env.nearestSyzBossDist < 75.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "SpringYardBumperBounce"
      condition: env.nearestBumperDist < 48.0
      cooldown_ms: 60
      action: key("RIGHT")

    sequence "RollerBadnikEvasion"
      condition: env.nearestRollerDist < 56.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "YadrinRollAttack"
      condition: env.nearestYadrinDist < 60.0 and env.isGrounded == true and env.isRolling == false
      cooldown_ms: 60
      action: key("DOWN")

    sequence "SpringYardElevatorRide"
      condition: env.zoneId == 3 and env.nearestElevatorDist < 40.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("RIGHT")

    sequence "DungeonSwitchPuzzleAdvance"
      condition: env.zoneId == 2 and env.nearestSwitchDist < 60.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("RIGHT")

    sequence "LavaHazardJumpEvasion"
      condition: env.nearestLavaDist < 58.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "HazardSpikeJumpEvasion"
      condition: env.nearestHazardDist < 52.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "BossWreckingBallEvasion"
      condition: env.nearestHazardDist < 58.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "BossEggmanJumpAttack"
      condition: env.bossDefeated == false and env.nearestEnemyDist < 70.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "CaterpillarHeadBounceAttack"
      condition: env.nearestCaterpillarDist < 64.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "BatbrainSwoopEvasion"
      condition: env.nearestBatbrainDist < 60.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "SpearHazardJumpEvasion"
      condition: env.nearestSpearDist < 52.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "BadnikBounceAttack"
      condition: env.nearestEnemyDist < 64.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "CapsuleJumpUnlock"
      condition: env.nearestCapsuleDist < 48.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("SPACE")

    sequence "SpinDashRollOnSlope"
      condition: env.slopeAngle > 20.0 and env.isRolling == false
      cooldown_ms: 90
      action: key("DOWN")

    sequence "CollectRingCluster"
      condition: env.nearestRingDist < 75.0
      cooldown_ms: 50
      action: move_toward(env.nearestRingPos)

    sequence "CheckpointQuickSave"
      condition: env.checkpointSaved == false and player.posX > 1500.0
      cooldown_ms: 2000
      action: key("F5")

    sequence "MarbleZoneRuinsAdvance"
      condition: env.zoneId == 2 and env.levelEndX > player.posX
      cooldown_ms: 40
      action: key("RIGHT")

    sequence "StepAngleByteSteepSlope"
      condition: env.slopeAngle > 35.0 and env.isGrounded == true
      cooldown_ms: 60
      action: key("RIGHT")

    sequence "RightwardLevelProgression"
      condition: env.levelEndX > player.posX
      cooldown_ms: 40
      action: key("RIGHT")

    sequence "AntiStallJump"
      condition: bot.idleFrames > 30 and env.isGrounded == true
      cooldown_ms: 70
      action: key("SPACE")
