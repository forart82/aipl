strategy "SurvivalHorrorAgent"
  seat: 1
  reaction_ms: 220
  max_rate_hz: 15.0
  max_turn_rad_s: 3.1415926
  max_cursor_px_s: 600.0
  max_idle_frames: 100

  selector "Root"
    sequence "EmergencyHerbHeal"
      condition: player.hp < 35 and inventory.hasHerb == true
      cooldown_ms: 120
      action: key("H")

    sequence "BattleGameZombieWeskerGauntletBoss"
      condition: env.gameMode == "BattleGame" and env.room == "500" and env.nearestEnemy == "801"
      cooldown_ms: 80
      action: pursue_and_attack(env.nearestEnemy)

    sequence "BattleGameGoldTyrantGauntletBoss"
      condition: env.gameMode == "BattleGame" and env.room == "600" and env.nearestEnemy == "802"
      cooldown_ms: 70
      action: pursue_and_attack(env.nearestEnemy)

    sequence "BattleGameRankScoreEvaluator"
      condition: env.gameMode == "BattleGame" and (env.scene == "battle_game_score" or env.battleGameComplete == true)
      cooldown_ms: 100
      action: key("SPACE")

    sequence "ArtGalleryCradleToGraveSequence"
      condition: env.room == "108" and env.puzzleActive == "ArtGallery"
      cooldown_ms: 120
      action: key("E")

    sequence "MoonlightSonataPianoPracticeAndEmblemSwap"
      condition: (env.room == "118" or env.room == "102") and (env.puzzleActive == "MoonlightSonata" or env.hasGoldEmblem == true)
      cooldown_ms: 150
      action: key("E")

    sequence "AncientTomesEagleWolfMedals3DInspection"
      condition: env.inspectingItem == true and (inventory.hasAncientTome1 == true or inventory.hasAncientTome2 == true or inventory.hasJewelryBox == true)
      cooldown_ms: 100
      action: key("SPACE")

    sequence "ArrangeModeItemRemixAndDoubleDamage"
      condition: env.gameMode == "Arrange" and env.doorInteractable == true
      cooldown_ms: 150
      action: key("E")

    sequence "BerettaCustomDecapitationCrit"
      condition: inventory.equippedWeapon == "BerettaCustom" and env.nearestEnemyDist < 140.0
      cooldown_ms: 100
      action: pursue_and_attack(env.nearestEnemy)

    sequence "MoonCrestBrokenHalvesCombining"
      condition: inventory.hasMoonCrestLeft == true and inventory.hasMoonCrestRight == true
      cooldown_ms: 200
      action: key("C")

    sequence "ClearTimeRankGradingEvaluator"
      condition: env.scene == "clear_rank_summary" or env.clearScreenActive == true
      cooldown_ms: 100
      action: key("SPACE")

    sequence "CollectibleFileArchiveReader18"
      condition: env.scene == "file_reader" or env.readingFile == true
      cooldown_ms: 120
      action: key("SPACE")

    sequence "CinemaEpilogueRollViewer"
      condition: env.epilogueActive == true or env.scene == "cinema_epilogue_roll"
      cooldown_ms: 100
      action: key("SPACE")

    sequence "CostumeWardrobeClosetUnlock"
      condition: env.wardrobeOpen == true or (env.room == "11C" and inventory.hasClosetKey == true)
      cooldown_ms: 120
      action: key("E")

    sequence "DualCharacterJillLockpickBarryBazooka"
      condition: player.character == "Jill" and env.doorSimpleLocked == true
      cooldown_ms: 150
      action: key("E")

    sequence "DualCharacterChrisLighterRebeccaFlame"
      condition: player.character == "Chris" and inventory.hasLighter == true and env.nearPlantOrDark == true
      cooldown_ms: 150
      action: key("E")

    sequence "QuickSaveStateCheckpoint"
      condition: env.checkpointAvailable == "true" and player.hp > 60 and bot.idleFrames > 40
      cooldown_ms: 1000
      action: key("5")

    sequence "TypewriterRibbonSaveMenu"
      condition: env.room == "106" and env.nearTypewriter == true
      cooldown_ms: 800
      action: key("T")

    sequence "SkeletalAnimationAimPose"
      condition: env.nearestEnemyDist < 120.0 and inventory.equippedWeapon != "None"
      cooldown_ms: 100
      action: key("U")

    sequence "MansionRoomProgressionTransit"
      condition: env.doorInteractable == true and bot.idleFrames > 20
      cooldown_ms: 150
      action: key("E")

    sequence "PointInRectHitboxTouch"
      condition: ui.inventoryOpen == true
      cooldown_ms: 120
      action: click_smooth(ui.inventorySlotTouchNode)

    sequence "ShotgunDecapitateOrAimUp"
      condition: inventory.equippedWeapon == "Shotgun" and env.nearestEnemyDist < 2.5
      cooldown_ms: 100
      action: key("U")

    sequence "HelipadSuperTyrantRocketStrike"
      condition: env.room == "303" and env.nearestEnemy == "14"
      cooldown_ms: 100
      action: pursue_and_attack(env.nearestEnemy)

    sequence "CavesBoulderDodgeQTE"
      condition: (env.room == "501" or env.room == "503") and env.boulderRolling == true
      cooldown_ms: 60
      action: evade_vector(3.14159)

    sequence "BlackTigerFlamethrowerWebClear"
      condition: env.room == "502" and env.webDoorBlocked == true and inventory.hasFlamethrower == true
      cooldown_ms: 120
      action: key("F")

    sequence "BlackTigerBossCombat"
      condition: env.room == "502" and env.nearestEnemy == "40"
      cooldown_ms: 100
      action: pursue_and_attack(env.nearestEnemy)

    sequence "CavesCrankShaftTunnelRotation"
      condition: env.room == "504" and inventory.hasCrank == true
      cooldown_ms: 150
      action: key("E")

    sequence "LabTerminalLoginJohnAda"
      condition: (env.room == "601" or env.room == "506") and env.nearTerminal == true
      cooldown_ms: 150
      action: key("E")

    sequence "MoDiskPasscodeInsertion"
      condition: (env.room == "604" or env.room == "605" or env.room == "606" or env.room == "508" or env.room == "507" or env.room == "510") and inventory.hasMoDisk == true
      cooldown_ms: 150
      action: key("E")

    sequence "HoldingCellPartnerRescue"
      condition: (env.room == "608" or env.room == "514") and env.cellUnlocked == true
      cooldown_ms: 150
      action: key("E")

    sequence "GuardhousePlant42BossEngagement"
      condition: env.room == "408" and env.nearestEnemy == "30"
      cooldown_ms: 100
      action: pursue_and_attack(env.nearestEnemy)

    sequence "Plant42AcidSporeAndVineSweepEvade"
      condition: env.room == "408" and env.bossSweeping == true
      cooldown_ms: 80
      action: evade_vector(env.nearestEnemyAngle)

    sequence "AquaRingVJoltRootsApplication"
      condition: env.room == "407" and inventory.hasVJolt == true
      cooldown_ms: 150
      action: key("E")

    sequence "ChemistryLabVJoltMixing"
      condition: env.room == "405" and env.nearChemistryBench == true
      cooldown_ms: 200
      action: key("E")

    sequence "LabPowerMazeChimeraSkeletalEncounter"
      condition: (env.room == "510" or env.room == "511" or env.room == "512") and (env.nearestEnemy == "11" or env.nearestEnemy == "12" or env.nearestEnemy == "34")
      cooldown_ms: 100
      action: pursue_and_attack(env.nearestEnemy)

    sequence "HelipadSignalFlareLaunch"
      condition: env.room == "303" and env.signalFlareUsed != "true"
      cooldown_ms: 150
      action: key("E")

    sequence "LabTyrantClawEncounter"
      condition: env.room == "513" and env.nearestEnemy == "13"
      cooldown_ms: 100
      action: pursue_and_attack(env.nearestEnemy)


    sequence "SelfDestructEmergencyEscape"
      condition: env.selfDestructActive == "true" and env.doorInteractable == true
      cooldown_ms: 120
      action: key("E")

    sequence "BossFinisherRocketLauncher"
      condition: env.nearestEnemy == "12" and inventory.ammoCount > 0
      cooldown_ms: 100
      action: pursue_and_attack(env.nearestEnemy)

    sequence "EvadeHostileZombieOrCerberus"
      condition: env.nearestEnemyDist < 48.0
      cooldown_ms: 80
      action: evade_vector(env.nearestEnemyAngle)

    sequence "EngageAndAimHostile"
      condition: inventory.ammoCount > 0 and env.nearestEnemyDist < 160.0
      cooldown_ms: 100
      action: pursue_and_attack(env.nearestEnemy)

    sequence "ManageInventoryTouchSlot"
      condition: ui.inventoryOpen == true
      cooldown_ms: 150
      action: click_smooth(ui.inventorySlotTouchNode)

    sequence "InteractDoorOrRoomTransition"
      condition: env.doorInteractable == true
      cooldown_ms: 150
      action: key("E")

    sequence "PickupItemOrInkRibbon"
      condition: env.nearestItemDist < 36.0
      cooldown_ms: 100
      action: interact_item(env.nearestItem)

    sequence "InspectFileOrDocument"
      condition: env.nearestFileDist < 30.0
      cooldown_ms: 120
      action: key("E")

    sequence "FallbackHeartbeatExploration"
      condition: bot.idleFrames > 45
      cooldown_ms: 80
      action: click_smooth(ui.primaryInteractiveNode)
