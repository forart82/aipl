strategy "UiAppExplorer"
  seat: 1
  reaction_ms: 180
  max_rate_hz: 15.0
  max_turn_rad_s: 6.2831853
  max_cursor_px_s: 780.0
  max_idle_frames: 100

  selector "Root"
    sequence "DismissModalDialog"
      condition: ui.modalVisible == true
      action: click_smooth(ui.modalConfirmBtn)

    sequence "TraverseNavigationTabs"
      condition: ui.unvisitedTabsCount > 0
      cooldown_ms: 400
      action: click_smooth(ui.nextUnvisitedTab)

    sequence "FillFocusedFormInputs"
      condition: ui.focusedInputVisible == true
      action: text("AuraEnterprise2026")

    sequence "ExerciseActionButtons"
      condition: ui.unclickedButtonsCount > 0
      cooldown_ms: 300
      action: click_smooth(ui.nextUnclickedButton)

    sequence "ScrollAndAuditContrast"
      condition: ui.scrollablePanelVisible == true
      action: wheel(-1)
