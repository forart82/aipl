  elif bp.contains("/cs/") or bp.contains("tactical_fps"):
    let ph = (frame / 12) % 6
    if ph == 0:
      snap.rawJson = "{\"isBuyPhase\":true,\"money\":4500,\"nearestProjectileDist\":200.0,\"nearestEnemyDist\":600.0,\"bombTargetActive\":false,\"objectiveDist\":10.0,\"idleFrames\":0}"
    elif ph == 1:
