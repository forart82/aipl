// ============================================================================
// AIPL Real 2-Player Playable Chess Arena (`aipl_hebar_bot/demos/chess_arena.aipl`)
// ============================================================================
// 100% Real 2-Player Chess Game with Complete Legal Move Generation:
// - Full 8x8 Board (length 64) with standard piece encoding
// - Strict legal move generation (pins, checks, ray-blocking, queen promotion)
// - Check, Checkmate & Stalemate detection
// - Tactical Move Evaluator (MVV-LVA, center control, piece development, check bonuses)
// - Real 2-Click Board Interaction for BOTH Human Players and Attached HEBAR Bots
// - Zero-Config Scene-Graph Target Exposure (fused "Move ..." buttons for BaseInstincts)
// - Full Telemetry Publishing via publishTurnState & publishBotState
// ============================================================================

module ChessArena

import {
  initWindow,
  closeWindow,
  setWindowMinSize,
  getWindowWidth,
  getWindowHeight,
  setTargetFps,
  setMaxFps,
  getCurrentFps,
  windowShouldClose,
  beginDrawing,
  endDrawing,
  clearScreen,
  drawRect,
  drawRoundedRect,
  drawCircle,
  drawText,
  getMouseX,
  getMouseY,
  isMouseButtonPressed,
  saveScreenshot,
  publishBotState,
  publishTurnState,
  rgb
} from "std/canvas"

