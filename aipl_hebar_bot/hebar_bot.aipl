pub fn testHebarWave6CheckpointContinuityAndReports(): void:
  testHebarWave11CheckpointContinuityAndReports()

pub fn testHebarWave7CheckpointContinuityAndReports(): void:
  testHebarWave11CheckpointContinuityAndReports()

pub fn testHebarWave8CheckpointContinuityAndReports(): void:
  testHebarWave11CheckpointContinuityAndReports()

pub fn testHebarWave9CheckpointContinuityAndReports(): void:
  testHebarWave11CheckpointContinuityAndReports()

pub fn testHebarWave10CheckpointContinuityAndReports(): void:
  testHebarWave11CheckpointContinuityAndReports()

pub fn testHebarWave11CheckpointContinuityAndReports(): void:
  let tmpCheck = "/tmp/aipl_hebar_test_cp.json"
  let _ = writeFile(tmpCheck, "{\"character\":\"Jill\",\"currentRoom\": 405, \"currentStage\": \"Guardhouse\", \"saveCount\": 4}\n")
  assert(fileExists(tmpCheck), "checkpoint file created")
  let stage = extractProgressionStage("survival_horror", tmpCheck)
  assert(stage.contains("Jill") and stage.contains("Room 405"), "progression stage extracted")
  let feats6 = getWave6FeaturesForProject("survival_horror")
  assert(feats6.len >= 4, "wave 6 features returned")
  let feats7 = getWave7FeaturesForProject("survival_horror")
  assert(feats7.len >= 5, "wave 7 features returned")
  let feats8 = getWave8FeaturesForProject("survival_horror")
  assert(feats8.len >= 5, "wave 8 features returned")
  let feats9 = getWave9FeaturesForProject("survival_horror")
  assert(feats9.len >= 5, "wave 9 features returned")
  let feats10 = getWave10FeaturesForProject("survival_horror")
  assert(feats10.len >= 5, "wave 10 features returned")
  let feats11 = getWave11FeaturesForProject("survival_horror")
  assert(feats11.len >= 5, "wave 11 features returned")
  mut wd = RssWatchdog.new("ccre", 110.0)
  let _ = wd.update(105.4, 60)
  assert(wd.get("peak") == 105.4, "watchdog peak recorded via receiver method")
  assert(not wd.has("triggered"), "watchdog not triggered under threshold")
  assert(wd.serialize().contains("\"ccre\""), "watchdog serialized via receiver method")
  let rep = HebarProgressionReport.new(
    "survival_horror",
    "/tmp/test.aipl",
    "aipl",
    "headless-fast",
    60,
    1.0,
    60.0,
    tmpCheck,
    true,
    true,
    "InitialBoot",
    stage,
    true,
    [],
    feats6,
    feats7,
    feats8,
    feats9,
    feats10,
    feats11,
    true,
    98,
    wd.peakRssMb,
    wd.triggered,
    wd.thresholdMb,
    "ALL_OK"
  )
  assert(rep.get("project") == "survival_horror", "report get receiver method")
  assert(rep.has("checkpoint"), "report has receiver method")
  let repOut = "/tmp/aipl_hebar_test_rep.json"
  let ok = rep.writeReportJson(repOut)
  assert(ok and fileExists(repOut), "hebar report json generated")

pub fn testKinematicGuardInvariants(): void:
  mut g = initKinematicGuard(1, 100.0, 100.0)
  g = enqueueDelayedCommand(g, 0, "click:240,180", 240.0, 180.0, 2)
  let early = pollReadyCommand(g, 4)
  assert(not early.dispatched, "command held during 150..250ms FIFO reaction window")
  let ready = pollReadyCommand(early.guard, 14)
  assert(ready.dispatched, "command released after reaction window")
  assert(isGuardCompliant(ready.guard), "guard remains 100% HEBAR compliant")

pub fn testMultiSeatArbiterTurnHandoff(): void:
  mut arb = initSeatArbiter(4)
  let snap = emptySceneSnapshot()
  let active = detectActiveSeatFromScene(arb, snap)
  assert(active == 1, "initial active seat is 1")
  arb = tryAcquireSeatCursorLease(arb, 0, 1, 12)
  assert(arb.leaseHolderSeat == 1, "seat 1 acquires lease")
  arb = releaseSeatCursorLease(arb, 0, 1, 16, "hash0002")
  assert(arb.activeSeat == 2, "turn hands off to seat 2")
  arb = recordOutOfTurnProbe(arb, true)
  assert(arb.outOfTurnRejected == 1, "out-of-turn probe recorded")

pub fn testBehaviorTreeAndZeroConfigInstincts(): void:
  let spec = parseHebarStrategyFile("aipl_hebar_bot/specs/default_universal.hebar")
  assert(spec.branches.len >= 4, "default_universal.hebar branches parsed")
  let snap = emptySceneSnapshot()
  let dec = evaluateStrategyTree(spec, snap, 1, 10, 0)
  assert(dec.matched and dec.script.len > 0, "behavior tree produces valid bot script")
  let inst = initInstinctState()
  let act = computeZeroConfigInstinctAction(inst, snap, 1, 1)
  assert(act.script.len > 0, "zero-config base instinct produces valid action")

pub fn testCrossTargetBridgeAndReports(): void:
  let h = openTargetBridge("aipl_hebar_bot/demos/ludo_chess_arena.aipl", "auto", "headless-fast", 4)
  let snap = pollTargetStateSnapshot(h, 10, 1)
  assert(snap.width > 0 and snap.height > 0, "target bridge returns valid snapshot")

pub fn test_hebar_bot_cli_e2e(): void:
